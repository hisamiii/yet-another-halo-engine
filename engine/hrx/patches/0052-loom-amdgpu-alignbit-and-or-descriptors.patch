Loom: v_alignbit_b32 and v_and_or_b32 descriptors for AMDGPU, so Low helpers (low.func.def asm) can author them.
Q5_K decode: the fifth bit of every byte by one rotate and one masked OR, 2 VALU per word instead of shift / and /
shift / or; bit-identical results.
diff --git a/loom/py/loom/target/arch/amdgpu/descriptors/alu.py b/loom/py/loom/target/arch/amdgpu/descriptors/alu.py
--- a/loom/py/loom/target/arch/amdgpu/descriptors/alu.py
+++ b/loom/py/loom/target/arch/amdgpu/descriptors/alu.py
@@ -2408,6 +2408,58 @@
     )
 
 
+def _v_alignbit_b32_overlay() -> AmdgpuDescriptorOverlay:
+    return AmdgpuDescriptorOverlay(
+        descriptor_key="amdgpu.v_alignbit_b32",
+        instruction_name="V_ALIGNBIT_B32",
+        mnemonic="v_alignbit_b32",
+        encoding_name="ENC_VOP3",
+        semantic_tag="integer.funnel_shift.right.u32",
+        schedule_class=_SCHEDULE_VALU,
+        operands=(
+            AmdgpuOperandOverlay("VDST", _vgpr_result()),
+            AmdgpuOperandOverlay("SRC0", _sgpr_vgpr_operand("high")),
+            AmdgpuOperandOverlay("SRC1", _sgpr_vgpr_operand("low")),
+            AmdgpuOperandOverlay(
+                "SRC2",
+                _sgpr_vgpr_operand("shift"),
+                size_exception_reason="alignbit-reads-low-5-bits-of-b32-shift",
+            ),
+        ),
+        asm_forms=_asm(
+            mnemonic="v_alignbit_b32",
+            results=("dst",),
+            operands=("high", "low", "shift"),
+        ),
+        constraints=_REMATERIALIZABLE_RESULT_CONSTRAINTS,
+        flags=(DescriptorFlag.DEAD_REMOVABLE,),
+    )
+
+
+def _v_and_or_b32_overlay() -> AmdgpuDescriptorOverlay:
+    return AmdgpuDescriptorOverlay(
+        descriptor_key="amdgpu.v_and_or_b32",
+        instruction_name="V_AND_OR_B32",
+        mnemonic="v_and_or_b32",
+        encoding_name="ENC_VOP3",
+        semantic_tag="integer.and_or.u32",
+        schedule_class=_SCHEDULE_VALU,
+        operands=(
+            AmdgpuOperandOverlay("VDST", _vgpr_result()),
+            AmdgpuOperandOverlay("SRC0", _sgpr_vgpr_operand("value")),
+            AmdgpuOperandOverlay("SRC1", _sgpr_vgpr_operand("mask")),
+            AmdgpuOperandOverlay("SRC2", _sgpr_vgpr_operand("addend")),
+        ),
+        asm_forms=_asm(
+            mnemonic="v_and_or_b32",
+            results=("dst",),
+            operands=("value", "mask", "addend"),
+        ),
+        constraints=_REMATERIALIZABLE_RESULT_CONSTRAINTS,
+        flags=(DescriptorFlag.DEAD_REMOVABLE,),
+    )
+
+
 def _v_perm_b32_overlay(
     *, include_literal_operand_form: bool = True
 ) -> AmdgpuDescriptorOverlay:
