+// Whether every lane of value_id is known to equal expected.
+static bool loom_amdgpu_table_lookup_lanes_equal(
+    const loom_value_fact_table_t* fact_table, loom_value_id_t value_id,
+    int64_t expected) {
+  if (fact_table == NULL) {
+    return false;
+  }
+  const loom_value_facts_t facts =
+      loom_value_fact_table_lookup(fact_table, value_id);
+  loom_value_fact_uniform_element_t uniform = {0};
+  int64_t value = 0;
+  return loom_value_facts_query_uniform_element(&fact_table->context, facts,
+                                                &uniform) &&
+         loom_amdgpu_value_facts_as_exact_non_negative_i64(uniform.element,
+                                                           &value) &&
+         value == expected;
+}
+
+// The u4 lookup reads only bits 0..3 of each index byte, so an index made by
+// masking a byte vector with 15, or by shifting it right by 4, can be read from
+// that vector directly (shifted by 4 as whole registers in the second case):
+// the bits it brings into 4..7 of each byte are never read.
+static bool loom_amdgpu_table_lookup_u4_raw_indices(
+    const loom_module_t* module, const loom_value_fact_table_t* fact_table,
+    loom_value_id_t indices,
+    loom_value_id_t* out_source, uint32_t* out_shift) {
+  const loom_value_t* value = loom_module_value(module, indices);
+  if (loom_value_is_block_arg(value)) {
+    return false;
+  }
+  const loom_op_t* op = loom_value_def_op(value);
+  if (!op) {
+    return false;
+  }
+  loom_value_id_t source = LOOM_VALUE_ID_INVALID;
+  uint32_t shift = 0;
+  if (loom_vector_andi_isa(op) &&
+      loom_amdgpu_table_lookup_lanes_equal(fact_table,
+                                           loom_vector_andi_rhs(op), 15)) {
+    source = loom_vector_andi_lhs(op);
+  } else if (loom_vector_shrui_isa(op) &&
+             loom_amdgpu_table_lookup_lanes_equal(
+                 fact_table, loom_vector_shrui_rhs(op), 4)) {
+    source = loom_vector_shrui_lhs(op);
+    shift = 4;
+  } else {
+    return false;
+  }
+  if (!loom_type_equal(loom_module_value_type(module, source),
+                       loom_module_value_type(module, indices))) {
+    return false;
+  }
+  *out_source = source;
+  *out_shift = shift;
+  return true;
 }
 
