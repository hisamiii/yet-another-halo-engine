---
 .../arch/amdgpu/lower/matrix_fragment_repack_packed_b16.c    | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/loom/src/loom/target/arch/amdgpu/lower/matrix_fragment_repack_packed_b16.c b/loom/src/loom/target/arch/amdgpu/lower/matrix_fragment_repack_packed_b16.c
index ad39e16803..c95e1b4fea 100644
--- a/loom/src/loom/target/arch/amdgpu/lower/matrix_fragment_repack_packed_b16.c
+++ b/loom/src/loom/target/arch/amdgpu/lower/matrix_fragment_repack_packed_b16.c
@@ -124,9 +124,8 @@ static iree_status_t loom_amdgpu_fragment_repack_lane_registers(
     return iree_ok_status();
   }
   for (uint16_t i = 0; i < plan->source_register_count; ++i) {
-    loom_value_id_t lane = LOOM_VALUE_ID_INVALID;
-    IREE_RETURN_IF_ERROR(loom_low_lower_lookup_value(
-        context, loom_value_slice_get(elements, 2u * i), &lane));
+    const loom_value_id_t lane = loom_low_lower_lookup_value(
+        context, loom_value_slice_get(elements, 2u * i));
     if (lane == LOOM_VALUE_ID_INVALID) {
       return iree_ok_status();
     }
