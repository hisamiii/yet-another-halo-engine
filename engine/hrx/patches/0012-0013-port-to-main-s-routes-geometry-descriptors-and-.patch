+// Forms an accessor-relative lock selector for a physical owner lock: the
+// owner tile's lock ordinal offset by the accessor's address window onto that
+// owner. Fails when the owner's locks are not visible from the accessor.
+iree_status_t loom_xdna_array_form_lock_selector(
+    const loom_xdna_array_family_t* family,
+    loom_xdna_tile_coordinate_t accessor, loom_xdna_tile_coordinate_t owner,
+    uint16_t owner_lock_ordinal, uint16_t* out_selector);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
