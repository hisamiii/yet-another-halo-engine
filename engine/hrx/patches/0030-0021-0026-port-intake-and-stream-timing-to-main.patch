     STACK_SPILLABLE_CLASSES,
 )
-from loom.target.arch.amd.xdna.aie2p.core_stream_descriptors import (
-    _SCALAR_STREAM_ISSUE_EVENT,
-)
 from loom.target.low_descriptors import (
     AsmForm,
     AsmImmediate,
@@ -2011,19 +2008,8 @@ def _event_separations() -> tuple[EventSeparation, ...]:
                 for consumer_access in ("read", "write")
             )
     # Scalar stream order is an issue constraint, not a wait for the status
-    # result. Other protocols retain their own timing: cascade instructions
-    # consume data at different stages, and locks order memory retirement.
-    result.append(
-        EventSeparation(
-            _SCALAR_STREAM_ISSUE_EVENT,
-            _SCALAR_STREAM_ISSUE_EVENT,
-            1,
-            ModelQuality.EXACT,
-        )
-    )
-    # Cascade transfers: in order on one link, independent across links and of
-    # local memory traffic, which only keeps its issue order around them.
-    # Scalar stream ports: same in-order / independent rule as the cascade links.
+    # result: in order on one port, independent across the input and output
+    # ports and of local memory traffic, like the cascade links below.
     stream_events = (STREAM_READ_EVENT, STREAM_WRITE_EVENT)
     for producer in stream_events:
         for consumer in stream_events:
@@ -2045,6 +2031,8 @@ def _event_separations() -> tuple[EventSeparation, ...]:
                 result.append(
                     EventSeparation(memory_event, stream_event, 0, ModelQuality.EXACT)
                 )
+    # Cascade transfers: in order on one link, independent across links and of
+    # local memory traffic, which only keeps its issue order around them.
     cascade_events = (CASCADE_READ_EVENT, CASCADE_WRITE_EVENT)
     for producer in cascade_events:
         for consumer in cascade_events:
