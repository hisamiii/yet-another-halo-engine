 //===----------------------------------------------------------------------===//
+// Dispatch timestamps (LOCAL PROTOTYPE, yah, not upstream)
+//===----------------------------------------------------------------------===//
+
+// One completed dispatch: device start/end ticks and what ran. Graph dispatches
+// carry their command buffer and command index; direct stream dispatches carry
+// command_buffer_id 0 and command_index UINT32_MAX.
+typedef struct hrx_profile_dispatch_t {
+  uint64_t command_buffer_id;
+  uint64_t executable_id;
+  uint32_t command_index;
+  uint32_t function_ordinal;
+  uint32_t workgroup_count[3];
+  uint64_t start_tick;
+  uint64_t end_tick;
+} hrx_profile_dispatch_t;
+
+// Receives completed dispatches during hrx_device_profile_dispatches_flush/end.
+// |dropped| counts records the device could not keep since the last call.
+typedef void (*hrx_profile_dispatch_fn_t)(void* user,
+                                          const hrx_profile_dispatch_t* events,
+                                          size_t count, uint64_t dropped);
+
+// Starts recording dispatch timestamps on |device| (fails while another
+// profile capture, e.g. HRX_PROFILE_FILE, is active). Flush delivers the
+// dispatches completed so far to |fn|; end delivers the rest and stops.
+HRX_API hrx_status_t hrx_device_profile_dispatches_begin(
+    hrx_device_t device, hrx_profile_dispatch_fn_t fn, void* user);
+HRX_API hrx_status_t hrx_device_profile_dispatches_flush(hrx_device_t device);
+HRX_API hrx_status_t hrx_device_profile_dispatches_end(hrx_device_t device);
+
+//===----------------------------------------------------------------------===//
 // Device memory/peer info
 //===----------------------------------------------------------------------===//
 
