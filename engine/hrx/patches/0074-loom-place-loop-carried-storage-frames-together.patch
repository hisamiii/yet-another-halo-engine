 // Borrowed allocator facts used when probing physical storage.
+// Storage frames joined by same-storage placement relations. Each member keeps
+// a fixed unit offset inside its frame, so one placed member predicts the
+// location of every other member. Frames crossing a control-flow edge carry
+// values around loops: keeping their members at those offsets folds the
+// backedge copies together with the slices, concats and copies feeding them.
+typedef struct loom_low_allocation_frame_affinity_t {
+  // Number of entries in each by-ordinal table.
+  iree_host_size_t value_count;
+  // Frame representative by value ordinal, or UINT32_MAX without an interval.
+  uint32_t* roots;
+  // Unit offset of each member's first unit inside its frame.
+  int32_t* offsets;
+  // Circular member list by value ordinal.
+  uint32_t* next_members;
+  // Lowest member unit offset, indexed by representative.
+  int32_t* frame_begins;
+  // One past the highest member unit offset, indexed by representative.
+  int32_t* frame_ends;
+  // Nonzero for a representative whose multi-unit frame crosses an edge.
+  uint8_t* edge_frames;
+} loom_low_allocation_frame_affinity_t;
+
+// Builds frame affinities over |liveness| values. Relations whose offsets
+// contradict their frame, and edges forwarding one value to several
+// destinations, are left out.
+iree_status_t loom_low_allocation_frame_affinity_build(
+    const loom_liveness_analysis_t* liveness,
+    const loom_low_placement_table_t* placement, iree_arena_allocator_t* arena,
+    loom_low_allocation_frame_affinity_t* out_frames);
