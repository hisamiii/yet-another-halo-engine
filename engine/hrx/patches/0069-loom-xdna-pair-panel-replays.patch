+// Replays a lock unit stands for: a streamed panel member past the 6-bit lock
+// value counts replay pairs (two chained drain descriptors per lock unit).
+static inline uint32_t loom_aie2p_panel_pair(uint64_t repeat_count) {
+  // EXPERIMENT LOOM_EXP_PAIR_MIN=n: pair-count past n replays (diagnosis; even counts only)
+  const char* spec = getenv("LOOM_EXP_PAIR_MIN");
+  const uint64_t limit = spec != NULL ? (uint64_t)atoi(spec) : 63u;
+  return repeat_count > limit && repeat_count % 2u == 0 ? 2u : 1u;
+}
+static inline uint32_t loom_aie2p_panel_units(uint64_t repeat_count) {
+  return (uint32_t)(repeat_count / loom_aie2p_panel_pair(repeat_count));
+}
 
