Subject: [PATCH 28/70] 0025-loom-xdna-east-neighbor-intake-depths

Two Loom AIE2P array fixes for the gate placement that frees the gate column's fill (yah gen_npu_gemm gwest):
- A worker channel to the sender's east neighbor (same row) is neighbor memory: the receiver loads the sender's
  memory through its west window, as vertical neighbors do through north / south. It was routed as a DMA stream.
- An intake multicast's members may have rings of different depth (one filler's compact single-record raw ring, the
  other's two records). The shared stage ring has the source member's depth; a deeper member's drain indexed stage
  records past it (another buffer: its decoder read garbage for every other raw record). A member's drain chain now
  covers both depths and takes the stage records in turn. Equal depths (every earlier image) are byte-identical.

(cherry picked from commit 0c4eaf39267a88f976a07221586f45555e1c51a4)
---
 .../src/loom/target/arch/amd/xdna/aie2p/array/plan.c | 12 +++++++++---
 .../loom/target/arch/amd/xdna/aie2p/array/program.c  |  7 ++++++-
 .../loom/target/arch/amd/xdna/aie2p/array/topology.c |  8 +++++++-
 3 files changed, 22 insertions(+), 5 deletions(-)

diff --git a/loom/src/loom/target/arch/amd/xdna/aie2p/array/plan.c b/loom/src/loom/target/arch/amd/xdna/aie2p/array/plan.c
index a731ea8d35..098a3b0ae4 100644
--- a/loom/src/loom/target/arch/amd/xdna/aie2p/array/plan.c
+++ b/loom/src/loom/target/arch/amd/xdna/aie2p/array/plan.c
@@ -3438,7 +3438,13 @@ static iree_status_t loom_aie2p_array_plan_intake_channel(
       &stage_state->memory_tile_bd_cursors[panel_drain->dma_channel & 1u];
   loom_aie2p_array_tile_resources_t* core_resources =
       &loom_aie2p_array_tile_state(builder, worker->coordinate)->resources;
-  if (*drain_cursor + capacity > half_capacity ||
+  // The member drains the source's stage records in turn: its chain covers
+  // both its own ring and the stage ring (members' capacities may differ).
+  const uint32_t stage_count =
+      builder->dma_channels[source->intake_fill_dma].buffer_descriptor_count;
+  uint32_t drain_count = capacity;
+  while (drain_count % stage_count != 0) drain_count += capacity;
+  if (*drain_cursor + drain_count > half_capacity ||
       (uint32_t)core_resources->next_buffer_descriptor + capacity >
           core_resources->facts->dma.buffer_descriptor_count ||
       (uint32_t)core_resources->next_lock + 2u >
@@ -3450,7 +3456,7 @@ static iree_status_t loom_aie2p_array_plan_intake_channel(
   const uint16_t drain_bd =
       (uint16_t)((panel_drain->dma_channel & 1u) * half_capacity +
                  *drain_cursor);
-  *drain_cursor += capacity;
+  *drain_cursor += drain_count;
   channel->intake_drain_dma = (uint32_t)builder->dma_channel_cursor;
   builder->dma_channels[builder->dma_channel_cursor++] =
       (loom_aie2p_array_dma_plan_t){
@@ -3461,7 +3467,7 @@ static iree_status_t loom_aie2p_array_plan_intake_channel(
           .flags = LOOM_AIE2P_ARRAY_DMA_FLAG_MEMORY_TILE |
                    LOOM_AIE2P_ARRAY_DMA_FLAG_INTAKE,
           .buffer_descriptor_start = drain_bd,
-          .buffer_descriptor_count = capacity,
+          .buffer_descriptor_count = (uint16_t)drain_count,
           .credit_lock_index = source->intake_chain_lock,
           .stage_record_base = source->stage_first_record,
       };
diff --git a/loom/src/loom/target/arch/amd/xdna/aie2p/array/program.c b/loom/src/loom/target/arch/amd/xdna/aie2p/array/program.c
index 086f4f65e3..4eb20ae430 100644
--- a/loom/src/loom/target/arch/amd/xdna/aie2p/array/program.c
+++ b/loom/src/loom/target/arch/amd/xdna/aie2p/array/program.c
@@ -994,6 +994,10 @@ static iree_status_t loom_aie2p_program_build_intake_memory_tile_descriptor(
       release_lock->lock_id, &release_selector));
   const loom_xdna_tile_facts_t* tile =
       loom_xdna_array_tile_facts(plan->family, dma->coordinate);
+  // A member's drain chain may be longer than the stage ring (its own ring
+  // is deeper): its descriptors take the stage records in turn.
+  const uint32_t stage_count =
+      plan->dma_channels[source->intake_fill_dma].buffer_descriptor_count;
   const uint16_t buffer_descriptor =
       dma->buffer_descriptor_start + (uint16_t)slot_ordinal;
   const uint16_t indices[] = {buffer_descriptor};
@@ -1015,7 +1019,8 @@ static iree_status_t loom_aie2p_program_build_intake_memory_tile_descriptor(
   loom_aie2p_program_encode_admitted_field(
       LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD1_BASE_ADDRESS,
       (tile->memory.local_load_base +
-       plan->stage_record_offsets[dma->stage_record_base + slot_ordinal]) >>
+       plan->stage_record_offsets[dma->stage_record_base +
+                                  slot_ordinal % stage_count]) >>
           tile->dma.address_encoding_shift,
       &words[1]);
   const bool last = slot_ordinal + 1u == dma->buffer_descriptor_count;
diff --git a/loom/src/loom/target/arch/amd/xdna/aie2p/array/topology.c b/loom/src/loom/target/arch/amd/xdna/aie2p/array/topology.c
index 32c13b90b5..863bb0e537 100644
--- a/loom/src/loom/target/arch/amd/xdna/aie2p/array/topology.c
+++ b/loom/src/loom/target/arch/amd/xdna/aie2p/array/topology.c
@@ -1108,8 +1108,14 @@ iree_status_t loom_aie2p_array_topology_validate(
           sender_worker->coordinate.column ==
               receiver_worker->coordinate.column &&
           (row_delta == -1 || row_delta == 1);
+      // The receiver east of the sender loads the sender's memory through its
+      // west window (a core sees its own, north, south and west memory).
+      const bool receiver_is_east_neighbor =
+          row_delta == 0 && (int)receiver_worker->coordinate.column ==
+                                (int)sender_worker->coordinate.column + 1;
       // a core stream between two workers is a route (no memory, no DMA)
-      if (workers_are_vertical_neighbors && !channel->core_stream) {
+      if ((workers_are_vertical_neighbors || receiver_is_east_neighbor) &&
+          !channel->core_stream) {
         channel->transport = LOOM_AIE2P_ARRAY_CHANNEL_TRANSPORT_NEIGHBOR_MEMORY;
         channel->neighbor_receiver_window = loom_xdna_array_load_window(
             topology->plan->family, receiver_worker->coordinate,
