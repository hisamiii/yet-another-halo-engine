+// Splits the control records into invocation ranges. Ranges depend only on
+// the program, so admission sizes the invocation and relocation tables before
+// command layout is measured.
+static void loom_aie2p_xdna_plan_invocations(
+    const loom_aie2p_array_program_t* program,
+    loom_aie2p_xdna_entry_layout_t* layout) {
+  const uint32_t control_count = (uint32_t)program->control_record_count;
+  // EXPERIMENT LOOM_EXP_SETUP_ONLY=1: for streamed and gated-call plans,
+  // invocation 0 is the array setup alone (no first call), so a runtime can
+  // splice an image's setup into a command between other images' jobs.
+  const char* setup_only_flag = getenv("LOOM_EXP_SETUP_ONLY");
+  const bool setup_only = setup_only_flag != NULL && setup_only_flag[0] == '1';
+  if (program->stream_push_end != 0) {
+    // [even push | waits | odd push | lead push]: array + even push + waits,
+    // even push, odd push, waits, lead push. A gated plan ends the lead push
+    // at stream_lead_end and appends [gate | done] as two more invocations.
+    const uint32_t push = (uint32_t)program->stream_push_end;
+    const uint32_t wait = (uint32_t)program->stream_wait_end;
+    const uint32_t odd = (uint32_t)program->stream_odd_end;
+    const bool gated = program->stream_lead_end != 0;
+    const uint32_t lead_end =
+        gated ? (uint32_t)program->stream_lead_end : control_count;
+    const uint32_t gate_end = (uint32_t)program->stream_gate_end;
+    const uint32_t begins[LOOM_AIE2P_XDNA_MAX_INVOCATION_COUNT] = {
+        0, 0, wait, push, odd, lead_end, gate_end};
+    const uint32_t ends[LOOM_AIE2P_XDNA_MAX_INVOCATION_COUNT] = {
+        wait, push, odd, wait, lead_end, gate_end, control_count};
+    layout->invocation_count = gated ? 7u : 5u;
+    memcpy(layout->range_begin, begins, sizeof(begins));
+    memcpy(layout->range_end, ends, sizeof(ends));
+    if (setup_only) {
+      layout->range_end[0] = 0;
+    }
+  } else if (program->gated_call_end != 0) {
+    // [call | gate | done]: array + call, call, gate, done.
+    const uint32_t call_end = (uint32_t)program->gated_call_end;
+    const uint32_t gate_end = (uint32_t)program->gated_gate_end;
+    const uint32_t begins[4] = {0, 0, call_end, gate_end};
+    const uint32_t ends[4] = {call_end, call_end, gate_end, control_count};
+    layout->invocation_count = 4;
+    memcpy(layout->range_begin, begins, sizeof(begins));
+    memcpy(layout->range_end, ends, sizeof(ends));
+    if (setup_only) {
+      layout->range_end[0] = 0;
+    }
+  } else {
+    // Array + every record, then every record again.
+    layout->invocation_count = 2;
+    layout->range_begin[0] = layout->range_begin[1] = 0;
+    layout->range_end[0] = layout->range_end[1] = control_count;
+  }
+  layout->relocation_count = 0;
+  layout->cut_count = 0;
+  for (uint32_t k = 0; k < layout->invocation_count; ++k) {
+    for (iree_host_size_t j = 0; j < program->relocation_count; ++j) {
+      const uint32_t target = program->relocations[j].target_record_index;
+      if (target >= layout->range_begin[k] && target < layout->range_end[k]) {
+        ++layout->relocation_count;
+      }
+    }
+    const uint32_t bounds[2] = {layout->range_begin[k], layout->range_end[k]};
+    for (uint32_t b = 0; b < 2; ++b) {
+      uint32_t c = 0;
+      while (c < layout->cut_count && layout->cuts[c] != bounds[b]) {
+        ++c;
+      }
+      if (c == layout->cut_count) {
+        layout->cuts[layout->cut_count++] = bounds[b];
+      }
+    }
+  }
+  for (uint32_t a = 1; a < layout->cut_count; ++a) {
+    for (uint32_t b = a; b > 0 && layout->cuts[b - 1] > layout->cuts[b]; --b) {
+      const uint32_t cut = layout->cuts[b];
+      layout->cuts[b] = layout->cuts[b - 1];
+      layout->cuts[b - 1] = cut;
+    }
+  }
+}
