+// Returns true when control fragment |c| (between cuts c and c + 1) is
+// nonempty and loaded by invocation |k|.
+static bool loom_aie2p_xdna_invocation_loads_fragment(
+    const loom_aie2p_xdna_entry_layout_t* layout, uint32_t k, uint32_t c) {
+  return layout->cuts[c + 1] > layout->cuts[c] &&
+         layout->cuts[c] >= layout->range_begin[k] &&
+         layout->cuts[c + 1] <= layout->range_end[k];
+}
