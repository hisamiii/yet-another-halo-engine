+// The exchange and the final V_PERM_B32 read bytes 0..1 of every source
+// register only. When the source fragment is built by vector.from_elements,
+// lane 2 i alone feeds register i: take that lane's register as it is and leave
+// the 16-bit pair packing (dead when nothing else reads it) unemitted.
+static iree_status_t loom_amdgpu_fragment_repack_lane_registers(
+    loom_low_lower_context_t* context, const loom_op_t* source_op,
+    const loom_amdgpu_fragment_repack_plan_t* plan,
+    loom_value_id_t* source_registers, bool* out_from_lanes) {
+  *out_from_lanes = false;
+  const loom_module_t* module = loom_low_lower_context_module(context);
+  const loom_op_t* def = loom_value_def_op(loom_module_value(module, plan->source));
+  if (def != NULL && loom_vector_fragment_isa(def)) {
+    def = loom_value_def_op(
+        loom_module_value(module, loom_vector_fragment_data(def)));
+  }
+  if (def == NULL || !loom_vector_from_elements_isa(def)) {
+    return iree_ok_status();
+  }
+  const loom_value_slice_t elements = loom_vector_from_elements_elements(def);
+  if (elements.count != (iree_host_size_t)plan->source_register_count * 2u) {
+    return iree_ok_status();
+  }
+  for (uint16_t i = 0; i < plan->source_register_count; ++i) {
+    loom_value_id_t lane = LOOM_VALUE_ID_INVALID;
+    IREE_RETURN_IF_ERROR(loom_low_lower_lookup_value(
+        context, loom_value_slice_get(elements, 2u * i), &lane));
+    if (lane == LOOM_VALUE_ID_INVALID) {
+      return iree_ok_status();
+    }
+    source_registers[i] = lane;
+  }
+  for (uint16_t i = 0; i < plan->source_register_count; ++i) {
+    IREE_RETURN_IF_ERROR(loom_amdgpu_materialize_low_vgpr_b32(
+        context, source_op, source_registers[i], &source_registers[i]));
+  }
+  *out_from_lanes = true;
+  return iree_ok_status();
+}
