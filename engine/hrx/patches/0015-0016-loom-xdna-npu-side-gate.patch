+// A core stream channel (constrain.core_stream): the shim DMA and a route that
+// ends at, or starts from, the worker core's stream port. The worker owns no
+// DMA, ring, slots, or locks for it, and it is not one of the worker's ports.
+static iree_status_t loom_aie2p_array_plan_core_stream_channel(
+    loom_aie2p_array_plan_builder_t* builder, uint32_t channel_index,
+    const loom_aie2p_array_endpoint_t* sender,
+    const loom_aie2p_array_endpoint_t* receiver) {
+  loom_aie2p_array_channel_t* channel = &builder->channels[channel_index];
+  const bool ingress = iree_any_bit_set(
+      channel->resource_flags,
+      LOOM_AIE2P_ARRAY_CHANNEL_RESOURCE_FLAG_OWNS_SHIM_MEMORY_TO_STREAM);
+  const loom_aie2p_array_worker_t* worker =
+      &builder->workers[(ingress ? receiver : sender)->owner_index];
+  // Its whole chain: a streamed plan queues core stream channels only in its
+  // gate and done invocations, not on alternating descriptor sets.
+  const uint16_t shim_descriptor_count =
+      channel->signal
+          ? 2
+          : iree_max(1, builder->binding_plans[channel->binding_plan_index]
+                            .chain_length);
+  // A request's tick shares its poll's shim tile (planned first) and lock.
+  const loom_aie2p_array_dma_plan_t* poll_dma =
+      channel->request_partner != UINT32_MAX && !channel->request_poll
+          ? &builder->dma_channels
+                 [builder->binding_plans[builder->channels[channel->request_partner]
+                                             .binding_plan_index]
+                      .dma_index]
+          : NULL;
+  loom_aie2p_array_shim_endpoint_proposal_t shim_proposal = {0};
+  if (!loom_aie2p_array_select_shim_endpoint(
+          builder,
+          poll_dma ? poll_dma->coordinate.column : worker->coordinate.column,
+          ingress ? LOOM_AIE2P_ARRAY_DMA_DIRECTION_MEMORY_TO_STREAM
+                  : LOOM_AIE2P_ARRAY_DMA_DIRECTION_STREAM_TO_MEMORY,
+          shim_descriptor_count, &shim_proposal) ||
+      (poll_dma &&
+       !loom_aie2p_array_coordinates_equal(shim_proposal.coordinate,
+                                           poll_dma->coordinate))) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, worker->coordinate,
+        IREE_SV("no shim tile has a free DMA channel and buffer descriptor "
+                "for the core stream (a request's tick needs its poll's tile)"));
+  }
+  const uint32_t shim_dma_index = loom_aie2p_array_commit_shim_endpoint(
+      builder, channel_index, &shim_proposal);
+  const loom_aie2p_array_dma_plan_t* shim_dma =
+      &builder->dma_channels[shim_dma_index];
+  if (channel->request_poll) {
+    loom_aie2p_array_tile_resources_t* resources =
+        &loom_aie2p_array_tile_state(builder, shim_dma->coordinate)->resources;
+    if (resources->next_lock >= resources->facts->lock_count) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, channel_index, worker->coordinate,
+          IREE_SV("the request's shim tile has no free lock"));
+    }
+    channel->request_lock_id = resources->next_lock++;
+    builder->locks[builder->lock_cursor++] = (loom_aie2p_array_lock_plan_t){
+        .channel_index = channel_index,
+        .coordinate = shim_dma->coordinate,
+        .lock_id = channel->request_lock_id,
+        .initial_value = 0,
+        .ring_endpoint_direction = LOOM_AIE2P_ARRAY_ENDPOINT_DIRECTION_RECEIVE,
+        .consumer_ready = 0,
+    };
+  } else if (poll_dma) {
+    channel->request_lock_id =
+        builder->channels[channel->request_partner].request_lock_id;
+  }
+  if (ingress) {
+    channel->sender_dma_index = shim_dma_index;
+  }
+  const bool routed =
+      ingress ? loom_aie2p_array_route_ingress(
+                    &builder->route_builder, channel_index,
+                    channel->source_channel_index, shim_dma->coordinate,
+                    shim_dma->dma_channel, worker->coordinate,
+                    LOOM_XDNA_STREAM_PORT_CORE, 0, /*vertical_first=*/false)
+              : loom_aie2p_array_route_egress(
+                    &builder->route_builder, channel_index,
+                    channel->source_channel_index, worker->coordinate,
+                    LOOM_XDNA_STREAM_PORT_CORE, 0, shim_dma->coordinate,
+                    shim_dma->dma_channel);
+  if (!routed) {
+    return loom_aie2p_array_diagnose_route_capacity(builder, channel_index);
+  }
+  loom_aie2p_array_binding_plan_t* binding_plan =
+      &builder->binding_plans[channel->binding_plan_index];
+  binding_plan->dma_index = shim_dma_index;
+  binding_plan->completion_route_index =
+      ingress ? UINT32_MAX
+              : loom_aie2p_array_plan_completion_route(builder,
+                                                       shim_dma->coordinate);
+  return iree_ok_status();
+}
