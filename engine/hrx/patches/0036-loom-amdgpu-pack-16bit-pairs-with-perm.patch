+#define LOOM_AMDGPU_B16_PAIR_PERMUTE_SELECTOR UINT32_C(0x05040100)
+
+// Packs lanes |lane_base| (bits 0..15) and |lane_base| + 1 (bits 16..31) with one
+// V_PERM_B32 instead of clearing, shifting and or-ing the two halves.
