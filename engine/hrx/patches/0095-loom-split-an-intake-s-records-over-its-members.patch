   const loom_diagnostic_emission_t emission = {
       .op = loom_value_def_op(loom_value_table_const_value(
@@ -3853,23 +3860,58 @@
 // with descriptors and locks of its own. The chain locks order the members:
 // the fill releases member 0's ready lock, each member's drain the next one's,
 // the last member's the fill's free lock.
+// The memory-tile drain DMA index of an intake's panel multicast.
+static uint32_t loom_aie2p_array_intake_drain_index(
+    const loom_aie2p_array_plan_builder_t* builder,
+    const loom_aie2p_array_channel_t* channel) {
+  const uint32_t source =
+      builder->channels[channel->intake_panel].source_channel_index;
+  const loom_aie2p_array_channel_t* panel = &builder->channels[source];
+  if (panel->stage_dma_index == UINT32_MAX) return UINT32_MAX;
+  return panel->stage_dma_index +
+         (panel->stage_panel_owner == source ? 1u : 0u);
+}
+
+// The earlier member of |channel_index|'s intake multicast whose panel shares
+// its drain (multicast siblings: one drain feeds both), or UINT32_MAX.
+static uint32_t loom_aie2p_array_intake_sibling_of(
+    const loom_aie2p_array_plan_builder_t* builder, uint32_t channel_index) {
+  const loom_aie2p_array_channel_t* channel = &builder->channels[channel_index];
+  const uint32_t drain = loom_aie2p_array_intake_drain_index(builder, channel);
+  if (drain == UINT32_MAX) return UINT32_MAX;
+  for (uint32_t i = channel->source_channel_index; i < channel_index; ++i) {
+    const loom_aie2p_array_channel_t* other = &builder->channels[i];
+    if (other->source_channel_index == channel->source_channel_index &&
+        loom_aie2p_array_channel_is_intake(other) &&
+        loom_aie2p_array_intake_drain_index(builder, other) == drain) {
+      return other->intake_sibling != UINT32_MAX ? other->intake_sibling : i;
+    }
+  }
+  return UINT32_MAX;
+}
