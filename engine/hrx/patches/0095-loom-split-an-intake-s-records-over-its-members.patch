+// LOOM_EXP_INTAKE_STAGE_DEPTH=N (EXPERIMENT): the memory-tile ring of an
+// intake holds N records (N dividing |record_count|) instead of |capacity|,
+// more DRAM reads in flight than the members' rings allow.
+static inline uint8_t loom_aie2p_array_intake_stage_depth(
+    uint8_t capacity, uint32_t record_count) {
+  const char* env = getenv("LOOM_EXP_INTAKE_STAGE_DEPTH");
+  const int depth = env ? atoi(env) : 0;
+  return depth > 0 && depth <= 16 && record_count % (uint32_t)depth == 0
+             ? (uint8_t)depth
+             : capacity;
+}
+
+// LOOM_EXP_INTAKE_SPLIT=1 (EXPERIMENT): an intake's members (not siblings)
+// take the stage ring's records in turn (member m: records m, m + n, ...;
+// stage depth a multiple of n), each drained as soon as it lands, in parallel.
+// Each member owns its slots' free lock (depth / n credits: the fill writes in
+// order, the members drain apart): member 0's is the chain lock, member m's
+// (m > 0) chain + n + m.
+static inline bool loom_aie2p_array_intake_split(void) {
+  const char* env = getenv("LOOM_EXP_INTAKE_SPLIT");
+  return env && atoi(env) != 0;
+}
