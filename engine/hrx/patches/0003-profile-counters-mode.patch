@@ -630,6 +630,13 @@ static iree_status_t hrx_get_profile_data_families(
   } else if (strcmp(value, "executable") == 0) {
     *out_data_families = IREE_HAL_DEVICE_PROFILING_DATA_EXECUTABLE_METADATA |
                          IREE_HAL_DEVICE_PROFILING_DATA_EXECUTABLE_TRACES;
+  } else if (strcmp(value, "counters") == 0) {
+    // Local profiling-only addition: per-dispatch hardware counter samples,
+    // names from HRX_PROFILE_COUNTERS (comma separated), with dispatch events.
+    *out_data_families = IREE_HAL_DEVICE_PROFILING_DATA_EXECUTABLE_METADATA |
+                         IREE_HAL_DEVICE_PROFILING_DATA_DEVICE_QUEUE_EVENTS |
+                         IREE_HAL_DEVICE_PROFILING_DATA_DISPATCH_EVENTS |
+                         IREE_HAL_DEVICE_PROFILING_DATA_COUNTER_SAMPLES;
   } else if (strcmp(value, "all") == 0) {
     *out_data_families = IREE_HAL_DEVICE_PROFILING_DATA_QUEUE_EVENTS |
                          IREE_HAL_DEVICE_PROFILING_DATA_EXECUTABLE_METADATA |
@@ -653,6 +660,26 @@ static iree_status_t hrx_device_profile_begin(hrx_device_s* device,
   iree_hal_device_profiling_options_t options = {0};
   IREE_RETURN_IF_ERROR(hrx_get_profile_data_families(&options.data_families));
   options.sink = sink;
+  // HRX_PROFILE_COUNTERS="A,B,C" (with HRX_PROFILE_MODE=counters): strict set.
+  iree_string_view_t counter_names[16];
+  iree_hal_profile_counter_set_selection_t counter_set = {0};
+  const char* counter_env = getenv("HRX_PROFILE_COUNTERS");
+  if ((options.data_families & IREE_HAL_DEVICE_PROFILING_DATA_COUNTER_SAMPLES) &&
+      counter_env && counter_env[0]) {
+    iree_string_view_t rest = iree_make_cstring_view(counter_env);
+    iree_host_size_t count = 0;
+    while (rest.size && count < IREE_ARRAYSIZE(counter_names)) {
+      iree_string_view_t head = iree_string_view_empty();
+      iree_string_view_split(rest, ',', &head, &rest);
+      head = iree_string_view_trim(head);
+      if (head.size) counter_names[count++] = head;
+    }
+    counter_set.name = IREE_SV("hrx_env");
+    counter_set.counter_name_count = count;
+    counter_set.counter_names = counter_names;
+    options.counter_set_count = 1;
+    options.counter_sets = &counter_set;
+  }
   iree_status_t status =
       iree_hal_device_profiling_begin(device->hal_device, &options);
   if (iree_status_is_ok(status)) {
