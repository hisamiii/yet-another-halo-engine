+bool loom_low_lower_alias_scope_is_entry_argument(
+    loom_low_lower_context_t* context,
+    loom_value_fact_alias_scope_id_t alias_scope_id) {
+  const loom_op_t* function_op =
+      loom_low_lower_context_source_function(context).op;
+  if (alias_scope_id == LOOM_VALUE_FACT_ALIAS_SCOPE_ID_NONE ||
+      function_op == NULL || function_op->region_count == 0) {
+    return false;
+  }
+  // Kernel-like functions may carry their arguments on a later region (the
+  // launch region); any region's entry block of the function op itself counts.
+  loom_region_t** regions = loom_op_regions(function_op);
+  for (uint8_t r = 0; r < function_op->region_count; ++r) {
+    const loom_region_t* region = regions[r];
+    if (region->block_count == 0) {
+      continue;
+    }
+    for (uint16_t i = 0; i < loom_region_entry_arg_count(region); ++i) {
+      if (loom_region_entry_arg_id(region, i) == alias_scope_id) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
