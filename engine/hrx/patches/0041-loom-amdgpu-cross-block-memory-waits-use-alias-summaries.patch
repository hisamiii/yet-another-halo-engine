+enum {
+  // No write anywhere in the function may alias this node's dependency reads.
+  LOOM_AMDGPU_WAIT_PLAN_CROSS_BLOCK_READ_INDEPENDENT = 1u << 0,
+  // No read anywhere in the function may alias this node's dependency writes.
+  LOOM_AMDGPU_WAIT_PLAN_CROSS_BLOCK_WRITE_INDEPENDENT = 1u << 1,
+};
+
+typedef struct loom_amdgpu_wait_plan_summary_use_t {
+  // Scheduled node carrying the effect.
+  uint32_t node_index;
+  // Source summary, or the conservative summary of the effect's space.
+  const loom_low_memory_access_summary_t* summary;
+} loom_amdgpu_wait_plan_summary_use_t;
+
+// The cross-block memory frontier tracks pending accesses per memory space
+// only, so a global load after a block that stored to another buffer would
+// drain every store. When the source memory summaries prove that no opposite
+// access anywhere in the function may alias a node's dependency accesses, no
+// path through the CFG makes that drain a dependency. Nodes whose memory
+// spaces come from traits (no descriptor effects, volatile) stay conservative
+// and keep every opposite access dependent.
+static iree_status_t loom_amdgpu_wait_plan_classify_cross_block_independence(
+    loom_amdgpu_wait_plan_builder_t* builder) {
+  const loom_low_schedule_table_t* schedule = builder->schedule;
+  if (schedule->memory_accesses == NULL || schedule->node_count == 0) {
+    return iree_ok_status();
+  }
+  uint8_t* effect_bits = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      builder->transient_arena, schedule->node_count, sizeof(*effect_bits),
+      (void**)&effect_bits));
+  memset(effect_bits, 0, schedule->node_count * sizeof(*effect_bits));
+  iree_host_size_t read_count = 0, write_count = 0;
+  for (iree_host_size_t i = 0; i < schedule->effect_use_count; ++i) {
+    const loom_low_schedule_effect_use_t* effect = &schedule->effect_uses[i];
+    if (!loom_amdgpu_wait_effect_is_dependency_memory(effect)) continue;
+    if (effect->kind == LOOM_LOW_EFFECT_KIND_READ) {
+      effect_bits[effect->node_index] |=
+          LOOM_AMDGPU_WAIT_PLAN_CROSS_BLOCK_READ_INDEPENDENT;
+      ++read_count;
+    } else if (effect->kind == LOOM_LOW_EFFECT_KIND_WRITE) {
+      effect_bits[effect->node_index] |=
+          LOOM_AMDGPU_WAIT_PLAN_CROSS_BLOCK_WRITE_INDEPENDENT;
+      ++write_count;
+    }
+  }
+  // Space flags not explained by descriptor effects are opaque accesses; only
+  // counter-backed ones can remain pending across a block edge.
+  bool opaque_read = false, opaque_write = false;
+  for (iree_host_size_t i = 0; i < schedule->node_count; ++i) {
+    const loom_amdgpu_wait_frontier_node_t* node = &builder->frontier_nodes[i];
+    const bool volatile_access =
+        schedule->nodes[i].descriptor != NULL &&
+        iree_any_bit_set(schedule->nodes[i].op->instance_flags,
+                         LOOM_MEMORY_ACCESS_FLAG_VOLATILE);
+    if (node->read_space_flags != 0 && node->read_counter_mask != 0 &&
+        (volatile_access ||
+         !iree_any_bit_set(effect_bits[i],
+                           LOOM_AMDGPU_WAIT_PLAN_CROSS_BLOCK_READ_INDEPENDENT))) {
+      opaque_read = true;
+    }
+    if (node->write_space_flags != 0 && node->write_counter_mask != 0 &&
+        (volatile_access ||
+         !iree_any_bit_set(
+             effect_bits[i],
+             LOOM_AMDGPU_WAIT_PLAN_CROSS_BLOCK_WRITE_INDEPENDENT))) {
+      opaque_write = true;
+    }
+  }
+  if (opaque_read && opaque_write) {
+    return iree_ok_status();
+  }
+  loom_amdgpu_wait_plan_summary_use_t* reads = NULL;
+  loom_amdgpu_wait_plan_summary_use_t* writes = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      builder->transient_arena, iree_max(read_count, 1), sizeof(*reads),
+      (void**)&reads));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      builder->transient_arena, iree_max(write_count, 1), sizeof(*writes),
+      (void**)&writes));
+  read_count = write_count = 0;
+  for (iree_host_size_t i = 0; i < schedule->effect_use_count; ++i) {
+    const loom_low_schedule_effect_use_t* effect = &schedule->effect_uses[i];
+    if (!loom_amdgpu_wait_effect_is_dependency_memory(effect)) continue;
+    const loom_low_memory_access_summary_t* summary =
+        loom_low_memory_access_map_lookup(schedule->memory_accesses,
+                                          schedule->nodes[effect->node_index].op,
+                                          effect->effect_ordinal);
+    if (summary == NULL) {
+      summary = loom_low_memory_access_summary_for_space(effect->memory_space);
+    }
+    const loom_amdgpu_wait_plan_summary_use_t use = {
+        .node_index = effect->node_index,
+        .summary = summary,
+    };
+    if (effect->kind == LOOM_LOW_EFFECT_KIND_READ) {
+      reads[read_count++] = use;
+    } else if (effect->kind == LOOM_LOW_EFFECT_KIND_WRITE) {
+      writes[write_count++] = use;
+    }
+  }
+  for (iree_host_size_t i = 0; i < schedule->node_count; ++i) {
+    if (opaque_write) {
+      effect_bits[i] &= ~LOOM_AMDGPU_WAIT_PLAN_CROSS_BLOCK_READ_INDEPENDENT;
+    }
+    if (opaque_read) {
+      effect_bits[i] &= ~LOOM_AMDGPU_WAIT_PLAN_CROSS_BLOCK_WRITE_INDEPENDENT;
+    }
+  }
+  for (iree_host_size_t r = 0; r < read_count; ++r) {
+    for (iree_host_size_t w = 0; w < write_count; ++w) {
+      if (loom_low_memory_access_summaries_may_alias(
+              reads[r].summary, writes[w].summary,
+              LOOM_LOW_MEMORY_COMPARISON_INDEPENDENT)) {
+        effect_bits[reads[r].node_index] &=
+            ~LOOM_AMDGPU_WAIT_PLAN_CROSS_BLOCK_READ_INDEPENDENT;
+        effect_bits[writes[w].node_index] &=
+            ~LOOM_AMDGPU_WAIT_PLAN_CROSS_BLOCK_WRITE_INDEPENDENT;
+      }
+    }
+  }
+  builder->cross_block_independence = effect_bits;
+  return iree_ok_status();
+}
