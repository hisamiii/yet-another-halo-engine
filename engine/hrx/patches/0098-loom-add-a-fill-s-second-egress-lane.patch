+// A fill's second egress lane (a second constrain.fill of |channel_index|, a
+// streamed interleaved one-member panel): the second writer takes the odd
+// interleave units on the stream-to-memory channel where its worker's merged
+// C egress lands (idle in the fill; per push, its descriptor runs before the C
+// ring). It frees its done lock; the first writer, now the even units, waits
+// on it in its last descriptor before it releases the panel.
+static iree_status_t loom_aie2p_array_plan_fill_lane2(
+    loom_aie2p_array_plan_builder_t* builder, uint32_t channel_index) {
+  loom_aie2p_array_channel_t* panel = &builder->channels[channel_index];
+  const loom_xdna_tile_coordinate_t coordinate = {panel->stage_column, 1};
+  const loom_aie2p_array_channel_t* source =
+      &builder->channels[panel->fill_source2];
+  if (source->lane2_share == UINT32_MAX ||
+      source->sender_dma_index == UINT32_MAX) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, coordinate,
+        IREE_SV("a fill's second egress lane must precede the panel it fills"));
+  }
+  const loom_aie2p_array_channel_t* c = &builder->channels[source->lane2_share];
+  if (c->stage_dma_index == UINT32_MAX ||
+      builder->dma_channels[c->stage_dma_index].coordinate.column !=
+          panel->stage_column ||
+      panel->stage_panel_owner != channel_index ||
+      panel->stage_panel_unit_bytes == 0 || !panel->stage_panel_stream ||
+      panel->stage_panel_group_count != 1 || panel->stage_record_count != 1 ||
+      panel->stage_panel_unit_bytes / 4u > 1023u ||
+      (panel->stage_panel_group_records[0] * builder->plan->panel_interleave) %
+              2u != 0) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, coordinate,
+        IREE_SV("a fill's second egress lane needs a streamed interleaved "
+                "one-member panel of an even unit count and its C egress "
+                "landing in the panel's memory tile"));
+  }
+  const loom_aie2p_array_dma_plan_t* c_fill =
+      &builder->dma_channels[c->stage_dma_index];
+  loom_aie2p_array_tile_state_t* state =
+      loom_aie2p_array_tile_state(builder, coordinate);
+  loom_aie2p_array_tile_resources_t* resources = &state->resources;
+  const uint16_t half_capacity =
+      (uint16_t)(resources->facts->dma.buffer_descriptor_count / 2u);
+  uint16_t* cursor = &state->memory_tile_bd_cursors[c_fill->dma_channel & 1u];
+  if (*cursor + 1u > half_capacity ||
+      (uint32_t)resources->next_lock + 2u > resources->facts->lock_count) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, coordinate,
+        IREE_SV("no descriptor or lock left for a fill's second egress lane"));
+  }
+  const uint16_t bd =
+      (uint16_t)((c_fill->dma_channel & 1u) * half_capacity + *cursor);
+  *cursor += 1u;
+  panel->lane2_lock = (uint32_t)builder->lock_cursor;
+  builder->locks[builder->lock_cursor++] = (loom_aie2p_array_lock_plan_t){
+      .channel_index = channel_index,
+      .coordinate = coordinate,
+      .lock_id = resources->next_lock++,
+      .initial_value = 0,
+      .ring_endpoint_direction = LOOM_AIE2P_ARRAY_ENDPOINT_DIRECTION_RECEIVE,
+      .consumer_ready = 1,
+  };
+  // (its go lock, right after: the first writer's first unit, past the
+  // panel's credit, frees the second writer)
+  builder->locks[builder->lock_cursor++] = (loom_aie2p_array_lock_plan_t){
+      .channel_index = channel_index,
+      .coordinate = coordinate,
+      .lock_id = resources->next_lock++,
+      .initial_value = 0,
+      .ring_endpoint_direction = LOOM_AIE2P_ARRAY_ENDPOINT_DIRECTION_RECEIVE,
+      .consumer_ready = 1,
+  };
+  panel->lane2_fill_dma = (uint32_t)builder->dma_channel_cursor;
+  builder->dma_channels[builder->dma_channel_cursor++] =
+      (loom_aie2p_array_dma_plan_t){
+          .channel_index = channel_index,
+          .coordinate = coordinate,
+          .direction = LOOM_XDNA_DMA_DIRECTION_STREAM_TO_MEMORY,
+          .dma_channel = c_fill->dma_channel,
+          .flags = LOOM_AIE2P_ARRAY_DMA_FLAG_MEMORY_TILE |
+                   LOOM_AIE2P_ARRAY_DMA_FLAG_LANE2,
+          .buffer_descriptor_start = bd,
+          .buffer_descriptor_count = 1,
+          .credit_lock_index = panel->lane2_lock,
+          .stage_record_base =
+              builder->dma_channels[panel->stage_dma_index].stage_record_base,
+      };
+  if (getenv("LOOM_EXP_ROUTE_DUMP")) {
+    fprintf(stderr,
+            "lane2: panel %u source %u shares channel %u (core dma %u, memory "
+            "tile s2mm %u bd %u lock %u)\n",
+            channel_index, panel->fill_source2, source->lane2_share,
+            builder->dma_channels[source->sender_dma_index].dma_channel,
+            c_fill->dma_channel, bd,
+            builder->locks[panel->lane2_lock].lock_id);
+  }
+  return iree_ok_status();
+}
