+    loom_low_placement_preference_index_t* out_index) {
+  const uint32_t use_count = (uint32_t)state->preferences.use_count;
+  if (use_count == 0) {
+    return iree_ok_status();
+  }
+  const uint32_t binding_count = (uint32_t)state->preferences.binding_count;
+  const uint32_t instruction_use_count =
+      state->preferences.instruction_use_count;
+  loom_low_placement_preference_use_t* uses = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      state->preference_arena, use_count, sizeof(*uses), (void**)&uses));
+  memcpy(uses, state->preferences.uses, use_count * sizeof(*uses));
+  loom_low_placement_preference_binding_t* bindings = NULL;
+  IREE_RETURN_IF_ERROR(
+      iree_arena_allocate_array(state->preference_arena, binding_count,
+                                sizeof(*bindings), (void**)&bindings));
+  memcpy(bindings, state->preferences.bindings,
+         binding_count * sizeof(*bindings));
+  *out_index = (loom_low_placement_preference_index_t){
+      .uses = uses,
+      .bindings = bindings,
+      .use_count = use_count,
+      .instruction_use_count = instruction_use_count,
+      .binding_count = binding_count,
+  };
+  if (instruction_use_count != use_count) {
+    IREE_RETURN_IF_ERROR(loom_low_placement_index_preference_incidence(
+        state, instruction_use_count,
+        state->tied_storage_origins_by_value_ordinal, bindings, out_index));
+  }
+  if (instruction_use_count == 0) {
+    return iree_ok_status();
+  }
+
+  // The companion index lets assignment queries see instruction uses too.
+  // Allocation adopts its result only when residency does not drop.
+  loom_low_placement_preference_index_t* aware = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate(
+      state->preference_arena, sizeof(*aware), (void**)&aware));
+  loom_low_placement_preference_binding_t* aware_bindings = NULL;
+  IREE_RETURN_IF_ERROR(
+      iree_arena_allocate_array(state->preference_arena, binding_count,
+                                sizeof(*aware_bindings),
+                                (void**)&aware_bindings));
+  memcpy(aware_bindings, state->preferences.bindings,
+         binding_count * sizeof(*aware_bindings));
+  loom_value_ordinal_t* chain_origins = NULL;
+  IREE_RETURN_IF_ERROR(
+      loom_low_placement_build_chain_origins(state, &chain_origins));
+  *aware = (loom_low_placement_preference_index_t){
+      .uses = uses,
+      .bindings = aware_bindings,
+      .origins_by_value_ordinal = chain_origins,
+      .use_count = use_count,
+      .binding_count = binding_count,
+  };
+  IREE_RETURN_IF_ERROR(loom_low_placement_index_preference_incidence(
+      state, 0, chain_origins, aware_bindings, aware));
+  out_index->instruction_aware = aware;
   return iree_ok_status();
 }
 
