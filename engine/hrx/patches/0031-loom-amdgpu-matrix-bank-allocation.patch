+// Extends tied storage origins across whole-value copies, moves and edge
+// payloads, which coalescing normally places in one storage. An accumulator
+// seeded by a copy or loop entry then sees the instruction uses of its chain.
+static iree_status_t loom_low_placement_build_chain_origins(
+    loom_low_placement_build_state_t* state,
+    loom_value_ordinal_t** out_origins) {
+  const loom_value_ordinal_t value_count = state->value_domain->value_count;
+  loom_value_ordinal_t* origins = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      state->preference_arena, value_count, sizeof(*origins),
+      (void**)&origins));
+  for (loom_value_ordinal_t i = 0; i < value_count; ++i) {
+    origins[i] = state->tied_storage_origins_by_value_ordinal
+                     ? state->tied_storage_origins_by_value_ordinal[i]
+                     : i;
+  }
+  for (uint32_t i = 0; i < state->relation_count; ++i) {
+    const loom_low_placement_relation_t* relation = &state->relations[i];
+    if (relation->kind != LOOM_LOW_PLACEMENT_RELATION_SAME_STORAGE ||
+        !(loom_low_placement_cause_is_edge(relation->cause) ||
+          loom_low_placement_cause_is_defining_transfer(relation->cause)) ||
+        !loom_low_placement_relation_can_alias(relation) ||
+        relation->result_unit_offset != 0 ||
+        relation->source_unit_offset != 0) {
+      continue;
+    }
+    const loom_liveness_interval_t* result =
+        loom_liveness_interval_for_value_ordinal(state->liveness,
+                                                 relation->result_ordinal);
+    const loom_liveness_interval_t* source =
+        loom_liveness_interval_for_value_ordinal(state->liveness,
+                                                 relation->source_ordinal);
+    if (result->unit_count != relation->unit_count ||
+        source->unit_count != relation->unit_count) {
+      continue;
+    }
+    const loom_value_ordinal_t a = loom_low_placement_tied_storage_origin(
+        origins, relation->result_ordinal);
+    const loom_value_ordinal_t b = loom_low_placement_tied_storage_origin(
+        origins, relation->source_ordinal);
+    origins[iree_max(a, b)] = iree_min(a, b);
+  }
+  for (loom_value_ordinal_t i = 0; i < value_count; ++i) {
+    origins[i] = loom_low_placement_tied_storage_origin(origins, i);
+  }
+  *out_origins = origins;
+  return iree_ok_status();
+}
