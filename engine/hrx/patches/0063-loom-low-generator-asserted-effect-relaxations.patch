+// LOOM_EXP_LOCK_ACQREL: one lock acquire or release (see
+// loom_low_schedule_effect_relaxations_t).
+static iree_status_t loom_low_schedule_effect_frontier_note_lock(
+    loom_low_schedule_build_state_t* state,
+    loom_low_schedule_effect_frontier_t* frontier, uint32_t node_index,
+    bool is_release,
+    loom_low_schedule_dependency_endpoint_t consumer_endpoint) {
+  IREE_RETURN_IF_ERROR(loom_low_schedule_effect_frontier_depend_on_ordered(
+      state, frontier, node_index, consumer_endpoint));
+  if (frontier->last_lock_node != LOOM_LOW_SCHEDULE_NODE_NONE &&
+      frontier->last_lock_node != frontier->ordered_node) {
+    IREE_RETURN_IF_ERROR(loom_low_schedule_add_dependency(
+        state, frontier->last_lock_node, node_index,
+        LOOM_LOW_SCHEDULE_DEPENDENCY_EFFECT, LOOM_LOW_ID_NONE,
+        loom_low_schedule_dependency_endpoint_none(), consumer_endpoint));
+  }
+  frontier->last_lock_node = node_index;
+  if (is_release) {
+    IREE_RETURN_IF_ERROR(loom_low_schedule_effect_frontier_follow_accesses(
+        state, frontier, node_index, frontier->last_release_node,
+        consumer_endpoint));
+    frontier->last_release_node = node_index;
+    return iree_ok_status();
+  }
+  // An acquire stays behind the latest access before it in source order.
+  const loom_low_schedule_effect_frontier_entry_t* last = NULL;
+  for (iree_host_size_t i = 0; i < frontier->write_count; ++i) {
+    if (!last || frontier->writes[i].node_index > last->node_index) {
+      last = &frontier->writes[i];
+    }
+  }
+  for (iree_host_size_t i = 0; i < frontier->read_count; ++i) {
+    if (!last || frontier->reads[i].node_index > last->node_index) {
+      last = &frontier->reads[i];
+    }
+  }
+  if (last) {
+    IREE_RETURN_IF_ERROR(loom_low_schedule_add_dependency(
+        state, last->node_index, node_index,
+        LOOM_LOW_SCHEDULE_DEPENDENCY_EFFECT, LOOM_LOW_ID_NONE,
+        loom_low_schedule_effect_frontier_entry_endpoint(last),
+        consumer_endpoint));
+  }
+  for (uint32_t i = 0; i < frontier->guarded_count; ++i) {
+    IREE_RETURN_IF_ERROR(loom_low_schedule_add_dependency(
+        state, frontier->guarded_nodes[i], node_index,
+        LOOM_LOW_SCHEDULE_DEPENDENCY_EFFECT, LOOM_LOW_ID_NONE,
+        loom_low_schedule_dependency_endpoint_none(), consumer_endpoint));
+  }
+  frontier->guarded_count = 0;
+  frontier->guard_node = node_index;
+  return iree_ok_status();
+}
