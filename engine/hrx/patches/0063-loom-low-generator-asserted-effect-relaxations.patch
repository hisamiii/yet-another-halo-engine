+// The vector access classes the relaxations key on, from the mnemonic.
+static uint8_t loom_low_schedule_descriptor_vector_class(
+    iree_string_view_t mnemonic,
+    loom_low_schedule_effect_relaxations_t relaxations) {
+  uint8_t vector_class = 0;
+  if (iree_string_view_starts_with(mnemonic, IREE_SV("vld"))) {
+    vector_class |= LOOM_LOW_SCHEDULE_VECTOR_LOAD;
+  }
+  if (iree_string_view_starts_with(mnemonic, IREE_SV("vst"))) {
+    vector_class |= LOOM_LOW_SCHEDULE_VECTOR_STORE;
+  }
+  if (iree_string_view_starts_with(mnemonic, IREE_SV("vst.acc"))) {
+    vector_class |= LOOM_LOW_SCHEDULE_ACCUMULATOR_STORE;
+  }
+  if (iree_string_view_starts_with(mnemonic, IREE_SV("vlda.fill")) ||
+      iree_string_view_starts_with(mnemonic, IREE_SV("vldb.fill")) ||
+      iree_string_view_starts_with(mnemonic, IREE_SV("vst.512"))) {
+    vector_class |= LOOM_LOW_SCHEDULE_SHARED_DATA_ACCESS;
+  }
+  if (!relaxations.vector_noalias) {
+    vector_class &= (uint8_t)~LOOM_LOW_SCHEDULE_VECTOR_STORE;
+  }
+  if (!relaxations.vector_noalias && !relaxations.accumulator_nowar) {
+    vector_class &= (uint8_t)~LOOM_LOW_SCHEDULE_VECTOR_LOAD;
+  }
+  if (!relaxations.accumulator_nowar) {
+    vector_class &= (uint8_t)~LOOM_LOW_SCHEDULE_ACCUMULATOR_STORE;
+  }
+  if (!relaxations.lock_acqrel) {
+    vector_class &= (uint8_t)~LOOM_LOW_SCHEDULE_SHARED_DATA_ACCESS;
+  }
+  return vector_class;
+}
