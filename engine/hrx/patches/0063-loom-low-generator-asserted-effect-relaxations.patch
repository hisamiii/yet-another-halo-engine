 } loom_low_schedule_effect_frontier_t;
 
+// EXPERIMENT (opt-in, generator-asserted): effect-order relaxations for
+// hand-scheduled AIE2P kernels whose generator proves the facts below. Hand
+// written Low carries no alias facts, so the default keeps every order.
+//   LOOM_EXP_NOALIAS_ACC=2: a vector load (vld*) does not wait for earlier
+//     vector stores (vst*): no store in the kernel's hoist window writes a
+//     block that a later load reads.
+//   LOOM_EXP_NOWAR_ACC=1: an accumulator store (vst.acc*) does not wait for
+//     earlier vector loads (vld*): every real write-after-read pair is also a
+//     data dependency.
+//   LOOM_EXP_LOCK_ACQREL=6: lock acquires and releases order only what they
+//     guard instead of fencing every access: a release follows the accesses
+//     since the previous release, an acquire is anchored behind the latest
+//     access before it and follows the shared-data accesses (FIFO fills,
+//     vst.512) since the previous acquire, and later shared-data accesses
+//     follow the acquire. Other ordered ops become full fences.
+typedef struct loom_low_schedule_effect_relaxations_t {
+  bool vector_noalias;
+  bool accumulator_nowar;
+  bool lock_acqrel;
+} loom_low_schedule_effect_relaxations_t;
+
+enum {
+  LOOM_LOW_SCHEDULE_VECTOR_LOAD = 1u << 0,
+  LOOM_LOW_SCHEDULE_VECTOR_STORE = 1u << 1,
+  LOOM_LOW_SCHEDULE_ACCUMULATOR_STORE = 1u << 2,
+  LOOM_LOW_SCHEDULE_SHARED_DATA_ACCESS = 1u << 3,
+};
+
+static loom_low_schedule_effect_relaxations_t
+loom_low_schedule_effect_relaxations(void) {
+  static int initialized = 0;
+  static loom_low_schedule_effect_relaxations_t relaxations;
+  if (!initialized) {
+    const char* noalias = getenv("LOOM_EXP_NOALIAS_ACC");
+    const char* nowar = getenv("LOOM_EXP_NOWAR_ACC");
+    const char* acqrel = getenv("LOOM_EXP_LOCK_ACQREL");
+    relaxations.vector_noalias = noalias && strcmp(noalias, "2") == 0;
+    relaxations.accumulator_nowar = nowar && strcmp(nowar, "1") == 0;
+    relaxations.lock_acqrel = acqrel && strcmp(acqrel, "6") == 0;
+    initialized = 1;
+  }
+  return relaxations;
+}
+
+static bool loom_low_schedule_relaxations_enabled(void) {
+  const loom_low_schedule_effect_relaxations_t r =
+      loom_low_schedule_effect_relaxations();
+  return r.vector_noalias || r.accumulator_nowar || r.lock_acqrel;
+}
+
+static uint8_t loom_low_schedule_node_vector_class(
+    const loom_low_schedule_effect_frontier_t* frontier, uint32_t node_index) {
+  return frontier->node_vector_classes
+             ? frontier->node_vector_classes[node_index]
+             : 0;
+}
