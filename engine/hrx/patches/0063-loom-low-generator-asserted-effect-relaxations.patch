   uint32_t read_retirement_nodes[LOOM_LOW_MEMORY_SPACE_WASM_MEMORY + 1];
+  // Generator-asserted relaxations (loom_low_schedule_effect_relaxations_t):
+  // per-node vector access classes, indexed by scheduler node ordinal.
+  uint8_t* node_vector_classes;
+  // Vector access class of the node whose effects are being noted.
+  uint8_t current_vector_class;
+  // LOOM_EXP_LOCK_ACQREL: the last lock op (lock ops keep their source order),
+  // the last release (later releases follow the accesses after it), the last
+  // acquire (later shared-data accesses follow it), and the shared-data
+  // accesses since that acquire (the next acquire follows them).
+  uint32_t last_lock_node;
+  uint32_t last_release_node;
+  uint32_t guard_node;
+  uint32_t guarded_nodes[512];
