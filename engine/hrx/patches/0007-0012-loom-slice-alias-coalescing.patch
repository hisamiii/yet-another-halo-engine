+++ b/loom/src/loom/codegen/low/allocation/coalescing.c
@@ -734,11 +734,20 @@ static iree_status_t loom_low_allocation_coalescing_assign_relation_interval(
     const loom_liveness_interval_t* interval,
     const loom_low_placement_relation_t* relation, bool* out_assigned) {
   *out_assigned = false;
-  const loom_value_id_t source_value_id =
+  // A slice aliases its source's storage. Values sharing that exact storage
+  // and dead at the slice (a tied accumulator input whose result is the
+  // source) hold nothing the slice could clobber, as for copies.
+  loom_value_id_t ignored_value_ids[16];
+  uint16_t ignored_value_count = 1;
+  ignored_value_ids[0] =
       loom_low_placement_value_id(context->placement, relation->source_ordinal);
+  IREE_RETURN_IF_ERROR(
+      loom_low_allocation_coalescing_collect_dead_exact_storage_aliases(
+          context, relation->op, interval->start_point, ignored_value_ids,
+          (uint16_t)IREE_ARRAYSIZE(ignored_value_ids), &ignored_value_count));
   return loom_low_allocation_coalescing_append_relation_interval(
-      context, interval, relation, &source_value_id,
-      /*ignored_value_count=*/1, out_assigned);
+      context, interval, relation, ignored_value_ids, ignored_value_count,
+      out_assigned);
 }
 
 static iree_status_t
diff --git a/loom/src/loom/ops/low/canonicalize.c b/loom/src/loom/ops/low/canonicalize.c
index 5ed024e3be..e11f65320c 100644
--- a/loom/src/loom/ops/low/canonicalize.c
+++ b/loom/src/loom/ops/low/canonicalize.c
@@ -291,3 +291,70 @@ iree_status_t loom_low_slice_canonicalize(loom_op_t* op,
   }
   return iree_ok_status();
 }
+
+// concat(slice %x[o], slice %x[o + n0], ...) of consecutive subranges of one
+// value is the subrange slice %x[o] (or %x itself when it covers all of %x):
+// lowering splits vector results into unit slices and regathers them for wide
+// consumers (a b128 store of half a WMMA accumulator), and the regathered
+// concat otherwise needs the allocator to rebuild an alias it can miss.
+iree_status_t loom_low_concat_canonicalize(loom_op_t* op,
+                                           loom_rewriter_t* rewriter) {
+  loom_value_slice_t sources = loom_low_concat_sources(op);
+  if (sources.count < 2) {
+    return iree_ok_status();
+  }
+  loom_value_id_t base = LOOM_VALUE_ID_INVALID;
+  int64_t first_offset = 0;
+  int64_t next_offset = 0;
+  for (uint16_t i = 0; i < sources.count; ++i) {
+    loom_op_t* slice_op = loom_low_defining_op(rewriter, sources.values[i]);
+    if (!loom_low_slice_isa(slice_op)) {
+      return iree_ok_status();
+    }
+    const loom_value_id_t slice_source = loom_low_slice_source(slice_op);
+    const int64_t offset = loom_low_slice_offset(slice_op);
+    if (offset < 0) {
+      return iree_ok_status();
+    }
+    if (i == 0) {
+      base = slice_source;
+      first_offset = offset;
+      next_offset = offset;
+    } else if (slice_source != base || offset != next_offset) {
+      return iree_ok_status();
+    }
+    const loom_type_t slice_type =
+        loom_module_value_type(rewriter->module, sources.values[i]);
+    if (!loom_type_is_register(slice_type)) {
+      return iree_ok_status();
+    }
+    next_offset += loom_low_register_type_unit_count(slice_type);
+  }
+  // Slices of a concat fold through it into its operands instead
+  // (loom_low_slice_canonicalize); a subrange slice here would keep the whole
+  // concat live behind it.
+  if (loom_low_concat_isa(loom_low_defining_op(rewriter, base))) {
+    return iree_ok_status();
+  }
+  const loom_type_t base_type = loom_module_value_type(rewriter->module, base);
+  const loom_type_t result_type =
+      loom_module_value_type(rewriter->module, loom_low_concat_result(op));
+  if (!loom_type_is_register(base_type) || !loom_type_is_register(result_type) ||
+      loom_low_register_type_unit_count(result_type) !=
+          (uint32_t)(next_offset - first_offset)) {
+    return iree_ok_status();
+  }
+  if (first_offset == 0 && loom_type_equal(result_type, base_type)) {
+    return loom_low_replace_single_result_with_value(op, rewriter, base);
+  }
+  loom_builder_set_before(&rewriter->builder, op);
+  loom_value_id_t value_checkpoint = loom_rewriter_value_checkpoint(rewriter);
+  loom_op_t* replacement_op = NULL;
+  IREE_RETURN_IF_ERROR(loom_low_slice_build(&rewriter->builder, base,
+                                            first_offset, result_type,
+                                            op->location, &replacement_op));
+  loom_value_id_t replacement = loom_low_slice_result(replacement_op);
+  IREE_RETURN_IF_ERROR(loom_rewriter_preserve_result_names_on_new_values(
+      rewriter, op, &replacement, 1, value_checkpoint));
+  return loom_low_replace_single_result_with_value(op, rewriter, replacement);
+}
