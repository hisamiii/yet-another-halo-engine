+// Returns whether |op| only feeds low.concat pieces and one of those concats
+// also consumes |existing|'s result. Replacing |op| by |existing| would then
+// make that concat consume one value as two pieces, and a value has one storage
+// location, so the concat could only be satisfied by a register copy. Keeping
+// the duplicate producer lets each piece be defined directly into its part of
+// the result. Duplicates with other users are still replaced, so CSE keeps
+// merging the computations downstream of them. Only concats whose result lives
+// in explicit physical registers count: there a copy is a whole register move,
+// and the pieces of one register come from separate producers.
+static bool loom_low_cse_duplicates_concat_piece(
+    const loom_module_t* module,
+    const loom_low_descriptor_set_t* descriptor_set, const loom_op_t* op,
+    const loom_op_t* existing) {
+  const loom_low_register_type_resolver_t resolver = {
+      .descriptor_set = descriptor_set,
+  };
+  bool shares_concat = false;
+  for (uint16_t r = 0; r < op->result_count; ++r) {
+    const loom_value_t* value = loom_op_result_value(module, op, r);
+    const loom_use_t* use = NULL;
+    loom_value_for_each_use(value, use) {
+      const loom_op_t* user = loom_use_user_op(*use);
+      if (user->kind != LOOM_OP_LOW_CONCAT ||
+          !loom_low_register_type_resolver_has_class_flags(
+              &resolver,
+              loom_module_value_type(module, loom_op_const_results(user)[0]),
+              LOOM_LOW_REG_CLASS_FLAG_EXPLICIT_PHYSICAL_REGISTERS)) {
+        return false;
+      }
+      const loom_value_id_t* operands = loom_op_const_operands(user);
+      for (uint16_t i = 0; i < user->operand_count; ++i) {
+        for (uint16_t k = 0; k < existing->result_count; ++k) {
+          if (operands[i] == loom_op_const_results(existing)[k]) {
+            shares_concat = true;
+          }
+        }
+      }
+    }
+  }
+  return shares_concat;
+}
