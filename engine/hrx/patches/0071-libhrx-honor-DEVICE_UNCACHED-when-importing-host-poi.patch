From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hisamiii <265242552+hisamiii@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:25:34 +0100
Subject: [PATCH 71/75] libhrx : honor DEVICE_UNCACHED when importing host
 pointers

The NPU's flag and C pages need an uncached GPU mapping, as HSA gave them.

Assisted-by: Claude Opus 5.5
---
 libhrx/src/binding/common/memory.c   |  4 ++--
 libhrx/src/libhrx/allocator.c        |  3 ++-
 libhrx/src/libhrx/mem_pool_backing.c | 20 ++++++++++++++++----
 libhrx/src/libhrx/mem_pool_backing.h |  8 ++++++--
 4 files changed, 26 insertions(+), 9 deletions(-)

diff --git a/libhrx/src/binding/common/memory.c b/libhrx/src/binding/common/memory.c
index 7c5590892c..ef511af467 100644
--- a/libhrx/src/binding/common/memory.c
+++ b/libhrx/src/binding/common/memory.c
@@ -888,7 +888,7 @@ iree_status_t iree_hal_streaming_memory_buffer_for_context(
   iree_hal_buffer_t* imported_buffer = NULL;
   status = hrx_mem_pool_backing_retain_import_source(
       execution_context->device_entry->hrx_device,
-      external_buffer.storage_class, &import_pool);
+      external_buffer.storage_class, /*device_uncached=*/false, &import_pool);
   if (iree_status_is_ok(status)) {
     status = iree_hal_pool_import_buffer(
         import_pool, &external_buffer,
@@ -2467,7 +2467,7 @@ static iree_status_t iree_hal_streaming_memory_register_host_with_context_mode(
   iree_hal_buffer_t* buffer = NULL;
   iree_status_t status = hrx_mem_pool_backing_retain_import_source(
       context->device_entry->hrx_device, external_buffer.storage_class,
-      &import_pool);
+      /*device_uncached=*/false, &import_pool);
   if (iree_status_is_ok(status)) {
     status = iree_hal_pool_import_buffer(
         import_pool, &external_buffer,
diff --git a/libhrx/src/libhrx/allocator.c b/libhrx/src/libhrx/allocator.c
index 5e69ae86d5..5e00a6ce78 100644
--- a/libhrx/src/libhrx/allocator.c
+++ b/libhrx/src/libhrx/allocator.c
@@ -87,7 +87,8 @@ hrx_status_t hrx_allocator_import_buffer(hrx_allocator_t allocator,
   iree_hal_pool_t* pool = NULL;
   iree_hal_buffer_t* hal_buffer = NULL;
   iree_status_t status = hrx_mem_pool_backing_retain_import_source(
-      allocator->device, ext.storage_class, &pool);
+      allocator->device, ext.storage_class,
+      iree_any_bit_set(params.type, HRX_MEMORY_TYPE_DEVICE_UNCACHED), &pool);
   if (iree_status_is_ok(status)) {
     status = iree_hal_pool_import_buffer(
         pool, &ext, iree_hal_make_buffer_range(0, IREE_HAL_WHOLE_BUFFER),
diff --git a/libhrx/src/libhrx/mem_pool_backing.c b/libhrx/src/libhrx/mem_pool_backing.c
index 7fb3458462..85589c5f63 100644
--- a/libhrx/src/libhrx/mem_pool_backing.c
+++ b/libhrx/src/libhrx/mem_pool_backing.c
@@ -85,6 +85,7 @@ typedef enum hrx_mem_pool_source_kind_e {
   HRX_MEM_POOL_SOURCE_UNCACHED_HOST,
   HRX_MEM_POOL_SOURCE_SIGNAL,
   HRX_MEM_POOL_SOURCE_HOST_IMPORT,
+  HRX_MEM_POOL_SOURCE_UNCACHED_HOST_IMPORT,
   HRX_MEM_POOL_SOURCE_DEVICE_IMPORT,
 } hrx_mem_pool_source_kind_t;
 
@@ -115,6 +116,8 @@ static iree_hal_pool_t** hrx_mem_pool_backing_source_slot(
       return &backing->signals;
     case HRX_MEM_POOL_SOURCE_HOST_IMPORT:
       return &backing->host_import_source;
+    case HRX_MEM_POOL_SOURCE_UNCACHED_HOST_IMPORT:
+      return &backing->uncached_host_import_source;
     case HRX_MEM_POOL_SOURCE_DEVICE_IMPORT:
       return &backing->device_import_source;
   }
@@ -150,11 +153,13 @@ static iree_status_t hrx_mem_pool_backing_create_source(
                               kind == HRX_MEM_POOL_SOURCE_SIGNAL;
   const bool uncached = kind == HRX_MEM_POOL_SOURCE_UNCACHED_DEVICE ||
                         kind == HRX_MEM_POOL_SOURCE_UNCACHED_HOST ||
+                        kind == HRX_MEM_POOL_SOURCE_UNCACHED_HOST_IMPORT ||
                         (fine_grained && device->type != HRX_ACCELERATOR_CPU);
   const bool host_coherent = kind == HRX_MEM_POOL_SOURCE_HOST || fine_grained ||
                              kind == HRX_MEM_POOL_SOURCE_UNCACHED_HOST ||
                              kind == HRX_MEM_POOL_SOURCE_SIGNAL ||
-                             kind == HRX_MEM_POOL_SOURCE_HOST_IMPORT;
+                             kind == HRX_MEM_POOL_SOURCE_HOST_IMPORT ||
+                             kind == HRX_MEM_POOL_SOURCE_UNCACHED_HOST_IMPORT;
   const iree_host_size_t device_count =
       mapping_source
           ? iree_hal_device_group_device_count(device->hal_device_group)
@@ -238,7 +243,8 @@ static iree_status_t hrx_mem_pool_backing_create_source(
   };
   iree_hal_slab_pool_options_t options;
   iree_hal_slab_pool_options_initialize(&options);
-  const bool imports_host = kind == HRX_MEM_POOL_SOURCE_HOST_IMPORT;
+  const bool imports_host = kind == HRX_MEM_POOL_SOURCE_HOST_IMPORT ||
+                            kind == HRX_MEM_POOL_SOURCE_UNCACHED_HOST_IMPORT;
   const bool imports_device = kind == HRX_MEM_POOL_SOURCE_DEVICE_IMPORT;
   const bool import_only = imports_host || imports_device;
   iree_hal_pool_import_class_t import_class = {0};
@@ -308,6 +314,10 @@ static iree_status_t hrx_mem_pool_backing_create_source(
     case HRX_MEM_POOL_SOURCE_HOST_IMPORT:
       options.trace_name = iree_make_cstring_view("hrx-host-import-source");
       break;
+    case HRX_MEM_POOL_SOURCE_UNCACHED_HOST_IMPORT:
+      options.trace_name =
+          iree_make_cstring_view("hrx-uncached-host-import-source");
+      break;
     case HRX_MEM_POOL_SOURCE_DEVICE_IMPORT:
       options.trace_name = iree_make_cstring_view("hrx-device-import-source");
       break;
@@ -431,6 +441,7 @@ void hrx_mem_pool_backing_deinitialize(hrx_mem_pool_backing_t* backing) {
   iree_hal_pool_release(backing->uncached_host.mapping);
   iree_hal_pool_release(backing->signals);
   iree_hal_pool_release(backing->host_import_source);
+  iree_hal_pool_release(backing->uncached_host_import_source);
   iree_hal_pool_release(backing->device_import_source);
   iree_slim_mutex_deinitialize(&backing->mutex);
 }
@@ -495,11 +506,12 @@ iree_status_t hrx_mem_pool_backing_retain_signal_pool(
 
 iree_status_t hrx_mem_pool_backing_retain_import_source(
     hrx_device_t device, iree_hal_external_storage_class_t storage_class,
-    iree_hal_pool_t** out_pool) {
+    bool device_uncached, iree_hal_pool_t** out_pool) {
   hrx_mem_pool_source_kind_t kind;
   switch (storage_class.type) {
     case IREE_HAL_EXTERNAL_STORAGE_TYPE_HOST_POINTER:
-      kind = HRX_MEM_POOL_SOURCE_HOST_IMPORT;
+      kind = device_uncached ? HRX_MEM_POOL_SOURCE_UNCACHED_HOST_IMPORT
+                             : HRX_MEM_POOL_SOURCE_HOST_IMPORT;
       break;
     case IREE_HAL_EXTERNAL_STORAGE_TYPE_DEVICE_ADDRESS:
       kind = HRX_MEM_POOL_SOURCE_DEVICE_IMPORT;
diff --git a/libhrx/src/libhrx/mem_pool_backing.h b/libhrx/src/libhrx/mem_pool_backing.h
index be54272d41..de554d1ebd 100644
--- a/libhrx/src/libhrx/mem_pool_backing.h
+++ b/libhrx/src/libhrx/mem_pool_backing.h
@@ -58,6 +58,8 @@ typedef struct hrx_mem_pool_backing_t {
   iree_hal_pool_t* signals;
   // Retained import-only source for caller-owned host pointers.
   iree_hal_pool_t* host_import_source;
+  // Retained import-only source for host pointers the device reads uncached.
+  iree_hal_pool_t* uncached_host_import_source;
   // Retained import-only source for native device addresses.
   iree_hal_pool_t* device_import_source;
   // Immutable child policy geometry selected with the cache's slab class.
@@ -115,10 +117,12 @@ iree_status_t hrx_mem_pool_backing_retain_signal_pool(
 
 // Retains the device-owned import-only source for |storage_class|. Portable
 // host pointers and native device addresses are the supported HRX interop
-// classes. The caller must release the returned pool.
+// classes. |device_uncached| selects an uncached device mapping of host
+// pointers, so device loads observe host and peer-device writes without cache
+// maintenance. The caller must release the returned pool.
 iree_status_t hrx_mem_pool_backing_retain_import_source(
     hrx_device_t device, iree_hal_external_storage_class_t storage_class,
-    iree_hal_pool_t** out_pool);
+    bool device_uncached, iree_hal_pool_t** out_pool);
 
 void hrx_mem_pool_backing_attach(hrx_mem_pool_backing_t* backing,
                                  hrx_mem_pool_retention_t* retention);
