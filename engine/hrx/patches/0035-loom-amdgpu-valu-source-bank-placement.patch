+# Measured VALU source-bank qualifications: on gfx1151 an instruction reading two
+# distinct VGPRs of one bank (mod 4) issues in 2.5 cycles, three in 5, else 1 (a
+# VOPD pair counts both components' reads). Three-source tied FMAC and the
+# two-source forms prefer pairwise different source banks; with each component
+# clean, a VOPD FMAC pair reaches the best case of two reads per bank.
+VALU_SOURCE_BANK_PLACEMENT_QUALIFICATIONS = (
+    ("gfx1151", 32, "amdgpu.v_fmac_f32"),
+)
+VALU_TWO_SOURCE_BANK_PLACEMENT_QUALIFICATIONS = (
+    ("gfx1151", 32, "amdgpu.v_add_f32"),
+    ("gfx1151", 32, "amdgpu.v_fmaak_f32"),
+    ("gfx1151", 32, "amdgpu.v_mul_f32"),
+    ("gfx1151", 32, "amdgpu.v_sub_f32"),
+)
+
 _WMMA_GFX11_WAVE64_ACCUMULATOR_SIZE_REASON = "gfx11-wave64-wmma-half-width-accumulator"
 _GFX12_WAVE64_MATRIX_OPERAND_SIZE_REASON = "gfx12-wave64-matrix-half-width-operands"
