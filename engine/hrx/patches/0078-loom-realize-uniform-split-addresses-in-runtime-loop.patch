From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hisamiii <265242552+hisamiii@users.noreply.github.com>
Date: Sun, 15 Nov 2026 03:09:41 +0100
Subject: [PATCH] loom : realize uniform split addresses in runtime loops

Port of yah 0053 onto main: inductionless loop domains, uniform terms to scalar offsets.
---
 loom/src/loom/codegen/low/lower/realization.c |  27 +-
 loom/src/loom/codegen/low/lower/realization.h |   8 +-
 .../low/lower/rule_source_memory_plan.c       |   5 +-
 .../arch/amdgpu/lower/address_realization.c   | 252 +++++++++++++-----
 4 files changed, 209 insertions(+), 83 deletions(-)

diff --git a/loom/src/loom/codegen/low/lower/realization.c b/loom/src/loom/codegen/low/lower/realization.c
index 6f823724ec..7051ecde07 100644
--- a/loom/src/loom/codegen/low/lower/realization.c
+++ b/loom/src/loom/codegen/low/lower/realization.c
@@ -169,8 +169,7 @@ static bool loom_low_lower_realization_loop_domain(
   const loom_cfg_natural_loop_t* loop = &cfg->loops.loops[loop_index];
   const loom_value_fact_induction_t* induction = &cfg->inductions[loop_index];
   if (loop->entries.count != 1 || loop->backedges.count != 1 ||
-      loop->exits.count != 1 || induction->value == LOOM_VALUE_ID_INVALID ||
-      induction->update != LOOM_VALUE_FACT_INDUCTION_UPDATE_ADDITIVE) {
+      loop->exits.count != 1) {
     return false;
   }
   const loom_cfg_edge_info_t* entry =
@@ -181,7 +180,6 @@ static bool loom_low_lower_realization_loop_domain(
       &cfg->graph.edges[loop->exits.unique_index];
   if (!loom_cfg_br_isa(entry->terminator) ||
       !loom_cfg_br_isa(backedge->terminator) ||
-      exit->source_block_index != loop->header_index ||
       exit->selector_value_id == LOOM_VALUE_ID_INVALID ||
       !loom_value_facts_is_subgroup_uniform(loom_value_fact_table_lookup(
           context->fact_table, exit->selector_value_id)) ||
@@ -191,6 +189,21 @@ static bool loom_low_lower_realization_loop_domain(
           cfg->control, backedge->source_block_index))) {
     return false;
   }
+  *out_loop = (loom_low_lower_realization_loop_t){
+      .header = cfg->graph.blocks[loop->header_index].block,
+      .entry = entry->terminator,
+      .backedge = backedge->terminator,
+      .induction_value = LOOM_VALUE_ID_INVALID,
+      .trip_count = LOOM_LOW_LOWER_REALIZATION_ESTIMATED_TRIP_COUNT,
+  };
+  // Runtime bounds and bottom-tested exits still give one uniform iteration
+  // domain. Only an exact header-tested additive recurrence publishes its
+  // induction.
+  if (induction->value == LOOM_VALUE_ID_INVALID ||
+      induction->update != LOOM_VALUE_FACT_INDUCTION_UPDATE_ADDITIVE ||
+      exit->source_block_index != loop->header_index) {
+    return true;
+  }
   const loom_loop_recurrence_facts_t recurrence =
       loom_value_fact_induction_facts(context->fact_table, context->module,
                                       induction);
@@ -208,7 +221,7 @@ static bool loom_low_lower_realization_loop_domain(
           loom_value_fact_induction_step_facts(context->fact_table, induction),
           &step) ||
       step <= 0) {
-    return false;
+    return true;
   }
   *out_loop = (loom_low_lower_realization_loop_t){
       .header = cfg->graph.blocks[loop->header_index].block,
@@ -299,7 +312,11 @@ iree_status_t loom_low_lower_realization_offer(
     loom_low_lower_context_t* context, const loom_op_t* source_op,
     const loom_low_lower_realization_loop_t* loop,
     const loom_low_lower_realization_offer_t* offer) {
-  if (source_op->parent_block != loop->backedge->parent_block) {
+  // Exact loops keep the latch-block domain their offers were measured with.
+  // A loop without an exact recurrence (runtime-bounded or bottom-tested) may
+  // offer from any uniform block of its body.
+  if (loop->induction_value != LOOM_VALUE_ID_INVALID &&
+      source_op->parent_block != loop->backedge->parent_block) {
     return iree_ok_status();
   }
   loom_low_lower_realization_construction_t* construction =
diff --git a/loom/src/loom/codegen/low/lower/realization.h b/loom/src/loom/codegen/low/lower/realization.h
index 601be4f008..65ec68d1c8 100644
--- a/loom/src/loom/codegen/low/lower/realization.h
+++ b/loom/src/loom/codegen/low/lower/realization.h
@@ -41,10 +41,14 @@ typedef struct loom_low_lower_realization_input_t {
   } value;
 } loom_low_lower_realization_input_t;
 
+// Cost-model trip estimate for loops whose trip count is a runtime value.
+#define LOOM_LOW_LOWER_REALIZATION_ESTIMATED_TRIP_COUNT 16
+
 // Retained uniform loop domain admitting complete, lane-valid edge payloads.
 // Entry and backedge are dedicated unconditional edges; the sole exit is a
-// uniform header test. This is a realization candidate domain, not a source
-// program restriction. Other loops retain their ordinary direct lowering.
+// uniform test in the header or the body. This is a realization candidate
+// domain, not a source program restriction. Other loops retain their ordinary
+// direct lowering.
 typedef struct loom_low_lower_realization_loop_t {
   // Source header defining the supplemental carried values.
   const loom_block_t* header;
diff --git a/loom/src/loom/codegen/low/lower/rule_source_memory_plan.c b/loom/src/loom/codegen/low/lower/rule_source_memory_plan.c
index c0934eface..d4f4c12790 100644
--- a/loom/src/loom/codegen/low/lower/rule_source_memory_plan.c
+++ b/loom/src/loom/codegen/low/lower/rule_source_memory_plan.c
@@ -692,7 +692,7 @@ loom_low_lower_rule_source_memory_consider_term_recurrence(
   }
   const loom_low_lower_realization_loop_t* loop =
       loom_low_lower_realization_loop(context, emission_op);
-  if (loop == NULL ||
+  if (loop == NULL || loop->induction_value == LOOM_VALUE_ID_INVALID ||
       emission_op->parent_block != loop->backedge->parent_block ||
       loop->initial_value != 0) {
     return iree_ok_status();
@@ -1032,7 +1032,8 @@ loom_low_lower_rule_source_memory_consider_recurrence(
   // This recipe initializes the carrier with zero and advances it by the
   // authored byte stride. Other induction domains require additional setup or
   // stride-scaling arithmetic that this materializer contract does not name.
-  if (loop->initial_value != 0 || loop->step != 1) {
+  if (loop->induction_value == LOOM_VALUE_ID_INVALID ||
+      loop->initial_value != 0 || loop->step != 1) {
     return iree_ok_status();
   }
   const int64_t constant_stride = source_recurrence->constant_stride;
diff --git a/loom/src/loom/target/arch/amdgpu/lower/address_realization.c b/loom/src/loom/target/arch/amdgpu/lower/address_realization.c
