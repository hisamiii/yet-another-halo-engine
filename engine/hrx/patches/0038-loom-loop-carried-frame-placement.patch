+  // Number of entries in each by-ordinal table.
+  iree_host_size_t value_count;
+  // Frame representative by value ordinal, or UINT32_MAX without an interval.
+  uint32_t* roots;
+  // Unit offset of each member's first unit inside its frame.
+  int32_t* offsets;
+  // Circular member list by value ordinal.
+  uint32_t* next_members;
+  // Lowest member unit offset, indexed by representative.
+  int32_t* frame_begins;
+  // One past the highest member unit offset, indexed by representative.
+  int32_t* frame_ends;
+  // Nonzero for a representative whose multi-unit frame crosses an edge.
+  uint8_t* edge_frames;
