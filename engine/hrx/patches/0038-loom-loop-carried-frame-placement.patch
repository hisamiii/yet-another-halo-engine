+// A loop-carried frame member away from its predicted location costs a copy
+// per unit on the edge. It weighs like one unsatisfied structural relation. A
+// first member starts its frame, so the whole frame must fit at that start.
+static uint32_t loom_low_allocation_search_frame_penalty(
+    loom_low_allocation_search_context_t* context,
+    const loom_low_allocation_search_location_query_t* query,
+    const loom_low_allocation_assignment_t* candidate) {
+  if (!query->has_frame) {
+    return 0;
+  }
+  if (query->frame_alignment == 0) {
+    return candidate->location_base != query->frame_base;
+  }
+  if (candidate->location_base < query->frame_offset ||
+      (candidate->location_base - query->frame_offset) %
+              query->frame_alignment !=
+          0) {
+    return 1;
+  }
+  return loom_low_allocation_search_location_conflicts(
+      context, query->frame_interval, candidate->descriptor_reg_class_id,
+      candidate->location_kind, candidate->location_base - query->frame_offset,
+      query->frame_span, /*ignored_value_ids=*/NULL,
+      /*ignored_value_count=*/0, /*ignored_storage_lease_value_ids=*/NULL,
+      /*ignored_storage_lease_value_count=*/0,
+      LOOM_LOW_ALLOCATION_STORAGE_RELEASE_FORBIDDEN);
+}
