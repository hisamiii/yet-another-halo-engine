+// Within one acquisition point, assigns loop header arguments whose frame has
+// an earlier member before the remaining values. Otherwise an unpredicted
+// argument can take the storage a predicted sibling inherits from its entry
+// value, displacing that sibling's whole frame.
+static iree_status_t loom_low_allocation_interval_assignment_order_frames(
+    loom_low_allocation_interval_assignment_state_t* state,
+    loom_low_allocation_interval_order_t* order) {
+  const loom_low_allocation_frame_affinity_t* frames = &state->frame_affinity;
+  if (frames->roots == NULL || order->interval_count < 2) {
+    return iree_ok_status();
+  }
+  const loom_low_allocation_interval_assignment_context_t* context =
+      state->context;
+  uint32_t* first_starts = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      state->scratch_arena, frames->value_count, sizeof(*first_starts),
+      (void**)&first_starts));
+  for (iree_host_size_t i = 0; i < frames->value_count; ++i) {
+    first_starts[i] = UINT32_MAX;
+  }
+  for (iree_host_size_t i = 0; i < frames->value_count; ++i) {
+    const uint32_t root = frames->roots[i];
+    if (root == UINT32_MAX) {
+      continue;
+    }
+    const loom_liveness_interval_t* interval =
+        loom_liveness_interval_for_value_ordinal(context->liveness,
+                                                 (loom_value_ordinal_t)i);
+    first_starts[root] = iree_min(first_starts[root], interval->start_point);
+  }
+  loom_low_allocation_interval_order_entry_t* scratch = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      state->scratch_arena, order->interval_count, sizeof(*scratch),
+      (void**)&scratch));
+  iree_host_size_t run_start = 0;
+  while (run_start < order->interval_count) {
+    const loom_low_allocation_interval_order_entry_t* first =
+        &order->intervals[run_start];
+    iree_host_size_t run_end = run_start + 1;
+    while (run_end < order->interval_count &&
+           order->intervals[run_end].acquisition_start_point ==
+               first->acquisition_start_point &&
+           order->intervals[run_end].topology_rank == first->topology_rank) {
+      ++run_end;
+    }
+    iree_host_size_t count = 0;
+    for (int pass = 0; pass < 2 && run_end - run_start > 1; ++pass) {
+      for (iree_host_size_t i = run_start; i < run_end; ++i) {
+        const loom_liveness_interval_t* interval = order->intervals[i].interval;
+        const loom_value_ordinal_t ordinal = loom_local_value_domain_ordinal(
+            context->value_domain, interval->value_id);
+        const uint32_t root =
+            ordinal < frames->value_count ? frames->roots[ordinal] : UINT32_MAX;
+        const bool predicted =
+            root != UINT32_MAX && frames->edge_frames[root] &&
+            first_starts[root] < interval->start_point &&
+            loom_value_is_block_arg(
+                loom_module_value(context->module, interval->value_id));
+        if (predicted == (pass == 0)) {
+          scratch[count++] = order->intervals[i];
+        }
+      }
+    }
+    if (count != 0) {
+      memcpy(&order->intervals[run_start], scratch, count * sizeof(*scratch));
+    }
+    run_start = run_end;
+  }
+  return iree_ok_status();
+}
