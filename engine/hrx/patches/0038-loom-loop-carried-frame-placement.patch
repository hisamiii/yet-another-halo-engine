-      context->descriptor_set, &query->preferences, candidate, NULL);
+  return iree_math_saturating_add_u32(
+      loom_low_allocation_preference_penalty(
+          context->descriptor_set, &query->preferences, candidate, NULL),
+      loom_low_allocation_search_frame_penalty(context, query, candidate));
