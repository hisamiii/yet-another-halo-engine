+// Predicts the value's location from its loop-carried frame: the location
+// implied by a placed member, or an aligned frame start for the first member.
+static void loom_low_allocation_search_prepare_frame(
+    const loom_low_allocation_search_context_t* context,
+    const loom_liveness_interval_t* interval,
+    const loom_low_allocation_assignment_t* candidate_template,
+    loom_low_allocation_search_location_query_t* query) {
+  const loom_low_allocation_frame_affinity_t* frames = context->frame_affinity;
+  if (frames == NULL || frames->roots == NULL) {
+    return;
+  }
+  const loom_value_ordinal_t ordinal = loom_module_value_ordinal_scratch_lookup(
+      context->module, interval->value_id);
+  if (ordinal >= frames->value_count) {
+    return;
+  }
+  const uint32_t root = frames->roots[ordinal];
+  if (root == UINT32_MAX || !frames->edge_frames[root]) {
+    return;
+  }
+  const int32_t offset = frames->offsets[ordinal];
+  // Frames are tuples, their lanes and copies; bound the walk regardless.
+  uint32_t member = frames->next_members[ordinal];
+  for (uint32_t step = 0; member != ordinal && step < 256;
+       ++step, member = frames->next_members[member]) {
+    const loom_low_allocation_assignment_t* assignment =
+        loom_low_allocation_assignment_map_assignment_for_value_ordinal(
+            context->assignment_map, member, NULL);
+    if (assignment == NULL ||
+        !loom_low_allocation_assignment_is_register_like(assignment) ||
+        assignment->location_kind != candidate_template->location_kind ||
+        assignment->descriptor_reg_class_id !=
+            candidate_template->descriptor_reg_class_id) {
+      continue;
+    }
+    const int64_t base = (int64_t)assignment->location_base -
+                         frames->offsets[member] + offset;
+    if (base < 0 || base > UINT32_MAX) {
+      return;
+    }
+    query->frame_base = (uint32_t)base;
+    query->has_frame = true;
+    return;
+  }
+  const uint32_t span =
+      (uint32_t)(frames->frame_ends[root] - frames->frame_begins[root]);
+  uint32_t alignment = 1;
+  while (alignment * 2 <= span && alignment < 8) {
+    alignment *= 2;
+  }
+  if (alignment == 1) {
+    return;
+  }
+  query->frame_alignment = alignment;
+  query->frame_offset = (uint32_t)(offset - frames->frame_begins[root]);
+  query->frame_span = span;
+  query->frame_interval = interval;
+  query->has_frame = true;
+}
+
+// Finds the representative of |node| and its unit offset relative to it.
+static uint32_t loom_low_allocation_frame_find(uint32_t* parents,
+                                               int32_t* deltas, uint32_t node,
+                                               int32_t* out_offset) {
+  int32_t offset = 0;
+  uint32_t root = node;
+  while (parents[root] != root) {
+    offset += deltas[root];
+    root = parents[root];
+  }
+  int32_t remaining = offset;
+  while (node != root && parents[node] != root) {
+    const uint32_t next = parents[node];
+    const int32_t delta = deltas[node];
+    parents[node] = root;
+    deltas[node] = remaining;
+    remaining -= delta;
+    node = next;
+  }
+  *out_offset = offset;
+  return root;
+}
+
+iree_status_t loom_low_allocation_frame_affinity_build(
+    const loom_liveness_analysis_t* liveness,
+    const loom_low_placement_table_t* placement, iree_arena_allocator_t* arena,
+    loom_low_allocation_frame_affinity_t* out_frames) {
+  *out_frames = (loom_low_allocation_frame_affinity_t){0};
+  if (placement == NULL || liveness->value_count == 0 ||
+      liveness->value_count >= UINT32_MAX) {
+    return iree_ok_status();
+  }
+  const iree_host_size_t count = liveness->value_count;
+  uint32_t* parents = NULL;
+  int32_t* deltas = NULL;
+  uint8_t* edge_members = NULL;
+  uint8_t* edge_source_counts = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(arena, count, sizeof(*parents),
+                                                 (void**)&parents));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(arena, count, sizeof(*deltas),
+                                                 (void**)&deltas));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, count, sizeof(*edge_members), (void**)&edge_members));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, count, sizeof(*edge_source_counts), (void**)&edge_source_counts));
+  for (iree_host_size_t i = 0; i < count; ++i) {
+    parents[i] = (uint32_t)i;
+  }
+  memset(deltas, 0, count * sizeof(*deltas));
+  memset(edge_members, 0, count * sizeof(*edge_members));
+  memset(edge_source_counts, 0, count * sizeof(*edge_source_counts));
+  // A value forwarded along several edges, such as a shared initial value,
+  // cannot sit at every destination's offset and predicts none of them.
+  for (iree_host_size_t i = 0; i < placement->relation_count; ++i) {
+    const loom_low_placement_relation_t* relation = &placement->relations[i];
+    if (loom_low_placement_cause_is_edge(relation->cause) &&
+        relation->source_ordinal < count &&
+        edge_source_counts[relation->source_ordinal] < 2) {
+      ++edge_source_counts[relation->source_ordinal];
+    }
+  }
+  for (iree_host_size_t i = 0; i < placement->relation_count; ++i) {
+    const loom_low_placement_relation_t* relation = &placement->relations[i];
+    if ((relation->kind != LOOM_LOW_PLACEMENT_RELATION_SAME_STORAGE &&
+         relation->kind != LOOM_LOW_PLACEMENT_RELATION_SUBRANGE &&
+         relation->kind != LOOM_LOW_PLACEMENT_RELATION_CONTIGUOUS_PART) ||
+        relation->result_ordinal >= count ||
+        relation->source_ordinal >= count ||
+        relation->result_ordinal == relation->source_ordinal) {
+      continue;
+    }
+    const bool is_edge = loom_low_placement_cause_is_edge(relation->cause);
+    if (is_edge && edge_source_counts[relation->source_ordinal] > 1) {
+      continue;
+    }
+    const loom_liveness_interval_t* result_interval =
+        loom_liveness_interval_for_value_ordinal(liveness,
+                                                 relation->result_ordinal);
+    const loom_liveness_interval_t* source_interval =
+        loom_liveness_interval_for_value_ordinal(liveness,
+                                                 relation->source_ordinal);
+    if (result_interval == NULL || source_interval == NULL ||
+        !loom_liveness_value_class_equal(result_interval->value_class,
+                                         source_interval->value_class)) {
+      continue;
+    }
+    // The result unit at result_unit_offset shares storage with the source
+    // unit at source_unit_offset.
+    const int32_t delta = (int32_t)relation->source_unit_offset -
+                          (int32_t)relation->result_unit_offset;
+    int32_t result_offset = 0;
+    int32_t source_offset = 0;
+    const uint32_t result_root = loom_low_allocation_frame_find(
+        parents, deltas, relation->result_ordinal, &result_offset);
+    const uint32_t source_root = loom_low_allocation_frame_find(
+        parents, deltas, relation->source_ordinal, &source_offset);
+    if (result_root == source_root) {
+      if (result_offset != source_offset + delta) {
+        continue;
+      }
+    } else {
+      parents[result_root] = source_root;
+      deltas[result_root] = source_offset + delta - result_offset;
+    }
+    if (is_edge) {
+      edge_members[relation->result_ordinal] = 1;
+    }
+  }
+
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, count, sizeof(*out_frames->roots), (void**)&out_frames->roots));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, count, sizeof(*out_frames->offsets),
+      (void**)&out_frames->offsets));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, count, sizeof(*out_frames->next_members),
+      (void**)&out_frames->next_members));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, count, sizeof(*out_frames->frame_begins),
+      (void**)&out_frames->frame_begins));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, count, sizeof(*out_frames->frame_ends),
+      (void**)&out_frames->frame_ends));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, count, sizeof(*out_frames->edge_frames),
+      (void**)&out_frames->edge_frames));
+  out_frames->value_count = count;
+  for (iree_host_size_t i = 0; i < count; ++i) {
+    out_frames->next_members[i] = (uint32_t)i;
+    out_frames->frame_begins[i] = INT32_MAX;
+    out_frames->frame_ends[i] = INT32_MIN;
+    out_frames->edge_frames[i] = 0;
+  }
+  for (iree_host_size_t i = 0; i < count; ++i) {
+    const loom_liveness_interval_t* interval =
+        loom_liveness_interval_for_value_ordinal(liveness,
+                                                 (loom_value_ordinal_t)i);
+    if (interval == NULL) {
+      out_frames->roots[i] = UINT32_MAX;
+      out_frames->offsets[i] = 0;
+      continue;
+    }
+    int32_t offset = 0;
+    const uint32_t root =
+        loom_low_allocation_frame_find(parents, deltas, (uint32_t)i, &offset);
+    out_frames->roots[i] = root;
+    out_frames->offsets[i] = offset;
+    out_frames->frame_begins[root] =
+        iree_min(out_frames->frame_begins[root], offset);
+    out_frames->frame_ends[root] = iree_max(
+        out_frames->frame_ends[root], offset + (int32_t)interval->unit_count);
+    if (edge_members[i]) {
+      out_frames->edge_frames[root] = 1;
+    }
+    if (root != i) {
+      const uint32_t next = out_frames->next_members[root];
+      out_frames->next_members[root] = (uint32_t)i;
+      out_frames->next_members[i] = next;
+    }
+  }
+  // Single-unit frames predict nothing beyond ordinary edge coalescing.
+  for (iree_host_size_t i = 0; i < count; ++i) {
+    if (out_frames->edge_frames[i] &&
+        out_frames->frame_ends[i] - out_frames->frame_begins[i] <= 1) {
+      out_frames->edge_frames[i] = 0;
+    }
+  }
+  return iree_ok_status();
 }
 
