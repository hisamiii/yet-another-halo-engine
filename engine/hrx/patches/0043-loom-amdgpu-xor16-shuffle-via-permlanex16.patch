+def _v_permlanex16_b32_overlay() -> AmdgpuDescriptorOverlay:
+    """v_permlanex16_b32 with SGPR lane selectors (any 16-lane permutation of the other row)."""
+    return AmdgpuDescriptorOverlay(
+        descriptor_key="amdgpu.v_permlanex16_b32",
+        instruction_name="V_PERMLANEX16_B32",
+        mnemonic="v_permlanex16_b32",
+        encoding_name="ENC_VOP3",
+        semantic_tag="lane.permlanex16.b32.sgpr_selectors",
+        schedule_class=_SCHEDULE_VALU,
+        operands=(
+            AmdgpuOperandOverlay("VDST", _vgpr_result()),
+            AmdgpuOperandOverlay("SRC0", _vgpr_operand("src")),
+            AmdgpuOperandOverlay("SRC1", _sgpr_operand("selector_low")),
+            AmdgpuOperandOverlay("SRC2", _sgpr_operand("selector_high")),
+        ),
+        effects=(_CONVERGENT_EFFECT,),
+        flags=(DescriptorFlag.DEAD_REMOVABLE,),
+    )
