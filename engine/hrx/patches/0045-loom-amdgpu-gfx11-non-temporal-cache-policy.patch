diff --git a/loom/src/loom/target/arch/amdgpu/lower/memory_cache.c b/loom/src/loom/target/arch/amdgpu/lower/memory_cache.c
index a552562bd..72b4e16ef 100644
--- a/loom/src/loom/target/arch/amdgpu/lower/memory_cache.c
+++ b/loom/src/loom/target/arch/amdgpu/lower/memory_cache.c
@@ -215,6 +215,31 @@ loom_amdgpu_memory_cache_policy_resolve(
     out_attrs->flags |= LOOM_AMDGPU_MEMORY_CACHE_POLICY_ATTR_NT;
     out_attrs->nt = 1;
   }
+  // GFX11: the near caches (L0 / L1 / L2) take the non-temporal hint as SLC (L2 stream) plus GLC on stores (L0 / L1
+  // miss-evict), the outer one (MALL) as DLC (no allocation); non_temporal is both, LLVM's nontemporal. Only plain
+  // loads and stores: atomics carry their own coherence bits.
+  const uint8_t temporal = policy->cache_temporal;
+  const bool near_nt = temporal == LOOM_CACHE_TEMPORAL_NON_TEMPORAL ||
+                       temporal == LOOM_CACHE_TEMPORAL_NON_TEMPORAL_REGULAR;
+  const bool outer_nt = temporal == LOOM_CACHE_TEMPORAL_NON_TEMPORAL ||
+                        temporal == LOOM_CACHE_TEMPORAL_REGULAR_NON_TEMPORAL;
+  if ((near_nt || outer_nt) &&
+      (access->source.operation_kind == LOOM_MEMORY_ACCESS_OPERATION_LOAD ||
+       access->source.operation_kind == LOOM_MEMORY_ACCESS_OPERATION_STORE)) {
+    if (near_nt && iree_any_bit_set(row->attr_flags, LOOM_AMDGPU_MEMORY_CACHE_POLICY_ATTR_SLC)) {
+      out_attrs->flags |= LOOM_AMDGPU_MEMORY_CACHE_POLICY_ATTR_SLC;
+      out_attrs->slc = 1;
+    }
+    if (outer_nt && iree_any_bit_set(row->attr_flags, LOOM_AMDGPU_MEMORY_CACHE_POLICY_ATTR_DLC)) {
+      out_attrs->flags |= LOOM_AMDGPU_MEMORY_CACHE_POLICY_ATTR_DLC;
+      out_attrs->dlc = 1;
+    }
+    if (near_nt && iree_any_bit_set(row->attr_flags, LOOM_AMDGPU_MEMORY_CACHE_POLICY_ATTR_GLC) &&
+        access->source.operation_kind == LOOM_MEMORY_ACCESS_OPERATION_STORE) {
+      out_attrs->flags |= LOOM_AMDGPU_MEMORY_CACHE_POLICY_ATTR_GLC;
+      out_attrs->glc = 1;
+    }
+  }
   return LOOM_AMDGPU_MEMORY_CACHE_POLICY_RESOLUTION_ENCODED;
 }
 
