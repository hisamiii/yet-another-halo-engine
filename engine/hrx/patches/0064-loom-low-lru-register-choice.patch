+// EXPERIMENT (opt-in): LOOM_EXP_LRU=<class name>,... gives a value of these
+// register classes the legal location freed longest ago instead of the lowest
+// one, so a locked body's hoisted pops and loads can land early (the register
+// event frontier holds a write behind the last read of the location's old
+// value).
+static bool loom_low_allocation_search_uses_lru(
+    const loom_low_descriptor_set_t* descriptor_set, uint16_t reg_class_id) {
+  static const char* list = (const char*)1;
+  if (list == (const char*)1) {
+    list = getenv("LOOM_EXP_LRU");
+  }
+  if (!list || reg_class_id >= descriptor_set->reg_class_count) {
+    return false;
+  }
+  const iree_string_view_t name = loom_low_descriptor_set_string(
+      descriptor_set,
+      descriptor_set->reg_classes[reg_class_id].name_string_ref);
+  for (const char* p = list; *p;) {
+    const char* comma = strchr(p, ',');
+    const iree_host_size_t n =
+        comma ? (iree_host_size_t)(comma - p) : strlen(p);
+    if (n == name.size && memcmp(p, name.data, n) == 0) {
+      return true;
+    }
+    if (!comma) {
+      break;
+    }
+    p = comma + 1;
+  }
+  return false;
+}
+
+// The latest end point of an earlier value of reg_class_id that overlaps
+// [base, base + unit_count) and ends by start_point (0: none).
+static uint32_t loom_low_allocation_search_lru_score(
+    const loom_low_allocation_assignment_map_t* assignment_map,
+    uint16_t reg_class_id, bool same_class_only, uint32_t base,
+    uint32_t unit_count, uint32_t start_point) {
+  uint32_t score = 0;
+  for (iree_host_size_t i = 0; i < assignment_map->assignment_count; ++i) {
+    const loom_low_allocation_assignment_t* assignment =
+        &assignment_map->assignments[i];
+    if (same_class_only &&
+        assignment->descriptor_reg_class_id != reg_class_id) {
+      continue;
+    }
+    if (assignment->location_base + assignment->location_count <= base ||
+        assignment->location_base >= base + unit_count) {
+      continue;
+    }
+    if (assignment->end_point <= start_point && assignment->end_point > score) {
+      score = assignment->end_point;
+    }
+  }
+  return score;
+}
