+// Appends a program section at |layout->startup_address| holding a jump to
+// |entry_address|: the core starts there, the program sits higher.
+static iree_status_t loom_aie2p_tile_link_place_startup_jump(
+    const loom_aie2p_tile_link_layout_t* layout, uint64_t entry_address,
+    iree_arena_allocator_t* arena,
+    loom_native_section_contribution_assembly_t* assembly,
+    loom_aie2p_linked_section_placement_t** inout_section_placements) {
+  uint8_t* bytes = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate(arena, 32, (void**)&bytes));
+  iree_host_size_t length = 0;
+  IREE_RETURN_IF_ERROR(loom_aie2p_native_pack_jump(
+      entry_address, iree_make_byte_span(bytes, 32), &length));
+  const uint32_t gap = layout->program_address - layout->startup_address;
+  if (layout->startup_address > layout->program_address || gap < length ||
+      gap > layout->program_owner_offset) {
+    return iree_make_status(IREE_STATUS_INVALID_ARGUMENT,
+                            "AIE2P startup jump overlaps the program");
+  }
+  const iree_host_size_t count = assembly->section_count + 1;
+  loom_native_elf_section_t* sections = NULL;
+  loom_aie2p_linked_section_placement_t* placements = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, count, sizeof(*sections), (void**)&sections));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, count, sizeof(*placements), (void**)&placements));
+  memcpy(sections, assembly->sections,
+         assembly->section_count * sizeof(*sections));
+  memcpy(placements, *inout_section_placements,
+         assembly->section_count * sizeof(*placements));
+  sections[count - 1] = (loom_native_elf_section_t){
+      .name = IREE_SV(".text.startup"),
+      .type = LOOM_NATIVE_ELF_SECTION_TYPE_PROGBITS,
+      .flags = LOOM_NATIVE_ELF_SECTION_FLAG_ALLOC |
+               LOOM_NATIVE_ELF_SECTION_FLAG_EXECINSTR,
+      .address = layout->startup_address,
+      .alignment = 16,
+      .contents = iree_make_const_byte_span(bytes, length),
+  };
+  placements[count - 1] = (loom_aie2p_linked_section_placement_t){
+      .memory_space = LOOM_XDNA_MEMORY_SPACE_PROGRAM,
+      .owner_offset = layout->program_owner_offset - gap,
+  };
+  assembly->sections = sections;
+  assembly->section_count = count;
+  *inout_section_placements = placements;
+  return iree_ok_status();
+}
