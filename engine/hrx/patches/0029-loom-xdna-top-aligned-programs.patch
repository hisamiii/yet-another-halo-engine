+static iree_status_t loom_aie2p_native_pack_standalone(
+    loom_aie2p_instruction_id_t instruction,
+    const loom_aie2p_encoding_field_value_t* field_values,
+    iree_host_size_t field_value_count, iree_byte_span_t storage,
+    iree_host_size_t* inout_length) {
+  loom_aie2p_instruction_info_t info;
+  if (!loom_aie2p_encoding_query_instruction_info(instruction, &info)) {
+    return iree_make_status(IREE_STATUS_INVALID_ARGUMENT,
+                            "AIE2P instruction is invalid");
+  }
+  loom_aie2p_encoded_slot_t slot = {.slot = info.slot};
+  IREE_RETURN_IF_ERROR(loom_aie2p_encoding_pack_instruction(
+      instruction, field_values, field_value_count, &slot.value));
+  loom_aie2p_encoding_packet_t packet;
+  IREE_RETURN_IF_ERROR(loom_aie2p_encoding_pack_bundle(
+      loom_aie2p_encoding_find_bundle_format_for_slots(&slot.slot, 1), &slot, 1,
+      &packet));
+  if (packet.data_length > storage.data_length - *inout_length) {
+    return iree_make_status(IREE_STATUS_RESOURCE_EXHAUSTED,
+                            "AIE2P jump exceeds its storage");
+  }
+  memcpy(storage.data + *inout_length, packet.data, packet.data_length);
+  *inout_length += packet.data_length;
+  return iree_ok_status();
+}
+
+iree_status_t loom_aie2p_native_pack_jump(uint64_t target_address,
+                                          iree_byte_span_t storage,
+                                          iree_host_size_t* out_length) {
+  *out_length = 0;
+  const loom_aie2p_instruction_id_t jump =
+      loom_aie2p_encoding_find_instruction(IREE_SV("J_lng"));
+  const loom_aie2p_instruction_id_t nop =
+      loom_aie2p_encoding_find_instruction(IREE_SV("NOP"));
+  loom_aie2p_instruction_info_t jump_info;
+  const bool found = jump != LOOM_AIE2P_INSTRUCTION_ID_INVALID &&
+                     nop != LOOM_AIE2P_INSTRUCTION_ID_INVALID &&
+                     loom_aie2p_encoding_query_instruction_info(jump, &jump_info);
+  IREE_ASSERT(found && "generated AIE2P tables must contain J_lng and NOP");
+  if (!found) {
+    return iree_make_status(IREE_STATUS_FAILED_PRECONDITION,
+                            "AIE2P tables lack J_lng or NOP");
+  }
+  const loom_aie2p_native_relocation_immediate_t target_immediate =
+      loom_aie2p_native_relocation_immediate(jump);
+  if (target_immediate.field_count != 1 || target_address > INT64_MAX) {
+    return iree_make_status(IREE_STATUS_FAILED_PRECONDITION,
+                            "AIE2P jump target is not its only field");
+  }
+  loom_aie2p_encoding_field_value_t target = {.field_id =
+                                                  target_immediate.field};
+  IREE_RETURN_IF_ERROR(loom_aie2p_machine_encode_immediate(
+      target_immediate.immediate, (int64_t)target_address, &target.value));
+  IREE_RETURN_IF_ERROR(
+      loom_aie2p_native_pack_standalone(jump, &target, 1, storage, out_length));
+  for (uint8_t i = 0; i < jump_info.delay_slot_count; ++i) {
+    IREE_RETURN_IF_ERROR(
+        loom_aie2p_native_pack_standalone(nop, NULL, 0, storage, out_length));
+  }
+  return iree_ok_status();
+}
