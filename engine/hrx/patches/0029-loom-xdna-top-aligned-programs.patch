Loom AIE2P core programs end at the top of program memory, behind a 16-byte startup jump at the core startup address
(J to the entry plus its delay-window NOPs; .text.startup). Images that share code tails (the GEMM loop after a
format-specific decoder) then hold that code at the same addresses, so a switch between them writes only the words
that differ (yah DeltaSetup): pp2048 setup program bytes 109.7 -> 81.9 MB. A program with less than 16 bytes to spare
stays at the startup address. Code size and per-call cycles are unchanged (branch targets stay 16-byte aligned).
--- a/loom/src/loom/target/arch/amd/xdna/aie2p/emit/artifact.c
+++ b/loom/src/loom/target/arch/amd/xdna/aie2p/emit/artifact.c
@@ -296,10 +296,18 @@ static iree_status_t loom_aie2p_xdna_plan_tile_link(
       plan->worker_plans[worker_index].coordinate;
   const loom_xdna_tile_facts_t* tile =
       loom_xdna_array_tile_facts(plan->family, coordinate);
+  // Programs end at the top of program memory, behind a startup jump: images
+  // sharing code tails hold them at the same addresses (smaller image switches).
+  const uint32_t capacity = tile->memory.program_capacity;
+  uint32_t offset = 0;
+  if (realization->code.byte_length + 16 <= capacity) {
+    offset = (capacity - (uint32_t)realization->code.byte_length) & ~15u;
+  }
   *out_layout = (loom_aie2p_tile_link_layout_t){
-      .program_address = tile->memory.program_base,
-      .program_owner_offset = 0,
-      .program_byte_capacity = tile->memory.program_capacity,
+      .program_address = tile->memory.program_base + offset,
+      .program_owner_offset = offset,
+      .program_byte_capacity = capacity - offset,
+      .startup_address = tile->memory.program_base,
       .storage_placements = storage_placements,
       .storage_placement_count = realization->storage_domain_count,
       .read_only_data_placements = read_only_data_placements,
