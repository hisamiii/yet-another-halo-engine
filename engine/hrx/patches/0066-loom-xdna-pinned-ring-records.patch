 loom_aie2p_array_channel_resources_propose_ring_from_probe(
     loom_aie2p_array_tile_resources_t* probe,
@@ -60,6 +138,20 @@ loom_aie2p_array_channel_resources_propose_ring_from_probe(
       record_count = 0;
