Subject: [PATCH 23/73] 0020 : route multicast core streams through route trees

---
 loom/src/loom/target/arch/amd/xdna/aie2p/array/plan.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/loom/src/loom/target/arch/amd/xdna/aie2p/array/plan.c b/loom/src/loom/target/arch/amd/xdna/aie2p/array/plan.c
index 19081b9355..3cdb683107 100644
