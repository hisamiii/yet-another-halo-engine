+++ b/loom/src/loom/target/arch/amd/xdna/aie2p/array/plan.c
@@ -2729,8 +2729,8 @@ static iree_status_t loom_aie2p_array_plan_core_stream_channel(
     channel->sender_dma_index = source->sender_dma_index;
     if (!loom_aie2p_array_route_ingress(
             &builder->route_builder, channel_index,
-            channel->source_channel_index, shim_dma->coordinate,
-            shim_dma->dma_channel,
+            &builder->route_trees[channel->source_channel_index],
+            shim_dma->coordinate, shim_dma->dma_channel,
             builder->workers[receiver->owner_index].coordinate,
             LOOM_XDNA_STREAM_PORT_CORE, 0, /*vertical_first=*/false)) {
       return loom_aie2p_array_diagnose_route_capacity(builder, channel_index);
