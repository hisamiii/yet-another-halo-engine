+// Most same-content views one concat result may share registers with.
+#define LOOM_LOW_ALLOCATION_COALESCING_MAX_SAME_CONTENT_VIEWS 8
+
+// Concat and slice results that view the same producers' units.
+// Follows low.concat / low.slice relations from |ordinal|'s unit |unit| back to
+// the producer that defines the unit's contents.
+static void loom_low_allocation_coalescing_view_root(
+    const loom_low_placement_table_t* placement, loom_value_ordinal_t ordinal,
+    uint32_t unit, loom_value_ordinal_t* out_ordinal, uint32_t* out_unit) {
+  for (int depth = 0; depth < 16; ++depth) {
+    const loom_low_placement_relation_range_t range =
+        loom_low_placement_relation_range_for_value_ordinal(placement, ordinal);
+    bool found = false;
+    for (uint32_t i = 0; i < range.count && !found; ++i) {
+      const loom_low_placement_relation_t* r =
+          &placement->relations[range.start + i];
+      if ((r->cause != LOOM_LOW_PLACEMENT_CAUSE_LOW_CONCAT &&
+           r->cause != LOOM_LOW_PLACEMENT_CAUSE_LOW_SLICE) ||
+          r->result_ordinal != ordinal ||
+          !loom_low_placement_relation_can_alias(r) ||
+          unit < r->result_unit_offset ||
+          unit - r->result_unit_offset >= r->unit_count) {
+        continue;
+      }
+      unit = r->source_unit_offset + (unit - r->result_unit_offset);
+      ordinal = r->source_ordinal;
+      found = true;
+    }
+    if (!found) {
+      break;
+    }
+  }
+  *out_ordinal = ordinal;
+  *out_unit = unit;
+}
