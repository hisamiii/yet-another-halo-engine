+// The cycle a block's branch must retire by. Default: full quiescence and the
+// terminator's sources. LOOM_EXP_DELAYFILL relaxes it for a block's only
+// branch: LOOM_EXP_DELAYFILL=2 with _NOEFF lets a conditional branch wait for
+// its sources only (without _NOEFF, resources and memory effects drain but
+// register events do not), and _EFFD lets an unconditional back edge's memory
+// effects land as late as the target's first memory-effect instruction.
+static uint64_t loom_aie2p_bundle_plan_branch_quiescent_cycle(
+    const loom_aie2p_bundle_plan_builder_t* builder,
+    const loom_aie2p_block_analysis_t* block_analysis,
+    const loom_aie2p_block_branch_t* branch) {
+  const uint32_t packet_index = block_analysis->terminator_packet_index;
+  const uint64_t quiescent_cycle =
+      loom_aie2p_bundle_plan_quiescent_cycle(builder, packet_index);
+  const loom_aie2p_bundle_plan_experiments_t* experiments =
+      loom_aie2p_bundle_plan_experiments();
+  if (!experiments->delay_fill || block_analysis->branches.count != 1) {
