+// LOOM_EXP_BANKMAP: the map entry of the current op, or NULL.
+static const loom_aie2p_bank_map_entry_t* loom_aie2p_bundle_plan_bank_entry(
+    const loom_aie2p_bundle_plan_builder_t* builder) {
+  const loom_aie2p_bank_map_t* map = builder->bank_map;
+  const loom_op_t* op = builder->current_op;
+  if (!map || !map->count || !op) {
+    return NULL;
+  }
+  loom_aie2p_bank_map_entry_t key;
+  if (op->result_count) {
+    const iree_string_view_t name =
+        loom_module_value_name(builder->frame->module, loom_op_results(op)[0]);
+    snprintf(key.name, sizeof(key.name), "%.*s", (int)name.size, name.data);
+  } else if (op->operand_count) {
+    const iree_string_view_t name =
+        loom_module_value_name(builder->frame->module, loom_op_operands(op)[0]);
+    snprintf(key.name, sizeof(key.name), "st:%.*s", (int)name.size, name.data);
+  } else {
+    return NULL;
+  }
+  return (const loom_aie2p_bank_map_entry_t*)bsearch(
+      &key, map->entries, map->count, sizeof(key),
+      loom_aie2p_bank_map_entry_compare);
+}
+
+// LOOM_EXP_BANKMAP: whether entry's banks are taken at cycle (+ its stage).
+static bool loom_aie2p_bundle_plan_bank_busy_at(
+    loom_aie2p_bundle_plan_builder_t* builder,
+    const loom_aie2p_bank_map_entry_t* entry, uint32_t cycle) {
+  if (!entry || cycle + entry->stage >= LOOM_AIE2P_BANK_MAP_CYCLES) {
+    return false;
+  }
+  const uint32_t at = cycle + entry->stage;
+  const uint8_t mask = entry->mask & 0x0Fu;
+  if (entry->mask & LOOM_AIE2P_BANK_MAP_NEVER_MOVES) {
+    const uint32_t dodge = loom_aie2p_bundle_plan_experiments()->pop_dodge;
+    if (!dodge) {
+      return false;
+    }
+    if (entry != builder->dodge_entry) {
+      builder->dodge_entry = entry;
+      builder->dodge_first_cycle = cycle;
+    }
+    if (cycle >= builder->dodge_first_cycle + dodge) {
+      return false;
+    }
+    return (builder->bank_busy[at] & mask) != 0;
+  }
+  if (loom_aie2p_bundle_plan_experiments()->bank_drift) {
+    const int64_t shifted = (int64_t)at - builder->bank_drift;
+    const uint8_t pre = shifted >= 0 && shifted < LOOM_AIE2P_BANK_MAP_CYCLES
+                            ? builder->bank_map->pre[shifted]
+                            : 0;
+    return ((builder->bank_busy[at] | pre) & mask) != 0;
+  }
+  return (builder->bank_busy[at] & mask) != 0;
+}
+
+// LOOM_EXP_LATE_READ: commits the register reads of the prepared instruction
+// (builder->instructions[0]) again as stage-2 reads into |issue| when its
+// mnemonic is listed.
+static iree_status_t loom_aie2p_bundle_plan_commit_late_reads(
+    const loom_aie2p_bundle_plan_builder_t* builder,
+    loom_low_physical_issue_t* issue, uint32_t cycle) {
+  const char* list = loom_aie2p_bundle_plan_experiments()->late_read;
+  if (!list) {
+    return iree_ok_status();
+  }
+  const loom_low_descriptor_set_t* descriptor_set = builder->descriptor_set;
+  static uint16_t late_event = LOOM_LOW_TIMING_EVENT_NONE;
+  static int resolved = 0;
+  if (!resolved) {
+    const loom_low_schedule_model_t* schedule_model = builder->schedule_model;
+    for (uint16_t e = 0; e < schedule_model->timing_event_count; ++e) {
+      if (iree_string_view_equal(
+              loom_low_schedule_model_timing_event_name(descriptor_set,
+                                                        schedule_model, e),
+              IREE_SV("amd.xdna.aie2p.operand.read.c2.none"))) {
+        late_event = e;
+      }
+    }
+    resolved = 1;
+  }
+  if (late_event == LOOM_LOW_TIMING_EVENT_NONE) {
+    return iree_ok_status();
+  }
+  const loom_low_descriptor_t* descriptor =
+      &descriptor_set->descriptors[builder->instructions[0].descriptor_ordinal];
+  const iree_string_view_t mnemonic = loom_low_descriptor_set_string(
+      descriptor_set, descriptor->mnemonic_string_ref);
+  if (!loom_aie2p_list_contains(list, mnemonic.data, mnemonic.size,
+                                /*prefix=*/false)) {
+    return iree_ok_status();
+  }
+  for (uint16_t j = 0; j < descriptor->operand_count; ++j) {
+    const loom_low_operand_t* operand =
+        loom_low_descriptor_operand(descriptor_set, descriptor, j);
+    if (operand->read_event_id == LOOM_LOW_TIMING_EVENT_NONE) {
+      continue;
+    }
+    IREE_RETURN_IF_ERROR(loom_low_schedule_event_frontier_commit(
+        &issue->events, builder->instructions[0].physical_registers[j],
+        late_event, cycle));
+  }
+  return iree_ok_status();
+}
