Loom: the f16 inline-accumulator WMMA (`.acc_zero`) gets 0034's placement preference: on gfx1151 it issues in 32
cycles iff A and B start in different VGPR banks (mod 4), else 33, whatever D's bank (SQ_BUSY microbench). The
attention QK chains start with it and landed with A and B in one bank (6.2% of the 2x64 key-split WMMAs at 33).
Bit-identical (register renames plus one exact copy in the 2x32 loop); 2x64 key split -0.24% at 64K and 16K, 2x32
main -0.2% at 20K, its chunk-0 form +0.8%.
diff --git a/loom/py/loom/target/arch/amdgpu/descriptors/matrix.py b/loom/py/loom/target/arch/amdgpu/descriptors/matrix.py
--- a/loom/py/loom/target/arch/amdgpu/descriptors/matrix.py
+++ b/loom/py/loom/target/arch/amdgpu/descriptors/matrix.py
@@ -29,8 +29,9 @@
 
 # Measured placement qualifications of inline-accumulator forms (no accumulator
 # register): gfx1151 iu4 issues in 16 cycles iff A and B start in different
-# banks, else 17, whatever the result's bank.
+# banks, else 17, whatever the result's bank; f16 likewise in 32, else 33.
 MATRIX_INLINE_ACCUMULATOR_PLACEMENT_QUALIFICATIONS = (
+    ("gfx1151", 32, "amdgpu.v_wmma_f32_16x16x16_f16.acc_zero"),
     ("gfx1151", 32, "amdgpu.v_wmma_i32_16x16x16_iu4.acc_zero"),
     ("gfx1151", 32, "amdgpu.v_wmma_i32_16x16x16_iu4.acc_inv_2pi"),
 )
