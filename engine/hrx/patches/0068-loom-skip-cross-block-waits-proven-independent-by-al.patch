diff --git a/loom/src/loom/target/arch/amdgpu/planning/wait_classification.c b/loom/src/loom/target/arch/amdgpu/planning/wait_classification.c
index 5698a47ee9..64bfcaf7b6 100644
--- a/loom/src/loom/target/arch/amdgpu/planning/wait_classification.c
+++ b/loom/src/loom/target/arch/amdgpu/planning/wait_classification.c
@@ -740,6 +740,123 @@ static void loom_amdgpu_wait_classification_classify_vmem_suffixes(
   }
 }
 
+typedef struct loom_amdgpu_wait_summary_use_t {
+  // Scheduled node carrying the effect.
+  uint32_t node_index;
+  // Source summary, or the conservative summary of the effect's space.
+  const loom_low_memory_access_summary_t* summary;
+} loom_amdgpu_wait_summary_use_t;
+
+// The cross-block memory frontier tracks pending accesses per memory space
+// only, so a global load after a block that stored to another buffer would
+// drain every store. When the source memory summaries prove that no opposite
+// access anywhere in the function may alias a node's dependency accesses, no
+// path through the CFG makes that drain a dependency. Nodes whose memory
+// spaces come from traits (no descriptor effects, volatile) stay conservative
+// and keep every opposite access dependent.
+static iree_status_t loom_amdgpu_wait_classification_classify_cross_block(
+    const loom_low_schedule_table_t* schedule, iree_arena_allocator_t* arena,
+    loom_amdgpu_wait_classification_t* classification) {
+  if (schedule->memory_accesses == NULL || schedule->node_count == 0 ||
+      schedule->block_count <= 1) {
+    return iree_ok_status();
+  }
+  uint8_t* effect_bits = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, schedule->node_count, sizeof(*effect_bits), (void**)&effect_bits));
+  memset(effect_bits, 0, schedule->node_count * sizeof(*effect_bits));
+  iree_host_size_t read_count = 0, write_count = 0;
+  for (iree_host_size_t i = 0; i < schedule->effect_use_count; ++i) {
+    const loom_low_schedule_effect_use_t* effect = &schedule->effect_uses[i];
+    if (!loom_amdgpu_wait_effect_is_dependency_memory(effect)) continue;
+    if (effect->kind == LOOM_LOW_EFFECT_KIND_READ) {
+      effect_bits[effect->node_index] |=
+          LOOM_AMDGPU_WAIT_CROSS_BLOCK_READ_INDEPENDENT;
+      ++read_count;
+    } else if (effect->kind == LOOM_LOW_EFFECT_KIND_WRITE) {
+      effect_bits[effect->node_index] |=
+          LOOM_AMDGPU_WAIT_CROSS_BLOCK_WRITE_INDEPENDENT;
+      ++write_count;
+    }
+  }
+  // Space flags not explained by descriptor effects are opaque accesses; only
+  // counter-backed ones can remain pending across a block edge.
+  bool opaque_read = false, opaque_write = false;
+  for (iree_host_size_t i = 0; i < schedule->node_count; ++i) {
+    const loom_amdgpu_wait_frontier_node_t* node =
+        &classification->frontier_nodes[i];
+    const bool volatile_access =
+        schedule->nodes[i].descriptor != NULL &&
+        schedule->nodes[i].op != NULL &&
+        iree_any_bit_set(schedule->nodes[i].op->instance_flags,
+                         LOOM_MEMORY_ACCESS_FLAG_VOLATILE);
+    if (node->read_space_flags != 0 && node->read_counter_mask != 0 &&
+        (volatile_access ||
+         !iree_any_bit_set(effect_bits[i],
+                           LOOM_AMDGPU_WAIT_CROSS_BLOCK_READ_INDEPENDENT))) {
+      opaque_read = true;
+    }
+    if (node->write_space_flags != 0 && node->write_counter_mask != 0 &&
+        (volatile_access ||
+         !iree_any_bit_set(effect_bits[i],
+                           LOOM_AMDGPU_WAIT_CROSS_BLOCK_WRITE_INDEPENDENT))) {
+      opaque_write = true;
+    }
+  }
+  if (opaque_read && opaque_write) {
+    return iree_ok_status();
+  }
+  loom_amdgpu_wait_summary_use_t* reads = NULL;
+  loom_amdgpu_wait_summary_use_t* writes = NULL;
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, iree_max(read_count, 1), sizeof(*reads), (void**)&reads));
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, iree_max(write_count, 1), sizeof(*writes), (void**)&writes));
+  read_count = write_count = 0;
+  for (iree_host_size_t i = 0; i < schedule->effect_use_count; ++i) {
+    const loom_low_schedule_effect_use_t* effect = &schedule->effect_uses[i];
+    if (!loom_amdgpu_wait_effect_is_dependency_memory(effect)) continue;
+    const loom_low_memory_access_summary_t* summary =
+        loom_low_memory_access_map_lookup(
+            schedule->memory_accesses, schedule->nodes[effect->node_index].op,
+            effect->effect_ordinal);
+    if (summary == NULL) {
+      summary = loom_low_memory_access_summary_for_space(effect->memory_space);
+    }
+    const loom_amdgpu_wait_summary_use_t use = {
+        .node_index = effect->node_index,
+        .summary = summary,
+    };
+    if (effect->kind == LOOM_LOW_EFFECT_KIND_READ) {
+      reads[read_count++] = use;
+    } else if (effect->kind == LOOM_LOW_EFFECT_KIND_WRITE) {
+      writes[write_count++] = use;
+    }
+  }
+  for (iree_host_size_t i = 0; i < schedule->node_count; ++i) {
+    if (opaque_write) {
+      effect_bits[i] &= ~LOOM_AMDGPU_WAIT_CROSS_BLOCK_READ_INDEPENDENT;
+    }
+    if (opaque_read) {
+      effect_bits[i] &= ~LOOM_AMDGPU_WAIT_CROSS_BLOCK_WRITE_INDEPENDENT;
+    }
+  }
+  for (iree_host_size_t r = 0; r < read_count; ++r) {
+    for (iree_host_size_t w = 0; w < write_count; ++w) {
+      if (loom_low_memory_access_summaries_may_alias(
+              reads[r].summary, writes[w].summary,
+              LOOM_LOW_MEMORY_COMPARISON_INDEPENDENT)) {
+        effect_bits[reads[r].node_index] &=
+            ~LOOM_AMDGPU_WAIT_CROSS_BLOCK_READ_INDEPENDENT;
+        effect_bits[writes[w].node_index] &=
+            ~LOOM_AMDGPU_WAIT_CROSS_BLOCK_WRITE_INDEPENDENT;
+      }
+    }
+  }
+  classification->cross_block_independence = effect_bits;
+  return iree_ok_status();
+}
+
 // Classification has one hot caller. Preserve its caller specialization while
 // retaining an external definition for ordinary non-LTO builds.
 extern IREE_ATTRIBUTE_ALWAYS_INLINE iree_status_t
@@ -777,5 +894,6 @@ loom_amdgpu_wait_classification_build(
     loom_amdgpu_wait_classification_classify_vmem_suffixes(
         schedule, out_classification->frontier_nodes);
   }
-  return iree_ok_status();
+  return loom_amdgpu_wait_classification_classify_cross_block(
+      schedule, arena, out_classification);
 }
diff --git a/loom/src/loom/target/arch/amdgpu/planning/wait_classification.h b/loom/src/loom/target/arch/amdgpu/planning/wait_classification.h
index fc1fc83fda..0245872068 100644
--- a/loom/src/loom/target/arch/amdgpu/planning/wait_classification.h
+++ b/loom/src/loom/target/arch/amdgpu/planning/wait_classification.h
@@ -97,6 +97,13 @@ static_assert(sizeof(loom_amdgpu_wait_node_state_t) == 12,
               "classified wait-node state must remain compact");
 
 // Target wait state indexed by the completed low schedule.
+enum {
+  // No write anywhere in the function may alias this node's dependency reads.
+  LOOM_AMDGPU_WAIT_CROSS_BLOCK_READ_INDEPENDENT = 1u << 0,
+  // No read anywhere in the function may alias this node's dependency writes.
+  LOOM_AMDGPU_WAIT_CROSS_BLOCK_WRITE_INDEPENDENT = 1u << 1,
+};
+
 typedef struct loom_amdgpu_wait_classification_t {
   // Compact target state indexed by schedule node. Classification flags and
   // decoded effects are stable; action planning may add path-resolved implicit
@@ -105,6 +112,9 @@ typedef struct loom_amdgpu_wait_classification_t {
   // Memory facts indexed by schedule node. Action planning records locally
   // completed producer prefixes in the same compact rows.
   loom_amdgpu_wait_frontier_node_t* frontier_nodes;
+  // Per-node LOOM_AMDGPU_WAIT_CROSS_BLOCK_* bits, or NULL without source
+  // memory summaries or when opaque accesses make every node dependent.
+  uint8_t* cross_block_independence;
   // Counter facts indexed by schedule node. Classification owns the producer,
   // write, hazard, and workgroup fields; dependency completion analysis
   // finalizes reset and block-exit fields before action planning begins.
diff --git a/loom/src/loom/target/arch/amdgpu/planning/wait_plan.c b/loom/src/loom/target/arch/amdgpu/planning/wait_plan.c
index f6b6bf9e82..9b11a4eb68 100644
--- a/loom/src/loom/target/arch/amdgpu/planning/wait_plan.c
+++ b/loom/src/loom/target/arch/amdgpu/planning/wait_plan.c
@@ -2560,11 +2560,23 @@ static uint32_t loom_amdgpu_wait_plan_outstanding_counter_mask(
 static iree_status_t
 loom_amdgpu_wait_plan_handle_cross_block_memory_dependencies(
     loom_amdgpu_wait_plan_builder_t* builder, uint32_t node_index) {
-  const loom_amdgpu_wait_frontier_node_t* frontier_node =
-      &builder->classification.frontier_nodes[node_index];
+  loom_amdgpu_wait_frontier_node_t query_node =
+      builder->classification.frontier_nodes[node_index];
+  if (builder->classification.cross_block_independence != NULL) {
+    const uint8_t independence =
+        builder->classification.cross_block_independence[node_index];
+    if (iree_any_bit_set(independence,
+                         LOOM_AMDGPU_WAIT_CROSS_BLOCK_READ_INDEPENDENT)) {
+      query_node.read_space_flags = 0;
+    }
+    if (iree_any_bit_set(independence,
+                         LOOM_AMDGPU_WAIT_CROSS_BLOCK_WRITE_INDEPENDENT)) {
+      query_node.write_space_flags = 0;
+    }
+  }
   const uint32_t counter_mask =
       loom_amdgpu_wait_frontier_memory_dependency_mask(&builder->frontier,
-                                                       frontier_node);
+                                                       &query_node);
   if (counter_mask == 0) {
     return iree_ok_status();
   }
