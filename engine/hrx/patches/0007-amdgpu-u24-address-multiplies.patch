+// Scale flags for an index whose byte offset index x byte_stride is described
+// by product_facts: a non-negative product below 2^24 x byte_stride proves the
+// index fits 24 bits, so v_mul_u32_u24 (full rate) replaces v_mul_lo_u32.
+static loom_amdgpu_vgpr_scale_u32_flags_t loom_amdgpu_memory_scale_flags(
+    loom_value_facts_t product_facts, uint64_t byte_stride) {
+  int64_t product_max = 0;
+  if (byte_stride == 0 || byte_stride > INT64_MAX ||
+      !loom_value_facts_as_non_negative_i64_maximum(product_facts,
+                                                    &product_max) ||
+      product_max / (int64_t)byte_stride >= (INT64_C(1) << 24)) {
+    return LOOM_AMDGPU_VGPR_SCALE_U32_FLAG_NONE;
+  }
+  return LOOM_AMDGPU_VGPR_SCALE_U32_FLAG_VALUE_UNSIGNED_24;
+}
