+// EXPERIMENT (opt-in): schedule controls for hand-scheduled locked bodies
+// (LOOM_EXP_LOCKED_PACK). Each is read once from the environment; unset keeps
+// the default plan.
+//   LOOM_EXP_LOCKED_HOIST=K: a FIFO pop or fill (and, with
+//     LOOM_EXP_LOCKED_HOIST_ACC=1 / _ST=1, an accumulator load / store) may
+//     issue up to K cycles below the authored-order floor. The register event
+//     frontier keeps a delayed write behind the last read of the old value.
+//   LOOM_EXP_LOCKED_VIEWS=1: views (no descriptor) are not order boundaries.
+//   LOOM_EXP_LOCKED_FLOAT=all|p1,p2,..: instructions with these mnemonic
+//     prefixes issue at or after the floor without raising it.
+//   LOOM_EXP_LATE_READ=m1,m2,..: these mnemonics read their register operands
+//     at stage 2 (the tables say 1): their reads are committed again as
+//     read.c2 events (vmov.vector512.to.accumulator512 reads a cycle late).
+//   LOOM_EXP_DELAYFILL=1|2: an unconditional branch (2: also a conditional
+//     one) is placed in its block's last delay window so the block's last
+//     bundles become its delay slots; 2 lets the branch share a bundle with
+//     one other slot. LOOM_EXP_DELAYFILL_NOEFF=1: a conditional branch waits
+//     for its sources only, not for resources or memory effects to drain (the
+//     generator orders the loop's effects). LOOM_EXP_DELAYFILL_EFFD=1: a back
+//     edge's memory effects need only land by the target's first
+//     memory-effect instruction.
+//   LOOM_EXP_BANKMAP=<file>: memory ops keep off the 16 KB banks other mapped
+//     ops touch in the same cycle. Lines "name mask stage" (name = result 0,
+//     or "st:" + operand 0 for stores; mask bit 7 = never moves), "@ mask
+//     cycle" (a pre-booked bank slot) and "= name cycle" (the op's cycle in
+//     the pass that wrote the map). LOOM_EXP_BANKDRIFT=1 checks pre-booked
+//     slots shifted by how far the never-move ops drifted from their map
+//     cycles. LOOM_EXP_POPDODGE=n: never-move ops dodge this plan's own
+//     bookings for at most n cycles.
+typedef struct loom_aie2p_bundle_plan_options_t {
+  uint32_t locked_hoist;
+  bool locked_hoist_acc;
+  bool locked_hoist_st;
+  bool locked_views;
+  const char* locked_float;
+  const char* late_read;
+  uint8_t delay_fill;
+  bool delay_fill_no_effect_wait;
+  bool delay_fill_effect_drain;
+  bool bank_drift;
+  uint32_t pop_dodge;
+} loom_aie2p_bundle_plan_options_t;
+
+static bool loom_aie2p_env_is_one(const char* name) {
+  const char* value = getenv(name);
+  return value && value[0] == '1';
+}
+
+static const loom_aie2p_bundle_plan_options_t* loom_aie2p_bundle_plan_options(
+    void) {
+  static int initialized = 0;
+  static loom_aie2p_bundle_plan_options_t options;
+  if (!initialized) {
+    const char* hoist = getenv("LOOM_EXP_LOCKED_HOIST");
+    options.locked_hoist = hoist ? (uint32_t)atoi(hoist) : 0;
+    options.locked_hoist_acc =
+        loom_aie2p_env_is_one("LOOM_EXP_LOCKED_HOIST_ACC");
+    options.locked_hoist_st = loom_aie2p_env_is_one("LOOM_EXP_LOCKED_HOIST_ST");
+    options.locked_views = getenv("LOOM_EXP_LOCKED_VIEWS") != NULL;
+    options.locked_float = getenv("LOOM_EXP_LOCKED_FLOAT");
+    options.late_read = getenv("LOOM_EXP_LATE_READ");
+    const char* fill = getenv("LOOM_EXP_DELAYFILL");
+    options.delay_fill = fill ? (fill[0] == '2' ? 2 : 1) : 0;
+    options.delay_fill_no_effect_wait =
+        getenv("LOOM_EXP_DELAYFILL_NOEFF") != NULL;
+    options.delay_fill_effect_drain = getenv("LOOM_EXP_DELAYFILL_EFFD") != NULL;
+    options.bank_drift = loom_aie2p_env_is_one("LOOM_EXP_BANKDRIFT");
+    const char* dodge = getenv("LOOM_EXP_POPDODGE");
+    options.pop_dodge = dodge ? (uint32_t)atoi(dodge) : 0;
+    initialized = 1;
+  }
+  return &options;
+}
+
+// Whether name (length n) matches an entry of the comma-separated list, as a
+// prefix or exactly.
+static bool loom_aie2p_list_contains(const char* list, const char* name,
+                                     iree_host_size_t n, bool prefix) {
+  for (const char* p = list; p && *p;) {
+    const char* comma = strchr(p, ',');
+    const iree_host_size_t k =
+        comma ? (iree_host_size_t)(comma - p) : strlen(p);
+    if (prefix ? (k <= n && memcmp(name, p, k) == 0)
+               : (k == n && memcmp(name, p, k) == 0)) {
+      return true;
+    }
+    p += k + (comma ? 1 : 0);
+  }
+  return false;
+}
+
+#define LOOM_AIE2P_BANK_MAP_CYCLES 65536
+#define LOOM_AIE2P_BANK_MAP_NEVER_MOVES 0x80u
+
+typedef struct loom_aie2p_bank_map_entry_t {
+  char name[48];
+  uint8_t mask;
+  uint8_t stage;
+  // The op's cycle in the pass that wrote the map, or -1.
+  int32_t map_cycle;
+} loom_aie2p_bank_map_entry_t;
+
+typedef struct loom_aie2p_bank_map_t {
+  loom_aie2p_bank_map_entry_t* entries;
+  int count;
+  // Pre-booked bank masks by cycle.
+  uint8_t pre[LOOM_AIE2P_BANK_MAP_CYCLES];
+} loom_aie2p_bank_map_t;
+
+static int loom_aie2p_bank_map_entry_compare(const void* a, const void* b) {
+  return strcmp(((const loom_aie2p_bank_map_entry_t*)a)->name,
+                ((const loom_aie2p_bank_map_entry_t*)b)->name);
+}
+
+// The LOOM_EXP_BANKMAP file, loaded once (process lifetime), or NULL.
+static const loom_aie2p_bank_map_t* loom_aie2p_bank_map(void) {
+  static int loaded = 0;
+  static loom_aie2p_bank_map_t* map = NULL;
+  if (loaded) {
+    return map;
+  }
+  loaded = 1;
+  const char* path = getenv("LOOM_EXP_BANKMAP");
+  FILE* file = path ? fopen(path, "r") : NULL;
+  if (!file) {
+    return NULL;
+  }
+  map = (loom_aie2p_bank_map_t*)calloc(1, sizeof(*map));
+  const int capacity = 4096;
+  map->entries =
+      (loom_aie2p_bank_map_entry_t*)calloc(capacity, sizeof(*map->entries));
+  loom_aie2p_bank_map_entry_t* cycles =
+      (loom_aie2p_bank_map_entry_t*)calloc(capacity, sizeof(*cycles));
+  if (!map->entries || !cycles) {
+    fclose(file);
+    free(cycles);
+    free(map ? map->entries : NULL);
+    free(map);
+    map = NULL;
+    return NULL;
+  }
+  int cycle_count = 0;
+  char name[64], line[256];
+  unsigned mask = 0, value = 0;
+  while (map->count < capacity && fgets(line, sizeof(line), file)) {
+    if (line[0] == '=') {
+      if (cycle_count < capacity &&
+          sscanf(line + 1, "%63s %u", name, &value) == 2) {
+        snprintf(cycles[cycle_count].name, sizeof(cycles[cycle_count].name),
+                 "%s", name);
+        cycles[cycle_count++].map_cycle = (int32_t)value;
+      }
+      continue;
+    }
+    if (sscanf(line, "%63s %u %u", name, &mask, &value) != 3) {
+      continue;
+    }
+    if (name[0] == '@') {
+      if (value < LOOM_AIE2P_BANK_MAP_CYCLES) {
+        map->pre[value] |= (uint8_t)mask;
+      }
+      continue;
+    }
+    loom_aie2p_bank_map_entry_t* entry = &map->entries[map->count++];
+    snprintf(entry->name, sizeof(entry->name), "%s", name);
+    entry->mask = (uint8_t)mask;
+    entry->stage = (uint8_t)value;
+    entry->map_cycle = -1;
+  }
+  fclose(file);
+  qsort(map->entries, map->count, sizeof(*map->entries),
+        loom_aie2p_bank_map_entry_compare);
+  for (int i = 0; i < cycle_count; ++i) {
+    loom_aie2p_bank_map_entry_t* entry = (loom_aie2p_bank_map_entry_t*)bsearch(
+        &cycles[i], map->entries, map->count, sizeof(cycles[i]),
+        loom_aie2p_bank_map_entry_compare);
+    if (entry) {
+      entry->map_cycle = cycles[i].map_cycle;
+    }
+  }
+  free(cycles);
+  return map;
+}
