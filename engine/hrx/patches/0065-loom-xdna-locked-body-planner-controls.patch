+// LOOM_EXP_LATE_READ: commits the register reads of a listed mnemonic again
+// as stage-2 reads.
+static iree_status_t loom_aie2p_bundle_plan_commit_late_reads(
+    loom_aie2p_bundle_plan_builder_t* builder, uint32_t cycle) {
+  const char* list = loom_aie2p_bundle_plan_options()->late_read;
+  if (!list) {
+    return iree_ok_status();
+  }
+  const loom_low_descriptor_set_t* descriptor_set = builder->descriptor_set;
+  static uint16_t late_event = LOOM_LOW_TIMING_EVENT_NONE;
+  static int resolved = 0;
+  if (!resolved) {
+    for (uint16_t e = 0; e < descriptor_set->timing_event_count; ++e) {
+      if (iree_string_view_equal(
+              loom_low_descriptor_set_string(
+                  descriptor_set,
+                  descriptor_set->timing_events[e].name_string_ref),
+              IREE_SV("amd.xdna.aie2p.operand.read.c2.none"))) {
+        late_event = e;
+      }
+    }
+    resolved = 1;
+  }
+  if (late_event == LOOM_LOW_TIMING_EVENT_NONE) {
+    return iree_ok_status();
+  }
+  const loom_low_descriptor_t* descriptor =
+      &descriptor_set->descriptors[builder->instructions[0].descriptor_ordinal];
+  const iree_string_view_t mnemonic = loom_low_descriptor_set_string(
+      descriptor_set, descriptor->mnemonic_string_ref);
+  if (!loom_aie2p_list_contains(list, mnemonic.data, mnemonic.size,
+                                /*prefix=*/false)) {
+    return iree_ok_status();
+  }
+  for (uint16_t j = 0; j < descriptor->operand_count; ++j) {
+    const loom_low_operand_t* operand =
+        &descriptor_set->operands[descriptor->operand_start + j];
+    if (operand->read_event_id == LOOM_LOW_TIMING_EVENT_NONE) {
+      continue;
+    }
+    IREE_RETURN_IF_ERROR(loom_low_schedule_event_frontier_commit(
+        &builder->issue.events, builder->instructions[0].physical_registers[j],
+        late_event, cycle));
+  }
+  return iree_ok_status();
+}
