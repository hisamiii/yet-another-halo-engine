+// LOOM_EXP_BANKMAP: the map entry of the current op, or NULL.
+static const loom_aie2p_bank_map_entry_t* loom_aie2p_bundle_plan_bank_entry(
+    const loom_aie2p_bundle_plan_builder_t* builder) {
+  const loom_aie2p_bank_map_t* map = builder->bank_map;
+  const loom_op_t* op = builder->current_op;
+  if (!map || !map->count || !op) {
+    return NULL;
+  }
+  loom_aie2p_bank_map_entry_t key;
+  if (op->result_count) {
+    const iree_string_view_t name =
+        loom_module_value_name(builder->frame->module, loom_op_results(op)[0]);
+    snprintf(key.name, sizeof(key.name), "%.*s", (int)name.size, name.data);
+  } else if (op->operand_count) {
+    const iree_string_view_t name =
+        loom_module_value_name(builder->frame->module, loom_op_operands(op)[0]);
+    snprintf(key.name, sizeof(key.name), "st:%.*s", (int)name.size, name.data);
+  } else {
+    return NULL;
+  }
+  return (const loom_aie2p_bank_map_entry_t*)bsearch(
+      &key, map->entries, map->count, sizeof(key),
+      loom_aie2p_bank_map_entry_compare);
+}
+
+// LOOM_EXP_BANKMAP: whether entry's banks are taken at cycle (+ its stage).
+static bool loom_aie2p_bundle_plan_bank_busy_at(
+    loom_aie2p_bundle_plan_builder_t* builder,
+    const loom_aie2p_bank_map_entry_t* entry, uint32_t cycle) {
+  if (!entry || cycle + entry->stage >= LOOM_AIE2P_BANK_MAP_CYCLES) {
+    return false;
+  }
+  const uint32_t at = cycle + entry->stage;
+  const uint8_t mask = entry->mask & 0x0Fu;
+  if (entry->mask & LOOM_AIE2P_BANK_MAP_NEVER_MOVES) {
+    const uint32_t dodge = loom_aie2p_bundle_plan_options()->pop_dodge;
+    if (!dodge) {
+      return false;
+    }
+    if (entry != builder->dodge_entry) {
+      builder->dodge_entry = entry;
+      builder->dodge_first_cycle = cycle;
+    }
+    if (cycle >= builder->dodge_first_cycle + dodge) {
+      return false;
+    }
+    return (builder->bank_busy[at] & mask) != 0;
+  }
+  if (loom_aie2p_bundle_plan_options()->bank_drift) {
+    const int64_t shifted = (int64_t)at - builder->bank_drift;
+    const uint8_t pre = shifted >= 0 && shifted < LOOM_AIE2P_BANK_MAP_CYCLES
+                            ? builder->bank_map->pre[shifted]
+                            : 0;
+    return ((builder->bank_busy[at] | pre) & mask) != 0;
+  }
+  return (builder->bank_busy[at] & mask) != 0;
+}
