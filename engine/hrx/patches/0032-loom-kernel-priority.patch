+iree_status_t loom_amdgpu_select_kernel_priority_plan(
+    loom_low_lower_context_t* context, const loom_op_t* source_op,
+    loom_low_lower_plan_t* out_plan) {
+  *out_plan = loom_low_lower_plan_empty();
+  if (!loom_kernel_priority_isa(source_op) ||
+      !loom_amdgpu_descriptor_set_has_ref(
+          loom_low_lower_context_descriptor_set(context),
+          LOOM_AMDGPU_DESCRIPTOR_REF_S_SETPRIO)) {
+    return iree_ok_status();
+  }
+  *out_plan = loom_low_lower_plan_make(source_op->kind, NULL);
+  return iree_ok_status();
+}
+
+iree_status_t loom_amdgpu_lower_kernel_priority(
+    loom_low_lower_context_t* context, const loom_op_t* source_op) {
+  return loom_amdgpu_build_control_packet_priority(
+      loom_low_lower_context_builder(context),
+      loom_low_lower_context_descriptor_set(context),
+      (uint32_t)loom_kernel_priority_level(source_op), source_op->location);
+}
+
+iree_status_t loom_amdgpu_low_legality_verify_kernel_priority(
+    const loom_target_low_legality_provider_t* provider,
+    loom_target_low_legality_context_t* context, const loom_op_t* op,
+    bool* out_handled) {
+  (void)provider;
+  *out_handled = loom_kernel_priority_isa(op);
+  if (!*out_handled) {
+    return iree_ok_status();
+  }
+  if (!loom_amdgpu_descriptor_set_has_ref(
+          loom_target_low_legality_descriptor_set(context),
+          LOOM_AMDGPU_DESCRIPTOR_REF_S_SETPRIO)) {
+    return loom_amdgpu_low_legality_reject(context, op,
+                                           IREE_SV("descriptor.s_setprio"));
+  }
+  return iree_ok_status();
+}
