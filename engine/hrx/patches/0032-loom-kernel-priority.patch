+# kernel.priority — issue priority hint for the current subgroup
+# ============================================================================
+
+kernel_priority = Op(
+    name="kernel.priority",
+    group=kernel_ops,
+    phase=OpPhase.EXECUTABLE,
+    doc=(
+        "Set the instruction issue priority of the current subgroup relative "
+        "to other subgroups resident on the same execution unit. Level 0 is "
+        "the default; higher levels win issue arbitration until the next "
+        "kernel.priority. The op has no memory or value effects and keeps its "
+        "position relative to the surrounding target instructions, so a pair "
+        "of kernel.priority ops brackets the code that should issue first."
+    ),
+    attrs=[
+        AttrDef(
+            "level",
+            ATTR_TYPE_I64,
+            doc="Issue priority level, 0 (default) through 3.",
+        ),
+    ],
+    traits=[OBSERVABLE_EFFECT, HasAncestor("kernel.def")],
+    verify="loom_kernel_priority_verify",
+    format=[
+        AttrDict(),
+    ],
+    examples=[
+        "kernel.priority {level = 3}",
+    ],
+)
