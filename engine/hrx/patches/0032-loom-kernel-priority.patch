+iree_status_t loom_kernel_priority_verify(const loom_module_t* module,
+                                         const loom_op_t* op,
+                                         iree_diagnostic_emitter_t emitter) {
+  (void)module;
+  int64_t level = loom_kernel_priority_level(op);
+  if (level < 0 || level > 3) {
+    return loom_kernel_emit_attribute_value_constraint(
+        emitter, op, IREE_SV("level"), level, IREE_SV("priority level 0..3"));
+  }
+  return iree_ok_status();
+}
