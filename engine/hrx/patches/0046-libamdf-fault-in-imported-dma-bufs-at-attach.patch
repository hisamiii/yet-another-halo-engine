@@ -7,6 +7,7 @@
 #ifndef AMDF_SRC_XDNA_UMD_DRM_BUFFER_H_
 #define AMDF_SRC_XDNA_UMD_DRM_BUFFER_H_
 
+#include <stdbool.h>
 #include <stddef.h>
 
 #include "amdf/amdf.h"
@@ -19,6 +20,9 @@ typedef struct amdf_linux_xdna_buffer_t {
   uint32_t handle;
   // Native `AMDXDNA_BO_*` allocation type fixed by creation.
   uint32_t type;
+  // Imported from another driver's dma-buf (its mapping is faulted in at
