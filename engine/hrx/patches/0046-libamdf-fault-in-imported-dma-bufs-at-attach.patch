libamdf: fault in an imported dma-buf's mapping at attach.

Since Linux 7.4 (amdxdna df4d535206) mmap of an imported BO no longer faults its pages in; the kernel leaves that to
the submit-time populate, which uses hmm_range_fault and rejects the exporter's VM_PFNMAP | VM_IO mapping (KFD / TTM
dma-bufs). The NPU then walks not-present ptes through SVA: AMD-Vi IO_PAGE_FAULTs and an all-NaN prefill. A BO list
does not help (duplicate imports share one resv: EALREADY; populate: EFAULT), so the attach reads one byte per page
from the CPU (ttm_bo_vm_fault installs the ptes), imports only. Older kernels prefault in mmap: the reads find them.
diff --git a/libamdf/src/xdna/umd/drm/buffer.c b/libamdf/src/xdna/umd/drm/buffer.c
index 56f7b66fd1..9d8e317d34 100644
--- a/libamdf/src/xdna/umd/drm/buffer.c
+++ b/libamdf/src/xdna/umd/drm/buffer.c
@@ -54,6 +54,7 @@ amdf_status_t amdf_linux_xdna_buffer_import_dma_buf(
   *out_buffer = (amdf_linux_xdna_buffer_t){
       .handle = create.handle,
       .type = AMDXDNA_BO_SHARE,
+      .imported = true,
       .byte_length = byte_length,
   };
   return AMDF_STATUS_OK;
@@ -173,6 +174,17 @@ amdf_status_t amdf_linux_xdna_buffer_attach(
       buffer->host_pointer = mapping;
       return AMDF_STATUS_OK;
     }
+    if (buffer->imported) {
+      // Since Linux 7.4 (amdxdna df4d535206) mmap no longer faults an
+      // imported dma-buf in, and the submit-time populate (hmm_range_fault)
+      // rejects the exporter's PFN mapping (TTM), so a BO list cannot replace
+      // this. The NPU walks this VA through SVA: fault every page in from the
+      // CPU now. On older kernels the pages are present and nothing faults.
+      for (size_t offset = 0; offset < buffer->byte_length;
+           offset += page_size) {
+        (void)*(volatile const uint8_t*)((const uint8_t*)mapping + offset);
+      }
+    }
     // mmap establishes SVA; the pre-mmap query does not yet have its address.
     if (ioctl(descriptor, DRM_IOCTL_AMDXDNA_GET_BO_INFO, &info) != 0) {
       return amdf_linux_error(errno);
