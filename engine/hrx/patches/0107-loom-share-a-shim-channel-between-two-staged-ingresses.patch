--- a/loom/src/loom/target/arch/amd/xdna/aie2p/array/plan.h
+++ b/loom/src/loom/target/arch/amd/xdna/aie2p/array/plan.h
@@ -811,10 +811,31 @@
 // LOOM_EXP_PACKET_SHARE=<channel>:<payload>[,<channel>:<payload>...]
 // (EXPERIMENT): each core stream egress channel may borrow its payload's lanes
 // up to the payload's receiver, as packets. Returns the pair count (<= max).
+// LOOM_EXP_SHIM_SHARE=<channel>:<host>[,...] (EXPERIMENT): a staged ingress
+// channel rides on its host staged ingress's shim DMA channel (its own
+// descriptors, queued per push after the host's): the host's descriptors carry
+// packet id 1, the channel's id 2, and the channel's fill route branches off the
+// host's at the host's memory tile, where each id picks its master and drops
+// its header. The pairs also count as LOOM_EXP_PACKET_SHARE pairs (planned after
+// their host, the branch switch configured as a part).
+static inline uint32_t loom_aie2p_array_shim_share_host(uint32_t channel) {
+  const char* env = getenv("LOOM_EXP_SHIM_SHARE");
+  while (env && *env) {
+    unsigned c = 0, h = 0;
+    int used = 0;
+    if (sscanf(env, "%u:%u%n", &c, &h, &used) != 2) break;
+    if (c == channel) return h;
+    env += used;
+    if (*env == ',') ++env;
+  }
+  return UINT32_MAX;
+}
+
 static inline int loom_aie2p_array_share_pairs(uint32_t* channels,
                                                uint32_t* payloads, int max) {
-  const char* env = getenv("LOOM_EXP_PACKET_SHARE");
   int n = 0;
+  for (int pass = 0; pass < 2; ++pass) {
+  const char* env = getenv(pass ? "LOOM_EXP_SHIM_SHARE" : "LOOM_EXP_PACKET_SHARE");
   while (env && *env && n < max) {
     unsigned c = 0, p = 0;
     int used = 0;
@@ -825,6 +846,7 @@
     env += used;
     if (*env == ',') ++env;
   }
+  }
   return n;
 }
 
