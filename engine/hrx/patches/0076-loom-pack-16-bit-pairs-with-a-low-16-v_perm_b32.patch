+++ b/loom/py/loom/target/arch/amdgpu/descriptors/alu.py
@@ -2649,6 +2649,42 @@ def _v_perm_b32_src2_literal_overlay() -> AmdgpuDescriptorOverlay:
     )
 
 
+def _v_perm_b32_lo16_pair_src2_literal_overlay() -> AmdgpuDescriptorOverlay:
+    """V_PERM_B32 with a literal selector that reads bytes 0..1 of each source
+    (0x05040100: two 16-bit lanes into one register). Its sources are low-16
+    parts, so a source whose upper half is undefined (a 16-bit result) is legal."""
+    return AmdgpuDescriptorOverlay(
+        descriptor_key="amdgpu.v_perm_b32.lo16_pair_src2_lit",
+        instruction_name="V_PERM_B32",
+        mnemonic="v_perm_b32_lo16_pair_src2_lit",
+        encoding_name="ENC_VOP3",
+        encoding_format_id=AMDGPU_ENCODING_FORMAT_VOP3_LITERAL,
+        semantic_tag="integer.byte.permute.u32",
+        schedule_class=_SCHEDULE_VALU,
+        operands=(
+            AmdgpuOperandOverlay("VDST", _vgpr_result()),
+            AmdgpuOperandOverlay(
+                "SRC0",
+                _vgpr_operand("src0", register_part=_REG_PART_VGPR_LOW16),
+                size_exception_reason=_D16_PARTIAL_REGISTER_SIZE_REASON,
+            ),
+            AmdgpuOperandOverlay(
+                "SRC1",
+                _vgpr_operand("src1", register_part=_REG_PART_VGPR_LOW16),
+                size_exception_reason=_D16_PARTIAL_REGISTER_SIZE_REASON,
+            ),
+        ),
+        asm_forms=_asm(
+            results=("dst",),
+            operands=("src0", "src1"),
+            immediates=("imm32",),
+        ),
+        immediates=(_LITERAL_U32_IMMEDIATE,),
+        fixed_encoding_fields=(("SRC2", _predefined("SRC_LITERAL", "OPR_SRC")),),
+        flags=(DescriptorFlag.DEAD_REMOVABLE,),
+    )
+
+
 def _v_perm_b32_src1_zero_src2_literal_overlay() -> AmdgpuDescriptorOverlay:
     return AmdgpuDescriptorOverlay(
         descriptor_key="amdgpu.v_perm_b32.src1_zero_src2_lit",
@@ -2912,6 +2948,7 @@ def _integer_bitwise_permute_overlays(
         *(
             (
                 _v_perm_b32_src2_literal_overlay(),
+                _v_perm_b32_lo16_pair_src2_literal_overlay(),
                 _v_perm_b32_src1_zero_src2_literal_overlay(),
             )
             if include_vop3_literal_forms
