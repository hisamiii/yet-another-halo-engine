+// V_PERM_B32 selector placing SRC1 bytes 0..1 in bits 0..15 and SRC0 bytes 0..1
+// in bits 16..31: two 16-bit lanes in one register whatever their upper bits.
+#define LOOM_AMDGPU_B16_PAIR_PERMUTE_SELECTOR UINT32_C(0x05040100)
+
+// Packs lanes |lane_base| (bits 0..15) and |lane_base| + 1 (bits 16..31) with one
+// V_PERM_B32 instead of clearing, shifting and or-ing the two halves.
+static iree_status_t loom_amdgpu_pack_16bit_lane_pair_with_permute(
+    loom_low_lower_context_t* context, const loom_op_t* source_op,
+    const loom_amdgpu_vector_from_elements_plan_t* plan,
+    const loom_low_lower_resolved_descriptor_t* permute, uint32_t lane_base,
+    loom_type_t lane_type, loom_value_id_t* out_packed) {
+  loom_value_id_t low_lane =
+      loom_low_lower_lookup_value(context, plan->payload.elements[lane_base]);
+  loom_value_id_t high_lane = loom_low_lower_lookup_value(
+      context, plan->payload.elements[lane_base + 1u]);
+  IREE_RETURN_IF_ERROR(loom_amdgpu_materialize_low_vgpr_b32(
+      context, source_op, low_lane, &low_lane));
+  IREE_RETURN_IF_ERROR(loom_amdgpu_materialize_low_vgpr_b32(
+      context, source_op, high_lane, &high_lane));
+  return loom_amdgpu_emit_resolved_vgpr_binary_immediate(
+      context, source_op, permute, high_lane, low_lane,
+      LOOM_AMDGPU_B16_PAIR_PERMUTE_SELECTOR, lane_type, out_packed);
+}
