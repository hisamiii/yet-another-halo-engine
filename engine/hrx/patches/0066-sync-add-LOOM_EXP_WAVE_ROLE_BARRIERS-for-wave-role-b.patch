From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hisamiii <265242552+hisamiii@users.noreply.github.com>
Date: Sat, 14 Nov 2026 19:17:36 +0100
Subject: [PATCH 66/73] sync : add LOOM_EXP_WAVE_ROLE_BARRIERS for wave role
 branches

Workgroup barriers under wave-uniform control pass when the source opts in.

Assisted-by: Claude Opus 5.5
---
 .../kernel_synchronization_legality.c         | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/loom/src/loom/analysis/kernel_synchronization_legality.c b/loom/src/loom/analysis/kernel_synchronization_legality.c
index ea15ef54e3..dd1f747754 100644
--- a/loom/src/loom/analysis/kernel_synchronization_legality.c
+++ b/loom/src/loom/analysis/kernel_synchronization_legality.c
@@ -6,6 +6,7 @@
 
 #include "loom/analysis/kernel_synchronization_legality.h"
 
+#include <stdlib.h>
 #include <string.h>
 
 #include "iree/base/internal/arena.h"
@@ -428,6 +429,15 @@ static bool loom_kernel_accept_matched_barrier_branch(
   return loom_kernel_barrier_op_signature(context, branch_op, &signature);
 }
 
+static bool loom_kernel_synchronization_legality_wave_role_barriers(void) {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char* value = getenv("LOOM_EXP_WAVE_ROLE_BARRIERS");
+    enabled = value && strcmp(value, "1") == 0;
+  }
+  return enabled;
+}
+
 static iree_status_t loom_kernel_synchronization_legality_check_barrier_control(
     loom_kernel_synchronization_legality_state_t* state, const loom_op_t* op) {
   const loom_value_fact_uniform_scope_t required_scope =
@@ -454,6 +464,18 @@ static iree_status_t loom_kernel_synchronization_legality_check_barrier_control(
   if (proven) {
     return iree_ok_status();
   }
+  // LOOM_EXP_WAVE_ROLE_BARRIERS=1: the source asserts that wave-uniform role
+  // branches run matching barrier sequences (each wave arrives at every barrier
+  // instance once, as AMDGPU s_barrier counts). Workgroup barriers then need
+  // only wave-uniform control; lane-divergent control still fails.
+  if (required_scope == LOOM_VALUE_FACT_UNIFORM_SCOPE_WORKGROUP &&
+      loom_kernel_barrier_isa(op) &&
+      loom_kernel_synchronization_legality_wave_role_barriers() &&
+      loom_control_uniformity_prove_execution(
+          &state->control_uniformity, op,
+          LOOM_VALUE_FACT_UNIFORM_SCOPE_SUBGROUP, NULL)) {
+    return iree_ok_status();
+  }
 
   loom_diagnostic_param_t params[] = {
       loom_param_string(
