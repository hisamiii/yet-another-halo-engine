// YAH FFN GEMM with in-kernel Q3_K decode and the SwiGLU epilogue, Loom port of
// HalfPrefillGemmKernel<..., kQ3_K, kSwiGLU>.
//
// HIP source: prefill_fp16.hip. The decoder and K loop are yah_ffn_gemm_q3k_swiglu_f32;
// the epilogue combines the accumulator with the separate f32 gate projection:
//
//   out[token*m + row] = round_f16(silu(gate[token*m + row]) * acc[row][token])
//
// This is the FFN up-projection fallback arm (LaunchBatchedQuantGEMMSwiGLUFp16),
// taken when TryLaunchBatchedDualQuantGEMMSwiGLUFp16 declines the pair: it only
// instantiates ten mixed pairs and four same-format pairs, so every other layer
// of this shard runs this arm. It is on the route.
//
// Measured: 16.33 ms at m_tiles=1088 (production 17408 rows). The decoder, K
// loop and the silu combine are untuned.
//
// Correctness case: the same packed fixture, the activation scaled to 1024 so the
// accumulator stays inside the f16 range, gate = 1, and the expected is
// round_f16(silu(1) * acc). The production-size case uses an all-zero weight, so
// the accumulator is zero and every output is zero.
//
// Required config (correctness): --config=yah_ffn_gemm_q3k_swiglu_swiglu.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_q3k_swiglu_swiglu.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_q3k_swiglu.m_tiles : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_q3k_swiglu.k_blocks : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_q3k_swiglu.token_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_q3k_swiglu() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_q3k_swiglu.m_tiles : index
  %token_tiles = config.get @yah_ffn_gemm_q3k_swiglu.token_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %token_tiles, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %input: buffer, %gate: buffer, %wstage: buffer, %ostage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lds_bytes = index.constant 512 : offset
  %wstage_lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %wstage_lds_view = buffer.view %wstage_lds[%base] : buffer -> view<16x16xf16>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c5120 = index.constant 5120 : index
  %c17600 = index.constant 17600 : index
  %c35200 = index.constant 35200 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c7i = scalar.constant 7 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c54i = scalar.constant 54 : i32
  %c63i = scalar.constant 63 : i32
  %c96i = scalar.constant 96 : i32
  %c110i = scalar.constant 110 : i32
  %c255i = scalar.constant 255 : i32
  %c2200i = scalar.constant 2200 : i32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %m_tiles = config.get @yah_ffn_gemm_q3k_swiglu.m_tiles : index
  %k_blocks = config.get @yah_ffn_gemm_q3k_swiglu.k_blocks : index
  %token_tiles = config.get @yah_ffn_gemm_q3k_swiglu.token_tiles : index
  %cbb = index.constant 110 : index
  %cbb2 = index.constant 55 : index
  %ktot = index.mul %k_blocks, %c256 : index
  %tokens = index.mul %token_tiles, %c64 : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %bpr = index.mul %k_blocks, %cbb : index
  %hpr = index.mul %k_blocks, %cbb2 : index
  %w_bytes = index.mul %m_rows, %bpr : index
  %w_halfs = index.mul %m_rows, %hpr : index
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %out_total = index.mul %m_rows, %tokens : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [%c1, %ktot] : encoding<layout>
  %weight_na, %input_na, %gate_na, %wstage_na, %ostage_na, %output_na = buffer.assume.noalias %weight, %input, %gate, %wstage, %ostage, %output : buffer, buffer, buffer, buffer, buffer, buffer
  %wg_y = kernel.workgroup.id<y> : index
  %token_base = index.mul %wg_y, %c64 : index
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<[%ktot]x[%tokens]xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf16>
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<[%out_total]xf32>
  %ostage_view = buffer.view %ostage_na[%base] : buffer -> view<[%stage_rows]x[%tokens]xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %k_blocks_i = index.cast %k_blocks : index to i32
  %bpr_i = scalar.muli %k_blocks_i, %c110i : i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc0, %acc1, %acc2, %acc3 = scf.for %kk = [%c0 to %ktot step %c16](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32
    %c_i = scalar.andi %lane_i, %c15i : i32
    %i_i = scalar.addi %kbase, %c_i : i32
    %blk_off0 = scalar.muli %kblk, %c110i : i32
    %group = scalar.shrui %i_i, %c5i : i32
    %half = scalar.shrui %group, %c2i : i32
    %sp = scalar.andi %group, %c3i : i32
    %h16b = scalar.andi %i_i, %c16i : i32
    %h16 = scalar.shrui %h16b, %c4i : i32
    %jj = scalar.andi %i_i, %c15i : i32
    %lane_of = scalar.addi %h16b, %jj : i32
    %half32 = scalar.shli %half, %c5i : i32
    %low_shift = scalar.shli %sp, %c1i : i32
    %half4 = scalar.shli %half, %c2i : i32
    %high_shift = scalar.addi %half4, %sp : i32
    %si0 = scalar.muli %half, %c8i : i32
    %sp2 = scalar.shli %sp, %c1i : i32
    %si1 = scalar.addi %si0, %sp2 : i32
    %si_v = scalar.addi %si1, %h16 : i32
    %si_lt8 = scalar.cmpi slt, %si_v, %c8i : i32
    %si_lo3 = scalar.andi %si_v, %c7i : i32
    %si_mod4 = scalar.andi %si_v, %c3i : i32
    %si_div4 = scalar.shrui %si_v, %c2i : i32
    %hi_shift = scalar.shli %si_div4, %c1i : i32
    %c_ix = index.cast %c_i : i32 to index
    %c_idx = index.max %c_ix, %c0 : index
    %j_sink = scf.for %j = [%c0 to %c8 step %c1](%mk = %c0 : index) -> (index) unroll(%c2) schedule(interleaved) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %e_i = scalar.addi %lane_i, %j32 : i32
      %r_i = scalar.shrui %e_i, %c4i : i32
      %row_i = scalar.addi %m_origin_i, %r_i : i32
      %row_off = scalar.muli %row_i, %bpr_i : i32
      %blk_off = scalar.addi %row_off, %blk_off0 : i32
      %qs0 = scalar.addi %blk_off, %c32i : i32
      %qs1 = scalar.addi %qs0, %half32 : i32
      %qs_i = scalar.addi %qs1, %lane_of : i32
      %qs_ix = index.cast %qs_i : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %w_last : index
      %qsb8 = view.load %w_view[%qs_idx] : view<[%w_bytes]xi8> -> i8
      %qsb = scalar.extui %qsb8 : i8 to i32
      %low0 = scalar.shrui %qsb, %low_shift : i32
      %low = scalar.andi %low0, %c3i : i32
      %hm_i = scalar.addi %blk_off, %lane_of : i32
      %hm_ix = index.cast %hm_i : i32 to index
      %hm_lo = index.max %hm_ix, %c0 : index
      %hm_idx = index.min %hm_lo, %w_last : index
      %hmb8 = view.load %w_view[%hm_idx] : view<[%w_bytes]xi8> -> i8
      %hmb = scalar.extui %hmb8 : i8 to i32
      %bit0 = scalar.shrui %hmb, %high_shift : i32
      %bit = scalar.andi %bit0, %c1i : i32
      %bit4 = scalar.shli %bit, %c2i : i32
      %lowbit = scalar.ori %low, %bit4 : i32
      %quant = scalar.subi %lowbit, %c4i : i32
      %quant_f = scalar.sitofp %quant : i32 to f32
      %sc0 = scalar.addi %blk_off, %c96i : i32
      %sc1 = scalar.addi %sc0, %si_lo3 : i32
      %sc_ix = index.cast %sc1 : i32 to index
      %sc_lo_ix = index.max %sc_ix, %c0 : index
      %sc_idx = index.min %sc_lo_ix, %w_last : index
      %scb8 = view.load %w_view[%sc_idx] : view<[%w_bytes]xi8> -> i8
      %scb = scalar.extui %scb8 : i8 to i32
      %scb_lo = scalar.andi %scb, %c15i : i32
      %scb_hi = scalar.shrui %scb, %c4i : i32
      %low4 = scf.if %si_lt8 -> (i32) {
        scf.yield %scb_lo : i32
      } else {
        scf.yield %scb_hi : i32
      }
      %hi_off8 = scalar.addi %sc0, %c8i : i32
      %hi1 = scalar.addi %hi_off8, %si_mod4 : i32
      %hi_ix = index.cast %hi1 : i32 to index
      %hi_lo = index.max %hi_ix, %c0 : index
      %hi_idx = index.min %hi_lo, %w_last : index
      %hib8 = view.load %w_view[%hi_idx] : view<[%w_bytes]xi8> -> i8
      %hib = scalar.extui %hib8 : i8 to i32
      %high0 = scalar.shrui %hib, %hi_shift : i32
      %high2 = scalar.andi %high0, %c3i : i32
      %high4 = scalar.shli %high2, %c4i : i32
      %scale6 = scalar.ori %low4, %high4 : i32
      %scale_biased = scalar.subi %scale6, %c32i : i32
      %scale_f = scalar.sitofp %scale_biased : i32 to f32
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_i = scalar.addi %blk_half0, %c54i : i32
      %d_ix = index.cast %d_i : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dsc = scalar.mulf %d, %scale_f : f32
      %value = scalar.mulf %dsc, %quant_f : f32
      %h = scalar.fptrunc %value : f32 to f16
      %row_local = index.cast %r_i : i32 to index
      view.store %h, %wstage_lds_view[%row_local, %c_idx] : f16, view<16x16xf16>
      scf.yield %mk : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhs = vector.fragment.load<lhs> %wstage_lds_view[%c0, %c0] shape [%m, %k] : view<16x16xf16> -> vector<16xf16>
    %t16 = index.add %token_base, %c16 : index
    %t32 = index.add %token_base, %c32 : index
    %t48 = index.add %token_base, %c48 : index
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %token_base] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %t16] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %t32] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %t48] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %n0 = vector.mma %lhs, %rhs0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n1 = vector.mma %lhs, %rhs1, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n2 = vector.mma %lhs, %rhs2, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n3 = vector.mma %lhs, %rhs3, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %n0, %n1, %n2, %n3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %o16 = index.add %token_base, %c16 : index
  %o32 = index.add %token_base, %c32 : index
  %o48 = index.add %token_base, %c48 : index
  vector.fragment.store<result> %acc0, %ostage_view[%m_origin, %token_base] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc1, %ostage_view[%m_origin, %o16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc2, %ostage_view[%m_origin, %o32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc3, %ostage_view[%m_origin, %o48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %tok_g = index.add %token_base, %tok : index
    %val = view.load %ostage_view[%gr2, %tok_g] : view<[%stage_rows]x[%tokens]xf32> -> f32
    %tok_off = index.mul %tok_g, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    %g = view.load %gate_view[%gflat] : view<[%out_total]xf32> -> f32
    %negg = scalar.mulf %g, %negone : f32
    %e = scalar.expf<afn> %negg : f32
    %den = scalar.addf %one, %e : f32
    %inv = scalar.divf %one, %den : f32
    %sig = scalar.mulf %g, %inv : f32
    %act = scalar.mulf %sig, %val : f32
    %h = scalar.fptrunc %act : f32 to f16
    view.store %h, %out_view[%gflat] : f16, view<[%out_total]xf16>
    scf.yield %mk2 : index
  }
  kernel.return
}

// Requires --config=yah_ffn_gemm_q3k_swiglu.m_tiles=1.
check.case public @yah_ffn_gemm_q3k_swiglu_case {
  %weight = check.file.read.npy path("fixtures/q3k_gemm/input_q3k_gemm.npy") : tensor<35200xi8>
  %input = check.generate.fill value(1024.0) : tensor<64x5120xf16>
  %gate = check.generate.fill value(1.0) : tensor<1024xf32>
  %output = check.generate.fill value(0.0) : tensor<1024xf16>
  %expected = check.file.read.npy path("fixtures/q3k_gemm/expected_swiglu.npy") : tensor<1024xf16>
  %wstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1024xf32>
  kernel.launch @yah_ffn_gemm_q3k_swiglu(%weight, %input, %gate, %wstage, %ostage, %output) : (tensor<35200xi8>, tensor<64x5120xf16>, tensor<1024xf32>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf16>)
  check.expect.close actual(%output) expected(%expected) atol(8.0) rtol(0.0) nan(same) : tensor<1024xf16>
  check.return
}

check.benchmark<@yah_ffn_gemm_q3k_swiglu_case> @yah_ffn_gemm_q3k_swiglu_bench

// Requires --config=yah_ffn_gemm_q3k_swiglu.m_tiles=1088. An all-zero Q3_K weight
// decodes to zero (d = 0), so every output must be exactly 0.
check.case public @yah_ffn_gemm_q3k_swiglu_full_case {
  %weight = check.generate.fill value(0) : tensor<38297600xi8>
  %input = check.generate.fill value(1024.0) : tensor<64x5120xf16>
  %gate = check.generate.fill value(1.0) : tensor<1114112xf32>
  %output = check.generate.fill value(0.0) : tensor<1114112xf16>
  %expected = check.generate.fill value(0.0) : tensor<1114112xf16>
  %wstage = check.generate.fill value(0.0) : tensor<89128960xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1114112xf32>
  kernel.launch @yah_ffn_gemm_q3k_swiglu(%weight, %input, %gate, %wstage, %ostage, %output) : (tensor<38297600xi8>, tensor<64x5120xf16>, tensor<1114112xf32>, tensor<89128960xf16>, tensor<1114112xf32>, tensor<1114112xf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1114112xf16>
  check.return
}

check.benchmark<@yah_ffn_gemm_q3k_swiglu_full_case> @yah_ffn_gemm_q3k_swiglu_full_bench