      %sc6_g = scalar.ori %sc_l_g, %sc_hi4_g : i32
      %sc_g = scalar.subi %sc6_g, %c32i_g : i32
      %sc_f_g = scalar.sitofp %sc_g : i32 to f32
      %blk_half_g = scalar.shrui %blk_off_g, %c1i_g : i32
      %d_ix_g = index.cast %blk_half_g : i32 to index
      %d_lo2_g = index.max %d_ix_g, %c0 : index
      %d_idx_g = index.min %d_lo2_g, %gw_half_last : index
