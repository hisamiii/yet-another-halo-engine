      %l_u = scalar.addi %l2_u, %q_u : i32
      %g8_u = scalar.shli %group_u, %c3i_u : i32
      %qso_u = scalar.addi %blk_off_u, %c2i_u : i32
      %g8a_u = scalar.addi %qso_u, %g8_u : i32
      %l2x_u = scalar.shli %l_u, %c1i_u : i32
      %lw_u = scalar.addi %l2x_u, %which_u : i32
      %qlo_i_u = scalar.addi %g8a_u, %lw_u : i32
      %qlo_ix_u = index.cast %qlo_i_u : i32 to index
      %qlo_lo_u = index.max %qlo_ix_u, %c0 : index
      %qlo_idx_u = index.min %qlo_lo_u, %uw_last : index
