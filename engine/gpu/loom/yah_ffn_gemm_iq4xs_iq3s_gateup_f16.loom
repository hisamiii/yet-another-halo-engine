      %c_i_g = scalar.andi %e_i_g, %c15i_g : i32
      %i_i_g = scalar.addi %kbase, %c_i_g : i32
      %group_g = scalar.shrui %i_i_g, %c5i_g : i32
      %within_g = scalar.andi %i_i_g, %c31i_g : i32
      %l_i_g = scalar.andi %within_g, %c15i_g : i32
      %high_g = scalar.shrui %within_g, %c4i_g : i32
      %row_i_g = scalar.addi %m_origin_i, %r_i_g : i32
      %row_off_g = scalar.muli %row_i_g, %c2880i_g : i32
      %blk_off0_g = scalar.muli %kblk_g, %c144i_g : i32
      %blk_off_g = scalar.addi %row_off_g, %blk_off0_g : i32
      %g16_g = scalar.shli %group_g, %c4i_g : i32
      %qs0_g = scalar.addi %blk_off_g, %c8i_g : i32
      %qs1_g = scalar.addi %qs0_g, %g16_g : i32
      %qs2_g = scalar.addi %qs1_g, %l_i_g : i32
      %qs_ix_g = index.cast %qs2_g : i32 to index
      %qs_lo_g = index.max %qs_ix_g, %c0 : index
      %qs_idx_g = index.min %qs_lo_g, %gw_last : index
      %qb8_g = view.load %gw_view[%qs_idx_g] : view<[%gw_bytes]xi8> -> i8
      %qb_g = scalar.extui %qb8_g : i8 to i32
      %nib_lo_g = scalar.andi %qb_g, %c15i_g : i32
      %nib_hi_g = scalar.shrui %qb_g, %c4i_g : i32
      %is_hi_g = scalar.cmpi eq, %high_g, %c1i_g : i32
      %nib_g = scf.if %is_hi_g -> (i32) {
        scf.yield %nib_hi_g : i32
      } else {
        scf.yield %nib_lo_g : i32
      }
      %nib0_g = scalar.andi %nib_g, %c1i_g : i32
      %t0_g = scalar.cmpi eq, %nib0_g, %c1i_g : i32
      %nib1s_g = scalar.shrui %nib_g, %c1i_g : i32
      %nib1_g = scalar.andi %nib1s_g, %c1i_g : i32
      %t1_g = scalar.cmpi eq, %nib1_g, %c1i_g : i32
      %nib2s_g = scalar.shrui %nib_g, %c2i_g : i32
      %nib2_g = scalar.andi %nib2s_g, %c1i_g : i32
      %t2_g = scalar.cmpi eq, %nib2_g, %c1i_g : i32
      %nib3s_g = scalar.shrui %nib_g, %c3i_g : i32
      %nib3_g = scalar.andi %nib3s_g, %c1i_g : i32
      %t3_g = scalar.cmpi eq, %nib3_g, %c1i_g : i32
      %code_g = scf.if %t3_g -> (f32) {
