      %sh0_lo_g = index.max %sh0_ix_g, %c0 : index
      %sh0_idx_g = index.min %sh0_lo_g, %gw_last : index
      %sh1_ix_g = index.cast %sh1_g : i32 to index
      %sh1_lo_g = index.max %sh1_ix_g, %c0 : index
      %sh1_idx_g = index.min %sh1_lo_g, %gw_last : index
      %shb0_g = view.load %gw_view[%sh0_idx_g] : view<[%gw_bytes]xi8> -> i8
      %shb1_g = view.load %gw_view[%sh1_idx_g] : view<[%gw_bytes]xi8> -> i8
      %shv0_g = scalar.extui %shb0_g : i8 to i32
      %shv1_g = scalar.extui %shb1_g : i8 to i32
      %shv1s_g = scalar.shli %shv1_g, %c8i_g : i32
