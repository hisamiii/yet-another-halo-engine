check.case public @yah_ffn_gemm_iq4xs_iq3s_gateup_case {
  %input = check.generate.fill value(0.0625) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1024xf16>
  %expected = check.file.read.npy path("fixtures/mixed_gateup/iq4xs_iq3s.npy") : tensor<1024xf16>
  %gwstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %uwstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ogate = check.generate.fill value(0.0) : tensor<1024xf32>
  %oup = check.generate.fill value(0.0) : tensor<1024xf32>
  %gate_weight = check.file.read.npy path("fixtures/iq4xs_gemm/input_iq4xs_gemm.npy") : tensor<43520xi8>
  %up_weight = check.file.read.npy path("fixtures/iq3s_gemm/input_iq3s_gemm.npy") : tensor<35200xi8>
  %up_grid = check.file.read.npy path("fixtures/iq3s_gemm/grid.npy") : tensor<512xi32>
  kernel.launch @yah_ffn_gemm_iq4xs_iq3s_gateup(%gate_weight, %up_weight, %up_grid, %input, %gwstage, %uwstage, %ogate, %oup, %output) : (tensor<43520xi8>, tensor<35200xi8>, tensor<512xi32>, tensor<64x5120xf16>, tensor<81920xf16>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf32>, tensor<1024xf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.1) rtol(0.0) nan(same) : tensor<1024xf16>
  check.return
}

