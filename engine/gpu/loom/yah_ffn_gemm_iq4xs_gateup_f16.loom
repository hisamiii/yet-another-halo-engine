// YAH FFN GEMM with in-kernel IQ4_XS decode and the paired gate/up SwiGLU
// epilogue, Loom port of HalfPrefillGemmKernel<..., kIQ4_XS, kGateUp>.
//
// HIP source: prefill_fp16.hip. Two IQ4_XS GEMMs share one activation tile and
// one output, each with its own decoder, accumulator group and staging buffer:
//
//   gate_acc[row][token] = sum_k iq4xs_decode(gate_w, row, k) * f16(A[token][k])
//   up_acc[row][token]   = sum_k iq4xs_decode(up_w,   row, k) * f16(A[token][k])
//   out[token*m + row]   = round_f16(silu(gate_acc) * up_acc)
//
// This is the same-format paired arm (TryLaunchBatchedDualQuantGEMMSwiGLUFp16),
// the dominant gate/up combination in the shard: IQ4_XS owns 35 gate and 34 up
// blocks of the 65 FFN layers. Generated from yah_ffn_gemm_iq4xs_gateup_f16.loom by
// replacing both decode bodies with the verified yah_ffn_gemm_iq4xs_f32 decode,
// so the paired structure, the combine epilogue and the case shape are shared.
//
// Measured: 24.17 ms at m_tiles=1088 (production 17408 rows). 1.470 ms at
// m_tiles=1. Both decoders and the combine are untuned; the same deferred levers
// as the other format ports apply.
//
// Correctness case: both weights are the packed IQ4_XS fixture and the activation
// is 2^-3, so the accumulators sit near -1.7 and silu is non-trivial (an absent
// or mis-scaled silu changes the output by ~an order of magnitude). The expected
// is round_f16(silu(acc) * acc). Both decoder copies run independently, so a bug
// in either the gate or the up decode changes the result. The production-size case
// uses all-zero weights, so every output is zero.
//
// Required config (correctness): --config=yah_ffn_gemm_iq4xs_gateup.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_iq4xs_gateup.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_iq4xs_gateup.m_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_iq4xs_gateup() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_iq4xs_gateup.m_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%gate_weight: buffer, %up_weight: buffer, %input: buffer, %gwstage: buffer, %uwstage: buffer, %ogate: buffer, %oup: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c5120 = index.constant 5120 : index
  %c2880 = index.constant 2880 : index
  %c21760 = index.constant 21760 : index
  %c43520 = index.constant 43520 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c255i = scalar.constant 255 : i32
%kval0 = scalar.constant -127.0 : f32
%kval1 = scalar.constant -104.0 : f32
%kval2 = scalar.constant -83.0 : f32
%kval3 = scalar.constant -65.0 : f32
%kval4 = scalar.constant -49.0 : f32
%kval5 = scalar.constant -35.0 : f32
%kval6 = scalar.constant -22.0 : f32
%kval7 = scalar.constant -10.0 : f32
%kval8 = scalar.constant 1.0 : f32
%kval9 = scalar.constant 13.0 : f32
%kval10 = scalar.constant 25.0 : f32
%kval11 = scalar.constant 38.0 : f32
%kval12 = scalar.constant 53.0 : f32
%kval13 = scalar.constant 69.0 : f32
%kval14 = scalar.constant 89.0 : f32
%kval15 = scalar.constant 113.0 : f32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %c144i = scalar.constant 136 : i32
  %c2880i = scalar.constant 2720 : i32
  %m_tiles = config.get @yah_ffn_gemm_iq4xs_gateup.m_tiles : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %w_bytes = index.mul %m_tiles, %c43520 : index
  %w_halfs = index.mul %m_tiles, %c21760 : index
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %out_total = index.mul %m_rows, %c64 : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [1, 5120] : encoding<layout>
  %gate_weight_na, %up_weight_na, %input_na, %gwstage_na, %uwstage_na, %ogate_na, %oup_na, %output_na = buffer.assume.noalias %gate_weight, %up_weight, %input, %gwstage, %uwstage, %ogate, %oup, %output : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %gw_view = buffer.view %gate_weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %gw_f16_view = buffer.view %gate_weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %uw_view = buffer.view %up_weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %uw_f16_view = buffer.view %up_weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<5120x64xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf16>
  %gwstage_view = buffer.view %gwstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %uwstage_view = buffer.view %uwstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %ogate_view = buffer.view %ogate_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %oup_view = buffer.view %oup_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %g0, %g1, %g2, %g3, %u0, %u1, %u2, %u3 = scf.for %kk = [%c0 to %c5120 step %c16](%ag0 = %init : vector<8xf32>, %ag1 = %init : vector<8xf32>, %ag2 = %init : vector<8xf32>, %ag3 = %init : vector<8xf32>, %au0 = %init : vector<8xf32>, %au1 = %init : vector<8xf32>, %au2 = %init : vector<8xf32>, %au3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32

    %j_sink_g = scf.for %j_g = [%c0 to %c8 step %c1](%mk_g = %c0 : index) -> (index) {
      %j_i_g = index.cast %j_g : index to i32
      %j32_g = scalar.shli %j_i_g, %c5i : i32
      %e_i_g = scalar.addi %lane_i, %j32_g : i32
      %r_i_g = scalar.shrui %e_i_g, %c4i : i32
      %c_i_g = scalar.andi %e_i_g, %c15i : i32
      %i_i_g = scalar.addi %kbase, %c_i_g : i32
      %group_g = scalar.shrui %i_i_g, %c5i : i32
      %within_g = scalar.andi %i_i_g, %c31i : i32
      %l_i_g = scalar.andi %within_g, %c15i : i32
      %high_g = scalar.shrui %within_g, %c4i : i32
      %row_i_g = scalar.addi %m_origin_i, %r_i_g : i32
      %row_off_g = scalar.muli %row_i_g, %c2880i : i32
      %blk_off0_g = scalar.muli %kblk, %c144i : i32
      %blk_off_g = scalar.addi %row_off_g, %blk_off0_g : i32
      %g16_g = scalar.shli %group_g, %c4i : i32
      %qs0_g = scalar.addi %blk_off_g, %c8i : i32
      %qs1_g = scalar.addi %qs0_g, %g16_g : i32
      %qs2_g = scalar.addi %qs1_g, %l_i_g : i32
      %qs_ix_g = index.cast %qs2_g : i32 to index
      %qs_lo_g = index.max %qs_ix_g, %c0 : index
      %qs_idx_g = index.min %qs_lo_g, %w_last : index
      %qb8_g = view.load %gw_view[%qs_idx_g] : view<[%w_bytes]xi8> -> i8
      %qb_g = scalar.extui %qb8_g : i8 to i32
      %nib_lo_g = scalar.andi %qb_g, %c15i : i32
      %nib_hi_g = scalar.shrui %qb_g, %c4i : i32
      %is_hi_g = scalar.cmpi eq, %high_g, %c1i : i32
      %nib_g = scf.if %is_hi_g -> (i32) {
        scf.yield %nib_hi_g : i32
      } else {
        scf.yield %nib_lo_g : i32
      }
      %nib0_g = scalar.andi %nib_g, %c1i : i32
      %t0_g = scalar.cmpi eq, %nib0_g, %c1i : i32
      %nib1s_g = scalar.shrui %nib_g, %c1i : i32
      %nib1_g = scalar.andi %nib1s_g, %c1i : i32
      %t1_g = scalar.cmpi eq, %nib1_g, %c1i : i32
      %nib2s_g = scalar.shrui %nib_g, %c2i : i32
      %nib2_g = scalar.andi %nib2s_g, %c1i : i32
      %t2_g = scalar.cmpi eq, %nib2_g, %c1i : i32
      %nib3s_g = scalar.shrui %nib_g, %c3i : i32
      %nib3_g = scalar.andi %nib3s_g, %c1i : i32
      %t3_g = scalar.cmpi eq, %nib3_g, %c1i : i32
      %code_g = scf.if %t3_g -> (f32) {
        %cb8_8_g = scf.if %t2_g -> (f32) {
          %cb12_4_g = scf.if %t1_g -> (f32) {
            %cb14_2_g = scf.if %t0_g -> (f32) {
              scf.yield %kval15 : f32
            } else {
              scf.yield %kval14 : f32
            }
            scf.yield %cb14_2_g : f32
          } else {
            %cb12_2_g = scf.if %t0_g -> (f32) {
              scf.yield %kval13 : f32
            } else {
              scf.yield %kval12 : f32
            }
            scf.yield %cb12_2_g : f32
          }
          scf.yield %cb12_4_g : f32
        } else {
          %cb8_4_g = scf.if %t1_g -> (f32) {
            %cb10_2_g = scf.if %t0_g -> (f32) {
              scf.yield %kval11 : f32
            } else {
              scf.yield %kval10 : f32
            }
            scf.yield %cb10_2_g : f32
          } else {
            %cb8_2_g = scf.if %t0_g -> (f32) {
              scf.yield %kval9 : f32
            } else {
              scf.yield %kval8 : f32
            }
            scf.yield %cb8_2_g : f32
          }
          scf.yield %cb8_4_g : f32
        }
        scf.yield %cb8_8_g : f32
      } else {
        %cb0_8_g = scf.if %t2_g -> (f32) {
          %cb4_4_g = scf.if %t1_g -> (f32) {
            %cb6_2_g = scf.if %t0_g -> (f32) {
              scf.yield %kval7 : f32
            } else {
              scf.yield %kval6 : f32
            }
            scf.yield %cb6_2_g : f32
          } else {
            %cb4_2_g = scf.if %t0_g -> (f32) {
              scf.yield %kval5 : f32
            } else {
              scf.yield %kval4 : f32
            }
            scf.yield %cb4_2_g : f32
          }
          scf.yield %cb4_4_g : f32
        } else {
          %cb0_4_g = scf.if %t1_g -> (f32) {
            %cb2_2_g = scf.if %t0_g -> (f32) {
              scf.yield %kval3 : f32
            } else {
              scf.yield %kval2 : f32
            }
            scf.yield %cb2_2_g : f32
          } else {
            %cb0_2_g = scf.if %t0_g -> (f32) {
              scf.yield %kval1 : f32
            } else {
              scf.yield %kval0 : f32
            }
            scf.yield %cb0_2_g : f32
          }
          scf.yield %cb0_4_g : f32
        }
        scf.yield %cb0_8_g : f32
      }
      %gpar_g = scalar.andi %group_g, %c1i : i32
      %sh4_g = scalar.shli %gpar_g, %c2i : i32
      %gh_g = scalar.shrui %group_g, %c1i : i32
      %sl0_g = scalar.addi %blk_off_g, %c4i : i32
      %sl1_g = scalar.addi %sl0_g, %gh_g : i32
      %sl_ix_g = index.cast %sl1_g : i32 to index
      %sl_lo2_g = index.max %sl_ix_g, %c0 : index
      %sl_idx_g = index.min %sl_lo2_g, %w_last : index
      %sl8_g = view.load %gw_view[%sl_idx_g] : view<[%w_bytes]xi8> -> i8
      %slb_g = scalar.extui %sl8_g : i8 to i32
      %sc_sh_g = scalar.shrui %slb_g, %sh4_g : i32
      %sc_l_g = scalar.andi %sc_sh_g, %c15i : i32
      %sh0_g = scalar.addi %blk_off_g, %c2i : i32
      %sh1_g = scalar.addi %blk_off_g, %c3i : i32
      %sh0_ix_g = index.cast %sh0_g : i32 to index
      %sh0_lo_g = index.max %sh0_ix_g, %c0 : index
      %sh0_idx_g = index.min %sh0_lo_g, %w_last : index
      %sh1_ix_g = index.cast %sh1_g : i32 to index
      %sh1_lo_g = index.max %sh1_ix_g, %c0 : index
      %sh1_idx_g = index.min %sh1_lo_g, %w_last : index
      %shb0_g = view.load %gw_view[%sh0_idx_g] : view<[%w_bytes]xi8> -> i8
      %shb1_g = view.load %gw_view[%sh1_idx_g] : view<[%w_bytes]xi8> -> i8
      %shv0_g = scalar.extui %shb0_g : i8 to i32
      %shv1_g = scalar.extui %shb1_g : i8 to i32
      %shv1s_g = scalar.shli %shv1_g, %c8i : i32
      %shv_g = scalar.ori %shv0_g, %shv1s_g : i32
      %sh2_g = scalar.shli %group_g, %c1i : i32
      %sc_hi_all_g = scalar.shrui %shv_g, %sh2_g : i32
      %sc_hi_g = scalar.andi %sc_hi_all_g, %c3i : i32
      %sc_hi4_g = scalar.shli %sc_hi_g, %c4i : i32
      %sc6_g = scalar.ori %sc_l_g, %sc_hi4_g : i32
      %sc_g = scalar.subi %sc6_g, %c32i : i32
      %sc_f_g = scalar.sitofp %sc_g : i32 to f32
      %blk_half_g = scalar.shrui %blk_off_g, %c1i : i32
      %d_ix_g = index.cast %blk_half_g : i32 to index
      %d_lo2_g = index.max %d_ix_g, %c0 : index
      %d_idx_g = index.min %d_lo2_g, %w_half_last : index
      %d_half_v_g = view.load %gw_f16_view[%d_idx_g] : view<[%w_halfs]xf16> -> f16
      %d_g = scalar.extf %d_half_v_g : f16 to f32
      %dsc_g = scalar.mulf %d_g, %sc_f_g : f32
      %value_g = scalar.mulf %dsc_g, %code_g : f32
      %h_g = scalar.fptrunc %value_g : f32 to f16
      %c_ix_g = index.cast %c_i_g : i32 to index
      %c_idx_g = index.max %c_ix_g, %c0 : index
      %kx_g = index.add %kk, %c_idx_g : index
      %row_ix_g = index.cast %row_i_g : i32 to index
      %row_lo_g = index.max %row_ix_g, %c0 : index
      %row_g = index.min %row_lo_g, %stage_last : index
      view.store %h_g, %gwstage_view[%row_g, %kx_g] : f16, view<[%stage_rows]x5120xf16>
      scf.yield %mk_g : index
    }
    %j_sink_u = scf.for %j_u = [%c0 to %c8 step %c1](%mk_u = %c0 : index) -> (index) {
      %j_i_u = index.cast %j_u : index to i32
      %j32_u = scalar.shli %j_i_u, %c5i : i32
      %e_i_u = scalar.addi %lane_i, %j32_u : i32
      %r_i_u = scalar.shrui %e_i_u, %c4i : i32
      %c_i_u = scalar.andi %e_i_u, %c15i : i32
      %i_i_u = scalar.addi %kbase, %c_i_u : i32
      %group_u = scalar.shrui %i_i_u, %c5i : i32
      %within_u = scalar.andi %i_i_u, %c31i : i32
      %l_i_u = scalar.andi %within_u, %c15i : i32
      %high_u = scalar.shrui %within_u, %c4i : i32
      %row_i_u = scalar.addi %m_origin_i, %r_i_u : i32
      %row_off_u = scalar.muli %row_i_u, %c2880i : i32
      %blk_off0_u = scalar.muli %kblk, %c144i : i32
      %blk_off_u = scalar.addi %row_off_u, %blk_off0_u : i32
      %g16_u = scalar.shli %group_u, %c4i : i32
      %qs0_u = scalar.addi %blk_off_u, %c8i : i32
      %qs1_u = scalar.addi %qs0_u, %g16_u : i32
      %qs2_u = scalar.addi %qs1_u, %l_i_u : i32
      %qs_ix_u = index.cast %qs2_u : i32 to index
      %qs_lo_u = index.max %qs_ix_u, %c0 : index
      %qs_idx_u = index.min %qs_lo_u, %w_last : index
      %qb8_u = view.load %uw_view[%qs_idx_u] : view<[%w_bytes]xi8> -> i8
      %qb_u = scalar.extui %qb8_u : i8 to i32
      %nib_lo_u = scalar.andi %qb_u, %c15i : i32
      %nib_hi_u = scalar.shrui %qb_u, %c4i : i32
      %is_hi_u = scalar.cmpi eq, %high_u, %c1i : i32
      %nib_u = scf.if %is_hi_u -> (i32) {
        scf.yield %nib_hi_u : i32
      } else {
        scf.yield %nib_lo_u : i32
      }
      %nib0_u = scalar.andi %nib_u, %c1i : i32
      %t0_u = scalar.cmpi eq, %nib0_u, %c1i : i32
      %nib1s_u = scalar.shrui %nib_u, %c1i : i32
      %nib1_u = scalar.andi %nib1s_u, %c1i : i32
      %t1_u = scalar.cmpi eq, %nib1_u, %c1i : i32
      %nib2s_u = scalar.shrui %nib_u, %c2i : i32
      %nib2_u = scalar.andi %nib2s_u, %c1i : i32
      %t2_u = scalar.cmpi eq, %nib2_u, %c1i : i32
      %nib3s_u = scalar.shrui %nib_u, %c3i : i32
      %nib3_u = scalar.andi %nib3s_u, %c1i : i32
      %t3_u = scalar.cmpi eq, %nib3_u, %c1i : i32
      %code_u = scf.if %t3_u -> (f32) {
        %cb8_8_u = scf.if %t2_u -> (f32) {
          %cb12_4_u = scf.if %t1_u -> (f32) {
            %cb14_2_u = scf.if %t0_u -> (f32) {
              scf.yield %kval15 : f32
            } else {
              scf.yield %kval14 : f32
            }
            scf.yield %cb14_2_u : f32
          } else {
            %cb12_2_u = scf.if %t0_u -> (f32) {
              scf.yield %kval13 : f32
            } else {
              scf.yield %kval12 : f32
            }
            scf.yield %cb12_2_u : f32
          }
          scf.yield %cb12_4_u : f32
        } else {
          %cb8_4_u = scf.if %t1_u -> (f32) {
            %cb10_2_u = scf.if %t0_u -> (f32) {
              scf.yield %kval11 : f32
            } else {
              scf.yield %kval10 : f32
            }
            scf.yield %cb10_2_u : f32
          } else {
            %cb8_2_u = scf.if %t0_u -> (f32) {
              scf.yield %kval9 : f32
            } else {
              scf.yield %kval8 : f32
            }
            scf.yield %cb8_2_u : f32
          }
          scf.yield %cb8_4_u : f32
        }
        scf.yield %cb8_8_u : f32
      } else {
        %cb0_8_u = scf.if %t2_u -> (f32) {
          %cb4_4_u = scf.if %t1_u -> (f32) {
            %cb6_2_u = scf.if %t0_u -> (f32) {
              scf.yield %kval7 : f32
            } else {
              scf.yield %kval6 : f32
            }
            scf.yield %cb6_2_u : f32
          } else {
            %cb4_2_u = scf.if %t0_u -> (f32) {
              scf.yield %kval5 : f32
            } else {
              scf.yield %kval4 : f32
            }
            scf.yield %cb4_2_u : f32
          }
          scf.yield %cb4_4_u : f32
        } else {
          %cb0_4_u = scf.if %t1_u -> (f32) {
            %cb2_2_u = scf.if %t0_u -> (f32) {
              scf.yield %kval3 : f32
            } else {
              scf.yield %kval2 : f32
            }
            scf.yield %cb2_2_u : f32
          } else {
            %cb0_2_u = scf.if %t0_u -> (f32) {
              scf.yield %kval1 : f32
            } else {
              scf.yield %kval0 : f32
            }
            scf.yield %cb0_2_u : f32
          }
          scf.yield %cb0_4_u : f32
        }
        scf.yield %cb0_8_u : f32
      }
      %gpar_u = scalar.andi %group_u, %c1i : i32
      %sh4_u = scalar.shli %gpar_u, %c2i : i32
      %gh_u = scalar.shrui %group_u, %c1i : i32
      %sl0_u = scalar.addi %blk_off_u, %c4i : i32
      %sl1_u = scalar.addi %sl0_u, %gh_u : i32
      %sl_ix_u = index.cast %sl1_u : i32 to index
      %sl_lo2_u = index.max %sl_ix_u, %c0 : index
      %sl_idx_u = index.min %sl_lo2_u, %w_last : index
      %sl8_u = view.load %uw_view[%sl_idx_u] : view<[%w_bytes]xi8> -> i8
      %slb_u = scalar.extui %sl8_u : i8 to i32
      %sc_sh_u = scalar.shrui %slb_u, %sh4_u : i32
      %sc_l_u = scalar.andi %sc_sh_u, %c15i : i32
      %sh0_u = scalar.addi %blk_off_u, %c2i : i32
      %sh1_u = scalar.addi %blk_off_u, %c3i : i32
      %sh0_ix_u = index.cast %sh0_u : i32 to index
      %sh0_lo_u = index.max %sh0_ix_u, %c0 : index
      %sh0_idx_u = index.min %sh0_lo_u, %w_last : index
      %sh1_ix_u = index.cast %sh1_u : i32 to index
      %sh1_lo_u = index.max %sh1_ix_u, %c0 : index
      %sh1_idx_u = index.min %sh1_lo_u, %w_last : index
      %shb0_u = view.load %uw_view[%sh0_idx_u] : view<[%w_bytes]xi8> -> i8
      %shb1_u = view.load %uw_view[%sh1_idx_u] : view<[%w_bytes]xi8> -> i8
      %shv0_u = scalar.extui %shb0_u : i8 to i32
      %shv1_u = scalar.extui %shb1_u : i8 to i32
      %shv1s_u = scalar.shli %shv1_u, %c8i : i32
      %shv_u = scalar.ori %shv0_u, %shv1s_u : i32
      %sh2_u = scalar.shli %group_u, %c1i : i32
      %sc_hi_all_u = scalar.shrui %shv_u, %sh2_u : i32
      %sc_hi_u = scalar.andi %sc_hi_all_u, %c3i : i32
      %sc_hi4_u = scalar.shli %sc_hi_u, %c4i : i32
      %sc6_u = scalar.ori %sc_l_u, %sc_hi4_u : i32
      %sc_u = scalar.subi %sc6_u, %c32i : i32
      %sc_f_u = scalar.sitofp %sc_u : i32 to f32
      %blk_half_u = scalar.shrui %blk_off_u, %c1i : i32
      %d_ix_u = index.cast %blk_half_u : i32 to index
      %d_lo2_u = index.max %d_ix_u, %c0 : index
      %d_idx_u = index.min %d_lo2_u, %w_half_last : index
      %d_half_v_u = view.load %uw_f16_view[%d_idx_u] : view<[%w_halfs]xf16> -> f16
      %d_u = scalar.extf %d_half_v_u : f16 to f32
      %dsc_u = scalar.mulf %d_u, %sc_f_u : f32
      %value_u = scalar.mulf %dsc_u, %code_u : f32
      %h_u = scalar.fptrunc %value_u : f32 to f16
      %c_ix_u = index.cast %c_i_u : i32 to index
      %c_idx_u = index.max %c_ix_u, %c0 : index
      %kx_u = index.add %kk, %c_idx_u : index
      %row_ix_u = index.cast %row_i_u : i32 to index
      %row_lo_u = index.max %row_ix_u, %c0 : index
      %row_u = index.min %row_lo_u, %stage_last : index
      view.store %h_u, %uwstage_view[%row_u, %kx_u] : f16, view<[%stage_rows]x5120xf16>
      scf.yield %mk_u : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhsg = vector.fragment.load<lhs> %gwstage_view[%m_origin, %kk] shape [%m, %k] : view<[%stage_rows]x5120xf16> -> vector<16xf16>
    %lhsu = vector.fragment.load<lhs> %uwstage_view[%m_origin, %kk] shape [%m, %k] : view<[%stage_rows]x5120xf16> -> vector<16xf16>
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %c0] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %c16] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %c32] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %c48] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %ng0 = vector.mma %lhsg, %rhs0, %ag0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng1 = vector.mma %lhsg, %rhs1, %ag1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng2 = vector.mma %lhsg, %rhs2, %ag2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng3 = vector.mma %lhsg, %rhs3, %ag3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu0 = vector.mma %lhsu, %rhs0, %au0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu1 = vector.mma %lhsu, %rhs1, %au1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu2 = vector.mma %lhsu, %rhs2, %au2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu3 = vector.mma %lhsu, %rhs3, %au3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %ng0, %ng1, %ng2, %ng3, %nu0, %nu1, %nu2, %nu3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  vector.fragment.store<result> %g0, %ogate_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %g1, %ogate_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %g2, %ogate_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %g3, %ogate_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u0, %oup_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u1, %oup_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u2, %oup_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u3, %oup_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %gv = view.load %ogate_view[%gr2, %tok] : view<[%stage_rows]x64xf32> -> f32
    %uv = view.load %oup_view[%gr2, %tok] : view<[%stage_rows]x64xf32> -> f32
    %tok_off = index.mul %tok, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    %negg = scalar.mulf %gv, %negone : f32
    %e = scalar.expf<afn> %negg : f32
    %den = scalar.addf %one, %e : f32
    %inv = scalar.divf %one, %den : f32
    %sig = scalar.mulf %gv, %inv : f32
    %act = scalar.mulf %sig, %uv : f32
    %h = scalar.fptrunc %act : f32 to f16
    view.store %h, %out_view[%gflat] : f16, view<[%out_total]xf16>
    scf.yield %mk2 : index
  }
  kernel.return
}

// Requires --config=yah_ffn_gemm_iq4xs_gateup.m_tiles=1.
check.case public @yah_ffn_gemm_iq4xs_gateup_case {
  %gate_weight = check.file.read.npy path("fixtures/iq4xs_gemm/input_iq4xs_gemm.npy") : tensor<43520xi8>
  %up_weight = check.file.read.npy path("fixtures/iq4xs_gemm/input_iq4xs_gemm.npy") : tensor<43520xi8>
  %input = check.generate.fill value(0.125) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1024xf16>
  %expected = check.file.read.npy path("fixtures/iq4xs_gemm/expected_gateup.npy") : tensor<1024xf16>
  %gwstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %uwstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ogate = check.generate.fill value(0.0) : tensor<1024xf32>
  %oup = check.generate.fill value(0.0) : tensor<1024xf32>
  kernel.launch @yah_ffn_gemm_iq4xs_gateup(%gate_weight, %up_weight, %input, %gwstage, %uwstage, %ogate, %oup, %output) : (tensor<43520xi8>, tensor<43520xi8>, tensor<64x5120xf16>, tensor<81920xf16>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf32>, tensor<1024xf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.005) rtol(0.0) nan(same) : tensor<1024xf16>
  check.return
}

