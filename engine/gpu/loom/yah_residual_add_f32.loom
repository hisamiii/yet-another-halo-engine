// YAH batched residual add, Loom port of BatchedResidualAddKernel.
//
// HIP source: prefill_residual.hip. out[i] = a[i] + b[i] over the flat element
// count, one element per work-item, 256 work-items per workgroup.
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_residual_add.total : %value: index where [range(%value, 1, 67108864)]

kernel.def target(@yah_wave32) @yah_residual_add() {
  %unit = index.constant 1 : index
  %total = config.get @yah_residual_add.total : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %total, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%a: buffer, %b: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c256 = index.constant 256 : index
  %total = config.get @yah_residual_add.total : index
  %lane = kernel.workitem.id<x> : index
  %wg = kernel.workgroup.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %idx = index.add %wg_base, %lane : index

  %a_noalias, %b_noalias, %out_noalias = buffer.assume.noalias %a, %b, %out : buffer, buffer, buffer
  %a_view = buffer.view %a_noalias[%base] : buffer -> view<[%total]xf32>
  %b_view = buffer.view %b_noalias[%base] : buffer -> view<[%total]xf32>
  %out_view = buffer.view %out_noalias[%base] : buffer -> view<[%total]xf32>

  %in_range = index.cmp ult, %idx, %total : index
  scf.if %in_range {
    %av = view.load %a_view[%idx] : view<[%total]xf32> -> f32
    %bv = view.load %b_view[%idx] : view<[%total]xf32> -> f32
    %sum = scalar.addf %av, %bv : f32
    view.store %sum, %out_view[%idx] : f32, view<[%total]xf32>
  }
  kernel.return
}

check.case public @yah_residual_add_case {
  %a = check.generate.iota offset(1.0) step(2.0) : tensor<327680xf32>
  %b = check.generate.iota offset(1000000.0) step(3.0) : tensor<327680xf32>
  %out = check.generate.fill value(-1.0) : tensor<327680xf32>
  %expected = check.generate.iota offset(1000001.0) step(5.0) : tensor<327680xf32>
  kernel.launch @yah_residual_add(%a, %b, %out) : (tensor<327680xf32>, tensor<327680xf32>, tensor<327680xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0001) rtol(0.0) nan(same) : tensor<327680xf32>
  check.return
}

check.benchmark<@yah_residual_add_case> @yah_residual_add_bench
