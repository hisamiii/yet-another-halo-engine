// Probe: physical per-lane layout of vector.fragment.load<rhs> for a 16x16 f16
// fragment on gfx11/wave32. Same store technique as probe_fragment_layout.loom.
amdgpu.target<gfx1151> @probe_wave32 {subgroup_size = 32}

kernel.def target(@probe_wave32) @probe_fragment_rhs_global() {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %k = index.constant 16 : index
  %n = index.constant 16 : index
  %lane = kernel.workitem.id<x> : index
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %in_view = buffer.view %input_noalias[%base] : buffer -> view<16x16xf16>
  %out_view = buffer.view %output_noalias[%base] : buffer -> view<32x16xf16>
  %rhs = vector.fragment.load<rhs> %in_view[%c0, %c0] shape [%k, %n] : view<16x16xf16> -> vector<16xf16>
  vector.store %rhs, %out_view[%lane, %c0] : vector<16xf16>, view<32x16xf16>
  kernel.return
}

check.case public @probe_fragment_rhs_global_case {
  %input = check.generate.iota offset(0.0) step(1.0) : tensor<16x16xf16>
  %output = check.generate.fill value(0.0) : tensor<32x16xf16>
  kernel.launch @probe_fragment_rhs_global(%input, %output) : (tensor<16x16xf16>, tensor<32x16xf16>)
  check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<32x16xf16>
  check.file.write.npy value(%output) path("probe_fragment_rhs_global.npy") mode(always) : tensor<32x16xf16>
  check.return
}

check.benchmark<@probe_fragment_rhs_global_case> @probe_fragment_rhs_global_bench
