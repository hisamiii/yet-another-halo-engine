// YAH vision patch embedding, Loom port of Patchify.
//
// HIP source: models/qwen/vision/encoder.hip. Turns an interleaved RGB image into
// flattened 16x16 patch vectors, normalized the same way the CPU reference does:
//
//   patch   = i / 1536;  element = i % 1536
//   merge   = patch / 4;
//   y = (merge / (grid_width/2))*2 + (patch % 4)/2
//   x = (merge % (grid_width/2))*2 + patch % 2
//   channel = element / 512; spatial = element % 512
//   pixel   = ((y*16 + spatial/16)*width + x*16 + spatial%16)*3 + channel
//   out[i]  = Bf16((float(pixels[pixel]) / 255 - 0.5) / 0.5)
//
// Every division in the HIP index math is by a power of two (1536 is not, but the
// lane covers `spatial` directly). This port removes them by making the loop
// variables the decomposition itself: one workgroup per patch, the lane is
// `spatial/16`, and the inner loops are `channel` and `spatial % 16`. The two
// power-of-two steps that remain -- `patch/4` and `patch%4`, and `grid_width/2` --
// are done with shifts and masks on i32 rather than `index.div`, because a
// power-of-two `index.div` lowers to `index.shrui`, which the AMDGPU register-unit
// constraint rejects.
//
// The pixel gather is the one place the footprint analysis needs help: the byte
// offset depends on a runtime image stride, so the config ranges are declared narrow
// enough that the maximum possible pixel is provable. That is a real contract of
// this port, and widening `count` past 4 or `width` past 64 would make the declared
// footprint exceed any reasonable pixel buffer.
//
// Required config: --config=yah_vision_patchify.count=4
//                  --config=yah_vision_patchify.width=32
//                  --config=yah_vision_patchify.grid_width=2
//                  --config=yah_vision_patchify.pixel_bytes=4608
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_vision_patchify.count : %value: index where [range(%value, 1, 4)]
config.decl @yah_vision_patchify.width : %value: index where [range(%value, 1, 64)]
config.decl @yah_vision_patchify.grid_width : %value: index where [range(%value, 1, 64)]
config.decl @yah_vision_patchify.pixel_bytes : %value: index where [range(%value, 4608, 1048576)]

kernel.def target(@yah_wave32) @yah_vision_patchify() {
  %unit = index.constant 1 : index
  %count = config.get @yah_vision_patchify.count : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%count, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%pixels: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c16 = index.constant 16 : index
  %c512 = index.constant 512 : index
  %c1536 = index.constant 1536 : index
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %inv255 = scalar.constant 0.00392156862745098 : f32
  %half_c = scalar.constant 0.5 : f32
  %count = config.get @yah_vision_patchify.count : index
  %width = config.get @yah_vision_patchify.width : index
  %grid_width = config.get @yah_vision_patchify.grid_width : index
  %pixel_bytes = config.get @yah_vision_patchify.pixel_bytes : index
  %out_elems = index.mul %count, %c1536 : index
  %pixels_na, %out_na = buffer.assume.noalias %pixels, %out : buffer, buffer
  %pixels_view = buffer.view %pixels_na[%base] : buffer -> view<[%pixel_bytes]xi8>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%out_elems]xbf16>
  %patch = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %patch_i = index.cast %patch : index to i32
  %p4 = scalar.andi %patch_i, %c3i : i32
  %merge_i = scalar.shrui %patch_i, %c2i : i32
  %merge = index.cast %merge_i : i32 to index
  %grid_i = index.cast %grid_width : index to i32
  %half_i = scalar.shrui %grid_i, %c1i : i32
  %half_grid = index.cast %half_i : i32 to index
  %my = index.div %merge, %half_grid : index
  %mx = index.rem %merge, %half_grid : index
  %p4_hi_i = scalar.shrui %p4, %c1i : i32
  %p4_hi = index.cast %p4_hi_i : i32 to index
  %p4_lo_i = scalar.andi %p4, %c1i : i32
  %p4_lo = index.cast %p4_lo_i : i32 to index
  %my2 = index.mul %my, %c2 : index
  %y = index.add %my2, %p4_hi : index
  %mx2 = index.mul %mx, %c2 : index
  %x = index.add %mx2, %p4_lo : index
  %y16 = index.mul %y, %c16 : index
  %x16 = index.mul %x, %c16 : index
  %patch_base = index.mul %patch, %c1536 : index
  %outer = scf.for %channel = [%c0 to %c3 step %c1](%m1 = %c0 : index) -> (index) {
    %channel512 = index.mul %channel, %c512 : index
    %channel_base = index.add %patch_base, %channel512 : index
    %inner = scf.for %col = [%c0 to %c16 step %c1](%m2 = %c0 : index) -> (index) {
      %row = index.add %y16, %lane : index
      %row_w = index.mul %row, %width : index
      %col_x = index.add %x16, %col : index
      %flat = index.add %row_w, %col_x : index
      %triple = index.mul %flat, %c3 : index
      %pixel = index.add %triple, %channel : index
      %byte = view.load %pixels_view[%pixel] : view<[%pixel_bytes]xi8> -> i8
      %unsigned = scalar.extui %byte : i8 to i32
      %as_float = scalar.sitofp %unsigned : i32 to f32
      %scaled = scalar.mulf %as_float, %inv255 : f32
      %centered = scalar.subf %scaled, %half_c : f32
      %value = scalar.divf %centered, %half_c : f32
      %narrow = scalar.fptrunc %value : f32 to bf16
      %spatial = index.add %col, %lane : index
      %elem0 = index.add %channel_base, %spatial : index
      view.store %narrow, %out_view[%elem0] : bf16, view<[%out_elems]xbf16>
      scf.yield %m2 : index
    }
    scf.yield %m1 : index
  }
  kernel.return
}

// Requires --config=yah_vision_patchify.count=4, .width=32, .grid_width=2,
// .pixel_bytes=4608.
//
// The pixel buffer is an iota byte pattern the case generates in-source, so only the
// bf16 expectation needs a fixture; it is stored as raw 16-bit patterns because
// bf16 has no numpy dtype. Four patches with 256 distinct pixel values exercise the
// patch/merge/p4 decomposition and the channel/spatial split.
check.case public @yah_vision_patchify_case {
  %pixels = check.generate.iota offset(0) step(1) : tensor<4608xi8>
  %out = check.generate.fill value(0.0) : tensor<6144xbf16>
  %expected = check.file.read.npy path("fixtures/vision_patchify/expected_bits.npy") : tensor<6144xi16>
  kernel.launch @yah_vision_patchify(%pixels, %out) : (tensor<4608xi8>, tensor<6144xbf16>)
  %actual_bits = check.tensor.view %out offset(0) : tensor<6144xbf16> -> tensor<6144xi16>
  check.expect.equal actual(%actual_bits) expected(%expected) : tensor<6144xi16>
  check.return
}

check.benchmark<@yah_vision_patchify_case> @yah_vision_patchify_bench
