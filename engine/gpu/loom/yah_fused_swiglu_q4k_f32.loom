// YAH fused quantized SwiGLU GEMV, Loom port of
// Wave32FusedQuantSwiGLUGEMVKernel_1Row for the Q4_K format (swiglu.hip).
//
// Two Q4_K GEMVs over one activation row, combined with SwiGLU:
//
//   gate_dot = sum_k q4k_decode(gate_w, m, k) * x[k]
//   up_dot   = sum_k q4k_decode(up_w,   m, k) * x[k]
//   out[m]   = silu(gate_dot) * up_dot
//
// This is the production decode FFN for a Q4_K shard
// (LaunchFusedSwiGLUGEMV -> Wave32FusedQuantSwiGLUGEMVKernel_2Rows<.., kQ4_K>);
// the 1-row and 2-row HIP arms differ only in how many rows a warp owns, so this
// port covers one row per workgroup and computes the same value. HIP calls
// QuantWarpBlockDot for each side, which is the same decoder the Q4_K GEMV port
// uses. FastFusedSwiGLUGEMVBlockKernel is the bf16/Q8 legacy fallback and is not
// this route.
//
// The decoder is duplicated with _g and _u suffixes; a decode fix has to be
// applied to both copies.
//
// Required config: --config=yah_fused_swiglu_q4k.m_rows=16
//                  --config=yah_fused_swiglu_q4k.k_blocks=20
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_fused_swiglu_q4k.m_rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_fused_swiglu_q4k.k_blocks : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_fused_swiglu_q4k() {
  %unit = index.constant 1 : index
  %m_rows = config.get @yah_fused_swiglu_q4k.m_rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_rows, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%gate_w: buffer, %up_w: buffer, %x: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c144 = index.constant 144 : index
  %c256 = index.constant 256 : index
  %c1440 = index.constant 1440 : index
  %c2880 = index.constant 2880 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %m_rows = config.get @yah_fused_swiglu_q4k.m_rows : index
  %k_blocks = config.get @yah_fused_swiglu_q4k.k_blocks : index
  %w_bytes = index.mul %m_rows, %c2880 : index
  %w_halfs = index.mul %m_rows, %c1440 : index
  %x_elems = index.mul %k_blocks, %c256 : index
  %gate_na, %up_na, %x_na, %out_na = buffer.assume.noalias %gate_w, %up_w, %x, %out : buffer, buffer, buffer, buffer
  %gw_view = buffer.view %gate_na[%base] : buffer -> view<[%w_bytes]xi8>
  %gw_f16_view = buffer.view %gate_na[%base] : buffer -> view<[%w_halfs]xf16>
  %uw_view = buffer.view %up_na[%base] : buffer -> view<[%w_bytes]xi8>
  %uw_f16_view = buffer.view %up_na[%base] : buffer -> view<[%w_halfs]xf16>
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%x_elems]xf32>
  %y_view = buffer.view %out_na[%base] : buffer -> view<[%m_rows]xf32>
  %m = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %m_i = index.cast %m : index to i32
  %lane_i = index.cast %lane : index to i32
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %x_last = index.sub %x_elems, %c1 : index
  %accg, %accu = scf.for %kblk = [%c0 to %k_blocks step %c1](%ag = %zero : f32, %au = %zero : f32) -> (f32, f32) {
    %kblk_i = index.cast %kblk : index to i32
    %row_off = scalar.muli %m_i, %c2880i : i32
    %blk_off0 = scalar.muli %kblk_i, %c144i : i32
    %blk_off = scalar.addi %row_off, %blk_off0 : i32
    %kblk256 = scalar.shli %kblk_i, %c8i : i32
    %a1g, %a1u = scf.for %j = [%c0 to %c8 step %c1](%g0 = %ag : f32, %u0 = %au : f32) -> (f32, f32) {
      %j_i_g = index.cast %j : index to i32
      %j32_g = scalar.shli %j_i_g, %c5i : i32
      %i_i_g = scalar.addi %lane_i, %j32_g : i32
      %gg_i_g = scalar.shrui %i_i_g, %c6i : i32
      %wv_i_g = scalar.andi %i_i_g, %c63i : i32
      %lane_dec_g = scalar.andi %wv_i_g, %c31i : i32
      %wv_hi_g = scalar.shrui %wv_i_g, %c5i : i32
      %is_low_g = scalar.cmpi slt, %wv_i_g, %c32i : i32
      %qs0_g = scalar.addi %blk_off, %c16i : i32
      %gg32_g = scalar.shli %gg_i_g, %c5i : i32
      %qs1_g = scalar.addi %qs0_g, %gg32_g : i32
      %qs2_g = scalar.addi %qs1_g, %lane_dec_g : i32
      %qs_ix_g = index.cast %qs2_g : i32 to index
      %qs_lo_g = index.max %qs_ix_g, %c0 : index
      %qs_idx_g = index.min %qs_lo_g, %w_last : index
      %qb8_g = view.load %gw_view[%qs_idx_g] : view<[%w_bytes]xi8> -> i8
      %qb_g = scalar.extui %qb8_g : i8 to i32
      %qb_lo_g = scalar.andi %qb_g, %c15i : i32
      %qb_hi_g = scalar.shrui %qb_g, %c4i : i32
      %quant4_g = scf.if %is_low_g -> (i32) {
        scf.yield %qb_lo_g : i32
      } else {
        scf.yield %qb_hi_g : i32
      }
      %gg2_g = scalar.shli %gg_i_g, %c1i : i32
      %sis_g = scalar.addi %gg2_g, %wv_hi_g : i32
      %sis_low_g = scalar.cmpi slt, %sis_g, %c4i : i32
      %la0_g = scalar.addi %blk_off, %c4i : i32
      %la_i_g = scalar.addi %la0_g, %sis_g : i32
      %lb_i_g = scalar.addi %la_i_g, %c4i : i32
      %lc_i_g = scalar.addi %blk_off, %sis_g : i32
      %la_ix_g = index.cast %la_i_g : i32 to index
      %la_lo_g = index.max %la_ix_g, %c0 : index
      %la_idx_g = index.min %la_lo_g, %w_last : index
      %lb_ix_g = index.cast %lb_i_g : i32 to index
      %lb_lo_g = index.max %lb_ix_g, %c0 : index
      %lb_idx_g = index.min %lb_lo_g, %w_last : index
      %lc_ix_g = index.cast %lc_i_g : i32 to index
      %lc_lo_g = index.max %lc_ix_g, %c0 : index
      %lc_idx_g = index.min %lc_lo_g, %w_last : index
      %la8_g = view.load %gw_view[%la_idx_g] : view<[%w_bytes]xi8> -> i8
      %lb8_g = view.load %gw_view[%lb_idx_g] : view<[%w_bytes]xi8> -> i8
      %lc8_g = view.load %gw_view[%lc_idx_g] : view<[%w_bytes]xi8> -> i8
      %la_g = scalar.extui %la8_g : i8 to i32
      %lb_g = scalar.extui %lb8_g : i8 to i32
      %lc_g = scalar.extui %lc8_g : i8 to i32
      %sc_g, %smin_g = scf.if %sis_low_g -> (i32, i32) {
        %s_g = scalar.andi %la_g, %c63i : i32
        %mv_g = scalar.andi %lb_g, %c63i : i32
        scf.yield %s_g, %mv_g : i32, i32
      } else {
        %lb_lo2_g = scalar.andi %lb_g, %c15i : i32
        %lc_hi_g = scalar.shrui %lc_g, %c6i : i32
        %lc_hi4_g = scalar.shli %lc_hi_g, %c4i : i32
        %s2_g = scalar.ori %lb_lo2_g, %lc_hi4_g : i32
        %lb_hi_g = scalar.shrui %lb_g, %c4i : i32
        %la_hi_g = scalar.shrui %la_g, %c6i : i32
        %la_hi4_g = scalar.shli %la_hi_g, %c4i : i32
        %m2_g = scalar.ori %lb_hi_g, %la_hi4_g : i32
        scf.yield %s2_g, %m2_g : i32, i32
      }
      %blk_half0_g = scalar.shrui %blk_off, %c1i : i32
      %d_ix_g = index.cast %blk_half0_g : i32 to index
      %d_lo_g = index.max %d_ix_g, %c0 : index
      %d_idx_g = index.min %d_lo_g, %w_half_last : index
      %dmin0_g = scalar.addi %blk_half0_g, %c1i : i32
      %dmin_ix_g = index.cast %dmin0_g : i32 to index
      %dmin_lo_g = index.max %dmin_ix_g, %c0 : index
      %dmin_idx_g = index.min %dmin_lo_g, %w_half_last : index
      %d_half_v_g = view.load %gw_f16_view[%d_idx_g] : view<[%w_halfs]xf16> -> f16
      %dmin_half_v_g = view.load %gw_f16_view[%dmin_idx_g] : view<[%w_halfs]xf16> -> f16
      %d_g = scalar.extf %d_half_v_g : f16 to f32
      %dmin_g = scalar.extf %dmin_half_v_g : f16 to f32
      %sc_f_g = scalar.sitofp %sc_g : i32 to f32
      %m_f_g = scalar.sitofp %smin_g : i32 to f32
      %q_f_g = scalar.sitofp %quant4_g : i32 to f32
      %dsc_g = scalar.mulf %d_g, %sc_f_g : f32
      %scaled_g = scalar.mulf %dsc_g, %q_f_g : f32
      %dm_g = scalar.mulf %dmin_g, %m_f_g : f32
      %value_g = scalar.subf %scaled_g, %dm_g : f32
      %j_i_u = index.cast %j : index to i32
      %j32_u = scalar.shli %j_i_u, %c5i : i32
      %i_i_u = scalar.addi %lane_i, %j32_u : i32
      %gg_i_u = scalar.shrui %i_i_u, %c6i : i32
      %wv_i_u = scalar.andi %i_i_u, %c63i : i32
      %lane_dec_u = scalar.andi %wv_i_u, %c31i : i32
      %wv_hi_u = scalar.shrui %wv_i_u, %c5i : i32
      %is_low_u = scalar.cmpi slt, %wv_i_u, %c32i : i32
      %qs0_u = scalar.addi %blk_off, %c16i : i32
      %gg32_u = scalar.shli %gg_i_u, %c5i : i32
      %qs1_u = scalar.addi %qs0_u, %gg32_u : i32
      %qs2_u = scalar.addi %qs1_u, %lane_dec_u : i32
      %qs_ix_u = index.cast %qs2_u : i32 to index
      %qs_lo_u = index.max %qs_ix_u, %c0 : index
      %qs_idx_u = index.min %qs_lo_u, %w_last : index
      %qb8_u = view.load %uw_view[%qs_idx_u] : view<[%w_bytes]xi8> -> i8
      %qb_u = scalar.extui %qb8_u : i8 to i32
      %qb_lo_u = scalar.andi %qb_u, %c15i : i32
      %qb_hi_u = scalar.shrui %qb_u, %c4i : i32
      %quant4_u = scf.if %is_low_u -> (i32) {
        scf.yield %qb_lo_u : i32
      } else {
        scf.yield %qb_hi_u : i32
      }
      %gg2_u = scalar.shli %gg_i_u, %c1i : i32
      %sis_u = scalar.addi %gg2_u, %wv_hi_u : i32
      %sis_low_u = scalar.cmpi slt, %sis_u, %c4i : i32
      %la0_u = scalar.addi %blk_off, %c4i : i32
      %la_i_u = scalar.addi %la0_u, %sis_u : i32
      %lb_i_u = scalar.addi %la_i_u, %c4i : i32
      %lc_i_u = scalar.addi %blk_off, %sis_u : i32
      %la_ix_u = index.cast %la_i_u : i32 to index
      %la_lo_u = index.max %la_ix_u, %c0 : index
      %la_idx_u = index.min %la_lo_u, %w_last : index
      %lb_ix_u = index.cast %lb_i_u : i32 to index
      %lb_lo_u = index.max %lb_ix_u, %c0 : index
      %lb_idx_u = index.min %lb_lo_u, %w_last : index
      %lc_ix_u = index.cast %lc_i_u : i32 to index
      %lc_lo_u = index.max %lc_ix_u, %c0 : index
      %lc_idx_u = index.min %lc_lo_u, %w_last : index
      %la8_u = view.load %uw_view[%la_idx_u] : view<[%w_bytes]xi8> -> i8
      %lb8_u = view.load %uw_view[%lb_idx_u] : view<[%w_bytes]xi8> -> i8
      %lc8_u = view.load %uw_view[%lc_idx_u] : view<[%w_bytes]xi8> -> i8
      %la_u = scalar.extui %la8_u : i8 to i32
      %lb_u = scalar.extui %lb8_u : i8 to i32
      %lc_u = scalar.extui %lc8_u : i8 to i32
      %sc_u, %smin_u = scf.if %sis_low_u -> (i32, i32) {
        %s_u = scalar.andi %la_u, %c63i : i32
        %mv_u = scalar.andi %lb_u, %c63i : i32
        scf.yield %s_u, %mv_u : i32, i32
      } else {
        %lb_lo2_u = scalar.andi %lb_u, %c15i : i32
        %lc_hi_u = scalar.shrui %lc_u, %c6i : i32
        %lc_hi4_u = scalar.shli %lc_hi_u, %c4i : i32
        %s2_u = scalar.ori %lb_lo2_u, %lc_hi4_u : i32
        %lb_hi_u = scalar.shrui %lb_u, %c4i : i32
        %la_hi_u = scalar.shrui %la_u, %c6i : i32
        %la_hi4_u = scalar.shli %la_hi_u, %c4i : i32
        %m2_u = scalar.ori %lb_hi_u, %la_hi4_u : i32
        scf.yield %s2_u, %m2_u : i32, i32
      }
      %blk_half0_u = scalar.shrui %blk_off, %c1i : i32
      %d_ix_u = index.cast %blk_half0_u : i32 to index
      %d_lo_u = index.max %d_ix_u, %c0 : index
      %d_idx_u = index.min %d_lo_u, %w_half_last : index
      %dmin0_u = scalar.addi %blk_half0_u, %c1i : i32
      %dmin_ix_u = index.cast %dmin0_u : i32 to index
      %dmin_lo_u = index.max %dmin_ix_u, %c0 : index
      %dmin_idx_u = index.min %dmin_lo_u, %w_half_last : index
      %d_half_v_u = view.load %uw_f16_view[%d_idx_u] : view<[%w_halfs]xf16> -> f16
      %dmin_half_v_u = view.load %uw_f16_view[%dmin_idx_u] : view<[%w_halfs]xf16> -> f16
      %d_u = scalar.extf %d_half_v_u : f16 to f32
      %dmin_u = scalar.extf %dmin_half_v_u : f16 to f32
      %sc_f_u = scalar.sitofp %sc_u : i32 to f32
      %m_f_u = scalar.sitofp %smin_u : i32 to f32
      %q_f_u = scalar.sitofp %quant4_u : i32 to f32
      %dsc_u = scalar.mulf %d_u, %sc_f_u : f32
      %scaled_u = scalar.mulf %dsc_u, %q_f_u : f32
      %dm_u = scalar.mulf %dmin_u, %m_f_u : f32
      %value_u = scalar.subf %scaled_u, %dm_u : f32
      %kidx_i = scalar.addi %kblk256, %i_i_g : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %x_last : index
      %xv = view.load %x_view[%kidx] : view<[%x_elems]xf32> -> f32
      %pg = scalar.mulf %value_g, %xv : f32
      %ng = scalar.addf %g0, %pg : f32
      %pu = scalar.mulf %value_u, %xv : f32
      %nu = scalar.addf %u0, %pu : f32
      scf.yield %ng, %nu : f32, f32
    }
    scf.yield %a1g, %a1u : f32, f32
  }
  %sumg = kernel.subgroup.reduce<addf> %accg : f32
  %sumu = kernel.subgroup.reduce<addf> %accu : f32
  %negg = scalar.mulf %sumg, %negone : f32
  %eg = scalar.expf<afn> %negg : f32
  %dg = scalar.addf %one, %eg : f32
  %sg = scalar.divf %one, %dg : f32
  %act = scalar.mulf %sumg, %sg : f32
  %res = scalar.mulf %act, %sumu : f32
  %is_zero = index.cmp eq, %lane, %c0 : index
  %st = scf.if %is_zero -> (f32) {
    view.store %res, %y_view[%m] : f32, view<[%m_rows]xf32>
    scf.yield %zero : f32
  } else {
    scf.yield %zero : f32
  }
  kernel.return
}

// Requires the config block above with m_rows=16, k_blocks=20. gate and up are
// the same fixture and x is the sparse GEMV activation, so both dots equal
// gemv_expected and the output is silu(dot) * dot.
check.case public @yah_fused_swiglu_q4k_case {
  %gate_w = check.file.read.npy path("fixtures/q4k_gemm/input_q4k_gemm.npy") : tensor<46080xi8>
  %up_w = check.file.read.npy path("fixtures/q4k_gemm/input_q4k_gemm.npy") : tensor<46080xi8>
  %x = check.file.read.npy path("fixtures/q4k_gemm/gemv_x.npy") : tensor<5120xf32>
  %expected = check.file.read.npy path("fixtures/q4k_gemm/fused_swiglu_expected.npy") : tensor<16xf32>
  %out = check.generate.fill value(0.0) : tensor<16xf32>
  kernel.launch @yah_fused_swiglu_q4k(%gate_w, %up_w, %x, %out) : (tensor<46080xi8>, tensor<46080xi8>, tensor<5120xf32>, tensor<16xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0001) rtol(9.9999999999999995e-07) nan(same) : tensor<16xf32>
  check.return
}

check.benchmark<@yah_fused_swiglu_q4k_case> @yah_fused_swiglu_q4k_bench

// Requires --config=yah_fused_swiglu_q4k.m_rows=17408 --config=yah_fused_swiglu_q4k.k_blocks=20.
// All-zero weights decode to zero, so out = silu(0) * 0 = 0 for every row.
check.case public @yah_fused_swiglu_q4k_full_case {
  %gate_w = check.generate.fill value(0) : tensor<50135040xi8>
  %up_w = check.generate.fill value(0) : tensor<50135040xi8>
  %x = check.generate.fill value(1.0) : tensor<5120xf32>
  %out = check.generate.fill value(0.0) : tensor<17408xf32>
  %expected = check.generate.fill value(0.0) : tensor<17408xf32>
  kernel.launch @yah_fused_swiglu_q4k(%gate_w, %up_w, %x, %out) : (tensor<50135040xi8>, tensor<50135040xi8>, tensor<5120xf32>, tensor<17408xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<17408xf32>
  check.return
}

check.benchmark<@yah_fused_swiglu_q4k_full_case> @yah_fused_swiglu_q4k_full_bench
