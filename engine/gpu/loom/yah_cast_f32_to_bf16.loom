// YAH fp32 to bf16 cast, Loom port of FloatToBfloat16Kernel.
//
// HIP source: models/qwen/hip/kernels/prefill_gemm.hip. Elementwise:
//
//   out[idx] = bf16(in[idx])
//
// used to build a bf16 scratch for the prefill GEMM path. The port is a flat
// index domain with no routing, so only the stride can be wrong.
//
// The check is exact and needs no fixture: bf16 carries eight explicit mantissa
// bits, so every integer up to 256 converts exactly, and an iota of small
// integers round-trips bit for bit. A wrong rounding mode or a stride error
// changes the values.
//
// Required config: --config=yah_bf16_cast.num_elements=8
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_bf16_cast.num_elements : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@yah_wave32) @yah_bf16_cast() {
  %unit = index.constant 1 : index
  %num_elements = config.get @yah_bf16_cast.num_elements : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %num_elements, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%in: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c256 = index.constant 256 : index
  %num_elements = config.get @yah_bf16_cast.num_elements : index
  %in_na, %out_na = buffer.assume.noalias %in, %out : buffer, buffer
  %in_view = buffer.view %in_na[%base] : buffer -> view<[%num_elements]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%num_elements]xbf16>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %idx = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %idx, %num_elements : index
  scf.if %in_range {
    %value = view.load %in_view[%idx] : view<[%num_elements]xf32> -> f32
    %narrow = scalar.fptrunc %value : f32 to bf16
    view.store %narrow, %out_view[%idx] : bf16, view<[%num_elements]xbf16>
  }
  kernel.return
}

// Requires --config=yah_bf16_cast.num_elements=8.
check.case public @yah_bf16_cast_case {
  %in = check.generate.iota offset(0.0) step(1.0) : tensor<8xf32>
  %out = check.generate.fill value(0.0) : tensor<8xbf16>
  %expected = check.generate.iota offset(0.0) step(1.0) : tensor<8xbf16>
  kernel.launch @yah_bf16_cast(%in, %out) : (tensor<8xf32>, tensor<8xbf16>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xbf16>
  check.return
}

check.benchmark<@yah_bf16_cast_case> @yah_bf16_cast_bench
