    %kdk15 = vector.mulf %dk_v, %kr15 : vector<8xf32>
    %sn15 = vector.addf %sja15, %kdk15 : vector<8xf32>
    scf.yield %sn0, %sn1, %sn2, %sn3, %sn4, %sn5, %sn6, %sn7, %sn8, %sn9, %sn10, %sn11, %sn12, %sn13, %sn14, %sn15 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  vector.store %f0, %state_view[%sa0] : vector<8xf32>, view<[%state_total]xf32>
