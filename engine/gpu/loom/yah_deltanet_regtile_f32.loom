    %sja9 = vector.mulf %s9, %alpha_v : vector<8xf32>
    %kdk9 = vector.mulf %dk_v, %kr9 : vector<8xf32>
    %sn9 = vector.addf %sja9, %kdk9 : vector<8xf32>
