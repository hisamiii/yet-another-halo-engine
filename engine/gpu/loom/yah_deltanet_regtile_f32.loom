    %pe127 = vector.extract %pq15[7] : vector<8xf32> -> f32
    %u127 = scalar.addf %u126, %ue127 : f32
    %p127 = scalar.addf %p126, %pe127 : f32
    %u_inv = scalar.mulf %u127, %inv_k : f32
    %v_minus = scalar.subf %v, %u_inv : f32
    %d = scalar.mulf %v_minus, %beta : f32
    %p_scaled = scalar.mulf %p127, %q_scale : f32
    %d_kq = scalar.mulf %d, %kq_dot2 : f32
    %o = scalar.addf %p_scaled, %d_kq : f32
    %out_t = index.mul %t, %inner_size : index
    %out_h = index.mul %h, %c128 : index
    %out_base = index.add %out_t, %out_h : index
    %out_idx = index.add %out_base, %row : index
    view.store %o, %out_view[%out_idx] : f32, view<[%out_total]xf32>
    %dk = scalar.mulf %d, %inv_k : f32
    %dk_v = vector.splat %dk : vector<8xf32>
    %kr0 = vector.load %conv_view[%ko0] : view<[%conv_total]xf32> -> vector<8xf32>
    %sja0 = vector.mulf %s0, %alpha_v : vector<8xf32>
    %kdk0 = vector.mulf %dk_v, %kr0 : vector<8xf32>
    %sn0 = vector.addf %sja0, %kdk0 : vector<8xf32>
