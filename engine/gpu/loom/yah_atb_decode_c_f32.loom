// YAH ATB C-operand decoder (write), Loom port of AtbDecodeCKernel<float, kWrite>.
//
// HIP source: models/qwen/hip/kernels/prefill_fp16.hip. Decodes bfp16ebs8 in L1
// tiles of (512, 128), each tile 2x2 super-blocks of 8x8 row-major sub-blocks:
//
//   g = group; tile = g/8192; gi = g%8192
//   l1r = tile/l1_cols; l1c = tile%l1_cols
//   rib = gi%8; t1 = gi/8; block = t1%4; t2 = t1/4;
//   sbc_half = t2%8; sbr_half = t2/8; br = block/2; bc = block%2
//   row = l1r*512 + (2*sbr_half+br)*8 + rib
//   col0 = n_offset + l1c*128 + (2*sbc_half+bc)*8
//   mult = Bfp16DecodeScale(packed[g*9])
//   out[row][col0+i] = Bfp16DecodeByte(packed[g*9+1+i], mult)
//
// The HIP scale helper is `2^(shared-127)/64` for shared >= 127 and
// `2^(-(127-shared))/64` otherwise, which is `2^(shared-133)` in both cases, so the
// port builds one fp32 exponent field `shared - 6`. The signed byte is
// `(byte&0x80) ? -(256-byte)*mult : byte*mult`; `~(byte-1)` as uint8 is exactly
// `256-byte`. row and col0 are clamped so the footprint analysis can bound the
// output view; for a real tile the clamps never fire.
//
// Required config: --config=yah_atb_decode_c.groups=2 --config=yah_atb_decode_c.l1_cols=1
//                  --config=yah_atb_decode_c.n_full=256 --config=yah_atb_decode_c.n_offset=0
//                  --config=yah_atb_decode_c.out_rows=2 --config=yah_atb_decode_c.packed_bytes=18
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_atb_decode_c.groups : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_atb_decode_c.l1_cols : %value: index where [range(%value, 1, 65536)]

config.decl @yah_atb_decode_c.n_full : %value: index where [range(%value, 8, 1073741824)]

config.decl @yah_atb_decode_c.n_offset : %value: index where [range(%value, 0, 1073741824)]

config.decl @yah_atb_decode_c.out_rows : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_atb_decode_c.packed_bytes : %value: index where [range(%value, 9, 1073741824)]

kernel.def target(@yah_wave32) @yah_atb_decode_c() {
  %unit = index.constant 1 : index
  %groups = config.get @yah_atb_decode_c.groups : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %groups, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%packed: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %c0 = index.constant 0 : index
  %c6 = index.constant 6 : index
  %c256 = index.constant 256 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c6i = scalar.constant 6 : i32
  %c7i = scalar.constant 7 : i32
  %c13i = scalar.constant 13 : i32
  %c8191i = scalar.constant 8191 : i32
  %c23i = scalar.constant 23 : i32
  %c128i = scalar.constant 128 : i32
  %c256i = scalar.constant 256 : i32
  %c512i = scalar.constant 512 : i32
  %groups = config.get @yah_atb_decode_c.groups : index
  %l1_cols = config.get @yah_atb_decode_c.l1_cols : index
  %n_full = config.get @yah_atb_decode_c.n_full : index
  %n_offset = config.get @yah_atb_decode_c.n_offset : index
  %out_rows = config.get @yah_atb_decode_c.out_rows : index
  %packed_bytes = config.get @yah_atb_decode_c.packed_bytes : index
  %l1_cols_i = index.cast %l1_cols : index to i32
  %n_full_i = index.cast %n_full : index to i32
  %n_offset_i = index.cast %n_offset : index to i32
  %out_elems = index.mul %out_rows, %n_full : index
  %out_rows_m1 = index.sub %out_rows, %c1 : index
  %n_full_m8 = index.sub %n_full, %c8 : index
  %packed_na, %out_na = buffer.assume.noalias %packed, %out : buffer, buffer
  %packed_view = buffer.view %packed_na[%base] : buffer -> view<[%packed_bytes]xi8>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%out_elems]xf32>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %g = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %g, %groups : index
  %sink = scf.if %in_range -> (index) {
    %g_i = index.cast %g : index to i32
    %tile_i = scalar.shrui %g_i, %c13i : i32
    %gi_i = scalar.andi %g_i, %c8191i : i32
    %l1c_i = scalar.remsi %tile_i, %l1_cols_i : i32
    %l1r_i = scalar.divsi %tile_i, %l1_cols_i : i32
    %rib_i = scalar.andi %gi_i, %c7i : i32
    %t1_i = scalar.shrui %gi_i, %c3i : i32
    %block_i = scalar.andi %t1_i, %c3i : i32
    %t2_i = scalar.shrui %t1_i, %c2i : i32
    %sbc_half_i = scalar.andi %t2_i, %c7i : i32
    %sbr_half_i = scalar.shrui %t2_i, %c3i : i32
    %br_i = scalar.shrui %block_i, %c1i : i32
    %bc_i = scalar.andi %block_i, %c1i : i32
    %sbr2_i = scalar.shli %sbr_half_i, %c1i : i32
    %sbr2br_i = scalar.addi %sbr2_i, %br_i : i32
    %sbr2br8_i = scalar.shli %sbr2br_i, %c3i : i32
    %l1r512_i = scalar.muli %l1r_i, %c512i : i32
    %sbr2br8_rib_i = scalar.addi %sbr2br8_i, %rib_i : i32
    %row_i = scalar.addi %l1r512_i, %sbr2br8_rib_i : i32
    %sbc2_i = scalar.shli %sbc_half_i, %c1i : i32
    %sbc2bc_i = scalar.addi %sbc2_i, %bc_i : i32
    %sbc2bc8_i = scalar.shli %sbc2bc_i, %c3i : i32
    %l1c128_i = scalar.shli %l1c_i, %c7i : i32
    %col_pre_i = scalar.addi %n_offset_i, %l1c128_i : i32
    %col0_i = scalar.addi %col_pre_i, %sbc2bc8_i : i32
    %out_rows_m1_i = index.cast %out_rows_m1 : index to i32
    %row_clamp_i = scalar.minsi %row_i, %out_rows_m1_i : i32
    %n_full_m8_i = index.cast %n_full_m8 : index to i32
    %col_clamp_i = scalar.minsi %col0_i, %n_full_m8_i : i32
    %row = index.cast %row_clamp_i : i32 to index
    %col0 = index.cast %col_clamp_i : i32 to index
    %g9_base = index.mul %g, %c9 : index
    %shared_i8 = view.load %packed_view[%g9_base] : view<[%packed_bytes]xi8> -> i8
    %shared = scalar.extui %shared_i8 : i8 to i32
    %shift_i = scalar.subi %shared, %c6i : i32
    %mult_bits = scalar.shli %shift_i, %c23i : i32
    %mult = scalar.bitcast %mult_bits : i32 to f32
    %row_base = index.mul %row, %n_full : index
    %g9 = index.mul %g, %c9 : index
    %write_loop = scf.for %i = [%c0 to %c8 step %c1](%mark = %c0i : i32) -> (i32) {
      %gi9 = index.add %g9, %i : index
      %byte_idx = index.add %gi9, %c1 : index
      %b_i8 = view.load %packed_view[%byte_idx] : view<[%packed_bytes]xi8> -> i8
      %b = scalar.extui %b_i8 : i8 to i32
      %high = scalar.andi %b, %c128i : i32
      %negative = scalar.cmpi ugt, %high, %c0i : i32
      %bf = scalar.sitofp %b : i32 to f32
      %pos_val = scalar.mulf %bf, %mult : f32
      %neg_mag = scalar.subi %c256i, %b : i32
      %negf = scalar.sitofp %neg_mag : i32 to f32
      %neg_prod = scalar.mulf %negf, %mult : f32
      %neg_val = scalar.negf %neg_prod : f32
      %value = scf.if %negative -> (f32) {
        scf.yield %neg_val : f32
      } else {
        scf.yield %pos_val : f32
      }
      %ci = index.add %col0, %i : index
      %dst = index.add %row_base, %ci : index
      view.store %value, %out_view[%dst] : f32, view<[%out_elems]xf32>
      scf.yield %mark : i32
    }
    scf.yield %c0 : index
  } else {
    scf.yield %c0 : index
  }
  kernel.return
}

// Requires --config=yah_atb_decode_c.groups=2, .l1_cols=1, .n_full=256, .n_offset=0,
// .out_rows=2, .packed_bytes=18.
//
// shared = 133 makes mult exactly 1.0. Group 0 carries bytes 1..8 and group 1
// carries 255..248, so the two rows decode to 1..8 and -1..-8: this pins both the
// signed-byte rule and the 512x128 row/column decomposition at once.
check.case public @yah_atb_decode_c_case {
  %packed = check.file.read.npy path("fixtures/atb_decode_c/packed.npy") : tensor<18xi8>
  %out = check.generate.fill value(0.0) : tensor<2x256xf32>
  %expected = check.file.read.npy path("fixtures/atb_decode_c/expected.npy") : tensor<2x256xf32>
  kernel.launch @yah_atb_decode_c(%packed, %out) : (tensor<18xi8>, tensor<2x256xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x256xf32>
  check.return
}

check.benchmark<@yah_atb_decode_c_case> @yah_atb_decode_c_bench
