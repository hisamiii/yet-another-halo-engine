// YAH ATB packed-head accumulate (fp32), Loom port of AtbAddHeadFp32Kernel.
//
// HIP source: models/qwen/hip/kernels/prefill_fp16.hip. The fp32 twin of the expand
// kernel, for the down projection whose residual already lives at full width:
//
//   out[r*full_cols + c] += packed[r*head_cols + c]      c < head_cols
//
// Same two-dimensional grid and views as the expand port, and the same reason for
// them: no index division by head_cols.
//
// Required config: --config=yah_atb_add.rows=2 --config=yah_atb_add.head_cols=3
//                  --config=yah_atb_add.full_cols=5
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_atb_add.rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_atb_add.head_cols : %value: index where [range(%value, 1, 65536)]

config.decl @yah_atb_add.full_cols : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_atb_add() {
  %unit = index.constant 1 : index
  %rows = config.get @yah_atb_add.rows : index
  %head_cols = config.get @yah_atb_add.head_cols : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %head_cols, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %rows, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%packed: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %rows = config.get @yah_atb_add.rows : index
  %head_cols = config.get @yah_atb_add.head_cols : index
  %full_cols = config.get @yah_atb_add.full_cols : index
  %packed_na, %out_na = buffer.assume.noalias %packed, %out : buffer, buffer
  %packed_view = buffer.view %packed_na[%base] : buffer -> view<[%rows]x[%head_cols]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%rows]x[%full_cols]xf32>
  %r = kernel.workgroup.id<y> : index
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %c256b = index.constant 256 : index
  %wg_base = index.mul %wg, %c256b : index
  %c = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %c, %head_cols : index
  scf.if %in_range {
    %value = view.load %packed_view[%r, %c] : view<[%rows]x[%head_cols]xf32> -> f32
    %previous = view.load %out_view[%r, %c] : view<[%rows]x[%full_cols]xf32> -> f32
    %sum = scalar.addf %previous, %value : f32
    view.store %sum, %out_view[%r, %c] : f32, view<[%rows]x[%full_cols]xf32>
  }
  kernel.return
}

// Requires --config=yah_atb_add.rows=2 --config=yah_atb_add.head_cols=3
// --config=yah_atb_add.full_cols=5.
check.case public @yah_atb_add_case {
  %packed = check.generate.iota offset(0.0) step(1.0) : tensor<2x3xf32>
  %expected = check.file.read.npy path("fixtures/atb_head/expected_add.npy") : tensor<2x5xf32>
  %out = check.generate.fill value(10.0) : tensor<2x5xf32>
  kernel.launch @yah_atb_add(%packed, %out) : (tensor<2x3xf32>, tensor<2x5xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x5xf32>
  check.return
}

check.benchmark<@yah_atb_add_case> @yah_atb_add_bench
