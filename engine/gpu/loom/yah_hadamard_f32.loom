// YAH in-place Hadamard transform, Loom port of HadamardInPlaceKernel.
//
// HIP source: engine/kv/kv_quant.hip. One block per row; the row is staged in
// shared memory, then each output element is the full inner product against a
// column of h:
//
//   row[d] = x[r][d]                       (workgroup memory)
//   x[r][e] = sum_d row[d] * h[d][e]
//
// dim is kKvBlock = 32, so one subgroup per row with one lane per output element
// and a serial 32-term inner product per lane.
//
// The check uses rows = 1 so the expectation stays expressible. With x all ones
// and h an iota over [32][32], element e is
//
//   sum_d h[d][e] = sum_d (d*32 + e) = 32*e + 15872
//
// which is an arithmetic sequence, so the expectation is an iota and a
// transposition of d and e changes it. At rows > 1 the same pattern repeats per
// row and no single iota describes the tensor, so the multi-row path is not
// covered in-source; that needs a captured fixture. The row index itself is still
// exercised because the staging read and the store both use it.
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_hadamard.rows : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_hadamard() {
  %unit = index.constant 1 : index
  %rows = config.get @yah_hadamard.rows : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%x: buffer, %h: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %rows = config.get @yah_hadamard.rows : index
  %zero = scalar.constant 0.0 : f32

  %row_bytes = index.constant 128 : offset
  %scratch = buffer.alloca<workgroup> align(16) %row_bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<32xf32>

  %x_noalias, %h_noalias = buffer.assume.noalias %x, %h : buffer, buffer
  %x_view = buffer.view %x_noalias[%base] : buffer -> view<[%rows]x32xf32>
  %h_view = buffer.view %h_noalias[%base] : buffer -> view<32x32xf32>

  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index

  %staged = view.load %x_view[%row, %lane] : view<[%rows]x32xf32> -> f32
  view.store %staged, %scratch_view[%lane] : f32, view<32xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %acc = scf.for %d = [%c0 to %c32 step %c1](%sum = %zero : f32) -> (f32) {
    %rd = view.load %scratch_view[%d] : view<32xf32> -> f32
    %hv = view.load %h_view[%d, %lane] : view<32x32xf32> -> f32
    %prod = scalar.mulf %rd, %hv : f32
    %next = scalar.addf %sum, %prod : f32
    scf.yield %next : f32
  }
  view.store %acc, %x_view[%row, %lane] : f32, view<[%rows]x32xf32>
  kernel.return
}

check.case public @yah_hadamard_case {
  %x = check.generate.fill value(1.0) : tensor<1x32xf32>
  %h = check.generate.iota offset(0.0) step(1.0) : tensor<32x32xf32>
  %expected = check.generate.iota offset(15872.0) step(32.0) : tensor<1x32xf32>
  kernel.launch @yah_hadamard(%x, %h) : (tensor<1x32xf32>, tensor<32x32xf32>)
  check.expect.close actual(%x) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x32xf32>
  check.return
}

check.benchmark<@yah_hadamard_case> @yah_hadamard_bench
