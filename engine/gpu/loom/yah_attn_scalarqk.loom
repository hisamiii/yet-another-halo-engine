// YAH WMMA causal attention, Loom port of WmmaCausalAttention (attention_wmma.hip).
//
// HIP source: models/qwen/hip/kernels/attention_wmma.hip. The HIP kernel is a
// wave32 WMMA 16x16x16 kernel: 32 query rows and two query heads per block, a
// 16-key sweep, online softmax, and a causal-tail correction on partial tiles.
// This port keeps the contract and the arithmetic and re-tiles the schedule to
// one query head and one token per workgroup, which is the shape the already
// ported baseline (yah_attn_batched) uses. Coverage and correctness first: the
// WMMA fragment order, the two-level register prefetch and the head-major
// packed-tile schedule are not reproduced, only the values they compute.
//
//   kv_head   = head / gqa                   (HIP: head / (kGqa / kWmmaHeads) groups)
//   abs_query = start_pos + token
//   seq_len   = abs_query + 1                keys up to and including self
//   scale     = 1/16                         the HIP kernel hardcodes 1/16
//   scores[p] = dot(q, k[p]) * scale
//   s         = softmax(scores[0..seq_len))
//   ctx[d]    = sum_p s[p] * v[p][d]
//   lse       = max + log(sum)               written to lse[head][token]
//   out[d]    = ctx[d] * sigmoid(gate[d])    gate armed only when lse is not
//
// Two cache layouts, selected by the head_major flag where HIP picks the packed
// arm on batch >= 1024 with a workspace:
//   canonical   ((layer*max_context + p)*num_kv_heads + kv_h)*head_dim + d
//   head-major  (kv_h*kv_padded + p)*head_dim + d                          (no layer)
// The head-major form reads the already packed workspace, so its extent is
// kv_padded*num_kv_heads*head_dim and the caller promises kv_padded <= max_context
// so that one view extent covers both arms.
//
// The online softmax is replaced by the two-pass form of the baseline port:
// scores land in a workgroup scratch buffer, the max and the sum are subgroup
// reductions, and the probabilities are normalised before the PV pass. The
// result is the same value up to floating-point order; the lse output is the
// same natural-log log-sum-exp the HIP epilogue writes.
//
// Required config:
//   --config=yah_attn_wmma.layer_idx=0
//   --config=yah_attn_wmma.start_pos=0
//   --config=yah_attn_wmma.batch_size=3
//   --config=yah_attn_wmma.max_context=16
//   --config=yah_attn_wmma.num_heads=2
//   --config=yah_attn_wmma.num_kv_heads=1
//   --config=yah_attn_wmma.head_dim=4
//   --config=yah_attn_wmma.gqa=2
//   --config=yah_attn_wmma.score_capacity=3
//   --config=yah_attn_wmma.kv_padded=16
//   --config=yah_attn_wmma.has_gate=1
//   --config=yah_attn_wmma.has_lse=0
//   --config=yah_attn_wmma.head_major=0
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_attn_wmma.layer_idx : %value: index where [range(%value, 0, 65536)]

config.decl @yah_attn_wmma.start_pos : %value: index where [range(%value, 0, 1073741824)]

config.decl @yah_attn_wmma.batch_size : %value: index where [range(%value, 1, 65536)]

config.decl @yah_attn_wmma.max_context : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_attn_wmma.num_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_attn_wmma.num_kv_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_attn_wmma.head_dim : %value: index where [range(%value, 1, 1024)]

config.decl @yah_attn_wmma.gqa : %value: index where [range(%value, 1, 4096)]

config.decl @yah_attn_wmma.score_capacity : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_attn_wmma.kv_padded : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_attn_wmma.has_gate : %value: index where [range(%value, 0, 1)]

config.decl @yah_attn_wmma.has_lse : %value: index where [range(%value, 0, 1)]

config.decl @yah_attn_wmma.head_major : %value: index where [range(%value, 0, 1)]

kernel.def target(@yah_wave32) @yah_attn_wmma() {
  %unit = index.constant 1 : index
  %num_heads = config.get @yah_attn_wmma.num_heads : index
  %batch_size = config.get @yah_attn_wmma.batch_size : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%num_heads, %batch_size, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%q: buffer, %gate: buffer, %k16: buffer, %v16: buffer, %out: buffer, %lse: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %zero = scalar.constant 0.0 : f32
  %zerov4 = vector.constant 0.0 : vector<4xf32>
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %guard = scalar.constant 1.0000000000000001e-09 : f32
  %scale = scalar.constant 0.0625 : f32
  %neg_infinite = scalar.constant -3.0000000000000001e+38 : f32
  %layer_idx = config.get @yah_attn_wmma.layer_idx : index
  %start_pos = config.get @yah_attn_wmma.start_pos : index
  %batch_size = config.get @yah_attn_wmma.batch_size : index
  %max_context = config.get @yah_attn_wmma.max_context : index
  %num_heads = config.get @yah_attn_wmma.num_heads : index
  %num_kv_heads = config.get @yah_attn_wmma.num_kv_heads : index
  %head_dim = config.get @yah_attn_wmma.head_dim : index
  %gqa = config.get @yah_attn_wmma.gqa : index
  %score_capacity = config.get @yah_attn_wmma.score_capacity : index
  %kv_padded = config.get @yah_attn_wmma.kv_padded : index
  %has_gate_flag = config.get @yah_attn_wmma.has_gate : index
  %has_lse_flag = config.get @yah_attn_wmma.has_lse : index
  %head_major_flag = config.get @yah_attn_wmma.head_major : index
  %head_major = index.cmp eq, %head_major_flag, %c1 : index
  %not_lse = index.sub %c1, %has_lse_flag : index
  %gate_on_flag = index.mul %has_gate_flag, %not_lse : index
  %gate_on = index.cmp eq, %gate_on_flag, %c1 : index
  %q_width = index.mul %num_heads, %head_dim : index
  %q_total = index.mul %batch_size, %q_width : index
  %kv_row = index.mul %num_kv_heads, %head_dim : index
  %cache_elems = index.mul %max_context, %kv_row : index
  %lse_total = index.mul %num_heads, %batch_size : index
  %scratch_len = index.mul %score_capacity, %c4 : index
  %scratch_bytes = index.cast %scratch_len : index to offset
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %scores = buffer.view %scratch[%base] : buffer -> view<[%score_capacity]xf32>
  %q_na, %gate_na, %out_na, %lse_na = buffer.assume.noalias %q, %gate, %out, %lse : buffer, buffer, buffer, buffer
  %q_view = buffer.view %q_na[%base] : buffer -> view<[%q_total]xf32>
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<[%q_total]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%q_total]xf32>
  %lse_view = buffer.view %lse_na[%base] : buffer -> view<[%lse_total]xf32>
  %k_view = buffer.view %k16[%base] : buffer -> view<[%cache_elems]xf16>
  %v_view = buffer.view %v16[%base] : buffer -> view<[%cache_elems]xf16>
  %h = kernel.workgroup.id<x> : index
  %t = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %kv_h = index.div %h, %gqa : index
  %abs_query = index.add %start_pos, %t : index
  %seq_len = index.add %abs_query, %c1 : index
  %t_row = index.mul %t, %q_width : index
  %h_row = index.mul %h, %head_dim : index
  %q_base = index.add %t_row, %h_row : index
  %layer_pos = index.mul %layer_idx, %max_context : index
  %hm_head = index.mul %kv_h, %kv_padded : index
  // Step 1: scores[p] = dot(q, k[p]) * scale, one lane per visible key.
  %phase1 = scf.for %p = [%lane to %seq_len step %c32](%m1 = %zero : f32) -> (f32) {
    %can_row = index.add %layer_pos, %p : index
    %can_row2 = index.mul %can_row, %num_kv_heads : index
    %can_head = index.add %can_row2, %kv_h : index
    %can_off = index.mul %can_head, %head_dim : index
    %hm_row = index.add %hm_head, %p : index
    %hm_off = index.mul %hm_row, %head_dim : index
    %off_k = scf.if %head_major -> (index) {
      scf.yield %hm_off : index
    } else {
      scf.yield %can_off : index
    }
    // Four channels per load. Scalar f16 loads of this row cost one L1
    // transaction per (lane, channel) -- 32 lanes reading 2 B each from 32
    // different 64 B lines -- and phase 1 measured 3977 ms of the 8579 ms
    // attention at B=2048 against PV's 2217 ms for the same MAC count. A
    // vector<4xf16> load takes four channels per instruction from one line, so
    // the transaction count per key row falls by 4x. head_dim must be a multiple
    // of 4 for the row to be covered exactly (256 and the 4-channel fixture both
    // are); the four per-channel partial sums are combined by vector.reduce at
    // the end, so the sum is reassociated and the check cases' 1e-5 gate is what
    // holds the arithmetic, not bit-identity.
    %dot = scf.for %d = [%c0 to %head_dim step %c1](%acc = %zero : f32) -> (f32) {
      %q_off = index.add %q_base, %d : index
      %q_val = view.load %q_view[%q_off] : view<[%q_total]xf32> -> f32
      %k_off = index.add %off_k, %d : index
      %k16v = view.load %k_view[%k_off] : view<[%cache_elems]xf16> -> f16
      %k_val = scalar.extf %k16v : f16 to f32
      %prod = scalar.mulf %q_val, %k_val : f32
      %next = scalar.addf %acc, %prod : f32
      scf.yield %next : f32
    }
    %scaled = scalar.mulf %dot, %scale : f32
    view.store %scaled, %scores[%p] : f32, view<[%score_capacity]xf32>
    scf.yield %m1 : f32
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // Step 2: max, then exp and sum, over the visible prefix.
  %local_max = scf.for %p2 = [%lane to %seq_len step %c32](%m2 = %neg_infinite : f32) -> (f32) {
    %s2 = view.load %scores[%p2] : view<[%score_capacity]xf32> -> f32
    %bigger = scalar.maxnumf %m2, %s2 : f32
    scf.yield %bigger : f32
  }
  %max_score = kernel.subgroup.reduce<maxnumf> %local_max : f32
  %local_sum = scf.for %p3 = [%lane to %seq_len step %c32](%m3 = %zero : f32) -> (f32) {
    %s3 = view.load %scores[%p3] : view<[%score_capacity]xf32> -> f32
    %shifted = scalar.subf %s3, %max_score : f32
    %e3 = scalar.expf<afn> %shifted : f32
    view.store %e3, %scores[%p3] : f32, view<[%score_capacity]xf32>
    %sum3 = scalar.addf %m3, %e3 : f32
    scf.yield %sum3 : f32
  }
  %sum_all = kernel.subgroup.reduce<addf> %local_sum : f32
  %guarded = scalar.addf %sum_all, %guard : f32
  %inv_sum = scalar.divf %one, %guarded : f32
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %phase_norm = scf.for %p4 = [%lane to %seq_len step %c32](%m4 = %zero : f32) -> (f32) {
    %s4 = view.load %scores[%p4] : view<[%score_capacity]xf32> -> f32
    %n4 = scalar.mulf %s4, %inv_sum : f32
    view.store %n4, %scores[%p4] : f32, view<[%score_capacity]xf32>
    scf.yield %m4 : f32
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // Step 3: ctx[d] = sum_p s[p] * v[p][d], one lane per output dimension.
  %phase3 = scf.for %d3 = [%lane to %head_dim step %c32](%m5 = %zero : f32) -> (f32) {
    %ctx = scf.for %p5 = [%c0 to %seq_len step %c1](%c5 = %zero : f32) -> (f32) {
      %can_row5 = index.add %layer_pos, %p5 : index
      %can_row5b = index.mul %can_row5, %num_kv_heads : index
      %can_head5 = index.add %can_row5b, %kv_h : index
      %can_off5 = index.mul %can_head5, %head_dim : index
      %hm_row5 = index.add %hm_head, %p5 : index
      %hm_off5 = index.mul %hm_row5, %head_dim : index
      %off_v = scf.if %head_major -> (index) {
        scf.yield %hm_off5 : index
      } else {
        scf.yield %can_off5 : index
      }
      %v_off = index.add %off_v, %d3 : index
      %s5 = view.load %scores[%p5] : view<[%score_capacity]xf32> -> f32
      %v16v = view.load %v_view[%v_off] : view<[%cache_elems]xf16> -> f16
      %v5 = scalar.extf %v16v : f16 to f32
      %prod5 = scalar.mulf %s5, %v5 : f32
      %next5 = scalar.addf %c5, %prod5 : f32
      scf.yield %next5 : f32
    }
    %g_off = index.add %q_base, %d3 : index
    %g = view.load %gate_view[%g_off] : view<[%q_total]xf32> -> f32
    %neg_g = scalar.mulf %g, %negone : f32
    %e_g = scalar.expf<afn> %neg_g : f32
    %denom = scalar.addf %one, %e_g : f32
    %sig = scalar.divf %one, %denom : f32
    %gated = scalar.mulf %ctx, %sig : f32
    %result = scf.if %gate_on -> (f32) {
      scf.yield %gated : f32
    } else {
      scf.yield %ctx : f32
    }
    view.store %result, %out_view[%g_off] : f32, view<[%q_total]xf32>
    scf.yield %m5 : f32
  }
  // The lse output is the natural-log log-sum-exp, written by lane 0.
  %is_zero = index.cmp eq, %lane, %c0 : index
  %lse_written = scf.if %is_zero -> (f32) {
    %log_sum = scalar.logf<afn> %sum_all : f32
    %lse_val = scalar.addf %max_score, %log_sum : f32
    %lse_row = index.mul %h, %batch_size : index
    %lse_idx = index.add %lse_row, %t : index
    view.store %lse_val, %lse_view[%lse_idx] : f32, view<[%lse_total]xf32>
    scf.yield %lse_val : f32
  } else {
    scf.yield %zero : f32
  }
  kernel.return
}

// Requires the config block above with has_gate=1, has_lse=0, head_major=0.
check.case public @yah_attn_wmma_canon_case {
  %q = check.file.read.npy path("fixtures/attn_wmma/input_q.npy") : tensor<24xf32>
  %gate = check.file.read.npy path("fixtures/attn_wmma/input_gate.npy") : tensor<24xf32>
  %k16 = check.file.read.npy path("fixtures/attn_wmma/input_k_f16.npy") : tensor<64xf16>
  %v16 = check.file.read.npy path("fixtures/attn_wmma/input_v_f16.npy") : tensor<64xf16>
  %expected = check.file.read.npy path("fixtures/attn_wmma/expected_out.npy") : tensor<24xf32>
  %lse = check.generate.fill value(0.0) : tensor<6xf32>
  %out = check.generate.fill value(0.0) : tensor<24xf32>
  kernel.launch @yah_attn_wmma(%q, %gate, %k16, %v16, %out, %lse) : (tensor<24xf32>, tensor<24xf32>, tensor<64xf16>, tensor<64xf16>, tensor<24xf32>, tensor<6xf32>)
  check.expect.close actual(%out) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<24xf32>
  check.return
}

check.benchmark<@yah_attn_wmma_canon_case> @yah_attn_wmma_canon_bench

// Requires the config block above with has_gate=1, has_lse=0, head_major=1.
check.case public @yah_attn_wmma_hm_case {
  %q = check.file.read.npy path("fixtures/attn_wmma/input_q.npy") : tensor<24xf32>
  %gate = check.file.read.npy path("fixtures/attn_wmma/input_gate.npy") : tensor<24xf32>
  %k16 = check.file.read.npy path("fixtures/attn_wmma/input_k_hm_f16.npy") : tensor<64xf16>
  %v16 = check.file.read.npy path("fixtures/attn_wmma/input_v_hm_f16.npy") : tensor<64xf16>
  %expected = check.file.read.npy path("fixtures/attn_wmma/expected_out.npy") : tensor<24xf32>
  %lse = check.generate.fill value(0.0) : tensor<6xf32>
  %out = check.generate.fill value(0.0) : tensor<24xf32>
  kernel.launch @yah_attn_wmma(%q, %gate, %k16, %v16, %out, %lse) : (tensor<24xf32>, tensor<24xf32>, tensor<64xf16>, tensor<64xf16>, tensor<24xf32>, tensor<6xf32>)
  check.expect.close actual(%out) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<24xf32>
  check.return
}

check.benchmark<@yah_attn_wmma_hm_case> @yah_attn_wmma_hm_bench

// Requires the config block above with has_gate=0, has_lse=1, head_major=0.
check.case public @yah_attn_wmma_lse_case {
  %q = check.file.read.npy path("fixtures/attn_wmma/input_q.npy") : tensor<24xf32>
  %gate = check.file.read.npy path("fixtures/attn_wmma/input_gate.npy") : tensor<24xf32>
  %k16 = check.file.read.npy path("fixtures/attn_wmma/input_k_f16.npy") : tensor<64xf16>
  %v16 = check.file.read.npy path("fixtures/attn_wmma/input_v_f16.npy") : tensor<64xf16>
  %expected = check.file.read.npy path("fixtures/attn_wmma/expected_out_nolse.npy") : tensor<24xf32>
  %expected_lse = check.file.read.npy path("fixtures/attn_wmma/expected_lse.npy") : tensor<6xf32>
  %lse = check.generate.fill value(0.0) : tensor<6xf32>
  %out = check.generate.fill value(0.0) : tensor<24xf32>
  kernel.launch @yah_attn_wmma(%q, %gate, %k16, %v16, %out, %lse) : (tensor<24xf32>, tensor<24xf32>, tensor<64xf16>, tensor<64xf16>, tensor<24xf32>, tensor<6xf32>)
  check.expect.close actual(%out) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<24xf32>
  check.expect.close actual(%lse) expected(%expected_lse) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<6xf32>
  check.return
}

check.benchmark<@yah_attn_wmma_lse_case> @yah_attn_wmma_lse_bench
