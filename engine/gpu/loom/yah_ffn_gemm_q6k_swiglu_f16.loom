// YAH FFN GEMM with in-kernel Q6_K decode and the SwiGLU epilogue, Loom port of
// HalfPrefillGemmKernel<..., kQ6_K, kSwiGLU>.
//
// HIP source: prefill_fp16.hip. The decoder and K loop are yah_ffn_gemm_q6k_swiglu_f32;
// the epilogue combines the accumulator with the separate f32 gate projection:
//
//   out[token*m + row] = round_f16(silu(gate[token*m + row]) * acc[row][token])
//
// This is the FFN up-projection fallback arm (LaunchBatchedQuantGEMMSwiGLUFp16),
// taken when TryLaunchBatchedDualQuantGEMMSwiGLUFp16 declines the pair: it only
// instantiates ten mixed pairs and four same-format pairs, so every other layer
// of this shard runs this arm. It is on the route.
//
// Measured: 15.86 ms at m_tiles=1088 (production 17408 rows). The decoder, K
// loop and the silu combine are untuned.
//
// Correctness case: the same packed fixture, the activation scaled to 4096 so the
// accumulator stays inside the f16 range, gate = 1, and the expected is
// round_f16(silu(1) * acc). The production-size case uses an all-zero weight, so
// the accumulator is zero and every output is zero.
//
// Required config (correctness): --config=yah_ffn_gemm_q6k_swiglu_swiglu.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_q6k_swiglu_swiglu.m_tiles=1088
amdgpu.target<gfx1151> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_q6k_swiglu.m_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_q6k_swiglu() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_q6k_swiglu.m_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %input: buffer, %gate: buffer, %wstage: buffer, %ostage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c5120 = index.constant 5120 : index
  %c33600 = index.constant 33600 : index
  %c67200 = index.constant 67200 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c104i = scalar.constant 104 : i32
  %c128i = scalar.constant 128 : i32
  %c192i = scalar.constant 192 : i32
  %c210i = scalar.constant 210 : i32
  %c255i = scalar.constant 255 : i32
  %c4200i = scalar.constant 4200 : i32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %m_tiles = config.get @yah_ffn_gemm_q6k_swiglu.m_tiles : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %w_bytes = index.mul %m_tiles, %c67200 : index
  %w_halfs = index.mul %m_tiles, %c33600 : index
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %out_total = index.mul %m_rows, %c64 : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [1, 5120] : encoding<layout>
  %weight_na, %input_na, %gate_na, %wstage_na, %ostage_na, %output_na = buffer.assume.noalias %weight, %input, %gate, %wstage, %ostage, %output : buffer, buffer, buffer, buffer, buffer, buffer
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<5120x64xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf16>
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<[%out_total]xf32>
  %wstage_view = buffer.view %wstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %ostage_view = buffer.view %ostage_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc0, %acc1, %acc2, %acc3 = scf.for %kk = [%c0 to %c5120 step %c16](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32
    %c_i = scalar.andi %lane_i, %c15i : i32
    %i_i = scalar.addi %kbase, %c_i : i32
    %blk_off0 = scalar.muli %kblk, %c210i : i32
    %group = scalar.shrui %i_i, %c5i : i32
    %half = scalar.shrui %group, %c2i : i32
    %segment = scalar.andi %group, %c3i : i32
    %h16b = scalar.andi %i_i, %c16i : i32
    %h16 = scalar.shrui %h16b, %c4i : i32
    %jj = scalar.andi %i_i, %c15i : i32
    %seg_ge2 = scalar.cmpi sge, %segment, %c2i : i32
    %qh_shift = scalar.shli %segment, %c1i : i32
    %sego = scalar.andi %segment, %c1i : i32
    %half64 = scalar.shli %half, %c6i : i32
    %sego32 = scalar.shli %sego, %c5i : i32
    %ql_base = scalar.addi %half64, %sego32 : i32
    %half32 = scalar.shli %half, %c5i : i32
    %half8 = scalar.shli %half, %c3i : i32
    %seg2 = scalar.shli %segment, %c1i : i32
    %c_ix = index.cast %c_i : i32 to index
    %c_idx = index.max %c_ix, %c0 : index
    %kx = index.add %kk, %c_idx : index
    %j_sink = scf.for %j = [%c0 to %c8 step %c1](%mk = %c0 : index) -> (index) unroll(%c2) schedule(interleaved) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %e_i = scalar.addi %lane_i, %j32 : i32
      %r_i = scalar.shrui %e_i, %c4i : i32
      %row_i = scalar.addi %m_origin_i, %r_i : i32
      %row_off = scalar.muli %row_i, %c4200i : i32
      %blk_off = scalar.addi %row_off, %blk_off0 : i32
      %ql_shift = scf.if %seg_ge2 -> (i32) {
        scf.yield %c4i : i32
      } else {
        scf.yield %c0i : i32
      }
      %ql1 = scalar.addi %blk_off, %ql_base : i32
      %ql2 = scalar.addi %ql1, %h16b : i32
      %ql_i = scalar.addi %ql2, %jj : i32
      %ql_ix = index.cast %ql_i : i32 to index
      %ql_lo = index.max %ql_ix, %c0 : index
      %ql_idx = index.min %ql_lo, %w_last : index
      %qlb8 = view.load %w_view[%ql_idx] : view<[%w_bytes]xi8> -> i8
      %qlb = scalar.extui %qlb8 : i8 to i32
      %low0 = scalar.shrui %qlb, %ql_shift : i32
      %low = scalar.andi %low0, %c15i : i32
      %qh0 = scalar.addi %blk_off, %c128i : i32
      %qh1 = scalar.addi %qh0, %half32 : i32
      %qh2 = scalar.addi %qh1, %h16b : i32
      %qh_i = scalar.addi %qh2, %jj : i32
      %qh_ix = index.cast %qh_i : i32 to index
      %qh_lo = index.max %qh_ix, %c0 : index
      %qh_idx = index.min %qh_lo, %w_last : index
      %qhb8 = view.load %w_view[%qh_idx] : view<[%w_bytes]xi8> -> i8
      %qhb = scalar.extui %qhb8 : i8 to i32
      %high0 = scalar.shrui %qhb, %qh_shift : i32
      %high = scalar.andi %high0, %c3i : i32
      %high4 = scalar.shli %high, %c4i : i32
      %code = scalar.ori %low, %high4 : i32
      %bias = scalar.subi %code, %c32i : i32
      %bias_f = scalar.sitofp %bias : i32 to f32
      %sc0 = scalar.addi %blk_off, %c192i : i32
      %sc1 = scalar.addi %sc0, %half8 : i32
      %sc2 = scalar.addi %sc1, %seg2 : i32
      %sc_i32 = scalar.addi %sc2, %h16 : i32
      %sc_ix = index.cast %sc_i32 : i32 to index
      %sc_lo = index.max %sc_ix, %c0 : index
      %sc_idx = index.min %sc_lo, %w_last : index
      %sc8 = view.load %w_view[%sc_idx] : view<[%w_bytes]xi8> -> i8
      %sc_f = scalar.sitofp %sc8 : i8 to f32
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_i = scalar.addi %blk_half0, %c104i : i32
      %d_ix = index.cast %d_i : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %value = scalar.mulf %dsc, %bias_f : f32
      %h = scalar.fptrunc %value : f32 to f16
      %row_ix = index.cast %row_i : i32 to index
      %row_lo = index.max %row_ix, %c0 : index
      %row = index.min %row_lo, %stage_last : index
      view.store %h, %wstage_view[%row, %kx] : f16, view<[%stage_rows]x5120xf16>
      scf.yield %mk : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhs = vector.fragment.load<lhs> %wstage_view[%m_origin, %kk] shape [%m, %k] : view<[%stage_rows]x5120xf16> -> vector<16xf16>
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %c0] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %c16] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %c32] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %c48] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %n0 = vector.mma %lhs, %rhs0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n1 = vector.mma %lhs, %rhs1, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n2 = vector.mma %lhs, %rhs2, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n3 = vector.mma %lhs, %rhs3, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %n0, %n1, %n2, %n3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  vector.fragment.store<result> %acc0, %ostage_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %acc1, %ostage_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %acc2, %ostage_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %acc3, %ostage_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %val = view.load %ostage_view[%gr2, %tok] : view<[%stage_rows]x64xf32> -> f32
    %tok_off = index.mul %tok, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    %g = view.load %gate_view[%gflat] : view<[%out_total]xf32> -> f32
    %negg = scalar.mulf %g, %negone : f32
    %e = scalar.expf<afn> %negg : f32
    %den = scalar.addf %one, %e : f32
    %inv = scalar.divf %one, %den : f32
    %sig = scalar.mulf %g, %inv : f32
    %act = scalar.mulf %sig, %val : f32
    %h = scalar.fptrunc %act : f32 to f16
    view.store %h, %out_view[%gflat] : f16, view<[%out_total]xf16>
    scf.yield %mk2 : index
  }
  kernel.return
}
