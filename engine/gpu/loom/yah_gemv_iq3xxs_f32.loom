// YAH IQ3_XXS block GEMV, Loom port of Q8KBlockGEMVKernel for the IQ3_XXS format
// (gemv_quant.hip). Decode each weight element with the IQ3_XXS block decoder and
// dot it against the fp32 activation row:
//
//   y[m] = sum_k iq3xxs_decode(W, m, k) * x[k]
//
// One workgroup per output row, 32 lanes, eight elements per 256-wide group and
// a subgroup add. On this shard IQ3_XXS owns one FFN-down block, so this arm is
// on the decode route.
//
// block_iq3_xxs is 98 bytes ({half d; uint8 qs[96]}); qs[0..63] index the
// 256-entry grid of four packed magnitudes and qs[64..95] are four aux words,
// one per 32-element group. The row stride is 20 blocks * 98 = 1960 bytes. Like
// the kStore port the grid (256 words) and ksigns (128 bytes) are extra read-only
// buffer operands, and the sign is applied as a signed magnitude before the float
// conversion (the carry-free byte negate).
//
// Required config: --config=yah_gemv_iq3xxs.m_rows=16
//                  --config=yah_gemv_iq3xxs.k_blocks=20
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_gemv_iq3xxs.m_rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_gemv_iq3xxs.k_blocks : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_gemv_iq3xxs() {
  %unit = index.constant 1 : index
  %m_rows = config.get @yah_gemv_iq3xxs.m_rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_rows, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %grid: buffer, %ksigns: buffer, %x: buffer, %y: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c98 = index.constant 98 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %c980 = index.constant 980 : index
  %c1960 = index.constant 1960 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c7i = scalar.constant 7 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c24i = scalar.constant 24 : i32
  %c28i = scalar.constant 28 : i32
  %c66i = scalar.constant 66 : i32
  %c98i = scalar.constant 98 : i32
  %c127i = scalar.constant 127 : i32
  %c255i = scalar.constant 255 : i32
  %c1960i = scalar.constant 1960 : i32
  %fhalf = scalar.constant 0.5 : f32
  %zero = scalar.constant 0.0 : f32
  %m_rows = config.get @yah_gemv_iq3xxs.m_rows : index
  %k_blocks = config.get @yah_gemv_iq3xxs.k_blocks : index
  %w_bytes = index.mul %m_rows, %c1960 : index
  %w_halfs = index.mul %m_rows, %c980 : index
  %x_elems = index.mul %k_blocks, %c256 : index
  %weight_na, %grid_na, %ksigns_na, %x_na, %y_na = buffer.assume.noalias %weight, %grid, %ksigns, %x, %y : buffer, buffer, buffer, buffer, buffer
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %grid_view = buffer.view %grid_na[%base] : buffer -> view<256xi32>
  %ksigns_view = buffer.view %ksigns_na[%base] : buffer -> view<128xi8>
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%x_elems]xf32>
  %y_view = buffer.view %y_na[%base] : buffer -> view<[%m_rows]xf32>
  %m = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %m_i = index.cast %m : index to i32
  %lane_i = index.cast %lane : index to i32
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %x_last = index.sub %x_elems, %c1 : index
  %acc0 = scf.for %kblk = [%c0 to %k_blocks step %c1](%a0 = %zero : f32) -> (f32) {
    %kblk_i = index.cast %kblk : index to i32
    %row_off = scalar.muli %m_i, %c1960i : i32
    %blk_off0 = scalar.muli %kblk_i, %c98i : i32
    %blk_off = scalar.addi %row_off, %blk_off0 : i32
    %kblk256 = scalar.shli %kblk_i, %c8i : i32
    %acc1 = scf.for %j = [%c0 to %c8 step %c1](%a1 = %a0 : f32) -> (f32) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %i_i = scalar.addi %lane_i, %j32 : i32
      %group = scalar.shrui %i_i, %c5i : i32
      %half0 = scalar.shrui %i_i, %c4i : i32
      %half = scalar.andi %half0, %c1i : i32
      %jj = scalar.andi %i_i, %c15i : i32
      %q = scalar.shrui %jj, %c3i : i32
      %which0 = scalar.shrui %jj, %c2i : i32
      %which = scalar.andi %which0, %c1i : i32
      %b = scalar.andi %jj, %c3i : i32
      %l2 = scalar.shli %half, %c1i : i32
      %l = scalar.addi %l2, %q : i32
      %l2x = scalar.shli %l, %c1i : i32
      %lw = scalar.addi %l2x, %which : i32
      %g8 = scalar.shli %group, %c3i : i32
      %qso = scalar.addi %blk_off, %c2i : i32
      %g8a = scalar.addi %qso, %g8 : i32
      %gix_i = scalar.addi %g8a, %lw : i32
      %gix_ix = index.cast %gix_i : i32 to index
      %gix_lo = index.max %gix_ix, %c0 : index
      %gix = index.min %gix_lo, %w_last : index
      %qsb8 = view.load %w_view[%gix] : view<[%w_bytes]xi8> -> i8
      %grid_lo = scalar.extui %qsb8 : i8 to i32
      %gidx_ix = index.cast %grid_lo : i32 to index
      %gidx_lo = index.max %gidx_ix, %c0 : index
      %gidx = index.min %gidx_lo, %c255 : index
      %gword = view.load %grid_view[%gidx] : view<256xi32> -> i32
      %g_shift = scalar.shli %b, %c3i : i32
      %gb0 = scalar.shrui %gword, %g_shift : i32
      %g_byte = scalar.andi %gb0, %c255i : i32
      %auxb = scalar.addi %blk_off, %c66i : i32
      %ag4 = scalar.shli %group, %c2i : i32
      %aux0_i = scalar.addi %auxb, %ag4 : i32
      %aux1_i = scalar.addi %aux0_i, %c1i : i32
      %aux2_i = scalar.addi %aux0_i, %c2i : i32
      %aux3_i = scalar.addi %aux0_i, %c3i : i32
      %aux0_ix = index.cast %aux0_i : i32 to index
      %aux0_lo = index.max %aux0_ix, %c0 : index
      %aux0_idx = index.min %aux0_lo, %w_last : index
      %aux1_ix = index.cast %aux1_i : i32 to index
      %aux1_lo = index.max %aux1_ix, %c0 : index
      %aux1_idx = index.min %aux1_lo, %w_last : index
      %aux2_ix = index.cast %aux2_i : i32 to index
      %aux2_lo = index.max %aux2_ix, %c0 : index
      %aux2_idx = index.min %aux2_lo, %w_last : index
      %aux3_ix = index.cast %aux3_i : i32 to index
      %aux3_lo = index.max %aux3_ix, %c0 : index
      %aux3_idx = index.min %aux3_lo, %w_last : index
      %ab0 = view.load %w_view[%aux0_idx] : view<[%w_bytes]xi8> -> i8
      %ab1 = view.load %w_view[%aux1_idx] : view<[%w_bytes]xi8> -> i8
      %ab2 = view.load %w_view[%aux2_idx] : view<[%w_bytes]xi8> -> i8
      %ab3 = view.load %w_view[%aux3_idx] : view<[%w_bytes]xi8> -> i8
      %aa0 = scalar.extui %ab0 : i8 to i32
      %aa1 = scalar.extui %ab1 : i8 to i32
      %aa2 = scalar.extui %ab2 : i8 to i32
      %aa3 = scalar.extui %ab3 : i8 to i32
      %as1 = scalar.shli %aa1, %c8i : i32
      %as2 = scalar.shli %aa2, %c16i : i32
      %as3 = scalar.shli %aa3, %c24i : i32
      %ao1 = scalar.ori %aa0, %as1 : i32
      %ao2 = scalar.ori %ao1, %as2 : i32
      %ao3 = scalar.ori %ao2, %as3 : i32
      %l7 = scalar.muli %l, %c7i : i32
      %sid0 = scalar.shrui %ao3, %l7 : i32
      %sid7 = scalar.andi %sid0, %c127i : i32
      %sid_ix = index.cast %sid7 : i32 to index
      %ksb8 = view.load %ksigns_view[%sid_ix] : view<128xi8> -> i8
      %signs = scalar.extui %ksb8 : i8 to i32
      %is_g1 = scalar.cmpi eq, %which, %c0i : i32
      %nbsh0 = scalar.shli %which, %c2i : i32
      %nbt0 = scalar.shrui %signs, %nbsh0 : i32
      %sign_nib = scalar.andi %nbt0, %c15i : i32
      %sbit0 = scalar.shrui %sign_nib, %b : i32
      %sign_bit = scalar.andi %sbit0, %c1i : i32
      %is_neg = scalar.cmpi eq, %sign_bit, %c1i : i32
      %neg_g = scalar.subi %c0i, %g_byte : i32
      %nbn0 = scalar.subi %c0i, %sign_bit : i32
      %nbm0 = scalar.xori %g_byte, %nbn0 : i32
      %mag = scalar.addi %nbm0, %sign_bit : i32
      %n4 = scalar.shrui %ao3, %c28i : i32
      %n4_f = scalar.sitofp %n4 : i32 to f32
      %hp = scalar.addf %n4_f, %fhalf : f32
      %hp2 = scalar.mulf %hp, %fhalf : f32
      %mag_f = scalar.sitofp %mag : i32 to f32
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %scale_f = scalar.mulf %d, %hp2 : f32
      %value = scalar.mulf %scale_f, %mag_f : f32
      %kidx_i = scalar.addi %kblk256, %i_i : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %x_last : index
      %xv = view.load %x_view[%kidx] : view<[%x_elems]xf32> -> f32
      %prod = scalar.mulf %value, %xv : f32
      %next = scalar.addf %a1, %prod : f32
      scf.yield %next : f32
    }
    scf.yield %acc1 : f32
  }
  %sum = kernel.subgroup.reduce<addf> %acc0 : f32
  %is_zero = index.cmp eq, %lane, %c0 : index
  %st = scf.if %is_zero -> (f32) {
    view.store %sum, %y_view[%m] : f32, view<[%m_rows]xf32>
    scf.yield %zero : f32
  } else {
    scf.yield %zero : f32
  }
  kernel.return
}

// Requires the config block above with m_rows=16, k_blocks=20.
check.case public @yah_gemv_iq3xxs_case {
  %weight = check.file.read.npy path("fixtures/iq3xxs_gemm/input_iq3xxs_gemm.npy") : tensor<31360xi8>
  %grid = check.file.read.npy path("fixtures/iq3xxs_gemm/grid.npy") : tensor<256xi32>
  %ksigns = check.file.read.npy path("fixtures/iq3xxs_gemm/ksigns.npy") : tensor<128xi8>
  %x = check.file.read.npy path("fixtures/iq3xxs_gemm/gemv_x.npy") : tensor<5120xf32>
  %expected = check.file.read.npy path("fixtures/iq3xxs_gemm/gemv_expected.npy") : tensor<16xf32>
  %y = check.generate.fill value(0.0) : tensor<16xf32>
  kernel.launch @yah_gemv_iq3xxs(%weight, %grid, %ksigns, %x, %y) : (tensor<31360xi8>, tensor<256xi32>, tensor<128xi8>, tensor<5120xf32>, tensor<16xf32>)
  check.expect.close actual(%y) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<16xf32>
  check.return
}

check.benchmark<@yah_gemv_iq3xxs_case> @yah_gemv_iq3xxs_bench

// Requires --config=yah_gemv_iq3xxs.m_rows=17408 --config=yah_gemv_iq3xxs.k_blocks=20.
// An all-zero IQ3_XXS weight decodes to zero, so every output row must be exactly 0.
check.case public @yah_gemv_iq3xxs_full_case {
  %weight = check.generate.fill value(0) : tensor<34119680xi8>
  %grid = check.generate.fill value(0) : tensor<256xi32>
  %ksigns = check.generate.fill value(0) : tensor<128xi8>
  %x = check.generate.fill value(1.0) : tensor<5120xf32>
  %y = check.generate.fill value(0.0) : tensor<17408xf32>
  %expected = check.generate.fill value(0.0) : tensor<17408xf32>
  kernel.launch @yah_gemv_iq3xxs(%weight, %grid, %ksigns, %x, %y) : (tensor<34119680xi8>, tensor<256xi32>, tensor<128xi8>, tensor<5120xf32>, tensor<17408xf32>)
  check.expect.close actual(%y) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<17408xf32>
  check.return
}

check.benchmark<@yah_gemv_iq3xxs_full_case> @yah_gemv_iq3xxs_full_bench