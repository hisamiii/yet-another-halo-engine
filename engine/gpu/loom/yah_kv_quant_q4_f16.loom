// YAH KV cache pack to q4, Loom port of QuantizeQ4Kernel.
//
// HIP source: engine/kv/kv_quant.hip. One work-item owns one 32-element block of
// f16 input and writes one 18-byte KvQ4Block (engine/kv/kv_cache.hpp):
//
//   amax    = max_i |f32(x[i])|
//   scale   = amax > 0 ? amax / 7 : 0              (f32, note 7 not 127)
//   inverse = scale > 0 ? 1 / scale : 0            (f32)
//   d       = f16(scale)                           little endian u16
//   q       = clamp(lroundf(f32(x[i]) * inverse), -8, 7)
//   qs[i/2] = even i: low nibble, odd i: high nibble, two's complement
//
// The clamp is asymmetric (-8..7) and the code is stored as a raw nibble of its
// two's complement, so -8 becomes 0x8 and 7 stays 0x7. There is no early exit: d
// is written even for an all-zero block.
//
// Required configs, one per case:
//
//   @yah_kvq4_varied   blocks=4     (4 x 32 f16 in, 4 x 18 i8 out)
//   @yah_kvq4_uniform  blocks=10240 (327680 f16 in, 184320 i8 out)
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_kvq4.blocks : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@yah_wave32) @yah_kvq4() {
  %unit = index.constant 1 : index
  %blocks = config.get @yah_kvq4.blocks : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %blocks, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c16 = index.constant 16 : index
  %c18 = index.constant 18 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %c7 = scalar.constant 7.0 : f32
  %c7i = scalar.constant 7 : i32
  %cneg8i = scalar.constant -8 : i32
  %c15i = scalar.constant 15 : i32
  %c4i = scalar.constant 4 : i32
  %c8i16 = scalar.constant 8 : i16
  %blocks = config.get @yah_kvq4.blocks : index
  %total = index.mul %blocks, %c32 : index
  %dst_bytes = index.mul %blocks, %c18 : index
  %src_noalias = buffer.assume.noalias %src : buffer
  %dst_noalias = buffer.assume.noalias %dst : buffer
  %src_view = buffer.view %src_noalias[%base] : buffer -> view<[%total]xf16>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_bytes]xi8>
  %lane = kernel.workitem.id<x> : index
  %wg = kernel.workgroup.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %blk = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %blk, %blocks : index
  scf.if %in_range {
    %src_base = index.mul %blk, %c32 : index
    %dst_base = index.mul %blk, %c18 : index
    %amax = scf.for %i = [%c0 to %c32 step %c1](%a = %zero : f32) -> (f32) {
      %off = index.add %src_base, %i : index
      %v = view.load %src_view[%off] : view<[%total]xf16> -> f16
      %vf = scalar.extf %v : f16 to f32
      %av = scalar.absf %vf : f32
      %m = scalar.maxnumf %a, %av : f32
      scf.yield %m : f32
    }
    %positive = scalar.cmpf ogt, %amax, %zero : f32
    %scale0 = scalar.divf %amax, %c7 : f32
    %scale = scf.if %positive -> (f32) {
      scf.yield %scale0 : f32
    } else {
      scf.yield %zero : f32
    }
    %scale_positive = scalar.cmpf ogt, %scale, %zero : f32
    %inverse = scf.if %scale_positive -> (f32) {
      %inv = scalar.divf %one, %scale : f32
      scf.yield %inv : f32
    } else {
      scf.yield %zero : f32
    }
    %scale_half = scalar.fptrunc %scale : f32 to f16
    %scale_bits = scalar.bitcast %scale_half : f16 to i16
    %d_lo = scalar.trunci %scale_bits : i16 to i8
    %d_hi_shifted = scalar.shrui %scale_bits, %c8i16 : i16
    %d_hi = scalar.trunci %d_hi_shifted : i16 to i8
    %dst_lo = index.add %dst_base, %c0 : index
    %dst_hi = index.add %dst_base, %c1 : index
    view.store %d_lo, %dst_view[%dst_lo] : i8, view<[%dst_bytes]xi8>
    view.store %d_hi, %dst_view[%dst_hi] : i8, view<[%dst_bytes]xi8>
    %codes_base = index.add %dst_base, %c2 : index
    %sink = scf.for %k = [%c0 to %c16 step %c1](%t = %zero : f32) -> (f32) {
      %two_k = index.mul %k, %c2 : index
      %odd_k = index.add %two_k, %c1 : index
      %off_even = index.add %src_base, %two_k : index
      %off_odd = index.add %src_base, %odd_k : index
      %even_h = view.load %src_view[%off_even] : view<[%total]xf16> -> f16
      %odd_h = view.load %src_view[%off_odd] : view<[%total]xf16> -> f16
      %even_f = scalar.extf %even_h : f16 to f32
      %odd_f = scalar.extf %odd_h : f16 to f32
      %even_p = scalar.mulf %even_f, %inverse : f32
      %odd_p = scalar.mulf %odd_f, %inverse : f32
      %even_r = scalar.roundf %even_p : f32
      %odd_r = scalar.roundf %odd_p : f32
      %even_q = scalar.fptosi %even_r : f32 to i32
      %odd_q = scalar.fptosi %odd_r : f32 to i32
      %even_hi = scalar.minsi %even_q, %c7i : i32
      %odd_hi = scalar.minsi %odd_q, %c7i : i32
      %even_lo = scalar.maxsi %even_hi, %cneg8i : i32
      %odd_lo = scalar.maxsi %odd_hi, %cneg8i : i32
      %even_nib = scalar.andi %even_lo, %c15i : i32
      %odd_nib = scalar.andi %odd_lo, %c15i : i32
      %odd_placed = scalar.shli %odd_nib, %c4i : i32
      %byte = scalar.ori %even_nib, %odd_placed : i32
      %packed = scalar.trunci %byte : i32 to i8
      %code_off = index.add %codes_base, %k : index
      view.store %packed, %dst_view[%code_off] : i8, view<[%dst_bytes]xi8>
      scf.yield %t : f32
    }
  }
  kernel.return
}

// Requires --config=yah_kvq4.blocks=4.
check.case public @yah_kvq4_varied {
  %src = check.file.read.npy path("fixtures/kv_quant_q8/input_varied.npy") : tensor<128xf16>
  %expected = check.file.read.npy path("fixtures/kv_quant_q8/q4_expected_varied.npy") : tensor<72xi8>
  %dst = check.generate.fill value(0) : tensor<72xi8>
  kernel.launch @yah_kvq4(%src, %dst) : (tensor<128xf16>, tensor<72xi8>)
  check.expect.equal actual(%dst) expected(%expected) : tensor<72xi8>
  check.return
}

check.benchmark<@yah_kvq4_varied> @yah_kvq4_varied_bench

// Requires --config=yah_kvq4.blocks=10240.
check.case public @yah_kvq4_uniform {
  %src = check.generate.fill value(3.0) : tensor<327680xf16>
  %expected = check.file.read.npy path("fixtures/kv_quant_q8/q4_expected_uniform.npy") : tensor<184320xi8>
  %dst = check.generate.fill value(0) : tensor<184320xi8>
  kernel.launch @yah_kvq4(%src, %dst) : (tensor<327680xf16>, tensor<184320xi8>)
  check.expect.equal actual(%dst) expected(%expected) : tensor<184320xi8>
  check.return
}

check.benchmark<@yah_kvq4_uniform> @yah_kvq4_uniform_bench
