// YAH IQ4_XS block GEMV, Loom port of Q8KBlockGEMVKernel for the IQ4_XS format
// (gemv_quant.hip). Decode each weight element with the IQ4_XS block decoder and
// dot it against the fp32 activation row:
//
//   y[m] = sum_k iq4xs_decode(W, m, k) * x[k]
//
// One workgroup per output row, 32 lanes, each lane eight elements per block and
// a subgroup add. This is the arm LaunchGEMV reaches through kHipQuantDirect; on
// this shard it is the decode attention-output, SSM-output and FFN-down
// projection arm.
//
// Measured: filled after the first run.
//
// Required config: --config=yah_gemv_iq4xs.m_rows=16
//                  --config=yah_gemv_iq4xs.k_blocks=20
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_gemv_iq4xs.m_rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_gemv_iq4xs.k_blocks : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_gemv_iq4xs() {
  %unit = index.constant 1 : index
  %m_rows = config.get @yah_gemv_iq4xs.m_rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_rows, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %x: buffer, %y: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c144 = index.constant 136 : index
  %c256 = index.constant 256 : index
  %c1440 = index.constant 1360 : index
  %c2880 = index.constant 2720 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c136i = scalar.constant 136 : i32
  %c2720i = scalar.constant 2720 : i32
  %kval0 = scalar.constant -127.0 : f32
  %kval1 = scalar.constant -104.0 : f32
  %kval2 = scalar.constant -83.0 : f32
  %kval3 = scalar.constant -65.0 : f32
  %kval4 = scalar.constant -49.0 : f32
  %kval5 = scalar.constant -35.0 : f32
  %kval6 = scalar.constant -22.0 : f32
  %kval7 = scalar.constant -10.0 : f32
  %kval8 = scalar.constant 1.0 : f32
  %kval9 = scalar.constant 13.0 : f32
  %kval10 = scalar.constant 25.0 : f32
  %kval11 = scalar.constant 38.0 : f32
  %kval12 = scalar.constant 53.0 : f32
  %kval13 = scalar.constant 69.0 : f32
  %kval14 = scalar.constant 89.0 : f32
  %kval15 = scalar.constant 113.0 : f32
  %zero = scalar.constant 0.0 : f32
  %m_rows = config.get @yah_gemv_iq4xs.m_rows : index
  %k_blocks = config.get @yah_gemv_iq4xs.k_blocks : index
  %w_bytes = index.mul %m_rows, %c2880 : index
  %w_halfs = index.mul %m_rows, %c1440 : index
  %x_elems = index.mul %k_blocks, %c256 : index
  %weight_na, %x_na, %y_na = buffer.assume.noalias %weight, %x, %y : buffer, buffer, buffer
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%x_elems]xf32>
  %y_view = buffer.view %y_na[%base] : buffer -> view<[%m_rows]xf32>
  %m = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %m_i = index.cast %m : index to i32
  %lane_i = index.cast %lane : index to i32
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %x_last = index.sub %x_elems, %c1 : index
  %acc0 = scf.for %kblk = [%c0 to %k_blocks step %c1](%a0 = %zero : f32) -> (f32) {
    %kblk_i = index.cast %kblk : index to i32
    %row_off = scalar.muli %m_i, %c2720i : i32
    %blk_off0 = scalar.muli %kblk_i, %c136i : i32
    %blk_off = scalar.addi %row_off, %blk_off0 : i32
    %kblk256 = scalar.shli %kblk_i, %c8i : i32
    %acc1 = scf.for %j = [%c0 to %c8 step %c1](%a1 = %a0 : f32) -> (f32) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %i_i = scalar.addi %lane_i, %j32 : i32
      %group = scalar.shrui %i_i, %c5i : i32
      %within = scalar.andi %i_i, %c31i : i32
      %l_i = scalar.andi %within, %c15i : i32
      %high = scalar.shrui %within, %c4i : i32

      %g16 = scalar.shli %group, %c4i : i32
      %qs0 = scalar.addi %blk_off, %c8i : i32
      %qs1 = scalar.addi %qs0, %g16 : i32
      %qs2 = scalar.addi %qs1, %l_i : i32
      %qs_ix = index.cast %qs2 : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %w_last : index
      %qb8 = view.load %w_view[%qs_idx] : view<[%w_bytes]xi8> -> i8
      %qb = scalar.extui %qb8 : i8 to i32
      %nib_lo = scalar.andi %qb, %c15i : i32
      %nib_hi = scalar.shrui %qb, %c4i : i32
      %is_hi = scalar.cmpi eq, %high, %c1i : i32
      %nib = scf.if %is_hi -> (i32) {
        scf.yield %nib_hi : i32
      } else {
        scf.yield %nib_lo : i32
      }
      %nib0 = scalar.andi %nib, %c1i : i32
      %t0 = scalar.cmpi eq, %nib0, %c1i : i32
      %nib1s = scalar.shrui %nib, %c1i : i32
      %nib1 = scalar.andi %nib1s, %c1i : i32
      %t1 = scalar.cmpi eq, %nib1, %c1i : i32
      %nib2s = scalar.shrui %nib, %c2i : i32
      %nib2 = scalar.andi %nib2s, %c1i : i32
      %t2 = scalar.cmpi eq, %nib2, %c1i : i32
      %nib3s = scalar.shrui %nib, %c3i : i32
      %nib3 = scalar.andi %nib3s, %c1i : i32
      %t3 = scalar.cmpi eq, %nib3, %c1i : i32
      %code = scf.if %t3 -> (f32) {
        %cb8_8 = scf.if %t2 -> (f32) {
          %cb12_4 = scf.if %t1 -> (f32) {
            %cb14_2 = scf.if %t0 -> (f32) {
              scf.yield %kval15 : f32
            } else {
              scf.yield %kval14 : f32
            }
            scf.yield %cb14_2 : f32
          } else {
            %cb12_2 = scf.if %t0 -> (f32) {
              scf.yield %kval13 : f32
            } else {
              scf.yield %kval12 : f32
            }
            scf.yield %cb12_2 : f32
          }
          scf.yield %cb12_4 : f32
        } else {
          %cb8_4 = scf.if %t1 -> (f32) {
            %cb10_2 = scf.if %t0 -> (f32) {
              scf.yield %kval11 : f32
            } else {
              scf.yield %kval10 : f32
            }
            scf.yield %cb10_2 : f32
          } else {
            %cb8_2 = scf.if %t0 -> (f32) {
              scf.yield %kval9 : f32
            } else {
              scf.yield %kval8 : f32
            }
            scf.yield %cb8_2 : f32
          }
          scf.yield %cb8_4 : f32
        }
        scf.yield %cb8_8 : f32
      } else {
        %cb0_8 = scf.if %t2 -> (f32) {
          %cb4_4 = scf.if %t1 -> (f32) {
            %cb6_2 = scf.if %t0 -> (f32) {
              scf.yield %kval7 : f32
            } else {
              scf.yield %kval6 : f32
            }
            scf.yield %cb6_2 : f32
          } else {
            %cb4_2 = scf.if %t0 -> (f32) {
              scf.yield %kval5 : f32
            } else {
              scf.yield %kval4 : f32
            }
            scf.yield %cb4_2 : f32
          }
          scf.yield %cb4_4 : f32
        } else {
          %cb0_4 = scf.if %t1 -> (f32) {
            %cb2_2 = scf.if %t0 -> (f32) {
              scf.yield %kval3 : f32
            } else {
              scf.yield %kval2 : f32
            }
            scf.yield %cb2_2 : f32
          } else {
            %cb0_2 = scf.if %t0 -> (f32) {
              scf.yield %kval1 : f32
            } else {
              scf.yield %kval0 : f32
            }
            scf.yield %cb0_2 : f32
          }
          scf.yield %cb0_4 : f32
        }
        scf.yield %cb0_8 : f32
      }
      %gpar = scalar.andi %group, %c1i : i32
      %sh4 = scalar.shli %gpar, %c2i : i32
      %gh = scalar.shrui %group, %c1i : i32
      %sl0 = scalar.addi %blk_off, %c4i : i32
      %sl1 = scalar.addi %sl0, %gh : i32
      %sl_ix = index.cast %sl1 : i32 to index
      %sl_lo2 = index.max %sl_ix, %c0 : index
      %sl_idx = index.min %sl_lo2, %w_last : index
      %sl8 = view.load %w_view[%sl_idx] : view<[%w_bytes]xi8> -> i8
      %slb = scalar.extui %sl8 : i8 to i32
      %sc_sh = scalar.shrui %slb, %sh4 : i32
      %sc_l = scalar.andi %sc_sh, %c15i : i32
      %sh0 = scalar.addi %blk_off, %c2i : i32
      %sh1 = scalar.addi %blk_off, %c3i : i32
      %sh0_ix = index.cast %sh0 : i32 to index
      %sh0_lo = index.max %sh0_ix, %c0 : index
      %sh0_idx = index.min %sh0_lo, %w_last : index
      %sh1_ix = index.cast %sh1 : i32 to index
      %sh1_lo = index.max %sh1_ix, %c0 : index
      %sh1_idx = index.min %sh1_lo, %w_last : index
      %shb0 = view.load %w_view[%sh0_idx] : view<[%w_bytes]xi8> -> i8
      %shb1 = view.load %w_view[%sh1_idx] : view<[%w_bytes]xi8> -> i8
      %shv0 = scalar.extui %shb0 : i8 to i32
      %shv1 = scalar.extui %shb1 : i8 to i32
      %shv1s = scalar.shli %shv1, %c8i : i32
      %shv = scalar.ori %shv0, %shv1s : i32
      %sh2 = scalar.shli %group, %c1i : i32
      %sc_hi_all = scalar.shrui %shv, %sh2 : i32
      %sc_hi = scalar.andi %sc_hi_all, %c3i : i32
      %sc_hi4 = scalar.shli %sc_hi, %c4i : i32
      %sc6 = scalar.ori %sc_l, %sc_hi4 : i32
      %sc = scalar.subi %sc6, %c32i : i32
      %sc_f = scalar.sitofp %sc : i32 to f32
      %blk_half = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half : i32 to index
      %d_lo2 = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo2, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %value = scalar.mulf %dsc, %code : f32
      %kidx_i = scalar.addi %kblk256, %i_i : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %x_last : index
      %xv = view.load %x_view[%kidx] : view<[%x_elems]xf32> -> f32
      %prod = scalar.mulf %value, %xv : f32
      %next = scalar.addf %a1, %prod : f32
      scf.yield %next : f32
    }
    scf.yield %acc1 : f32
  }
  %sum = kernel.subgroup.reduce<addf> %acc0 : f32
  %is_zero = index.cmp eq, %lane, %c0 : index
  %st = scf.if %is_zero -> (f32) {
    view.store %sum, %y_view[%m] : f32, view<[%m_rows]xf32>
    scf.yield %zero : f32
  } else {
    scf.yield %zero : f32
  }
  kernel.return
}

// Requires the config block above with m_rows=16, k_blocks=20.
check.case public @yah_gemv_iq4xs_case {
  %weight = check.file.read.npy path("fixtures/iq4xs_gemm/input_iq4xs_gemm.npy") : tensor<43520xi8>
  %x = check.file.read.npy path("fixtures/iq4xs_gemm/gemv_x.npy") : tensor<5120xf32>
  %expected = check.file.read.npy path("fixtures/iq4xs_gemm/gemv_expected.npy") : tensor<16xf32>
  %y = check.generate.fill value(0.0) : tensor<16xf32>
  kernel.launch @yah_gemv_iq4xs(%weight, %x, %y) : (tensor<43520xi8>, tensor<5120xf32>, tensor<16xf32>)
  check.expect.close actual(%y) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<16xf32>
  check.return
}

check.benchmark<@yah_gemv_iq4xs_case> @yah_gemv_iq4xs_bench

// Requires --config=yah_gemv_iq4xs.m_rows=17408 --config=yah_gemv_iq4xs.k_blocks=20.
// An all-zero IQ4_XS weight decodes to zero, so every output row must be exactly 0.
check.case public @yah_gemv_iq4xs_full_case {
  %weight = check.generate.fill value(0) : tensor<47349760xi8>
  %x = check.generate.fill value(1.0) : tensor<5120xf32>
  %y = check.generate.fill value(0.0) : tensor<17408xf32>
  %expected = check.generate.fill value(0.0) : tensor<17408xf32>
  kernel.launch @yah_gemv_iq4xs(%weight, %x, %y) : (tensor<47349760xi8>, tensor<5120xf32>, tensor<17408xf32>)
  check.expect.close actual(%y) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<17408xf32>
  check.return
}

check.benchmark<@yah_gemv_iq4xs_full_case> @yah_gemv_iq4xs_full_bench