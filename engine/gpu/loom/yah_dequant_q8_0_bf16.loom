// YAH Q8_0 weight dequantization to bf16, Loom port of DequantizeQ8_0ToBf16Kernel.
//
// HIP source: models/qwen/hip/kernels/prefill_gemm.hip. Per 32-wide block:
//
//   block_q8_0 = { __half d; int8 qs[32]; }          (34 bytes)
//   out[b*32 + j] = bf16(float(d) * float(qs[b][j]))
//
// The HIP kernel packs eight blocks per warp and hands each lane a uint64 of eight
// codes, extracting them with a byte pointer. This port gives each block its own
// one-warp workgroup and strides over the 32 codes, which is the same product in a
// different order.
//
// The scale is an fp16 on the wire, so the input is read through an f16 view for d
// and an i8 view for the codes; both alias the same buffer and neither is marked
// noalias.
//
// Required config: --config=yah_dequant_q8_0.blocks=2
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_dequant_q8_0.blocks : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@yah_wave32) @yah_dequant_q8_0() {
  %unit = index.constant 1 : index
  %blocks = config.get @yah_dequant_q8_0.blocks : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%blocks, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%w: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c17 = index.constant 17 : index
  %c32 = index.constant 32 : index
  %c34 = index.constant 34 : index
  %blocks = config.get @yah_dequant_q8_0.blocks : index
  %total = index.mul %blocks, %c32 : index
  %out_na = buffer.assume.noalias %out : buffer
  %w_f16 = buffer.view %w[%base] : buffer -> view<[%blocks]x[%c17]xf16>
  %w_i8 = buffer.view %w[%base] : buffer -> view<[%blocks]x[%c34]xi8>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%total]xbf16>
  %block = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %d_half = view.load %w_f16[%block, %c0] : view<[%blocks]x[%c17]xf16> -> f16
  %d = scalar.extf %d_half : f16 to f32
  %block_base = index.mul %block, %c32 : index
  %sink = scf.for %j = [%lane to %c32 step %c32](%mark = %c0 : index) -> (index) {
    %code_col = index.add %c2, %j : index
    %code = view.load %w_i8[%block, %code_col] : view<[%blocks]x[%c34]xi8> -> i8
    %code_f = scalar.sitofp %code : i8 to f32
    %scaled = scalar.mulf %d, %code_f : f32
    %narrow = scalar.fptrunc %scaled : f32 to bf16
    %dst = index.add %block_base, %j : index
    view.store %narrow, %out_view[%dst] : bf16, view<[%total]xbf16>
    scf.yield %mark : index
  }
  kernel.return
}

// Requires --config=yah_dequant_q8_0.blocks=2.
//
// Scale 0.5 times the ramp -16..15 gives multiples of 0.5 in [-8, 7.5], exact in
// bf16, repeating every 32 elements.
check.case public @yah_dequant_q8_0_case {
  %w = check.file.read.npy path("fixtures/dequant_q8_0/input_q8_0.npy") : tensor<68xi8>
  %out = check.generate.fill value(0.0) : tensor<64xbf16>
  %expected = check.generate.iota offset(-8.0) step(0.5) period(32) : tensor<64xbf16>
  kernel.launch @yah_dequant_q8_0(%w, %out) : (tensor<68xi8>, tensor<64xbf16>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<64xbf16>
  check.return
}

check.benchmark<@yah_dequant_q8_0_case> @yah_dequant_q8_0_bench
