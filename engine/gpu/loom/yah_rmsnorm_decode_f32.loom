// YAH decode RMSNorm, Loom port of RMSNormKernel (norm.hip).
//
// HIP source: models/qwen/hip/kernels/norm.hip. The single-row twin of the batched
// prefill norm:
//
//   mean_sq = sum_i x[i]^2 / dim
//   inv_rms = 1 / sqrt(mean_sq + eps)
//   out[i]  = (x[i] * inv_rms) * weight[i]
//
// The HIP kernel is one workgroup with a shared-memory reduction tree, and it also
// carries a register-cached specialization when dim is exactly 5120. This port takes
// dim as a config, uses one subgroup with lane-strided loops and
// `kernel.subgroup.reduce<addf>`, and leaves the register caching to tuning.
//
// The check is exact and needs no fixture: x all ones with eps zero makes the mean
// square exactly 1 and inv_rms exactly 1, so the output is exactly the weight, which
// the case makes an iota.
//
// Required config: --config=yah_rmsnorm_decode.dim=8
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_rmsnorm_decode.dim : %value: index where [range(%value, 1, 65536)]

config.def @yah_rmsnorm_decode.eps = 0.0 : f32

kernel.def target(@yah_wave32) @yah_rmsnorm_decode() {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%x: buffer, %weight: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c32 = index.constant 32 : index
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %dim = config.get @yah_rmsnorm_decode.dim : index
  %eps = config.get @yah_rmsnorm_decode.eps : f32
  %x_na, %w_na, %out_na = buffer.assume.noalias %x, %weight, %out : buffer, buffer, buffer
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%dim]xf32>
  %w_view = buffer.view %w_na[%base] : buffer -> view<[%dim]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%dim]xf32>
  %lane = kernel.workitem.id<x> : index
  %partial = scf.for %i = [%lane to %dim step %c32](%s = %zero : f32) -> (f32) {
    %v = view.load %x_view[%i] : view<[%dim]xf32> -> f32
    %sq = scalar.mulf %v, %v : f32
    %next = scalar.addf %s, %sq : f32
    scf.yield %next : f32
  }
  %sum_sq = kernel.subgroup.reduce<addf> %partial : f32
  %dim_i = index.cast %dim : index to i32
  %dim_f = scalar.sitofp %dim_i : i32 to f32
  %mean_sq = scalar.divf %sum_sq, %dim_f : f32
  %shifted = scalar.addf %mean_sq, %eps : f32
  %root = scalar.sqrtf %shifted : f32
  %inv = scalar.divf %one, %root : f32
  %sink = scf.for %j = [%lane to %dim step %c32](%mark = %zero : f32) -> (f32) {
    %v2 = view.load %x_view[%j] : view<[%dim]xf32> -> f32
    %w = view.load %w_view[%j] : view<[%dim]xf32> -> f32
    %normalized = scalar.mulf %v2, %inv : f32
    %scaled = scalar.mulf %normalized, %w : f32
    view.store %scaled, %out_view[%j] : f32, view<[%dim]xf32>
    scf.yield %mark : f32
  }
  kernel.return
}

// Requires --config=yah_rmsnorm_decode.dim=8.
check.case public @yah_rmsnorm_decode_case {
  %x = check.generate.fill value(1.0) : tensor<8xf32>
  %weight = check.generate.iota offset(0.0) step(1.0) : tensor<8xf32>
  %out = check.generate.fill value(0.0) : tensor<8xf32>
  %expected = check.generate.iota offset(0.0) step(1.0) : tensor<8xf32>
  kernel.launch @yah_rmsnorm_decode(%x, %weight, %out) : (tensor<8xf32>, tensor<8xf32>, tensor<8xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.return
}

check.benchmark<@yah_rmsnorm_decode_case> @yah_rmsnorm_decode_bench
