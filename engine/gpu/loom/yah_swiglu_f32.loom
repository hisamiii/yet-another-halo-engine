// YAH SwiGLU activation, Loom port of BatchedSwiGLUActivationKernel.
//
// HIP source: prefill_swiglu.hip, the split form (LaunchBatchedSwiGLUActivation):
//
//   out[i] = silu(gate[i]) * up[i]        silu(x) = x / (1 + exp(-x))
//
// One element per work-item, 256 per workgroup, flat over batch * dim. The packed
// form (LaunchPackedSwiGLUActivation) reads both halves of one [batch][2*dim]
// row; splitting it into two tensors here keeps a binding swap detectable, which
// a single uniform packed tensor cannot do.
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_swiglu.total : %value: index where [range(%value, 1, 67108864)]

kernel.def target(@yah_wave32) @yah_swiglu() {
  %unit = index.constant 1 : index
  %total = config.get @yah_swiglu.total : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %total, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%gate: buffer, %up: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c256 = index.constant 256 : index
  %total = config.get @yah_swiglu.total : index
  %lane = kernel.workitem.id<x> : index
  %wg = kernel.workgroup.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %idx = index.add %wg_base, %lane : index

  %gate_noalias, %up_noalias, %out_noalias = buffer.assume.noalias %gate, %up, %out : buffer, buffer, buffer
  %gate_view = buffer.view %gate_noalias[%base] : buffer -> view<[%total]xf32>
  %up_view = buffer.view %up_noalias[%base] : buffer -> view<[%total]xf32>
  %out_view = buffer.view %out_noalias[%base] : buffer -> view<[%total]xf32>

  %in_range = index.cmp ult, %idx, %total : index
  scf.if %in_range {
    %g = view.load %gate_view[%idx] : view<[%total]xf32> -> f32
    %u = view.load %up_view[%idx] : view<[%total]xf32> -> f32
    %s = scalar.siluf %g : f32
    %v = scalar.mulf %s, %u : f32
    view.store %v, %out_view[%idx] : f32, view<[%total]xf32>
  }
  kernel.return
}

check.case public @yah_swiglu_case {
  %gate = check.generate.fill value(1.0) : tensor<327680xf32>
  %up = check.generate.fill value(2.0) : tensor<327680xf32>
  %out = check.generate.fill value(-1.0) : tensor<327680xf32>
  %expected = check.generate.fill value(1.4621171572600098) : tensor<327680xf32>
  kernel.launch @yah_swiglu(%gate, %up, %out) : (tensor<327680xf32>, tensor<327680xf32>, tensor<327680xf32>)
  check.expect.close actual(%out) expected(%expected) atol(9.9999999999999995e-07) rtol(0.0) nan(same) : tensor<327680xf32>
  check.return
}

check.benchmark<@yah_swiglu_case> @yah_swiglu_bench
