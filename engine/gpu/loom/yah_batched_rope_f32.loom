// YAH batched RoPE in place, Loom port of BatchedRoPEKernel (text path).
//
// HIP source: models/qwen/hip/kernels/prefill_rope.hip. Grid (pairs, batch): block
// b rotates token b in place with `cur_pos = start_pos + b`. Each thread owns one
// (head, pair):
//
//   h = pair_idx / half_rot; i = pair_idx % half_rot
//   freq = 1 / theta^(2i/rotary_dim); angle = RopePosition(cur_pos, i) * freq
//   q[b][h][i]            = q0*cos - q1*sin
//   q[b][h][i+half_rot]   = q0*sin + q1*cos          (same for k over k_heads)
//
// The q pass runs over num_heads*half_rot pairs and the k pass over
// num_kv_heads*half_rot, the same thread indexing both. `RopePosition` returns the
// physical position for the null mRoPE table. start_pos = 0, batch = 1 makes the
// rotation the identity, which verifies the b/h/i indexing exactly.
//
// Required config: --config=yah_batched_rope.batch=1 --config=yah_batched_rope.start_pos=0
//                  --config=yah_batched_rope.num_heads=4 --config=yah_batched_rope.num_kv_heads=2
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_batched_rope.batch : %value: index where [range(%value, 1, 65536)]

config.decl @yah_batched_rope.start_pos : %value: index where [range(%value, 0, 1073741824)]

config.decl @yah_batched_rope.num_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_batched_rope.num_kv_heads : %value: index where [range(%value, 1, 4096)]

config.def @yah_batched_rope.head_dim = 128 : index

config.def @yah_batched_rope.rotary_dim = 128 : index

config.def @yah_batched_rope.theta = 10000000.0 : f32

kernel.def target(@yah_wave32) @yah_batched_rope() {
  %unit = index.constant 1 : index
  %num_heads = config.get @yah_batched_rope.num_heads : index
  %num_kv_heads = config.get @yah_batched_rope.num_kv_heads : index
  %rotary_dim = config.get @yah_batched_rope.rotary_dim : index
  %c2 = index.constant 2 : index
  %half_rot = index.div %rotary_dim, %c2 : index
  %q_pairs = index.mul %num_heads, %half_rot : index
  %k_pairs = index.mul %num_kv_heads, %half_rot : index
  %total = index.max %q_pairs, %k_pairs : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %total, %c255 : index
  %tiles = index.div %biased, %c256 : index
  %batch = config.get @yah_batched_rope.batch : index
  kernel.launch.config workgroups(%tiles, %batch, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%q: buffer, %k: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c256 = index.constant 256 : index
  %batch = config.get @yah_batched_rope.batch : index
  %start_pos = config.get @yah_batched_rope.start_pos : index
  %num_heads = config.get @yah_batched_rope.num_heads : index
  %num_kv_heads = config.get @yah_batched_rope.num_kv_heads : index
  %head_dim = config.get @yah_batched_rope.head_dim : index
  %rotary_dim = config.get @yah_batched_rope.rotary_dim : index
  %theta = config.get @yah_batched_rope.theta : f32
  %c2i = scalar.constant 2 : i32
  %rotary_dim_i = index.cast %rotary_dim : index to i32
  %half_rot_i = scalar.shrui %rotary_dim_i, %c2i : i32
  %half_rot = index.cast %half_rot_i : i32 to index
  %rotary_dimf = scalar.constant 128.0 : f32
  %two = scalar.constant 2.0 : f32
  %one = scalar.constant 1.0 : f32
  %bn_heads = index.mul %batch, %num_heads : index
  %q_elems = index.mul %bn_heads, %head_dim : index
  %bn_kv = index.mul %batch, %num_kv_heads : index
  %k_elems = index.mul %bn_kv, %head_dim : index
  %q_pairs = index.mul %num_heads, %half_rot : index
  %k_pairs = index.mul %num_kv_heads, %half_rot : index
  %nhd = index.mul %num_heads, %head_dim : index
  %nkvd = index.mul %num_kv_heads, %head_dim : index
  %q_na, %k_na = buffer.assume.noalias %q, %k : buffer, buffer
  %q_view = buffer.view %q_na[%base] : buffer -> view<[%q_elems]xf32>
  %k_view = buffer.view %k_na[%base] : buffer -> view<[%k_elems]xf32>
  %bi = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %wg = kernel.workgroup.id<x> : index
  %wg256 = index.mul %wg, %c256 : index
  %pair_idx = index.add %wg256, %lane : index
  %cur_raw = index.add %start_pos, %bi : index
  %cur_i = index.cast %cur_raw : index to i32
  %curf = scalar.sitofp %cur_i : i32 to f32
  %q_ok = index.cmp ult, %pair_idx, %q_pairs : index
  scf.if %q_ok {
    %h = index.div %pair_idx, %half_rot : index
    %i = index.rem %pair_idx, %half_rot : index
    %ii = index.cast %i : index to i32
    %iif = scalar.sitofp %ii : i32 to f32
    %twoi = scalar.mulf %two, %iif : f32
    %expo = scalar.divf %twoi, %rotary_dimf : f32
    %invfreq = scalar.powf<afn> %theta, %expo : f32
    %freq = scalar.divf %one, %invfreq : f32
    %angle = scalar.mulf %curf, %freq : f32
    %cv = scalar.cosf<afn> %angle : f32
    %sv = scalar.sinf<afn> %angle : f32
    %i1 = index.add %i, %half_rot : index
    %qh = index.mul %h, %head_dim : index
    %bq = index.mul %bi, %nhd : index
    %base_q = index.add %bq, %qh : index
    %idx0 = index.add %base_q, %i : index
    %idx1 = index.add %base_q, %i1 : index
    %q0 = view.load %q_view[%idx0] : view<[%q_elems]xf32> -> f32
    %q1 = view.load %q_view[%idx1] : view<[%q_elems]xf32> -> f32
    %ac = scalar.mulf %q0, %cv : f32
    %as = scalar.mulf %q1, %sv : f32
    %r0 = scalar.subf %ac, %as : f32
    %bc = scalar.mulf %q0, %sv : f32
    %bd = scalar.mulf %q1, %cv : f32
    %r1 = scalar.addf %bc, %bd : f32
    view.store %r0, %q_view[%idx0] : f32, view<[%q_elems]xf32>
    view.store %r1, %q_view[%idx1] : f32, view<[%q_elems]xf32>
  }
  %k_ok = index.cmp ult, %pair_idx, %k_pairs : index
  scf.if %k_ok {
    %hk = index.div %pair_idx, %half_rot : index
    %ik = index.rem %pair_idx, %half_rot : index
    %iki = index.cast %ik : index to i32
    %ikf = scalar.sitofp %iki : i32 to f32
    %twoik = scalar.mulf %two, %ikf : f32
    %expok = scalar.divf %twoik, %rotary_dimf : f32
    %invfreqk = scalar.powf<afn> %theta, %expok : f32
    %freqk = scalar.divf %one, %invfreqk : f32
    %anglek = scalar.mulf %curf, %freqk : f32
    %cvk = scalar.cosf<afn> %anglek : f32
    %svk = scalar.sinf<afn> %anglek : f32
    %ik1 = index.add %ik, %half_rot : index
    %kh = index.mul %hk, %head_dim : index
    %bk = index.mul %bi, %nkvd : index
    %base_k = index.add %bk, %kh : index
    %idxk0 = index.add %base_k, %ik : index
    %idxk1 = index.add %base_k, %ik1 : index
    %k0 = view.load %k_view[%idxk0] : view<[%k_elems]xf32> -> f32
    %k1 = view.load %k_view[%idxk1] : view<[%k_elems]xf32> -> f32
    %kac = scalar.mulf %k0, %cvk : f32
    %kas = scalar.mulf %k1, %svk : f32
    %kr0 = scalar.subf %kac, %kas : f32
    %kbc = scalar.mulf %k0, %svk : f32
    %kbd = scalar.mulf %k1, %cvk : f32
    %kr1 = scalar.addf %kbc, %kbd : f32
    view.store %kr0, %k_view[%idxk0] : f32, view<[%k_elems]xf32>
    view.store %kr1, %k_view[%idxk1] : f32, view<[%k_elems]xf32>
  }
  kernel.return
}

// Requires the config above. batch = 1, start_pos = 0 makes every angle zero, so
// the q and k iotas come back unchanged.
check.case public @yah_batched_rope_case {
  %q = check.generate.iota offset(1.0) step(1.0) : tensor<4x128xf32>
  %k = check.generate.iota offset(100.0) step(2.0) : tensor<2x128xf32>
  %q_expected = check.generate.iota offset(1.0) step(1.0) : tensor<4x128xf32>
  %k_expected = check.generate.iota offset(100.0) step(2.0) : tensor<2x128xf32>
  kernel.launch @yah_batched_rope(%q, %k) : (tensor<4x128xf32>, tensor<2x128xf32>)
  check.expect.close actual(%q) expected(%q_expected) atol(0.0) rtol(0.0) nan(same) : tensor<4x128xf32>
  check.expect.close actual(%k) expected(%k_expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x128xf32>
  check.return
}

check.benchmark<@yah_batched_rope_case> @yah_batched_rope_bench
