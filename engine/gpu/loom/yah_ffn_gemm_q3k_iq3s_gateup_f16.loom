      %h16_g = scalar.shrui %h16b_g, %c4i_g : i32
      %jj_g = scalar.andi %i_i_g, %c15i_g : i32
      %lane_of_g = scalar.addi %h16b_g, %jj_g : i32
      %half32_g = scalar.shli %half_g, %c5i_g : i32
