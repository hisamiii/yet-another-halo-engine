      %si_div4_g = scalar.shrui %si_v_g, %c2i_g : i32
      %hi_shift_g = scalar.shli %si_div4_g, %c1i_g : i32
      %high0_g = scalar.shrui %hib_g, %hi_shift_g : i32
      %high2_g = scalar.andi %high0_g, %c3i_g : i32
      %high4_g = scalar.shli %high2_g, %c4i_g : i32
      %scale6_g = scalar.ori %low4_g, %high4_g : i32
      %scale_biased_g = scalar.subi %scale6_g, %c32i_g : i32
      %scale_f_g = scalar.sitofp %scale_biased_g : i32 to f32
