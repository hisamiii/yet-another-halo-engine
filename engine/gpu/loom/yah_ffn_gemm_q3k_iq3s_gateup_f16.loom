      %si_mod4_g = scalar.andi %si_v_g, %c3i_g : i32
      %hi_off8_g = scalar.addi %sc0_g, %c8i_g : i32
      %hi1_g = scalar.addi %hi_off8_g, %si_mod4_g : i32
      %hi_ix_g = index.cast %hi1_g : i32 to index
      %hi_lo_g = index.max %hi_ix_g, %c0 : index
      %hi_idx_g = index.min %hi_lo_g, %gw_last : index
      %hib8_g = view.load %gw_view[%hi_idx_g] : view<[%gw_bytes]xi8> -> i8
