// YAH DFlash SiLU multiply, Loom port of dflash_silu_mul_kernel.
//
// HIP source: dflash_kernels.hip. In place: gate[i] = silu(gate[i]) * up[i].
//
// Required config: --config=yah_dflash_silu_mul.count=8
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_dflash_silu_mul.count : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@yah_wave32) @yah_dflash_silu_mul() {
  %unit = index.constant 1 : index
  %count = config.get @yah_dflash_silu_mul.count : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %count, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%gate: buffer, %up: buffer) {
  %base = index.constant 0 : offset
  %c256 = index.constant 256 : index
  %count = config.get @yah_dflash_silu_mul.count : index
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %gate_na, %up_na = buffer.assume.noalias %gate, %up : buffer, buffer
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<[%count]xf32>
  %up_view = buffer.view %up_na[%base] : buffer -> view<[%count]xf32>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wg256 = index.mul %wg, %c256 : index
  %idx = index.add %wg256, %lane : index
  %in_range = index.cmp ult, %idx, %count : index
  scf.if %in_range {
    %g = view.load %gate_view[%idx] : view<[%count]xf32> -> f32
    %neg = scalar.subf %zero, %g : f32
    %e = scalar.expf<afn> %neg : f32
    %den = scalar.addf %one, %e : f32
    %silu = scalar.divf %g, %den : f32
    %u = view.load %up_view[%idx] : view<[%count]xf32> -> f32
    %r = scalar.mulf %silu, %u : f32
    view.store %r, %gate_view[%idx] : f32, view<[%count]xf32>
  }
  kernel.return
}

// Requires --config=yah_dflash_silu_mul.count=8.
// gate = 100 and up = 2: exp(-100) rounds to zero in f32, so silu(100) = 100 and the
// result is exactly 200.
check.case public @yah_dflash_silu_mul_case {
  %gate = check.generate.fill value(100.0) : tensor<8xf32>
  %up = check.generate.fill value(2.0) : tensor<8xf32>
  %expected = check.generate.fill value(200.0) : tensor<8xf32>
  kernel.launch @yah_dflash_silu_mul(%gate, %up) : (tensor<8xf32>, tensor<8xf32>)
  check.expect.close actual(%gate) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.return
}

check.benchmark<@yah_dflash_silu_mul_case> @yah_dflash_silu_mul_bench
