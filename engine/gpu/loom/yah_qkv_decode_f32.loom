// YAH mixed-format decode QKV projection, Loom port of
// Wave32FusedQKVProjectionsKernel_1Row (qkv.hip). One workgroup per row over
// q_dim + 2*kv_dim rows; each band dispatches its own runtime GgmlType.
// On this shard q in {Q4_K,IQ4_XS,IQ4_NL,Q6_K} and k,v in {Q4_K,Q5_K,Q6_K,Q8_0}.
// The per-band weight buffer is read through ONE i8 and ONE f16 view sized to
// the maximum supported stride, so the buffers must be at least
// q_rows*4200 and kv_rows*5440 bytes respectively.
//
// Required config: --config=yah_qkv_decode.q_dim=16
//                  --config=yah_qkv_decode.kv_dim=16
//                  --config=yah_qkv_decode.k_groups=20
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

func.def @q4k_step(%wn: index, %whn: index, %xn: index, %wv: view<[%wn]xi8>, %wh: view<[%whn]xf16>, %xs: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c144 = index.constant 144 : index
  %c256 = index.constant 256 : index
  %c1440 = index.constant 1440 : index
  %c2880 = index.constant 2880 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %zero = scalar.constant 0.0 : f32
  %wlast = index.sub %wn, %c1 : index
  %whlast = index.sub %whn, %c1 : index
  %xlast = index.sub %xn, %c1 : index
  %row_off = scalar.muli %row_i, %c2880i : i32
  %blk_off0 = scalar.muli %kblk_i, %c144i : i32
  %blk_off = scalar.addi %row_off, %blk_off0 : i32
  %kblk256 = scalar.shli %kblk_i, %c8i : i32
      %gg_i = scalar.shrui %i_i, %c6i : i32
      %wv_i = scalar.andi %i_i, %c63i : i32
      %lane_dec = scalar.andi %wv_i, %c31i : i32
      %wv_hi = scalar.shrui %wv_i, %c5i : i32
      %is_low = scalar.cmpi slt, %wv_i, %c32i : i32
      %qs0 = scalar.addi %blk_off, %c16i : i32
      %gg32 = scalar.shli %gg_i, %c5i : i32
      %qs1 = scalar.addi %qs0, %gg32 : i32
      %qs2 = scalar.addi %qs1, %lane_dec : i32
      %qs_ix = index.cast %qs2 : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %wlast : index
      %qb8 = view.load %wv[%qs_idx] : view<[%wn]xi8> -> i8
      %qb = scalar.extui %qb8 : i8 to i32
      %qb_lo = scalar.andi %qb, %c15i : i32
      %qb_hi = scalar.shrui %qb, %c4i : i32
      %quant4 = scf.if %is_low -> (i32) {
        scf.yield %qb_lo : i32
      } else {
        scf.yield %qb_hi : i32
      }
      %gg2 = scalar.shli %gg_i, %c1i : i32
      %sis = scalar.addi %gg2, %wv_hi : i32
      %sis_low = scalar.cmpi slt, %sis, %c4i : i32
      %la0 = scalar.addi %blk_off, %c4i : i32
      %la_i = scalar.addi %la0, %sis : i32
      %lb_i = scalar.addi %la_i, %c4i : i32
      %lc_i = scalar.addi %blk_off, %sis : i32
      %la_ix = index.cast %la_i : i32 to index
      %la_lo = index.max %la_ix, %c0 : index
      %la_idx = index.min %la_lo, %wlast : index
      %lb_ix = index.cast %lb_i : i32 to index
      %lb_lo = index.max %lb_ix, %c0 : index
      %lb_idx = index.min %lb_lo, %wlast : index
      %lc_ix = index.cast %lc_i : i32 to index
      %lc_lo = index.max %lc_ix, %c0 : index
      %lc_idx = index.min %lc_lo, %wlast : index
      %la8 = view.load %wv[%la_idx] : view<[%wn]xi8> -> i8
      %lb8 = view.load %wv[%lb_idx] : view<[%wn]xi8> -> i8
      %lc8 = view.load %wv[%lc_idx] : view<[%wn]xi8> -> i8
      %la = scalar.extui %la8 : i8 to i32
      %lb = scalar.extui %lb8 : i8 to i32
      %lc = scalar.extui %lc8 : i8 to i32
      %sc, %smin = scf.if %sis_low -> (i32, i32) {
        %s = scalar.andi %la, %c63i : i32
        %mv = scalar.andi %lb, %c63i : i32
        scf.yield %s, %mv : i32, i32
      } else {
        %lb_lo2 = scalar.andi %lb, %c15i : i32
        %lc_hi = scalar.shrui %lc, %c6i : i32
        %lc_hi4 = scalar.shli %lc_hi, %c4i : i32
        %s2 = scalar.ori %lb_lo2, %lc_hi4 : i32
        %lb_hi = scalar.shrui %lb, %c4i : i32
        %la_hi = scalar.shrui %la, %c6i : i32
        %la_hi4 = scalar.shli %la_hi, %c4i : i32
        %m2 = scalar.ori %lb_hi, %la_hi4 : i32
        scf.yield %s2, %m2 : i32, i32
      }
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %whlast : index
      %dmin0 = scalar.addi %blk_half0, %c1i : i32
      %dmin_ix = index.cast %dmin0 : i32 to index
      %dmin_lo = index.max %dmin_ix, %c0 : index
      %dmin_idx = index.min %dmin_lo, %whlast : index
      %d_half_v = view.load %wh[%d_idx] : view<[%whn]xf16> -> f16
      %dmin_half_v = view.load %wh[%dmin_idx] : view<[%whn]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dmin = scalar.extf %dmin_half_v : f16 to f32
      %sc_f = scalar.sitofp %sc : i32 to f32
      %m_f = scalar.sitofp %smin : i32 to f32
      %q_f = scalar.sitofp %quant4 : i32 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %scaled = scalar.mulf %dsc, %q_f : f32
      %dm = scalar.mulf %dmin, %m_f : f32
      %value = scalar.subf %scaled, %dm : f32
      %kidx_i = scalar.addi %kblk256, %i_i : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %xlast : index
      %xv = view.load %xs[%kidx] : view<[%xn]xf32> -> f32
      %prod = scalar.mulf %value, %xv : f32
  func.return %prod : f32
}

func.def @iq4xs_step(%wn: index, %whn: index, %xn: index, %wv: view<[%wn]xi8>, %wh: view<[%whn]xf16>, %xs: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c144 = index.constant 136 : index
  %c256 = index.constant 256 : index
  %c1440 = index.constant 1360 : index
  %c2880 = index.constant 2720 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c136i = scalar.constant 136 : i32
  %c2720i = scalar.constant 2720 : i32
  %kval0 = scalar.constant -127.0 : f32
  %kval1 = scalar.constant -104.0 : f32
  %kval2 = scalar.constant -83.0 : f32
  %kval3 = scalar.constant -65.0 : f32
  %kval4 = scalar.constant -49.0 : f32
  %kval5 = scalar.constant -35.0 : f32
  %kval6 = scalar.constant -22.0 : f32
  %kval7 = scalar.constant -10.0 : f32
  %kval8 = scalar.constant 1.0 : f32
  %kval9 = scalar.constant 13.0 : f32
  %kval10 = scalar.constant 25.0 : f32
  %kval11 = scalar.constant 38.0 : f32
  %kval12 = scalar.constant 53.0 : f32
  %kval13 = scalar.constant 69.0 : f32
  %kval14 = scalar.constant 89.0 : f32
  %kval15 = scalar.constant 113.0 : f32
  %zero = scalar.constant 0.0 : f32
  %wlast = index.sub %wn, %c1 : index
  %whlast = index.sub %whn, %c1 : index
  %xlast = index.sub %xn, %c1 : index
  %row_off = scalar.muli %row_i, %c2720i : i32
  %blk_off0 = scalar.muli %kblk_i, %c136i : i32
  %blk_off = scalar.addi %row_off, %blk_off0 : i32
  %kblk256 = scalar.shli %kblk_i, %c8i : i32
      %group = scalar.shrui %i_i, %c5i : i32
      %within = scalar.andi %i_i, %c31i : i32
      %l_i = scalar.andi %within, %c15i : i32
      %high = scalar.shrui %within, %c4i : i32

      %g16 = scalar.shli %group, %c4i : i32
      %qs0 = scalar.addi %blk_off, %c8i : i32
      %qs1 = scalar.addi %qs0, %g16 : i32
      %qs2 = scalar.addi %qs1, %l_i : i32
      %qs_ix = index.cast %qs2 : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %wlast : index
      %qb8 = view.load %wv[%qs_idx] : view<[%wn]xi8> -> i8
      %qb = scalar.extui %qb8 : i8 to i32
      %nib_lo = scalar.andi %qb, %c15i : i32
      %nib_hi = scalar.shrui %qb, %c4i : i32
      %is_hi = scalar.cmpi eq, %high, %c1i : i32
      %nib = scf.if %is_hi -> (i32) {
        scf.yield %nib_hi : i32
      } else {
        scf.yield %nib_lo : i32
      }
      %nib0 = scalar.andi %nib, %c1i : i32
      %t0 = scalar.cmpi eq, %nib0, %c1i : i32
      %nib1s = scalar.shrui %nib, %c1i : i32
      %nib1 = scalar.andi %nib1s, %c1i : i32
      %t1 = scalar.cmpi eq, %nib1, %c1i : i32
      %nib2s = scalar.shrui %nib, %c2i : i32
      %nib2 = scalar.andi %nib2s, %c1i : i32
      %t2 = scalar.cmpi eq, %nib2, %c1i : i32
      %nib3s = scalar.shrui %nib, %c3i : i32
      %nib3 = scalar.andi %nib3s, %c1i : i32
      %t3 = scalar.cmpi eq, %nib3, %c1i : i32
      %code = scf.if %t3 -> (f32) {
        %cb8_8 = scf.if %t2 -> (f32) {
          %cb12_4 = scf.if %t1 -> (f32) {
            %cb14_2 = scf.if %t0 -> (f32) {
              scf.yield %kval15 : f32
            } else {
              scf.yield %kval14 : f32
            }
            scf.yield %cb14_2 : f32
          } else {
            %cb12_2 = scf.if %t0 -> (f32) {
              scf.yield %kval13 : f32
            } else {
              scf.yield %kval12 : f32
            }
            scf.yield %cb12_2 : f32
          }
          scf.yield %cb12_4 : f32
        } else {
          %cb8_4 = scf.if %t1 -> (f32) {
            %cb10_2 = scf.if %t0 -> (f32) {
              scf.yield %kval11 : f32
            } else {
              scf.yield %kval10 : f32
            }
            scf.yield %cb10_2 : f32
          } else {
            %cb8_2 = scf.if %t0 -> (f32) {
              scf.yield %kval9 : f32
            } else {
              scf.yield %kval8 : f32
            }
            scf.yield %cb8_2 : f32
          }
          scf.yield %cb8_4 : f32
        }
        scf.yield %cb8_8 : f32
      } else {
        %cb0_8 = scf.if %t2 -> (f32) {
          %cb4_4 = scf.if %t1 -> (f32) {
            %cb6_2 = scf.if %t0 -> (f32) {
              scf.yield %kval7 : f32
            } else {
              scf.yield %kval6 : f32
            }
            scf.yield %cb6_2 : f32
          } else {
            %cb4_2 = scf.if %t0 -> (f32) {
              scf.yield %kval5 : f32
            } else {
              scf.yield %kval4 : f32
            }
            scf.yield %cb4_2 : f32
          }
          scf.yield %cb4_4 : f32
        } else {
          %cb0_4 = scf.if %t1 -> (f32) {
            %cb2_2 = scf.if %t0 -> (f32) {
              scf.yield %kval3 : f32
            } else {
              scf.yield %kval2 : f32
            }
            scf.yield %cb2_2 : f32
          } else {
            %cb0_2 = scf.if %t0 -> (f32) {
              scf.yield %kval1 : f32
            } else {
              scf.yield %kval0 : f32
            }
            scf.yield %cb0_2 : f32
          }
          scf.yield %cb0_4 : f32
        }
        scf.yield %cb0_8 : f32
      }
      %gpar = scalar.andi %group, %c1i : i32
      %sh4 = scalar.shli %gpar, %c2i : i32
      %gh = scalar.shrui %group, %c1i : i32
      %sl0 = scalar.addi %blk_off, %c4i : i32
      %sl1 = scalar.addi %sl0, %gh : i32
      %sl_ix = index.cast %sl1 : i32 to index
      %sl_lo2 = index.max %sl_ix, %c0 : index
      %sl_idx = index.min %sl_lo2, %wlast : index
      %sl8 = view.load %wv[%sl_idx] : view<[%wn]xi8> -> i8
      %slb = scalar.extui %sl8 : i8 to i32
      %sc_sh = scalar.shrui %slb, %sh4 : i32
      %sc_l = scalar.andi %sc_sh, %c15i : i32
      %sh0 = scalar.addi %blk_off, %c2i : i32
      %sh1 = scalar.addi %blk_off, %c3i : i32
      %sh0_ix = index.cast %sh0 : i32 to index
      %sh0_lo = index.max %sh0_ix, %c0 : index
      %sh0_idx = index.min %sh0_lo, %wlast : index
      %sh1_ix = index.cast %sh1 : i32 to index
      %sh1_lo = index.max %sh1_ix, %c0 : index
      %sh1_idx = index.min %sh1_lo, %wlast : index
      %shb0 = view.load %wv[%sh0_idx] : view<[%wn]xi8> -> i8
      %shb1 = view.load %wv[%sh1_idx] : view<[%wn]xi8> -> i8
      %shv0 = scalar.extui %shb0 : i8 to i32
      %shv1 = scalar.extui %shb1 : i8 to i32
      %shv1s = scalar.shli %shv1, %c8i : i32
      %shv = scalar.ori %shv0, %shv1s : i32
      %sh2 = scalar.shli %group, %c1i : i32
      %sc_hi_all = scalar.shrui %shv, %sh2 : i32
      %sc_hi = scalar.andi %sc_hi_all, %c3i : i32
      %sc_hi4 = scalar.shli %sc_hi, %c4i : i32
      %sc6 = scalar.ori %sc_l, %sc_hi4 : i32
      %sc = scalar.subi %sc6, %c32i : i32
      %sc_f = scalar.sitofp %sc : i32 to f32
      %blk_half = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half : i32 to index
      %d_lo2 = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo2, %whlast : index
      %d_half_v = view.load %wh[%d_idx] : view<[%whn]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %value = scalar.mulf %dsc, %code : f32
      %kidx_i = scalar.addi %kblk256, %i_i : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %xlast : index
      %xv = view.load %xs[%kidx] : view<[%xn]xf32> -> f32
      %prod = scalar.mulf %value, %xv : f32
  func.return %prod : f32
}

func.def @iq4nl_step(%wn: index, %whn: index, %xn: index, %wv: view<[%wn]xi8>, %wh: view<[%whn]xf16>, %xs: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c144 = index.constant 144 : index
  %c256 = index.constant 256 : index
  %c1440 = index.constant 1440 : index
  %c2880 = index.constant 2880 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c18i = scalar.constant 18 : i32
  %c31i = scalar.constant 31 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %kval0 = scalar.constant -127.0 : f32
  %kval1 = scalar.constant -104.0 : f32
  %kval2 = scalar.constant -83.0 : f32
  %kval3 = scalar.constant -65.0 : f32
  %kval4 = scalar.constant -49.0 : f32
  %kval5 = scalar.constant -35.0 : f32
  %kval6 = scalar.constant -22.0 : f32
  %kval7 = scalar.constant -10.0 : f32
  %kval8 = scalar.constant 1.0 : f32
  %kval9 = scalar.constant 13.0 : f32
  %kval10 = scalar.constant 25.0 : f32
  %kval11 = scalar.constant 38.0 : f32
  %kval12 = scalar.constant 53.0 : f32
  %kval13 = scalar.constant 69.0 : f32
  %kval14 = scalar.constant 89.0 : f32
  %kval15 = scalar.constant 113.0 : f32
  %zero = scalar.constant 0.0 : f32
  %wlast = index.sub %wn, %c1 : index
  %whlast = index.sub %whn, %c1 : index
  %xlast = index.sub %xn, %c1 : index
  %row_off = scalar.muli %row_i, %c2880i : i32
  %grp_off0 = scalar.muli %kblk_i, %c144i : i32
  %grp_off = scalar.addi %row_off, %grp_off0 : i32
  %blk8 = scalar.shrui %i_i, %c5i : i32
  %blkj = scalar.muli %blk8, %c18i : i32
  %blk_off = scalar.addi %grp_off, %blkj : i32
  %kblk256 = scalar.shli %kblk_i, %c8i : i32
      %within = scalar.andi %i_i, %c31i : i32
      %l_i = scalar.andi %within, %c15i : i32
      %half = scalar.shrui %within, %c4i : i32
      %shift = scalar.shli %half, %c2i : i32
      %qs0 = scalar.addi %blk_off, %c2i : i32
      %qs_i = scalar.addi %qs0, %l_i : i32
      %qs_ix = index.cast %qs_i : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %wlast : index
      %qb8 = view.load %wv[%qs_idx] : view<[%wn]xi8> -> i8
      %qb = scalar.extui %qb8 : i8 to i32
      %nib0s = scalar.shrui %qb, %shift : i32
      %nib = scalar.andi %nib0s, %c15i : i32
      %nib0 = scalar.andi %nib, %c1i : i32
      %t0 = scalar.cmpi eq, %nib0, %c1i : i32
      %nib1s = scalar.shrui %nib, %c1i : i32
      %nib1 = scalar.andi %nib1s, %c1i : i32
      %t1 = scalar.cmpi eq, %nib1, %c1i : i32
      %nib2s = scalar.shrui %nib, %c2i : i32
      %nib2 = scalar.andi %nib2s, %c1i : i32
      %t2 = scalar.cmpi eq, %nib2, %c1i : i32
      %nib3s = scalar.shrui %nib, %c3i : i32
      %nib3 = scalar.andi %nib3s, %c1i : i32
      %t3 = scalar.cmpi eq, %nib3, %c1i : i32
      %code = scf.if %t3 -> (f32) {
        %cb8_8 = scf.if %t2 -> (f32) {
          %cb12_4 = scf.if %t1 -> (f32) {
            %cb14_2 = scf.if %t0 -> (f32) {
              scf.yield %kval15 : f32
            } else {
              scf.yield %kval14 : f32
            }
            scf.yield %cb14_2 : f32
          } else {
            %cb12_2 = scf.if %t0 -> (f32) {
              scf.yield %kval13 : f32
            } else {
              scf.yield %kval12 : f32
            }
            scf.yield %cb12_2 : f32
          }
          scf.yield %cb12_4 : f32
        } else {
          %cb8_4 = scf.if %t1 -> (f32) {
            %cb10_2 = scf.if %t0 -> (f32) {
              scf.yield %kval11 : f32
            } else {
              scf.yield %kval10 : f32
            }
            scf.yield %cb10_2 : f32
          } else {
            %cb8_2 = scf.if %t0 -> (f32) {
              scf.yield %kval9 : f32
            } else {
              scf.yield %kval8 : f32
            }
            scf.yield %cb8_2 : f32
          }
          scf.yield %cb8_4 : f32
        }
        scf.yield %cb8_8 : f32
      } else {
        %cb0_8 = scf.if %t2 -> (f32) {
          %cb4_4 = scf.if %t1 -> (f32) {
            %cb6_2 = scf.if %t0 -> (f32) {
              scf.yield %kval7 : f32
            } else {
              scf.yield %kval6 : f32
            }
            scf.yield %cb6_2 : f32
          } else {
            %cb4_2 = scf.if %t0 -> (f32) {
              scf.yield %kval5 : f32
            } else {
              scf.yield %kval4 : f32
            }
            scf.yield %cb4_2 : f32
          }
          scf.yield %cb4_4 : f32
        } else {
          %cb0_4 = scf.if %t1 -> (f32) {
            %cb2_2 = scf.if %t0 -> (f32) {
              scf.yield %kval3 : f32
            } else {
              scf.yield %kval2 : f32
            }
            scf.yield %cb2_2 : f32
          } else {
            %cb0_2 = scf.if %t0 -> (f32) {
              scf.yield %kval1 : f32
            } else {
              scf.yield %kval0 : f32
            }
            scf.yield %cb0_2 : f32
          }
          scf.yield %cb0_4 : f32
        }
        scf.yield %cb0_8 : f32
      }
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %whlast : index
      %d_half_v = view.load %wh[%d_idx] : view<[%whn]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %value = scalar.mulf %d, %code : f32
      %kidx_i = scalar.addi %kblk256, %i_i : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %xlast : index
      %xv = view.load %xs[%kidx] : view<[%xn]xf32> -> f32
      %prod = scalar.mulf %value, %xv : f32
  func.return %prod : f32
}

func.def @q5k_step(%wn: index, %whn: index, %xn: index, %wv: view<[%wn]xi8>, %wh: view<[%whn]xf16>, %xs: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c144 = index.constant 176 : index
  %c256 = index.constant 256 : index
  %c1440 = index.constant 1760 : index
  %c2880 = index.constant 3520 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %c48i = scalar.constant 48 : i32
  %c176i = scalar.constant 176 : i32
  %c3520i = scalar.constant 3520 : i32
  %zero = scalar.constant 0.0 : f32
  %wlast = index.sub %wn, %c1 : index
  %whlast = index.sub %whn, %c1 : index
  %xlast = index.sub %xn, %c1 : index
  %row_off = scalar.muli %row_i, %c3520i : i32
  %blk_off0 = scalar.muli %kblk_i, %c176i : i32
  %blk_off = scalar.addi %row_off, %blk_off0 : i32
  %kblk256 = scalar.shli %kblk_i, %c8i : i32
      %gg_i = scalar.shrui %i_i, %c6i : i32
      %wv_i = scalar.andi %i_i, %c63i : i32
      %lane_dec = scalar.andi %wv_i, %c31i : i32
      %wv_hi = scalar.shrui %wv_i, %c5i : i32
      %is_low = scalar.cmpi slt, %wv_i, %c32i : i32

      %qs0 = scalar.addi %blk_off, %c48i : i32
      %gg32 = scalar.shli %gg_i, %c5i : i32
      %qs1 = scalar.addi %qs0, %gg32 : i32
      %qs2 = scalar.addi %qs1, %lane_dec : i32
      %qs_ix = index.cast %qs2 : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %wlast : index
      %qb8 = view.load %wv[%qs_idx] : view<[%wn]xi8> -> i8
      %qb = scalar.extui %qb8 : i8 to i32
      %qb_lo = scalar.andi %qb, %c15i : i32
      %qb_hi = scalar.shrui %qb, %c4i : i32
      %quant4 = scf.if %is_low -> (i32) {
        scf.yield %qb_lo : i32
      } else {
        scf.yield %qb_hi : i32
      }
      %gg2 = scalar.shli %gg_i, %c1i : i32
      %sis = scalar.addi %gg2, %wv_hi : i32
      %sis_low = scalar.cmpi slt, %sis, %c4i : i32
      %qh0 = scalar.addi %blk_off, %c16i : i32
      %qh_i = scalar.addi %qh0, %lane_dec : i32
      %qh_ix = index.cast %qh_i : i32 to index
      %qh_lo = index.max %qh_ix, %c0 : index
      %qh_idx = index.min %qh_lo, %wlast : index
      %qh8 = view.load %wv[%qh_idx] : view<[%wn]xi8> -> i8
      %qh = scalar.extui %qh8 : i8 to i32
      %qhv = scalar.shrui %qh, %sis : i32
      %qbit = scalar.andi %qhv, %c1i : i32
      %qhigh = scalar.muli %qbit, %c16i : i32
      %quant = scalar.addi %quant4, %qhigh : i32
      %la0 = scalar.addi %blk_off, %c4i : i32
      %la_i = scalar.addi %la0, %sis : i32
      %lb_i = scalar.addi %la_i, %c4i : i32
      %lc_i = scalar.addi %blk_off, %sis : i32
      %la_ix = index.cast %la_i : i32 to index
      %la_lo = index.max %la_ix, %c0 : index
      %la_idx = index.min %la_lo, %wlast : index
      %lb_ix = index.cast %lb_i : i32 to index
      %lb_lo = index.max %lb_ix, %c0 : index
      %lb_idx = index.min %lb_lo, %wlast : index
      %lc_ix = index.cast %lc_i : i32 to index
      %lc_lo = index.max %lc_ix, %c0 : index
      %lc_idx = index.min %lc_lo, %wlast : index
      %la8 = view.load %wv[%la_idx] : view<[%wn]xi8> -> i8
      %lb8 = view.load %wv[%lb_idx] : view<[%wn]xi8> -> i8
      %lc8 = view.load %wv[%lc_idx] : view<[%wn]xi8> -> i8
      %la = scalar.extui %la8 : i8 to i32
      %lb = scalar.extui %lb8 : i8 to i32
      %lc = scalar.extui %lc8 : i8 to i32
      %sc, %smin = scf.if %sis_low -> (i32, i32) {
        %s = scalar.andi %la, %c63i : i32
        %mv = scalar.andi %lb, %c63i : i32
        scf.yield %s, %mv : i32, i32
      } else {
        %lb_lo = scalar.andi %lb, %c15i : i32
        %lc_hi = scalar.shrui %lc, %c6i : i32
        %lc_hi4 = scalar.shli %lc_hi, %c4i : i32
        %s2 = scalar.ori %lb_lo, %lc_hi4 : i32
        %lb_hi = scalar.shrui %lb, %c4i : i32
        %la_hi = scalar.shrui %la, %c6i : i32
        %la_hi4 = scalar.shli %la_hi, %c4i : i32
        %m2 = scalar.ori %lb_hi, %la_hi4 : i32
        scf.yield %s2, %m2 : i32, i32
      }
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %whlast : index
      %dmin0 = scalar.addi %blk_half0, %c1i : i32
      %dmin_ix = index.cast %dmin0 : i32 to index
      %dmin_lo = index.max %dmin_ix, %c0 : index
      %dmin_idx = index.min %dmin_lo, %whlast : index
      %d_half_v = view.load %wh[%d_idx] : view<[%whn]xf16> -> f16
      %dmin_half_v = view.load %wh[%dmin_idx] : view<[%whn]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dmin = scalar.extf %dmin_half_v : f16 to f32
      %sc_f = scalar.sitofp %sc : i32 to f32
      %m_f = scalar.sitofp %smin : i32 to f32
      %q_f = scalar.sitofp %quant : i32 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %scaled = scalar.mulf %dsc, %q_f : f32
      %dm = scalar.mulf %dmin, %m_f : f32
      %value = scalar.subf %scaled, %dm : f32
      %kidx_i = scalar.addi %kblk256, %i_i : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %xlast : index
      %xv = view.load %xs[%kidx] : view<[%xn]xf32> -> f32
      %prod = scalar.mulf %value, %xv : f32
  func.return %prod : f32
}

func.def @q6k_step(%wn: index, %whn: index, %xn: index, %wv: view<[%wn]xi8>, %wh: view<[%whn]xf16>, %xs: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c144 = index.constant 210 : index
  %c256 = index.constant 256 : index
  %c1440 = index.constant 2100 : index
  %c2880 = index.constant 4200 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %c210i = scalar.constant 210 : i32
  %c4200i = scalar.constant 4200 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c104i = scalar.constant 104 : i32
  %c128i = scalar.constant 128 : i32
  %c192i = scalar.constant 192 : i32
  %zero = scalar.constant 0.0 : f32
  %wlast = index.sub %wn, %c1 : index
  %whlast = index.sub %whn, %c1 : index
  %xlast = index.sub %xn, %c1 : index
  %row_off = scalar.muli %row_i, %c4200i : i32
  %blk_off0 = scalar.muli %kblk_i, %c210i : i32
  %blk_off = scalar.addi %row_off, %blk_off0 : i32
  %kblk256 = scalar.shli %kblk_i, %c8i : i32
      %group = scalar.shrui %i_i, %c5i : i32
      %half = scalar.shrui %group, %c2i : i32
      %segment = scalar.andi %group, %c3i : i32
      %h16b = scalar.andi %i_i, %c16i : i32
      %h16 = scalar.shrui %h16b, %c4i : i32
      %jj = scalar.andi %i_i, %c15i : i32
      %seg_ge2 = scalar.cmpi sge, %segment, %c2i : i32
      %ql_shift = scf.if %seg_ge2 -> (i32) {
        scf.yield %c4i : i32
      } else {
        scf.yield %c0i : i32
      }
      %qh_shift = scalar.shli %segment, %c1i : i32
      %sego = scalar.andi %segment, %c1i : i32
      %half64 = scalar.shli %half, %c6i : i32
      %sego32 = scalar.shli %sego, %c5i : i32
      %ql_base = scalar.addi %half64, %sego32 : i32
      %ql1 = scalar.addi %blk_off, %ql_base : i32
      %ql2 = scalar.addi %ql1, %h16b : i32
      %ql_i = scalar.addi %ql2, %jj : i32
      %ql_ix = index.cast %ql_i : i32 to index
      %ql_lo = index.max %ql_ix, %c0 : index
      %ql_idx = index.min %ql_lo, %wlast : index
      %qlb8 = view.load %wv[%ql_idx] : view<[%wn]xi8> -> i8
      %qlb = scalar.extui %qlb8 : i8 to i32
      %low0 = scalar.shrui %qlb, %ql_shift : i32
      %low = scalar.andi %low0, %c15i : i32
      %half32 = scalar.shli %half, %c5i : i32
      %qh0 = scalar.addi %blk_off, %c128i : i32
      %qh1 = scalar.addi %qh0, %half32 : i32
      %qh2 = scalar.addi %qh1, %h16b : i32
      %qh_i = scalar.addi %qh2, %jj : i32
      %qh_ix = index.cast %qh_i : i32 to index
      %qh_lo = index.max %qh_ix, %c0 : index
      %qh_idx = index.min %qh_lo, %wlast : index
      %qhb8 = view.load %wv[%qh_idx] : view<[%wn]xi8> -> i8
      %qhb = scalar.extui %qhb8 : i8 to i32
      %high0 = scalar.shrui %qhb, %qh_shift : i32
      %high = scalar.andi %high0, %c3i : i32
      %high4 = scalar.shli %high, %c4i : i32
      %code = scalar.ori %low, %high4 : i32
      %bias = scalar.subi %code, %c32i : i32
      %bias_f = scalar.sitofp %bias : i32 to f32
      %half8 = scalar.shli %half, %c3i : i32
      %seg2 = scalar.shli %segment, %c1i : i32
      %sc0 = scalar.addi %blk_off, %c192i : i32
      %sc1 = scalar.addi %sc0, %half8 : i32
      %sc2 = scalar.addi %sc1, %seg2 : i32
      %sc_i32 = scalar.addi %sc2, %h16 : i32
      %sc_ix = index.cast %sc_i32 : i32 to index
      %sc_lo = index.max %sc_ix, %c0 : index
      %sc_idx = index.min %sc_lo, %wlast : index
      %sc8 = view.load %wv[%sc_idx] : view<[%wn]xi8> -> i8
      %sc_f = scalar.sitofp %sc8 : i8 to f32
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_i = scalar.addi %blk_half0, %c104i : i32
      %d_ix = index.cast %d_i : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %whlast : index
      %d_half_v = view.load %wh[%d_idx] : view<[%whn]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %value = scalar.mulf %dsc, %bias_f : f32
      %kidx_i = scalar.addi %kblk256, %i_i : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %xlast : index
      %xv = view.load %xs[%kidx] : view<[%xn]xf32> -> f32
      %prod = scalar.mulf %value, %xv : f32
  func.return %prod : f32
}

func.def @q8_0_step(%wn: index, %whn: index, %xn: index, %wv: view<[%wn]xi8>, %wh: view<[%whn]xf16>, %xs: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c5i = scalar.constant 5 : i32
  %c8i = scalar.constant 8 : i32
  %c31i = scalar.constant 31 : i32
  %c34i = scalar.constant 34 : i32
  %c272i = scalar.constant 272 : i32
  %c5440i = scalar.constant 5440 : i32
  %wlast = index.sub %wn, %c1 : index
  %whlast = index.sub %whn, %c1 : index
  %xlast = index.sub %xn, %c1 : index
  %row_off = scalar.muli %row_i, %c5440i : i32
  %grp_off = scalar.muli %kblk_i, %c272i : i32
  %base0 = scalar.addi %row_off, %grp_off : i32
  %blk8 = scalar.shrui %i_i, %c5i : i32
  %blkj = scalar.muli %blk8, %c34i : i32
  %blk_off = scalar.addi %base0, %blkj : i32
  %within = scalar.andi %i_i, %c31i : i32
  %qs0 = scalar.addi %blk_off, %c2i : i32
  %qs_i = scalar.addi %qs0, %within : i32
  %qs_ix = index.cast %qs_i : i32 to index
  %qs_lo = index.max %qs_ix, %c0 : index
  %qs_idx = index.min %qs_lo, %wlast : index
  %qb8 = view.load %wv[%qs_idx] : view<[%wn]xi8> -> i8
  %qb = scalar.extsi %qb8 : i8 to i32
  %q_f = scalar.sitofp %qb : i32 to f32
  %blk_half0 = scalar.shrui %blk_off, %c1i : i32
  %d_ix = index.cast %blk_half0 : i32 to index
  %d_lo = index.max %d_ix, %c0 : index
  %d_idx = index.min %d_lo, %whlast : index
  %d_half_v = view.load %wh[%d_idx] : view<[%whn]xf16> -> f16
  %d = scalar.extf %d_half_v : f16 to f32
  %value = scalar.mulf %d, %q_f : f32
  %kblk256 = scalar.shli %kblk_i, %c8i : i32
  %kidx_i = scalar.addi %kblk256, %i_i : i32
  %kidx_ix = index.cast %kidx_i : i32 to index
  %kidx_lo = index.max %kidx_ix, %c0 : index
  %kidx = index.min %kidx_lo, %xlast : index
  %xv_v = view.load %xs[%kidx] : view<[%xn]xf32> -> f32
  %prod = scalar.mulf %value, %xv_v : f32
  func.return %prod : f32
}


config.decl @yah_qkv_decode.q_dim : %value: index where [range(%value, 1, 65536)]

config.decl @yah_qkv_decode.kv_dim : %value: index where [range(%value, 1, 65536)]

config.decl @yah_qkv_decode.k_groups : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_qkv_decode() {
  %unit = index.constant 1 : index
  %q_dim = config.get @yah_qkv_decode.q_dim : index
  %kv_dim = config.get @yah_qkv_decode.kv_dim : index
  %c2 = index.constant 2 : index
  %c32 = index.constant 32 : index
  %kv2 = index.mul %kv_dim, %c2 : index
  %total = index.add %q_dim, %kv2 : index
  kernel.launch.config workgroups(%total, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%q_w: buffer, %k_w: buffer, %v_w: buffer, %x: buffer, %q_out: buffer, %k_out: buffer, %v_out: buffer, %q_type: i32, %k_type: i32, %v_type: i32) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2i = index.constant 2 : index
  %c4200 = index.constant 4200 : index
  %c2100 = index.constant 2100 : index
  %c5440 = index.constant 5440 : index
  %c2720 = index.constant 2720 : index
  %c256 = index.constant 256 : index
  %c8 = index.constant 8 : index
  %c0i = scalar.constant 0 : i32
  %c8i = scalar.constant 8 : i32
  %c5i = scalar.constant 5 : i32
  %zero = scalar.constant 0.0 : f32
  %id_q4k = scalar.constant 1 : i32
  %id_iq4xs = scalar.constant 2 : i32
  %id_iq4nl = scalar.constant 3 : i32
  %id_q5k = scalar.constant 4 : i32
  %id_q6k = scalar.constant 5 : i32
  %id_q8_0 = scalar.constant 6 : i32
  %q_dim = config.get @yah_qkv_decode.q_dim : index
  %kv_dim = config.get @yah_qkv_decode.kv_dim : index
  %k_groups = config.get @yah_qkv_decode.k_groups : index
  %q_wn = index.mul %q_dim, %c4200 : index
  %q_whn = index.mul %q_dim, %c2100 : index
  %kv_wn = index.mul %kv_dim, %c5440 : index
  %kv_whn = index.mul %kv_dim, %c2720 : index
  %x_elems = index.mul %k_groups, %c256 : index
  %q_na, %k_na, %v_na, %x_na, %qo_na, %ko_na, %vo_na = buffer.assume.noalias %q_w, %k_w, %v_w, %x, %q_out, %k_out, %v_out : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %qw = buffer.view %q_na[%base] : buffer -> view<[%q_wn]xi8>
  %qwh = buffer.view %q_na[%base] : buffer -> view<[%q_whn]xf16>
  %kw = buffer.view %k_na[%base] : buffer -> view<[%kv_wn]xi8>
  %kwh = buffer.view %k_na[%base] : buffer -> view<[%kv_whn]xf16>
  %vw = buffer.view %v_na[%base] : buffer -> view<[%kv_wn]xi8>
  %vwh = buffer.view %v_na[%base] : buffer -> view<[%kv_whn]xf16>
  %xv = buffer.view %x_na[%base] : buffer -> view<[%x_elems]xf32>
  %qo = buffer.view %qo_na[%base] : buffer -> view<[%q_dim]xf32>
  %ko = buffer.view %ko_na[%base] : buffer -> view<[%kv_dim]xf32>
  %vo = buffer.view %vo_na[%base] : buffer -> view<[%kv_dim]xf32>
  %m = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %qk = index.add %q_dim, %kv_dim : index
  %is_q = index.cmp ult, %m, %q_dim : index
  %is_k = index.cmp ult, %m, %qk : index
  %row_k = index.sub %m, %q_dim : index
  %row_v = index.sub %m, %qk : index
  %q_sink = scf.if %is_q -> (f32) {
  %is_q_q4k = scalar.cmpi eq, %q_type, %id_q4k : i32
  %is_q_iq4xs = scalar.cmpi eq, %q_type, %id_iq4xs : i32
  %is_q_iq4nl = scalar.cmpi eq, %q_type, %id_iq4nl : i32
  %is_q_q6k = scalar.cmpi eq, %q_type, %id_q6k : i32
  %row_i_q = index.cast %m : index to i32
  %acc_q = scf.for %kblk_q = [%c0 to %k_groups step %c1](%a0_q = %zero : f32) -> (f32) {
    %kblk_i_q = index.cast %kblk_q : index to i32
    %acc1_q = scf.for %j_q = [%c0 to %c8 step %c1](%a1_q = %a0_q : f32) -> (f32) {
      %j_i_q = index.cast %j_q : index to i32
      %j32_q = scalar.shli %j_i_q, %c5i : i32
      %i_i_q = scalar.addi %lane_i, %j32_q : i32
      %d = scf.if %is_q_q4k -> (f32) {
        %r = func.call @q4k_step(%q_wn, %q_whn, %x_elems, %qw, %qwh, %xv, %row_i_q, %kblk_i_q, %i_i_q) : (index, index, index, view<[%q_wn]xi8>, view<[%q_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
        scf.yield %r : f32
      } else {
        %dn = scf.if %is_q_iq4xs -> (f32) {
          %r = func.call @iq4xs_step(%q_wn, %q_whn, %x_elems, %qw, %qwh, %xv, %row_i_q, %kblk_i_q, %i_i_q) : (index, index, index, view<[%q_wn]xi8>, view<[%q_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
          scf.yield %r : f32
        } else {
          %dn = scf.if %is_q_iq4nl -> (f32) {
            %r = func.call @iq4nl_step(%q_wn, %q_whn, %x_elems, %qw, %qwh, %xv, %row_i_q, %kblk_i_q, %i_i_q) : (index, index, index, view<[%q_wn]xi8>, view<[%q_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
            scf.yield %r : f32
          } else {
            %r = func.call @q6k_step(%q_wn, %q_whn, %x_elems, %qw, %qwh, %xv, %row_i_q, %kblk_i_q, %i_i_q) : (index, index, index, view<[%q_wn]xi8>, view<[%q_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
            scf.yield %r : f32
          }
          scf.yield %dn : f32
        }
        scf.yield %dn : f32
      }
      %next_q = scalar.addf %a1_q, %d : f32
      scf.yield %next_q : f32
    }
    scf.yield %acc1_q : f32
  }
  %sum_q = kernel.subgroup.reduce<addf> %acc_q : f32
  %is_zero_q = index.cmp eq, %lane, %c0 : index
  %st_q = scf.if %is_zero_q -> (f32) {
    view.store %sum_q, %qo[%m] : f32, view<[%q_dim]xf32>
    scf.yield %zero : f32
  } else {
    scf.yield %zero : f32
  }
    scf.yield %zero : f32
  } else {
    %k_sink = scf.if %is_k -> (f32) {
    %is_k_q4k = scalar.cmpi eq, %k_type, %id_q4k : i32
    %is_k_q5k = scalar.cmpi eq, %k_type, %id_q5k : i32
    %is_k_q6k = scalar.cmpi eq, %k_type, %id_q6k : i32
    %is_k_q8_0 = scalar.cmpi eq, %k_type, %id_q8_0 : i32
    %row_i_k = index.cast %row_k : index to i32
    %acc_k = scf.for %kblk_k = [%c0 to %k_groups step %c1](%a0_k = %zero : f32) -> (f32) {
      %kblk_i_k = index.cast %kblk_k : index to i32
      %acc1_k = scf.for %j_k = [%c0 to %c8 step %c1](%a1_k = %a0_k : f32) -> (f32) {
        %j_i_k = index.cast %j_k : index to i32
        %j32_k = scalar.shli %j_i_k, %c5i : i32
        %i_i_k = scalar.addi %lane_i, %j32_k : i32
        %d = scf.if %is_k_q4k -> (f32) {
          %r = func.call @q4k_step(%kv_wn, %kv_whn, %x_elems, %kw, %kwh, %xv, %row_i_k, %kblk_i_k, %i_i_k) : (index, index, index, view<[%kv_wn]xi8>, view<[%kv_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
          scf.yield %r : f32
        } else {
          %dn = scf.if %is_k_q5k -> (f32) {
            %r = func.call @q5k_step(%kv_wn, %kv_whn, %x_elems, %kw, %kwh, %xv, %row_i_k, %kblk_i_k, %i_i_k) : (index, index, index, view<[%kv_wn]xi8>, view<[%kv_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
            scf.yield %r : f32
          } else {
            %dn = scf.if %is_k_q6k -> (f32) {
              %r = func.call @q6k_step(%kv_wn, %kv_whn, %x_elems, %kw, %kwh, %xv, %row_i_k, %kblk_i_k, %i_i_k) : (index, index, index, view<[%kv_wn]xi8>, view<[%kv_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
              scf.yield %r : f32
            } else {
              %r = func.call @q8_0_step(%kv_wn, %kv_whn, %x_elems, %kw, %kwh, %xv, %row_i_k, %kblk_i_k, %i_i_k) : (index, index, index, view<[%kv_wn]xi8>, view<[%kv_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
              scf.yield %r : f32
            }
            scf.yield %dn : f32
          }
          scf.yield %dn : f32
        }
        %next_k = scalar.addf %a1_k, %d : f32
        scf.yield %next_k : f32
      }
      scf.yield %acc1_k : f32
    }
    %sum_k = kernel.subgroup.reduce<addf> %acc_k : f32
    %is_zero_k = index.cmp eq, %lane, %c0 : index
    %st_k = scf.if %is_zero_k -> (f32) {
      view.store %sum_k, %ko[%row_k] : f32, view<[%kv_dim]xf32>
      scf.yield %zero : f32
    } else {
      scf.yield %zero : f32
    }
      scf.yield %zero : f32
    } else {
      %is_v_q4k = scalar.cmpi eq, %v_type, %id_q4k : i32
      %is_v_q5k = scalar.cmpi eq, %v_type, %id_q5k : i32
      %is_v_q6k = scalar.cmpi eq, %v_type, %id_q6k : i32
      %is_v_q8_0 = scalar.cmpi eq, %v_type, %id_q8_0 : i32
      %row_i_v = index.cast %row_v : index to i32
      %acc_v = scf.for %kblk_v = [%c0 to %k_groups step %c1](%a0_v = %zero : f32) -> (f32) {
        %kblk_i_v = index.cast %kblk_v : index to i32
        %acc1_v = scf.for %j_v = [%c0 to %c8 step %c1](%a1_v = %a0_v : f32) -> (f32) {
          %j_i_v = index.cast %j_v : index to i32
          %j32_v = scalar.shli %j_i_v, %c5i : i32
          %i_i_v = scalar.addi %lane_i, %j32_v : i32
          %d = scf.if %is_v_q4k -> (f32) {
            %r = func.call @q4k_step(%kv_wn, %kv_whn, %x_elems, %vw, %vwh, %xv, %row_i_v, %kblk_i_v, %i_i_v) : (index, index, index, view<[%kv_wn]xi8>, view<[%kv_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
            scf.yield %r : f32
          } else {
            %dn = scf.if %is_v_q5k -> (f32) {
              %r = func.call @q5k_step(%kv_wn, %kv_whn, %x_elems, %vw, %vwh, %xv, %row_i_v, %kblk_i_v, %i_i_v) : (index, index, index, view<[%kv_wn]xi8>, view<[%kv_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
              scf.yield %r : f32
            } else {
              %dn = scf.if %is_v_q6k -> (f32) {
                %r = func.call @q6k_step(%kv_wn, %kv_whn, %x_elems, %vw, %vwh, %xv, %row_i_v, %kblk_i_v, %i_i_v) : (index, index, index, view<[%kv_wn]xi8>, view<[%kv_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
                scf.yield %r : f32
              } else {
                %r = func.call @q8_0_step(%kv_wn, %kv_whn, %x_elems, %vw, %vwh, %xv, %row_i_v, %kblk_i_v, %i_i_v) : (index, index, index, view<[%kv_wn]xi8>, view<[%kv_whn]xf16>, view<[%x_elems]xf32>, i32, i32, i32) -> (f32)
                scf.yield %r : f32
              }
              scf.yield %dn : f32
            }
            scf.yield %dn : f32
          }
          %next_v = scalar.addf %a1_v, %d : f32
          scf.yield %next_v : f32
        }
        scf.yield %acc1_v : f32
      }
      %sum_v = kernel.subgroup.reduce<addf> %acc_v : f32
      %is_zero_v = index.cmp eq, %lane, %c0 : index
      %st_v = scf.if %is_zero_v -> (f32) {
        view.store %sum_v, %vo[%row_v] : f32, view<[%kv_dim]xf32>
        scf.yield %zero : f32
      } else {
        scf.yield %zero : f32
      }
      scf.yield %zero : f32
    }
    scf.yield %k_sink : f32
  }
  kernel.return
}

// q=iq4xs k=q5k v=q6k; all three bands share the same sparse x.
check.case public @yah_qkv_decode_case_a {
  %q_w = check.file.read.npy path("fixtures/qkv_decode/iq4xs_pad.npy") : tensor<87040xi8>
  %k_w = check.file.read.npy path("fixtures/qkv_decode/q5k_pad.npy") : tensor<87040xi8>
  %v_w = check.file.read.npy path("fixtures/qkv_decode/q6k_pad.npy") : tensor<87040xi8>
  %x = check.file.read.npy path("fixtures/qkv_decode/x.npy") : tensor<5120xf32>
  %q_out = check.generate.fill value(0.0) : tensor<16xf32>
  %k_out = check.generate.fill value(0.0) : tensor<16xf32>
  %v_out = check.generate.fill value(0.0) : tensor<16xf32>
  %eq = check.file.read.npy path("fixtures/qkv_decode/iq4xs_expected.npy") : tensor<16xf32>
  %ek = check.file.read.npy path("fixtures/qkv_decode/q5k_expected.npy") : tensor<16xf32>
  %ev = check.file.read.npy path("fixtures/qkv_decode/q6k_expected.npy") : tensor<16xf32>
  %tq = check.literal value(2) : i32
  %tk = check.literal value(4) : i32
  %tv = check.literal value(5) : i32
  kernel.launch @yah_qkv_decode(%q_w, %k_w, %v_w, %x, %q_out, %k_out, %v_out, %tq, %tk, %tv) : (tensor<87040xi8>, tensor<87040xi8>, tensor<87040xi8>, tensor<5120xf32>, tensor<16xf32>, tensor<16xf32>, tensor<16xf32>, i32, i32, i32)
  check.expect.close actual(%q_out) expected(%eq) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<16xf32>
  check.expect.close actual(%k_out) expected(%ek) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<16xf32>
  check.expect.close actual(%v_out) expected(%ev) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<16xf32>
  check.return
}

check.benchmark<@yah_qkv_decode_case_a> @yah_qkv_decode_case_a_bench

// q=q4k k=q8_0 v=q4k; all three bands share the same sparse x.
