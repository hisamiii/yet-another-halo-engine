// YAH speculative segment weights, Loom port of SpeculativeSegmentWeightsKernel.
//
// HIP source: sample.hip. Second stage of the speculative residual sampler. It folds
// the per-segment maxima into the global maximum, then writes the temperature-scaled,
// min-p-filtered exp weight of every logit and the per-segment sum:
//
//   maximum = max(scratch.maxima[0..2*threads))
//   threshold = min_p > 0 ? maximum + temperature*log(min_p) : -inf
//   weight[i] = finite(v) && v >= threshold ? exp((v-maximum)/temperature) : 0
//   scratch.target_sums[block] = sum of the segment weights
//
// HIP sums the staged segment through a shared `values` array; the port accumulates in
// a register and folds with `kernel.workgroup.reduce<addf>`. The scratch layout is the
// flat `{maxima[segments], target_sums[segments], residual_sums[segments], total}`.
//
// Required config: --config=yah_spec_seg_weights.vocab_size=1024 --config=yah_spec_seg_weights.segments=256
//                  --config=yah_spec_seg_weights.scratch_elems=769
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_spec_seg_weights.vocab_size : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_spec_seg_weights.segments : %value: index where [range(%value, 1, 65536)]

config.decl @yah_spec_seg_weights.scratch_elems : %value: index where [range(%value, 2, 1073741824)]

kernel.def target(@yah_wave32) @yah_spec_seg_weights() {
  %unit = index.constant 1 : index
  %segments = config.get @yah_spec_seg_weights.segments : index
  %c128 = index.constant 128 : index
  kernel.launch.config workgroups(%segments, %unit, %unit) workgroup_size(%c128, %unit, %unit) : index
} launch(%logits: buffer, %weights: buffer, %scratch: buffer, %params: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c128 = index.constant 128 : index
  %limit = scalar.constant 3.4028234663852886e+38 : f32
  %neg_infinite = scalar.constant -3.9999999999999999e+38 : f32
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %flt_min = scalar.constant 1.1754943508222875e-38 : f32
  %vocab_size = config.get @yah_spec_seg_weights.vocab_size : index
  %segments = config.get @yah_spec_seg_weights.segments : index
  %scratch_elems = config.get @yah_spec_seg_weights.scratch_elems : index
  %segments_m1 = index.sub %segments, %c1 : index
  %segments_i = index.cast %segments : index to i32
  %c1i = scalar.constant 1 : i32
  %half_i = scalar.shrui %segments_i, %c1i : i32
  %half = index.cast %half_i : i32 to index
  %logits_na, %weights_na, %scratch_na, %params_na = buffer.assume.noalias %logits, %weights, %scratch, %params : buffer, buffer, buffer, buffer
  %logits_view = buffer.view %logits_na[%base] : buffer -> view<[%vocab_size]xf32>
  %weights_view = buffer.view %weights_na[%base] : buffer -> view<[%vocab_size]xf32>
  %scratch_view = buffer.view %scratch_na[%base] : buffer -> view<[%scratch_elems]xf32>
  %params_view = buffer.view %params_na[%base] : buffer -> view<[%c2]xf32>
  %block_raw = kernel.workgroup.id<x> : index
  %block = index.min %block_raw, %segments_m1 : index
  %tid = kernel.workitem.id<x> : index
  %m0 = view.load %scratch_view[%tid] : view<[%scratch_elems]xf32> -> f32
  %t2_raw = index.add %tid, %half : index
  %t2 = index.min %t2_raw, %segments_m1 : index
  %m1 = view.load %scratch_view[%t2] : view<[%scratch_elems]xf32> -> f32
  %mlocal = scalar.maxnumf %m0, %m1 : f32
  %maximum = kernel.workgroup.reduce<maxnumf> %mlocal : f32
  %temperature = view.load %params_view[%c0] : view<[%c2]xf32> -> f32
  %min_p = view.load %params_view[%c1] : view<[%c2]xf32> -> f32
  %min_p_on = scalar.cmpf ogt, %min_p, %zero : f32
  %threshold = scf.if %min_p_on -> (f32) {
    %lmp = scalar.logf<afn> %min_p : f32
    %tls = scalar.mulf %temperature, %lmp : f32
    %thr = scalar.addf %maximum, %tls : f32
    scf.yield %thr : f32
  } else {
    scf.yield %neg_infinite : f32
  }
  %denom = scalar.maxnumf %temperature, %flt_min : f32
  %inverse_temperature = scalar.divf %one, %denom : f32
  %vb = index.mul %vocab_size, %block : index
  %begin = index.div %vb, %segments : index
  %bp1 = index.add %block, %c1 : index
  %vb1 = index.mul %vocab_size, %bp1 : index
  %end = index.div %vb1, %segments : index
  %start = index.add %begin, %tid : index
  %local_sum = scf.for %i = [%start to %end step %c128](%acc = %zero : f32) -> (f32) {
    %v = view.load %logits_view[%i] : view<[%vocab_size]xf32> -> f32
    %mag = scalar.absf %v : f32
    %finite = scalar.cmpf ole, %mag, %limit : f32
    %ge = scalar.cmpf oge, %v, %threshold : f32
    %w = scf.if %finite -> (f32) {
      %g = scf.if %ge -> (f32) {
        %diff = scalar.subf %v, %maximum : f32
        %scaled = scalar.mulf %diff, %inverse_temperature : f32
        %e = scalar.expf<afn> %scaled : f32
        scf.yield %e : f32
      } else {
        scf.yield %zero : f32
      }
      scf.yield %g : f32
    } else {
      scf.yield %zero : f32
    }
    view.store %w, %weights_view[%i] : f32, view<[%vocab_size]xf32>
    %n = scalar.addf %acc, %w : f32
    scf.yield %n : f32
  }
  %total = kernel.workgroup.reduce<addf> %local_sum : f32
  %leader = index.cmp eq, %tid, %c0 : index
  scf.if %leader {
    %slot = index.add %segments, %block : index
    view.store %total, %scratch_view[%slot] : f32, view<[%scratch_elems]xf32>
  }
  kernel.return
}

// Requires --config=yah_spec_seg_weights.vocab_size=1024, .segments=256, .scratch_elems=769.
// maxima = 0, logits = 0, temperature = 1, min_p = 0: every weight is exp(0) = 1 and
// every segment of 4 sums to 4. The scratch maxima region is untouched; the
// target_sums region is inspected through a byte-offset view.
check.case public @yah_spec_seg_weights_case {
  %logits = check.generate.fill value(0.0) : tensor<1024xf32>
  %weights = check.generate.fill value(0.0) : tensor<1024xf32>
  %scratch = check.generate.fill value(0.0) : tensor<769xf32>
  %params = check.file.read.npy path("fixtures/spec_seg_weights/params.npy") : tensor<2xf32>
  %expected_weights = check.generate.fill value(1.0) : tensor<1024xf32>
  %expected_sums = check.generate.fill value(4.0) : tensor<256xf32>
  kernel.launch @yah_spec_seg_weights(%logits, %weights, %scratch, %params) : (tensor<1024xf32>, tensor<1024xf32>, tensor<769xf32>, tensor<2xf32>)
  check.expect.close actual(%weights) expected(%expected_weights) atol(0.0) rtol(0.0) nan(same) : tensor<1024xf32>
  %sums = check.tensor.view %scratch offset(1024) : tensor<769xf32> -> tensor<256xf32>
  check.expect.close actual(%sums) expected(%expected_sums) atol(0.0) rtol(0.0) nan(same) : tensor<256xf32>
  check.return
}

check.benchmark<@yah_spec_seg_weights_case> @yah_spec_seg_weights_bench
