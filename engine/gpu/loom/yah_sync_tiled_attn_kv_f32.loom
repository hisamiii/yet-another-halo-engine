// YAH tiled-attention KV prefix sync, Loom port of SyncTiledAttentionKvPrefixKernel.
//
// HIP source: models/qwen/hip/kernels/attention_tile.hip. Copies the already-written
// f32 KV prefix into the fp16 cache in the layout WMMA attention reads:
//
//   pos = blockIdx.y; index = blockIdx.x*blockDim.x + tid
//   kv_width = num_kv_heads*head_dim
//   kv_head = index/head_dim; dimension = index%head_dim
//   f32 = ((layer*num_kv_heads + kv_head)*max_context + pos)*head_dim + dimension
//   f16 = ((layer*max_context + pos)*kv_width) + index
//   k_cache_f16[f16] = __float2half_rn(k_cache[f32])   (same for v)
//
// The f32 cache is head-major and the f16 cache is position-major, so this is a
// real permutation between the two offsets, which is what the check exercises.
// `__float2half_rn` is `scalar.fptrunc`.
//
// Required config: --config=yah_sync_tiled_attn_kv.layer_idx=0 --config=yah_sync_tiled_attn_kv.prefix_length=2
//                  --config=yah_sync_tiled_attn_kv.max_context=4 --config=yah_sync_tiled_attn_kv.num_kv_heads=2
//                  --config=yah_sync_tiled_attn_kv.head_dim=8 --config=yah_sync_tiled_attn_kv.k_f32_elems=64
//                  --config=yah_sync_tiled_attn_kv.kv_f16_elems=32
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_sync_tiled_attn_kv.layer_idx : %value: index where [range(%value, 0, 65536)]

config.decl @yah_sync_tiled_attn_kv.prefix_length : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_sync_tiled_attn_kv.max_context : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_sync_tiled_attn_kv.num_kv_heads : %value: index where [range(%value, 1, 65536)]

config.decl @yah_sync_tiled_attn_kv.head_dim : %value: index where [range(%value, 1, 65536)]

config.decl @yah_sync_tiled_attn_kv.k_f32_elems : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_sync_tiled_attn_kv.kv_f16_elems : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@yah_wave32) @yah_sync_tiled_attn_kv() {
  %unit = index.constant 1 : index
  %num_kv_heads = config.get @yah_sync_tiled_attn_kv.num_kv_heads : index
  %head_dim = config.get @yah_sync_tiled_attn_kv.head_dim : index
  %prefix_length = config.get @yah_sync_tiled_attn_kv.prefix_length : index
  %kv_width = index.mul %num_kv_heads, %head_dim : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %kv_width, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %prefix_length, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%k_cache: buffer, %v_cache: buffer, %k_cache_f16: buffer, %v_cache_f16: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %layer_idx = config.get @yah_sync_tiled_attn_kv.layer_idx : index
  %prefix_length = config.get @yah_sync_tiled_attn_kv.prefix_length : index
  %max_context = config.get @yah_sync_tiled_attn_kv.max_context : index
  %num_kv_heads = config.get @yah_sync_tiled_attn_kv.num_kv_heads : index
  %head_dim = config.get @yah_sync_tiled_attn_kv.head_dim : index
  %k_f32_elems = config.get @yah_sync_tiled_attn_kv.k_f32_elems : index
  %kv_f16_elems = config.get @yah_sync_tiled_attn_kv.kv_f16_elems : index
  %kv_width = index.mul %num_kv_heads, %head_dim : index
  %prefix_m1 = index.sub %prefix_length, %c1 : index
  %kv_width_m1 = index.sub %kv_width, %c1 : index
  %k_na, %v_na, %k16_na, %v16_na = buffer.assume.noalias %k_cache, %v_cache, %k_cache_f16, %v_cache_f16 : buffer, buffer, buffer, buffer
  %k_view = buffer.view %k_na[%base] : buffer -> view<[%k_f32_elems]xf32>
  %v_view = buffer.view %v_na[%base] : buffer -> view<[%k_f32_elems]xf32>
  %k16_view = buffer.view %k16_na[%base] : buffer -> view<[%kv_f16_elems]xf16>
  %v16_view = buffer.view %v16_na[%base] : buffer -> view<[%kv_f16_elems]xf16>
  %pos_raw = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %wg = kernel.workgroup.id<x> : index
  %wg256 = index.mul %wg, %c256 : index
  %index_raw = index.add %wg256, %lane : index
  %pos = index.min %pos_raw, %prefix_m1 : index
  %index = index.min %index_raw, %kv_width_m1 : index
  %kv_head = index.div %index, %head_dim : index
  %dimension = index.rem %index, %head_dim : index
  %hn = index.mul %layer_idx, %num_kv_heads : index
  %hnh = index.add %hn, %kv_head : index
  %hnhm = index.mul %hnh, %max_context : index
  %hnhm_p = index.add %hnhm, %pos : index
  %f32_off_pre = index.mul %hnhm_p, %head_dim : index
  %f32_off = index.add %f32_off_pre, %dimension : index
  %lm = index.mul %layer_idx, %max_context : index
  %lm_p = index.add %lm, %pos : index
  %f16_off_pre = index.mul %lm_p, %kv_width : index
  %f16_off = index.add %f16_off_pre, %index : index
  %kc = view.load %k_view[%f32_off] : view<[%k_f32_elems]xf32> -> f32
  %vc = view.load %v_view[%f32_off] : view<[%k_f32_elems]xf32> -> f32
  %kc16 = scalar.fptrunc %kc : f32 to f16
  %vc16 = scalar.fptrunc %vc : f32 to f16
  view.store %kc16, %k16_view[%f16_off] : f16, view<[%kv_f16_elems]xf16>
  view.store %vc16, %v16_view[%f16_off] : f16, view<[%kv_f16_elems]xf16>
  kernel.return
}

// Requires the config above. layer 0, two prefix positions, two KV heads of 8 dims:
// the f32 cache is iota 0..63 and the f16 cache is its head-major -> position-major
// permutation, held as a float16 fixture. All values are integers below 64, so rn
// fp16 is exact.
check.case public @yah_sync_tiled_attn_kv_case {
  %k = check.generate.iota offset(0.0) step(1.0) : tensor<64xf32>
  %v = check.generate.iota offset(0.0) step(1.0) : tensor<64xf32>
  %k16 = check.generate.fill value(0.0) : tensor<32xf16>
  %v16 = check.generate.fill value(0.0) : tensor<32xf16>
  %expected_k = check.file.read.npy path("fixtures/sync_tiled_attn_kv/k16.npy") : tensor<32xf16>
  %expected_v = check.file.read.npy path("fixtures/sync_tiled_attn_kv/v16.npy") : tensor<32xf16>
  kernel.launch @yah_sync_tiled_attn_kv(%k, %v, %k16, %v16) : (tensor<64xf32>, tensor<64xf32>, tensor<32xf16>, tensor<32xf16>)
  check.expect.close actual(%k16) expected(%expected_k) atol(0.0) rtol(0.0) nan(same) : tensor<32xf16>
  check.expect.close actual(%v16) expected(%expected_v) atol(0.0) rtol(0.0) nan(same) : tensor<32xf16>
  check.return
}

check.benchmark<@yah_sync_tiled_attn_kv_case> @yah_sync_tiled_attn_kv_bench
