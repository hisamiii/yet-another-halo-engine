// Probe: physical per-lane register layout of vector.fragment.load<lhs> for a
// 16x16 f16 matrix fragment on amdgpu gfx11 (wave32).
//
// Input  : tensor<16x16xf16>, element (row, col) = row*16 + col (iota).
// Kernel : %lhs = vector.fragment.load<lhs> <view<16x16xf16>>[0,0]
//                 shape [16,16] -> vector<16xf16>
//          then vector.store %lhs to lane L of a tensor<32x16xf16> so that
//          out[L][e] = the value the fragment load placed at physical
//          lane-local element e of lane L.
//
// out[L][e] = row*16+col identifies the logical (row, col) at lane L element e.
//
// Run: bash engine/gpu/loom/loom_run.sh engine/gpu/loom/probe_fragment_layout.loom \
//        @probe_fragment_lhs_global_case -
amdgpu.target<gfx1151> @probe_wave32 {subgroup_size = 32}

kernel.def target(@probe_wave32) @probe_fragment_lhs_global() {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %m = index.constant 16 : index
  %k = index.constant 16 : index
  %lane = kernel.workitem.id<x> : index

  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %in_view = buffer.view %input_noalias[%base] : buffer -> view<16x16xf16>
  %out_view = buffer.view %output_noalias[%base] : buffer -> view<32x16xf16>

  %lhs = vector.fragment.load<lhs> %in_view[%c0, %c0] shape [%m, %k] : view<16x16xf16> -> vector<16xf16>
  vector.store %lhs, %out_view[%lane, %c0] : vector<16xf16>, view<32x16xf16>
  kernel.return
}

check.case public @probe_fragment_lhs_global_case {
  %input = check.generate.iota offset(0.0) step(1.0) : tensor<16x16xf16>
  %output = check.generate.fill value(0.0) : tensor<32x16xf16>
  kernel.launch @probe_fragment_lhs_global(%input, %output) : (tensor<16x16xf16>, tensor<32x16xf16>)
  check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<32x16xf16>
  check.file.write.npy value(%output) path("probe_fragment_lhs_global.npy") mode(always) : tensor<32x16xf16>
  check.return
}

check.benchmark<@probe_fragment_lhs_global_case> @probe_fragment_lhs_global_bench
