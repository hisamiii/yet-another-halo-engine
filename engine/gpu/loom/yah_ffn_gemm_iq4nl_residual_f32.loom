// YAH FFN GEMM with in-kernel IQ4_NL decode and the residual epilogue, Loom port
// of HalfPrefillGemmKernel<..., kIQ4_NL, kResidual>.
//
// HIP source: prefill_fp16.hip. Identical to yah_ffn_gemm_iq4nl_f32 except for the
// epilogue, which adds the accumulator into the existing f32 residual rows in
// place:
//
//   y[token*m + row] += iq4nl_decode(W, row, k) * f16(A[token][k])
//
// This is the down-projection arm (LaunchBatchedQuantGEMMResidualFp16). 1 FFN
// down block(s) in the shard use this format. The decoder, the K loop, the operand
// list and the two global staging buffers are unchanged from the store arm.
//
// Measured: 15.61 ms at m_tiles=1088 (production 17408 rows), against the HIP
// Q4_K kernel at 1.197 ms and the Q4_K port at 23.31 ms. 0.641 ms at m_tiles=1.
// The decoder, K loop and staging are identical to yah_ffn_gemm_iq4nl_f32; only
// the store epilogue changes.
//
// Correctness case: the same packed fixture and unit activation as the store arm,
// with the output initialised to 1000, so the expected value is 1000 + row sum.
// The production-size case uses an all-zero weight, which decodes to zero and
// leaves the residual buffer unchanged.
//
// Required config (correctness): --config=yah_ffn_gemm_iq4nl_residual.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_iq4nl_residual.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_iq4nl_residual.m_tiles : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_iq4nl_residual.k_blocks : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_iq4nl_residual.token_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_iq4nl_residual() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_iq4nl_residual.m_tiles : index
  %token_tiles = config.get @yah_ffn_gemm_iq4nl_residual.token_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %token_tiles, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %input: buffer, %wstage: buffer, %ostage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c5120 = index.constant 5120 : index
  %c23040 = index.constant 23040 : index
  %c46080 = index.constant 46080 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c18i = scalar.constant 18 : i32
  %c31i = scalar.constant 31 : i32
  %c63i = scalar.constant 63 : i32
  %c255i = scalar.constant 255 : i32
  %c2880i = scalar.constant 2880 : i32
  %kval0 = scalar.constant -127.0 : f32
  %kval1 = scalar.constant -104.0 : f32
  %kval2 = scalar.constant -83.0 : f32
  %kval3 = scalar.constant -65.0 : f32
  %kval4 = scalar.constant -49.0 : f32
  %kval5 = scalar.constant -35.0 : f32
  %kval6 = scalar.constant -22.0 : f32
  %kval7 = scalar.constant -10.0 : f32
  %kval8 = scalar.constant 1.0 : f32
  %kval9 = scalar.constant 13.0 : f32
  %kval10 = scalar.constant 25.0 : f32
  %kval11 = scalar.constant 38.0 : f32
  %kval12 = scalar.constant 53.0 : f32
  %kval13 = scalar.constant 69.0 : f32
  %kval14 = scalar.constant 89.0 : f32
  %kval15 = scalar.constant 113.0 : f32
  %m_tiles = config.get @yah_ffn_gemm_iq4nl_residual.m_tiles : index
  %k_blocks = config.get @yah_ffn_gemm_iq4nl_residual.k_blocks : index
  %token_tiles = config.get @yah_ffn_gemm_iq4nl_residual.token_tiles : index
  %cbb = index.constant 18 : index
  %cbb2 = index.constant 9 : index
  %ktot = index.mul %k_blocks, %c32 : index
  %tokens = index.mul %token_tiles, %c64 : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %bpr = index.mul %k_blocks, %cbb : index
  %hpr = index.mul %k_blocks, %cbb2 : index
  %w_bytes = index.mul %m_rows, %bpr : index
  %w_halfs = index.mul %m_rows, %hpr : index
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %out_total = index.mul %m_rows, %tokens : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [%c1, %ktot] : encoding<layout>
  %weight_na, %input_na, %wstage_na, %ostage_na, %output_na = buffer.assume.noalias %weight, %input, %wstage, %ostage, %output : buffer, buffer, buffer, buffer, buffer
  %wg_y = kernel.workgroup.id<y> : index
  %token_base = index.mul %wg_y, %c64 : index
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<[%ktot]x[%tokens]xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf32>
  %wstage_view = buffer.view %wstage_na[%base] : buffer -> view<[%stage_rows]x[%c16]xf16>
  %ostage_view = buffer.view %ostage_na[%base] : buffer -> view<[%stage_rows]x[%tokens]xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %k_blocks_i = index.cast %k_blocks : index to i32
  %bpr_i = scalar.muli %k_blocks_i, %c18i : i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc0, %acc1, %acc2, %acc3 = scf.for %kk = [%c0 to %ktot step %c16](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c5i : i32
    %j_sink = scf.for %j = [%c0 to %c8 step %c1](%mk = %c0 : index) -> (index) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %e_i = scalar.addi %lane_i, %j32 : i32
      %r_i = scalar.shrui %e_i, %c4i : i32
      %c_i = scalar.andi %e_i, %c15i : i32
      %row_i = scalar.addi %m_origin_i, %r_i : i32
      %row_off = scalar.muli %row_i, %bpr_i : i32
      %blk_off0 = scalar.muli %kblk, %c18i : i32
      %blk_off = scalar.addi %row_off, %blk_off0 : i32
      %shift4 = scalar.shrui %kk_i, %c4i : i32
      %shiftb = scalar.andi %shift4, %c1i : i32
      %shift = scalar.shli %shiftb, %c2i : i32
      %qs0 = scalar.addi %blk_off, %c2i : i32
      %qs_i = scalar.addi %qs0, %c_i : i32
      %qs_ix = index.cast %qs_i : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %w_last : index
      %qb8 = view.load %w_view[%qs_idx] : view<[%w_bytes]xi8> -> i8
      %qb = scalar.extui %qb8 : i8 to i32
      %nib0s = scalar.shrui %qb, %shift : i32
      %nib = scalar.andi %nib0s, %c15i : i32
      %nib0 = scalar.andi %nib, %c1i : i32
      %t0 = scalar.cmpi eq, %nib0, %c1i : i32
      %nib1s = scalar.shrui %nib, %c1i : i32
      %nib1 = scalar.andi %nib1s, %c1i : i32
      %t1 = scalar.cmpi eq, %nib1, %c1i : i32
      %nib2s = scalar.shrui %nib, %c2i : i32
      %nib2 = scalar.andi %nib2s, %c1i : i32
      %t2 = scalar.cmpi eq, %nib2, %c1i : i32
      %nib3s = scalar.shrui %nib, %c3i : i32
      %nib3 = scalar.andi %nib3s, %c1i : i32
      %t3 = scalar.cmpi eq, %nib3, %c1i : i32
      %code = scf.if %t3 -> (f32) {
        %cb8_8 = scf.if %t2 -> (f32) {
          %cb12_4 = scf.if %t1 -> (f32) {
            %cb14_2 = scf.if %t0 -> (f32) {
              scf.yield %kval15 : f32
            } else {
              scf.yield %kval14 : f32
            }
            scf.yield %cb14_2 : f32
          } else {
            %cb12_2 = scf.if %t0 -> (f32) {
              scf.yield %kval13 : f32
            } else {
              scf.yield %kval12 : f32
            }
            scf.yield %cb12_2 : f32
          }
          scf.yield %cb12_4 : f32
        } else {
          %cb8_4 = scf.if %t1 -> (f32) {
            %cb10_2 = scf.if %t0 -> (f32) {
              scf.yield %kval11 : f32
            } else {
              scf.yield %kval10 : f32
            }
            scf.yield %cb10_2 : f32
          } else {
            %cb8_2 = scf.if %t0 -> (f32) {
              scf.yield %kval9 : f32
            } else {
              scf.yield %kval8 : f32
            }
            scf.yield %cb8_2 : f32
          }
          scf.yield %cb8_4 : f32
        }
        scf.yield %cb8_8 : f32
      } else {
        %cb0_8 = scf.if %t2 -> (f32) {
          %cb4_4 = scf.if %t1 -> (f32) {
            %cb6_2 = scf.if %t0 -> (f32) {
              scf.yield %kval7 : f32
            } else {
              scf.yield %kval6 : f32
            }
            scf.yield %cb6_2 : f32
          } else {
            %cb4_2 = scf.if %t0 -> (f32) {
              scf.yield %kval5 : f32
            } else {
              scf.yield %kval4 : f32
            }
            scf.yield %cb4_2 : f32
          }
          scf.yield %cb4_4 : f32
        } else {
          %cb0_4 = scf.if %t1 -> (f32) {
            %cb2_2 = scf.if %t0 -> (f32) {
              scf.yield %kval3 : f32
            } else {
              scf.yield %kval2 : f32
            }
            scf.yield %cb2_2 : f32
          } else {
            %cb0_2 = scf.if %t0 -> (f32) {
              scf.yield %kval1 : f32
            } else {
              scf.yield %kval0 : f32
            }
            scf.yield %cb0_2 : f32
          }
          scf.yield %cb0_4 : f32
        }
        scf.yield %cb0_8 : f32
      }
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %value = scalar.mulf %d, %code : f32
      %h = scalar.fptrunc %value : f32 to f16
      %c_ix = index.cast %c_i : i32 to index
      %c_idx = index.max %c_ix, %c0 : index
      %row_ix = index.cast %row_i : i32 to index
      %row_lo = index.max %row_ix, %c0 : index
      %row = index.min %row_lo, %stage_last : index
      view.store %h, %wstage_view[%row, %c_idx] : f16, view<[%stage_rows]x[%c16]xf16>
      scf.yield %mk : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhs = vector.fragment.load<lhs> %wstage_view[%m_origin, %c0] shape [%m, %k] : view<[%stage_rows]x[%c16]xf16> -> vector<16xf16>
    %t16 = index.add %token_base, %c16 : index
    %t32 = index.add %token_base, %c32 : index
    %t48 = index.add %token_base, %c48 : index
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %token_base] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %t16] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %t32] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %t48] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %n0 = vector.mma %lhs, %rhs0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n1 = vector.mma %lhs, %rhs1, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n2 = vector.mma %lhs, %rhs2, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n3 = vector.mma %lhs, %rhs3, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %n0, %n1, %n2, %n3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %o16 = index.add %token_base, %c16 : index
  %o32 = index.add %token_base, %c32 : index
  %o48 = index.add %token_base, %c48 : index
  vector.fragment.store<result> %acc0, %ostage_view[%m_origin, %token_base] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc1, %ostage_view[%m_origin, %o16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc2, %ostage_view[%m_origin, %o32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc3, %ostage_view[%m_origin, %o48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %tok_g = index.add %token_base, %tok : index
    %val = view.load %ostage_view[%gr2, %tok_g] : view<[%stage_rows]x[%tokens]xf32> -> f32
    %tok_off = index.mul %tok_g, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    %res = view.load %out_view[%gflat] : view<[%out_total]xf32> -> f32
    %sum = scalar.addf %res, %val : f32
    view.store %sum, %out_view[%gflat] : f32, view<[%out_total]xf32>
    scf.yield %mk2 : index
  }
  kernel.return
}

// Requires --config=yah_ffn_gemm_iq4nl_residual.m_tiles=1.
check.case public @yah_ffn_gemm_iq4nl_residual_case {
  %weight = check.file.read.npy path("fixtures/iq4nl_gemm/input_iq4nl_gemm.npy") : tensor<46080xi8>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(1000.0) : tensor<1024xf32>
  %expected = check.file.read.npy path("fixtures/iq4nl_gemm/expected_residual.npy") : tensor<1024xf32>
  %wstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ostage = check.generate.fill value(1000.0) : tensor<1024xf32>
  kernel.launch @yah_ffn_gemm_iq4nl_residual(%weight, %input, %wstage, %ostage, %output) : (tensor<46080xi8>, tensor<64x5120xf16>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf32>)
  check.expect.close actual(%output) expected(%expected) atol(1e-5) rtol(1e-5) nan(same) : tensor<1024xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_iq4nl_residual_case> @yah_ffn_gemm_iq4nl_residual_bench

// Requires --config=yah_ffn_gemm_iq4nl_residual.m_tiles=1088. An all-zero IQ4_NL weight
// decodes to zero (d = 0), so every output must be exactly 0.
check.case public @yah_ffn_gemm_iq4nl_residual_full_case {
  %weight = check.generate.fill value(0) : tensor<50135040xi8>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1114112xf32>
  %expected = check.generate.fill value(0.0) : tensor<1114112xf32>
  %wstage = check.generate.fill value(0.0) : tensor<89128960xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1114112xf32>
  kernel.launch @yah_ffn_gemm_iq4nl_residual(%weight, %input, %wstage, %ostage, %output) : (tensor<50135040xi8>, tensor<64x5120xf16>, tensor<89128960xf16>, tensor<1114112xf32>, tensor<1114112xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1114112xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_iq4nl_residual_full_case> @yah_ffn_gemm_iq4nl_residual_full_bench