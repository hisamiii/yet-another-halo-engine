// YAH prefill RMSNorm + Q8_1 quantization, Loom port of
// BatchedFusedRMSNormQuantizeQ8_1Kernel.
//
// HIP source: models/qwen/hip/kernels/prefill_quant_gemm.hip. One workgroup per
// token. The row is normalized and immediately quantized:
//
//   val    = x[i] + residual[i]
//   sum_sq = sum val^2;  inv_rms = rsqrt(sum_sq/dim + eps)
//   normed = (val * inv_rms) * weight[i]
//   d = max_32lane |normed| / 127;  q = roundf(normed / d)
//
// and (d, q) go to the tiled Q8_1 layout including the sum sidecar. HIP stages the
// row in LDS so the normalize pass does not re-read global memory; the port recomputes
// `x[i] + residual[i]` in the quantization loop instead, which is bit-identical for
// every element and needs no LDS. The cross-workgroup sum is one
// `kernel.workgroup.reduce<addf>`; the per-block maximum is one
// `kernel.subgroup.reduce<maxnumf>`, and a wave owns exactly one 32-element block.
//
// The reduction order differs from HIP 256-thread shared-memory tree, so the last
// bit of `inv_rms` can differ on non-constant rows. The check uses a constant row,
// where every reduction order is exact, so the whole output is byte-exact.
//
// Required config: --config=yah_fused_rmsnorm_q8.batch=1 --config=yah_fused_rmsnorm_q8.dim=64
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_fused_rmsnorm_q8.batch : %value: index where [range(%value, 1, 65536)]

config.decl @yah_fused_rmsnorm_q8.dim : %value: index where [range(%value, 32, 65536)]

kernel.def target(@yah_wave32) @yah_fused_rmsnorm_q8() {
  %unit = index.constant 1 : index
  %batch = config.get @yah_fused_rmsnorm_q8.batch : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%batch, %unit, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%x: buffer, %residual: buffer, %weight: buffer, %eps_buf: buffer, %sum_out: buffer, %y: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c144 = index.constant 144 : index
  %c176 = index.constant 176 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %c576 = index.constant 576 : index
  %c704 = index.constant 704 : index
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c15i = scalar.constant 15 : i32
  %c31 = index.constant 31 : index
  %c127f = scalar.constant 127.0 : f32
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %batch = config.get @yah_fused_rmsnorm_q8.batch : index
  %dim = config.get @yah_fused_rmsnorm_q8.dim : index
  %dim_i = index.cast %dim : index to i32
  %dimf = scalar.sitofp %dim_i : i32 to f32
  %num_blocks_i = scalar.shrui %dim_i, %c5i : i32
  %num_blocks = index.cast %num_blocks_i : i32 to index
  %batch_i = index.cast %batch : index to i32
  %batch15_i = scalar.addi %batch_i, %c15i : i32
  %tiles_i = scalar.shrui %batch15_i, %c4i : i32
  %tiles = index.cast %tiles_i : i32 to index
  %tiles_blocks = index.mul %tiles, %num_blocks : index
  %row_elems = index.mul %batch, %dim : index
  %total_bytes = index.mul %tiles_blocks, %c704 : index
  %sum_base_words = index.mul %tiles_blocks, %c144 : index
  %total_words = index.mul %tiles_blocks, %c176 : index
  %x_na, %res_na, %w_na, %eps_na, %sum_na, %y_na = buffer.assume.noalias %x, %residual, %weight, %eps_buf, %sum_out, %y : buffer, buffer, buffer, buffer, buffer, buffer
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%row_elems]xf32>
  %res_view = buffer.view %res_na[%base] : buffer -> view<[%row_elems]xf32>
  %w_view = buffer.view %w_na[%base] : buffer -> view<[%dim]xf32>
  %eps_view = buffer.view %eps_na[%base] : buffer -> view<[%c1]xf32>
  %sum_view = buffer.view %sum_na[%base] : buffer -> view<[%row_elems]xf32>
  %y_i8 = buffer.view %y_na[%base] : buffer -> view<[%total_bytes]xi8>
  %y_f32 = buffer.view %y_na[%base] : buffer -> view<[%total_words]xf32>
  %tok = kernel.workgroup.id<x> : index
  %tid = kernel.workitem.id<x> : index
  %eps = view.load %eps_view[%c0] : view<[%c1]xf32> -> f32
  %row_base = index.mul %tok, %dim : index
  // Sum of squares over the row, then the workgroup reduction.
  %local = scf.for %i = [%tid to %dim step %c256](%acc = %zero : f32) -> (f32) {
    %e = index.add %row_base, %i : index
    %xv = view.load %x_view[%e] : view<[%row_elems]xf32> -> f32
    %rv = view.load %res_view[%e] : view<[%row_elems]xf32> -> f32
    %v = scalar.addf %xv, %rv : f32
    view.store %v, %sum_view[%e] : f32, view<[%row_elems]xf32>
    %sq = scalar.mulf %v, %v : f32
    %next = scalar.addf %acc, %sq : f32
    scf.yield %next : f32
  }
  %total = kernel.workgroup.reduce<addf> %local : f32
  %mean = scalar.divf %total, %dimf : f32
  %mean_eps = scalar.addf %mean, %eps : f32
  %inv = scalar.rsqrtf %mean_eps : f32
  // Quantization: wave `w` owns blocks w, w+8, ... .
  %lane = index.andi %tid, %c31 : index
  %tid_i = index.cast %tid : index to i32
  %wave_i = scalar.shrui %tid_i, %c5i : i32
  %wave = index.cast %wave_i : i32 to index
  %blocks_loop = scf.for %blk = [%wave to %num_blocks step %c8](%mark = %c0 : index) -> (index) {
    %blk32 = index.mul %blk, %c32 : index
    %eoff = index.add %blk32, %lane : index
    %e2 = index.add %row_base, %eoff : index
    %xv2 = view.load %x_view[%e2] : view<[%row_elems]xf32> -> f32
    %rv2 = view.load %res_view[%e2] : view<[%row_elems]xf32> -> f32
    %v2 = scalar.addf %xv2, %rv2 : f32
    %wv = view.load %w_view[%eoff] : view<[%dim]xf32> -> f32
    %scaled = scalar.mulf %v2, %inv : f32
    %normed = scalar.mulf %scaled, %wv : f32
    %abs = scalar.absf %normed : f32
    %max_abs = kernel.subgroup.reduce<maxnumf> %abs : f32
    %d = scalar.divf %max_abs, %c127f : f32
    %nonzero = scalar.cmpf one, %d, %zero : f32
    %id = scf.if %nonzero -> (f32) {
      %inv2 = scalar.divf %one, %d : f32
      scf.yield %inv2 : f32
    } else {
      scf.yield %zero : f32
    }
    %prod = scalar.mulf %normed, %id : f32
    %rounded = scalar.roundf %prod : f32
    %q_i32 = scalar.fptosi %rounded : f32 to i32
    %q_i8 = scalar.trunci %q_i32 : i32 to i8
    %tok_i = index.cast %tok : index to i32
    %tt_i = scalar.shrui %tok_i, %c4i : i32
    %tl_i = scalar.andi %tok_i, %c15i : i32
    %tt = index.cast %tt_i : i32 to index
    %tl_c_i = scalar.minsi %tl_i, %c15i : i32
    %tl = index.cast %tl_c_i : i32 to index
    %tt_nb = index.mul %tt, %num_blocks : index
    %tile_raw = index.add %tt_nb, %blk : index
    %tile_max = index.sub %tiles_blocks, %c1 : index
    %tile_raw_i = index.cast %tile_raw : index to i32
    %tile_max_i = index.cast %tile_max : index to i32
    %tile_clamp_i = scalar.minsi %tile_raw_i, %tile_max_i : i32
    %tile = index.cast %tile_clamp_i : i32 to index
    %tile_bytes = index.mul %tile, %c576 : index
    %lane_i = index.cast %lane : index to i32
    %half_i = scalar.shrui %lane_i, %c4i : i32
    %pos_i = scalar.andi %lane_i, %c15i : i32
    %half = index.cast %half_i : i32 to index
    %pos = index.cast %pos_i : i32 to index
    %half256 = index.mul %half, %c256 : index
    %tl16 = index.mul %tl, %c16 : index
    %tl16_pos = index.add %tl16, %pos : index
    %within = index.add %half256, %tl16_pos : index
    %byte = index.add %tile_bytes, %within : index
    view.store %q_i8, %y_i8[%byte] : i8, view<[%total_bytes]xi8>
    %qf = scalar.sitofp %q_i32 : i32 to f32
    %lt16 = index.cmp ult, %lane, %c16 : index
    %low_contrib = scf.if %lt16 -> (f32) {
      scf.yield %qf : f32
    } else {
      scf.yield %zero : f32
    }
    %high_contrib = scf.if %lt16 -> (f32) {
      scf.yield %zero : f32
    } else {
      scf.yield %qf : f32
    }
    %low = kernel.subgroup.reduce<addf> %low_contrib : f32
    %high = kernel.subgroup.reduce<addf> %high_contrib : f32
    %is_leader = index.cmp eq, %lane, %c0 : index
    scf.if %is_leader {
      %tile_words = index.mul %tile, %c144 : index
      %scale_off = index.add %c128, %tl : index
      %scale_idx = index.add %tile_words, %scale_off : index
      view.store %d, %y_f32[%scale_idx] : f32, view<[%total_words]xf32>
      %tile16 = index.mul %tile, %c16 : index
      %tile16_tl = index.add %tile16, %tl : index
      %slot_pair = index.mul %tile16_tl, %c2 : index
      %slot = index.add %sum_base_words, %slot_pair : index
      %total_sum = scalar.addf %low, %high : f32
      %slot0 = scalar.mulf %d, %total_sum : f32
      %slot1 = scalar.mulf %d, %low : f32
      view.store %slot0, %y_f32[%slot] : f32, view<[%total_words]xf32>
      %slot_next = index.add %slot, %c1 : index
      view.store %slot1, %y_f32[%slot_next] : f32, view<[%total_words]xf32>
    }
    scf.yield %mark : index
  }
  kernel.return
}

// Requires --config=yah_fused_rmsnorm_q8.batch=1 --config=yah_fused_rmsnorm_q8.dim=64.
//
// x = 1, residual = 0, weight = 1, eps = 0: every element contributes exactly 1 to
// the sum of squares, so sum_sq = 64, mean = 1, inv_rms = rsqrt(1) = 1, and every
// normed value is exactly 1. The output is then the same byte-exact fixture as the
// base quantizer with all-ones input: two blocks, each q = 127 and d = 1/127.
check.case public @yah_fused_rmsnorm_q8_case {
  %x = check.generate.fill value(1.0) : tensor<1x64xf32>
  %residual = check.generate.fill value(0.0) : tensor<1x64xf32>
  %weight = check.generate.fill value(1.0) : tensor<64xf32>
  %eps = check.generate.fill value(0.0) : tensor<1xf32>
  %sum_out = check.generate.fill value(0.0) : tensor<1x64xf32>
  %y = check.generate.fill value(0) : tensor<1408xi8>
  %expected = check.file.read.npy path("fixtures/fused_rmsnorm_q8/expected_bytes.npy") : tensor<1408xi8>
  %expected_sum = check.generate.fill value(1.0) : tensor<1x64xf32>
  kernel.launch @yah_fused_rmsnorm_q8(%x, %residual, %weight, %eps, %sum_out, %y) : (tensor<1x64xf32>, tensor<1x64xf32>, tensor<64xf32>, tensor<1xf32>, tensor<1x64xf32>, tensor<1408xi8>)
  check.expect.equal actual(%y) expected(%expected) : tensor<1408xi8>
  check.expect.close actual(%sum_out) expected(%expected_sum) atol(0.0) rtol(0.0) nan(same) : tensor<1x64xf32>
  check.return
}

check.benchmark<@yah_fused_rmsnorm_q8_case> @yah_fused_rmsnorm_q8_bench
