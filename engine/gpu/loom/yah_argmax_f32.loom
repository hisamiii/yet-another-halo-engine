// YAH argmax over logits, Loom port of ArgmaxKernel.
//
// HIP source: sample.hip. The HIP kernel scans with 256 threads into a shared
// (value, index) pair and tree-reduces, ignoring non-finite values and keeping the
// lowest index on ties because the comparison is strict.
//
// This port reaches the same answer in two passes, which avoids needing a
// scalar select (the scalar dialect has cmpf, isfinitef and maxnumf, but no
// scalar.select):
//
//   pass 1  each lane takes the max over its stride-32 slice, mapping non-finite
//           entries to -3e38, then kernel.subgroup.reduce<maxnumf> gives the row max
//   pass 2  each lane records the lowest index in its slice equal to that max
//   combine lane 0 scans the 32 per-lane candidates from workgroup memory and
//           keeps the minimum, which is the lowest index on ties
//
// Two passes read the logits twice. That is a correctness-first choice; the HIP
// kernel reads once.
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_argmax.vocab : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@yah_wave32) @yah_argmax() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 1024 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%logits: buffer, %out_token: buffer) {
  // One 1024-lane workgroup: each lane scans a stride-1024 slice (unrolled so
  // loads overlap), waves reduce with subgroup maxima, and 32 per-wave values
  // meet in LDS. The lowest matching index is found as the maximum of -index
  // in f32 (exact below 2^24). Max and lowest-index are order-independent, so
  // the result is the one-wave kernel's exactly. 248320 logits: 1.9 ms before.
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c1024 = index.constant 1024 : index
  %vocab = config.get @yah_argmax.vocab : index
  %neg_big = scalar.constant -3.0000000000000001e+38 : f32
  %pos_limit = scalar.constant 3.0000000000000001e+38 : f32
  %logits_noalias, %out_noalias = buffer.assume.noalias %logits, %out_token : buffer, buffer
  %logits_view = buffer.view %logits_noalias[%base] : buffer -> view<[%vocab]xf32>
  %out_view = buffer.view %out_noalias[%base] : buffer -> view<1xi32>
  %wbytes = index.constant 128 : offset
  %wmax = buffer.alloca<workgroup> align(16) %wbytes : buffer
  %wmax_view = buffer.view %wmax[%base] : buffer -> view<32xf32>
  %widx = buffer.alloca<workgroup> align(16) %wbytes : buffer
  %widx_view = buffer.view %widx[%base] : buffer -> view<32xf32>
  %tid = kernel.workitem.id<x> : index
  %wave = index.div %tid, %c32 : index
  %lane = index.rem %tid, %c32 : index
  %is_lane0 = index.cmp eq, %lane, %c0 : index

  %slice_max = scf.for %i = [%tid to %vocab step %c1024](%acc = %neg_big : f32) -> (f32) unroll(%c8) {
    %v = view.load %logits_view[%i] : view<[%vocab]xf32> -> f32
    // NaN and +inf fail this bound and are dropped (see the one-wave version).
    %finite = scalar.cmpf ole, %v, %pos_limit : f32
    %fv = scf.if %finite -> (f32) {
      scf.yield %v : f32
    } else {
      scf.yield %neg_big : f32
    }
    %next = scalar.maxnumf %acc, %fv : f32
    scf.yield %next : f32
  }
  %wave_max = kernel.subgroup.reduce<maxnumf> %slice_max : f32
  scf.if %is_lane0 {
    view.store %wave_max, %wmax_view[%wave] : f32, view<32xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %row_max = scf.for %k = [%c0 to %c32 step %c1](%m = %neg_big : f32) -> (f32) {
    %wm = view.load %wmax_view[%k] : view<32xf32> -> f32
    %nm = scalar.maxnumf %m, %wm : f32
    scf.yield %nm : f32
  }

  %vocab_i32 = index.cast %vocab : index to i32
  %vocab_f = scalar.sitofp %vocab_i32 : i32 to f32
  %neg_vocab = scalar.negf %vocab_f : f32
  %cand = scf.for %i2 = [%tid to %vocab step %c1024](%acc2 = %neg_vocab : f32) -> (f32) unroll(%c8) {
    %v2 = view.load %logits_view[%i2] : view<[%vocab]xf32> -> f32
    %eq = scalar.cmpf oeq, %v2, %row_max : f32
    %ii = index.cast %i2 : index to i32
    %fi = scalar.sitofp %ii : i32 to f32
    %nfi = scalar.negf %fi : f32
    %c = scf.if %eq -> (f32) {
      scf.yield %nfi : f32
    } else {
      scf.yield %neg_vocab : f32
    }
    %n2 = scalar.maxnumf %acc2, %c : f32
    scf.yield %n2 : f32
  }
  %wave_cand = kernel.subgroup.reduce<maxnumf> %cand : f32
  scf.if %is_lane0 {
    view.store %wave_cand, %widx_view[%wave] : f32, view<32xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %is_leader = index.cmp eq, %tid, %c0 : index
  scf.if %is_leader {
    %best = scf.for %k2 = [%c0 to %c32 step %c1](%b = %neg_vocab : f32) -> (f32) {
      %cv = view.load %widx_view[%k2] : view<32xf32> -> f32
      %nb = scalar.maxnumf %b, %cv : f32
      scf.yield %nb : f32
    }
    %best_pos = scalar.negf %best : f32
    %best_i = scalar.fptosi %best_pos : f32 to i32
    view.store %best_i, %out_view[%c0] : i32, view<1xi32>
  }
  kernel.return
}
