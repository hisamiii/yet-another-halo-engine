// YAH fused QKV projections (warp-per-row, f32 weights), Loom port of
// Wave32FusedQKVProjectionsKernel_1Row<4> (f32 arm).
//
// HIP source: models/qwen/hip/kernels/qkv.hip. This is the launcher default when
// hidden_size % 8 == 0: four warps per block, each warp owning one output row of the
// concatenated [q_w | k_w | v_w] matrix. The 32 lanes split the hidden dimension, a
// shuffle reduction folds the lane partials, and lane 0 writes the row:
//
//   m = blockIdx.x*4 + warp_id; total = q_dim + 2*kv_dim
//   q band: m < q_dim                     row = m
//   k band: (m - q_dim) < kv_dim          row = m - q_dim
//   v band: (m - q_dim - kv_dim) < kv_dim row = m - q_dim - kv_dim
//   dot = sum_k W[row*hidden + k] * x[k]
//   out[row] = warp_reduce_add(dot)
//
// The unsigned biased comparisons give the three bands without nesting `scf.if`.
// The warp reduction is `kernel.subgroup.reduce<addf>`, which broadcasts, so only
// lane 0 stores. Only the f32 weight arm is ported; the BF16, Q8_0 and
// block-quantized arms need the sub-16 format table and stay deferred.
//
// Required config: --config=yah_qkv_proj_wave32.q_dim=1 --config=yah_qkv_proj_wave32.kv_dim=1
//                  --config=yah_qkv_proj_wave32.hidden=8
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_qkv_proj_wave32.q_dim : %value: index where [range(%value, 1, 65536)]

config.decl @yah_qkv_proj_wave32.kv_dim : %value: index where [range(%value, 1, 65536)]

config.decl @yah_qkv_proj_wave32.hidden : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_qkv_proj_wave32() {
  %unit = index.constant 1 : index
  %q_dim = config.get @yah_qkv_proj_wave32.q_dim : index
  %kv_dim = config.get @yah_qkv_proj_wave32.kv_dim : index
  %c2 = index.constant 2 : index
  %qkv2 = index.mul %c2, %kv_dim : index
  %total = index.add %q_dim, %qkv2 : index
  %c4 = index.constant 4 : index
  %c3 = index.constant 3 : index
  %biased = index.add %total, %c3 : index
  %tiles = index.div %biased, %c4 : index
  %c128 = index.constant 128 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%c128, %unit, %unit) : index
} launch(%q_w: buffer, %k_w: buffer, %v_w: buffer, %x: buffer, %q_out: buffer, %k_out: buffer, %v_out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %zero = scalar.constant 0.0 : f32
  %q_dim = config.get @yah_qkv_proj_wave32.q_dim : index
  %kv_dim = config.get @yah_qkv_proj_wave32.kv_dim : index
  %hidden = config.get @yah_qkv_proj_wave32.hidden : index
  %q_elems = index.mul %q_dim, %hidden : index
  %kv_elems = index.mul %kv_dim, %hidden : index
  %kv_m1 = index.sub %kv_dim, %c1 : index
  %q_na, %k_na, %v_na, %x_na, %qo_na, %ko_na, %vo_na = buffer.assume.noalias %q_w, %k_w, %v_w, %x, %q_out, %k_out, %v_out : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %q_view = buffer.view %q_na[%base] : buffer -> view<[%q_elems]xf32>
  %k_view = buffer.view %k_na[%base] : buffer -> view<[%kv_elems]xf32>
  %v_view = buffer.view %v_na[%base] : buffer -> view<[%kv_elems]xf32>
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%hidden]xf32>
  %qo_view = buffer.view %qo_na[%base] : buffer -> view<[%q_dim]xf32>
  %ko_view = buffer.view %ko_na[%base] : buffer -> view<[%kv_dim]xf32>
  %vo_view = buffer.view %vo_na[%base] : buffer -> view<[%kv_dim]xf32>
  %wg = kernel.workgroup.id<x> : index
  %warp = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %wg4 = index.mul %wg, %c4 : index
  %m = index.add %wg4, %warp : index
  %is_q = index.cmp ult, %m, %q_dim : index
  scf.if %is_q {
    %mh = index.mul %m, %hidden : index
    %local_q = scf.for %k = [%lane to %hidden step %c32](%acc = %zero : f32) -> (f32) {
      %off = index.add %mh, %k : index
      %wv = view.load %q_view[%off] : view<[%q_elems]xf32> -> f32
      %xv = view.load %x_view[%k] : view<[%hidden]xf32> -> f32
      %p = scalar.mulf %wv, %xv : f32
      %n = scalar.addf %acc, %p : f32
      scf.yield %n : f32
    }
    %sum_q = kernel.subgroup.reduce<addf> %local_q : f32
    %leader_q = index.cmp eq, %lane, %c0 : index
    scf.if %leader_q {
      view.store %sum_q, %qo_view[%m] : f32, view<[%q_dim]xf32>
    }
  }
  %mq = index.sub %m, %q_dim : index
  %is_k = index.cmp ult, %mq, %kv_dim : index
  scf.if %is_k {
    %row = index.min %mq, %kv_m1 : index
    %rh = index.mul %row, %hidden : index
    %local_k = scf.for %k2 = [%lane to %hidden step %c32](%acc2 = %zero : f32) -> (f32) {
      %off2 = index.add %rh, %k2 : index
      %wv2 = view.load %k_view[%off2] : view<[%kv_elems]xf32> -> f32
      %xv2 = view.load %x_view[%k2] : view<[%hidden]xf32> -> f32
      %p2 = scalar.mulf %wv2, %xv2 : f32
      %n2 = scalar.addf %acc2, %p2 : f32
      scf.yield %n2 : f32
    }
    %sum_k = kernel.subgroup.reduce<addf> %local_k : f32
    %leader_k = index.cmp eq, %lane, %c0 : index
    scf.if %leader_k {
      view.store %sum_k, %ko_view[%row] : f32, view<[%kv_dim]xf32>
    }
  }
  %mqv = index.sub %mq, %kv_dim : index
  %is_v = index.cmp ult, %mqv, %kv_dim : index
  scf.if %is_v {
    %rowv = index.min %mqv, %kv_m1 : index
    %rhv = index.mul %rowv, %hidden : index
    %local_v = scf.for %k3 = [%lane to %hidden step %c32](%acc3 = %zero : f32) -> (f32) {
      %off3 = index.add %rhv, %k3 : index
      %wv3 = view.load %v_view[%off3] : view<[%kv_elems]xf32> -> f32
      %xv3 = view.load %x_view[%k3] : view<[%hidden]xf32> -> f32
      %p3 = scalar.mulf %wv3, %xv3 : f32
      %n3 = scalar.addf %acc3, %p3 : f32
      scf.yield %n3 : f32
    }
    %sum_v = kernel.subgroup.reduce<addf> %local_v : f32
    %leader_v = index.cmp eq, %lane, %c0 : index
    scf.if %leader_v {
      view.store %sum_v, %vo_view[%rowv] : f32, view<[%kv_dim]xf32>
    }
  }
  kernel.return
}

// Requires --config=yah_qkv_proj_wave32.q_dim=1, .kv_dim=1, .hidden=8.
//
// One row each for q, k and v of 8 hidden values: q_w = 0..7, k_w = 10..17,
// v_w = 20..27 and x = 1, so the three outputs are the row sums 28, 108 and 188.
// Exact in f32, no fixture.
check.case public @yah_qkv_proj_wave32_case {
  %q_w = check.generate.iota offset(0.0) step(1.0) : tensor<1x8xf32>
  %k_w = check.generate.iota offset(10.0) step(1.0) : tensor<1x8xf32>
  %v_w = check.generate.iota offset(20.0) step(1.0) : tensor<1x8xf32>
  %x = check.generate.fill value(1.0) : tensor<8xf32>
  %q_out = check.generate.fill value(0.0) : tensor<1xf32>
  %k_out = check.generate.fill value(0.0) : tensor<1xf32>
  %v_out = check.generate.fill value(0.0) : tensor<1xf32>
  %eq = check.generate.fill value(28.0) : tensor<1xf32>
  %ek = check.generate.fill value(108.0) : tensor<1xf32>
  %ev = check.generate.fill value(188.0) : tensor<1xf32>
  kernel.launch @yah_qkv_proj_wave32(%q_w, %k_w, %v_w, %x, %q_out, %k_out, %v_out) : (tensor<1x8xf32>, tensor<1x8xf32>, tensor<1x8xf32>, tensor<8xf32>, tensor<1xf32>, tensor<1xf32>, tensor<1xf32>)
  check.expect.close actual(%q_out) expected(%eq) atol(0.0) rtol(0.0) nan(same) : tensor<1xf32>
  check.expect.close actual(%k_out) expected(%ek) atol(0.0) rtol(0.0) nan(same) : tensor<1xf32>
  check.expect.close actual(%v_out) expected(%ev) atol(0.0) rtol(0.0) nan(same) : tensor<1xf32>
  check.return
}

check.benchmark<@yah_qkv_proj_wave32_case> @yah_qkv_proj_wave32_bench
