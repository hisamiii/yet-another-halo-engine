// YAH embedding lookup with a device token pointer, Loom port of
// EmbeddingLookupPtrKernel (f32 table arm).
//
// HIP source: models/qwen/hip/kernels/embed.hip. The token id lives in device
// memory, so this is the decode-graph-friendly cousin of EmbeddingLookupKernel:
//
//   token = *d_token_id; out[i] = table[token*hidden + i]
//
// Only the f32 arm is ported; the BF16, Q8_0 and block-quantized arms need the
// sub-16 format table. token is clamped to the declared row count so the footprint
// analysis can bound the table view.
//
// Required config: --config=yah_embed_ptr.rows=4 --config=yah_embed_ptr.hidden=8
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_embed_ptr.rows : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_embed_ptr.hidden : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@yah_wave32) @yah_embed_ptr() {
  %unit = index.constant 1 : index
  %hidden = config.get @yah_embed_ptr.hidden : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %hidden, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%table: buffer, %d_token: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %rows = config.get @yah_embed_ptr.rows : index
  %hidden = config.get @yah_embed_ptr.hidden : index
  %table_elems = index.mul %rows, %hidden : index
  %rows_m1 = index.sub %rows, %c1 : index
  %table_na, %tok_na, %out_na = buffer.assume.noalias %table, %d_token, %out : buffer, buffer, buffer
  %table_view = buffer.view %table_na[%base] : buffer -> view<[%table_elems]xf32>
  %tok_view = buffer.view %tok_na[%base] : buffer -> view<[%c1]xi32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%hidden]xf32>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wg256 = index.mul %wg, %c256 : index
  %idx = index.add %wg256, %lane : index
  %in_range = index.cmp ult, %idx, %hidden : index
  scf.if %in_range {
    %tok_i = view.load %tok_view[%c0] : view<[%c1]xi32> -> i32
    %tok_raw = index.cast %tok_i : i32 to index
    %token_nonneg = index.max %tok_raw, %c0 : index
    %token = index.min %token_nonneg, %rows_m1 : index
    %th = index.mul %token, %hidden : index
    %off = index.add %th, %idx : index
    %v = view.load %table_view[%off] : view<[%table_elems]xf32> -> f32
    view.store %v, %out_view[%idx] : f32, view<[%hidden]xf32>
  }
  kernel.return
}

// Requires --config=yah_embed_ptr.rows=4 --config=yah_embed_ptr.hidden=8.
// table = iota 0..31 and token = 2, so out is the third row, 16..23.
check.case public @yah_embed_ptr_case {
  %table = check.generate.iota offset(0.0) step(1.0) : tensor<4x8xf32>
  %tok = check.file.read.npy path("fixtures/embed_ptr/token.npy") : tensor<1xi32>
  %out = check.generate.fill value(0.0) : tensor<8xf32>
  %expected = check.generate.iota offset(16.0) step(1.0) : tensor<8xf32>
  kernel.launch @yah_embed_ptr(%table, %tok, %out) : (tensor<4x8xf32>, tensor<1xi32>, tensor<8xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.return
}

check.benchmark<@yah_embed_ptr_case> @yah_embed_ptr_bench
