// YAH FFN GEMM paired gate/up SwiGLU, Loom port of HalfPrefillGemmKernel<kGateUp>.
//
// HIP source: prefill_fp16.hip. Two GEMMs share one activation row block and
// write one fp16 SwiGLU result:
//
//   gate_acc[row][token] = sum_k gate_w[row][k] * A[token][k]
//   up_acc[row][token]   = sum_k up_w[row][k]   * A[token][k]
//   out[token*m + row]   = round_f16(silu(gate_acc) * up_acc)
//
// This is the paired arm forward.hip takes first
// (TryLaunchBatchedDualQuantGEMMSwiGLUFp16); when it declines, the same result is
// produced by yah_ffn_gemm_f16 followed by yah_ffn_gemm_swiglu_f16. HIP keeps
// the gate and up rows adjacent in one accumulator array; here they are two
// separate accumulator groups over the same rows, which is the same logical
// mapping.
//
// round_f16 is HIP RoundActivation = __float2half_rn; the fragment store
// narrows at its boundary, as in yah_ffn_gemm_swiglu_f16.
//
// The correctness case is uniform. gate_w = 2^-12 and up_w = 0.5 make the two
// accumulators exactly 1.25 and 2560, so the output is
// round_f16(silu(1.25) * 2560) = 2488. The uniform case isolates the pairing and
// the epilogue; the fragment indexing and the output layout are pinned by
// yah_ffn_gemm_f16 and yah_ffn_gemm_residual_f32.
//
// Required config: --config=yah_ffn_gemm_gateup.m_tiles=1088
amdgpu.target<gfx1151> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_gateup.m_tiles : %value: index where [range(%value, 1, 4096)]

config.def @yah_ffn_gemm_gateup.depth = 3 : index

config.def @yah_ffn_gemm_gateup.unroll = 2 : index

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_gateup() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_gateup.m_tiles : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%gate_weight: buffer, %up_weight: buffer, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c5120 = index.constant 5120 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index

  // Activation viewed [k][t]: element (k,t) is A[t][k] = base + t*5120 + k.
  %a_layout = encoding.layout.strided [1, 5120] : encoding<layout>
  // HIP stores its result token-major, y[token*m + row], for coalesced
  // stores. A default row-major view would write out[row][token] instead,
  // which is a different layout from the HIP kernel. The strided layout
  // gives element (row,token) the address token*17408 + row without a
  // transposed register copy.
  %out_layout = encoding.layout.strided [1, 17408] : encoding<layout>

  %gate_noalias, %up_noalias, %input_noalias, %output_noalias = buffer.assume.noalias %gate_weight, %up_weight, %input, %output : buffer, buffer, buffer, buffer
  %gw_view = buffer.view %gate_noalias[%base] : buffer -> view<17408x5120xf16>
  %uw_view = buffer.view %up_noalias[%base] : buffer -> view<17408x5120xf16>
  %a_t_view = buffer.view %input_noalias[%base] : buffer -> view<5120x64xf16, %a_layout>
  %out_view = buffer.view %output_noalias[%base] : buffer -> view<17408x64xf16, %out_layout>

  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index

  %depth = config.get @yah_ffn_gemm_gateup.depth : index
  %factor = config.get @yah_ffn_gemm_gateup.unroll : index

  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %g0, %g1, %g2, %g3, %u0, %u1, %u2, %u3 = scf.for %kk = [%c0 to %c5120 step %c16](%ag0 = %init : vector<8xf32>, %ag1 = %init : vector<8xf32>, %ag2 = %init : vector<8xf32>, %ag3 = %init : vector<8xf32>, %au0 = %init : vector<8xf32>, %au1 = %init : vector<8xf32>, %au2 = %init : vector<8xf32>, %au3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) pipeline(%depth) unroll(%factor) schedule(recurrence) {
    %lhsg = vector.fragment.load<lhs> %gw_view[%m_origin, %kk] shape [%m, %k] : view<17408x5120xf16> -> vector<16xf16>
    %lhsu = vector.fragment.load<lhs> %uw_view[%m_origin, %kk] shape [%m, %k] : view<17408x5120xf16> -> vector<16xf16>
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %c0] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %c16] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %c32] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %c48] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %ng0 = vector.mma %lhsg, %rhs0, %ag0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng1 = vector.mma %lhsg, %rhs1, %ag1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng2 = vector.mma %lhsg, %rhs2, %ag2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng3 = vector.mma %lhsg, %rhs3, %ag3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu0 = vector.mma %lhsu, %rhs0, %au0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu1 = vector.mma %lhsu, %rhs1, %au1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu2 = vector.mma %lhsu, %rhs2, %au2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu3 = vector.mma %lhsu, %rhs3, %au3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %ng0, %ng1, %ng2, %ng3, %nu0, %nu1, %nu2, %nu3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  // SwiGLU epilogue in registers: out = round_f16(silu(gate_acc) * up_acc).
  %silu0 = vector.siluf %g0 : vector<8xf32>
  %silu1 = vector.siluf %g1 : vector<8xf32>
  %silu2 = vector.siluf %g2 : vector<8xf32>
  %silu3 = vector.siluf %g3 : vector<8xf32>
  %act0 = vector.mulf %silu0, %u0 : vector<8xf32>
  %act1 = vector.mulf %silu1, %u1 : vector<8xf32>
  %act2 = vector.mulf %silu2, %u2 : vector<8xf32>
  %act3 = vector.mulf %silu3, %u3 : vector<8xf32>
  vector.fragment.store<result> %act0, %out_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<17408x64xf16, %out_layout>
  vector.fragment.store<result> %act1, %out_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<17408x64xf16, %out_layout>
  vector.fragment.store<result> %act2, %out_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<17408x64xf16, %out_layout>
  vector.fragment.store<result> %act3, %out_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<17408x64xf16, %out_layout>
  kernel.return
}

check.case public @yah_ffn_gemm_gateup_case {
  // gate_w = 2^-12 and up_w = 0.5 are exact in f16, so gate_acc = 5120*2^-12 =
  // 1.25 and up_acc = 5120*0.5 = 2560 exactly. silu(1.25) = 0.9716249 and
  // round_f16(0.9716249 * 2560) = round_f16(2487.36) = 2488. The f16 ULP at
  // 2488 is 2, hence the atol.
  %gate_weight = check.generate.fill value(0.000244140625) : tensor<17408x5120xf16>
  %up_weight = check.generate.fill value(0.5) : tensor<17408x5120xf16>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<17408x64xf16>
  %expected = check.generate.fill value(2488.0) : tensor<17408x64xf16>
  kernel.launch @yah_ffn_gemm_gateup(%gate_weight, %up_weight, %input, %output) : (tensor<17408x5120xf16>, tensor<17408x5120xf16>, tensor<64x5120xf16>, tensor<17408x64xf16>)
  check.expect.close actual(%output) expected(%expected) atol(2.0) rtol(0.0) nan(same) : tensor<17408x64xf16>
  check.return
}

check.benchmark<@yah_ffn_gemm_gateup_case> @yah_ffn_gemm_gateup_bench
