// YAH DeltaNet decode recurrence (resident fp32 storage), Loom port of
// DeltaNetRecurrenceKernel<float, Resident=true, WriteOutput=true>.
//
// HIP source: models/qwen/hip/kernels/deltanet_decode.hpp:16-373, the
// single-token decode recurrence reached from LaunchSSMConvRecurrence
// (engine/model/forward.hip:710) with QwenRecurrentStateStorage::kFp32 and
// key_dim == val_dim == 128. This is a DISTINCT kernel from the prefill
// row-split recurrence in yah_deltanet_rowsplit_f32.loom; it differs in the
// normalization (k and q are scaled by their own L2 norms, not by the separate
// prep-kq scales), in the alpha/beta computation (done here from
// alpha/beta/ssm_a/ssm_dt, not read precomputed), and in the RMSNorm + SiLU gate
// epilogue on the head output.
//
// SEMANTICS. One workgroup per value head h, kh = h % num_key_heads. For the
// single decoded token, with alpha, beta, ssm_a, ssm_dt indexed by h, the
// per-head q/k/v rows read from the conv output and the 128x128 state matrix
// S (one value row per S[j]):
//
//   alpha_in = alpha[h] + ssm_dt[h]
//   alpha_h  = exp(softplus(alpha_in) * ssm_a[h]),
//              softplus(x) = x if x > 20 else log1p(exp(x))       [overflow guard]
//   beta_h   = 1 / (1 + exp(-beta[h]))
//   k_norm[i] = k[i] / sqrt(sum_l k[l]^2 + 1e-6)
//   q_scale   = (1 / sqrt(128)) / sqrt(sum_l q[l]^2 + 1e-6)
//   q_norm[i] = q[i] * q_scale
//   u_j = sum_i (S[j][i] * alpha_h) * k_norm[i]
//   d_j = (v[j] - u_j) * beta_h
//   S'[j][i] = S[j][i] * alpha_h + d_j * k_norm[i]
//   o_j = sum_i S'[j][i] * q_norm[i]
//   mean_sq = sum_j o_j^2 / 128
//   rms = 1 / sqrt(mean_sq + 1e-6)
//   out[h][j] = o_j * rms * ssm_norm[j] * (g * sigmoid(g)),  g = gate[h][j]
//
// The readout u_j uses the pre-update state; S is written in place so the
// caller's recurrent state advances exactly one token. The HIP kernel keeps all
// 128 key values of each value row in registers (resident[32] float4) and walks
// rows verification rows. This port fixes rows = 1 (single-token decode, the
// only path forward.hip:710 uses) and defers the 128-wide resident register tile
// and the four-warp shuffle schedule to tuning: it uses ONE 32-lane wave per
// head, each lane owning four value rows (j = lane + 32*m), and the K/Q norm
// reductions are four-term per-lane partial sums fed to a single
// kernel.subgroup.reduce<addf> (the Loom spelling of the HIP __shfl_xor
// four-warp stitching). That is the same arithmetic with a different summation
// order and a different register schedule; see PORTING.md.
//
// OPERANDS, in the HIP pointer order (conv_out, deltanet_state, alpha_buf,
// beta_buf, ssm_a, ssm_dt, ssm_norm, gate, out_buf):
//   conv  f32 [2*num_key_heads*128 + num_heads*128]  q[kh][i], k[kh][i], v[h][j]
//   state f32 [num_heads*128*128]                    this layer only, [h][j][i]
//   alpha f32 [num_heads]     beta f32 [num_heads]
//   ssm_a f32 [num_heads]     ssm_dt f32 [num_heads]
//   norm  f32 [128]           gate f32 [num_heads*128]
//   out   f32 [num_heads*128] written in place after the RMSNorm + gate
//
// The HIP kernel takes layer_idx and offsets deltanet_state internally; as in the
// row-split port the caller reproduces that by offsetting the state pointer, so
// the state operand is one layer's worth. The HIP kernel also allows alpha_buf,
// beta_buf, ssm_a, ssm_dt, ssm_norm and gate to be null (folding to 0.0, -0.05,
// 1.0); this port requires all of them present, which is the decode path.
//
// Required config (small case): --config=yah_deltanet_decode.num_heads=4
//                               --config=yah_deltanet_decode.num_key_heads=2
// Required config (production): --config=yah_deltanet_decode.num_heads=32
//                               --config=yah_deltanet_decode.num_key_heads=16
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_deltanet_decode.num_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_deltanet_decode.num_key_heads : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_wave32) @yah_deltanet_decode() {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  %num_heads = config.get @yah_deltanet_decode.num_heads : index
  kernel.launch.config workgroups(%num_heads, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%conv: buffer, %state: buffer, %alpha: buffer, %beta: buffer, %ssm_a: buffer, %ssm_dt: buffer, %ssm_norm: buffer, %gate: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c16384 = index.constant 16384 : index
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %twenty = scalar.constant 20.0 : f32
  %epsilon = scalar.constant 0.000001 : f32
  %num_heads = config.get @yah_deltanet_decode.num_heads : index
  %num_key_heads = config.get @yah_deltanet_decode.num_key_heads : index
  %qk_total = index.mul %num_key_heads, %c128 : index
  %qk2_total = index.mul %qk_total, %c2 : index
  %v_total = index.mul %num_heads, %c128 : index
  %conv_total = index.add %qk2_total, %v_total : index
  %state_total = index.mul %num_heads, %c16384 : index
  %head_total = index.mul %num_heads, %c128 : index
  %conv_na, %state_na, %alpha_na, %beta_na, %a_na, %dt_na, %norm_na, %gate_na, %out_na = buffer.assume.noalias %conv, %state, %alpha, %beta, %ssm_a, %ssm_dt, %ssm_norm, %gate, %out : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %conv_view = buffer.view %conv_na[%base] : buffer -> view<[%conv_total]xf32>
  %state_view = buffer.view %state_na[%base] : buffer -> view<[%state_total]xf32>
  %alpha_view = buffer.view %alpha_na[%base] : buffer -> view<[%num_heads]xf32>
  %beta_view = buffer.view %beta_na[%base] : buffer -> view<[%num_heads]xf32>
  %a_view = buffer.view %a_na[%base] : buffer -> view<[%num_heads]xf32>
  %dt_view = buffer.view %dt_na[%base] : buffer -> view<[%num_heads]xf32>
  %norm_view = buffer.view %norm_na[%base] : buffer -> view<[%c128]xf32>
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<[%head_total]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%head_total]xf32>
  %h = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %kh = index.rem %h, %num_key_heads : index

  // 1. Decay and learning rate.
  %dt = view.load %dt_view[%h] : view<[%num_heads]xf32> -> f32
  %a_val = view.load %a_view[%h] : view<[%num_heads]xf32> -> f32
  %alpha_in = view.load %alpha_view[%h] : view<[%num_heads]xf32> -> f32
  %beta_in = view.load %beta_view[%h] : view<[%num_heads]xf32> -> f32
  %biased = scalar.addf %alpha_in, %dt : f32
  %over = scalar.cmpf ogt, %biased, %twenty : f32
  %softplus = scf.if %over -> (f32) {
    scf.yield %biased : f32
  } else {
    %exp_biased = scalar.expf<afn> %biased : f32
    %one_plus = scalar.addf %one, %exp_biased : f32
    %log_one_plus = scalar.logf<afn> %one_plus : f32
    scf.yield %log_one_plus : f32
  }
  %scaled = scalar.mulf %softplus, %a_val : f32
  %alpha_h = scalar.expf<afn> %scaled : f32
  %neg_beta = scalar.mulf %beta_in, %negone : f32
  %beta_exp = scalar.expf<afn> %neg_beta : f32
  %beta_den = scalar.addf %one, %beta_exp : f32
  %beta_h = scalar.divf %one, %beta_den : f32

  // 2. Key/query L2 normalization. q comes first in the conv row, then k.
  %q_base = index.mul %kh, %c128 : index
  %k_head = index.add %num_key_heads, %kh : index
  %k_base = index.mul %k_head, %c128 : index
  %lane_quad = index.mul %lane, %c4 : index
  %k_sq = scf.for %i = [%c0 to %c4 step %c1](%acc = %zero : f32) -> (f32) {
    %e = index.add %lane_quad, %i : index
    %ki = index.add %k_base, %e : index
    %kv = view.load %conv_view[%ki] : view<[%conv_total]xf32> -> f32
    %kk = scalar.mulf %kv, %kv : f32
    %next = scalar.addf %acc, %kk : f32
    scf.yield %next : f32
  }
  %k_sq_all = kernel.subgroup.reduce<addf> %k_sq : f32
  %k_eps = scalar.addf %k_sq_all, %epsilon : f32
  %k_root = scalar.sqrtf %k_eps : f32
  %inv_k = scalar.divf %one, %k_root : f32
  %q_sq = scf.for %i2 = [%c0 to %c4 step %c1](%acc2 = %zero : f32) -> (f32) {
    %e2 = index.add %lane_quad, %i2 : index
    %qi = index.add %q_base, %e2 : index
    %qv = view.load %conv_view[%qi] : view<[%conv_total]xf32> -> f32
    %qq = scalar.mulf %qv, %qv : f32
    %next2 = scalar.addf %acc2, %qq : f32
    scf.yield %next2 : f32
  }
  %q_sq_all = kernel.subgroup.reduce<addf> %q_sq : f32
  %q_eps = scalar.addf %q_sq_all, %epsilon : f32
  %q_root = scalar.sqrtf %q_eps : f32
  %inv_q = scalar.divf %one, %q_root : f32
  %dim_i = index.cast %c128 : index to i32
  %dim_f = scalar.sitofp %dim_i : i32 to f32
  %dim_root = scalar.sqrtf %dim_f : f32
  %inv_dim = scalar.divf %one, %dim_root : f32
  %q_scale = scalar.mulf %inv_dim, %inv_q : f32

  // 3. One pass over the four value rows this lane owns: u, d, in-place state
  // update, raw readout o_j, and the sum of squares of the readouts.
  %v_head = index.mul %h, %c128 : index
  %v_base = index.add %qk2_total, %v_head : index
  %h_row = index.mul %h, %c16384 : index
  %sq = scf.for %m = [%c0 to %c4 step %c1](%acc3 = %zero : f32) -> (f32) {
    %m32 = index.mul %m, %c32 : index
    %j = index.add %lane, %m32 : index
    %row = index.mul %j, %c128 : index
    %row_base = index.add %h_row, %row : index
    %u = scf.for %i3 = [%c0 to %c128 step %c1](%ua = %zero : f32) -> (f32) {
      %si = index.add %row_base, %i3 : index
      %st = view.load %state_view[%si] : view<[%state_total]xf32> -> f32
      %ki2 = index.add %k_base, %i3 : index
      %kv2 = view.load %conv_view[%ki2] : view<[%conv_total]xf32> -> f32
      %kn = scalar.mulf %kv2, %inv_k : f32
      %sa = scalar.mulf %st, %alpha_h : f32
      %uk = scalar.mulf %sa, %kn : f32
      %u2 = scalar.addf %ua, %uk : f32
      scf.yield %u2 : f32
    }
    %vj_idx = index.add %v_base, %j : index
    %vj = view.load %conv_view[%vj_idx] : view<[%conv_total]xf32> -> f32
    %vsub = scalar.subf %vj, %u : f32
    %d = scalar.mulf %vsub, %beta_h : f32
    %oj = scf.for %i4 = [%c0 to %c128 step %c1](%oa = %zero : f32) -> (f32) {
      %si2 = index.add %row_base, %i4 : index
      %st2 = view.load %state_view[%si2] : view<[%state_total]xf32> -> f32
      %ki3 = index.add %k_base, %i4 : index
      %kv3 = view.load %conv_view[%ki3] : view<[%conv_total]xf32> -> f32
      %kn2 = scalar.mulf %kv3, %inv_k : f32
      %sa2 = scalar.mulf %st2, %alpha_h : f32
      %dk = scalar.mulf %d, %kn2 : f32
      %snew = scalar.addf %sa2, %dk : f32
      view.store %snew, %state_view[%si2] : f32, view<[%state_total]xf32>
      %qi2 = index.add %q_base, %i4 : index
      %qv2 = view.load %conv_view[%qi2] : view<[%conv_total]xf32> -> f32
      %qn = scalar.mulf %qv2, %q_scale : f32
      %ot = scalar.mulf %snew, %qn : f32
      %oa2 = scalar.addf %oa, %ot : f32
      scf.yield %oa2 : f32
    }
    %out_idx = index.add %v_head, %j : index
    view.store %oj, %out_view[%out_idx] : f32, view<[%head_total]xf32>
    %oj_sq = scalar.mulf %oj, %oj : f32
    %next3 = scalar.addf %acc3, %oj_sq : f32
    scf.yield %next3 : f32
  }
  %sq_all = kernel.subgroup.reduce<addf> %sq : f32

  // 4. Per-head RMSNorm on the readouts, then the SiLU gate.
  %mean_sq = scalar.divf %sq_all, %dim_f : f32
  %mean_eps = scalar.addf %mean_sq, %epsilon : f32
  %rms_root = scalar.sqrtf %mean_eps : f32
  %rms = scalar.divf %one, %rms_root : f32
  %sink = scf.for %m2 = [%c0 to %c4 step %c1](%mark = %zero : f32) -> (f32) {
    %m32b = index.mul %m2, %c32 : index
    %j2 = index.add %lane, %m32b : index
    %idx2 = index.add %v_head, %j2 : index
    %raw = view.load %out_view[%idx2] : view<[%head_total]xf32> -> f32
    %w = view.load %norm_view[%j2] : view<[%c128]xf32> -> f32
    %normed = scalar.mulf %raw, %rms : f32
    %weighted = scalar.mulf %normed, %w : f32
    %g = view.load %gate_view[%idx2] : view<[%head_total]xf32> -> f32
    %neg_g = scalar.mulf %g, %negone : f32
    %g_exp = scalar.expf<afn> %neg_g : f32
    %g_den = scalar.addf %one, %g_exp : f32
    %sig = scalar.divf %one, %g_den : f32
    %silu = scalar.mulf %g, %sig : f32
    %val = scalar.mulf %weighted, %silu : f32
    view.store %val, %out_view[%idx2] : f32, view<[%head_total]xf32>
    scf.yield %mark : f32
  }
  kernel.return
}

// Requires --config=yah_deltanet_decode.num_heads=4, .num_key_heads=2.
//
// Random fixture generated by fixtures/deltanet_decode_resident/generate.py,
// which evaluates the recurrence above in float64 numpy from the same float32
// inputs. The kernel runs in float32 (mul/add, not fma), so the comparison
// carries a small tolerance. The case exercises kh = h % 2 != h (heads 2,3 read
// the kh=0 q/k rows), all four value rows per lane, and the in-place state walk.
check.case public @yah_deltanet_decode_case {
  %conv = check.file.read.npy path("fixtures/deltanet_decode_resident/input_conv.npy") : tensor<1024xf32>
  %state = check.file.read.npy path("fixtures/deltanet_decode_resident/input_state.npy") : tensor<65536xf32>
  %alpha = check.file.read.npy path("fixtures/deltanet_decode_resident/input_alpha.npy") : tensor<4xf32>
  %beta = check.file.read.npy path("fixtures/deltanet_decode_resident/input_beta.npy") : tensor<4xf32>
  %ssm_a = check.file.read.npy path("fixtures/deltanet_decode_resident/input_ssm_a.npy") : tensor<4xf32>
  %ssm_dt = check.file.read.npy path("fixtures/deltanet_decode_resident/input_ssm_dt.npy") : tensor<4xf32>
  %ssm_norm = check.file.read.npy path("fixtures/deltanet_decode_resident/input_ssm_norm.npy") : tensor<128xf32>
  %gate = check.file.read.npy path("fixtures/deltanet_decode_resident/input_gate.npy") : tensor<512xf32>
  %expected_out = check.file.read.npy path("fixtures/deltanet_decode_resident/expected_out.npy") : tensor<512xf32>
  %expected_state = check.file.read.npy path("fixtures/deltanet_decode_resident/expected_state.npy") : tensor<65536xf32>
  %out = check.generate.fill value(0.0) : tensor<512xf32>
  kernel.launch @yah_deltanet_decode(%conv, %state, %alpha, %beta, %ssm_a, %ssm_dt, %ssm_norm, %gate, %out) : (tensor<1024xf32>, tensor<65536xf32>, tensor<4xf32>, tensor<4xf32>, tensor<4xf32>, tensor<4xf32>, tensor<128xf32>, tensor<512xf32>, tensor<512xf32>)
  check.expect.close actual(%out) expected(%expected_out) atol(0.00001) rtol(0.00001) nan(same) : tensor<512xf32>
  check.expect.close actual(%state) expected(%expected_state) atol(0.00001) rtol(0.00001) nan(same) : tensor<65536xf32>
  check.return
}

check.benchmark<@yah_deltanet_decode_case> @yah_deltanet_decode_bench

// Requires --config=yah_deltanet_decode.num_heads=32, .num_key_heads=16.
//
// Production geometry for this shard (ssm_time_step_rank 32, ssm_group_count 16,
// ssm_state_size 128, ssm_inner_size 4096). The inputs make the recurrence
// analytic and exact: ssm_a = 0 so alpha_h = exp(0) = 1, beta = 20 so
// beta_h = 1/(1+exp(-20)) rounds to exactly 1 in fp32, state starts at 0, k, q
// and v are all ones and gate is 0, so
//
//   u_j = 0, d_j = 1, S'[j][i] = 1 * inv_k, inv_k = 1/sqrt(128 + 1e-6) = 1/sqrt(128)
//   out = o_j * rms * 1 * (0 * sigmoid(0)) = 0
//
// The expected state is therefore the constant inv_k = 0.0883883461356163
// everywhere (the fp32 value 1/sqrt(128)), and the expected output is zero. This
// pins the head/value-row/key indexing at the real shape, the state walk and the
// RMSNorm/gate path, and gives the number worth reading. The fixture case above
// is what proves the full non-degenerate arithmetic.
check.case public @yah_deltanet_decode_scaled {
  %conv = check.generate.fill value(1.0) : tensor<8192xf32>
  %state = check.generate.fill value(0.0) : tensor<524288xf32>
  %alpha = check.generate.fill value(0.0) : tensor<32xf32>
  %beta = check.generate.fill value(20.0) : tensor<32xf32>
  %ssm_a = check.generate.fill value(0.0) : tensor<32xf32>
  %ssm_dt = check.generate.fill value(0.0) : tensor<32xf32>
  %ssm_norm = check.generate.fill value(1.0) : tensor<128xf32>
  %gate = check.generate.fill value(0.0) : tensor<4096xf32>
  %out = check.generate.fill value(0.0) : tensor<4096xf32>
  %expected_out = check.generate.fill value(0.0) : tensor<4096xf32>
  %expected_state = check.generate.fill value(0.0883883461356163) : tensor<524288xf32>
  kernel.launch @yah_deltanet_decode(%conv, %state, %alpha, %beta, %ssm_a, %ssm_dt, %ssm_norm, %gate, %out) : (tensor<8192xf32>, tensor<524288xf32>, tensor<32xf32>, tensor<32xf32>, tensor<32xf32>, tensor<32xf32>, tensor<128xf32>, tensor<4096xf32>, tensor<4096xf32>)
  check.expect.close actual(%out) expected(%expected_out) atol(0.0) rtol(0.0) nan(same) : tensor<4096xf32>
  check.expect.close actual(%state) expected(%expected_state) atol(0.000001) rtol(0.0) nan(same) : tensor<524288xf32>
  check.return
}

check.benchmark<@yah_deltanet_decode_scaled> @yah_deltanet_decode_scaled_bench
