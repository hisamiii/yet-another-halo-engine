// YAH FFN GEMM, LDS-staged with a shared multi-wave allocation.
//
// v7 (yah_ffn_gemm_lds.loom) proved the fetch shape is achievable -- fragment
// access gap 10224 -> 112 bytes, global loads halved -- but lost 19% because
// amdgpu.lds became the residency limiter: 10240 B of staging charged to a
// single-wave workgroup cost more residency than the 200 registers it saved.
//
// This version keeps the same 10240 B of staging but shares it across four waves,
// so the fetch is paid once and consumed four times:
//
//   activation 64 tokens x 64 K = 8192 B, shared by all four waves
//   weight     16 rows   x 64 K = 2048 B, shared by all four waves
//
// The workgroup therefore covers 16 rows x 64 tokens with four waves, and each
// wave owns a 16-token slice of the N dimension: wave w reads only tokens
// [w*16, w*16+16) and all 16 rows. Per K sub-step a wave issues one lhs and one
// rhs fragment load, both from LDS, and one MMA -- so the staging is amortised
// four ways instead of one.
//
// The fill is still wide: 32 lanes assigned four-per-row means one instruction
// covers 8 runs of 128 contiguous bytes. Two barriers per 64-K block.
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_lds4.m_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_lds4() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_lds4.m_tiles : index
  %workgroup_size = index.constant 128 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%weight: buffer, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c5120 = index.constant 5120 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index

  %kt_layout = encoding.layout.strided [1, 64] : encoding<layout>

  %weight_noalias, %input_noalias, %output_noalias = buffer.assume.noalias %weight, %input, %output : buffer, buffer, buffer
  %w_view = buffer.view %weight_noalias[%base] : buffer -> view<17408x5120xf16>
  %a_view = buffer.view %input_noalias[%base] : buffer -> view<64x5120xf16>
  %out_view = buffer.view %output_noalias[%base] : buffer -> view<17408x64xf32>

  %act_bytes = index.constant 8192 : offset
  %wgt_bytes = index.constant 2048 : offset
  %act = buffer.alloca<workgroup> align(16) %act_bytes : buffer
  %wgt = buffer.alloca<workgroup> align(16) %wgt_bytes : buffer
  %act_tk = buffer.view %act[%base] : buffer -> view<64x64xf16>
  %act_kt = buffer.view %act[%base] : buffer -> view<64x64xf16, %kt_layout>
  %wgt_view = buffer.view %wgt[%base] : buffer -> view<16x64xf16>

  %wi = kernel.workitem.id<x> : index
  %sub = kernel.subgroup.id : index
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %n_origin = index.mul %sub, %c16 : index
  %four = index.constant 4 : index
  %quad_row = index.div %wi, %four : index
  %quad = index.rem %wi, %four : index
  %klane = index.mul %quad, %c16 : index
  %eight = index.constant 8 : index
  %w_row = index.div %wi, %eight : index
  %w_klane = index.mul %quad, %c16 : index

  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc = scf.for %kb = [%c0 to %c5120 step %c64](%a0 = %init : vector<8xf32>) -> (vector<8xf32>) {
    %g0 = scf.for %p = [%c0 to %c2 step %c1](%idx = %c0 : index) -> (index) {
      %p32 = index.mul %p, %c32 : index
      %t = index.add %quad_row, %p32 : index
      %gk = index.add %kb, %klane : index
      %av = vector.load %a_view[%t, %gk] : view<64x5120xf16> -> vector<16xf16>
      vector.store %av, %act_tk[%t, %klane] : vector<16xf16>, view<64x64xf16>
      scf.yield %idx : index
    }
    %gr = index.add %m_origin, %w_row : index
    %gk2 = index.add %kb, %w_klane : index
    %wv = vector.load %w_view[%gr, %gk2] : view<17408x5120xf16> -> vector<16xf16>
    vector.store %wv, %wgt_view[%w_row, %w_klane] : vector<16xf16>, view<16x64xf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %l0 = vector.fragment.load<lhs> %wgt_view[%c0, %c0] shape [%m, %k] : view<16x64xf16> -> vector<16xf16>
    %r0 = vector.fragment.load<rhs> %act_kt[%c0, %n_origin] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %b0 = vector.mma %l0, %r0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %l1 = vector.fragment.load<lhs> %wgt_view[%c0, %c16] shape [%m, %k] : view<16x64xf16> -> vector<16xf16>
    %r1 = vector.fragment.load<rhs> %act_kt[%c16, %n_origin] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %b1 = vector.mma %l1, %r1, %b0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %l2 = vector.fragment.load<lhs> %wgt_view[%c0, %c32] shape [%m, %k] : view<16x64xf16> -> vector<16xf16>
    %r2 = vector.fragment.load<rhs> %act_kt[%c32, %n_origin] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %b2 = vector.mma %l2, %r2, %b1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %l3 = vector.fragment.load<lhs> %wgt_view[%c0, %c48] shape [%m, %k] : view<16x64xf16> -> vector<16xf16>
    %r3 = vector.fragment.load<rhs> %act_kt[%c48, %n_origin] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %b3 = vector.mma %l3, %r3, %b2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %b3 : vector<8xf32>
  }
  vector.fragment.store<result> %acc, %out_view[%m_origin, %n_origin] shape [%m, %n] : vector<8xf32>, view<17408x64xf32>
  kernel.return
}

check.case public @yah_ffn_gemm_lds4_case {
  %weight = check.generate.fill value(1.0) : tensor<17408x5120xf16>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<17408x64xf32>
  %expected = check.generate.fill value(5120.0) : tensor<17408x64xf32>
  kernel.launch @yah_ffn_gemm_lds4(%weight, %input, %output) : (tensor<17408x5120xf16>, tensor<64x5120xf16>, tensor<17408x64xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<17408x64xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_lds4_case> @yah_ffn_gemm_lds4_bench
