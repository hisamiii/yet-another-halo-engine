// YAH WMMA attention head packing, Loom port of PackAttentionHeads.
//
// HIP source: models/qwen/hip/kernels/attention_wmma.hip. K head-major is copied
// straight into the packed key buffer; V is transposed through a 16x(head_dim+8)
// LDS tile so the packed value buffer has one key block of 16 keys contiguous for
// each dimension:
//
//   head = blockIdx.x; base = blockIdx.y*16
//   Pass A (i = tid; i < 16*head_dim/8; i += 256):
//     key = i/(head_dim/8); dim = (i%(head_dim/8))*8
//     src = ((base+key)*kv_heads + head)*head_dim + dim
//     dst = (head*length + base+key)*head_dim + dim
//     if base+key < length: packed_keys[dst..+8] = keys[src..+8];
//                           tile[key][dim..+8]  = values[src..+8]
//     else:                 tile[key][dim..+8]  = 0
//   barrier
//   Pass B (i = tid; i < 16*head_dim/8; i += 256):
//     dim = i/2; key = (i%2)*8
//     packed_values[head*padded*head_dim + base*head_dim + dim*16 + key + j]
//         = tile[key+j][dim]   for j in 0..8
//
// The port keeps the LDS tile and both passes. It replaces the uint4 copies with
// element stores, which is the same bytes and lets the footprint analysis bound
// every access from the config ranges. key and dim are clamped to the tile; the
// pass-A guard makes the clamps no-ops.
//
// Required config: --config=yah_pack_attn_heads.head_dim=8 --config=yah_pack_attn_heads.kv_heads=1
//                  --config=yah_pack_attn_heads.length=16 --config=yah_pack_attn_heads.keys_elems=128
//                  --config=yah_pack_attn_heads.packed_k_elems=128 --config=yah_pack_attn_heads.packed_v_elems=128
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_pack_attn_heads.head_dim : %value: index where [range(%value, 8, 65536)]

config.decl @yah_pack_attn_heads.kv_heads : %value: index where [range(%value, 1, 65536)]

config.decl @yah_pack_attn_heads.length : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_pack_attn_heads.keys_elems : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_pack_attn_heads.packed_k_elems : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_pack_attn_heads.packed_v_elems : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@yah_wave32) @yah_pack_attn_heads() {
  %unit = index.constant 1 : index
  %head_dim = config.get @yah_pack_attn_heads.head_dim : index
  %kv_heads = config.get @yah_pack_attn_heads.kv_heads : index
  %length = config.get @yah_pack_attn_heads.length : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %hw8 = index.div %head_dim, %c8 : index
  %groups = index.mul %c2, %head_dim : index
  %biased = index.add %length, %c15 : index
  %key_blocks = index.div %biased, %c16 : index
  kernel.launch.config workgroups(%kv_heads, %key_blocks, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%keys: buffer, %values: buffer, %packed_keys: buffer, %packed_values: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c8i = scalar.constant 8 : i32
  %c16i = scalar.constant 16 : i32
  %zero16 = scalar.constant 0.0 : f16
  %head_dim = config.get @yah_pack_attn_heads.head_dim : index
  %kv_heads = config.get @yah_pack_attn_heads.kv_heads : index
  %length = config.get @yah_pack_attn_heads.length : index
  %keys_elems = config.get @yah_pack_attn_heads.keys_elems : index
  %packed_k_elems = config.get @yah_pack_attn_heads.packed_k_elems : index
  %packed_v_elems = config.get @yah_pack_attn_heads.packed_v_elems : index
  %hw8 = index.div %head_dim, %c8 : index
  %groups = index.mul %c2, %head_dim : index
  %length15 = index.add %length, %c15 : index
  %length_i = index.cast %length15 : index to i32
  %cneg16i = scalar.constant -16 : i32
  %padded_i = scalar.andi %length_i, %cneg16i : i32
  %padded = index.cast %padded_i : i32 to index
  %head_dim_m8 = index.sub %head_dim, %c8 : index
  %head_dim_m1 = index.sub %head_dim, %c1 : index
  %tile_stride = index.add %head_dim, %c8 : index
  %tile_elems = index.mul %c16, %tile_stride : index
  %tile_bytes_i = index.cast %tile_elems : index to i32
  %tile_bytes_2 = scalar.shli %tile_bytes_i, %c1i : i32
  %tile_bytes = index.cast %tile_bytes_2 : i32 to offset
  %scratch = buffer.alloca<workgroup> align(16) %tile_bytes : buffer
  %tile = buffer.view %scratch[%base] : buffer -> view<[%tile_elems]xf16>
  %keys_na, %values_na, %pk_na, %pv_na = buffer.assume.noalias %keys, %values, %packed_keys, %packed_values : buffer, buffer, buffer, buffer
  %keys_view = buffer.view %keys_na[%base] : buffer -> view<[%keys_elems]xf16>
  %values_view = buffer.view %values_na[%base] : buffer -> view<[%keys_elems]xf16>
  %pk_view = buffer.view %pk_na[%base] : buffer -> view<[%packed_k_elems]xf16>
  %pv_view = buffer.view %pv_na[%base] : buffer -> view<[%packed_v_elems]xf16>
  %head = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wgy = kernel.workgroup.id<y> : index
  %base16 = index.mul %wgy, %c16 : index
  // Pass A.
  %pass_a = scf.for %i = [%lane to %groups step %c256](%m1 = %c0 : index) -> (index) {
    %key = index.div %i, %hw8 : index
    %rem = index.rem %i, %hw8 : index
    %dim = index.mul %rem, %c8 : index
    %key_c = index.min %key, %c15 : index
    %dim_c = index.min %dim, %head_dim_m8 : index
    %keybase = index.add %base16, %key_c : index
    %in_range = index.cmp ult, %keybase, %length : index
    %row = index.add %key_c, %c0 : index
    %row_s = index.mul %row, %tile_stride : index
    %tile_base = index.add %row_s, %dim_c : index
    %inner = scf.for %j = [%c0 to %c8 step %c1](%m2 = %c0 : index) -> (index) {
      %tj = index.add %tile_base, %j : index
      %loaded = scf.if %in_range -> (f16) {
        %src_pre = index.mul %keybase, %kv_heads : index
        %src_pre2 = index.add %src_pre, %head : index
        %src_pre3 = index.mul %src_pre2, %head_dim : index
        %src_pre4 = index.add %src_pre3, %dim_c : index
        %src = index.add %src_pre4, %j : index
        %vv = view.load %values_view[%src] : view<[%keys_elems]xf16> -> f16
        %dst_pre = index.mul %head, %length : index
        %dst_pre2 = index.add %dst_pre, %keybase : index
        %dst_pre3 = index.mul %dst_pre2, %head_dim : index
        %dst_pre4 = index.add %dst_pre3, %dim_c : index
        %dst = index.add %dst_pre4, %j : index
        %kv = view.load %keys_view[%src] : view<[%keys_elems]xf16> -> f16
        view.store %kv, %pk_view[%dst] : f16, view<[%packed_k_elems]xf16>
        scf.yield %vv : f16
      } else {
        scf.yield %zero16 : f16
      }
      view.store %loaded, %tile[%tj] : f16, view<[%tile_elems]xf16>
      scf.yield %m2 : index
    }
    scf.yield %inner : index
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // Pass B: transpose the value tile into packed_values.
  %pass_b = scf.for %i2 = [%lane to %groups step %c256](%m3 = %c0 : index) -> (index) {
    %dim2 = index.div %i2, %c2 : index
    %keypart = index.rem %i2, %c2 : index
    %key2 = index.mul %keypart, %c8 : index
    %dim2_c = index.min %dim2, %head_dim_m1 : index
    %key2_c = index.min %key2, %c15 : index
    %inner2 = scf.for %j2 = [%c0 to %c8 step %c1](%m4 = %c0 : index) -> (index) {
      %kj = index.add %key2_c, %j2 : index
      %kj_s = index.mul %kj, %tile_stride : index
      %tile_idx = index.add %kj_s, %dim2_c : index
      %val = view.load %tile[%tile_idx] : view<[%tile_elems]xf16> -> f16
      %hp = index.mul %head, %padded : index
      %hp_d = index.mul %hp, %head_dim : index
      %bd = index.mul %base16, %head_dim : index
      %d16 = index.mul %dim2_c, %c16 : index
      %pre = index.add %hp_d, %bd : index
      %pre2 = index.add %pre, %d16 : index
      %pre3 = index.add %pre2, %key2_c : index
      %dst2 = index.add %pre3, %j2 : index
      view.store %val, %pv_view[%dst2] : f16, view<[%packed_v_elems]xf16>
      scf.yield %m4 : index
    }
    scf.yield %inner2 : index
  }
  kernel.return
}

// Requires the config above. One KV head, 16 keys of 8 dims. keys = iota 0..127
// (the packed key copy is the same iota) and values = iota 0..127, so the packed
// value buffer is the pure [key][dim] -> [dim][key] 16x8 transpose, compared
// against a float16 fixture.
check.case public @yah_pack_attn_heads_case {
  %keys = check.generate.iota offset(0.0) step(1.0) : tensor<128xf16>
  %values = check.generate.iota offset(0.0) step(1.0) : tensor<128xf16>
  %pk = check.generate.fill value(0.0) : tensor<128xf16>
  %pv = check.generate.fill value(0.0) : tensor<128xf16>
  %expected_pk = check.generate.iota offset(0.0) step(1.0) : tensor<128xf16>
  %expected_pv = check.file.read.npy path("fixtures/pack_attn_heads/packed_v.npy") : tensor<128xf16>
  kernel.launch @yah_pack_attn_heads(%keys, %values, %pk, %pv) : (tensor<128xf16>, tensor<128xf16>, tensor<128xf16>, tensor<128xf16>)
  check.expect.close actual(%pk) expected(%expected_pk) atol(0.0) rtol(0.0) nan(same) : tensor<128xf16>
  check.expect.close actual(%pv) expected(%expected_pv) atol(0.0) rtol(0.0) nan(same) : tensor<128xf16>
  check.return
}

check.benchmark<@yah_pack_attn_heads_case> @yah_pack_attn_heads_bench
