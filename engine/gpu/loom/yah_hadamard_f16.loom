// YAH in-place Hadamard transform on fp16 storage, Loom port of
// HadamardInPlaceHalfKernel.
//
// HIP source: engine/kv/kv_quant.hip. Identical to the fp32 variant except that
// the row lives in fp16: the staging read widens each element, the transform is
// f32, and the store rounds back.
//
//   row[d] = f32(x[r][d])                  (workgroup memory, f32)
//   x[r][e] = f16(sum_d row[d] * h[d][e])
//
// dim is kKvBlock = 32, so one subgroup per row, one lane per output element, and
// a serial 32-term inner product per lane.
//
// The check uses rows = 1 so the expectation stays expressible, and scales h so
// the result survives fp16 without rounding. With x all ones and
// h[d][e] = (d*32 + e)/16, element e is
//
//   sum_d (d*32 + e)/16 = (15872 + 32*e)/16 = 992 + 2*e
//
// an arithmetic sequence that is exactly representable in fp16 (below 2048, and a
// multiple of 1/16). The unscaled version summed to 15872 + 32*e, which fp16 rounds,
// so the expectation would no longer be a single iota. A transposition of d and e
// changes the sequence. At rows > 1 the pattern repeats per row and no single iota
// describes the tensor; that path needs a captured fixture.
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_hadamard16.rows : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_hadamard16() {
  %unit = index.constant 1 : index
  %rows = config.get @yah_hadamard16.rows : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%x: buffer, %h: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %rows = config.get @yah_hadamard16.rows : index
  %zero = scalar.constant 0.0 : f32
  %row_bytes = index.constant 128 : offset
  %scratch = buffer.alloca<workgroup> align(16) %row_bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<32xf32>
  %x_noalias, %h_noalias = buffer.assume.noalias %x, %h : buffer, buffer
  %x_view = buffer.view %x_noalias[%base] : buffer -> view<[%rows]x32xf16>
  %h_view = buffer.view %h_noalias[%base] : buffer -> view<32x32xf32>
  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %staged_half = view.load %x_view[%row, %lane] : view<[%rows]x32xf16> -> f16
  %staged = scalar.extf %staged_half : f16 to f32
  view.store %staged, %scratch_view[%lane] : f32, view<32xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %acc = scf.for %d = [%c0 to %c32 step %c1](%sum = %zero : f32) -> (f32) {
    %rd = view.load %scratch_view[%d] : view<32xf32> -> f32
    %hv = view.load %h_view[%d, %lane] : view<32x32xf32> -> f32
    %prod = scalar.mulf %rd, %hv : f32
    %next = scalar.addf %sum, %prod : f32
    scf.yield %next : f32
  }
  %result = scalar.fptrunc %acc : f32 to f16
  view.store %result, %x_view[%row, %lane] : f16, view<[%rows]x32xf16>
  kernel.return
}

// Requires --config=yah_hadamard16.rows=1.
check.case public @yah_hadamard16_case {
  %x = check.generate.fill value(1.0) : tensor<1x32xf16>
  %h = check.generate.iota offset(0.0) step(0.0625) : tensor<32x32xf32>
  %expected = check.generate.iota offset(992.0) step(2.0) : tensor<1x32xf16>
  kernel.launch @yah_hadamard16(%x, %h) : (tensor<1x32xf16>, tensor<32x32xf32>)
  check.expect.close actual(%x) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x32xf16>
  check.return
}

check.benchmark<@yah_hadamard16_case> @yah_hadamard16_bench
