// YAH DFlash selector partial top-k, Loom port of dflash_selector_partial_topk_kernel.
//
// HIP source: dflash_kernels.hip. Each block reduces a `tokens_per_block` slice of the
// logits to the `selector_top_k` largest (score, token) pairs and writes the partial
// list. HIP keeps a descending top-k list per thread in registers and tree-merges the
// 128 lists; Loom has no register arrays, so the port uses an equivalent iterative
// selection instead: for each of the top_k slots, the block selects the maximum score
// that is strictly behind the previous pick in (score desc, token asc) order, then the
// smallest token among the ties. That is the same ordering the HIP insert/merge
// produces (strict `>` insertion keeps lower token indices first, and the merge prefers
// the lower thread slot on ties).
//
// Required config: --config=yah_dflash_topk.vocab_size=8 --config=yah_dflash_topk.batch=1
//                  --config=yah_dflash_topk.tokens_per_block=2048 --config=yah_dflash_topk.top_k=4
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_dflash_topk.vocab_size : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_dflash_topk.batch : %value: index where [range(%value, 1, 65536)]

config.decl @yah_dflash_topk.tokens_per_block : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_dflash_topk.top_k : %value: index where [range(%value, 1, 16)]

kernel.def target(@yah_wave32) @yah_dflash_topk() {
  %unit = index.constant 1 : index
  %vocab_size = config.get @yah_dflash_topk.vocab_size : index
  %tokens_per_block = config.get @yah_dflash_topk.tokens_per_block : index
  %batch = config.get @yah_dflash_topk.batch : index
  %c1 = index.constant 1 : index
  %tpbm1 = index.sub %tokens_per_block, %c1 : index
  %biased2 = index.add %vocab_size, %tpbm1 : index
  %blocks_x = index.div %biased2, %tokens_per_block : index
  %c128 = index.constant 128 : index
  kernel.launch.config workgroups(%blocks_x, %batch, %unit) workgroup_size(%c128, %unit, %unit) : index
} launch(%logits: buffer, %partial_scores: buffer, %partial_ids: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c128 = index.constant 128 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %cneg1i = scalar.constant -1 : i32
  %cmax_i = scalar.constant 2147483647 : i32
  %pos_infinite = scalar.constant 3.9999999999999999e+38 : f32
  %neg_infinite = scalar.constant -3.9999999999999999e+38 : f32
  %zero = scalar.constant 0.0 : f32
  %vocab_size = config.get @yah_dflash_topk.vocab_size : index
  %batch = config.get @yah_dflash_topk.batch : index
  %tokens_per_block = config.get @yah_dflash_topk.tokens_per_block : index
  %top_k = config.get @yah_dflash_topk.top_k : index
  %tpbm1 = index.sub %tokens_per_block, %c1 : index
  %biased2 = index.add %vocab_size, %tpbm1 : index
  %blocks_x = index.div %biased2, %tokens_per_block : index
  %logits_elems = index.mul %batch, %vocab_size : index
  %bb = index.mul %batch, %blocks_x : index
  %partial_elems = index.mul %bb, %top_k : index
  %topk_bytes_i = index.cast %top_k : index to i32
  %topk_bytes_4 = scalar.shli %topk_bytes_i, %c2i : i32
  %topk_bytes = index.cast %topk_bytes_4 : i32 to offset
  %pick_s_buf = buffer.alloca<workgroup> align(16) %topk_bytes : buffer
  %pick_i_buf = buffer.alloca<workgroup> align(16) %topk_bytes : buffer
  %pick_s = buffer.view %pick_s_buf[%base] : buffer -> view<[%top_k]xf32>
  %pick_i = buffer.view %pick_i_buf[%base] : buffer -> view<[%top_k]xi32>
  %logits_na, %ps_na, %pi_na = buffer.assume.noalias %logits, %partial_scores, %partial_ids : buffer, buffer, buffer
  %logits_view = buffer.view %logits_na[%base] : buffer -> view<[%logits_elems]xf32>
  %ps_view = buffer.view %ps_na[%base] : buffer -> view<[%partial_elems]xf32>
  %pi_view = buffer.view %pi_na[%base] : buffer -> view<[%partial_elems]xi32>
  %block = kernel.workgroup.id<x> : index
  %bi = kernel.workgroup.id<y> : index
  %tid = kernel.workitem.id<x> : index
  %row = index.mul %bi, %vocab_size : index
  %begin = index.mul %block, %tokens_per_block : index
  %req_end = index.add %begin, %tokens_per_block : index
  %end = index.min %req_end, %vocab_size : index
  %tok_start = index.add %begin, %tid : index
  %picks_s, %picks_i = scf.for %pick = [%c0 to %top_k step %c1](%prev_s = %pos_infinite : f32, %prev_i = %cneg1i : i32) -> (f32, i32) {
    %local_max = scf.for %i = [%tok_start to %end step %c128](%m = %neg_infinite : f32) -> (f32) {
      %li = index.add %row, %i : index
      %score = view.load %logits_view[%li] : view<[%logits_elems]xf32> -> f32
      %i_i = index.cast %i : index to i32
      %lt = scalar.cmpf olt, %score, %prev_s : f32
      %eq = scalar.cmpf oeq, %score, %prev_s : f32
      %gt_i = scalar.cmpi sgt, %i_i, %prev_i : i32
      %eligible = scf.if %lt -> (i1) {
        %t = scalar.constant 1 : i1
        scf.yield %t : i1
      } else {
        %e = scf.if %eq -> (i1) {
          %g = scf.if %gt_i -> (i1) {
            %t2 = scalar.constant 1 : i1
            scf.yield %t2 : i1
          } else {
            %f2 = scalar.constant 0 : i1
            scf.yield %f2 : i1
          }
          scf.yield %g : i1
        } else {
          %f3 = scalar.constant 0 : i1
          scf.yield %f3 : i1
        }
        scf.yield %e : i1
      }
      %nm = scf.if %eligible -> (f32) {
        %big = scalar.cmpf ogt, %score, %m : f32
        %b = scf.if %big -> (f32) {
          scf.yield %score : f32
        } else {
          scf.yield %m : f32
        }
        scf.yield %b : f32
      } else {
        scf.yield %m : f32
      }
      scf.yield %nm : f32
    }
    %gmax = kernel.workgroup.reduce<maxnumf> %local_max : f32
    %local_id = scf.for %j = [%tok_start to %end step %c128](%mi = %cmax_i : i32) -> (i32) {
      %lj = index.add %row, %j : index
      %score2 = view.load %logits_view[%lj] : view<[%logits_elems]xf32> -> f32
      %j_i = index.cast %j : index to i32
      %lt2 = scalar.cmpf olt, %score2, %prev_s : f32
      %eq2 = scalar.cmpf oeq, %score2, %prev_s : f32
      %gt_i2 = scalar.cmpi sgt, %j_i, %prev_i : i32
      %eligible2 = scf.if %lt2 -> (i1) {
        %t = scalar.constant 1 : i1
        scf.yield %t : i1
      } else {
        %e = scf.if %eq2 -> (i1) {
          %g = scf.if %gt_i2 -> (i1) {
            %t2 = scalar.constant 1 : i1
            scf.yield %t2 : i1
          } else {
            %f2 = scalar.constant 0 : i1
            scf.yield %f2 : i1
          }
          scf.yield %g : i1
        } else {
          %f3 = scalar.constant 0 : i1
          scf.yield %f3 : i1
        }
        scf.yield %e : i1
      }
      %istle = scalar.cmpf oeq, %score2, %gmax : f32
      %nm = scf.if %eligible2 -> (i32) {
        %cand = scf.if %istle -> (i32) {
          %smaller = scalar.cmpi slt, %j_i, %mi : i32
          %s = scf.if %smaller -> (i32) {
            scf.yield %j_i : i32
          } else {
            scf.yield %mi : i32
          }
          scf.yield %s : i32
        } else {
          scf.yield %mi : i32
        }
        scf.yield %cand : i32
      } else {
        scf.yield %mi : i32
      }
      scf.yield %nm : i32
    }
    %gmin = kernel.workgroup.reduce<minui> %local_id : i32
    view.store %gmax, %pick_s[%pick] : f32, view<[%top_k]xf32>
    view.store %gmin, %pick_i[%pick] : i32, view<[%top_k]xi32>
    scf.yield %gmax, %gmin : f32, i32
  }
  %bi_bx = index.mul %bi, %blocks_x : index
  %bi_bx_block = index.add %bi_bx, %block : index
  %out_base = index.mul %bi_bx_block, %top_k : index
  %outloop = scf.for %o = [%tid to %top_k step %c128](%m3 = %c0 : index) -> (index) {
    %s_slot = index.add %out_base, %o : index
    %sv = view.load %pick_s[%o] : view<[%top_k]xf32> -> f32
    %iv = view.load %pick_i[%o] : view<[%top_k]xi32> -> i32
    view.store %sv, %ps_view[%s_slot] : f32, view<[%partial_elems]xf32>
    view.store %iv, %pi_view[%s_slot] : i32, view<[%partial_elems]xi32>
    scf.yield %m3 : index
  }
  kernel.return
}

// Requires --config=yah_dflash_topk.vocab_size=8, .batch=1, .tokens_per_block=2048, .top_k=4.
// logits = {0,7,1,6,2,5,3,4}; the block keeps the four largest as (7,1),(6,3),(5,5),(4,7).
check.case public @yah_dflash_topk_case {
  %logits = check.file.read.npy path("fixtures/dflash_topk/logits.npy") : tensor<8xf32>
  %ps = check.generate.fill value(0.0) : tensor<4xf32>
  %pi = check.generate.fill value(0) : tensor<4xi32>
  %es = check.file.read.npy path("fixtures/dflash_topk/scores.npy") : tensor<4xf32>
  %ei = check.file.read.npy path("fixtures/dflash_topk/ids.npy") : tensor<4xi32>
  kernel.launch @yah_dflash_topk(%logits, %ps, %pi) : (tensor<8xf32>, tensor<4xf32>, tensor<4xi32>)
  check.expect.close actual(%ps) expected(%es) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.expect.equal actual(%pi) expected(%ei) : tensor<4xi32>
  check.return
}

check.benchmark<@yah_dflash_topk_case> @yah_dflash_topk_bench
