// YAH FFN GEMM with in-kernel Q6_K weight decode, Loom port of
// HalfPrefillGemmKernel<..., kQ6_K, kStore>.
//
// HIP source: prefill_fp16.hip, element decoder Q6KValue / DecodeQuantSub16 in
// quant_ops.hpp. The weight stays packed Q6_K and is decoded inside the K loop.
//
//   out[token*m + row] = sum_k q6k_decode(W, row, k) * f16(A[token][k])
//
// block_q6_K is 210 bytes and holds 256 weights:
//   uint8 ql[128]; uint8 qh[64]; int8 scales[16]; half d
// element i of the block is
//   half = i/128; within = i%128; segment = within/32; lane = within%32
//   low  = segment 0/2 ? ql[half*64 + lane] & 0xF
//                       : ql[half*64 + 32 + lane] & 0xF
//          (segments 2/3 take the high nibble of the same two bytes)
//   high = (qh[half*32 + lane] >> (2*segment)) & 3
//   scale = scales[half*8 + lane/16 + segment*2]        (int8)
//   value = f32(d) * f32(scale) * f32(((high << 4) | low) - 32)
//
// BLOCK ORDER: unlike Q6_K, block_q6_K stores d last (offset 208), so the fp16
// d view index is blk_off/2 + 104. ql/qh/scales start at 0, 128 and 192. The
// fixture and yah_dequant_q6k_bf16 both follow this order.
//
// Schedule, correctness first and tuning deferred: one workgroup per 16-row
// tile, one wave. For each K step of 16 the 32 lanes decode the 16x16 weight
// tile into the wstage global scratch, vector.fragment.load<lhs> reads it back,
// four 16x16x16 MMAs cover the four N sub-tiles, and the accumulators go through
// an ostage global scratch to the output with scalar stores so the output index
// can follow the m_tiles config. Both fragment operands are staged through
// global memory rather than LDS: a fragment load or store against a
// buffer.alloca<workgroup> view compiles but does not produce the tile the
// target reads, and the global form is the one yah_ffn_gemm_f16 validates.
//
// Measured: 17.47 ms at m_tiles=1088 (production 17408 rows), against the HIP
// Q4_K kernel at 1.197 ms and the Q4_K port at 23.31 ms. The levers, all
// deferred: decode a whole 256-wide block once per workgroup and reuse its
// scale bytes across 16 K steps, keep the staged tile in LDS instead of global,
// and drop the full-width 178 MB staging buffer in favour of a 16-column tile
// once the LDS fragment path is understood. 0.555 ms at m_tiles=1.
//
// Two cases, because the correctness shape and the production shape need
// different configs:
//   @yah_ffn_gemm_q6k_case       m_tiles=1    packed fixture, captured reference
//   @yah_ffn_gemm_q6k_full_case  m_tiles=1088 all-zero weight, output must be 0
// The all-zero weight is a valid Q6_K block (d = 0) and exercises the full
// decode path at production size; the fixture case pins the decode arithmetic.
// The fixture case uses atol/rtol 1e-5 like yah_ffn_gemm_q8_0_f32: the decode is
// bit-exact against Q6KValue (all 81920 block-row elements), but the f32 MMA
// accumulator rounds once per 16-wide K step, which leaves a max absolute error
// of 1.9e-6 at K = 5120. Half the outputs are still exact.
//
// Required config (correctness): --config=yah_ffn_gemm_q6k.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_q6k.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_q6k.m_tiles : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_q6k.k_blocks : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_q6k.token_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_q6k() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_q6k.m_tiles : index
  %token_tiles = config.get @yah_ffn_gemm_q6k.token_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %token_tiles, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %input: buffer, %wstage: buffer, %ostage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c5120 = index.constant 5120 : index
  %c33600 = index.constant 33600 : index
  %c67200 = index.constant 67200 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c104i = scalar.constant 104 : i32
  %c128i = scalar.constant 128 : i32
  %c192i = scalar.constant 192 : i32
  %c210i = scalar.constant 210 : i32
  %c255i = scalar.constant 255 : i32
  %c4200i = scalar.constant 4200 : i32
  %m_tiles = config.get @yah_ffn_gemm_q6k.m_tiles : index
  %k_blocks = config.get @yah_ffn_gemm_q6k.k_blocks : index
  %token_tiles = config.get @yah_ffn_gemm_q6k.token_tiles : index
  %cbb = index.constant 210 : index
  %cbb2 = index.constant 105 : index
  %ktot = index.mul %k_blocks, %c256 : index
  %tokens = index.mul %token_tiles, %c64 : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %bpr = index.mul %k_blocks, %cbb : index
  %hpr = index.mul %k_blocks, %cbb2 : index
  %w_bytes = index.mul %m_rows, %bpr : index
  %w_halfs = index.mul %m_rows, %hpr : index
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %out_total = index.mul %m_rows, %tokens : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [%c1, %ktot] : encoding<layout>
  %weight_na, %input_na, %wstage_na, %ostage_na, %output_na = buffer.assume.noalias %weight, %input, %wstage, %ostage, %output : buffer, buffer, buffer, buffer, buffer
  %wg_y = kernel.workgroup.id<y> : index
  %token_base = index.mul %wg_y, %c64 : index
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<[%ktot]x[%tokens]xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf32>
  %wstage_view = buffer.view %wstage_na[%base] : buffer -> view<[%stage_rows]x[%c16]xf16>
  %ostage_view = buffer.view %ostage_na[%base] : buffer -> view<[%stage_rows]x[%tokens]xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %k_blocks_i = index.cast %k_blocks : index to i32
  %bpr_i = scalar.muli %k_blocks_i, %c210i : i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc0, %acc1, %acc2, %acc3 = scf.for %kk = [%c0 to %ktot step %c16](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32
    %j_sink = scf.for %j = [%c0 to %c8 step %c1](%mk = %c0 : index) -> (index) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %e_i = scalar.addi %lane_i, %j32 : i32
      %r_i = scalar.shrui %e_i, %c4i : i32
      %c_i = scalar.andi %e_i, %c15i : i32
      %i_i = scalar.addi %kbase, %c_i : i32
      %row_i = scalar.addi %m_origin_i, %r_i : i32
      %row_off = scalar.muli %row_i, %bpr_i : i32
      %blk_off0 = scalar.muli %kblk, %c210i : i32
      %blk_off = scalar.addi %row_off, %blk_off0 : i32
      %group = scalar.shrui %i_i, %c5i : i32
      %half = scalar.shrui %group, %c2i : i32
      %segment = scalar.andi %group, %c3i : i32
      %h16b = scalar.andi %i_i, %c16i : i32
      %h16 = scalar.shrui %h16b, %c4i : i32
      %jj = scalar.andi %i_i, %c15i : i32
      %seg_ge2 = scalar.cmpi sge, %segment, %c2i : i32
      %ql_shift = scf.if %seg_ge2 -> (i32) {
        scf.yield %c4i : i32
      } else {
        scf.yield %c0i : i32
      }
      %qh_shift = scalar.shli %segment, %c1i : i32
      %sego = scalar.andi %segment, %c1i : i32
      %half64 = scalar.shli %half, %c6i : i32
      %sego32 = scalar.shli %sego, %c5i : i32
      %ql_base = scalar.addi %half64, %sego32 : i32
      %ql1 = scalar.addi %blk_off, %ql_base : i32
      %ql2 = scalar.addi %ql1, %h16b : i32
      %ql_i = scalar.addi %ql2, %jj : i32
      %ql_ix = index.cast %ql_i : i32 to index
      %ql_lo = index.max %ql_ix, %c0 : index
      %ql_idx = index.min %ql_lo, %w_last : index
      %qlb8 = view.load %w_view[%ql_idx] : view<[%w_bytes]xi8> -> i8
      %qlb = scalar.extui %qlb8 : i8 to i32
      %low0 = scalar.shrui %qlb, %ql_shift : i32
      %low = scalar.andi %low0, %c15i : i32
      %half32 = scalar.shli %half, %c5i : i32
      %qh0 = scalar.addi %blk_off, %c128i : i32
      %qh1 = scalar.addi %qh0, %half32 : i32
      %qh2 = scalar.addi %qh1, %h16b : i32
      %qh_i = scalar.addi %qh2, %jj : i32
      %qh_ix = index.cast %qh_i : i32 to index
      %qh_lo = index.max %qh_ix, %c0 : index
      %qh_idx = index.min %qh_lo, %w_last : index
      %qhb8 = view.load %w_view[%qh_idx] : view<[%w_bytes]xi8> -> i8
      %qhb = scalar.extui %qhb8 : i8 to i32
      %high0 = scalar.shrui %qhb, %qh_shift : i32
      %high = scalar.andi %high0, %c3i : i32
      %high4 = scalar.shli %high, %c4i : i32
      %code = scalar.ori %low, %high4 : i32
      %bias = scalar.subi %code, %c32i : i32
      %bias_f = scalar.sitofp %bias : i32 to f32
      %half8 = scalar.shli %half, %c3i : i32
      %seg2 = scalar.shli %segment, %c1i : i32
      %sc0 = scalar.addi %blk_off, %c192i : i32
      %sc1 = scalar.addi %sc0, %half8 : i32
      %sc2 = scalar.addi %sc1, %seg2 : i32
      %sc_i32 = scalar.addi %sc2, %h16 : i32
      %sc_ix = index.cast %sc_i32 : i32 to index
      %sc_lo = index.max %sc_ix, %c0 : index
      %sc_idx = index.min %sc_lo, %w_last : index
      %sc8 = view.load %w_view[%sc_idx] : view<[%w_bytes]xi8> -> i8
      %sc_f = scalar.sitofp %sc8 : i8 to f32
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_i = scalar.addi %blk_half0, %c104i : i32
      %d_ix = index.cast %d_i : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %value = scalar.mulf %dsc, %bias_f : f32
      %h = scalar.fptrunc %value : f32 to f16
      %c_ix = index.cast %c_i : i32 to index
      %c_idx = index.max %c_ix, %c0 : index
      %row_ix = index.cast %row_i : i32 to index
      %row_lo = index.max %row_ix, %c0 : index
      %row = index.min %row_lo, %stage_last : index
      view.store %h, %wstage_view[%row, %c_idx] : f16, view<[%stage_rows]x[%c16]xf16>
      scf.yield %mk : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhs = vector.fragment.load<lhs> %wstage_view[%m_origin, %c0] shape [%m, %k] : view<[%stage_rows]x[%c16]xf16> -> vector<16xf16>
    %t16 = index.add %token_base, %c16 : index
    %t32 = index.add %token_base, %c32 : index
    %t48 = index.add %token_base, %c48 : index
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %token_base] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %t16] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %t32] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %t48] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %n0 = vector.mma %lhs, %rhs0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n1 = vector.mma %lhs, %rhs1, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n2 = vector.mma %lhs, %rhs2, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n3 = vector.mma %lhs, %rhs3, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %n0, %n1, %n2, %n3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %o16 = index.add %token_base, %c16 : index
  %o32 = index.add %token_base, %c32 : index
  %o48 = index.add %token_base, %c48 : index
  vector.fragment.store<result> %acc0, %ostage_view[%m_origin, %token_base] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc1, %ostage_view[%m_origin, %o16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc2, %ostage_view[%m_origin, %o32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc3, %ostage_view[%m_origin, %o48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %tok_g = index.add %token_base, %tok : index
    %val = view.load %ostage_view[%gr2, %tok_g] : view<[%stage_rows]x[%tokens]xf32> -> f32
    %tok_off = index.mul %tok_g, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    view.store %val, %out_view[%gflat] : f32, view<[%out_total]xf32>
    scf.yield %mk2 : index
  }
  kernel.return
}

// Requires --config=yah_ffn_gemm_q6k.m_tiles=1.
check.case public @yah_ffn_gemm_q6k_case {
  %weight = check.file.read.npy path("fixtures/q6k_gemm/input_q6k_gemm.npy") : tensor<67200xi8>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1024xf32>
  %expected = check.file.read.npy path("fixtures/q6k_gemm/expected_out.npy") : tensor<1024xf32>
  %wstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1024xf32>
  kernel.launch @yah_ffn_gemm_q6k(%weight, %input, %wstage, %ostage, %output) : (tensor<67200xi8>, tensor<64x5120xf16>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf32>)
  check.expect.close actual(%output) expected(%expected) atol(1e-5) rtol(1e-5) nan(same) : tensor<1024xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_q6k_case> @yah_ffn_gemm_q6k_bench

// Requires --config=yah_ffn_gemm_q6k.m_tiles=1088. An all-zero Q6_K weight
// decodes to zero (d = 0), so every output must be exactly 0.
check.case public @yah_ffn_gemm_q6k_full_case {
  %weight = check.generate.fill value(0) : tensor<73113600xi8>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1114112xf32>
  %expected = check.generate.fill value(0.0) : tensor<1114112xf32>
  %wstage = check.generate.fill value(0.0) : tensor<89128960xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1114112xf32>
  kernel.launch @yah_ffn_gemm_q6k(%weight, %input, %wstage, %ostage, %output) : (tensor<73113600xi8>, tensor<64x5120xf16>, tensor<89128960xf16>, tensor<1114112xf32>, tensor<1114112xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1114112xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_q6k_full_case> @yah_ffn_gemm_q6k_full_bench