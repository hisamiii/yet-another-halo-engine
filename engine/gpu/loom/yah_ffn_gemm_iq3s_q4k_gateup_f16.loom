check.case public @yah_ffn_gemm_iq3s_q4k_gateup_case {
  %input = check.generate.fill value(0.0078125) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1024xf16>
  %expected = check.file.read.npy path("fixtures/mixed_gateup/iq3s_q4k.npy") : tensor<1024xf16>
  %gwstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %uwstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ogate = check.generate.fill value(0.0) : tensor<1024xf32>
  %oup = check.generate.fill value(0.0) : tensor<1024xf32>
  %gate_weight = check.file.read.npy path("fixtures/iq3s_gemm/input_iq3s_gemm.npy") : tensor<35200xi8>
  %gate_grid = check.file.read.npy path("fixtures/iq3s_gemm/grid.npy") : tensor<512xi32>
  %up_weight = check.file.read.npy path("fixtures/q4k_gemm/input_q4k_gemm.npy") : tensor<46080xi8>
  kernel.launch @yah_ffn_gemm_iq3s_q4k_gateup(%gate_weight, %gate_grid, %up_weight, %input, %gwstage, %uwstage, %ogate, %oup, %output) : (tensor<35200xi8>, tensor<512xi32>, tensor<46080xi8>, tensor<64x5120xf16>, tensor<81920xf16>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf32>, tensor<1024xf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.1) rtol(0.0) nan(same) : tensor<1024xf16>
  check.return
}

