// YAH FFN GEMM with in-kernel mixed-format paired gate/up, Loom port of
// HalfPrefillGemmKernel<..., kIQ3_S, kQ4_K, kGateUp>.
//
// HIP source: prefill_fp16.hip. The gate weight is IQ3_S and the up weight is
// Q4_K; each has its own decoder, block geometry, staging buffer and
// accumulator group, plus any table operands the format needs:
//
//   gate_acc[row][token] = sum_k iq3s_decode(gate_w, row, k) * f16(A[token][k])
//   up_acc[row][token]   = sum_k q4k_decode(up_w,   row, k) * f16(A[token][k])
//   out[token*m + row]   = round_f16(silu(gate_acc) * up_acc)
//
// Mixed paired arm with per-operand grid/ksigns operands where the format needs
// them. Generated from yah_ffn_gemm_q4k_gateup_f16.loom with per-operand sizes,
// per-operand block shifts and suffixed decode constants.
//
// Measured: 28.20 ms at m_tiles=1088 (production 17408 rows). Both decoders,
// any table lookups and the combine are untuned.
//
// Correctness case: the gate fixture is the packed IQ3_S input, the up
// fixture the packed Q4_K input, and the activation is 0.0078125. Expected is
// round_f16(silu(gate_acc) * up_acc). The production-size case uses all-zero
// weights, so every output is zero.
//
// Required config (correctness): --config=yah_ffn_gemm_iq3s_q4k_gateup.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_iq3s_q4k_gateup.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_iq3s_q4k_gateup.m_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_iq3s_q4k_gateup() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_iq3s_q4k_gateup.m_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%gate_weight: buffer, %gate_grid: buffer, %up_weight: buffer, %input: buffer, %gwstage: buffer, %uwstage: buffer, %ogate: buffer, %oup: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c127 = index.constant 127 : index
  %c255 = index.constant 255 : index
  %c511 = index.constant 511 : index
  %c1023 = index.constant 1023 : index
  %c2047 = index.constant 2047 : index
  %c5120 = index.constant 5120 : index
  %c2880 = index.constant 2880 : index
  %c23040 = index.constant 23040 : index
  %c46080 = index.constant 46080 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c255i = scalar.constant 255 : i32
  %c0i_g = scalar.constant 0 : i32
  %c1i_g = scalar.constant 1 : i32
  %c2i_g = scalar.constant 2 : i32
  %c3i_g = scalar.constant 3 : i32
  %c4i_g = scalar.constant 4 : i32
  %c5i_g = scalar.constant 5 : i32
  %c6i_g = scalar.constant 6 : i32
  %c7i_g = scalar.constant 7 : i32
  %c8i_g = scalar.constant 8 : i32
  %c15i_g = scalar.constant 15 : i32
  %c16i_g = scalar.constant 16 : i32
  %c31i_g = scalar.constant 31 : i32
  %c32i_g = scalar.constant 32 : i32
  %c63i_g = scalar.constant 63 : i32
  %c66i_g = scalar.constant 66 : i32
  %c74i_g = scalar.constant 74 : i32
  %c106i_g = scalar.constant 106 : i32
  %c110i_g = scalar.constant 110 : i32
  %c255i_g = scalar.constant 255 : i32
  %c2200i_g = scalar.constant 2200 : i32
  %c0i_u = scalar.constant 0 : i32
  %c1i_u = scalar.constant 1 : i32
  %c4i_u = scalar.constant 4 : i32
  %c5i_u = scalar.constant 5 : i32
  %c6i_u = scalar.constant 6 : i32
  %c8i_u = scalar.constant 8 : i32
  %c15i_u = scalar.constant 15 : i32
  %c16i_u = scalar.constant 16 : i32
  %c31i_u = scalar.constant 31 : i32
  %c32i_u = scalar.constant 32 : i32
  %c63i_u = scalar.constant 63 : i32
  %c255i_u = scalar.constant 255 : i32
  %c144i_u = scalar.constant 144 : i32
  %c2880i_u = scalar.constant 2880 : i32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %m_tiles = config.get @yah_ffn_gemm_iq3s_q4k_gateup.m_tiles : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %cag_bytes = index.constant 35200 : index
  %cag_halfs = index.constant 17600 : index
  %cbu_bytes = index.constant 46080 : index
  %cbu_halfs = index.constant 23040 : index
  %gw_bytes = index.mul %m_tiles, %cag_bytes : index
  %gw_halfs = index.mul %m_tiles, %cag_halfs : index
  %uw_bytes = index.mul %m_tiles, %cbu_bytes : index
  %uw_halfs = index.mul %m_tiles, %cbu_halfs : index
  %gw_last = index.sub %gw_bytes, %c1 : index
  %gw_half_last = index.sub %gw_halfs, %c1 : index
  %uw_last = index.sub %uw_bytes, %c1 : index
  %uw_half_last = index.sub %uw_halfs, %c1 : index
  %out_total = index.mul %m_rows, %c64 : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [1, 5120] : encoding<layout>
  %gate_weight_na, %gate_grid_na, %up_weight_na, %input_na, %gwstage_na, %uwstage_na, %ogate_na, %oup_na, %output_na = buffer.assume.noalias %gate_weight, %gate_grid, %up_weight, %input, %gwstage, %uwstage, %ogate, %oup, %output : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %gw_view = buffer.view %gate_weight_na[%base] : buffer -> view<[%gw_bytes]xi8>
  %gw_f16_view = buffer.view %gate_weight_na[%base] : buffer -> view<[%gw_halfs]xf16>
  %uw_view = buffer.view %up_weight_na[%base] : buffer -> view<[%uw_bytes]xi8>
  %uw_f16_view = buffer.view %up_weight_na[%base] : buffer -> view<[%uw_halfs]xf16>
  %gate_grid_view = buffer.view %gate_grid_na[%base] : buffer -> view<512xi32>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<5120x64xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf16>
  %gwstage_view = buffer.view %gwstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %uwstage_view = buffer.view %uwstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %ogate_view = buffer.view %ogate_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %oup_view = buffer.view %oup_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %g0, %g1, %g2, %g3, %u0, %u1, %u2, %u3 = scf.for %kk = [%c0 to %c5120 step %c16](%ag0 = %init : vector<8xf32>, %ag1 = %init : vector<8xf32>, %ag2 = %init : vector<8xf32>, %ag3 = %init : vector<8xf32>, %au0 = %init : vector<8xf32>, %au1 = %init : vector<8xf32>, %au2 = %init : vector<8xf32>, %au3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32

    %j_sink_g = scf.for %j_g = [%c0 to %c8 step %c1](%mk_g = %c0 : index) -> (index) {
      %kblk_g = scalar.shrui %kk_i, %c8i_g : i32
      %j_i_g = index.cast %j_g : index to i32
      %j32_g = scalar.shli %j_i_g, %c5i_g : i32
      %e_i_g = scalar.addi %lane_i, %j32_g : i32
      %r_i_g = scalar.shrui %e_i_g, %c4i_g : i32
      %c_i_g = scalar.andi %e_i_g, %c15i_g : i32
      %i_i_g = scalar.addi %kbase, %c_i_g : i32
      %row_i_g = scalar.addi %m_origin_i, %r_i_g : i32
      %row_off_g = scalar.muli %row_i_g, %c2200i_g : i32
      %blk_off0_g = scalar.muli %kblk_g, %c110i_g : i32
      %blk_off_g = scalar.addi %row_off_g, %blk_off0_g : i32
      %group_g = scalar.shrui %i_i_g, %c5i_g : i32
      %half0_g = scalar.shrui %i_i_g, %c4i_g : i32
      %half_g = scalar.andi %half0_g, %c1i_g : i32
      %jj_g = scalar.andi %i_i_g, %c15i_g : i32
      %q_g = scalar.shrui %jj_g, %c3i_g : i32
      %which0_g = scalar.shrui %jj_g, %c2i_g : i32
      %which_g = scalar.andi %which0_g, %c1i_g : i32
      %b_g = scalar.andi %jj_g, %c3i_g : i32
      %l2_g = scalar.shli %half_g, %c1i_g : i32
      %l_g = scalar.addi %l2_g, %q_g : i32
      %g8_g = scalar.shli %group_g, %c3i_g : i32
      %qso_g = scalar.addi %blk_off_g, %c2i_g : i32
      %g8a_g = scalar.addi %qso_g, %g8_g : i32
      %l2x_g = scalar.shli %l_g, %c1i_g : i32
      %lw_g = scalar.addi %l2x_g, %which_g : i32
      %qlo_i_g = scalar.addi %g8a_g, %lw_g : i32
      %qlo_ix_g = index.cast %qlo_i_g : i32 to index
      %qlo_lo_g = index.max %qlo_ix_g, %c0 : index
      %qlo_idx_g = index.min %qlo_lo_g, %gw_last : index
      %qlob8_g = view.load %gw_view[%qlo_idx_g] : view<[%gw_bytes]xi8> -> i8
      %grid_lo_g = scalar.extui %qlob8_g : i8 to i32
      %qho_g = scalar.addi %blk_off_g, %c66i_g : i32
      %qh_i_g = scalar.addi %qho_g, %group_g : i32
      %qh_ix_g = index.cast %qh_i_g : i32 to index
      %qh_lo_g = index.max %qh_ix_g, %c0 : index
      %qh_idx_g = index.min %qh_lo_g, %gw_last : index
      %qhb8_g = view.load %gw_view[%qh_idx_g] : view<[%gw_bytes]xi8> -> i8
      %qhb_g = scalar.extui %qhb8_g : i8 to i32
      %hbit0_g = scalar.shrui %qhb_g, %lw_g : i32
      %hbit_g = scalar.andi %hbit0_g, %c1i_g : i32
      %hbit8_g = scalar.shli %hbit_g, %c8i_g : i32
      %gidx_i_g = scalar.ori %grid_lo_g, %hbit8_g : i32
      %gidx_ix_g = index.cast %gidx_i_g : i32 to index
      %gidx_lo_g = index.max %gidx_ix_g, %c0 : index
      %gidx_g = index.min %gidx_lo_g, %c511 : index
      %gword_g = view.load %gate_grid_view[%gidx_g] : view<512xi32> -> i32
      %g_shift_g = scalar.shli %b_g, %c3i_g : i32
      %gb0_g = scalar.shrui %gword_g, %g_shift_g : i32
      %g_byte_g = scalar.andi %gb0_g, %c255i_g : i32
      %sg4_g = scalar.shli %group_g, %c2i_g : i32
      %sgo_g = scalar.addi %blk_off_g, %c74i_g : i32
      %sg1_g = scalar.addi %sgo_g, %sg4_g : i32
      %sg_i_g = scalar.addi %sg1_g, %l_g : i32
      %sg_ix_g = index.cast %sg_i_g : i32 to index
      %sg_lo_g = index.max %sg_ix_g, %c0 : index
      %sg_idx_g = index.min %sg_lo_g, %gw_last : index
      %sgb8_g = view.load %gw_view[%sg_idx_g] : view<[%gw_bytes]xi8> -> i8
      %sgb_g = scalar.extui %sgb8_g : i8 to i32
      %is_g1_g = scalar.cmpi eq, %which_g, %c0i_g : i32
      %sign_nib_g = scf.if %is_g1_g -> (i32) {
        %sn_lo_g = scalar.andi %sgb_g, %c15i_g : i32
        scf.yield %sn_lo_g : i32
      } else {
        %sn_hi_g = scalar.shrui %sgb_g, %c4i_g : i32
        scf.yield %sn_hi_g : i32
      }
      %sbit0_g = scalar.shrui %sign_nib_g, %b_g : i32
      %sign_bit_g = scalar.andi %sbit0_g, %c1i_g : i32
      %is_neg_g = scalar.cmpi eq, %sign_bit_g, %c1i_g : i32
      %neg_g_g = scalar.subi %c0i_g, %g_byte_g : i32
      %mag_g = scf.if %is_neg_g -> (i32) {
        scf.yield %neg_g_g : i32
      } else {
        scf.yield %g_byte_g : i32
      }
      %sco_g = scalar.addi %blk_off_g, %c106i_g : i32
      %gdiv2_g = scalar.shrui %group_g, %c1i_g : i32
      %sc_i_g = scalar.addi %sco_g, %gdiv2_g : i32
      %sc_ix_g = index.cast %sc_i_g : i32 to index
      %sc_lo_g = index.max %sc_ix_g, %c0 : index
      %sc_idx_g = index.min %sc_lo_g, %gw_last : index
      %scb8_g = view.load %gw_view[%sc_idx_g] : view<[%gw_bytes]xi8> -> i8
      %scb_g = scalar.extui %scb8_g : i8 to i32
      %odd_g = scalar.andi %group_g, %c1i_g : i32
      %is_even_g = scalar.cmpi eq, %odd_g, %c0i_g : i32
      %nib_g = scf.if %is_even_g -> (i32) {
        %ni_lo_g = scalar.andi %scb_g, %c15i_g : i32
        scf.yield %ni_lo_g : i32
      } else {
        %ni_hi_g = scalar.shrui %scb_g, %c4i_g : i32
        scf.yield %ni_hi_g : i32
      }
      %nib2_g = scalar.shli %nib_g, %c1i_g : i32
      %one_plus_g = scalar.addi %nib2_g, %c1i_g : i32
      %scale_f_g = scalar.sitofp %one_plus_g : i32 to f32
      %mag_f_g = scalar.sitofp %mag_g : i32 to f32
