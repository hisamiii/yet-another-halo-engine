// YAH sparse sampling penalties, Loom port of ApplySparsePenaltiesKernel.
//
// HIP source: sample.hip. One thread per penalty entry, each naming a unique
// token. The `sampling::TokenPenalty` record is {u32 token, u32 generated_count,
// u32 repeated}, 12 bytes with no padding, so the port reads it as a
// `view<[penalty_count]x[%c3]xi32>` and keeps the HIP arithmetic and branch order:
//
//   adjusted = logits[token]
//   if (repeated && repeat_penalty != 1): adjusted = adjusted <= 0 ? adjusted * r
//                                                                : adjusted / r
//   adjusted -= frequency_penalty * generated_count
//   if (generated_count != 0): adjusted -= presence_penalty
//   logits[token] = adjusted
//
// The three coefficients arrive in a four-float buffer rather than as configs,
// because a config value cannot be a float on this target. Penalty tokens are
// unique, so the in-place update has no race and no ordering requirement.
//
// Required config: --config=yah_sparse_penalties.penalty_count=3 --config=yah_sparse_penalties.vocab_size=8
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_sparse_penalties.penalty_count : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_sparse_penalties.vocab_size : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@yah_wave32) @yah_sparse_penalties() {
  %unit = index.constant 1 : index
  %penalty_count = config.get @yah_sparse_penalties.penalty_count : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %penalty_count, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%logits: buffer, %penalties: buffer, %params: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c256 = index.constant 256 : index
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %penalty_count = config.get @yah_sparse_penalties.penalty_count : index
  %vocab_size = config.get @yah_sparse_penalties.vocab_size : index
  %logits_na, %pen_na, %params_na = buffer.assume.noalias %logits, %penalties, %params : buffer, buffer, buffer
  %logits_view = buffer.view %logits_na[%base] : buffer -> view<[%vocab_size]xf32>
  %pen_view = buffer.view %pen_na[%base] : buffer -> view<[%penalty_count]x[%c3]xi32>
  %params_view = buffer.view %params_na[%base] : buffer -> view<[%c3]xf32>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %index = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %index, %penalty_count : index
  scf.if %in_range {
    %token_i = view.load %pen_view[%index, %c0] : view<[%penalty_count]x[%c3]xi32> -> i32
    %token = index.cast %token_i : i32 to index
    %token_ok = index.cmp ult, %token, %vocab_size : index
    scf.if %token_ok {
      %count_i = view.load %pen_view[%index, %c1] : view<[%penalty_count]x[%c3]xi32> -> i32
      %repeated_i = view.load %pen_view[%index, %c2] : view<[%penalty_count]x[%c3]xi32> -> i32
      %rep = view.load %params_view[%c0] : view<[%c3]xf32> -> f32
      %freq = view.load %params_view[%c1] : view<[%c3]xf32> -> f32
      %pres = view.load %params_view[%c2] : view<[%c3]xf32> -> f32
      %adjusted0 = view.load %logits_view[%token] : view<[%vocab_size]xf32> -> f32
      %rep_on = scalar.cmpf one, %rep, %one : f32
      %repeated_idx = index.cast %repeated_i : i32 to index
      %rep_zero = index.cmp eq, %repeated_idx, %c0 : index
      %adjusted1 = scf.if %rep_on -> (f32) {
        %skip_repeat = scf.if %rep_zero -> (f32) {
          scf.yield %adjusted0 : f32
        } else {
          %nonpos = scalar.cmpf ole, %adjusted0, %zero : f32
          %repeated_val = scf.if %nonpos -> (f32) {
            %m = scalar.mulf %adjusted0, %rep : f32
            scf.yield %m : f32
          } else {
            %d = scalar.divf %adjusted0, %rep : f32
            scf.yield %d : f32
          }
          scf.yield %repeated_val : f32
        }
        scf.yield %skip_repeat : f32
      } else {
        scf.yield %adjusted0 : f32
      }
      %count_f = scalar.sitofp %count_i : i32 to f32
      %freq_term = scalar.mulf %freq, %count_f : f32
      %adjusted3 = scalar.subf %adjusted1, %freq_term : f32
      %count_idx = index.cast %count_i : i32 to index
      %count_zero = index.cmp eq, %count_idx, %c0 : index
      %adjusted4 = scf.if %count_zero -> (f32) {
        scf.yield %adjusted3 : f32
      } else {
        %p = scalar.subf %adjusted3, %pres : f32
        scf.yield %p : f32
      }
      view.store %adjusted4, %logits_view[%token] : f32, view<[%vocab_size]xf32>
    }
  }
  kernel.return
}

// Requires --config=yah_sparse_penalties.penalty_count=3 --config=yah_sparse_penalties.vocab_size=8.
//
// logits = 0..7, penalties = {(1, 2, repeated), (3, 0, fresh), (5, 4, repeated)}
// and (repeat, frequency, presence) = (2, 0.5, 1). Every step is exact in f32,
// so the expected row is a fixture: token 1 -> -1.5, token 3 -> 3, token 5 -> -0.5.
check.case public @yah_sparse_penalties_case {
  %logits = check.generate.iota offset(0.0) step(1.0) : tensor<8xf32>
  %penalties = check.file.read.npy path("fixtures/sparse_penalties/penalties.npy") : tensor<3x3xi32>
  %params = check.file.read.npy path("fixtures/sparse_penalties/params.npy") : tensor<4xf32>
  %expected = check.file.read.npy path("fixtures/sparse_penalties/expected.npy") : tensor<8xf32>
  kernel.launch @yah_sparse_penalties(%logits, %penalties, %params) : (tensor<8xf32>, tensor<3x3xi32>, tensor<4xf32>)
  check.expect.close actual(%logits) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.return
}

check.benchmark<@yah_sparse_penalties_case> @yah_sparse_penalties_bench
