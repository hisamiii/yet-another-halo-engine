// Probe: does vector.fragment.load<lhs> read the same layout from a
// buffer.alloca<workgroup> LDS view as from global? 256 f16 are staged into LDS
// by 32 lanes (8 each), a workgroup barrier is issued, then the fragment load
// reads LDS and the per-lane carrier is stored to global exactly as in
// probe_fragment_layout.loom.
amdgpu.target<gfx11-generic> @probe_wave32 {subgroup_size = 32}

kernel.def target(@probe_wave32) @probe_fragment_lhs_lds() {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c8 = index.constant 8 : index
  %m = index.constant 16 : index
  %k = index.constant 16 : index
  %stage_bytes = index.constant 512 : offset
  %lane = kernel.workitem.id<x> : index
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %in_flat = buffer.view %input_noalias[%base] : buffer -> view<256xf16>
  %out_view = buffer.view %output_noalias[%base] : buffer -> view<32x16xf16>
  %stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %stage_flat = buffer.view %stage[%base] : buffer -> view<256xf16>
  %off = index.mul %lane, %c8 : index
  %v = vector.load %in_flat[%off] : view<256xf16> -> vector<8xf16>
  vector.store %v, %stage_flat[%off] : vector<8xf16>, view<256xf16>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %stage_view = buffer.view %stage[%base] : buffer -> view<16x16xf16>
  %lhs = vector.fragment.load<lhs> %stage_view[%c0, %c0] shape [%m, %k] : view<16x16xf16> -> vector<16xf16>
  vector.store %lhs, %out_view[%lane, %c0] : vector<16xf16>, view<32x16xf16>
  kernel.return
}

check.case public @probe_fragment_lhs_lds_case {
  %input = check.generate.iota offset(0.0) step(1.0) : tensor<16x16xf16>
  %output = check.generate.fill value(0.0) : tensor<32x16xf16>
  kernel.launch @probe_fragment_lhs_lds(%input, %output) : (tensor<16x16xf16>, tensor<32x16xf16>)
  check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<32x16xf16>
  check.file.write.npy value(%output) path("probe_fragment_lhs_lds.npy") mode(always) : tensor<32x16xf16>
  check.return
}

check.benchmark<@probe_fragment_lhs_lds_case> @probe_fragment_lhs_lds_bench
