            %j32_qkv_iq4nl = scalar.shli %j_i_qkv_iq4nl, %c5i : i32
            %i_i_qkv_iq4nl = scalar.addi %lane_i, %j32_qkv_iq4nl : i32
            %prod_qkv_iq4nl = func.call @iq4nl_step(%qkv_bytes, %qkv_halfs, %hidden, %qw_view, %qw_f16_view, %x_view, %m_i, %kblk_i_qkv_iq4nl, %i_i_qkv_iq4nl) : (index, index, index, view<[%qkv_bytes]xi8>, view<[%qkv_halfs]xf16>, view<[%hidden]xf32>, i32, i32, i32) -> (f32)
            %next_qkv_iq4nl = scalar.addf %a1_qkv_iq4nl, %prod_qkv_iq4nl : f32
            scf.yield %next_qkv_iq4nl : f32
          }
          scf.yield %acc1_qkv_iq4nl : f32
        }
        scf.yield %acc_qkv_iq4nl : f32
        } else {
          %qkv_part_p3 = scf.if %qkv_is_3 -> (f32) {
          %acc_qkv_q5k = scf.for %kblk_qkv_q5k = [%c0 to %k_groups step %c1](%a0_qkv_q5k = %zero : f32) -> (f32) {
            %kblk_i_qkv_q5k = index.cast %kblk_qkv_q5k : index to i32
            %acc1_qkv_q5k = scf.for %j_qkv_q5k = [%c0 to %c8 step %c1](%a1_qkv_q5k = %a0_qkv_q5k : f32) -> (f32) {
              %j_i_qkv_q5k = index.cast %j_qkv_q5k : index to i32
              %j32_qkv_q5k = scalar.shli %j_i_qkv_q5k, %c5i : i32
              %i_i_qkv_q5k = scalar.addi %lane_i, %j32_qkv_q5k : i32
              %prod_qkv_q5k = func.call @q5k_step(%qkv_bytes, %qkv_halfs, %hidden, %qw_view, %qw_f16_view, %x_view, %m_i, %kblk_i_qkv_q5k, %i_i_qkv_q5k) : (index, index, index, view<[%qkv_bytes]xi8>, view<[%qkv_halfs]xf16>, view<[%hidden]xf32>, i32, i32, i32) -> (f32)
