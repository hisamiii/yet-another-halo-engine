          %j_i_qkv_iq4xs = index.cast %j_qkv_iq4xs : index to i32
          %j32_qkv_iq4xs = scalar.shli %j_i_qkv_iq4xs, %c5i : i32
          %i_i_qkv_iq4xs = scalar.addi %lane_i, %j32_qkv_iq4xs : i32
          %prod_qkv_iq4xs = func.call @iq4xs_step(%qkv_bytes, %qkv_halfs, %hidden, %qw_view, %qw_f16_view, %x_view, %m_i, %kblk_i_qkv_iq4xs, %i_i_qkv_iq4xs) : (index, index, index, view<[%qkv_bytes]xi8>, view<[%qkv_halfs]xf16>, view<[%hidden]xf32>, i32, i32, i32) -> (f32)
          %next_qkv_iq4xs = scalar.addf %a1_qkv_iq4xs, %prod_qkv_iq4xs : f32
          scf.yield %next_qkv_iq4xs : f32
        }
        scf.yield %acc1_qkv_iq4xs : f32
      }
