  %qbit = scalar.andi %qhv, %c1i : i32
  %qhigh = scalar.muli %qbit, %c16i : i32
  %quant = scalar.addi %quant4, %qhigh : i32
  %la0 = scalar.addi %blk_off, %c4i : i32
  %la_i = scalar.addi %la0, %sis : i32
  %lb_i = scalar.addi %la_i, %c4i : i32
  %lc_i = scalar.addi %blk_off, %sis : i32
  %la_ix = index.cast %la_i : i32 to index
  %la_lo = index.max %la_ix, %c0 : index
  %la_idx = index.min %la_lo, %w_last : index
  %lb_ix = index.cast %lb_i : i32 to index
  %lb_lo = index.max %lb_ix, %c0 : index
  %lb_idx = index.min %lb_lo, %w_last : index
  %lc_ix = index.cast %lc_i : i32 to index
  %lc_lo = index.max %lc_ix, %c0 : index
  %lc_idx = index.min %lc_lo, %w_last : index
  %la8 = view.load %w[%la_idx] : view<[%wn]xi8> -> i8
  %lb8 = view.load %w[%lb_idx] : view<[%wn]xi8> -> i8
  %lc8 = view.load %w[%lc_idx] : view<[%wn]xi8> -> i8
  %la = scalar.extui %la8 : i8 to i32
  %lb = scalar.extui %lb8 : i8 to i32
  %lc = scalar.extui %lc8 : i8 to i32
  %sc, %smin = scf.if %sis_low -> (i32, i32) {
    %s = scalar.andi %la, %c63i : i32
    %mv = scalar.andi %lb, %c63i : i32
    scf.yield %s, %mv : i32, i32
  } else {
    %lb_lo = scalar.andi %lb, %c15i : i32
    %lc_hi = scalar.shrui %lc, %c6i : i32
    %lc_hi4 = scalar.shli %lc_hi, %c4i : i32
    %s2 = scalar.ori %lb_lo, %lc_hi4 : i32
    %lb_hi = scalar.shrui %lb, %c4i : i32
    %la_hi = scalar.shrui %la, %c6i : i32
    %la_hi4 = scalar.shli %la_hi, %c4i : i32
    %m2 = scalar.ori %lb_hi, %la_hi4 : i32
    scf.yield %s2, %m2 : i32, i32
  }
  %blk_half0 = scalar.shrui %blk_off, %c1i : i32
  %d_ix = index.cast %blk_half0 : i32 to index
  %d_lo = index.max %d_ix, %c0 : index
  %d_idx = index.min %d_lo, %w_half_last : index
  %dmin0 = scalar.addi %blk_half0, %c1i : i32
  %dmin_ix = index.cast %dmin0 : i32 to index
  %dmin_lo = index.max %dmin_ix, %c0 : index
  %dmin_idx = index.min %dmin_lo, %w_half_last : index
  %d_half_v = view.load %wf[%d_idx] : view<[%wh]xf16> -> f16
  %dmin_half_v = view.load %wf[%dmin_idx] : view<[%wh]xf16> -> f16
  %d = scalar.extf %d_half_v : f16 to f32
  %dmin = scalar.extf %dmin_half_v : f16 to f32
  %sc_f = scalar.sitofp %sc : i32 to f32
  %m_f = scalar.sitofp %smin : i32 to f32
  %q_f = scalar.sitofp %quant : i32 to f32
  %dsc = scalar.mulf %d, %sc_f : f32
  %scaled = scalar.mulf %dsc, %q_f : f32
  %dm = scalar.mulf %dmin, %m_f : f32
  %value = scalar.subf %scaled, %dm : f32
  %kidx_i = scalar.addi %kblk256, %i_i : i32
  %kidx_ix = index.cast %kidx_i : i32 to index
  %kidx_lo = index.max %kidx_ix, %c0 : index
  %kidx = index.min %kidx_lo, %x_last : index
  %xm = view.load %xv[%kidx] : view<[%xn]xf32> -> f32
  %prod = scalar.mulf %value, %xm : f32
  func.return %prod : f32
}

func.def @q6k_step(%wn: index, %wh: index, %xn: index, %w: view<[%wn]xi8>, %wf: view<[%wh]xf16>, %xv: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %c0 = index.constant 0 : index
