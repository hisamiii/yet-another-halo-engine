        %j32_beta_q8_0 = scalar.shli %j_i_beta_q8_0, %c5i : i32
        %i_i_beta_q8_0 = scalar.addi %lane_i, %j32_beta_q8_0 : i32
        %prod_beta_q8_0 = func.call @q8_0_step(%ab_bytes, %ab_halfs, %hidden, %bw_view, %bw_f16_view, %x_view, %row_b_i, %kblk_i_beta_q8_0, %i_i_beta_q8_0, %rs_i) : (index, index, index, view<[%ab_bytes]xi8>, view<[%ab_halfs]xf16>, view<[%hidden]xf32>, i32, i32, i32, i32) -> (f32)
        %next_beta_q8_0 = scalar.addf %a1_beta_q8_0, %prod_beta_q8_0 : f32
        scf.yield %next_beta_q8_0 : f32
      }
      scf.yield %acc1_beta_q8_0 : f32
    }
    scf.yield %acc_beta_q8_0 : f32
    } else {
      scf.yield %zero : f32
    }
    %beta_sum = kernel.subgroup.reduce<addf> %beta_part : f32
    scf.if %is_leader {
      view.store %beta_sum, %bo_view[%row_b] : f32, view<[%rank]xf32>
    }
  }

  kernel.return
}



// ---- Small checks (config hidden=5120 qkv_size=16 inner_size=16 rank=2) ----
// Each case binds one band to a single-format fixture zero-padded to the band's
// max-stride bytes and the other three to zero-filled buffers of the same max
// size, so a row routed to the wrong band, a wrong output row, or a wrong row
// stride produces a nonzero where zero is required. The activation is the shared
// sparse gemv_x so each expected dot is an exact sum of a few decoded weights.

check.case public @yah_ssm_proj_decode_q4k_case {
  %qkv_w = check.file.read.npy path("fixtures/ssm_proj_decode/qkv_q4k_pad.npy") : tensor<67200xi8>
  %gate_w = check.generate.fill value(0) : tensor<67200xi8>
  %alpha_w = check.generate.fill value(0) : tensor<10880xi8>
  %beta_w = check.generate.fill value(0) : tensor<10880xi8>
  %x = check.file.read.npy path("fixtures/q4k_gemm/gemv_x.npy") : tensor<5120xf32>
  %qkv_out = check.generate.fill value(0.0) : tensor<16xf32>
  %gate_out = check.generate.fill value(0.0) : tensor<16xf32>
  %alpha_out = check.generate.fill value(0.0) : tensor<2xf32>
  %beta_out = check.generate.fill value(0.0) : tensor<2xf32>
  %qkv_exp = check.file.read.npy path("fixtures/q4k_gemm/gemv_expected.npy") : tensor<16xf32>
  %gate_exp = check.generate.fill value(0.0) : tensor<16xf32>
  %alpha_exp = check.generate.fill value(0.0) : tensor<2xf32>
  %beta_exp = check.generate.fill value(0.0) : tensor<2xf32>
  %qkv_t = check.literal value(0) : i32
  %gate_t = check.literal value(0) : i32
  %alpha_t = check.literal value(5) : i32
  %beta_t = check.literal value(5) : i32
  kernel.launch @yah_ssm_proj_decode_f32(%qkv_w, %gate_w, %alpha_w, %beta_w, %x, %qkv_out, %gate_out, %alpha_out, %beta_out, %qkv_t, %gate_t, %alpha_t, %beta_t) : (tensor<67200xi8>, tensor<67200xi8>, tensor<10880xi8>, tensor<10880xi8>, tensor<5120xf32>, tensor<16xf32>, tensor<16xf32>, tensor<2xf32>, tensor<2xf32>, i32, i32, i32, i32)
  check.expect.close actual(%qkv_out) expected(%qkv_exp) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<16xf32>
  check.expect.close actual(%gate_out) expected(%gate_exp) atol(0.0) rtol(0.0) nan(same) : tensor<16xf32>
  check.expect.close actual(%alpha_out) expected(%alpha_exp) atol(0.0) rtol(0.0) nan(same) : tensor<2xf32>
  check.expect.close actual(%beta_out) expected(%beta_exp) atol(0.0) rtol(0.0) nan(same) : tensor<2xf32>
  check.return
}

