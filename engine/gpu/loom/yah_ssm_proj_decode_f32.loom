kernel.def target(@yah_wave32) @yah_ssm_proj_decode_f32() {
  %unit = index.constant 1 : index
  %qkv_size = config.get @yah_ssm_proj_decode.qkv_size : index
  %inner_size = config.get @yah_ssm_proj_decode.inner_size : index
