  %alpha_end = index.add %gate_end, %rank : index
  %total_rows = index.add %alpha_end, %rank : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%total_rows, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%qkv_w: buffer, %gate_w: buffer, %alpha_w: buffer, %beta_w: buffer, %x: buffer, %qkv_out: buffer, %gate_out: buffer, %alpha_out: buffer, %beta_out: buffer, %qkv_type: i32, %gate_type: i32, %alpha_type: i32, %beta_type: i32) {

  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c2100 = index.constant 2100 : index
  %c4200 = index.constant 4200 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c8i = scalar.constant 8 : i32
  %c34i = scalar.constant 34 : i32
  %zero = scalar.constant 0.0 : f32
  %hidden = config.get @yah_ssm_proj_decode.hidden : index
  %qkv_size = config.get @yah_ssm_proj_decode.qkv_size : index
  %inner_size = config.get @yah_ssm_proj_decode.inner_size : index
  %rank = config.get @yah_ssm_proj_decode.rank : index
  %gate_end = index.add %qkv_size, %inner_size : index
  %alpha_end = index.add %gate_end, %rank : index
  %qkv_bytes = index.mul %qkv_size, %c4200 : index
  %qkv_halfs = index.mul %qkv_size, %c2100 : index
  %gate_bytes = index.mul %inner_size, %c4200 : index
  %gate_halfs = index.mul %inner_size, %c2100 : index
  %hidden_i = index.cast %hidden : index to i32
  %hid32_i = scalar.shrui %hidden_i, %c5i : i32
  %rs_i = scalar.muli %hid32_i, %c34i : i32
  %rs = index.cast %rs_i : i32 to index
  %rs_half_i = scalar.shrui %rs_i, %c1i : i32
  %rs_half = index.cast %rs_half_i : i32 to index
  %ab_bytes = index.mul %rank, %rs : index
  %ab_halfs = index.mul %rank, %rs_half : index
  %kg_i = scalar.shrui %hidden_i, %c8i : i32
  %k_groups = index.cast %kg_i : i32 to index
  %qw_na, %gw_na, %aw_na, %bw_na, %x_na, %qo_na, %go_na, %ao_na, %bo_na = buffer.assume.noalias %qkv_w, %gate_w, %alpha_w, %beta_w, %x, %qkv_out, %gate_out, %alpha_out, %beta_out : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %qw_view = buffer.view %qw_na[%base] : buffer -> view<[%qkv_bytes]xi8>
  %qw_f16_view = buffer.view %qw_na[%base] : buffer -> view<[%qkv_halfs]xf16>
  %gw_view = buffer.view %gw_na[%base] : buffer -> view<[%gate_bytes]xi8>
  %gw_f16_view = buffer.view %gw_na[%base] : buffer -> view<[%gate_halfs]xf16>
  %aw_view = buffer.view %aw_na[%base] : buffer -> view<[%ab_bytes]xi8>
  %aw_f16_view = buffer.view %aw_na[%base] : buffer -> view<[%ab_halfs]xf16>
  %bw_view = buffer.view %bw_na[%base] : buffer -> view<[%ab_bytes]xi8>
  %bw_f16_view = buffer.view %bw_na[%base] : buffer -> view<[%ab_halfs]xf16>
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%hidden]xf32>
  %qo_view = buffer.view %qo_na[%base] : buffer -> view<[%qkv_size]xf32>
  %go_view = buffer.view %go_na[%base] : buffer -> view<[%inner_size]xf32>
  %ao_view = buffer.view %ao_na[%base] : buffer -> view<[%rank]xf32>
  %bo_view = buffer.view %bo_na[%base] : buffer -> view<[%rank]xf32>
  %m = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_i = index.cast %m : index to i32
  %row_g = index.sub %m, %qkv_size : index
  %row_a = index.sub %m, %gate_end : index
  %row_b = index.sub %m, %alpha_end : index
  %row_g_i = index.cast %row_g : index to i32
  %row_a_i = index.cast %row_a : index to i32
  %row_b_i = index.cast %row_b : index to i32
  %is_leader = index.cmp eq, %lane, %c0 : index
  %in_qkv = index.cmp ult, %m, %qkv_size : index
  %in_gate = index.cmp ult, %row_g, %inner_size : index
  %in_alpha = index.cmp ult, %row_a, %rank : index
  %in_beta = index.cmp ult, %row_b, %rank : index

  %qkv_is_0 = scalar.cmpi eq, %qkv_type, %c0i : i32
  %qkv_is_1 = scalar.cmpi eq, %qkv_type, %c1i : i32
  %qkv_is_2 = scalar.cmpi eq, %qkv_type, %c2i : i32
  %qkv_is_3 = scalar.cmpi eq, %qkv_type, %c3i : i32
  %qkv_is_4 = scalar.cmpi eq, %qkv_type, %c4i : i32
