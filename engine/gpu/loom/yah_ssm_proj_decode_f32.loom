  %qkv_w = check.generate.fill value(0) : tensor<51609600xi8>
  %gate_w = check.generate.fill value(0) : tensor<25804800xi8>
  %alpha_w = check.generate.fill value(0) : tensor<261120xi8>
  %beta_w = check.generate.fill value(0) : tensor<261120xi8>
  %x = check.file.read.npy path("fixtures/q4k_gemm/gemv_x.npy") : tensor<5120xf32>
  %qkv_out = check.generate.fill value(0.0) : tensor<12288xf32>
  %gate_out = check.generate.fill value(0.0) : tensor<6144xf32>
  %alpha_out = check.generate.fill value(0.0) : tensor<48xf32>
  %beta_out = check.generate.fill value(0.0) : tensor<48xf32>
  %qkv_exp = check.generate.fill value(0.0) : tensor<12288xf32>
  %gate_exp = check.generate.fill value(0.0) : tensor<6144xf32>
