        %j32_qkv_q4k = scalar.shli %j_i_qkv_q4k, %c5i : i32
        %i_i_qkv_q4k = scalar.addi %lane_i, %j32_qkv_q4k : i32
        %prod_qkv_q4k = func.call @q4k_step(%qkv_bytes, %qkv_halfs, %hidden, %qw_view, %qw_f16_view, %x_view, %m_i, %kblk_i_qkv_q4k, %i_i_qkv_q4k) : (index, index, index, view<[%qkv_bytes]xi8>, view<[%qkv_halfs]xf16>, view<[%hidden]xf32>, i32, i32, i32) -> (f32)
        %next_qkv_q4k = scalar.addf %a1_qkv_q4k, %prod_qkv_q4k : f32
        scf.yield %next_qkv_q4k : f32
