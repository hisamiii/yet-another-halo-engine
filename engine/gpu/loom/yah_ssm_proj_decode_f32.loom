func.def @q8_0_step(%wn: index, %wh: index, %xn: index, %w: view<[%wn]xi8>, %wf: view<[%wh]xf16>, %xv: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32, %row_stride: i32) -> (f32) {
