  %gate_is_4 = scalar.cmpi eq, %gate_type, %c4i : i32
  %alpha_is_5 = scalar.cmpi eq, %alpha_type, %c5i : i32
  %beta_is_5 = scalar.cmpi eq, %beta_type, %c5i : i32

  scf.if %in_qkv {
    %qkv_part = scf.if %qkv_is_0 -> (f32) {
    %acc_qkv_q4k = scf.for %kblk_qkv_q4k = [%c0 to %k_groups step %c1](%a0_qkv_q4k = %zero : f32) -> (f32) {
      %kblk_i_qkv_q4k = index.cast %kblk_qkv_q4k : index to i32
      %acc1_qkv_q4k = scf.for %j_qkv_q4k = [%c0 to %c8 step %c1](%a1_qkv_q4k = %a0_qkv_q4k : f32) -> (f32) {
