// YAH fused SSM input projections, Loom port of
// Wave32FusedSSMInputProjectionsKernel_1Row (ssm.hip lines 19-140).
//
// One workgroup per output row over a merged row space of
// qkv_size + inner_size + 2*time_step_rank rows, 32 lanes:
//
//   m < qkv_size                    -> qkv_w[m],            out row m
//   m < qkv_size + inner_size       -> gate_w[m-qkv_size],  out row m-qkv_size
//   m < ... + rank                  -> alpha_w[m-gate_end], out row m-gate_end
//   else                            -> beta_w[m-alpha_end], out row m-alpha_end
//
// Each output is the dot of that weight row with the same fp32 activation:
//
//   out[row] = sum_k decode(W, row, k) * x[k]
//
// accumulated over k_groups = hidden/256 outer steps and 8 j steps of 32 lanes,
// then reduced with kernel.subgroup.reduce<addf> and stored by lane 0.
//
// The weight type of each band is a runtime i32 launch argument:
//   0=Q4_K  1=IQ4_XS  2=IQ4_NL  3=Q5_K  4=Q6_K  5=Q8_0
// On the Qwen3.8-27B-UD-Q4_K_S shard the reachable formats are qkv
// {Q4_K, IQ4_XS, IQ4_NL}, gate {Q4_K, IQ4_XS, Q5_K}, alpha {Q8_0} and
// beta {Q8_0}; the dispatcher also carries the Q5_K and Q6_K arms so that the
// 4200 B/row max-stride qkv/gate view is meaningful and the port covers every
// block format the HIP QuantWarpBlockDot arm can reach.
//
// HIP selects A and out_target once per row and calls QuantWarpBlockDot. Loom
// cannot select a buffer with one value, so each of the four bands is its own
// scf.if and each band's format is a nested scf.if chain. Every branch calls a
// per-format func.def that decodes one element and returns value * x[k]; the
// decode bodies are copied from the matching yah_gemv_*_f32.loom ports (Q8_0
// from ssm.hip lines 95-109).
//
// A band declares exactly ONE i8 view and ONE f16 view, sized at the band's
// maximum supported row stride (4200 B/row for qkv/gate because Q6_K is the
// widest decoder there; hidden/32*34 for the Q8_0 alpha/beta bands). A view per
// format would over-declare the footprint the preflight compares against the
// bound tensor. The per-format decoder clamps every load, so it only touches its
// own row stride range and the padding above it is never read.
//
// Required config: --config=yah_ssm_proj_decode.hidden=<k>
//                  --config=yah_ssm_proj_decode.qkv_size=<rows>
//                  --config=yah_ssm_proj_decode.inner_size=<rows>
//                  --config=yah_ssm_proj_decode.rank=<rows>
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_ssm_proj_decode.hidden : %value: index where [range(%value, 1, 65536)]

config.decl @yah_ssm_proj_decode.qkv_size : %value: index where [range(%value, 1, 65536)]

config.decl @yah_ssm_proj_decode.inner_size : %value: index where [range(%value, 1, 65536)]

config.decl @yah_ssm_proj_decode.rank : %value: index where [range(%value, 1, 4096)]

func.def @q4k_step(%wn: index, %wh: index, %xn: index, %w: view<[%wn]xi8>, %wf: view<[%wh]xf16>, %xv: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %w_last = index.sub %wn, %c1 : index
  %w_half_last = index.sub %wh, %c1 : index
  %x_last = index.sub %xn, %c1 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %row_off = scalar.muli %row_i, %c2880i : i32
  %blk_off0 = scalar.muli %kblk_i, %c144i : i32
  %blk_off = scalar.addi %row_off, %blk_off0 : i32
  %kblk256 = scalar.shli %kblk_i, %c8i : i32
  %gg_i = scalar.shrui %i_i, %c6i : i32
  %wv_i = scalar.andi %i_i, %c63i : i32
  %lane_dec = scalar.andi %wv_i, %c31i : i32
  %wv_hi = scalar.shrui %wv_i, %c5i : i32
  %is_low = scalar.cmpi slt, %wv_i, %c32i : i32
  %qs0 = scalar.addi %blk_off, %c16i : i32
  %gg32 = scalar.shli %gg_i, %c5i : i32
  %qs1 = scalar.addi %qs0, %gg32 : i32
  %qs2 = scalar.addi %qs1, %lane_dec : i32
  %qs_ix = index.cast %qs2 : i32 to index
  %qs_lo = index.max %qs_ix, %c0 : index
  %qs_idx = index.min %qs_lo, %w_last : index
  %qb8 = view.load %w[%qs_idx] : view<[%wn]xi8> -> i8
  %qb = scalar.extui %qb8 : i8 to i32
  %qb_lo = scalar.andi %qb, %c15i : i32
  %qb_hi = scalar.shrui %qb, %c4i : i32
  %quant4 = scf.if %is_low -> (i32) {
    scf.yield %qb_lo : i32
  } else {
    scf.yield %qb_hi : i32
  }
  %gg2 = scalar.shli %gg_i, %c1i : i32
  %sis = scalar.addi %gg2, %wv_hi : i32
  %sis_low = scalar.cmpi slt, %sis, %c4i : i32
  %la0 = scalar.addi %blk_off, %c4i : i32
  %la_i = scalar.addi %la0, %sis : i32
  %lb_i = scalar.addi %la_i, %c4i : i32
  %lc_i = scalar.addi %blk_off, %sis : i32
  %la_ix = index.cast %la_i : i32 to index
  %la_lo = index.max %la_ix, %c0 : index
  %la_idx = index.min %la_lo, %w_last : index
  %lb_ix = index.cast %lb_i : i32 to index
  %lb_lo = index.max %lb_ix, %c0 : index
  %lb_idx = index.min %lb_lo, %w_last : index
  %lc_ix = index.cast %lc_i : i32 to index
  %lc_lo = index.max %lc_ix, %c0 : index
  %lc_idx = index.min %lc_lo, %w_last : index
  %la8 = view.load %w[%la_idx] : view<[%wn]xi8> -> i8
  %lb8 = view.load %w[%lb_idx] : view<[%wn]xi8> -> i8
  %lc8 = view.load %w[%lc_idx] : view<[%wn]xi8> -> i8
  %la = scalar.extui %la8 : i8 to i32
  %lb = scalar.extui %lb8 : i8 to i32
  %lc = scalar.extui %lc8 : i8 to i32
  %sc, %smin = scf.if %sis_low -> (i32, i32) {
    %s = scalar.andi %la, %c63i : i32
    %mv = scalar.andi %lb, %c63i : i32
    scf.yield %s, %mv : i32, i32
  } else {
    %lb_lo2 = scalar.andi %lb, %c15i : i32
    %lc_hi = scalar.shrui %lc, %c6i : i32
    %lc_hi4 = scalar.shli %lc_hi, %c4i : i32
    %s2 = scalar.ori %lb_lo2, %lc_hi4 : i32
    %lb_hi = scalar.shrui %lb, %c4i : i32
    %la_hi = scalar.shrui %la, %c6i : i32
    %la_hi4 = scalar.shli %la_hi, %c4i : i32
    %m2 = scalar.ori %lb_hi, %la_hi4 : i32
    scf.yield %s2, %m2 : i32, i32
  }
  %blk_half0 = scalar.shrui %blk_off, %c1i : i32
  %d_ix = index.cast %blk_half0 : i32 to index
  %d_lo = index.max %d_ix, %c0 : index
  %d_idx = index.min %d_lo, %w_half_last : index
  %dmin0 = scalar.addi %blk_half0, %c1i : i32
  %dmin_ix = index.cast %dmin0 : i32 to index
  %dmin_lo = index.max %dmin_ix, %c0 : index
  %dmin_idx = index.min %dmin_lo, %w_half_last : index
  %d_half_v = view.load %wf[%d_idx] : view<[%wh]xf16> -> f16
  %dmin_half_v = view.load %wf[%dmin_idx] : view<[%wh]xf16> -> f16
  %d = scalar.extf %d_half_v : f16 to f32
  %dmin = scalar.extf %dmin_half_v : f16 to f32
  %sc_f = scalar.sitofp %sc : i32 to f32
  %m_f = scalar.sitofp %smin : i32 to f32
  %q_f = scalar.sitofp %quant4 : i32 to f32
  %dsc = scalar.mulf %d, %sc_f : f32
  %scaled = scalar.mulf %dsc, %q_f : f32
  %dm = scalar.mulf %dmin, %m_f : f32
  %value = scalar.subf %scaled, %dm : f32
  %kidx_i = scalar.addi %kblk256, %i_i : i32
  %kidx_ix = index.cast %kidx_i : i32 to index
  %kidx_lo = index.max %kidx_ix, %c0 : index
  %kidx = index.min %kidx_lo, %x_last : index
  %xm = view.load %xv[%kidx] : view<[%xn]xf32> -> f32
  %prod = scalar.mulf %value, %xm : f32
  func.return %prod : f32
}

func.def @iq4xs_step(%wn: index, %wh: index, %xn: index, %w: view<[%wn]xi8>, %wf: view<[%wh]xf16>, %xv: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %w_last = index.sub %wn, %c1 : index
  %w_half_last = index.sub %wh, %c1 : index
  %x_last = index.sub %xn, %c1 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c136i = scalar.constant 136 : i32
  %c2720i = scalar.constant 2720 : i32
  %kval0 = scalar.constant -127.0 : f32
  %kval1 = scalar.constant -104.0 : f32
  %kval2 = scalar.constant -83.0 : f32
  %kval3 = scalar.constant -65.0 : f32
  %kval4 = scalar.constant -49.0 : f32
  %kval5 = scalar.constant -35.0 : f32
  %kval6 = scalar.constant -22.0 : f32
  %kval7 = scalar.constant -10.0 : f32
  %kval8 = scalar.constant 1.0 : f32
  %kval9 = scalar.constant 13.0 : f32
  %kval10 = scalar.constant 25.0 : f32
  %kval11 = scalar.constant 38.0 : f32
  %kval12 = scalar.constant 53.0 : f32
  %kval13 = scalar.constant 69.0 : f32
  %kval14 = scalar.constant 89.0 : f32
  %kval15 = scalar.constant 113.0 : f32
  %row_off = scalar.muli %row_i, %c2720i : i32
  %blk_off0 = scalar.muli %kblk_i, %c136i : i32
  %blk_off = scalar.addi %row_off, %blk_off0 : i32
  %kblk256 = scalar.shli %kblk_i, %c8i : i32
  %group = scalar.shrui %i_i, %c5i : i32
  %within = scalar.andi %i_i, %c31i : i32
  %l_i = scalar.andi %within, %c15i : i32
  %high = scalar.shrui %within, %c4i : i32
  %g16 = scalar.shli %group, %c4i : i32
  %qs0 = scalar.addi %blk_off, %c8i : i32
  %qs1 = scalar.addi %qs0, %g16 : i32
  %qs2 = scalar.addi %qs1, %l_i : i32
  %qs_ix = index.cast %qs2 : i32 to index
  %qs_lo = index.max %qs_ix, %c0 : index
  %qs_idx = index.min %qs_lo, %w_last : index
  %qb8 = view.load %w[%qs_idx] : view<[%wn]xi8> -> i8
  %qb = scalar.extui %qb8 : i8 to i32
  %nib_lo = scalar.andi %qb, %c15i : i32
  %nib_hi = scalar.shrui %qb, %c4i : i32
  %is_hi = scalar.cmpi eq, %high, %c1i : i32
  %nib = scf.if %is_hi -> (i32) {
    scf.yield %nib_hi : i32
  } else {
    scf.yield %nib_lo : i32
  }
  %nib0 = scalar.andi %nib, %c1i : i32
  %t0 = scalar.cmpi eq, %nib0, %c1i : i32
  %nib1s = scalar.shrui %nib, %c1i : i32
  %nib1 = scalar.andi %nib1s, %c1i : i32
  %t1 = scalar.cmpi eq, %nib1, %c1i : i32
  %nib2s = scalar.shrui %nib, %c2i : i32
  %nib2 = scalar.andi %nib2s, %c1i : i32
  %t2 = scalar.cmpi eq, %nib2, %c1i : i32
  %nib3s = scalar.shrui %nib, %c3i : i32
  %nib3 = scalar.andi %nib3s, %c1i : i32
  %t3 = scalar.cmpi eq, %nib3, %c1i : i32
  %code = scf.if %t3 -> (f32) {
    %cb8_8 = scf.if %t2 -> (f32) {
      %cb12_4 = scf.if %t1 -> (f32) {
        %cb14_2 = scf.if %t0 -> (f32) {
          scf.yield %kval15 : f32
        } else {
          scf.yield %kval14 : f32
        }
        scf.yield %cb14_2 : f32
      } else {
        %cb12_2 = scf.if %t0 -> (f32) {
          scf.yield %kval13 : f32
        } else {
          scf.yield %kval12 : f32
        }
        scf.yield %cb12_2 : f32
      }
      scf.yield %cb12_4 : f32
    } else {
      %cb8_4 = scf.if %t1 -> (f32) {
        %cb10_2 = scf.if %t0 -> (f32) {
          scf.yield %kval11 : f32
        } else {
          scf.yield %kval10 : f32
        }
        scf.yield %cb10_2 : f32
      } else {
        %cb8_2 = scf.if %t0 -> (f32) {
          scf.yield %kval9 : f32
        } else {
          scf.yield %kval8 : f32
        }
        scf.yield %cb8_2 : f32
      }
      scf.yield %cb8_4 : f32
    }
    scf.yield %cb8_8 : f32
  } else {
    %cb0_8 = scf.if %t2 -> (f32) {
      %cb4_4 = scf.if %t1 -> (f32) {
        %cb6_2 = scf.if %t0 -> (f32) {
          scf.yield %kval7 : f32
        } else {
          scf.yield %kval6 : f32
        }
        scf.yield %cb6_2 : f32
      } else {
        %cb4_2 = scf.if %t0 -> (f32) {
          scf.yield %kval5 : f32
        } else {
          scf.yield %kval4 : f32
        }
        scf.yield %cb4_2 : f32
      }
      scf.yield %cb4_4 : f32
    } else {
      %cb0_4 = scf.if %t1 -> (f32) {
        %cb2_2 = scf.if %t0 -> (f32) {
          scf.yield %kval3 : f32
        } else {
          scf.yield %kval2 : f32
        }
        scf.yield %cb2_2 : f32
      } else {
        %cb0_2 = scf.if %t0 -> (f32) {
          scf.yield %kval1 : f32
        } else {
          scf.yield %kval0 : f32
        }
        scf.yield %cb0_2 : f32
      }
      scf.yield %cb0_4 : f32
    }
    scf.yield %cb0_8 : f32
  }
  %gpar = scalar.andi %group, %c1i : i32
  %sh4 = scalar.shli %gpar, %c2i : i32
  %gh = scalar.shrui %group, %c1i : i32
  %sl0 = scalar.addi %blk_off, %c4i : i32
  %sl1 = scalar.addi %sl0, %gh : i32
  %sl_ix = index.cast %sl1 : i32 to index
  %sl_lo2 = index.max %sl_ix, %c0 : index
  %sl_idx = index.min %sl_lo2, %w_last : index
  %sl8 = view.load %w[%sl_idx] : view<[%wn]xi8> -> i8
  %slb = scalar.extui %sl8 : i8 to i32
  %sc_sh = scalar.shrui %slb, %sh4 : i32
  %sc_l = scalar.andi %sc_sh, %c15i : i32
  %sh0 = scalar.addi %blk_off, %c2i : i32
  %sh1 = scalar.addi %blk_off, %c3i : i32
  %sh0_ix = index.cast %sh0 : i32 to index
  %sh0_lo = index.max %sh0_ix, %c0 : index
  %sh0_idx = index.min %sh0_lo, %w_last : index
  %sh1_ix = index.cast %sh1 : i32 to index
  %sh1_lo = index.max %sh1_ix, %c0 : index
  %sh1_idx = index.min %sh1_lo, %w_last : index
  %shb0 = view.load %w[%sh0_idx] : view<[%wn]xi8> -> i8
  %shb1 = view.load %w[%sh1_idx] : view<[%wn]xi8> -> i8
  %shv0 = scalar.extui %shb0 : i8 to i32
  %shv1 = scalar.extui %shb1 : i8 to i32
  %shv1s = scalar.shli %shv1, %c8i : i32
  %shv = scalar.ori %shv0, %shv1s : i32
  %sh2 = scalar.shli %group, %c1i : i32
  %sc_hi_all = scalar.shrui %shv, %sh2 : i32
  %sc_hi = scalar.andi %sc_hi_all, %c3i : i32
  %sc_hi4 = scalar.shli %sc_hi, %c4i : i32
  %sc6 = scalar.ori %sc_l, %sc_hi4 : i32
  %sc = scalar.subi %sc6, %c32i : i32
  %sc_f = scalar.sitofp %sc : i32 to f32
  %blk_half = scalar.shrui %blk_off, %c1i : i32
  %d_ix = index.cast %blk_half : i32 to index
  %d_lo2 = index.max %d_ix, %c0 : index
  %d_idx = index.min %d_lo2, %w_half_last : index
  %d_half_v = view.load %wf[%d_idx] : view<[%wh]xf16> -> f16
  %d = scalar.extf %d_half_v : f16 to f32
  %dsc = scalar.mulf %d, %sc_f : f32
  %value = scalar.mulf %dsc, %code : f32
  %kidx_i = scalar.addi %kblk256, %i_i : i32
  %kidx_ix = index.cast %kidx_i : i32 to index
  %kidx_lo = index.max %kidx_ix, %c0 : index
  %kidx = index.min %kidx_lo, %x_last : index
  %xm = view.load %xv[%kidx] : view<[%xn]xf32> -> f32
  %prod = scalar.mulf %value, %xm : f32
  func.return %prod : f32
}

func.def @iq4nl_step(%wn: index, %wh: index, %xn: index, %w: view<[%wn]xi8>, %wf: view<[%wh]xf16>, %xv: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %w_last = index.sub %wn, %c1 : index
  %w_half_last = index.sub %wh, %c1 : index
  %x_last = index.sub %xn, %c1 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c18i = scalar.constant 18 : i32
  %c31i = scalar.constant 31 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %kval0 = scalar.constant -127.0 : f32
  %kval1 = scalar.constant -104.0 : f32
  %kval2 = scalar.constant -83.0 : f32
  %kval3 = scalar.constant -65.0 : f32
  %kval4 = scalar.constant -49.0 : f32
  %kval5 = scalar.constant -35.0 : f32
  %kval6 = scalar.constant -22.0 : f32
  %kval7 = scalar.constant -10.0 : f32
  %kval8 = scalar.constant 1.0 : f32
  %kval9 = scalar.constant 13.0 : f32
  %kval10 = scalar.constant 25.0 : f32
  %kval11 = scalar.constant 38.0 : f32
  %kval12 = scalar.constant 53.0 : f32
  %kval13 = scalar.constant 69.0 : f32
  %kval14 = scalar.constant 89.0 : f32
  %kval15 = scalar.constant 113.0 : f32
  %row_off = scalar.muli %row_i, %c2880i : i32
  %grp_off0 = scalar.muli %kblk_i, %c144i : i32
  %blk_in = scalar.shrui %i_i, %c5i : i32
  %blk18 = scalar.muli %blk_in, %c18i : i32
  %blk_off0 = scalar.addi %row_off, %grp_off0 : i32
  %blk_off = scalar.addi %blk_off0, %blk18 : i32
  %kblk256 = scalar.shli %kblk_i, %c8i : i32
  %within = scalar.andi %i_i, %c31i : i32
  %l_i = scalar.andi %within, %c15i : i32
  %half = scalar.shrui %within, %c4i : i32
  %shift = scalar.shli %half, %c2i : i32
  %qs0 = scalar.addi %blk_off, %c2i : i32
  %qs_i = scalar.addi %qs0, %l_i : i32
  %qs_ix = index.cast %qs_i : i32 to index
  %qs_lo = index.max %qs_ix, %c0 : index
  %qs_idx = index.min %qs_lo, %w_last : index
  %qb8 = view.load %w[%qs_idx] : view<[%wn]xi8> -> i8
  %qb = scalar.extui %qb8 : i8 to i32
  %nib0s = scalar.shrui %qb, %shift : i32
  %nib = scalar.andi %nib0s, %c15i : i32
  %nib0 = scalar.andi %nib, %c1i : i32
  %t0 = scalar.cmpi eq, %nib0, %c1i : i32
  %nib1s = scalar.shrui %nib, %c1i : i32
  %nib1 = scalar.andi %nib1s, %c1i : i32
  %t1 = scalar.cmpi eq, %nib1, %c1i : i32
  %nib2s = scalar.shrui %nib, %c2i : i32
  %nib2 = scalar.andi %nib2s, %c1i : i32
  %t2 = scalar.cmpi eq, %nib2, %c1i : i32
  %nib3s = scalar.shrui %nib, %c3i : i32
  %nib3 = scalar.andi %nib3s, %c1i : i32
  %t3 = scalar.cmpi eq, %nib3, %c1i : i32
  %code = scf.if %t3 -> (f32) {
    %cb8_8 = scf.if %t2 -> (f32) {
      %cb12_4 = scf.if %t1 -> (f32) {
        %cb14_2 = scf.if %t0 -> (f32) {
          scf.yield %kval15 : f32
        } else {
          scf.yield %kval14 : f32
        }
        scf.yield %cb14_2 : f32
      } else {
        %cb12_2 = scf.if %t0 -> (f32) {
          scf.yield %kval13 : f32
        } else {
          scf.yield %kval12 : f32
        }
        scf.yield %cb12_2 : f32
      }
      scf.yield %cb12_4 : f32
    } else {
      %cb8_4 = scf.if %t1 -> (f32) {
        %cb10_2 = scf.if %t0 -> (f32) {
          scf.yield %kval11 : f32
        } else {
          scf.yield %kval10 : f32
        }
        scf.yield %cb10_2 : f32
      } else {
        %cb8_2 = scf.if %t0 -> (f32) {
          scf.yield %kval9 : f32
        } else {
          scf.yield %kval8 : f32
        }
        scf.yield %cb8_2 : f32
      }
      scf.yield %cb8_4 : f32
    }
    scf.yield %cb8_8 : f32
  } else {
    %cb0_8 = scf.if %t2 -> (f32) {
      %cb4_4 = scf.if %t1 -> (f32) {
        %cb6_2 = scf.if %t0 -> (f32) {
          scf.yield %kval7 : f32
        } else {
          scf.yield %kval6 : f32
        }
        scf.yield %cb6_2 : f32
      } else {
        %cb4_2 = scf.if %t0 -> (f32) {
          scf.yield %kval5 : f32
        } else {
          scf.yield %kval4 : f32
        }
        scf.yield %cb4_2 : f32
      }
      scf.yield %cb4_4 : f32
    } else {
      %cb0_4 = scf.if %t1 -> (f32) {
        %cb2_2 = scf.if %t0 -> (f32) {
          scf.yield %kval3 : f32
        } else {
          scf.yield %kval2 : f32
        }
        scf.yield %cb2_2 : f32
      } else {
        %cb0_2 = scf.if %t0 -> (f32) {
          scf.yield %kval1 : f32
        } else {
          scf.yield %kval0 : f32
        }
        scf.yield %cb0_2 : f32
      }
      scf.yield %cb0_4 : f32
    }
    scf.yield %cb0_8 : f32
  }
  %blk_half0 = scalar.shrui %blk_off, %c1i : i32
  %d_ix = index.cast %blk_half0 : i32 to index
  %d_lo = index.max %d_ix, %c0 : index
  %d_idx = index.min %d_lo, %w_half_last : index
  %d_half_v = view.load %wf[%d_idx] : view<[%wh]xf16> -> f16
  %d = scalar.extf %d_half_v : f16 to f32
  %value = scalar.mulf %d, %code : f32
  %kidx_i = scalar.addi %kblk256, %i_i : i32
  %kidx_ix = index.cast %kidx_i : i32 to index
  %kidx_lo = index.max %kidx_ix, %c0 : index
  %kidx = index.min %kidx_lo, %x_last : index
  %xm = view.load %xv[%kidx] : view<[%xn]xf32> -> f32
  %prod = scalar.mulf %value, %xm : f32
  func.return %prod : f32
}

func.def @q5k_step(%wn: index, %wh: index, %xn: index, %w: view<[%wn]xi8>, %wf: view<[%wh]xf16>, %xv: view<[%xn]xf32>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %w_last = index.sub %wn, %c1 : index
  %w_half_last = index.sub %wh, %c1 : index
  %x_last = index.sub %xn, %c1 : index
