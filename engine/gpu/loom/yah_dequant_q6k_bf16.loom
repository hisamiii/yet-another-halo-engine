// YAH Q6_K weight dequantization to bf16, Loom port of DequantizeQ6KToBf16Kernel
// and its Q6KValueFp element decoder.
//
// HIP source: models/qwen/hip/kernels/prefill_gemm.hip and quant_ops.hpp. A
// block_q6_K is 210 bytes:
//
//   uint8 ql[128]; uint8 qh[64]; int8 scales[16]; __half d
//
// and element i of the 256-wide block is
//
//   half = i/128; within = i%128; segment = within/32; lane = within%32
//   qh_byte = qh[half*32 + lane]
//   ql byte = segment 0/2 ? ql[half*64 + lane] : ql[half*64 + 32 + lane]
//   low     = even segment ? that byte & 0xF : that byte >> 4
//   high    = (qh_byte >> (2*segment)) & 3
//   scale   = scales[half*8 + lane/16 + segment*2]        (int8)
//   quant   = ((high << 4) | low) - 32                    (-32..31)
//   value   = f32(d) * f32(scale) * f32(quant)
//
// As in the Q5_K port, the element loop is written as nested passes rather than a
// single 256-index pass: `index.div` by a power of two lowers to `index.shrui`, which
// the AMDGPU register-unit constraint rejects. Segment splits into two bits, so
// `segment & 1` (the ql half and the qh shift) and `segment >> 1` (the nibble half)
// become loop variables, and `lane/16` becomes its own loop level.
//
// The expected value is written as raw bf16 bit patterns and compared through
// `check.tensor.view`, because numpy has no bf16 dtype.
//
// Required config: --config=yah_dequant_q6k.blocks=2
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_dequant_q6k.blocks : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@yah_wave32) @yah_dequant_q6k() {
  %unit = index.constant 1 : index
  %blocks = config.get @yah_dequant_q6k.blocks : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%blocks, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%w: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c96 = index.constant 96 : index
  %c104 = index.constant 104 : index
  %c105 = index.constant 105 : index
  %c128 = index.constant 128 : index
  %c192 = index.constant 192 : index
  %c210 = index.constant 210 : index
  %c256 = index.constant 256 : index
  %c1i = scalar.constant 1 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c15i = scalar.constant 15 : i32
  %c32i = scalar.constant 32 : i32
  %blocks = config.get @yah_dequant_q6k.blocks : index
  %total = index.mul %blocks, %c256 : index
  %w_f16 = buffer.view %w[%base] : buffer -> view<[%blocks]x[%c105]xf16>
  %w_i8 = buffer.view %w[%base] : buffer -> view<[%blocks]x[%c210]xi8>
  %out_na = buffer.assume.noalias %out : buffer
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%total]xbf16>
  %block = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %d_half = view.load %w_f16[%block, %c104] : view<[%blocks]x[%c105]xf16> -> f16
  %d = scalar.extf %d_half : f16 to f32
  %block_base = index.mul %block, %c256 : index
  %half_sink = scf.for %half = [%c0 to %c2 step %c1](%m0 = %c0 : index) -> (index) {
    %half128 = index.mul %half, %c128 : index
    %half64 = index.mul %half, %c64 : index
    %half32 = index.mul %half, %c32 : index
    %half8 = index.mul %half, %c8 : index
    %qh_row = index.add %c128, %half32 : index
    %sc_row = index.add %c192, %half8 : index
    %hi_sink = scf.for %seg_hi = [%c0 to %c2 step %c1](%m1 = %c0 : index) -> (index) {
      %hi64 = index.mul %seg_hi, %c64 : index
      %hi4 = index.mul %seg_hi, %c4 : index
      %lo_sink = scf.for %seg_lo = [%c0 to %c2 step %c1](%m2 = %c0 : index) -> (index) {
        %lo32 = index.mul %seg_lo, %c32 : index
        %lo2 = index.mul %seg_lo, %c2 : index
        %ql_off = index.add %half64, %lo32 : index
        %scale_off0 = index.add %sc_row, %hi4 : index
        %scale_off1 = index.add %scale_off0, %lo2 : index
        %l16_sink = scf.for %l16 = [%c0 to %c2 step %c1](%m3 = %c0 : index) -> (index) {
          %lane16_sink = scf.for %lane16 = [%c0 to %c16 step %c1](%m4 = %c0 : index) -> (index) {
            %l16_16 = index.mul %l16, %c16 : index
            %lane = index.add %l16_16, %lane16 : index
            %ql_col = index.add %ql_off, %lane : index
            %qh_col = index.add %qh_row, %lane : index
            %scale_col = index.add %scale_off1, %l16 : index
            %ql8 = view.load %w_i8[%block, %ql_col] : view<[%blocks]x[%c210]xi8> -> i8
            %qh8 = view.load %w_i8[%block, %qh_col] : view<[%blocks]x[%c210]xi8> -> i8
            %sc8 = view.load %w_i8[%block, %scale_col] : view<[%blocks]x[%c210]xi8> -> i8
            %ql = scalar.extui %ql8 : i8 to i32
            %qh = scalar.extui %qh8 : i8 to i32
            %sc = scalar.sitofp %sc8 : i8 to f32
            %is_high = index.cmp uge, %seg_hi, %c1 : index
            %low = scf.if %is_high -> (i32) {
              %hi_nib = scalar.shrui %ql, %c4i : i32
              scf.yield %hi_nib : i32
            } else {
              %lo_nib = scalar.andi %ql, %c15i : i32
              scf.yield %lo_nib : i32
            }
            %shift4 = index.mul %seg_hi, %c4 : index
            %shift2 = index.mul %seg_lo, %c2 : index
            %shift = index.add %shift4, %shift2 : index
            %shift_i = index.cast %shift : index to i32
            %qh_shifted = scalar.shrui %qh, %shift_i : i32
            %high = scalar.andi %qh_shifted, %c3i : i32
            %high4 = scalar.shli %high, %c4i : i32
            %code = scalar.ori %high4, %low : i32
            %quant = scalar.subi %code, %c32i : i32
            %quant_f = scalar.sitofp %quant : i32 to f32
            %dsc = scalar.mulf %d, %sc : f32
            %value = scalar.mulf %dsc, %quant_f : f32
            %narrow = scalar.fptrunc %value : f32 to bf16
            %idx0 = index.add %half128, %hi64 : index
            %idx1 = index.add %idx0, %lo32 : index
            %idx2 = index.add %idx1, %lane : index
            %dst = index.add %block_base, %idx2 : index
            view.store %narrow, %out_view[%dst] : bf16, view<[%total]xbf16>
            scf.yield %m4 : index
          }
          scf.yield %m3 : index
        }
        scf.yield %m2 : index
      }
      scf.yield %m1 : index
    }
    scf.yield %m0 : index
  }
  kernel.return
}

// Requires --config=yah_dequant_q6k.blocks=2.
//
// The fixture scales cycle 1, 2, 4, 8 so the scale index is observable, and every
// value is an integer of magnitude at most 248, which bf16 holds exactly. The ql
// and qh planes are varied, so the element mapping is pinned. Comparison is on the
// raw bf16 bits through check.tensor.view.
check.case public @yah_dequant_q6k_case {
  %w = check.file.read.npy path("fixtures/dequant_q6k/input_q6k.npy") : tensor<420xi8>
  %expected = check.file.read.npy path("fixtures/dequant_q6k/expected_bits.npy") : tensor<512xi16>
  %out = check.generate.fill value(0.0) : tensor<512xbf16>
  kernel.launch @yah_dequant_q6k(%w, %out) : (tensor<420xi8>, tensor<512xbf16>)
  %actual_bits = check.tensor.view %out offset(0) : tensor<512xbf16> -> tensor<512xi16>
  check.expect.equal actual(%actual_bits) expected(%expected) : tensor<512xi16>
  check.return
}

check.benchmark<@yah_dequant_q6k_case> @yah_dequant_q6k_bench
