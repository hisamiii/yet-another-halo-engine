// YAH attention output gate, Loom port of ApplyAttentionGateKernel.
//
// HIP source: models/qwen/hip/kernels/attention_batched.hip. An elementwise pass:
//
//   out[i] *= 1 / (1 + exp(-gate[i]))
//
// The kernel is its own index domain: gate and out are read and written at the
// same flat index, so only the stride can be wrong, not the routing.
//
// The check uses two exact points of the sigmoid rather than a fixture. At
// gate = 0 the factor is exactly 0.5, and at gate = 100 fp32 exp(-100) underflows
// to zero so the factor is exactly 1.0. Together they separate 'the gate was
// applied' from 'the gate was read and ignored' from 'the gate was not read', and
// both expectations stay arithmetic sequences. A non-uniform gate has no exact
// expectation and would need a fixture; PORTING.md records that gap.
//
// Required config: --config=yah_attn_gate.num_elements=8
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_attn_gate.num_elements : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@yah_wave32) @yah_attn_gate() {
  %unit = index.constant 1 : index
  %num_elements = config.get @yah_attn_gate.num_elements : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %num_elements, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%gate: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %num_elements = config.get @yah_attn_gate.num_elements : index
  %gate_na, %out_na = buffer.assume.noalias %gate, %out : buffer, buffer
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<[%num_elements]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%num_elements]xf32>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %c256b = index.constant 256 : index
  %wg_base = index.mul %wg, %c256b : index
  %index = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %index, %num_elements : index
  scf.if %in_range {
    %g = view.load %gate_view[%index] : view<[%num_elements]xf32> -> f32
    %negative = scalar.mulf %g, %negone : f32
    %exponential = scalar.expf<afn> %negative : f32
    %denominator = scalar.addf %one, %exponential : f32
    %factor = scalar.divf %one, %denominator : f32
    %previous = view.load %out_view[%index] : view<[%num_elements]xf32> -> f32
    %result = scalar.mulf %previous, %factor : f32
    view.store %result, %out_view[%index] : f32, view<[%num_elements]xf32>
  }
  kernel.return
}

// Requires --config=yah_attn_gate.num_elements=8. gate = 0, so the factor is 0.5.
check.case public @yah_attn_gate_half {
  %gate = check.generate.fill value(0.0) : tensor<8xf32>
  %out = check.generate.iota offset(0.0) step(1.0) : tensor<8xf32>
  %expected = check.generate.iota offset(0.0) step(0.5) : tensor<8xf32>
  kernel.launch @yah_attn_gate(%gate, %out) : (tensor<8xf32>, tensor<8xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.return
}

check.benchmark<@yah_attn_gate_half> @yah_attn_gate_half_bench

// Requires --config=yah_attn_gate.num_elements=8. gate = 100, so exp(-100) flushes
// to zero and the factor is exactly 1.0: the output must come back untouched.
check.case public @yah_attn_gate_open {
  %gate = check.generate.fill value(100.0) : tensor<8xf32>
  %out = check.generate.iota offset(0.0) step(1.0) : tensor<8xf32>
  %expected = check.generate.iota offset(0.0) step(1.0) : tensor<8xf32>
  kernel.launch @yah_attn_gate(%gate, %out) : (tensor<8xf32>, tensor<8xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.return
}

check.benchmark<@yah_attn_gate_open> @yah_attn_gate_open_bench
