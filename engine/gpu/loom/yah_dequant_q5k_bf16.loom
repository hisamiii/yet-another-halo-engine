// YAH Q5_K weight dequantization to bf16, Loom port of DequantizeQ5KToBf16Kernel
// and its Q5KValueFp element decoder.
//
// HIP source: models/qwen/hip/kernels/prefill_gemm.hip and quant_ops.hpp. A
// block_q5_K is 176 bytes:
//
//   __half d; __half dmin; uint8 scales[12]; uint8 qh[32]; uint8 qs[128]
//
// and element i of the 256-wide block is
//
//   gg = i/64; wv = i%64; lane = wv%32; low_half = wv < 32
//   qb     = qs[gg*32 + lane]
//   quant4 = low_half ? qb & 0x0F : qb >> 4
//   bit    = 2*gg + (low_half ? 0 : 1)
//   quant  = quant4 + ((qh[lane] >> bit) & 1 ? 16 : 0)          (0..31)
//   sis    = 2*gg + (low_half ? 0 : 1)
//   (sc, m) = packed scales pair sis          (GetQKScaleMin, Q4_K encoding)
//   value  = f32(d) * sc * quant - f32(dmin) * m
//
// The packed scale decode is the awkward part: a 12-byte array holds eight 6-bit
// scales and eight 6-bit minima. Below sis 4 the pairs are the obvious two
// bytes; at and above 4 the high two bits of one byte join the low four of
// another. This port keeps the branch and the bit surgery verbatim.
//
// The element loop is written as eight (gg, half) passes rather than one pass over
// 256 indices, because splitting by index would need `index.div` by 64 and 32 and
// power-of-two index division lowers to `index.shrui`, which the AMDGPU
// register-unit constraint rejects. The lane supplies the /32 dimension directly.
//
// The expectation is the raw bf16 bit pattern, because bf16 has no numpy dtype:
// the fixture stores int16 bits and the case reinterprets the kernel output with
// `check.tensor.view` before comparing.
//
// Required config: --config=yah_dequant_q5k.blocks=2
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_dequant_q5k.blocks : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@yah_wave32) @yah_dequant_q5k() {
  %unit = index.constant 1 : index
  %blocks = config.get @yah_dequant_q5k.blocks : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%blocks, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%w: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c2 = index.constant 2 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c88 = index.constant 88 : index
  %c176 = index.constant 176 : index
  %c256 = index.constant 256 : index
  %m63i = scalar.constant 63 : i32
  %m15i = scalar.constant 15 : i32
  %m4i = scalar.constant 4 : i32
  %m6i = scalar.constant 6 : i32
  %c16i = scalar.constant 16 : i32
  %c1i = scalar.constant 1 : i32
  %blocks = config.get @yah_dequant_q5k.blocks : index
  %total = index.mul %blocks, %c256 : index
  %w_f16 = buffer.view %w[%base] : buffer -> view<[%blocks]x[%c88]xf16>
  %w_i8 = buffer.view %w[%base] : buffer -> view<[%blocks]x[%c176]xi8>
  %out_na = buffer.assume.noalias %out : buffer
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%total]xbf16>
  %block = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %d_half = view.load %w_f16[%block, %c0] : view<[%blocks]x[%c88]xf16> -> f16
  %dmin_half = view.load %w_f16[%block, %c1] : view<[%blocks]x[%c88]xf16> -> f16
  %d = scalar.extf %d_half : f16 to f32
  %dmin = scalar.extf %dmin_half : f16 to f32
  %block_base = index.mul %block, %c256 : index
  %qh_col0 = index.add %c16, %lane : index
  %qh8 = view.load %w_i8[%block, %qh_col0] : view<[%blocks]x[%c176]xi8> -> i8
  %qh = scalar.extui %qh8 : i8 to i32
  %block_sink = scf.for %gg = [%c0 to %c4 step %c1](%mark = %c0 : index) -> (index) {
    %gg32 = index.mul %gg, %c32 : index
    %qs_col0 = index.add %c48, %gg32 : index
    %qs_col = index.add %qs_col0, %lane : index
    %qb8 = view.load %w_i8[%block, %qs_col] : view<[%blocks]x[%c176]xi8> -> i8
    %qb = scalar.extui %qb8 : i8 to i32
    %gg64 = index.mul %gg, %c64 : index
    %half_sink = scf.for %half = [%c0 to %c2 step %c1](%mark2 = %c0 : index) -> (index) {
      %is_first = index.cmp ult, %half, %c1 : index
      %quant4 = scf.if %is_first -> (i32) {
        %low = scalar.andi %qb, %m15i : i32
        scf.yield %low : i32
      } else {
        %high = scalar.shrui %qb, %m4i : i32
        scf.yield %high : i32
      }
      %half32 = index.mul %half, %c32 : index
      %bit0 = index.mul %gg, %c1 : index
      %bit1 = index.add %bit0, %bit0 : index
      %bit = index.add %bit1, %half : index
      %bitf_i = index.cast %bit : index to i32
      %shifted = scalar.shrui %qh, %bitf_i : i32
      %bitv = scalar.andi %shifted, %c1i : i32
      %high16 = scalar.muli %bitv, %c16i : i32
      %quant = scalar.addi %quant4, %high16 : i32
      %sis0 = index.mul %gg, %c1 : index
      %sis1 = index.add %sis0, %sis0 : index
      %sis = index.add %sis1, %half : index
      %la_col = index.add %c4, %sis : index
      %lb_col = index.add %la_col, %c4 : index
      %la8 = view.load %w_i8[%block, %la_col] : view<[%blocks]x[%c176]xi8> -> i8
      %lb8 = view.load %w_i8[%block, %lb_col] : view<[%blocks]x[%c176]xi8> -> i8
      %la = scalar.extui %la8 : i8 to i32
      %lb = scalar.extui %lb8 : i8 to i32
      %is_low = index.cmp ult, %sis, %c4 : index
      %sc, %m = scf.if %is_low -> (i32, i32) {
        %s = scalar.andi %la, %m63i : i32
        %mm = scalar.andi %lb, %m63i : i32
        scf.yield %s, %mm : i32, i32
      } else {
        %lc8 = view.load %w_i8[%block, %sis] : view<[%blocks]x[%c176]xi8> -> i8
        %lc = scalar.extui %lc8 : i8 to i32
        %lb_lo = scalar.andi %lb, %m15i : i32
        %lc_hi = scalar.shrui %lc, %m6i : i32
        %lc_hi4 = scalar.shli %lc_hi, %m4i : i32
        %s2 = scalar.ori %lb_lo, %lc_hi4 : i32
        %lb_hi = scalar.shrui %lb, %m4i : i32
        %la_hi = scalar.shrui %la, %m6i : i32
        %la_hi4 = scalar.shli %la_hi, %m4i : i32
        %mm2 = scalar.ori %lb_hi, %la_hi4 : i32
        scf.yield %s2, %mm2 : i32, i32
      }
      %sc_f = scalar.sitofp %sc : i32 to f32
      %m_f = scalar.sitofp %m : i32 to f32
      %quant_f = scalar.sitofp %quant : i32 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %scaled = scalar.mulf %dsc, %quant_f : f32
      %dm = scalar.mulf %dmin, %m_f : f32
      %value = scalar.subf %scaled, %dm : f32
      %narrow = scalar.fptrunc %value : f32 to bf16
      %idx0 = index.add %gg64, %half32 : index
      %idx1 = index.add %idx0, %lane : index
      %dst = index.add %block_base, %idx1 : index
      view.store %narrow, %out_view[%dst] : bf16, view<[%total]xbf16>
      scf.yield %mark2 : index
    }
    scf.yield %mark : index
  }
  kernel.return
}

// Requires --config=yah_dequant_q5k.blocks=2.
//
// The fixture picks scales so every sc is 1 and every m is 0, which makes the
// expected value exactly the 0..31 quant code; the codes and the high-bit plane
// are both varied, so the index mapping is pinned. The comparison is on the raw
// bf16 bit patterns through check.tensor.view, because bf16 has no numpy dtype.
check.case public @yah_dequant_q5k_case {
  %w = check.file.read.npy path("fixtures/dequant_q5k/input_q5k.npy") : tensor<352xi8>
  %expected = check.file.read.npy path("fixtures/dequant_q5k/expected_bits.npy") : tensor<512xi16>
  %out = check.generate.fill value(0.0) : tensor<512xbf16>
  kernel.launch @yah_dequant_q5k(%w, %out) : (tensor<352xi8>, tensor<512xbf16>)
  %actual_bits = check.tensor.view %out offset(0) : tensor<512xbf16> -> tensor<512xi16>
  check.expect.equal actual(%actual_bits) expected(%expected) : tensor<512xi16>
  check.return
}

check.benchmark<@yah_dequant_q5k_case> @yah_dequant_q5k_bench
