// YAH batched KV cache write, Loom port of WriteBatchedKVCacheKernel.
//
// HIP source: models/qwen/hip/kernels/attention_batched.hip. One workgroup per
// (kv head, batch) copies head_dim values of k and v into the cache position
// start_pos + b, in whichever of four destinations are present:
//
//   pos       = start_pos + b
//   f32 cache: ((layer*num_kv_heads + kv_head)*max_context + pos)*head_dim + i
//   f16 cache: ((layer*max_context + pos)*num_kv_heads*head_dim)
//              + kv_head*head_dim + i
//
// The two layouts are transposes of each other in (head, position) order and
// coincide only when max_context == num_kv_heads, which the fixture deliberately
// avoids. The HIP kernel treats each destination as optional; this port requires
// all four to be present and PORTING.md records that the null forms are not
// covered.
//
// Every expectation is a copy or an exact f16 of a small integer, so the fixture
// comparison is bit-exact.
//
// Required config: --config=yah_kv_write.layer_idx=0
//                  --config=yah_kv_write.start_pos=0
//                  --config=yah_kv_write.batch_size=2
//                  --config=yah_kv_write.max_context=3
//                  --config=yah_kv_write.num_kv_heads=2
//                  --config=yah_kv_write.head_dim=4
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_kv_write.layer_idx : %value: index where [range(%value, 0, 65536)]

config.decl @yah_kv_write.start_pos : %value: index where [range(%value, 0, 1073741824)]

config.decl @yah_kv_write.batch_size : %value: index where [range(%value, 1, 65536)]

config.decl @yah_kv_write.max_context : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_kv_write.num_kv_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_kv_write.head_dim : %value: index where [range(%value, 1, 1024)]

kernel.def target(@yah_wave32) @yah_kv_write() {
  %unit = index.constant 1 : index
  %num_kv_heads = config.get @yah_kv_write.num_kv_heads : index
  %batch_size = config.get @yah_kv_write.batch_size : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%num_kv_heads, %batch_size, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%k: buffer, %v: buffer, %k_cache: buffer, %v_cache: buffer, %k_cache_f16: buffer, %v_cache_f16: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c32 = index.constant 32 : index
  %layer_idx = config.get @yah_kv_write.layer_idx : index
  %start_pos = config.get @yah_kv_write.start_pos : index
  %batch_size = config.get @yah_kv_write.batch_size : index
  %max_context = config.get @yah_kv_write.max_context : index
  %num_kv_heads = config.get @yah_kv_write.num_kv_heads : index
  %head_dim = config.get @yah_kv_write.head_dim : index
  %kv_width = index.mul %num_kv_heads, %head_dim : index
  %source_total = index.mul %batch_size, %kv_width : index
  %cache_total = index.mul %num_kv_heads, %max_context : index
  %cache_elems = index.mul %cache_total, %head_dim : index
  %k_na, %v_na, %kc_na, %vc_na, %kh_na, %vh_na = buffer.assume.noalias %k, %v, %k_cache, %v_cache, %k_cache_f16, %v_cache_f16 : buffer, buffer, buffer, buffer, buffer, buffer
  %k_view = buffer.view %k_na[%base] : buffer -> view<[%source_total]xf32>
  %v_view = buffer.view %v_na[%base] : buffer -> view<[%source_total]xf32>
  %kc_view = buffer.view %kc_na[%base] : buffer -> view<[%cache_elems]xf32>
  %vc_view = buffer.view %vc_na[%base] : buffer -> view<[%cache_elems]xf32>
  %kh_view = buffer.view %kh_na[%base] : buffer -> view<[%cache_elems]xf16>
  %vh_view = buffer.view %vh_na[%base] : buffer -> view<[%cache_elems]xf16>
  %kv_head = kernel.workgroup.id<x> : index
  %b = kernel.workgroup.id<y> : index
  %tid = kernel.workitem.id<x> : index
  %pos = index.add %start_pos, %b : index
  %b_row = index.mul %b, %kv_width : index
  %head_off = index.mul %kv_head, %head_dim : index
  %source = index.add %b_row, %head_off : index
  %layer_heads = index.mul %layer_idx, %num_kv_heads : index
  %cache_head = index.add %layer_heads, %kv_head : index
  %cache_row = index.mul %cache_head, %max_context : index
  %cache_pos = index.add %cache_row, %pos : index
  %cache_base = index.mul %cache_pos, %head_dim : index
  %layer_ctx = index.mul %layer_idx, %max_context : index
  %f16_pos = index.add %layer_ctx, %pos : index
  %f16_row = index.mul %f16_pos, %kv_width : index
  %f16_base = index.add %f16_row, %head_off : index
  %sink = scf.for %i = [%tid to %head_dim step %c32](%mark = %c0 : index) -> (index) {
    %src = index.add %source, %i : index
    %dst32 = index.add %cache_base, %i : index
    %dst16 = index.add %f16_base, %i : index
    %key = view.load %k_view[%src] : view<[%source_total]xf32> -> f32
    %val = view.load %v_view[%src] : view<[%source_total]xf32> -> f32
    %key16 = scalar.fptrunc %key : f32 to f16
    %val16 = scalar.fptrunc %val : f32 to f16
    view.store %key, %kc_view[%dst32] : f32, view<[%cache_elems]xf32>
    view.store %val, %vc_view[%dst32] : f32, view<[%cache_elems]xf32>
    view.store %key16, %kh_view[%dst16] : f16, view<[%cache_elems]xf16>
    view.store %val16, %vh_view[%dst16] : f16, view<[%cache_elems]xf16>
    scf.yield %mark : index
  }
  kernel.return
}

// Requires the config block above.
check.case public @yah_kv_write_case {
  %k = check.generate.iota offset(0.0) step(1.0) : tensor<16xf32>
  %v = check.generate.iota offset(100.0) step(1.0) : tensor<16xf32>
  %k_cache = check.generate.fill value(0.0) : tensor<24xf32>
  %v_cache = check.generate.fill value(0.0) : tensor<24xf32>
  %k_cache_f16 = check.generate.fill value(0.0) : tensor<24xf16>
  %v_cache_f16 = check.generate.fill value(0.0) : tensor<24xf16>
  %expected_k = check.file.read.npy path("fixtures/kv_cache_write/expected_k_cache.npy") : tensor<24xf32>
  %expected_v = check.file.read.npy path("fixtures/kv_cache_write/expected_v_cache.npy") : tensor<24xf32>
  %expected_k16 = check.file.read.npy path("fixtures/kv_cache_write/expected_k_cache_f16.npy") : tensor<24xf16>
  %expected_v16 = check.file.read.npy path("fixtures/kv_cache_write/expected_v_cache_f16.npy") : tensor<24xf16>
  kernel.launch @yah_kv_write(%k, %v, %k_cache, %v_cache, %k_cache_f16, %v_cache_f16) : (tensor<16xf32>, tensor<16xf32>, tensor<24xf32>, tensor<24xf32>, tensor<24xf16>, tensor<24xf16>)
  check.expect.close actual(%k_cache) expected(%expected_k) atol(0.0) rtol(0.0) nan(same) : tensor<24xf32>
  check.expect.close actual(%v_cache) expected(%expected_v) atol(0.0) rtol(0.0) nan(same) : tensor<24xf32>
  check.expect.close actual(%k_cache_f16) expected(%expected_k16) atol(0.0) rtol(0.0) nan(same) : tensor<24xf16>
  check.expect.close actual(%v_cache_f16) expected(%expected_v16) atol(0.0) rtol(0.0) nan(same) : tensor<24xf16>
  check.return
}

check.benchmark<@yah_kv_write_case> @yah_kv_write_bench
