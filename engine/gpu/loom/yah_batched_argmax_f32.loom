// YAH batched argmax, Loom port of BatchedArgmaxKernel<false, false>.
//
// HIP source: sample.hip. One workgroup per row; the maximum is over finite logits
// only, and ties keep the smallest index. The HIP shared-memory tree carries a
// (value, index) pair so it can break ties during the reduction. Loom reductions
// are single-valued, so the port makes two passes: one `maxnumf` workgroup
// reduction for the value, then one `minui` workgroup reduction for the smallest
// index whose finite value equals that maximum. Both give the same answer.
//
// The Partial and MapIndices template arms (tiled vocabulary, candidate remap) are
// not ported; this is the plain full-row arm.
//
// Required config: --config=yah_batched_argmax.rows=2 --config=yah_batched_argmax.vocab=8
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_batched_argmax.rows : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_batched_argmax.vocab : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@yah_wave32) @yah_batched_argmax() {
  %unit = index.constant 1 : index
  %rows = config.get @yah_batched_argmax.rows : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%logits: buffer, %out_tokens: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %limit = scalar.constant 3.4028234663852886e+38 : f32
  %neg_infinite = scalar.constant -3.9999999999999999e+38 : f32
  %cneg1 = scalar.constant -1 : i32
  %rows = config.get @yah_batched_argmax.rows : index
  %vocab = config.get @yah_batched_argmax.vocab : index
  %total = index.mul %rows, %vocab : index
  %logits_na, %out_na = buffer.assume.noalias %logits, %out_tokens : buffer, buffer
  %logits_view = buffer.view %logits_na[%base] : buffer -> view<[%total]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%rows]xi32>
  %row = kernel.workgroup.id<x> : index
  %tid = kernel.workitem.id<x> : index
  %row_base = index.mul %row, %vocab : index
  // Pass one: the maximum finite value.
  %local_max = scf.for %i = [%tid to %vocab step %c256](%acc = %neg_infinite : f32) -> (f32) {
    %e = index.add %row_base, %i : index
    %v = view.load %logits_view[%e] : view<[%total]xf32> -> f32
    %mag = scalar.absf %v : f32
    %finite = scalar.cmpf ole, %mag, %limit : f32
    %bigger = scalar.cmpf ogt, %v, %acc : f32
    %next = scf.if %finite -> (f32) {
      %b = scf.if %bigger -> (f32) {
        scf.yield %v : f32
      } else {
        scf.yield %acc : f32
      }
      scf.yield %b : f32
    } else {
      scf.yield %acc : f32
    }
    scf.yield %next : f32
  }
  %max_val = kernel.workgroup.reduce<maxnumf> %local_max : f32
  // Pass two: the smallest finite index with that value.
  %local_idx = scf.for %j = [%tid to %vocab step %c256](%acc2 = %cneg1 : i32) -> (i32) {
    %e2 = index.add %row_base, %j : index
    %v2 = view.load %logits_view[%e2] : view<[%total]xf32> -> f32
    %mag2 = scalar.absf %v2 : f32
    %finite2 = scalar.cmpf ole, %mag2, %limit : f32
    %equal = scalar.cmpf oeq, %v2, %max_val : f32
    %j_i = index.cast %j : index to i32
    %take2 = scf.if %finite2 -> (i32) {
      %eq2 = scf.if %equal -> (i32) {
        %m = scalar.minui %acc2, %j_i : i32
        scf.yield %m : i32
      } else {
        scf.yield %acc2 : i32
      }
      scf.yield %eq2 : i32
    } else {
      scf.yield %acc2 : i32
    }
    scf.yield %take2 : i32
  }
  %first = kernel.workgroup.reduce<minui> %local_idx : i32
  %lane = kernel.workitem.id<x> : index
  %is_leader = index.cmp eq, %lane, %c0 : index
  scf.if %is_leader {
    view.store %first, %out_view[%row] : i32, view<[%rows]xi32>
  }
  kernel.return
}

// Requires --config=yah_batched_argmax.rows=2 --config=yah_batched_argmax.vocab=8.
//
// Row 0 is {1,3,2,3,0,5,5,4} (max 5, first at 5) and row 1 is {0,-1,7,7,7,2,3,4}
// (max 7, first at 2). The repeated maxima are what pin the tie break to the
// smallest index rather than whichever lane happened to win the tree.
check.case public @yah_batched_argmax_case {
  %logits = check.file.read.npy path("fixtures/batched_argmax/logits.npy") : tensor<2x8xf32>
  %out = check.generate.fill value(0) : tensor<2xi32>
  %expected = check.file.read.npy path("fixtures/batched_argmax/expected.npy") : tensor<2xi32>
  kernel.launch @yah_batched_argmax(%logits, %out) : (tensor<2x8xf32>, tensor<2xi32>)
  check.expect.equal actual(%out) expected(%expected) : tensor<2xi32>
  check.return
}

check.benchmark<@yah_batched_argmax_case> @yah_batched_argmax_bench
