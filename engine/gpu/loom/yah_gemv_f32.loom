// YAH decode GEMV, Loom port of FastGEMVBlockKernel.
//
// HIP source: models/qwen/hip/kernels/gemv.hip. One row of the weight matrix per
// output element:
//
//   y[m] = sum_k A[m][k] * x[k]
//
// The HIP kernel is one block per row with a redundant vectorised load (the bf16 and
// f32 paths differ only in the weight element type) and a shuffle reduction followed
// by a shared-memory cross-warp combine. This port covers the f32 weight path and
// re-tiles it to one subgroup per row with a lane-strided scalar dot and a single
// `kernel.subgroup.reduce<addf>`; the reduction order differs and the sum is the
// same. The bf16 weight path stays on the queue.
//
// The check needs no fixture: with `x` all ones and the weight an iota, each output
// is the sum of its weight row, which is the arithmetic sequence `K*K*m + K(K-1)/2`.
// A wrong row stride or a wrong reduction changes it.
//
// Required config: --config=yah_gemv.rows=3 --config=yah_gemv.k=4
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_gemv.rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_gemv.k : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_gemv() {
  %unit = index.constant 1 : index
  %rows = config.get @yah_gemv.rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%a: buffer, %x: buffer, %y: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c32 = index.constant 32 : index
  %zero = scalar.constant 0.0 : f32
  %rows = config.get @yah_gemv.rows : index
  %k = config.get @yah_gemv.k : index
  %a_total = index.mul %rows, %k : index
  %a_na, %x_na, %y_na = buffer.assume.noalias %a, %x, %y : buffer, buffer, buffer
  %a_view = buffer.view %a_na[%base] : buffer -> view<[%rows]x[%k]xf32>
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%k]xf32>
  %y_view = buffer.view %y_na[%base] : buffer -> view<[%rows]xf32>
  %m = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %acc = scf.for %kk = [%lane to %k step %c32](%s = %zero : f32) -> (f32) {
    %w = view.load %a_view[%m, %kk] : view<[%rows]x[%k]xf32> -> f32
    %xv = view.load %x_view[%kk] : view<[%k]xf32> -> f32
    %prod = scalar.mulf %w, %xv : f32
    %next = scalar.addf %s, %prod : f32
    scf.yield %next : f32
  }
  %dot = kernel.subgroup.reduce<addf> %acc : f32
  %is_leader = index.cmp eq, %lane, %c0 : index
  scf.if %is_leader {
    view.store %dot, %y_view[%m] : f32, view<[%rows]xf32>
  }
  kernel.return
}

// Requires --config=yah_gemv.rows=3 --config=yah_gemv.k=4.
//
// Row m of an iota weight holds m*K .. m*K+K-1, so its sum is K*K*m + K(K-1)/2:
// with K = 4 that is 16*m + 6, an arithmetic sequence with a wrong stride or a
// wrong reduction order changing it.
check.case public @yah_gemv_case {
  %a = check.generate.iota offset(0.0) step(1.0) : tensor<3x4xf32>
  %x = check.generate.fill value(1.0) : tensor<4xf32>
  %y = check.generate.fill value(0.0) : tensor<3xf32>
  %expected = check.generate.iota offset(6.0) step(16.0) : tensor<3xf32>
  kernel.launch @yah_gemv(%a, %x, %y) : (tensor<3x4xf32>, tensor<4xf32>, tensor<3xf32>)
  check.expect.close actual(%y) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<3xf32>
  check.return
}

check.benchmark<@yah_gemv_case> @yah_gemv_bench
