// YAH RoPE, Loom port of RoPEKernel.
//
// HIP source: rope.hip. For every (head, pair) the half-rotation is
//
//   exponent = 2 * pair / rotary_dim
//   inv_freq = 1 / theta^exponent
//   angle    = position * inv_freq          position = pos (text path)
//   c = cos(angle), s = sin(angle)
//   q[h][pair]           = q0 * c - q1 * s
//   q[h][pair+half_rot]  = q0 * s + q1 * c
//
// and the same for k over num_kv_heads. Views are 2-D [heads][head_dim] so the
// verifier can check each axis; the flat form put both axes into one index and
// the subrange check could not bound it.
//
// This port covers the text path, where the vision mRoPE table is null so
// RopePosition returns the physical position unchanged. The mRoPE variant indexes
// a positions table and is a separate port.
//
// Check coverage note: pos = 0 makes the rotation exactly the identity (c = 1,
// s = 0), which verifies the head, pair and idx0/idx1 indexing exactly but not
// the rotation arithmetic. A nonzero angle needs a per-element expectation that
// check.generate.iota cannot express, so the arithmetic needs a captured fixture.
//
// The trig ops carry <afn>: the AMDGPU math policy rejects exact f32 sinf/cosf
// under math.trig.exact_f32. loom-check accepts the exact form, so only a real
// target compilation catches this.
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_rope.total_pairs : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_rope.q_heads : %value: index where [range(%value, 1, 1024)]

config.decl @yah_rope.k_heads : %value: index where [range(%value, 1, 1024)]

config.def @yah_rope.head_dim = 128 : index

config.def @yah_rope.rotary_dim = 128 : index

config.def @yah_rope.theta = 10000000.0 : f32

config.def @yah_rope.pos = 0 : index

kernel.def target(@yah_wave32) @yah_rope() {
  %unit = index.constant 1 : index
  %total = config.get @yah_rope.total_pairs : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %total, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%q: buffer, %k: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c256 = index.constant 256 : index
  %total = config.get @yah_rope.total_pairs : index
  %q_heads = config.get @yah_rope.q_heads : index
  %k_heads = config.get @yah_rope.k_heads : index
  %head_dim = config.get @yah_rope.head_dim : index
  %rotary_dim = config.get @yah_rope.rotary_dim : index
  %theta = config.get @yah_rope.theta : f32
  %pos = config.get @yah_rope.pos : index
  %half_rot = index.div %rotary_dim, %c2 : index

  %rotary_dimf = scalar.constant 128.0 : f32
  %two = scalar.constant 2.0 : f32
  %one = scalar.constant 1.0 : f32

  %q_noalias, %k_noalias = buffer.assume.noalias %q, %k : buffer, buffer
  %q_view = buffer.view %q_noalias[%base] : buffer -> view<[%q_heads]x[%head_dim]xf32>
  %k_view = buffer.view %k_noalias[%base] : buffer -> view<[%k_heads]x[%head_dim]xf32>

  %lane = kernel.workitem.id<x> : index
  %wg = kernel.workgroup.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %tid = index.add %wg_base, %lane : index

  %posi = index.cast %pos : index to i32
  %posf = scalar.sitofp %posi : i32 to f32

  %in_range = index.cmp ult, %tid, %total : index
  scf.if %in_range {
    %h = index.div %tid, %half_rot : index
    %pair = index.rem %tid, %half_rot : index
    %pairi = index.cast %pair : index to i32
    %pairf = scalar.sitofp %pairi : i32 to f32
    %twopair = scalar.mulf %two, %pairf : f32
    %exponent = scalar.divf %twopair, %rotary_dimf : f32
    %inv_freq = scalar.powf<afn> %theta, %exponent : f32
    %inv = scalar.divf %one, %inv_freq : f32
    %angle = scalar.mulf %posf, %inv : f32
    %cos_v = scalar.cosf<afn> %angle : f32
    %sin_v = scalar.sinf<afn> %angle : f32
    %pair1 = index.add %pair, %half_rot : index
    %q_ok = index.cmp ult, %h, %q_heads : index
    scf.if %q_ok {
      %q0 = view.load %q_view[%h, %pair] : view<[%q_heads]x[%head_dim]xf32> -> f32
      %q1 = view.load %q_view[%h, %pair1] : view<[%q_heads]x[%head_dim]xf32> -> f32
      %qc = scalar.mulf %q0, %cos_v : f32
      %qs = scalar.mulf %q1, %sin_v : f32
      %qn0 = scalar.subf %qc, %qs : f32
      %qa = scalar.mulf %q0, %sin_v : f32
      %qb = scalar.mulf %q1, %cos_v : f32
      %qn1 = scalar.addf %qa, %qb : f32
      view.store %qn0, %q_view[%h, %pair] : f32, view<[%q_heads]x[%head_dim]xf32>
      view.store %qn1, %q_view[%h, %pair1] : f32, view<[%q_heads]x[%head_dim]xf32>
    }
    %k_ok = index.cmp ult, %h, %k_heads : index
    scf.if %k_ok {
      %k0 = view.load %k_view[%h, %pair] : view<[%k_heads]x[%head_dim]xf32> -> f32
      %k1 = view.load %k_view[%h, %pair1] : view<[%k_heads]x[%head_dim]xf32> -> f32
      %kc = scalar.mulf %k0, %cos_v : f32
      %ks = scalar.mulf %k1, %sin_v : f32
      %kn0 = scalar.subf %kc, %ks : f32
      %ka = scalar.mulf %k0, %sin_v : f32
      %kb = scalar.mulf %k1, %cos_v : f32
      %kn1 = scalar.addf %ka, %kb : f32
      view.store %kn0, %k_view[%h, %pair] : f32, view<[%k_heads]x[%head_dim]xf32>
      view.store %kn1, %k_view[%h, %pair1] : f32, view<[%k_heads]x[%head_dim]xf32>
    }
  }
  kernel.return
}

check.case public @yah_rope_case {
  %q = check.generate.iota offset(1.0) step(1.0) : tensor<4x128xf32>
  %k = check.generate.iota offset(100.0) step(2.0) : tensor<2x128xf32>
  %q_expected = check.generate.iota offset(1.0) step(1.0) : tensor<4x128xf32>
  %k_expected = check.generate.iota offset(100.0) step(2.0) : tensor<2x128xf32>
  kernel.launch @yah_rope(%q, %k) : (tensor<4x128xf32>, tensor<2x128xf32>)
  check.expect.close actual(%q) expected(%q_expected) atol(0.0) rtol(0.0) nan(same) : tensor<4x128xf32>
  check.expect.close actual(%k) expected(%k_expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x128xf32>
  check.return
}

check.benchmark<@yah_rope_case> @yah_rope_bench
