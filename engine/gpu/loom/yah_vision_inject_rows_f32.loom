// YAH vision embedding row injection, Loom port of InjectRows.
//
// HIP source: models/qwen/vision/device_input.hip. Broadcasts one embedding row
// across hc hidden rows:
//
//   row       = i / (width*hc)
//   hidden[i] = embedding[row*width + i % width]
//
// Both divisors here are runtime products rather than power-of-two constants, so a
// plain `index.div` and `index.rem` lower to real divisions and the register-unit
// constraint that rejects `index.shrui` does not apply. No loop restructuring is
// needed for this one.
//
// The check uses hc = 2 so the broadcast is real; at hc = 1 the kernel is the
// identity and any index expression would pass. The flat result is a repeating
// pattern within each half rather than one arithmetic sequence, so it is a fixture.
//
// Required config: --config=yah_vision_inject_rows.rows=2
//                  --config=yah_vision_inject_rows.width=3
//                  --config=yah_vision_inject_rows.hc=2
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_vision_inject_rows.rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_vision_inject_rows.width : %value: index where [range(%value, 1, 65536)]

config.decl @yah_vision_inject_rows.hc : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_wave32) @yah_vision_inject_rows() {
  %unit = index.constant 1 : index
  %rows = config.get @yah_vision_inject_rows.rows : index
  %width = config.get @yah_vision_inject_rows.width : index
  %hc = config.get @yah_vision_inject_rows.hc : index
  %row_width = index.mul %width, %hc : index
  %total = index.mul %rows, %row_width : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %total, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%hidden: buffer, %embedding: buffer) {
  %base = index.constant 0 : offset
  %c256 = index.constant 256 : index
  %rows = config.get @yah_vision_inject_rows.rows : index
  %width = config.get @yah_vision_inject_rows.width : index
  %hc = config.get @yah_vision_inject_rows.hc : index
  %row_width = index.mul %width, %hc : index
  %total = index.mul %rows, %row_width : index
  %embedding_elems = index.mul %rows, %width : index
  %hidden_na, %embedding_na = buffer.assume.noalias %hidden, %embedding : buffer, buffer
  %hidden_view = buffer.view %hidden_na[%base] : buffer -> view<[%total]xf32>
  %embedding_view = buffer.view %embedding_na[%base] : buffer -> view<[%embedding_elems]xf32>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %i = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %i, %total : index
  scf.if %in_range {
    %row = index.div %i, %row_width : index
    %col = index.rem %i, %width : index
    %row_base = index.mul %row, %width : index
    %src = index.add %row_base, %col : index
    %v = view.load %embedding_view[%src] : view<[%embedding_elems]xf32> -> f32
    view.store %v, %hidden_view[%i] : f32, view<[%total]xf32>
  }
  kernel.return
}

// Requires --config=yah_vision_inject_rows.rows=2 --config=yah_vision_inject_rows.width=3
// --config=yah_vision_inject_rows.hc=2.
check.case public @yah_vision_inject_rows_case {
  %embedding = check.generate.iota offset(0.0) step(1.0) : tensor<6xf32>
  %hidden = check.generate.fill value(0.0) : tensor<12xf32>
  %expected = check.file.read.npy path("fixtures/vision_inject_rows/expected_hidden.npy") : tensor<12xf32>
  kernel.launch @yah_vision_inject_rows(%hidden, %embedding) : (tensor<12xf32>, tensor<6xf32>)
  check.expect.close actual(%hidden) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<12xf32>
  check.return
}

check.benchmark<@yah_vision_inject_rows_case> @yah_vision_inject_rows_bench
