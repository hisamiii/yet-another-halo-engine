      %qh_ix = index.cast %qh_i : i32 to index
      %qh_lo = index.max %qh_ix, %c0 : index
      %qh_idx = index.min %qh_lo, %wlast : index
      %qhb8 = view.load %wv[%qh_idx] : view<[%wn]xi8> -> i8
      %qhb = scalar.extui %qhb8 : i8 to i32
      %hbit0 = scalar.shrui %qhb, %lw : i32
      %hbit = scalar.andi %hbit0, %c1i : i32
      %hbit8 = scalar.shli %hbit, %c8i : i32
      %gidx_i = scalar.ori %grid_lo, %hbit8 : i32
      %gidx_ix = index.cast %gidx_i : i32 to index
      %gidx_lo = index.max %gidx_ix, %c0 : index
      %gidx = index.min %gidx_lo, %c511 : index
      %gword = view.load %gs[%gidx] : view<512xi32> -> i32
      %g_shift = scalar.shli %b, %c3i : i32
      %gb0 = scalar.shrui %gword, %g_shift : i32
      %g_byte = scalar.andi %gb0, %c255i : i32
      %sg4 = scalar.shli %group, %c2i : i32
      %sgo = scalar.addi %blk_off, %c74i : i32
      %sg1 = scalar.addi %sgo, %sg4 : i32
      %sg_i = scalar.addi %sg1, %l : i32
      %sg_ix = index.cast %sg_i : i32 to index
      %sg_lo = index.max %sg_ix, %c0 : index
      %sg_idx = index.min %sg_lo, %wlast : index
      %sgb8 = view.load %wv[%sg_idx] : view<[%wn]xi8> -> i8
      %sgb = scalar.extui %sgb8 : i8 to i32
      %is_g1 = scalar.cmpi eq, %which, %c0i : i32
      %sign_nib = scf.if %is_g1 -> (i32) {
        %sn_lo = scalar.andi %sgb, %c15i : i32
        scf.yield %sn_lo : i32
      } else {
        %sn_hi = scalar.shrui %sgb, %c4i : i32
        scf.yield %sn_hi : i32
      }
      %sbit0 = scalar.shrui %sign_nib, %b : i32
      %sign_bit = scalar.andi %sbit0, %c1i : i32
      %is_neg = scalar.cmpi eq, %sign_bit, %c1i : i32
      %neg_g = scalar.subi %c0i, %g_byte : i32
      %mag = scf.if %is_neg -> (i32) {
        scf.yield %neg_g : i32
