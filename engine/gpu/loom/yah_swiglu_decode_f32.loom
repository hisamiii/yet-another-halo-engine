      %l = scalar.addi %l2, %q : i32
      %l2x = scalar.shli %l, %c1i : i32
      %lw = scalar.addi %l2x, %which : i32
      %g8 = scalar.shli %group, %c3i : i32
      %qso = scalar.addi %blk_off, %c2i : i32
      %g8a = scalar.addi %qso, %g8 : i32
