}


config.decl @yah_swiglu_decode.m_rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_swiglu_decode.k_groups : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_swiglu_decode() {
  %unit = index.constant 1 : index
  %m_rows = config.get @yah_swiglu_decode.m_rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_rows, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%gate_w: buffer, %up_w: buffer, %grid_s: buffer, %grid_x: buffer, %grid_q: buffer, %grid_p: buffer, %ksigns: buffer, %x: buffer, %out: buffer, %gate_type: i32, %up_type: i32) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c4200 = index.constant 4200 : index
  %c2100 = index.constant 2100 : index
  %c256 = index.constant 256 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c5i = scalar.constant 5 : i32
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
