  %gw = buffer.view %gw_na[%base] : buffer -> view<[%w_bytes]xi8>
  %gwh = buffer.view %gw_na[%base] : buffer -> view<[%w_halfs]xf16>
  %uw = buffer.view %uw_na[%base] : buffer -> view<[%w_bytes]xi8>
  %uwh = buffer.view %uw_na[%base] : buffer -> view<[%w_halfs]xf16>
  %gs = buffer.view %gs_na[%base] : buffer -> view<512xi32>
