      %wsel = scalar.shrui %j8, %c2i : i32
      %w1 = scalar.addi %w0, %wsel : i32
      %w_ix = index.cast %w1 : i32 to index
      %w_lo = index.max %w_ix, %c0 : index
      %w_idx = index.min %w_lo, %c2047 : index
      %gword = view.load %gp[%w_idx] : view<2048xi32> -> i32
      %j4 = scalar.andi %j8, %c3i : i32
      %gsh = scalar.shli %j4, %c3i : i32
      %gb0 = scalar.shrui %gword, %gsh : i32
      %g_byte = scalar.andi %gb0, %c255i : i32
      %sgo = scalar.addi %blk_off, %c34i : i32
      %sg4 = scalar.shli %group, %c2i : i32
      %sg1 = scalar.addi %sgo, %sg4 : i32
      %sg_i = scalar.addi %sg1, %l : i32
      %sg_ix = index.cast %sg_i : i32 to index
      %sg_lo = index.max %sg_ix, %c0 : index
      %sg_idx = index.min %sg_lo, %wlast : index
      %sg8 = view.load %wv[%sg_idx] : view<[%wn]xi8> -> i8
      %sgb = scalar.extui %sg8 : i8 to i32
      %sbit0 = scalar.shrui %sgb, %j8 : i32
      %sign_bit = scalar.andi %sbit0, %c1i : i32
      %is_neg = scalar.cmpi eq, %sign_bit, %c1i : i32
