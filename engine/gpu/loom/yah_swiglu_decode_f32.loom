                        scf.yield %r_g : f32
                      } else {
                        %r_g = func.call @iq2s_step(%w_bytes, %w_halfs, %x_elems, %gw, %gwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
                        scf.yield %r_g : f32
                      }
                      scf.yield %dn_g : f32
                    }
                    scf.yield %dn_g : f32
                  }
                  scf.yield %dn_g : f32
                }
                scf.yield %dn_g : f32
              }
              scf.yield %dn_g : f32
            }
            scf.yield %dn_g : f32
          }
          scf.yield %dn_g : f32
        }
        scf.yield %dn_g : f32
      }
      %d_u = scf.if %u_is_q4k -> (f32) {
        %r_u = func.call @q4k_step(%w_bytes, %w_halfs, %x_elems, %uw, %uwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
        scf.yield %r_u : f32
      } else {
        %dn_u = scf.if %u_is_iq4xs -> (f32) {
          %r_u = func.call @iq4xs_step(%w_bytes, %w_halfs, %x_elems, %uw, %uwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
          scf.yield %r_u : f32
        } else {
          %dn_u = scf.if %u_is_iq4nl -> (f32) {
            %r_u = func.call @iq4nl_step(%w_bytes, %w_halfs, %x_elems, %uw, %uwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
            scf.yield %r_u : f32
          } else {
            %dn_u = scf.if %u_is_q5k -> (f32) {
              %r_u = func.call @q5k_step(%w_bytes, %w_halfs, %x_elems, %uw, %uwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
              scf.yield %r_u : f32
            } else {
              %dn_u = scf.if %u_is_q6k -> (f32) {
                %r_u = func.call @q6k_step(%w_bytes, %w_halfs, %x_elems, %uw, %uwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
                scf.yield %r_u : f32
              } else {
                %dn_u = scf.if %u_is_q3k -> (f32) {
                  %r_u = func.call @q3k_step(%w_bytes, %w_halfs, %x_elems, %uw, %uwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
                  scf.yield %r_u : f32
                } else {
                  %dn_u = scf.if %u_is_iq3s -> (f32) {
                    %r_u = func.call @iq3s_step(%w_bytes, %w_halfs, %x_elems, %uw, %uwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
                    scf.yield %r_u : f32
                  } else {
                    %dn_u = scf.if %u_is_iq3xxs -> (f32) {
                      %r_u = func.call @iq3xxs_step(%w_bytes, %w_halfs, %x_elems, %uw, %uwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
                      scf.yield %r_u : f32
                    } else {
                      %dn_u = scf.if %u_is_iq2xs -> (f32) {
                        %r_u = func.call @iq2xs_step(%w_bytes, %w_halfs, %x_elems, %uw, %uwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
                        scf.yield %r_u : f32
                      } else {
                        %r_u = func.call @iq2s_step(%w_bytes, %w_halfs, %x_elems, %uw, %uwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
                        scf.yield %r_u : f32
                      }
                      scf.yield %dn_u : f32
                    }
                    scf.yield %dn_u : f32
                  }
                  scf.yield %dn_u : f32
                }
                scf.yield %dn_u : f32
              }
              scf.yield %dn_u : f32
            }
            scf.yield %dn_u : f32
          }
          scf.yield %dn_u : f32
        }
        scf.yield %dn_u : f32
      }
      %ng = scalar.addf %g0, %d_g : f32
      %nu = scalar.addf %u0, %d_u : f32
      scf.yield %ng, %nu : f32, f32
    }
    scf.yield %a1g, %a1u : f32, f32
  }
  %sumg = kernel.subgroup.reduce<addf> %accg : f32
  %sumu = kernel.subgroup.reduce<addf> %accu : f32
  %negg = scalar.mulf %sumg, %negone : f32
  %eg = scalar.expf<afn> %negg : f32
  %dg = scalar.addf %one, %eg : f32
  %sg = scalar.divf %one, %dg : f32
  %act = scalar.mulf %sumg, %sg : f32
  %res = scalar.mulf %act, %sumu : f32
  %is_zero = index.cmp eq, %lane, %c0 : index
  %st = scf.if %is_zero -> (f32) {
    view.store %res, %ov[%m] : f32, view<[%m_rows]xf32>
    scf.yield %zero : f32
  } else {
    scf.yield %zero : f32
  }
  kernel.return
}

// Small cases: 16 rows, hidden 5120.
// gate=q4k up=iq4xs; both chains share x.
check.case public @yah_swiglu_decode_case_a {
  %gate_w = check.file.read.npy path("fixtures/swiglu_decode/q4k_pad.npy") : tensor<67200xi8>
  %up_w = check.file.read.npy path("fixtures/swiglu_decode/iq4xs_pad.npy") : tensor<67200xi8>
  %grid_s = check.file.read.npy path("fixtures/iq3s_gemm/grid.npy") : tensor<512xi32>
  %grid_x = check.file.read.npy path("fixtures/iq3xxs_gemm/grid.npy") : tensor<256xi32>
  %grid_q = check.file.read.npy path("fixtures/iq2xs_gemm/grid32.npy") : tensor<1024xi32>
  %grid_p = check.file.read.npy path("fixtures/iq2s_gemm/grid32.npy") : tensor<2048xi32>
  %ksigns = check.file.read.npy path("fixtures/iq3xxs_gemm/ksigns.npy") : tensor<128xi8>
  %x = check.file.read.npy path("fixtures/swiglu_decode/x.npy") : tensor<5120xf32>
  %out = check.generate.fill value(0.0) : tensor<16xf32>
  %expected = check.file.read.npy path("fixtures/swiglu_decode/q4k_iq4xs_expected.npy") : tensor<16xf32>
  %tg = check.literal value(1) : i32
  %tu = check.literal value(2) : i32
  kernel.launch @yah_swiglu_decode(%gate_w, %up_w, %grid_s, %grid_x, %grid_q, %grid_p, %ksigns, %x, %out, %tg, %tu) : (tensor<67200xi8>, tensor<67200xi8>, tensor<512xi32>, tensor<256xi32>, tensor<1024xi32>, tensor<2048xi32>, tensor<128xi8>, tensor<5120xf32>, tensor<16xf32>, i32, i32)
  check.expect.close actual(%out) expected(%expected) atol(0.001) rtol(1.0000000000000001e-05) nan(same) : tensor<16xf32>
  check.return
}

