      %ab1 = view.load %wv[%aux1_idx] : view<[%wn]xi8> -> i8
      %ab2 = view.load %wv[%aux2_idx] : view<[%wn]xi8> -> i8
      %ab3 = view.load %wv[%aux3_idx] : view<[%wn]xi8> -> i8
