  %fquarter = scalar.constant 0.25 : f32
  %wlast = index.sub %wn, %c1 : index
  %whlast = index.sub %whn, %c1 : index
  %xlast = index.sub %xn, %c1 : index
  %row_off = scalar.muli %row_i, %c1640i : i32
  %blk_off0 = scalar.muli %kblk_i, %c82i : i32
  %blk_off = scalar.addi %row_off, %blk_off0 : i32
  %kblk256 = scalar.shli %kblk_i, %c8i : i32
      %group = scalar.shrui %i_i, %c5i : i32
      %half0 = scalar.shrui %i_i, %c4i : i32
      %half = scalar.andi %half0, %c1i : i32
      %jj = scalar.andi %i_i, %c15i : i32
      %li = scalar.shrui %jj, %c3i : i32
      %j8 = scalar.andi %jj, %c7i : i32
      %l2 = scalar.shli %half, %c1i : i32
      %l = scalar.addi %l2, %li : i32
      %qsw = scalar.shli %group, %c2i : i32
      %qsw2 = scalar.addi %qsw, %l : i32
      %qs0 = scalar.addi %blk_off, %c2i : i32
      %low_i = scalar.addi %qs0, %qsw2 : i32
      %low_ix = index.cast %low_i : i32 to index
      %low_lo = index.max %low_ix, %c0 : index
      %low_idx = index.min %low_lo, %wlast : index
      %low8 = view.load %wv[%low_idx] : view<[%wn]xi8> -> i8
      %low = scalar.extui %low8 : i8 to i32
      %qho = scalar.addi %blk_off, %c66i : i32
      %qh_i = scalar.addi %qho, %group : i32
      %qh_ix = index.cast %qh_i : i32 to index
      %qh_lo = index.max %qh_ix, %c0 : index
      %qh_idx = index.min %qh_lo, %wlast : index
      %qhb8 = view.load %wv[%qh_idx] : view<[%wn]xi8> -> i8
      %qhb = scalar.extui %qhb8 : i8 to i32
