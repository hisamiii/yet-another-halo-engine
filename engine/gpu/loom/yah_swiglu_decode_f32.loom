      %sco = scalar.addi %blk_off, %c66i : i32
      %sc_i = scalar.addi %sco, %group : i32
      %sc_ix = index.cast %sc_i : i32 to index
      %sc_lo = index.max %sc_ix, %c0 : index
      %sc_idx = index.min %sc_lo, %wlast : index
      %scb8 = view.load %wv[%sc_idx] : view<[%wn]xi8> -> i8
      %scb = scalar.extui %scb8 : i8 to i32
      %is_low = scalar.cmpi eq, %half, %c0i : i32
      %nib = scf.if %is_low -> (i32) {
        %ni_lo = scalar.andi %scb, %c15i : i32
        scf.yield %ni_lo : i32
      } else {
        %ni_hi = scalar.shrui %scb, %c4i : i32
        scf.yield %ni_hi : i32
      }
      %nib_f = scalar.sitofp %nib : i32 to f32
      %hp = scalar.addf %nib_f, %fhalf : f32
      %hp2 = scalar.mulf %hp, %fquarter : f32
      %mag_f = scalar.sitofp %mag : i32 to f32
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %whlast : index
      %d_half_v = view.load %wh[%d_idx] : view<[%whn]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %scale_f = scalar.mulf %d, %hp2 : f32
      %value = scalar.mulf %scale_f, %mag_f : f32
