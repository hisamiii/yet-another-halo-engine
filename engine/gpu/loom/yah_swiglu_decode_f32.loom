        scf.yield %g_byte : i32
      }
      %sco = scalar.addi %blk_off, %c106i : i32
      %gdiv2 = scalar.shrui %group, %c1i : i32
      %sc_i = scalar.addi %sco, %gdiv2 : i32
      %sc_ix = index.cast %sc_i : i32 to index
      %sc_lo = index.max %sc_ix, %c0 : index
      %sc_idx = index.min %sc_lo, %wlast : index
      %scb8 = view.load %wv[%sc_idx] : view<[%wn]xi8> -> i8
      %scb = scalar.extui %scb8 : i8 to i32
      %odd = scalar.andi %group, %c1i : i32
      %is_even = scalar.cmpi eq, %odd, %c0i : i32
      %nib = scf.if %is_even -> (i32) {
        %ni_lo = scalar.andi %scb, %c15i : i32
        scf.yield %ni_lo : i32
      } else {
        %ni_hi = scalar.shrui %scb, %c4i : i32
        scf.yield %ni_hi : i32
      }
      %nib2 = scalar.shli %nib, %c1i : i32
      %one_plus = scalar.addi %nib2, %c1i : i32
      %scale_f = scalar.sitofp %one_plus : i32 to f32
      %mag_f = scalar.sitofp %mag : i32 to f32
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %whlast : index
      %d_half_v = view.load %wh[%d_idx] : view<[%whn]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dsc = scalar.mulf %d, %scale_f : f32
      %value = scalar.mulf %dsc, %mag_f : f32
      %kidx_i = scalar.addi %kblk256, %i_i : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %xlast : index
      %xv = view.load %xs[%kidx] : view<[%xn]xf32> -> f32
      %prod = scalar.mulf %value, %xv : f32
  func.return %prod : f32
}

