  %kidx_ix = index.cast %kidx_i : i32 to index
  %kidx_lo = index.max %kidx_ix, %c0 : index
  %kidx = index.min %kidx_lo, %xlast : index
  %xv_v = view.load %xs[%kidx] : view<[%xn]xf32> -> f32
  %prod = scalar.mulf %value, %xv_v : f32
  func.return %prod : f32
}

func.def @iq2s_step(%wn: index, %whn: index, %xn: index, %wv: view<[%wn]xi8>, %wh: view<[%whn]xf16>, %xs: view<[%xn]xf32>, %gs: view<512xi32>, %gx: view<256xi32>, %gq: view<1024xi32>, %gp: view<2048xi32>, %ksv: view<128xi8>, %row_i: i32, %kblk_i: i32, %i_i: i32) -> (f32) {
