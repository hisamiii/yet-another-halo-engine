                      %r_g = func.call @iq3xxs_step(%w_bytes, %w_halfs, %x_elems, %gw, %gwh, %xs, %gs, %gx, %gq, %gp, %ks, %row_i, %kblk_i, %i_i) : (index, index, index, view<[%w_bytes]xi8>, view<[%w_halfs]xf16>, view<[%x_elems]xf32>, view<512xi32>, view<256xi32>, view<1024xi32>, view<2048xi32>, view<128xi8>, i32, i32, i32) -> (f32)
