  %g_is_iq3s = scalar.cmpi eq, %gate_type, %id_iq3s : i32
  %g_is_iq3xxs = scalar.cmpi eq, %gate_type, %id_iq3xxs : i32
  %g_is_iq2xs = scalar.cmpi eq, %gate_type, %id_iq2xs : i32
  %g_is_iq2s = scalar.cmpi eq, %gate_type, %id_iq2s : i32
  %u_is_q4k = scalar.cmpi eq, %up_type, %id_q4k : i32
  %u_is_iq4xs = scalar.cmpi eq, %up_type, %id_iq4xs : i32
  %u_is_iq4nl = scalar.cmpi eq, %up_type, %id_iq4nl : i32
