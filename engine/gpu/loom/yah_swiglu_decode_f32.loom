  %id_q6k = scalar.constant 5 : i32
  %id_q3k = scalar.constant 6 : i32
  %id_iq3s = scalar.constant 7 : i32
  %id_iq3xxs = scalar.constant 8 : i32
  %id_iq2xs = scalar.constant 9 : i32
  %id_iq2s = scalar.constant 10 : i32
