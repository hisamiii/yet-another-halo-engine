// YAH batched fused QK RMSNorm + RoPE + KV write (prefill), Loom port of
// BatchedFusedQKNormRoPEKvWriteKernel (text/mRoPE-null path).
//
// HIP source: models/qwen/hip/kernels/prefill_rope.hip. Grid (heads, batch): block
// b handles token b, blocks [0, num_heads) rotate Q in place, blocks
// [num_heads, num_heads+num_kv_heads) rotate K and write both KV caches. The Q/K
// operands are token-major, so each head base is offset by b times the token width.
// The math is the decode port (`yah_fused_qk_rope_f32.loom`); only the row base and
// `cur_pos = start_pos + b` differ.
//
// Required config: --config=yah_fused_qk_rope_batched.start_pos=0 --config=yah_fused_qk_rope_batched.batch=1
//                  --config=yah_fused_qk_rope_batched.layer_idx=0 --config=yah_fused_qk_rope_batched.max_context=1
//                  --config=yah_fused_qk_rope_batched.num_heads=1 --config=yah_fused_qk_rope_batched.num_kv_heads=1
//                  --config=yah_fused_qk_rope_batched.head_dim=8 --config=yah_fused_qk_rope_batched.rotary_dim=8
//                  --config=yah_fused_qk_rope_batched.q_elems=8 --config=yah_fused_qk_rope_batched.kv_elems=8
//                  --config=yah_fused_qk_rope_batched.cache32_elems=8 --config=yah_fused_qk_rope_batched.cache16_elems=8
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_fused_qk_rope_batched.start_pos : %value: index where [range(%value, 0, 1073741824)]

config.decl @yah_fused_qk_rope_batched.batch : %value: index where [range(%value, 1, 65536)]

config.decl @yah_fused_qk_rope_batched.layer_idx : %value: index where [range(%value, 0, 65536)]

config.decl @yah_fused_qk_rope_batched.max_context : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_fused_qk_rope_batched.num_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_fused_qk_rope_batched.num_kv_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_fused_qk_rope_batched.head_dim : %value: index where [range(%value, 8, 65536)]

config.decl @yah_fused_qk_rope_batched.rotary_dim : %value: index where [range(%value, 2, 65536)]

config.decl @yah_fused_qk_rope_batched.q_elems : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_fused_qk_rope_batched.kv_elems : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_fused_qk_rope_batched.cache32_elems : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_fused_qk_rope_batched.cache16_elems : %value: index where [range(%value, 1, 1073741824)]

config.def @yah_fused_qk_rope_batched.theta = 10000000.0 : f32
// cache_start: first position held by the f16 cache (row cur - cache_start).
// 0 (default) = the whole context; chunked prefill with a quantized KV cache
// sets it to the chunk start, so the f16 cache is a one-chunk scratch.
config.def @yah_fused_qk_rope_batched.cache_start = 0 : index

kernel.def target(@yah_wave32) @yah_fused_qk_rope_batched() {
  %unit = index.constant 1 : index
  %num_heads = config.get @yah_fused_qk_rope_batched.num_heads : index
  %num_kv_heads = config.get @yah_fused_qk_rope_batched.num_kv_heads : index
  %batch = config.get @yah_fused_qk_rope_batched.batch : index
  %c256 = index.constant 256 : index
  %blocks = index.add %num_heads, %num_kv_heads : index
  kernel.launch.config workgroups(%blocks, %batch, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%q: buffer, %k: buffer, %v: buffer, %q_weight: buffer, %k_weight: buffer, %q_out: buffer, %k_out: buffer, %k_cache: buffer, %v_cache: buffer, %k_cache_f16: buffer, %v_cache_f16: buffer, %eps_buf: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %two = scalar.constant 2.0 : f32
  %one = scalar.constant 1.0 : f32
  %zero = scalar.constant 0.0 : f32
  %start_pos = config.get @yah_fused_qk_rope_batched.start_pos : index
  %layer_idx = config.get @yah_fused_qk_rope_batched.layer_idx : index
  %max_context = config.get @yah_fused_qk_rope_batched.max_context : index
  %cache_start = config.get @yah_fused_qk_rope_batched.cache_start : index
  %num_heads = config.get @yah_fused_qk_rope_batched.num_heads : index
  %num_kv_heads = config.get @yah_fused_qk_rope_batched.num_kv_heads : index
  %head_dim = config.get @yah_fused_qk_rope_batched.head_dim : index
  %rotary_dim = config.get @yah_fused_qk_rope_batched.rotary_dim : index
  %q_elems = config.get @yah_fused_qk_rope_batched.q_elems : index
  %kv_elems = config.get @yah_fused_qk_rope_batched.kv_elems : index
  %cache32_elems = config.get @yah_fused_qk_rope_batched.cache32_elems : index
  %cache16_elems = config.get @yah_fused_qk_rope_batched.cache16_elems : index
  %theta = config.get @yah_fused_qk_rope_batched.theta : f32
  %head_dim_i = index.cast %head_dim : index to i32
  %head_dimf = scalar.sitofp %head_dim_i : i32 to f32
  %rotary_dim_i = index.cast %rotary_dim : index to i32
  %rotary_dimf = scalar.sitofp %rotary_dim_i : i32 to f32
  %c1i = scalar.constant 1 : i32
  %half_rot_i = scalar.shrui %rotary_dim_i, %c1i : i32
  %half_rot = index.cast %half_rot_i : i32 to index
  %num_heads_m1 = index.sub %num_heads, %c1 : index
  %kv_heads_m1 = index.sub %num_kv_heads, %c1 : index
  %kv_width = index.mul %num_kv_heads, %head_dim : index
  %ctx_m1 = index.sub %max_context, %c1 : index
  %q_na, %k_na, %v_na, %qw_na, %kw_na, %qo_na, %ko_na, %kc_na, %vc_na, %k16_na, %v16_na, %eps_na = buffer.assume.noalias %q, %k, %v, %q_weight, %k_weight, %q_out, %k_out, %k_cache, %v_cache, %k_cache_f16, %v_cache_f16, %eps_buf : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %q_view = buffer.view %q_na[%base] : buffer -> view<[%q_elems]xf32>
  %k_view = buffer.view %k_na[%base] : buffer -> view<[%kv_elems]xf32>
  %v_view = buffer.view %v_na[%base] : buffer -> view<[%kv_elems]xf32>
  %qw_view = buffer.view %qw_na[%base] : buffer -> view<[%head_dim]xf32>
  %kw_view = buffer.view %kw_na[%base] : buffer -> view<[%head_dim]xf32>
  %qo_view = buffer.view %qo_na[%base] : buffer -> view<[%q_elems]xf32>
  %ko_view = buffer.view %ko_na[%base] : buffer -> view<[%kv_elems]xf32>
  %kc_view = buffer.view %kc_na[%base] : buffer -> view<[%cache32_elems]xf32>
  %vc_view = buffer.view %vc_na[%base] : buffer -> view<[%cache32_elems]xf32>
  %k16_view = buffer.view %k16_na[%base] : buffer -> view<[%cache16_elems]xf16>
  %v16_view = buffer.view %v16_na[%base] : buffer -> view<[%cache16_elems]xf16>
  %eps_view = buffer.view %eps_na[%base] : buffer -> view<[%c1]xf32>
  %block = kernel.workgroup.id<x> : index
  %bi = kernel.workgroup.id<y> : index
  %tid = kernel.workitem.id<x> : index
  %eps = view.load %eps_view[%c0] : view<[%c1]xf32> -> f32
  %cur_raw = index.add %start_pos, %bi : index
  %cur_nn = index.max %cur_raw, %c0 : index
  %cur = index.min %cur_nn, %ctx_m1 : index
  %cur_i = index.cast %cur : index to i32
  %curf = scalar.sitofp %cur_i : i32 to f32
  %is_q = index.cmp ult, %block, %num_heads : index
  scf.if %is_q {
    %bq = index.min %block, %num_heads_m1 : index
    %qwidth = index.mul %num_heads, %head_dim : index
    %bqw = index.mul %bi, %qwidth : index
    %hbq = index.mul %bq, %head_dim : index
    %hb = index.add %bqw, %hbq : index
    %local_q = scf.for %i = [%tid to %head_dim step %c256](%acc = %zero : f32) -> (f32) {
      %ei = index.add %hb, %i : index
      %xv = view.load %q_view[%ei] : view<[%q_elems]xf32> -> f32
      %sq = scalar.mulf %xv, %xv : f32
      %nq = scalar.addf %acc, %sq : f32
      scf.yield %nq : f32
    }
    %total_q = kernel.workgroup.reduce<addf> %local_q : f32
    %mean_q = scalar.divf %total_q, %head_dimf : f32
    %me_q = scalar.addf %mean_q, %eps : f32
    %inv_q = scalar.rsqrtf %me_q : f32
    %rope_q = scf.for %p = [%tid to %half_rot step %c256](%m1 = %c0 : index) -> (index) {
      %p1 = index.add %p, %half_rot : index
      %i0 = index.add %hb, %p : index
      %i1 = index.add %hb, %p1 : index
      %q0 = view.load %q_view[%i0] : view<[%q_elems]xf32> -> f32
      %q1 = view.load %q_view[%i1] : view<[%q_elems]xf32> -> f32
      %w0 = view.load %qw_view[%p] : view<[%head_dim]xf32> -> f32
      %w1 = view.load %qw_view[%p1] : view<[%head_dim]xf32> -> f32
      %n0 = scalar.mulf %q0, %inv_q : f32
      %n0w = scalar.mulf %n0, %w0 : f32
      %n1 = scalar.mulf %q1, %inv_q : f32
      %n1w = scalar.mulf %n1, %w1 : f32
      %pi = index.cast %p : index to i32
      %pif = scalar.sitofp %pi : i32 to f32
      %twop = scalar.mulf %two, %pif : f32
      %expo = scalar.divf %twop, %rotary_dimf : f32
      %invfreq = scalar.powf<afn> %theta, %expo : f32
      %inv = scalar.divf %one, %invfreq : f32
      %angle = scalar.mulf %curf, %inv : f32
      %cv = scalar.cosf<afn> %angle : f32
      %sv = scalar.sinf<afn> %angle : f32
      %a0 = scalar.mulf %n0w, %cv : f32
      %a1 = scalar.mulf %n1w, %sv : f32
      %r0 = scalar.subf %a0, %a1 : f32
      %b0 = scalar.mulf %n0w, %sv : f32
      %b1 = scalar.mulf %n1w, %cv : f32
      %r1 = scalar.addf %b0, %b1 : f32
      view.store %r0, %qo_view[%i0] : f32, view<[%q_elems]xf32>
      view.store %r1, %qo_view[%i1] : f32, view<[%q_elems]xf32>
      scf.yield %m1 : index
    }
    %tail_start = index.add %rotary_dim, %tid : index
    %tail_q = scf.for %i2 = [%tail_start to %head_dim step %c256](%m2 = %c0 : index) -> (index) {
      %e2 = index.add %hb, %i2 : index
      %x2 = view.load %q_view[%e2] : view<[%q_elems]xf32> -> f32
      %w2 = view.load %qw_view[%i2] : view<[%head_dim]xf32> -> f32
      %n2 = scalar.mulf %x2, %inv_q : f32
      %n2w = scalar.mulf %n2, %w2 : f32
      view.store %n2w, %qo_view[%e2] : f32, view<[%q_elems]xf32>
      scf.yield %m2 : index
    }
  }
  %kv_h_raw = index.sub %block, %num_heads : index
  %is_k = index.cmp ult, %kv_h_raw, %num_kv_heads : index
  scf.if %is_k {
    %kv_h = index.min %kv_h_raw, %kv_heads_m1 : index
    %bkw = index.mul %bi, %kv_width : index
    %hbkq = index.mul %kv_h, %head_dim : index
    %hbk = index.add %bkw, %hbkq : index
    %local_k = scf.for %j = [%tid to %head_dim step %c256](%acc2 = %zero : f32) -> (f32) {
      %ej = index.add %hbk, %j : index
      %xv2 = view.load %k_view[%ej] : view<[%kv_elems]xf32> -> f32
      %sq2 = scalar.mulf %xv2, %xv2 : f32
      %nk = scalar.addf %acc2, %sq2 : f32
      scf.yield %nk : f32
    }
    %total_k = kernel.workgroup.reduce<addf> %local_k : f32
    %mean_k = scalar.divf %total_k, %head_dimf : f32
    %me_k = scalar.addf %mean_k, %eps : f32
    %inv_k = scalar.rsqrtf %me_k : f32
    %lkv = index.mul %layer_idx, %num_kv_heads : index
    %lkvh = index.add %lkv, %kv_h : index
    %lkvhm = index.mul %lkvh, %max_context : index
    %lkvhmp = index.add %lkvhm, %cur : index
    %kv_off_raw = index.mul %lkvhmp, %head_dim : index
    %cache32_max = index.sub %cache32_elems, %head_dim : index
    %kv_off = index.min %kv_off_raw, %cache32_max : index
    %lm = index.mul %layer_idx, %max_context : index
    %cur16 = index.sub %cur, %cache_start : index
    %lmp = index.add %lm, %cur16 : index
    %f16_pre = index.mul %lmp, %kv_width : index
    %f16_off_raw = index.add %f16_pre, %hbkq : index
    %cache16_max = index.sub %cache16_elems, %head_dim : index
    %f16_off = index.min %f16_off_raw, %cache16_max : index
    %rope_k = scf.for %p3 = [%tid to %half_rot step %c256](%m3 = %c0 : index) -> (index) {
      %p3b = index.add %p3, %half_rot : index
      %j0 = index.add %hbk, %p3 : index
      %j1 = index.add %hbk, %p3b : index
      %kk0 = view.load %k_view[%j0] : view<[%kv_elems]xf32> -> f32
      %kk1 = view.load %k_view[%j1] : view<[%kv_elems]xf32> -> f32
      %kw0 = view.load %kw_view[%p3] : view<[%head_dim]xf32> -> f32
      %kw1 = view.load %kw_view[%p3b] : view<[%head_dim]xf32> -> f32
      %kn0 = scalar.mulf %kk0, %inv_k : f32
      %kn0w = scalar.mulf %kn0, %kw0 : f32
      %kn1 = scalar.mulf %kk1, %inv_k : f32
      %kn1w = scalar.mulf %kn1, %kw1 : f32
      %p3i = index.cast %p3 : index to i32
      %p3if = scalar.sitofp %p3i : i32 to f32
      %twop3 = scalar.mulf %two, %p3if : f32
      %expo3 = scalar.divf %twop3, %rotary_dimf : f32
      %invfreq3 = scalar.powf<afn> %theta, %expo3 : f32
      %inv3 = scalar.divf %one, %invfreq3 : f32
      %angle3 = scalar.mulf %curf, %inv3 : f32
      %cv3 = scalar.cosf<afn> %angle3 : f32
      %sv3 = scalar.sinf<afn> %angle3 : f32
      %ka = scalar.mulf %kn0w, %cv3 : f32
      %kb = scalar.mulf %kn1w, %sv3 : f32
      %kr0 = scalar.subf %ka, %kb : f32
      %kc2 = scalar.mulf %kn0w, %sv3 : f32
      %kd = scalar.mulf %kn1w, %cv3 : f32
      %kr1 = scalar.addf %kc2, %kd : f32
      view.store %kr0, %ko_view[%j0] : f32, view<[%kv_elems]xf32>
      view.store %kr1, %ko_view[%j1] : f32, view<[%kv_elems]xf32>
      %kc_off0 = index.add %kv_off, %p3 : index
      %kc_off1 = index.add %kv_off, %p3b : index
      view.store %kr0, %kc_view[%kc_off0] : f32, view<[%cache32_elems]xf32>
      view.store %kr1, %kc_view[%kc_off1] : f32, view<[%cache32_elems]xf32>
      %k16_off0 = index.add %f16_off, %p3 : index
      %k16_off1 = index.add %f16_off, %p3b : index
      %kr0h = scalar.fptrunc %kr0 : f32 to f16
      %kr1h = scalar.fptrunc %kr1 : f32 to f16
      view.store %kr0h, %k16_view[%k16_off0] : f16, view<[%cache16_elems]xf16>
      view.store %kr1h, %k16_view[%k16_off1] : f16, view<[%cache16_elems]xf16>
      scf.yield %m3 : index
    }
    %tail_start_k = index.add %rotary_dim, %tid : index
    %tail_k = scf.for %i3 = [%tail_start_k to %head_dim step %c256](%m4 = %c0 : index) -> (index) {
      %e3 = index.add %hbk, %i3 : index
      %x3 = view.load %k_view[%e3] : view<[%kv_elems]xf32> -> f32
      %w3 = view.load %kw_view[%i3] : view<[%head_dim]xf32> -> f32
      %n3 = scalar.mulf %x3, %inv_k : f32
      %n3w = scalar.mulf %n3, %w3 : f32
      view.store %n3w, %ko_view[%e3] : f32, view<[%kv_elems]xf32>
      %kc_off3 = index.add %kv_off, %i3 : index
      view.store %n3w, %kc_view[%kc_off3] : f32, view<[%cache32_elems]xf32>
      %k16_off3 = index.add %f16_off, %i3 : index
      %n3h = scalar.fptrunc %n3w : f32 to f16
      view.store %n3h, %k16_view[%k16_off3] : f16, view<[%cache16_elems]xf16>
      scf.yield %m4 : index
    }
    %v_loop = scf.for %i4 = [%tid to %head_dim step %c256](%m5 = %c0 : index) -> (index) {
      %e4 = index.add %hbk, %i4 : index
      %vv = view.load %v_view[%e4] : view<[%kv_elems]xf32> -> f32
      %vc_off = index.add %kv_off, %i4 : index
      view.store %vv, %vc_view[%vc_off] : f32, view<[%cache32_elems]xf32>
      %v16_off = index.add %f16_off, %i4 : index
      %vvh = scalar.fptrunc %vv : f32 to f16
      view.store %vvh, %v16_view[%v16_off] : f16, view<[%cache16_elems]xf16>
      scf.yield %m5 : index
    }
  }
  kernel.return
}

// Requires the config above (batch 1, max_context 1). q = k = v = weights = 1,
// eps = 0, start_pos = 0: inv_rms = 1, the rotation is the identity, and every
// output is 1.
check.case public @yah_fused_qk_rope_batched_case {
  %q = check.generate.fill value(1.0) : tensor<8xf32>
  %k = check.generate.fill value(1.0) : tensor<8xf32>
  %v = check.generate.fill value(1.0) : tensor<8xf32>
  %qw = check.generate.fill value(1.0) : tensor<8xf32>
  %kw = check.generate.fill value(1.0) : tensor<8xf32>
  %q_out = check.generate.fill value(0.0) : tensor<8xf32>
  %k_out = check.generate.fill value(0.0) : tensor<8xf32>
  %k_cache = check.generate.fill value(0.0) : tensor<8xf32>
  %v_cache = check.generate.fill value(0.0) : tensor<8xf32>
  %k16 = check.generate.fill value(0.0) : tensor<8xf16>
  %v16 = check.generate.fill value(0.0) : tensor<8xf16>
  %eps = check.generate.fill value(0.0) : tensor<1xf32>
  %e8 = check.generate.fill value(1.0) : tensor<8xf32>
  %e16 = check.generate.fill value(1.0) : tensor<8xf16>
  kernel.launch @yah_fused_qk_rope_batched(%q, %k, %v, %qw, %kw, %q_out, %k_out, %k_cache, %v_cache, %k16, %v16, %eps) : (tensor<8xf32>, tensor<8xf32>, tensor<8xf32>, tensor<8xf32>, tensor<8xf32>, tensor<8xf32>, tensor<8xf32>, tensor<8xf32>, tensor<8xf32>, tensor<8xf16>, tensor<8xf16>, tensor<1xf32>)
  check.expect.close actual(%q_out) expected(%e8) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.expect.close actual(%k_out) expected(%e8) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.expect.close actual(%k_cache) expected(%e8) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.expect.close actual(%v_cache) expected(%e8) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.expect.close actual(%k16) expected(%e16) atol(0.0) rtol(0.0) nan(same) : tensor<8xf16>
  check.expect.close actual(%v16) expected(%e16) atol(0.0) rtol(0.0) nan(same) : tensor<8xf16>
  check.return
}

check.benchmark<@yah_fused_qk_rope_batched_case> @yah_fused_qk_rope_batched_bench
