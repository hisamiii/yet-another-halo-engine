// YAH FFN GEMM with in-kernel IQ2_XS weight decode, Loom port of
// HalfPrefillGemmKernel<..., kIQ2_XS, kStore>.
//
// HIP source: prefill_fp16.hip, element decoder DecodeQuantSub16 IQ2_XS arm in
// quant_ops.hpp. The weight stays packed IQ2_XS and is decoded inside the K loop.
//
//   out[token*m + row] = sum_k iq2xs_decode(W, row, k) * f16(A[token][k])
//
// block_iq2_xs is 74 bytes: half d; uint16 qs[32]; uint8 scales[8]. Element i is
//   sub16 = i/16; ib32 = (sub16/2)%8; half = sub16%2
//   li = (i%16)/8; j = i%8; l = 2*half + li
//   code = qs[4*ib32 + l]
//   g_word = iq2xs_grid[code & 511]; g_byte = (g_word >> (8*j)) & 0xFF
//   signs = ksigns[code >> 9]; sign_bit = (signs >> j) & 1
//   mag = sign_bit ? -g_byte : g_byte
//   nib = half == 0 ? scales[ib32] & 0xF : scales[ib32] >> 4
//   value = f32(d) * (0.5 + nib) * 0.25 * mag
//
// As in the IQ2_XS port the 512-entry grid and the 128-byte ksigns table are
// operands. The grid is 64-bit in HIP; here it is passed as the little-endian
// i32 word pairs, so element j reads word (j/4) of the pair. The uint16 code is
// two byte loads at 2 + 2*(4*ib32 + l) because the 74-byte block stride is not
// 2-aligned in the general row.
//
// BLOCK ORDER: block_iq2_xs stores d first (offset 0); qs starts at 2 and scales
// at 66. QK = 256, so the row stride is 20 blocks * 74 = 1480 bytes.
//
// Schedule, correctness first and tuning deferred: one workgroup per 16-row
// tile, one wave. For each K step of 16 the 32 lanes decode the 16x16 weight
// tile into the wstage global scratch, vector.fragment.load<lhs> reads it back,
// four 16x16x16 MMAs cover the four N sub-tiles, and the accumulators go through
// an ostage global scratch to the output with scalar stores so the output index
// can follow the m_tiles config. Both fragment operands are staged through
// global memory rather than LDS: a fragment load or store against a
// buffer.alloca<workgroup> view compiles but does not produce the tile the
// target reads, and the global form is the one yah_ffn_gemm_f16 validates.
//
// Measured: 19.85 ms at m_tiles=1088 (production 17408 rows), against the HIP
// Q4_K kernel at 1.197 ms and the Q4_K port at 23.31 ms. 0.841 ms at m_tiles=1.
// The deferred levers are the same as the other format ports, plus the grid and
// ksigns loads.
//
// Two cases, because the correctness shape and the production shape need
// different configs:
//   @yah_ffn_gemm_iq2xxs_case       m_tiles=1    packed fixture, captured reference
//   @yah_ffn_gemm_iq2xxs_full_case  m_tiles=1088 all-zero weight, output must be 0
// The all-zero weight is a valid IQ2_XS block (d = 0) and exercises the full
// decode path at production size; the fixture case pins the decode arithmetic.
//
// Required config (correctness): --config=yah_ffn_gemm_iq2xxs.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_iq2xxs.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_iq2xxs.m_tiles : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_iq2xxs.k_blocks : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_iq2xxs.token_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_iq2xxs() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_iq2xxs.m_tiles : index
  %token_tiles = config.get @yah_ffn_gemm_iq2xxs.token_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %token_tiles, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %grid: buffer, %ksigns: buffer, %input: buffer, %wstage: buffer, %ostage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lds_bytes = index.constant 512 : offset
  %wstage_lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %wstage_lds_view = buffer.view %wstage_lds[%base] : buffer -> view<16x16xf16>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c511 = index.constant 511 : index
  %c1023 = index.constant 1023 : index
  %c255 = index.constant 255 : index
  %c127 = index.constant 127 : index
  %c5120 = index.constant 5120 : index
  %c11840 = index.constant 11840 : index
  %c23680 = index.constant 23680 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c63i = scalar.constant 63 : i32
  %c7i = scalar.constant 7 : i32
  %c8i = scalar.constant 8 : i32
  %c9i = scalar.constant 9 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c66i = scalar.constant 66 : i32
  %c74i = scalar.constant 66 : i32
  %c127i = scalar.constant 127 : i32
  %c255i = scalar.constant 255 : i32
  %c511i = scalar.constant 511 : i32
  %c1480i = scalar.constant 1480 : i32
  %fhalf = scalar.constant 0.5 : f32
  %fquarter = scalar.constant 0.25 : f32
  %m_tiles = config.get @yah_ffn_gemm_iq2xxs.m_tiles : index
  %k_blocks = config.get @yah_ffn_gemm_iq2xxs.k_blocks : index
  %token_tiles = config.get @yah_ffn_gemm_iq2xxs.token_tiles : index
  %cbb = index.constant 66 : index
  %cbb2 = index.constant 33 : index
  %ktot = index.mul %k_blocks, %c256 : index
  %tokens = index.mul %token_tiles, %c64 : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %bpr = index.mul %k_blocks, %cbb : index
  %hpr = index.mul %k_blocks, %cbb2 : index
  %w_bytes = index.mul %m_rows, %bpr : index
  %w_halfs = index.mul %m_rows, %hpr : index
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %out_total = index.mul %m_rows, %tokens : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [%c1, %ktot] : encoding<layout>
  %weight_na, %grid_na, %ksigns_na, %input_na, %wstage_na, %ostage_na, %output_na = buffer.assume.noalias %weight, %grid, %ksigns, %input, %wstage, %ostage, %output : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %wg_y = kernel.workgroup.id<y> : index
  %token_base = index.mul %wg_y, %c64 : index
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<[%ktot]x[%tokens]xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf32>
  %grid_view = buffer.view %grid_na[%base] : buffer -> view<512xi32>
  %ksigns_view = buffer.view %ksigns_na[%base] : buffer -> view<128xi8>
  %ostage_view = buffer.view %ostage_na[%base] : buffer -> view<[%stage_rows]x[%tokens]xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %k_blocks_i = index.cast %k_blocks : index to i32
  %bpr_i = scalar.muli %k_blocks_i, %c74i : i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc0, %acc1, %acc2, %acc3 = scf.for %kk = [%c0 to %ktot step %c16](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32
    %c_i = scalar.andi %lane_i, %c15i : i32
    %i_i = scalar.addi %kbase, %c_i : i32
    %blk_off0 = scalar.muli %kblk, %c74i : i32
    %group = scalar.shrui %i_i, %c5i : i32
    %k28i = scalar.constant 28 : i32
    %k31i = scalar.constant 31 : i32
    %k24i = scalar.constant 24 : i32
    %k511x = index.constant 511 : index
    %kquarter = scalar.constant 0.25 : f32
    %g8 = scalar.shli %group, %c3i : i32
    %i31 = scalar.andi %i_i, %k31i : i32
    %li = scalar.shrui %i31, %c3i : i32
    %j8 = scalar.andi %i_i, %c7i : i32
    %wsel = scalar.shrui %j8, %c2i : i32
    %j4 = scalar.andi %j8, %c3i : i32
    %gsh = scalar.shli %j4, %c3i : i32
    %sh7 = scalar.muli %li, %c7i : i32
    %c_ix = index.cast %c_i : i32 to index
    %c_idx = index.max %c_ix, %c0 : index
    %j_sink = scf.for %j = [%c0 to %c8 step %c1](%mk = %c0 : index) -> (index) unroll(%c2) schedule(interleaved) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %e_i = scalar.addi %lane_i, %j32 : i32
      %r_i = scalar.shrui %e_i, %c4i : i32
      %row_i = scalar.addi %m_origin_i, %r_i : i32
      %row_off = scalar.muli %row_i, %bpr_i : i32
      %blk_off = scalar.addi %row_off, %blk_off0 : i32
      %gbase = scalar.addi %blk_off, %c2i : i32
      %qsb = scalar.addi %gbase, %g8 : i32
      %code_i = scalar.addi %qsb, %li : i32
      %code_ix = index.cast %code_i : i32 to index
      %code_lo = index.max %code_ix, %c0 : index
      %code_idx = index.min %code_lo, %w_last : index
      %code_b = view.load %w_view[%code_idx] : view<[%w_bytes]xi8> -> i8
      %code = scalar.extui %code_b : i8 to i32
      %h4 = scalar.addi %qsb, %c4i : i32
      %h4_ix = index.cast %h4 : i32 to index
      %h4_lo = index.max %h4_ix, %c0 : index
      %h4_idx = index.min %h4_lo, %w_last : index
      %h4_b = view.load %w_view[%h4_idx] : view<[%w_bytes]xi8> -> i8
      %h4v = scalar.extui %h4_b : i8 to i32
      %h5 = scalar.addi %qsb, %c5i : i32
      %h5_ix = index.cast %h5 : i32 to index
      %h5_lo = index.max %h5_ix, %c0 : index
      %h5_idx = index.min %h5_lo, %w_last : index
      %h5_b = view.load %w_view[%h5_idx] : view<[%w_bytes]xi8> -> i8
      %h5v = scalar.extui %h5_b : i8 to i32
      %h6 = scalar.addi %qsb, %c6i : i32
      %h6_ix = index.cast %h6 : i32 to index
      %h6_lo = index.max %h6_ix, %c0 : index
      %h6_idx = index.min %h6_lo, %w_last : index
      %h6_b = view.load %w_view[%h6_idx] : view<[%w_bytes]xi8> -> i8
      %h6v = scalar.extui %h6_b : i8 to i32
      %h7 = scalar.addi %qsb, %c7i : i32
      %h7_ix = index.cast %h7 : i32 to index
      %h7_lo = index.max %h7_ix, %c0 : index
      %h7_idx = index.min %h7_lo, %w_last : index
      %h7_b = view.load %w_view[%h7_idx] : view<[%w_bytes]xi8> -> i8
      %h7v = scalar.extui %h7_b : i8 to i32
      %h5s = scalar.shli %h5v, %c8i : i32
      %h6s = scalar.shli %h6v, %c16i : i32
      %h7s = scalar.shli %h7v, %k24i : i32
      %hi0 = scalar.ori %h4v, %h5s : i32
      %hi1 = scalar.ori %hi0, %h6s : i32
      %high = scalar.ori %hi1, %h7s : i32
      %scn = scalar.shrui %high, %k28i : i32
      %scnf = scalar.sitofp %scn : i32 to f32
      %hp = scalar.addf %scnf, %fhalf : f32
      %hp2 = scalar.mulf %hp, %kquarter : f32
      %w0 = scalar.shli %code, %c1i : i32
      %w1 = scalar.addi %w0, %wsel : i32
      %w_ix = index.cast %w1 : i32 to index
      %w_lo = index.max %w_ix, %c0 : index
      %w_idx = index.min %w_lo, %k511x : index
      %gword = view.load %grid_view[%w_idx] : view<512xi32> -> i32
      %gb0 = scalar.shrui %gword, %gsh : i32
      %g_byte = scalar.andi %gb0, %c255i : i32
      %sid0 = scalar.shrui %high, %sh7 : i32
      %sid1 = scalar.andi %sid0, %c127i : i32
      %sid_ix = index.cast %sid1 : i32 to index
      %ks = view.load %ksigns_view[%sid_ix] : view<128xi8> -> i8
      %signs = scalar.extui %ks : i8 to i32
      %sbit0 = scalar.shrui %signs, %j8 : i32
      %sign_bit = scalar.andi %sbit0, %c1i : i32
      %is_neg = scalar.cmpi eq, %sign_bit, %c1i : i32
      %neg_g = scalar.subi %c0i, %g_byte : i32
      // conditional negate without a branch: (x ^ -s) + s
      %neg_one = scalar.subi %c0i, %sign_bit : i32
      %mag0 = scalar.xori %g_byte, %neg_one : i32
      %mag = scalar.addi %mag0, %sign_bit : i32
      %mag_f = scalar.sitofp %mag : i32 to f32
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %scale_f = scalar.mulf %d, %hp2 : f32
      %value = scalar.mulf %scale_f, %mag_f : f32
      %h = scalar.fptrunc %value : f32 to f16
      %row_local = index.cast %r_i : i32 to index
      view.store %h, %wstage_lds_view[%row_local, %c_idx] : f16, view<16x16xf16>
      scf.yield %mk : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhs = vector.fragment.load<lhs> %wstage_lds_view[%c0, %c0] shape [%m, %k] : view<16x16xf16> -> vector<16xf16>
    %t16 = index.add %token_base, %c16 : index
    %t32 = index.add %token_base, %c32 : index
    %t48 = index.add %token_base, %c48 : index
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %token_base] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %t16] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %t32] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %t48] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %n0 = vector.mma %lhs, %rhs0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n1 = vector.mma %lhs, %rhs1, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n2 = vector.mma %lhs, %rhs2, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n3 = vector.mma %lhs, %rhs3, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %n0, %n1, %n2, %n3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %o16 = index.add %token_base, %c16 : index
  %o32 = index.add %token_base, %c32 : index
  %o48 = index.add %token_base, %c48 : index
  vector.fragment.store<result> %acc0, %ostage_view[%m_origin, %token_base] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc1, %ostage_view[%m_origin, %o16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc2, %ostage_view[%m_origin, %o32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  vector.fragment.store<result> %acc3, %ostage_view[%m_origin, %o48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x[%tokens]xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %tok_g = index.add %token_base, %tok : index
    %val = view.load %ostage_view[%gr2, %tok_g] : view<[%stage_rows]x[%tokens]xf32> -> f32
    %tok_off = index.mul %tok_g, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    view.store %val, %out_view[%gflat] : f32, view<[%out_total]xf32>
    scf.yield %mk2 : index
  }
  kernel.return
}

// Requires --config=yah_ffn_gemm_iq2xxs.m_tiles=1.
check.case public @yah_ffn_gemm_iq2xxs_case {
  %weight = check.file.read.npy path("fixtures/iq2xxs_gemm/input_iq2xxs_gemm.npy") : tensor<21120xi8>
  %grid = check.file.read.npy path("fixtures/iq2xxs_gemm/grid32.npy") : tensor<512xi32>
  %ksigns = check.file.read.npy path("fixtures/iq2xxs_gemm/ksigns.npy") : tensor<128xi8>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1024xf32>
  %expected = check.file.read.npy path("fixtures/iq2xxs_gemm/expected_out.npy") : tensor<1024xf32>
  %wstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1024xf32>
  kernel.launch @yah_ffn_gemm_iq2xxs(%weight, %grid, %ksigns, %input, %wstage, %ostage, %output) : (tensor<21120xi8>, tensor<512xi32>, tensor<128xi8>, tensor<64x5120xf16>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf32>)
  check.expect.close actual(%output) expected(%expected) atol(1e-5) rtol(1e-5) nan(same) : tensor<1024xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_iq2xxs_case> @yah_ffn_gemm_iq2xxs_bench

// Requires --config=yah_ffn_gemm_iq2xxs.m_tiles=1088. An all-zero IQ2_XS weight
// decodes to zero (d = 0), so every output must be exactly 0.
check.case public @yah_ffn_gemm_iq2xxs_full_case {
  %weight = check.generate.fill value(0) : tensor<22978560xi8>
  %grid = check.generate.fill value(0) : tensor<512xi32>
  %ksigns = check.generate.fill value(0) : tensor<128xi8>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1114112xf32>
  %expected = check.generate.fill value(0.0) : tensor<1114112xf32>
  %wstage = check.generate.fill value(0.0) : tensor<89128960xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1114112xf32>
  kernel.launch @yah_ffn_gemm_iq2xxs(%weight, %grid, %ksigns, %input, %wstage, %ostage, %output) : (tensor<22978560xi8>, tensor<512xi32>, tensor<128xi8>, tensor<64x5120xf16>, tensor<89128960xf16>, tensor<1114112xf32>, tensor<1114112xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1114112xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_iq2xxs_full_case> @yah_ffn_gemm_iq2xxs_full_bench