// YAH quantize-then-dequantize over 32-element blocks in fp16, Loom port of
// QuantizeDequantizeFp16Kernel.
//
// HIP source: engine/kv/kv_quant.hip. Same shape as the fp32 variant, one
// work-item per 32-element block:
//
//   amax  = max_i |f32(x[i])|
//   scale = amax > 0 ? amax / levels : 0
//   if scale == 0: return                      (block left untouched)
//   x[i]  = f16( clamp(round(f32(x[i]) / scale), -levels, levels) * scale )
//
// The fp32 variant stores its results in fp32, so it is exact end to end. This
// one crosses f16 twice more: the magnitude scan widens each element, and the
// write rounds back. That rounding is the point of the kernel -- it is the fp16
// analogue of the KV operand error measurement -- so the check is exact only
// because the round trip is exact for the values it uses: with uniform input the
// scale divides the value exactly and f16(3.0) survives the round trip.
//
// See yah_qdq_f32.loom for why the config is a promise rather than something the
// kernel can verify: on this target a kernel cannot learn its operand size, so
// over-declaring the config is an out-of-bounds write. tools/loom_preflight.py
// blocks that, and loom_run.sh keeps correctness and timing on one config.
//
// Required configs, one per case:
//
//   @yah_qdq16_small  blocks=32    (32 x 32 = 1024 f16 = 2048 B)
//   @yah_qdq16_full   blocks=10240 (10240 x 32 = 327680 f16 = 655360 B)
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_qdq16.blocks : %value: index where [range(%value, 1, 1048576)]

config.def @yah_qdq16.levels = 8 : i32

kernel.def target(@yah_wave32) @yah_qdq16() {
  %unit = index.constant 1 : index
  %blocks = config.get @yah_qdq16.blocks : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %blocks, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%x: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %negone = scalar.constant -1.0 : f32
  %zero = scalar.constant 0.0 : f32
  %blocks = config.get @yah_qdq16.blocks : index
  %total = index.mul %blocks, %c32 : index
  %levels_i = config.get @yah_qdq16.levels : i32
  %levels = scalar.sitofp %levels_i : i32 to f32
  %neg_levels_i = scalar.negi %levels_i : i32
  %x_noalias = buffer.assume.noalias %x : buffer
  %x_view = buffer.view %x_noalias[%base] : buffer -> view<[%total]xf16>
  %lane = kernel.workitem.id<x> : index
  %wg = kernel.workgroup.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %blk = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %blk, %blocks : index
  scf.if %in_range {
    %blk_base = index.mul %blk, %c32 : index
    %amax = scf.for %i = [%c0 to %c32 step %c1](%a = %zero : f32) -> (f32) {
      %off = index.add %blk_base, %i : index
      %v = view.load %x_view[%off] : view<[%total]xf16> -> f16
      %vf = scalar.extf %v : f16 to f32
      %av = scalar.absf %vf : f32
      %m = scalar.maxnumf %a, %av : f32
      scf.yield %m : f32
    }
    %positive = scalar.cmpf ogt, %amax, %zero : f32
    %scale0 = scalar.divf %amax, %levels : f32
    %scale = scf.if %positive -> (f32) {
      scf.yield %scale0 : f32
    } else {
      scf.yield %zero : f32
    }
    %nonzero = scalar.cmpf one, %scale, %zero : f32
    scf.if %nonzero {
      %sink = scf.for %j = [%c0 to %c32 step %c1](%t = %zero : f32) -> (f32) {
        %off2 = index.add %blk_base, %j : index
        %v2 = view.load %x_view[%off2] : view<[%total]xf16> -> f16
        %v2f = scalar.extf %v2 : f16 to f32
        %scaled = scalar.divf %v2f, %scale : f32
        %r = scalar.roundf %scaled : f32
        %q = scalar.fptosi %r : f32 to i32
        %hi = scalar.minsi %q, %levels_i : i32
        %lo = scalar.maxsi %hi, %neg_levels_i : i32
        %lof = scalar.sitofp %lo : i32 to f32
        %back = scalar.mulf %lof, %scale : f32
        %half = scalar.fptrunc %back : f32 to f16
        view.store %half, %x_view[%off2] : f16, view<[%total]xf16>
        scf.yield %t : f32
      }
    }
  }
  kernel.return
}

// Requires --config=yah_qdq16.blocks=32.
check.case public @yah_qdq16_small {
  %x = check.generate.fill value(3.0) : tensor<1024xf16>
  %expected = check.generate.fill value(3.0) : tensor<1024xf16>
  kernel.launch @yah_qdq16(%x) : (tensor<1024xf16>)
  check.expect.close actual(%x) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1024xf16>
  check.return
}

check.benchmark<@yah_qdq16_small> @yah_qdq16_small_bench

// Requires --config=yah_qdq16.blocks=10240. The real shape: 64 x 5120 fp16.
check.case public @yah_qdq16_full {
  %x = check.generate.fill value(3.0) : tensor<327680xf16>
  %expected = check.generate.fill value(3.0) : tensor<327680xf16>
  kernel.launch @yah_qdq16(%x) : (tensor<327680xf16>)
  check.expect.close actual(%x) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<327680xf16>
  check.return
}

check.benchmark<@yah_qdq16_full> @yah_qdq16_full_bench
