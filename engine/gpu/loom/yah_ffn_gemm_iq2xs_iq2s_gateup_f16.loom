// YAH FFN GEMM with in-kernel mixed-format paired gate/up, Loom port of
// HalfPrefillGemmKernel<..., kIQ2_XS, kIQ2_S, kGateUp>.
//
// HIP source: prefill_fp16.hip. The gate weight is IQ2_XS and the up weight is
// IQ2_S; each has its own decoder, block geometry, staging buffer and
// accumulator group, plus any table operands the format needs:
//
//   gate_acc[row][token] = sum_k iq2xs_decode(gate_w, row, k) * f16(A[token][k])
//   up_acc[row][token]   = sum_k iq2s_decode(up_w,   row, k) * f16(A[token][k])
//   out[token*m + row]   = round_f16(silu(gate_acc) * up_acc)
//
// Mixed paired arm with per-operand grid/ksigns operands where the format needs
// them. Generated from yah_ffn_gemm_q4k_gateup_f16.loom with per-operand sizes,
// per-operand block shifts and suffixed decode constants.
//
// Measured: 27.84 ms at m_tiles=1088 (production 17408 rows). Both decoders,
// any table lookups and the combine are untuned.
//
// Correctness case: the gate fixture is the packed IQ2_XS input, the up
// fixture the packed IQ2_S input, and the activation is 0.03125. Expected is
// round_f16(silu(gate_acc) * up_acc). The production-size case uses all-zero
// weights, so every output is zero.
//
// Required config (correctness): --config=yah_ffn_gemm_iq2xs_iq2s_gateup.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_iq2xs_iq2s_gateup.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_iq2xs_iq2s_gateup.m_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_iq2xs_iq2s_gateup() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_iq2xs_iq2s_gateup.m_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%gate_weight: buffer, %gate_grid: buffer, %gate_ksigns: buffer, %up_weight: buffer, %up_grid: buffer, %input: buffer, %gwstage: buffer, %uwstage: buffer, %ogate: buffer, %oup: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
