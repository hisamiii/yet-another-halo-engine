      %qs2_lo_g = index.max %qs2_ix_g, %c0 : index
      %qs2_idx_g = index.min %qs2_lo_g, %gw_last : index
      %qb0_8_g = view.load %gw_view[%qs1_idx_g] : view<[%gw_bytes]xi8> -> i8
      %qb1_8_g = view.load %gw_view[%qs2_idx_g] : view<[%gw_bytes]xi8> -> i8
      %qb0_g = scalar.extui %qb0_8_g : i8 to i32
      %qb1_g = scalar.extui %qb1_8_g : i8 to i32
