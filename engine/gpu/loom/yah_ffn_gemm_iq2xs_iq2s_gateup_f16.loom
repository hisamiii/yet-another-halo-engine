      }
      %sco_u = scalar.addi %blk_off_u, %c74i_u : i32
      %sc_i_u = scalar.addi %sco_u, %group_u : i32
      %sc_ix_u = index.cast %sc_i_u : i32 to index
      %sc_lo_u = index.max %sc_ix_u, %c0 : index
      %sc_idx_u = index.min %sc_lo_u, %uw_last : index
      %scb8_u = view.load %uw_view[%sc_idx_u] : view<[%uw_bytes]xi8> -> i8
      %scb_u = scalar.extui %scb8_u : i8 to i32
      %is_low_u = scalar.cmpi eq, %half_u, %c0i_u : i32
      %nib_u = scf.if %is_low_u -> (i32) {
        %ni_lo_u = scalar.andi %scb_u, %c15i_u : i32
        scf.yield %ni_lo_u : i32
      } else {
        %ni_hi_u = scalar.shrui %scb_u, %c4i_u : i32
        scf.yield %ni_hi_u : i32
      }
      %nib_f_u = scalar.sitofp %nib_u : i32 to f32
      %hp_u = scalar.addf %nib_f_u, %fhalf_u : f32
      %hp2_u = scalar.mulf %hp_u, %fquarter_u : f32
      %mag_f_u = scalar.sitofp %mag_u : i32 to f32
      %blk_half0_u = scalar.shrui %blk_off_u, %c1i_u : i32
      %d_ix_u = index.cast %blk_half0_u : i32 to index
      %d_lo_u = index.max %d_ix_u, %c0 : index
      %d_idx_u = index.min %d_lo_u, %uw_half_last : index
      %d_half_v_u = view.load %uw_f16_view[%d_idx_u] : view<[%uw_halfs]xf16> -> f16
      %d_u = scalar.extf %d_half_v_u : f16 to f32
      %scale_f_u = scalar.mulf %d_u, %hp2_u : f32
      %value_u = scalar.mulf %scale_f_u, %mag_f_u : f32
      %h_u = scalar.fptrunc %value_u : f32 to f16
      %c_ix_u = index.cast %c_i_u : i32 to index
      %c_idx_u = index.max %c_ix_u, %c0 : index
      %kx_u = index.add %kk, %c_idx_u : index
      %row_ix_u = index.cast %row_i_u : i32 to index
      %row_lo_u = index.max %row_ix_u, %c0 : index
      %row_u = index.min %row_lo_u, %stage_last : index
      view.store %h_u, %uwstage_view[%row_u, %kx_u] : f16, view<[%stage_rows]x5120xf16>
      scf.yield %mk_u : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhsg = vector.fragment.load<lhs> %gwstage_view[%m_origin, %kk] shape [%m, %k] : view<[%stage_rows]x5120xf16> -> vector<16xf16>
    %lhsu = vector.fragment.load<lhs> %uwstage_view[%m_origin, %kk] shape [%m, %k] : view<[%stage_rows]x5120xf16> -> vector<16xf16>
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %c0] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %c16] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %c32] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %c48] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %ng0 = vector.mma %lhsg, %rhs0, %ag0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng1 = vector.mma %lhsg, %rhs1, %ag1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng2 = vector.mma %lhsg, %rhs2, %ag2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng3 = vector.mma %lhsg, %rhs3, %ag3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu0 = vector.mma %lhsu, %rhs0, %au0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu1 = vector.mma %lhsu, %rhs1, %au1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu2 = vector.mma %lhsu, %rhs2, %au2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu3 = vector.mma %lhsu, %rhs3, %au3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %ng0, %ng1, %ng2, %ng3, %nu0, %nu1, %nu2, %nu3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  vector.fragment.store<result> %g0, %ogate_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %g1, %ogate_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %g2, %ogate_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %g3, %ogate_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u0, %oup_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u1, %oup_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u2, %oup_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u3, %oup_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %gv = view.load %ogate_view[%gr2, %tok] : view<[%stage_rows]x64xf32> -> f32
    %uv = view.load %oup_view[%gr2, %tok] : view<[%stage_rows]x64xf32> -> f32
    %tok_off = index.mul %tok, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    %negg = scalar.mulf %gv, %negone : f32
    %e = scalar.expf<afn> %negg : f32
    %den = scalar.addf %one, %e : f32
    %inv = scalar.divf %one, %den : f32
    %sig = scalar.mulf %gv, %inv : f32
    %act = scalar.mulf %sig, %uv : f32
    %h = scalar.fptrunc %act : f32 to f16
    view.store %h, %out_view[%gflat] : f16, view<[%out_total]xf16>
    scf.yield %mk2 : index
  }
  kernel.return
}

