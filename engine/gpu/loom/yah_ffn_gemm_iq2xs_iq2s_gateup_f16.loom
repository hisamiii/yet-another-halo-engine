  %negone = scalar.constant -1.0 : f32
  %m_tiles = config.get @yah_ffn_gemm_iq2xs_iq2s_gateup.m_tiles : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %cag_bytes = index.constant 23680 : index
  %cag_halfs = index.constant 11840 : index
  %cbu_bytes = index.constant 26240 : index
  %cbu_halfs = index.constant 13120 : index
  %gw_bytes = index.mul %m_tiles, %cag_bytes : index
  %gw_halfs = index.mul %m_tiles, %cag_halfs : index
  %uw_bytes = index.mul %m_tiles, %cbu_bytes : index
