// YAH FFN GEMM with in-kernel IQ4_XS decode and the SwiGLU epilogue, Loom port of
// HalfPrefillGemmKernel<..., kIQ4_XS, kSwiGLU>.
//
// HIP source: prefill_fp16.hip. The decoder and K loop are yah_ffn_gemm_iq4xs_swiglu_f32;
// the epilogue combines the accumulator with the separate f32 gate projection:
//
//   out[token*m + row] = round_f16(silu(gate[token*m + row]) * acc[row][token])
//
// This is the FFN up-projection fallback arm (LaunchBatchedQuantGEMMSwiGLUFp16),
// taken when TryLaunchBatchedDualQuantGEMMSwiGLUFp16 declines the pair: it only
// instantiates ten mixed pairs and four same-format pairs, so every other layer
// of this shard runs this arm. It is on the route.
//
// Measured: 14.82 ms at m_tiles=1088 (production 17408 rows). The decoder, K
// loop and the silu combine are untuned.
//
// Correctness case: the same packed fixture, the activation scaled to 512 so the
// accumulator stays inside the f16 range, gate = 1, and the expected is
// round_f16(silu(1) * acc). The production-size case uses an all-zero weight, so
// the accumulator is zero and every output is zero.
//
// Required config (correctness): --config=yah_ffn_gemm_iq4xs_swiglu_swiglu.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_iq4xs_swiglu_swiglu.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_iq4xs_swiglu.m_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_iq4xs_swiglu() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_iq4xs_swiglu.m_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %input: buffer, %gate: buffer, %wstage: buffer, %ostage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c5120 = index.constant 5120 : index
  %c2880 = index.constant 2720 : index
  %c23040 = index.constant 21760 : index
  %c46080 = index.constant 43520 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %kval0 = scalar.constant -127.0 : f32
  %kval1 = scalar.constant -104.0 : f32
  %kval2 = scalar.constant -83.0 : f32
  %kval3 = scalar.constant -65.0 : f32
  %kval4 = scalar.constant -49.0 : f32
  %kval5 = scalar.constant -35.0 : f32
  %kval6 = scalar.constant -22.0 : f32
  %kval7 = scalar.constant -10.0 : f32
  %kval8 = scalar.constant 1.0 : f32
  %kval9 = scalar.constant 13.0 : f32
  %kval10 = scalar.constant 25.0 : f32
  %kval11 = scalar.constant 38.0 : f32
  %kval12 = scalar.constant 53.0 : f32
  %kval13 = scalar.constant 69.0 : f32
  %kval14 = scalar.constant 89.0 : f32
  %kval15 = scalar.constant 113.0 : f32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c255i = scalar.constant 255 : i32
  %c144i = scalar.constant 136 : i32
  %c2880i = scalar.constant 2720 : i32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %m_tiles = config.get @yah_ffn_gemm_iq4xs_swiglu.m_tiles : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %w_bytes = index.mul %m_tiles, %c46080 : index
  %w_halfs = index.mul %m_tiles, %c23040 : index
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %out_total = index.mul %m_rows, %c64 : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [1, 5120] : encoding<layout>
  %weight_na, %input_na, %gate_na, %wstage_na, %ostage_na, %output_na = buffer.assume.noalias %weight, %input, %gate, %wstage, %ostage, %output : buffer, buffer, buffer, buffer, buffer, buffer
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<5120x64xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf16>
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<[%out_total]xf32>
  %wstage_view = buffer.view %wstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %ostage_view = buffer.view %ostage_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc0, %acc1, %acc2, %acc3 = scf.for %kk = [%c0 to %c5120 step %c16](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32
    %j_sink = scf.for %j = [%c0 to %c8 step %c1](%mk = %c0 : index) -> (index) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %e_i = scalar.addi %lane_i, %j32 : i32
      %r_i = scalar.shrui %e_i, %c4i : i32
      %c_i = scalar.andi %e_i, %c15i : i32
      %i_i = scalar.addi %kbase, %c_i : i32
      %group = scalar.shrui %i_i, %c5i : i32
      %within = scalar.andi %i_i, %c31i : i32
      %l_i = scalar.andi %within, %c15i : i32
      %high = scalar.shrui %within, %c4i : i32
      %row_i = scalar.addi %m_origin_i, %r_i : i32
      %row_off = scalar.muli %row_i, %c2880i : i32
      %blk_off0 = scalar.muli %kblk, %c144i : i32
      %blk_off = scalar.addi %row_off, %blk_off0 : i32
      %g16 = scalar.shli %group, %c4i : i32
      %qs0 = scalar.addi %blk_off, %c8i : i32
      %qs1 = scalar.addi %qs0, %g16 : i32
      %qs2 = scalar.addi %qs1, %l_i : i32
      %qs_ix = index.cast %qs2 : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %w_last : index
      %qb8 = view.load %w_view[%qs_idx] : view<[%w_bytes]xi8> -> i8
      %qb = scalar.extui %qb8 : i8 to i32
      %nib_lo = scalar.andi %qb, %c15i : i32
      %nib_hi = scalar.shrui %qb, %c4i : i32
      %is_hi = scalar.cmpi eq, %high, %c1i : i32
      %nib = scf.if %is_hi -> (i32) {
        scf.yield %nib_hi : i32
      } else {
        scf.yield %nib_lo : i32
      }
      %nib0 = scalar.andi %nib, %c1i : i32
      %t0 = scalar.cmpi eq, %nib0, %c1i : i32
      %nib1s = scalar.shrui %nib, %c1i : i32
      %nib1 = scalar.andi %nib1s, %c1i : i32
      %t1 = scalar.cmpi eq, %nib1, %c1i : i32
      %nib2s = scalar.shrui %nib, %c2i : i32
      %nib2 = scalar.andi %nib2s, %c1i : i32
      %t2 = scalar.cmpi eq, %nib2, %c1i : i32
      %nib3s = scalar.shrui %nib, %c3i : i32
      %nib3 = scalar.andi %nib3s, %c1i : i32
      %t3 = scalar.cmpi eq, %nib3, %c1i : i32
      %code = scf.if %t3 -> (f32) {
        %cb8_8 = scf.if %t2 -> (f32) {
          %cb12_4 = scf.if %t1 -> (f32) {
            %cb14_2 = scf.if %t0 -> (f32) {
              scf.yield %kval15 : f32
            } else {
              scf.yield %kval14 : f32
            }
            scf.yield %cb14_2 : f32
          } else {
            %cb12_2 = scf.if %t0 -> (f32) {
              scf.yield %kval13 : f32
            } else {
              scf.yield %kval12 : f32
            }
            scf.yield %cb12_2 : f32
          }
          scf.yield %cb12_4 : f32
        } else {
          %cb8_4 = scf.if %t1 -> (f32) {
            %cb10_2 = scf.if %t0 -> (f32) {
              scf.yield %kval11 : f32
            } else {
              scf.yield %kval10 : f32
            }
            scf.yield %cb10_2 : f32
          } else {
            %cb8_2 = scf.if %t0 -> (f32) {
              scf.yield %kval9 : f32
            } else {
              scf.yield %kval8 : f32
            }
            scf.yield %cb8_2 : f32
          }
          scf.yield %cb8_4 : f32
        }
        scf.yield %cb8_8 : f32
      } else {
        %cb0_8 = scf.if %t2 -> (f32) {
          %cb4_4 = scf.if %t1 -> (f32) {
            %cb6_2 = scf.if %t0 -> (f32) {
              scf.yield %kval7 : f32
            } else {
              scf.yield %kval6 : f32
            }
            scf.yield %cb6_2 : f32
          } else {
            %cb4_2 = scf.if %t0 -> (f32) {
              scf.yield %kval5 : f32
            } else {
              scf.yield %kval4 : f32
            }
            scf.yield %cb4_2 : f32
          }
          scf.yield %cb4_4 : f32
        } else {
          %cb0_4 = scf.if %t1 -> (f32) {
            %cb2_2 = scf.if %t0 -> (f32) {
              scf.yield %kval3 : f32
            } else {
              scf.yield %kval2 : f32
            }
            scf.yield %cb2_2 : f32
          } else {
            %cb0_2 = scf.if %t0 -> (f32) {
              scf.yield %kval1 : f32
            } else {
              scf.yield %kval0 : f32
            }
            scf.yield %cb0_2 : f32
          }
          scf.yield %cb0_4 : f32
        }
        scf.yield %cb0_8 : f32
      }
      %gpar = scalar.andi %group, %c1i : i32
      %sh4 = scalar.shli %gpar, %c2i : i32
      %gh = scalar.shrui %group, %c1i : i32
      %sl0 = scalar.addi %blk_off, %c4i : i32
      %sl1 = scalar.addi %sl0, %gh : i32
      %sl_ix = index.cast %sl1 : i32 to index
      %sl_lo2 = index.max %sl_ix, %c0 : index
      %sl_idx = index.min %sl_lo2, %w_last : index
      %sl8 = view.load %w_view[%sl_idx] : view<[%w_bytes]xi8> -> i8
      %slb = scalar.extui %sl8 : i8 to i32
      %sc_sh = scalar.shrui %slb, %sh4 : i32
      %sc_l = scalar.andi %sc_sh, %c15i : i32
      %sh0 = scalar.addi %blk_off, %c2i : i32
      %sh1 = scalar.addi %blk_off, %c3i : i32
      %sh0_ix = index.cast %sh0 : i32 to index
      %sh0_lo = index.max %sh0_ix, %c0 : index
      %sh0_idx = index.min %sh0_lo, %w_last : index
      %sh1_ix = index.cast %sh1 : i32 to index
      %sh1_lo = index.max %sh1_ix, %c0 : index
      %sh1_idx = index.min %sh1_lo, %w_last : index
      %shb0 = view.load %w_view[%sh0_idx] : view<[%w_bytes]xi8> -> i8
      %shb1 = view.load %w_view[%sh1_idx] : view<[%w_bytes]xi8> -> i8
      %shv0 = scalar.extui %shb0 : i8 to i32
      %shv1 = scalar.extui %shb1 : i8 to i32
      %shv1s = scalar.shli %shv1, %c8i : i32
      %shv = scalar.ori %shv0, %shv1s : i32
      %sh2 = scalar.shli %group, %c1i : i32
      %sc_hi_all = scalar.shrui %shv, %sh2 : i32
      %sc_hi = scalar.andi %sc_hi_all, %c3i : i32
      %sc_hi4 = scalar.shli %sc_hi, %c4i : i32
      %sc6 = scalar.ori %sc_l, %sc_hi4 : i32
      %sc = scalar.subi %sc6, %c32i : i32
      %sc_f = scalar.sitofp %sc : i32 to f32
      %blk_half = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half : i32 to index
      %d_lo2 = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo2, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %value = scalar.mulf %dsc, %code : f32
      %h = scalar.fptrunc %value : f32 to f16
      %c_ix = index.cast %c_i : i32 to index
      %c_idx = index.max %c_ix, %c0 : index
      %kx = index.add %kk, %c_idx : index
      %row_ix = index.cast %row_i : i32 to index
      %row_lo = index.max %row_ix, %c0 : index
      %row = index.min %row_lo, %stage_last : index
      view.store %h, %wstage_view[%row, %kx] : f16, view<[%stage_rows]x5120xf16>
      scf.yield %mk : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhs = vector.fragment.load<lhs> %wstage_view[%m_origin, %kk] shape [%m, %k] : view<[%stage_rows]x5120xf16> -> vector<16xf16>
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %c0] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %c16] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %c32] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %c48] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %n0 = vector.mma %lhs, %rhs0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n1 = vector.mma %lhs, %rhs1, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n2 = vector.mma %lhs, %rhs2, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n3 = vector.mma %lhs, %rhs3, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %n0, %n1, %n2, %n3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  vector.fragment.store<result> %acc0, %ostage_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %acc1, %ostage_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %acc2, %ostage_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %acc3, %ostage_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %val = view.load %ostage_view[%gr2, %tok] : view<[%stage_rows]x64xf32> -> f32
    %tok_off = index.mul %tok, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    %g = view.load %gate_view[%gflat] : view<[%out_total]xf32> -> f32
    %negg = scalar.mulf %g, %negone : f32
    %e = scalar.expf<afn> %negg : f32
    %den = scalar.addf %one, %e : f32
    %inv = scalar.divf %one, %den : f32
    %sig = scalar.mulf %g, %inv : f32
    %act = scalar.mulf %sig, %val : f32
    %h = scalar.fptrunc %act : f32 to f16
    view.store %h, %out_view[%gflat] : f16, view<[%out_total]xf16>
    scf.yield %mk2 : index
  }
  kernel.return
}

// Requires --config=yah_ffn_gemm_iq4xs_swiglu.m_tiles=1.
check.case public @yah_ffn_gemm_iq4xs_swiglu_case {
  %weight = check.file.read.npy path("fixtures/iq4xs_gemm/input_iq4xs_gemm.npy") : tensor<43520xi8>
  %input = check.generate.fill value(512.0) : tensor<64x5120xf16>
  %gate = check.generate.fill value(1.0) : tensor<1024xf32>
  %output = check.generate.fill value(0.0) : tensor<1024xf16>
  %expected = check.file.read.npy path("fixtures/iq4xs_gemm/expected_swiglu.npy") : tensor<1024xf16>
  %wstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1024xf32>
  kernel.launch @yah_ffn_gemm_iq4xs_swiglu(%weight, %input, %gate, %wstage, %ostage, %output) : (tensor<43520xi8>, tensor<64x5120xf16>, tensor<1024xf32>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf16>)
  check.expect.close actual(%output) expected(%expected) atol(8.0) rtol(0.0) nan(same) : tensor<1024xf16>
  check.return
}

check.benchmark<@yah_ffn_gemm_iq4xs_swiglu_case> @yah_ffn_gemm_iq4xs_swiglu_bench

// Requires --config=yah_ffn_gemm_iq4xs_swiglu.m_tiles=1088. An all-zero IQ4_XS weight
// decodes to zero, so every output must be exactly 0.
check.case public @yah_ffn_gemm_iq4xs_swiglu_full_case {
  %weight = check.generate.fill value(0) : tensor<47349760xi8>
  %input = check.generate.fill value(512.0) : tensor<64x5120xf16>
  %gate = check.generate.fill value(1.0) : tensor<1114112xf32>
  %output = check.generate.fill value(0.0) : tensor<1114112xf16>
  %expected = check.generate.fill value(0.0) : tensor<1114112xf16>
  %wstage = check.generate.fill value(0.0) : tensor<89128960xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1114112xf32>
  kernel.launch @yah_ffn_gemm_iq4xs_swiglu(%weight, %input, %gate, %wstage, %ostage, %output) : (tensor<47349760xi8>, tensor<64x5120xf16>, tensor<1114112xf32>, tensor<89128960xf16>, tensor<1114112xf32>, tensor<1114112xf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1114112xf16>
  check.return
}

check.benchmark<@yah_ffn_gemm_iq4xs_swiglu_full_case> @yah_ffn_gemm_iq4xs_swiglu_full_bench