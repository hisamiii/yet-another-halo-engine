// YAH FFN GEMM with in-kernel mixed-format paired gate/up, Loom port of
// HalfPrefillGemmKernel<..., kQ4_K, kIQ4_XS, kGateUp>.
//
// HIP source: prefill_fp16.hip. The gate weight is Q4_K and the up weight is
// IQ4_XS; each has its own decoder, block geometry, staging buffer and
// accumulator group:
//
//   gate_acc[row][token] = sum_k q4k_decode(gate_w, row, k) * f16(A[token][k])
//   up_acc[row][token]   = sum_k iq4xs_decode(up_w,   row, k) * f16(A[token][k])
//   out[token*m + row]   = round_f16(silu(gate_acc) * up_acc)
//
// Mixed paired arm. Generated from yah_ffn_gemm_q4k_gateup_f16.loom with per-
// operand sizes and suffixed decode constants, because the two formats have
// different block bytes, row strides and decode constants.
//
// Measured: 31.89 ms at m_tiles=1088 (production 17408 rows). 1.505 ms at
// m_tiles=1. Both decoders and the combine are untuned.
//
// Correctness case: the gate fixture is the packed Q4_K input, the up
// fixture the packed IQ4_XS input, and the activation is 0.0625. Expected is
// round_f16(silu(gate_acc) * up_acc). The production-size case uses all-zero
// weights, so every output is zero.
//
// Required config (correctness): --config=yah_ffn_gemm_q4k_iq4xs_gateup.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_q4k_iq4xs_gateup.m_tiles=1088
amdgpu.target<gfx1151> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_q4k_iq4xs_gateup.m_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_q4k_iq4xs_gateup() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_q4k_iq4xs_gateup.m_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%gate_weight: buffer, %up_weight: buffer, %input: buffer, %gwstage: buffer, %uwstage: buffer, %ogate: buffer, %oup: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c5120 = index.constant 5120 : index
  %c2880 = index.constant 2880 : index
  %c23040 = index.constant 23040 : index
  %c46080 = index.constant 46080 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c255i = scalar.constant 255 : i32
  %c0i_g = scalar.constant 0 : i32
  %c1i_g = scalar.constant 1 : i32
  %c4i_g = scalar.constant 4 : i32
  %c5i_g = scalar.constant 5 : i32
  %c6i_g = scalar.constant 6 : i32
  %c8i_g = scalar.constant 8 : i32
  %c15i_g = scalar.constant 15 : i32
  %c16i_g = scalar.constant 16 : i32
  %c31i_g = scalar.constant 31 : i32
  %c32i_g = scalar.constant 32 : i32
  %c63i_g = scalar.constant 63 : i32
  %c255i_g = scalar.constant 255 : i32
  %c144i_g = scalar.constant 144 : i32
  %c2880i_g = scalar.constant 2880 : i32
  %c0i_u = scalar.constant 0 : i32
  %c1i_u = scalar.constant 1 : i32
  %c2i_u = scalar.constant 2 : i32
  %c3i_u = scalar.constant 3 : i32
  %kval0_u = scalar.constant -127.0 : f32
  %kval1_u = scalar.constant -104.0 : f32
  %kval2_u = scalar.constant -83.0 : f32
  %kval3_u = scalar.constant -65.0 : f32
  %kval4_u = scalar.constant -49.0 : f32
  %kval5_u = scalar.constant -35.0 : f32
  %kval6_u = scalar.constant -22.0 : f32
  %kval7_u = scalar.constant -10.0 : f32
  %kval8_u = scalar.constant 1.0 : f32
  %kval9_u = scalar.constant 13.0 : f32
  %kval10_u = scalar.constant 25.0 : f32
  %kval11_u = scalar.constant 38.0 : f32
  %kval12_u = scalar.constant 53.0 : f32
  %kval13_u = scalar.constant 69.0 : f32
  %kval14_u = scalar.constant 89.0 : f32
  %kval15_u = scalar.constant 113.0 : f32
  %c4i_u = scalar.constant 4 : i32
  %c5i_u = scalar.constant 5 : i32
  %c6i_u = scalar.constant 6 : i32
  %c8i_u = scalar.constant 8 : i32
  %c15i_u = scalar.constant 15 : i32
  %c16i_u = scalar.constant 16 : i32
  %c31i_u = scalar.constant 31 : i32
  %c32i_u = scalar.constant 32 : i32
  %c63i_u = scalar.constant 63 : i32
  %c255i_u = scalar.constant 255 : i32
  %c144i_u = scalar.constant 136 : i32
  %c2880i_u = scalar.constant 2720 : i32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %m_tiles = config.get @yah_ffn_gemm_q4k_iq4xs_gateup.m_tiles : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %cag_bytes = index.constant 46080 : index
  %cag_halfs = index.constant 23040 : index
  %cbu_bytes = index.constant 43520 : index
  %cbu_halfs = index.constant 21760 : index
  %gw_bytes = index.mul %m_tiles, %cag_bytes : index
  %gw_halfs = index.mul %m_tiles, %cag_halfs : index
  %uw_bytes = index.mul %m_tiles, %cbu_bytes : index
  %uw_halfs = index.mul %m_tiles, %cbu_halfs : index
  %gw_last = index.sub %gw_bytes, %c1 : index
  %gw_half_last = index.sub %gw_halfs, %c1 : index
  %uw_last = index.sub %uw_bytes, %c1 : index
  %uw_half_last = index.sub %uw_halfs, %c1 : index
  %out_total = index.mul %m_rows, %c64 : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [1, 5120] : encoding<layout>
  %gate_weight_na, %up_weight_na, %input_na, %gwstage_na, %uwstage_na, %ogate_na, %oup_na, %output_na = buffer.assume.noalias %gate_weight, %up_weight, %input, %gwstage, %uwstage, %ogate, %oup, %output : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %gw_view = buffer.view %gate_weight_na[%base] : buffer -> view<[%gw_bytes]xi8>
  %gw_f16_view = buffer.view %gate_weight_na[%base] : buffer -> view<[%gw_halfs]xf16>
  %uw_view = buffer.view %up_weight_na[%base] : buffer -> view<[%uw_bytes]xi8>
  %uw_f16_view = buffer.view %up_weight_na[%base] : buffer -> view<[%uw_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<5120x64xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf16>
  %gwstage_view = buffer.view %gwstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %uwstage_view = buffer.view %uwstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %ogate_view = buffer.view %ogate_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %oup_view = buffer.view %oup_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %g0, %g1, %g2, %g3, %u0, %u1, %u2, %u3 = scf.for %kk = [%c0 to %c5120 step %c16](%ag0 = %init : vector<8xf32>, %ag1 = %init : vector<8xf32>, %ag2 = %init : vector<8xf32>, %ag3 = %init : vector<8xf32>, %au0 = %init : vector<8xf32>, %au1 = %init : vector<8xf32>, %au2 = %init : vector<8xf32>, %au3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32

    %j_sink_g = scf.for %j_g = [%c0 to %c8 step %c1](%mk_g = %c0 : index) -> (index) {
      %j_i_g = index.cast %j_g : index to i32
      %j32_g = scalar.shli %j_i_g, %c5i_g : i32
      %e_i_g = scalar.addi %lane_i, %j32_g : i32
      %r_i_g = scalar.shrui %e_i_g, %c4i_g : i32
      %c_i_g = scalar.andi %e_i_g, %c15i_g : i32
      %i_i_g = scalar.addi %kbase, %c_i_g : i32
      %gg_i_g = scalar.shrui %i_i_g, %c6i_g : i32
      %wv_i_g = scalar.andi %i_i_g, %c63i_g : i32
      %lane_dec_g = scalar.andi %wv_i_g, %c31i_g : i32
      %wv_hi_g = scalar.shrui %wv_i_g, %c5i_g : i32
      %is_low_g = scalar.cmpi slt, %wv_i_g, %c32i_g : i32
      %row_i_g = scalar.addi %m_origin_i, %r_i_g : i32
      %row_off_g = scalar.muli %row_i_g, %c2880i_g : i32
      %blk_off0_g = scalar.muli %kblk, %c144i_g : i32
      %blk_off_g = scalar.addi %row_off_g, %blk_off0_g : i32
      %qs0_g = scalar.addi %blk_off_g, %c16i_g : i32
      %gg32_g = scalar.shli %gg_i_g, %c5i_g : i32
      %qs1_g = scalar.addi %qs0_g, %gg32_g : i32
      %qs2_g = scalar.addi %qs1_g, %lane_dec_g : i32
      %qs_ix_g = index.cast %qs2_g : i32 to index
      %qs_lo_g = index.max %qs_ix_g, %c0 : index
      %qs_idx_g = index.min %qs_lo_g, %gw_last : index
      %qb8_g = view.load %gw_view[%qs_idx_g] : view<[%gw_bytes]xi8> -> i8
      %qb_g = scalar.extui %qb8_g : i8 to i32
      %qb_lo_g = scalar.andi %qb_g, %c15i_g : i32
      %qb_hi_g = scalar.shrui %qb_g, %c4i_g : i32
      %quant4_g = scf.if %is_low_g -> (i32) {
        scf.yield %qb_lo_g : i32
      } else {
        scf.yield %qb_hi_g : i32
      }
      %gg2_g = scalar.shli %gg_i_g, %c1i_g : i32
      %sis_g = scalar.addi %gg2_g, %wv_hi_g : i32
      %sis_low_g = scalar.cmpi slt, %sis_g, %c4i_g : i32
      %la0_g = scalar.addi %blk_off_g, %c4i_g : i32
      %la_i_g = scalar.addi %la0_g, %sis_g : i32
      %lb_i_g = scalar.addi %la_i_g, %c4i_g : i32
      %lc_i_g = scalar.addi %blk_off_g, %sis_g : i32
      %la_ix_g = index.cast %la_i_g : i32 to index
      %la_lo_g = index.max %la_ix_g, %c0 : index
      %la_idx_g = index.min %la_lo_g, %gw_last : index
      %lb_ix_g = index.cast %lb_i_g : i32 to index
      %lb_lo_g = index.max %lb_ix_g, %c0 : index
      %lb_idx_g = index.min %lb_lo_g, %gw_last : index
      %lc_ix_g = index.cast %lc_i_g : i32 to index
      %lc_lo_g = index.max %lc_ix_g, %c0 : index
      %lc_idx_g = index.min %lc_lo_g, %gw_last : index
      %la8_g = view.load %gw_view[%la_idx_g] : view<[%gw_bytes]xi8> -> i8
      %lb8_g = view.load %gw_view[%lb_idx_g] : view<[%gw_bytes]xi8> -> i8
      %lc8_g = view.load %gw_view[%lc_idx_g] : view<[%gw_bytes]xi8> -> i8
      %la_g = scalar.extui %la8_g : i8 to i32
      %lb_g = scalar.extui %lb8_g : i8 to i32
      %lc_g = scalar.extui %lc8_g : i8 to i32
      %sc, %smin_g = scf.if %sis_low_g -> (i32, i32) {
        %s_g = scalar.andi %la_g, %c63i_g : i32
        %mv_g = scalar.andi %lb_g, %c63i_g : i32
        scf.yield %s_g, %mv_g : i32, i32
      } else {
        %lb_lo_g = scalar.andi %lb_g, %c15i_g : i32
        %lc_hi_g = scalar.shrui %lc_g, %c6i_g : i32
        %lc_hi4_g = scalar.shli %lc_hi_g, %c4i_g : i32
        %s2_g = scalar.ori %lb_lo_g, %lc_hi4_g : i32
        %lb_hi_g = scalar.shrui %lb_g, %c4i_g : i32
        %la_hi_g = scalar.shrui %la_g, %c6i_g : i32
        %la_hi4_g = scalar.shli %la_hi_g, %c4i_g : i32
        %m2_g = scalar.ori %lb_hi_g, %la_hi4_g : i32
        scf.yield %s2_g, %m2_g : i32, i32
      }
      %blk_half0_g = scalar.shrui %blk_off_g, %c1i_g : i32
      %d_ix_g = index.cast %blk_half0_g : i32 to index
      %d_lo_g = index.max %d_ix_g, %c0 : index
      %d_idx_g = index.min %d_lo_g, %gw_half_last : index
      %dmin0_g = scalar.addi %blk_half0_g, %c1i_g : i32
      %dmin_ix_g = index.cast %dmin0_g : i32 to index
      %dmin_lo_g = index.max %dmin_ix_g, %c0 : index
      %dmin_idx_g = index.min %dmin_lo_g, %gw_half_last : index
      %d_half_v_g = view.load %gw_f16_view[%d_idx_g] : view<[%gw_halfs]xf16> -> f16
      %dmin_half_v_g = view.load %gw_f16_view[%dmin_idx_g] : view<[%gw_halfs]xf16> -> f16
      %d_g = scalar.extf %d_half_v_g : f16 to f32
      %dmin_g = scalar.extf %dmin_half_v_g : f16 to f32
      %sc_f_g = scalar.sitofp %sc : i32 to f32
      %m_f_g = scalar.sitofp %smin_g : i32 to f32
      %q_f_g = scalar.sitofp %quant4_g : i32 to f32
      %dsc_g = scalar.mulf %d_g, %sc_f_g : f32
      %scaled_g = scalar.mulf %dsc_g, %q_f_g : f32
      %dm_g = scalar.mulf %dmin_g, %m_f_g : f32
      %value_g = scalar.subf %scaled_g, %dm_g : f32
      %h_g = scalar.fptrunc %value_g : f32 to f16
      %c_ix_g = index.cast %c_i_g : i32 to index
      %c_idx_g = index.max %c_ix_g, %c0 : index
      %kx_g = index.add %kk, %c_idx_g : index
      %row_ix_g = index.cast %row_i_g : i32 to index
      %row_lo_g = index.max %row_ix_g, %c0 : index
      %row_g = index.min %row_lo_g, %stage_last : index
