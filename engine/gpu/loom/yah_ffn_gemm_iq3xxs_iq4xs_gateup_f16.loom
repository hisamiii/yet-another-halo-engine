      %blk_off0_g = scalar.muli %kblk_g, %c98i_g : i32
      %blk_off_g = scalar.addi %row_off_g, %blk_off0_g : i32
      %group_g = scalar.shrui %i_i_g, %c5i_g : i32
      %half0_g = scalar.shrui %i_i_g, %c4i_g : i32
      %half_g = scalar.andi %half0_g, %c1i_g : i32
      %jj_g = scalar.andi %i_i_g, %c15i_g : i32
      %q_g = scalar.shrui %jj_g, %c3i_g : i32
      %which0_g = scalar.shrui %jj_g, %c2i_g : i32
      %which_g = scalar.andi %which0_g, %c1i_g : i32
      %b_g = scalar.andi %jj_g, %c3i_g : i32
      %l2_g = scalar.shli %half_g, %c1i_g : i32
      %l_g = scalar.addi %l2_g, %q_g : i32
      %l2x_g = scalar.shli %l_g, %c1i_g : i32
      %lw_g = scalar.addi %l2x_g, %which_g : i32
      %g8_g = scalar.shli %group_g, %c3i_g : i32
      %qso_g = scalar.addi %blk_off_g, %c2i_g : i32
      %g8a_g = scalar.addi %qso_g, %g8_g : i32
      %gix_i_g = scalar.addi %g8a_g, %lw_g : i32
      %gix_ix_g = index.cast %gix_i_g : i32 to index
      %gix_lo_g = index.max %gix_ix_g, %c0 : index
      %gix_g = index.min %gix_lo_g, %gw_last : index
      %qsb8_g = view.load %gw_view[%gix_g] : view<[%gw_bytes]xi8> -> i8
      %grid_lo_g = scalar.extui %qsb8_g : i8 to i32
      %gidx_ix_g = index.cast %grid_lo_g : i32 to index
      %gidx_lo_g = index.max %gidx_ix_g, %c0 : index
      %gidx_g = index.min %gidx_lo_g, %c255 : index
      %gword_g = view.load %gate_grid_view[%gidx_g] : view<256xi32> -> i32
      %g_shift_g = scalar.shli %b_g, %c3i_g : i32
      %gb0_g = scalar.shrui %gword_g, %g_shift_g : i32
      %g_byte_g = scalar.andi %gb0_g, %c255i_g : i32
      %auxb_g = scalar.addi %blk_off_g, %c66i_g : i32
      %ag4_g = scalar.shli %group_g, %c2i_g : i32
      %aux0_i_g = scalar.addi %auxb_g, %ag4_g : i32
      %aux1_i_g = scalar.addi %aux0_i_g, %c1i_g : i32
      %aux2_i_g = scalar.addi %aux0_i_g, %c2i_g : i32
      %aux3_i_g = scalar.addi %aux0_i_g, %c3i_g : i32
      %aux0_ix_g = index.cast %aux0_i_g : i32 to index
      %aux0_lo_g = index.max %aux0_ix_g, %c0 : index
      %aux0_idx_g = index.min %aux0_lo_g, %gw_last : index
