      %ab1_g = view.load %gw_view[%aux1_idx_g] : view<[%gw_bytes]xi8> -> i8
      %ab2_g = view.load %gw_view[%aux2_idx_g] : view<[%gw_bytes]xi8> -> i8
      %ab3_g = view.load %gw_view[%aux3_idx_g] : view<[%gw_bytes]xi8> -> i8
      %a0_g = scalar.extui %ab0_g : i8 to i32
      %a1_g = scalar.extui %ab1_g : i8 to i32
      %a2_g = scalar.extui %ab2_g : i8 to i32
      %a3_g = scalar.extui %ab3_g : i8 to i32
      %as1_g = scalar.shli %a1_g, %c8i_g : i32
      %as2_g = scalar.shli %a2_g, %c16i_g : i32
      %as3_g = scalar.shli %a3_g, %c24i_g : i32
