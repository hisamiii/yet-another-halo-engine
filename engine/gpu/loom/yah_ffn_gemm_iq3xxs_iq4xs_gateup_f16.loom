      %hp2_g = scalar.mulf %hp_g, %fhalf_g : f32
      %mag_f_g = scalar.sitofp %mag_g : i32 to f32
      %blk_half0_g = scalar.shrui %blk_off_g, %c1i_g : i32
      %d_ix_g = index.cast %blk_half0_g : i32 to index
      %d_lo_g = index.max %d_ix_g, %c0 : index
      %d_idx_g = index.min %d_lo_g, %gw_half_last : index
      %d_half_v_g = view.load %gw_f16_view[%d_idx_g] : view<[%gw_halfs]xf16> -> f16
