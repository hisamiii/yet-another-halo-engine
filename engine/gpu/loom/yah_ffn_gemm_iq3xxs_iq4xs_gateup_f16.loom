  %c1i_u = scalar.constant 1 : i32
  %c2i_u = scalar.constant 2 : i32
  %c3i_u = scalar.constant 3 : i32
  %kval0_u = scalar.constant -127.0 : f32
  %kval1_u = scalar.constant -104.0 : f32
  %kval2_u = scalar.constant -83.0 : f32
  %kval3_u = scalar.constant -65.0 : f32
  %kval4_u = scalar.constant -49.0 : f32
  %kval5_u = scalar.constant -35.0 : f32
  %kval6_u = scalar.constant -22.0 : f32
  %kval7_u = scalar.constant -10.0 : f32
  %kval8_u = scalar.constant 1.0 : f32
  %kval9_u = scalar.constant 13.0 : f32
  %kval10_u = scalar.constant 25.0 : f32
  %kval11_u = scalar.constant 38.0 : f32
  %kval12_u = scalar.constant 53.0 : f32
  %kval13_u = scalar.constant 69.0 : f32
  %kval14_u = scalar.constant 89.0 : f32
  %kval15_u = scalar.constant 113.0 : f32
  %c4i_u = scalar.constant 4 : i32
  %c5i_u = scalar.constant 5 : i32
  %c6i_u = scalar.constant 6 : i32
  %c8i_u = scalar.constant 8 : i32
  %c15i_u = scalar.constant 15 : i32
  %c16i_u = scalar.constant 16 : i32
  %c31i_u = scalar.constant 31 : i32
  %c32i_u = scalar.constant 32 : i32
  %c63i_u = scalar.constant 63 : i32
  %c255i_u = scalar.constant 255 : i32
  %c144i_u = scalar.constant 136 : i32
  %c2880i_u = scalar.constant 2720 : i32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %m_tiles = config.get @yah_ffn_gemm_iq3xxs_iq4xs_gateup.m_tiles : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %cag_bytes = index.constant 31360 : index
  %cag_halfs = index.constant 15680 : index
  %cbu_bytes = index.constant 43520 : index
  %cbu_halfs = index.constant 21760 : index
  %gw_bytes = index.mul %m_tiles, %cag_bytes : index
  %gw_halfs = index.mul %m_tiles, %cag_halfs : index
  %uw_bytes = index.mul %m_tiles, %cbu_bytes : index
  %uw_halfs = index.mul %m_tiles, %cbu_halfs : index
  %gw_last = index.sub %gw_bytes, %c1 : index
  %gw_half_last = index.sub %gw_halfs, %c1 : index
  %uw_last = index.sub %uw_bytes, %c1 : index
  %uw_half_last = index.sub %uw_halfs, %c1 : index
  %out_total = index.mul %m_rows, %c64 : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [1, 5120] : encoding<layout>
  %gate_weight_na, %gate_grid_na, %gate_ksigns_na, %up_weight_na, %input_na, %gwstage_na, %uwstage_na, %ogate_na, %oup_na, %output_na = buffer.assume.noalias %gate_weight, %gate_grid, %gate_ksigns, %up_weight, %input, %gwstage, %uwstage, %ogate, %oup, %output : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %gw_view = buffer.view %gate_weight_na[%base] : buffer -> view<[%gw_bytes]xi8>
  %gw_f16_view = buffer.view %gate_weight_na[%base] : buffer -> view<[%gw_halfs]xf16>
  %uw_view = buffer.view %up_weight_na[%base] : buffer -> view<[%uw_bytes]xi8>
  %uw_f16_view = buffer.view %up_weight_na[%base] : buffer -> view<[%uw_halfs]xf16>
  %gate_grid_view = buffer.view %gate_grid_na[%base] : buffer -> view<256xi32>
  %gate_ksigns_view = buffer.view %gate_ksigns_na[%base] : buffer -> view<128xi8>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<5120x64xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf16>
  %gwstage_view = buffer.view %gwstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %uwstage_view = buffer.view %uwstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %ogate_view = buffer.view %ogate_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %oup_view = buffer.view %oup_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %g0, %g1, %g2, %g3, %u0, %u1, %u2, %u3 = scf.for %kk = [%c0 to %c5120 step %c16](%ag0 = %init : vector<8xf32>, %ag1 = %init : vector<8xf32>, %ag2 = %init : vector<8xf32>, %ag3 = %init : vector<8xf32>, %au0 = %init : vector<8xf32>, %au1 = %init : vector<8xf32>, %au2 = %init : vector<8xf32>, %au3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
