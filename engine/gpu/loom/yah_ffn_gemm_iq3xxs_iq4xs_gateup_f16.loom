// YAH FFN GEMM with in-kernel mixed-format paired gate/up, Loom port of
// HalfPrefillGemmKernel<..., kIQ3_XXS, kIQ4_XS, kGateUp>.
//
// HIP source: prefill_fp16.hip. The gate weight is IQ3_XXS and the up weight is
// IQ4_XS; each has its own decoder, block geometry, staging buffer and
// accumulator group, plus any table operands the format needs:
//
//   gate_acc[row][token] = sum_k iq3xxs_decode(gate_w, row, k) * f16(A[token][k])
//   up_acc[row][token]   = sum_k iq4xs_decode(up_w,   row, k) * f16(A[token][k])
//   out[token*m + row]   = round_f16(silu(gate_acc) * up_acc)
//
// Mixed paired arm with per-operand grid/ksigns operands where the format needs
// them. Generated from yah_ffn_gemm_q4k_gateup_f16.loom with per-operand sizes,
// per-operand block shifts and suffixed decode constants.
//
// Measured: 28.53 ms at m_tiles=1088 (production 17408 rows). Both decoders,
// any table lookups and the combine are untuned.
//
// Correctness case: the gate fixture is the packed IQ3_XXS input, the up
// fixture the packed IQ4_XS input, and the activation is 0.0625. Expected is
// round_f16(silu(gate_acc) * up_acc). The production-size case uses all-zero
// weights, so every output is zero.
//
// Required config (correctness): --config=yah_ffn_gemm_iq3xxs_iq4xs_gateup.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_iq3xxs_iq4xs_gateup.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_iq3xxs_iq4xs_gateup.m_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_iq3xxs_iq4xs_gateup() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_iq3xxs_iq4xs_gateup.m_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%gate_weight: buffer, %gate_grid: buffer, %gate_ksigns: buffer, %up_weight: buffer, %input: buffer, %gwstage: buffer, %uwstage: buffer, %ogate: buffer, %oup: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c127 = index.constant 127 : index
  %c255 = index.constant 255 : index
  %c511 = index.constant 511 : index
  %c1023 = index.constant 1023 : index
  %c2047 = index.constant 2047 : index
  %c5120 = index.constant 5120 : index
  %c2880 = index.constant 2880 : index
  %c23040 = index.constant 23040 : index
  %c46080 = index.constant 46080 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c255i = scalar.constant 255 : i32
