  %gate_grid = check.file.read.npy path("fixtures/iq3xxs_gemm/grid.npy") : tensor<256xi32>
  %gate_ksigns = check.file.read.npy path("fixtures/iq3xxs_gemm/ksigns.npy") : tensor<128xi8>
  %up_weight = check.file.read.npy path("fixtures/iq4xs_gemm/input_iq4xs_gemm.npy") : tensor<43520xi8>
  kernel.launch @yah_ffn_gemm_iq3xxs_iq4xs_gateup(%gate_weight, %gate_grid, %gate_ksigns, %up_weight, %input, %gwstage, %uwstage, %ogate, %oup, %output) : (tensor<31360xi8>, tensor<256xi32>, tensor<128xi8>, tensor<43520xi8>, tensor<64x5120xf16>, tensor<81920xf16>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf32>, tensor<1024xf16>)
