      %j_i_g = index.cast %j_g : index to i32
      %j32_g = scalar.shli %j_i_g, %c5i_g : i32
      %e_i_g = scalar.addi %lane_i, %j32_g : i32
      %r_i_g = scalar.shrui %e_i_g, %c4i_g : i32
      %c_i_g = scalar.andi %e_i_g, %c15i_g : i32
      %i_i_g = scalar.addi %kbase, %c_i_g : i32
