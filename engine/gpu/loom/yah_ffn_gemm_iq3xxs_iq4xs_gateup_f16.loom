      %nib1_u = scalar.andi %nib1s_u, %c1i_u : i32
      %t1_u = scalar.cmpi eq, %nib1_u, %c1i_u : i32
      %nib2s_u = scalar.shrui %nib_u, %c2i_u : i32
      %nib2_u = scalar.andi %nib2s_u, %c1i_u : i32
      %t2_u = scalar.cmpi eq, %nib2_u, %c1i_u : i32
      %nib3s_u = scalar.shrui %nib_u, %c3i_u : i32
      %nib3_u = scalar.andi %nib3s_u, %c1i_u : i32
