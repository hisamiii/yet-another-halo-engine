      %j32_u = scalar.shli %j_i_u, %c5i_u : i32
      %e_i_u = scalar.addi %lane_i, %j32_u : i32
      %r_i_u = scalar.shrui %e_i_u, %c4i_u : i32
      %c_i_u = scalar.andi %e_i_u, %c15i_u : i32
      %i_i_u = scalar.addi %kbase, %c_i_u : i32
      %group_u = scalar.shrui %i_i_u, %c5i_u : i32
      %within_u = scalar.andi %i_i_u, %c31i_u : i32
      %l_i_u = scalar.andi %within_u, %c15i_u : i32
      %high_u = scalar.shrui %within_u, %c4i_u : i32
      %row_i_u = scalar.addi %m_origin_i, %r_i_u : i32
      %row_off_u = scalar.muli %row_i_u, %c2880i_u : i32
      %blk_off0_u = scalar.muli %kblk_u, %c144i_u : i32
      %blk_off_u = scalar.addi %row_off_u, %blk_off0_u : i32
      %g16_u = scalar.shli %group_u, %c4i_u : i32
      %qs0_u = scalar.addi %blk_off_u, %c8i_u : i32
      %qs1_u = scalar.addi %qs0_u, %g16_u : i32
      %qs2_u = scalar.addi %qs1_u, %l_i_u : i32
