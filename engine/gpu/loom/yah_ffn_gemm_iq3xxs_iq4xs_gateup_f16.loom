      %aux1_lo_g = index.max %aux1_ix_g, %c0 : index
      %aux1_idx_g = index.min %aux1_lo_g, %gw_last : index
      %aux2_ix_g = index.cast %aux2_i_g : i32 to index
      %aux2_lo_g = index.max %aux2_ix_g, %c0 : index
      %aux2_idx_g = index.min %aux2_lo_g, %gw_last : index
      %aux3_ix_g = index.cast %aux3_i_g : i32 to index
      %aux3_lo_g = index.max %aux3_ix_g, %c0 : index
      %aux3_idx_g = index.min %aux3_lo_g, %gw_last : index
