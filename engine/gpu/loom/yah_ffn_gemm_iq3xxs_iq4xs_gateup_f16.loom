      %qs_lo_u = index.max %qs_ix_u, %c0 : index
      %qs_idx_u = index.min %qs_lo_u, %uw_last : index
      %qb8_u = view.load %uw_view[%qs_idx_u] : view<[%uw_bytes]xi8> -> i8
      %qb_u = scalar.extui %qb8_u : i8 to i32
      %nib_lo_u = scalar.andi %qb_u, %c15i_u : i32
      %nib_hi_u = scalar.shrui %qb_u, %c4i_u : i32
