  %c1i_g = scalar.constant 1 : i32
  %c2i_g = scalar.constant 2 : i32
  %c3i_g = scalar.constant 3 : i32
  %c4i_g = scalar.constant 4 : i32
  %c5i_g = scalar.constant 5 : i32
  %c6i_g = scalar.constant 6 : i32
  %c7i_g = scalar.constant 7 : i32
  %c8i_g = scalar.constant 8 : i32
  %c15i_g = scalar.constant 15 : i32
  %c16i_g = scalar.constant 16 : i32
