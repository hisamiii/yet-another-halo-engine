      %sid0_g = scalar.shrui %aux32_g, %l7_g : i32
      %sid7_g = scalar.andi %sid0_g, %c127i_g : i32
      %sid_ix_g = index.cast %sid7_g : i32 to index
      %ks_g = view.load %gate_ksigns_view[%sid_ix_g] : view<128xi8> -> i8
      %signs_g = scalar.extui %ks_g : i8 to i32
