// YAH FFN GEMM with in-kernel IQ3_XXS decode and the residual epilogue, Loom port
// of HalfPrefillGemmKernel<..., kIQ3_XXS, kResidual>.
//
// HIP source: prefill_fp16.hip. Identical to yah_ffn_gemm_iq3xxs_f32 except for the
// epilogue, which adds the accumulator into the existing f32 residual rows in
// place:
//
//   y[token*m + row] += iq3xxs_decode(W, row, k) * f16(A[token][k])
//
// This is the down-projection arm (LaunchBatchedQuantGEMMResidualFp16). 1 FFN
// down block(s) in the shard use this format. The decoder, the K loop, the operand
// list and the two global staging buffers are unchanged from the store arm.
//
// Measured: 18.11 ms at m_tiles=1088 (production 17408 rows), against the HIP
// Q4_K kernel at 1.197 ms and the Q4_K port at 23.31 ms. 0.790 ms at m_tiles=1.
// The decoder, K loop and staging are identical to yah_ffn_gemm_iq3xxs_f32; only
// the store epilogue changes.
//
// Correctness case: the same packed fixture and unit activation as the store arm,
// with the output initialised to 1000, so the expected value is 1000 + row sum.
// The production-size case uses an all-zero weight, which decodes to zero and
// leaves the residual buffer unchanged.
//
// Required config (correctness): --config=yah_ffn_gemm_iq3xxs_residual.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_iq3xxs_residual.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_iq3xxs_residual.m_tiles : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_iq3xxs_residual.k_blocks : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_iq3xxs_residual.token_tiles : %value: index where [range(%value, 1, 4096)]
config.def @yah_ffn_gemm_iq3xxs_residual.k_split = 1 : index
config.def @yah_ffn_gemm_iq3xxs_residual.accum = 1 : index

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_iq3xxs_residual() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_iq3xxs_residual.m_tiles : index
  %token_tiles = config.get @yah_ffn_gemm_iq3xxs_residual.token_tiles : index
  %k_split = config.get @yah_ffn_gemm_iq3xxs_residual.k_split : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %token_tiles, %k_split) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %grid: buffer, %ksigns: buffer, %input: buffer, %wstage: buffer, %ostage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lds_bytes = index.constant 512 : offset
  %wstage_lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %wstage_lds_view = buffer.view %wstage_lds[%base] : buffer -> view<16x16xf16>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %c127 = index.constant 127 : index
  %c511 = index.constant 511 : index
  %c5120 = index.constant 5120 : index
  %c15680 = index.constant 15680 : index
  %c31360 = index.constant 31360 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c7i = scalar.constant 7 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c24i = scalar.constant 24 : i32
  %c28i = scalar.constant 28 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c66i = scalar.constant 66 : i32
  %c98i = scalar.constant 98 : i32
  %c127i = scalar.constant 127 : i32
  %c255i = scalar.constant 255 : i32
  %c1960i = scalar.constant 1960 : i32
  %fhalf = scalar.constant 0.5 : f32
  %m_tiles = config.get @yah_ffn_gemm_iq3xxs_residual.m_tiles : index
  %k_blocks = config.get @yah_ffn_gemm_iq3xxs_residual.k_blocks : index
  %token_tiles = config.get @yah_ffn_gemm_iq3xxs_residual.token_tiles : index
  %cbb = index.constant 98 : index
  %cbb2 = index.constant 49 : index
  %ktot = index.mul %k_blocks, %c256 : index
  %tokens = index.mul %token_tiles, %c64 : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %bpr = index.mul %k_blocks, %cbb : index
  %hpr = index.mul %k_blocks, %cbb2 : index
  %w_bytes = index.mul %m_rows, %bpr : index
  %w_halfs = index.mul %m_rows, %hpr : index
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %out_total = index.mul %m_rows, %tokens : index
  %k_split = config.get @yah_ffn_gemm_iq3xxs_residual.k_split : index
  %split = kernel.workgroup.id<z> : index
  %accum = config.get @yah_ffn_gemm_iq3xxs_residual.accum : index
  %k_count = index.div %k_blocks, %k_split : index
  %kc_elems = index.mul %k_count, %c256 : index
  %k_off = index.mul %split, %kc_elems : index
  %k_end = index.add %k_off, %kc_elems : index
  %ktot_m16 = index.sub %ktot, %c16 : index
  %split_base = index.mul %split, %out_total : index
  %out_total_split = index.mul %out_total, %k_split : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %split_rows = index.mul %split, %stage_rows : index
  %stage_rows_split = index.mul %stage_rows, %k_split : index
  %a_layout = encoding.layout.strided [%c1, %ktot] : encoding<layout>
  %weight_na, %grid_na, %ksigns_na, %input_na, %wstage_na, %ostage_na, %output_na = buffer.assume.noalias %weight, %grid, %ksigns, %input, %wstage, %ostage, %output : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %wg_y = kernel.workgroup.id<y> : index
  %token_base = index.mul %wg_y, %c64 : index
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<[%ktot]x[%tokens]xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total_split]xf32>
  %grid_view = buffer.view %grid_na[%base] : buffer -> view<256xi32>
  %ksigns_view = buffer.view %ksigns_na[%base] : buffer -> view<128xi8>
  %ostage_view = buffer.view %ostage_na[%base] : buffer -> view<[%stage_rows_split]x[%tokens]xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %m_origin_s = index.add %m_origin, %split_rows : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %k_blocks_i = index.cast %k_blocks : index to i32
  %bpr_i = scalar.muli %k_blocks_i, %c98i : i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc0, %acc1, %acc2, %acc3 = scf.for %kk = [%k_off to %k_end step %c16](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_ld = index.min %kk, %ktot_m16 : index
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32
    %c_i = scalar.andi %lane_i, %c15i : i32
    %i_i = scalar.addi %kbase, %c_i : i32
    %blk_off0 = scalar.muli %kblk, %c98i : i32
    %group = scalar.shrui %i_i, %c5i : i32
    %half0 = scalar.shrui %i_i, %c4i : i32
    %half = scalar.andi %half0, %c1i : i32
    %jj = scalar.andi %i_i, %c15i : i32
    %q = scalar.shrui %jj, %c3i : i32
    %which0 = scalar.shrui %jj, %c2i : i32
    %which = scalar.andi %which0, %c1i : i32
    %b = scalar.andi %jj, %c3i : i32
    %l2 = scalar.shli %half, %c1i : i32
    %l = scalar.addi %l2, %q : i32
    %l2x = scalar.shli %l, %c1i : i32
    %lw = scalar.addi %l2x, %which : i32
    %g8 = scalar.shli %group, %c3i : i32
    %g_shift = scalar.shli %b, %c3i : i32
    %ag4 = scalar.shli %group, %c2i : i32
    %l7 = scalar.muli %l, %c7i : i32
    %is_g1 = scalar.cmpi eq, %which, %c0i : i32
    %c_ix = index.cast %c_i : i32 to index
    %c_idx = index.max %c_ix, %c0 : index
    %j_sink = scf.for %j = [%c0 to %c8 step %c1](%mk = %c0 : index) -> (index) unroll(%c2) schedule(interleaved) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %e_i = scalar.addi %lane_i, %j32 : i32
      %r_i = scalar.shrui %e_i, %c4i : i32
      %row_i = scalar.addi %m_origin_i, %r_i : i32
      %row_off = scalar.muli %row_i, %bpr_i : i32
      %blk_off = scalar.addi %row_off, %blk_off0 : i32
      %qso = scalar.addi %blk_off, %c2i : i32
      %g8a = scalar.addi %qso, %g8 : i32
      %gix_i = scalar.addi %g8a, %lw : i32
      %gix_ix = index.cast %gix_i : i32 to index
      %gix_lo = index.max %gix_ix, %c0 : index
      %gix = index.min %gix_lo, %w_last : index
      %qsb8 = view.load %w_view[%gix] : view<[%w_bytes]xi8> -> i8
      %grid_lo = scalar.extui %qsb8 : i8 to i32
      %gidx_ix = index.cast %grid_lo : i32 to index
      %gidx_lo = index.max %gidx_ix, %c0 : index
      %gidx = index.min %gidx_lo, %c255 : index
      %gword = view.load %grid_view[%gidx] : view<256xi32> -> i32
      %gb0 = scalar.shrui %gword, %g_shift : i32
      %g_byte = scalar.andi %gb0, %c255i : i32
      %auxb = scalar.addi %blk_off, %c66i : i32
      %aux0_i = scalar.addi %auxb, %ag4 : i32
      %aux1_i = scalar.addi %aux0_i, %c1i : i32
      %aux2_i = scalar.addi %aux0_i, %c2i : i32
      %aux3_i = scalar.addi %aux0_i, %c3i : i32
      %aux0_ix = index.cast %aux0_i : i32 to index
      %aux0_lo = index.max %aux0_ix, %c0 : index
      %aux0_idx = index.min %aux0_lo, %w_last : index
      %aux1_ix = index.cast %aux1_i : i32 to index
      %aux1_lo = index.max %aux1_ix, %c0 : index
      %aux1_idx = index.min %aux1_lo, %w_last : index
      %aux2_ix = index.cast %aux2_i : i32 to index
      %aux2_lo = index.max %aux2_ix, %c0 : index
      %aux2_idx = index.min %aux2_lo, %w_last : index
      %aux3_ix = index.cast %aux3_i : i32 to index
      %aux3_lo = index.max %aux3_ix, %c0 : index
      %aux3_idx = index.min %aux3_lo, %w_last : index
      %ab0 = view.load %w_view[%aux0_idx] : view<[%w_bytes]xi8> -> i8
      %ab1 = view.load %w_view[%aux1_idx] : view<[%w_bytes]xi8> -> i8
      %ab2 = view.load %w_view[%aux2_idx] : view<[%w_bytes]xi8> -> i8
      %ab3 = view.load %w_view[%aux3_idx] : view<[%w_bytes]xi8> -> i8
      %a0 = scalar.extui %ab0 : i8 to i32
      %a1 = scalar.extui %ab1 : i8 to i32
      %a2 = scalar.extui %ab2 : i8 to i32
      %a3 = scalar.extui %ab3 : i8 to i32
      %as1 = scalar.shli %a1, %c8i : i32
      %as2 = scalar.shli %a2, %c16i : i32
      %as3 = scalar.shli %a3, %c24i : i32
      %ao1 = scalar.ori %a0, %as1 : i32
      %ao2 = scalar.ori %ao1, %as2 : i32
      %aux32 = scalar.ori %ao2, %as3 : i32
      %sid0 = scalar.shrui %aux32, %l7 : i32
      %sid7 = scalar.andi %sid0, %c127i : i32
      %sid_ix = index.cast %sid7 : i32 to index
      %ks = view.load %ksigns_view[%sid_ix] : view<128xi8> -> i8
      %signs = scalar.extui %ks : i8 to i32
      %sign_nib = scf.if %is_g1 -> (i32) {
        %sn_lo = scalar.andi %signs, %c15i : i32
        scf.yield %sn_lo : i32
      } else {
        %sn_hi = scalar.shrui %signs, %c4i : i32
        scf.yield %sn_hi : i32
      }
      %sbit0 = scalar.shrui %sign_nib, %b : i32
      %sign_bit = scalar.andi %sbit0, %c1i : i32
      %is_neg = scalar.cmpi eq, %sign_bit, %c1i : i32
      %neg_g = scalar.subi %c0i, %g_byte : i32
      %mag = scf.if %is_neg -> (i32) {
        scf.yield %neg_g : i32
      } else {
        scf.yield %g_byte : i32
      }
      %n4 = scalar.shrui %aux32, %c28i : i32
      %n4_f = scalar.sitofp %n4 : i32 to f32
      %hp = scalar.addf %n4_f, %fhalf : f32
      %hp2 = scalar.mulf %hp, %fhalf : f32
      %mag_f = scalar.sitofp %mag : i32 to f32
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %scale_f = scalar.mulf %d, %hp2 : f32
      %value = scalar.mulf %scale_f, %mag_f : f32
      %h = scalar.fptrunc %value : f32 to f16
      %row_local = index.cast %r_i : i32 to index
      view.store %h, %wstage_lds_view[%row_local, %c_idx] : f16, view<16x16xf16>
      scf.yield %mk : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhs = vector.fragment.load<lhs> %wstage_lds_view[%c0, %c0] shape [%m, %k] : view<16x16xf16> -> vector<16xf16>
    %t16 = index.add %token_base, %c16 : index
    %t32 = index.add %token_base, %c32 : index
    %t48 = index.add %token_base, %c48 : index
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk_ld, %token_base] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk_ld, %t16] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk_ld, %t32] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk_ld, %t48] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %n0 = vector.mma %lhs, %rhs0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n1 = vector.mma %lhs, %rhs1, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n2 = vector.mma %lhs, %rhs2, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n3 = vector.mma %lhs, %rhs3, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %n0, %n1, %n2, %n3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %o16 = index.add %token_base, %c16 : index
  %o32 = index.add %token_base, %c32 : index
  %o48 = index.add %token_base, %c48 : index
  vector.fragment.store<result> %acc0, %ostage_view[%m_origin_s, %token_base] shape [%m, %n] : vector<8xf32>, view<[%stage_rows_split]x[%tokens]xf32>
  vector.fragment.store<result> %acc1, %ostage_view[%m_origin_s, %o16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows_split]x[%tokens]xf32>
  vector.fragment.store<result> %acc2, %ostage_view[%m_origin_s, %o32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows_split]x[%tokens]xf32>
  vector.fragment.store<result> %acc3, %ostage_view[%m_origin_s, %o48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows_split]x[%tokens]xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %tok_g = index.add %token_base, %tok : index
    %gr2_s = index.add %gr2, %split_rows : index
    %val = view.load %ostage_view[%gr2_s, %tok_g] : view<[%stage_rows_split]x[%tokens]xf32> -> f32
    %tok_off = index.mul %tok_g, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    %gflat_abs = index.add %gflat, %split_base : index
    %res = view.load %out_view[%gflat_abs] : view<[%out_total_split]xf32> -> f32
    %sum_acc = scalar.addf %res, %val : f32
    %is_acc = index.cmp eq, %accum, %c1 : index
    %sum = scf.if %is_acc -> (f32) {
      scf.yield %sum_acc : f32
    } else {
      scf.yield %val : f32
    }
    view.store %sum, %out_view[%gflat_abs] : f32, view<[%out_total_split]xf32>
    scf.yield %mk2 : index
  }
  kernel.return
}

// Requires --config=yah_ffn_gemm_iq3xxs_residual.m_tiles=1.
check.case public @yah_ffn_gemm_iq3xxs_residual_case {
  %weight = check.file.read.npy path("fixtures/iq3xxs_gemm/input_iq3xxs_gemm.npy") : tensor<31360xi8>
  %grid = check.file.read.npy path("fixtures/iq3xxs_gemm/grid.npy") : tensor<256xi32>
  %ksigns = check.file.read.npy path("fixtures/iq3xxs_gemm/ksigns.npy") : tensor<128xi8>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(1000.0) : tensor<1024xf32>
  %expected = check.file.read.npy path("fixtures/iq3xxs_gemm/expected_residual.npy") : tensor<1024xf32>
  %wstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ostage = check.generate.fill value(1000.0) : tensor<1024xf32>
  kernel.launch @yah_ffn_gemm_iq3xxs_residual(%weight, %grid, %ksigns, %input, %wstage, %ostage, %output) : (tensor<31360xi8>, tensor<256xi32>, tensor<128xi8>, tensor<64x5120xf16>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf32>)
  check.expect.close actual(%output) expected(%expected) atol(1e-5) rtol(1e-5) nan(same) : tensor<1024xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_iq3xxs_residual_case> @yah_ffn_gemm_iq3xxs_residual_bench

// Requires --config=yah_ffn_gemm_iq3xxs_residual.m_tiles=1088. An all-zero IQ3_XXS weight
// decodes to zero (d = 0), so every output must be exactly 0.
check.case public @yah_ffn_gemm_iq3xxs_residual_full_case {
  %weight = check.generate.fill value(0) : tensor<34119680xi8>
  %grid = check.generate.fill value(0) : tensor<256xi32>
  %ksigns = check.generate.fill value(0) : tensor<128xi8>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1114112xf32>
  %expected = check.generate.fill value(0.0) : tensor<1114112xf32>
