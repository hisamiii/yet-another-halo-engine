// YAH FFN GEMM in Loom: out[t][m] = sum_k W[m][k] * A[t][k], token-major as
// the HIP kernel stores it (y[token*m + row]). A layout fix landed with the
// parity check below: the earlier version wrote out[row][token] through a
// default row-major view, which the all-ones correctness case could not see
// because a constant is its own transpose.
//
// v3. v2 collapsed the token axis into one workgroup (M16 x N64) so the weight
// tensor is read exactly once, taking v1's 5.979 ms to 3.000 ms (2.00x,
// correctness passing in both). v2's remaining problem was that every WMMA
// operand came straight from global memory with nothing pipelined across K
// steps: 320 sequential iterations each exposed a whole memory latency, which
// works out to about one WMMA per 121 cycles per CU. At 178 MB of weight
// traffic over 3.000 ms v2 ran at 59 GB/s, so it was latency-bound and not
// bandwidth-bound.
//
// This version keeps the arithmetic and tile identical and changes only the loop
// schedule. pipeline(%depth) is ordinary read-ahead: it moves the global operand
// loads ahead of the ordered consumer while the MMAs against the carried
// accumulator stay in source order. The schedule is config-driven so the sweep
// needs no source edit, as the Loom loop schedule workflow describes.
//
// Measured on gfx1151, iree-benchmark-loom --measure=dispatch_complete, 5 timed
// batches after 2 warmups, serially in one session, correctness passing in all
// four arms:
//
//   depth.unroll  vector VGPR   time      TFLOP/s
//   1.1 (v2)          80        2.895 ms    3.940    matched serial control
//   2.2               -         2.501 ms    4.562
//   3.2              200        1.819 ms    6.271    row-major store; since corrected
//   4.2              240        1.918 ms    5.949
//
// The sweep above predates the output-layout fix described at the top of this
// file. The depth-3 arm re-measured at 1.83-1.90 ms / 6.0-6.2 TFLOP/s once the result
// went token-major, so the corrected store costs about 5% here. That is the
// faithful layout; the previous number is kept because it bounds the cost.
//
// So read-ahead is worth 1.59x over the serial control, and depth four regresses:
// the queue costs vector registers (80 -> 200 -> 240), which directly costs
// resident warps, and past depth three the occupancy loss overtakes the overlap
// gained. Zero spills at every depth. Against our tuned HIP kernel at the same
// fp16 precision (1.353 ms, 8.43 TFLOP/s) this leaves a 1.34x gap, down from
// 4.4x for v1.
//
// The activation operand is token-major ([t][k]), so the rhs operand is a
// *strided view* of it as [k][t] (encoding.layout.strided [1, 5120]) rather than
// a transposed copy.
//
// Correctness case, layout-sensitive form (the same check appears at the bottom
// of this file). The weight varies with output-row parity, so even rows sum to
// 13104640 and odd rows to 39319040; the expected value is an iota of period 2
// over the flat token-major index. Reverting the result view to row-major fails
// the case, which was checked with a probe copy. The original all-ones case could
// not see that transposition, because a constant is its own transpose; it pinned
// the K reduction and the operand indexing but never the output layout.
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_f16.m_tiles : %value: index where [range(%value, 1, 4096)]

config.def @yah_ffn_gemm_f16.depth = 3 : index

config.def @yah_ffn_gemm_f16.unroll = 2 : index

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_f16() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_f16.m_tiles : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%weight: buffer, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c5120 = index.constant 5120 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index

  // Activation viewed [k][t]: element (k,t) is A[t][k] = base + t*5120 + k.
  %a_layout = encoding.layout.strided [1, 5120] : encoding<layout>
  // HIP stores its result token-major, y[token*m + row], for coalesced
  // stores. A default row-major view would write out[row][token] instead,
  // which is a different layout from the HIP kernel. The strided layout
  // gives element (row,token) the address token*17408 + row without a
  // transposed register copy.
  %out_layout = encoding.layout.strided [1, 17408] : encoding<layout>

  %weight_noalias, %input_noalias, %output_noalias = buffer.assume.noalias %weight, %input, %output : buffer, buffer, buffer
  %w_view = buffer.view %weight_noalias[%base] : buffer -> view<17408x5120xf16>
  %a_t_view = buffer.view %input_noalias[%base] : buffer -> view<5120x64xf16, %a_layout>
  %out_view = buffer.view %output_noalias[%base] : buffer -> view<17408x64xf32, %out_layout>

  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index

  %depth = config.get @yah_ffn_gemm_f16.depth : index
  %factor = config.get @yah_ffn_gemm_f16.unroll : index

  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc0, %acc1, %acc2, %acc3 = scf.for %kk = [%c0 to %c5120 step %c16](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) pipeline(%depth) unroll(%factor) schedule(recurrence) {
    %lhs = vector.fragment.load<lhs> %w_view[%m_origin, %kk] shape [%m, %k] : view<17408x5120xf16> -> vector<16xf16>
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %c0] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %c16] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %c32] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %c48] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %n0 = vector.mma %lhs, %rhs0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n1 = vector.mma %lhs, %rhs1, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n2 = vector.mma %lhs, %rhs2, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n3 = vector.mma %lhs, %rhs3, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %n0, %n1, %n2, %n3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  vector.fragment.store<result> %acc0, %out_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<17408x64xf32, %out_layout>
  vector.fragment.store<result> %acc1, %out_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<17408x64xf32, %out_layout>
  vector.fragment.store<result> %acc2, %out_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<17408x64xf32, %out_layout>
  vector.fragment.store<result> %acc3, %out_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<17408x64xf32, %out_layout>
  kernel.return
}

check.case public @yah_ffn_gemm_f16_case {
  // Layout-sensitive: the weight varies with output-row parity and the input
  // is uniform, so the result is not constant along the row axis and the
  // expected value depends on the parity of the flat output index.
  //
  //   weight[row][k] = (row*5120 + k) mod 10240 = 5120*(row mod 2) + k
  //   input[t][k]    = 1
  //   out[row][t]    = sum_k round_f16(weight[row][k])
  //                  = 13104640 for even rows, 39319040 for odd rows
  //
  // HIP stores token-major, out_flat[token*m + row], so the flat index i maps
  // to row = i mod 17408 and the expected is an iota of period 2. A row-major
  // store would place row = i / 64 instead, and element 1 would read
  // 13104640 where 39319040 is required. Both sums are exact in f32.
  %weight = check.generate.iota offset(0.0) step(1.0) period(10240) : tensor<17408x5120xf16>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<17408x64xf32>
  %expected = check.generate.iota offset(13104640.0) step(26214400.0) period(2) : tensor<17408x64xf32>
  kernel.launch @yah_ffn_gemm_f16(%weight, %input, %output) : (tensor<17408x5120xf16>, tensor<64x5120xf16>, tensor<17408x64xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<17408x64xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_f16_case> @yah_ffn_gemm_f16_bench
