// YAH KV cache unpack from q8, Loom port of DequantizeQ8Kernel.
//
// HIP source: engine/kv/kv_quant.hip. One work-item owns one 34-byte KvQ8Block
// (engine/kv/kv_cache.hpp) and writes 32 f16 values:
//
//   scale = f32(u16 d)                              little endian f16 bits
//   out[i] = f16(scale * f32(i8 qs[i]))
//
// The scale crosses f16 on the way back: d is an f16 on the wire, so widening it
// is exact, but the product is rounded to f16 on write. The check is exact because
// the fixture replicates that same rounding.
//
// Required configs, one per case:
//
//   @yah_kvq8_dequant_varied   blocks=4     (4 x 34 i8 in, 4 x 32 f16 out)
//   @yah_kvq8_dequant_uniform  blocks=10240 (348160 i8 in, 327680 f16 out)
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_kvq8_dequant.blocks : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@yah_wave32) @yah_kvq8_dequant() {
  %unit = index.constant 1 : index
  %blocks = config.get @yah_kvq8_dequant.blocks : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %blocks, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c32 = index.constant 32 : index
  %c34 = index.constant 34 : index
  %c256 = index.constant 256 : index
  %c8i16 = scalar.constant 8 : i16
  %blocks = config.get @yah_kvq8_dequant.blocks : index
  %src_bytes = index.mul %blocks, %c34 : index
  %total = index.mul %blocks, %c32 : index
  %src_noalias = buffer.assume.noalias %src : buffer
  %dst_noalias = buffer.assume.noalias %dst : buffer
  %src_view = buffer.view %src_noalias[%base] : buffer -> view<[%src_bytes]xi8>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%total]xf16>
  %lane = kernel.workitem.id<x> : index
  %wg = kernel.workgroup.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %blk = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %blk, %blocks : index
  scf.if %in_range {
    %src_base = index.mul %blk, %c34 : index
    %dst_base = index.mul %blk, %c32 : index
    // d at bytes 0..1, little endian.
    %d_lo_off = index.add %src_base, %c0 : index
    %d_hi_off = index.add %src_base, %c1 : index
    %d_lo8 = view.load %src_view[%d_lo_off] : view<[%src_bytes]xi8> -> i8
    %d_hi8 = view.load %src_view[%d_hi_off] : view<[%src_bytes]xi8> -> i8
    %d_lo = scalar.extui %d_lo8 : i8 to i16
    %d_hi = scalar.extui %d_hi8 : i8 to i16
    %d_hi_shifted = scalar.shli %d_hi, %c8i16 : i16
    %d_bits = scalar.ori %d_lo, %d_hi_shifted : i16
    %d_half = scalar.bitcast %d_bits : i16 to f16
    %scale = scalar.extf %d_half : f16 to f32
    %codes_base = index.add %src_base, %c2 : index
    %scale_sink = scf.for %j = [%c0 to %c32 step %c1](%t = %scale : f32) -> (f32) {
      %code_off = index.add %codes_base, %j : index
      %code8 = view.load %src_view[%code_off] : view<[%src_bytes]xi8> -> i8
      %code = scalar.sitofp %code8 : i8 to f32
      %product = scalar.mulf %scale, %code : f32
      %out = scalar.fptrunc %product : f32 to f16
      %out_off = index.add %dst_base, %j : index
      view.store %out, %dst_view[%out_off] : f16, view<[%total]xf16>
      scf.yield %t : f32
    }
  }
  kernel.return
}

// Requires --config=yah_kvq8_dequant.blocks=4. Reads the packed bytes the q8 pack
// case produces, so a packer/unpacker disagreement about the layout shows up here.
check.case public @yah_kvq8_dequant_varied {
  %src = check.file.read.npy path("fixtures/kv_quant_q8/expected_varied.npy") : tensor<136xi8>
  %expected = check.file.read.npy path("fixtures/kv_quant_q8/dequant_varied_expected.npy") : tensor<128xf16>
  %dst = check.generate.fill value(0.0) : tensor<128xf16>
  kernel.launch @yah_kvq8_dequant(%src, %dst) : (tensor<136xi8>, tensor<128xf16>)
  check.expect.close actual(%dst) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<128xf16>
  check.return
}

check.benchmark<@yah_kvq8_dequant_varied> @yah_kvq8_dequant_varied_bench

// Requires --config=yah_kvq8_dequant.blocks=10240. The real shape.
check.case public @yah_kvq8_dequant_uniform {
  %src = check.file.read.npy path("fixtures/kv_quant_q8/expected_uniform.npy") : tensor<348160xi8>
  %expected = check.file.read.npy path("fixtures/kv_quant_q8/dequant_uniform_expected.npy") : tensor<327680xf16>
  %dst = check.generate.fill value(0.0) : tensor<327680xf16>
  kernel.launch @yah_kvq8_dequant(%src, %dst) : (tensor<348160xi8>, tensor<327680xf16>)
  check.expect.close actual(%dst) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<327680xf16>
  check.return
}

check.benchmark<@yah_kvq8_dequant_uniform> @yah_kvq8_dequant_uniform_bench
