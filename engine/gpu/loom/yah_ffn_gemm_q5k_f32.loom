// YAH FFN GEMM with in-kernel Q5_K weight decode, Loom port of
// HalfPrefillGemmKernel<..., kQ5_K, kStore>.
//
// HIP source: prefill_fp16.hip. Identical to yah_ffn_gemm_q4k_f32 except for the
// packed format. block_q5_K is 176 bytes:
//
//   __half d; __half dmin; uint8 scales[12]; uint8 qh[32]; uint8 qs[128]
//
// and element i of the 256-wide block is the Q4_K element with a fifth bit from
// the qh plane:
//
//   quant = quant4 + ((qh[lane] >> (2*gg + (low ? 0 : 1))) & 1) * 16   (0..31)
//   value = f32(d) * sc * quant - f32(dmin) * m
//
// The scale/min pair index sis is the same expression as the qh bit index, so the
// port reuses %sis for the shift. The Q5_K decoder itself is the one
// yah_dequant_q5k_bf16 validates; the K loop, staging and epilogue are the Q4_K
// GEMM. The mixed Unsloth dynamic Q4_K shard carries Q5_K tensors, so this is a
// production format, not a test-only one.
//
// Required config (correctness): --config=yah_ffn_gemm_q5k.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_q5k.m_tiles=1088
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_q5k.m_tiles : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_q5k.k_blocks : %value: index where [range(%value, 1, 4096)]
config.decl @yah_ffn_gemm_q5k.token_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_q5k() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_q5k.m_tiles : index
  %token_tiles = config.get @yah_ffn_gemm_q5k.token_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %token_tiles, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %input: buffer, %wstage: buffer, %ostage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lds_bytes = index.constant 512 : offset
  %wstage_lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %wstage_lds_view = buffer.view %wstage_lds[%base] : buffer -> view<16x16xf16>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c72 = index.constant 88 : index
  %c144 = index.constant 176 : index
  %c256 = index.constant 256 : index
  %c5120 = index.constant 5120 : index
  %c2880 = index.constant 3520 : index
  %c23040 = index.constant 28160 : index
  %c46080 = index.constant 56320 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c48i = scalar.constant 48 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c255i = scalar.constant 255 : i32
  %c144i = scalar.constant 176 : i32
  %c2880i = scalar.constant 3520 : i32
  %m_tiles = config.get @yah_ffn_gemm_q5k.m_tiles : index
  %k_blocks = config.get @yah_ffn_gemm_q5k.k_blocks : index
  %token_tiles = config.get @yah_ffn_gemm_q5k.token_tiles : index
  %ktot = index.mul %k_blocks, %c256 : index
  %tokens = index.mul %token_tiles, %c64 : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %bpr = index.mul %k_blocks, %c144 : index
  %hpr = index.mul %k_blocks, %c72 : index
  %w_bytes = index.mul %m_rows, %bpr : index
  %w_halfs = index.mul %m_rows, %hpr : index
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %out_total = index.mul %m_rows, %tokens : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [%c1, %ktot] : encoding<layout>
  %weight_na, %input_na, %wstage_na, %ostage_na, %output_na = buffer.assume.noalias %weight, %input, %wstage, %ostage, %output : buffer, buffer, buffer, buffer, buffer
  %wg_y = kernel.workgroup.id<y> : index
  %token_base = index.mul %wg_y, %c64 : index
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<[%ktot]x[%tokens]xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf32>
  %ostage_view = buffer.view %ostage_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %k_blocks_i = index.cast %k_blocks : index to i32
  %bpr_i = scalar.muli %k_blocks_i, %c144i : i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc0, %acc1, %acc2, %acc3 = scf.for %kk = [%c0 to %ktot step %c16](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32
    %c_i = scalar.andi %lane_i, %c15i : i32
    %i_i = scalar.addi %kbase, %c_i : i32
    %gg_i = scalar.shrui %i_i, %c6i : i32
    %wv_i = scalar.andi %i_i, %c63i : i32
    %lane_dec = scalar.andi %wv_i, %c31i : i32
    %wv_hi = scalar.shrui %wv_i, %c5i : i32
    %is_low = scalar.cmpi slt, %wv_i, %c32i : i32
    %blk_off0 = scalar.muli %kblk, %c144i : i32
    %gg32 = scalar.shli %gg_i, %c5i : i32
    %gg2 = scalar.shli %gg_i, %c1i : i32
    %sis = scalar.addi %gg2, %wv_hi : i32
    %sis_low = scalar.cmpi slt, %sis, %c4i : i32
    %c_ix = index.cast %c_i : i32 to index
    %c_idx = index.max %c_ix, %c0 : index
    %j_sink = scf.for %j = [%c0 to %c8 step %c1](%mk = %c0 : index) -> (index) unroll(%c2) schedule(interleaved) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %e_i = scalar.addi %lane_i, %j32 : i32
      %r_i = scalar.shrui %e_i, %c4i : i32
      %row_i = scalar.addi %m_origin_i, %r_i : i32
      %row_off = scalar.muli %row_i, %bpr_i : i32
      %blk_off = scalar.addi %row_off, %blk_off0 : i32
      %qs0 = scalar.addi %blk_off, %c48i : i32
      %qs1 = scalar.addi %qs0, %gg32 : i32
      %qs2 = scalar.addi %qs1, %lane_dec : i32
      %qs_ix = index.cast %qs2 : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %w_last : index
      %qb8 = view.load %w_view[%qs_idx] : view<[%w_bytes]xi8> -> i8
      %qb = scalar.extui %qb8 : i8 to i32
      %qb_lo = scalar.andi %qb, %c15i : i32
      %qb_hi = scalar.shrui %qb, %c4i : i32
      %quant4 = scf.if %is_low -> (i32) {
        scf.yield %qb_lo : i32
      } else {
        scf.yield %qb_hi : i32
      }
      %qh0 = scalar.addi %blk_off, %c16i : i32
      %qh_i = scalar.addi %qh0, %lane_dec : i32
      %qh_ix = index.cast %qh_i : i32 to index
      %qh_lo = index.max %qh_ix, %c0 : index
      %qh_idx = index.min %qh_lo, %w_last : index
      %qh8 = view.load %w_view[%qh_idx] : view<[%w_bytes]xi8> -> i8
      %qh = scalar.extui %qh8 : i8 to i32
      %qhv = scalar.shrui %qh, %sis : i32
      %qbit = scalar.andi %qhv, %c1i : i32
      %qhigh = scalar.muli %qbit, %c16i : i32
      %quant = scalar.addi %quant4, %qhigh : i32
      %la0 = scalar.addi %blk_off, %c4i : i32
      %la_i = scalar.addi %la0, %sis : i32
      %lb_i = scalar.addi %la_i, %c4i : i32
      %lc_i = scalar.addi %blk_off, %sis : i32
      %la_ix = index.cast %la_i : i32 to index
      %la_lo = index.max %la_ix, %c0 : index
      %la_idx = index.min %la_lo, %w_last : index
      %lb_ix = index.cast %lb_i : i32 to index
      %lb_lo = index.max %lb_ix, %c0 : index
      %lb_idx = index.min %lb_lo, %w_last : index
      %lc_ix = index.cast %lc_i : i32 to index
      %lc_lo = index.max %lc_ix, %c0 : index
      %lc_idx = index.min %lc_lo, %w_last : index
      %la8 = view.load %w_view[%la_idx] : view<[%w_bytes]xi8> -> i8
      %lb8 = view.load %w_view[%lb_idx] : view<[%w_bytes]xi8> -> i8
      %lc8 = view.load %w_view[%lc_idx] : view<[%w_bytes]xi8> -> i8
      %la = scalar.extui %la8 : i8 to i32
      %lb = scalar.extui %lb8 : i8 to i32
      %lc = scalar.extui %lc8 : i8 to i32
      %sc, %smin = scf.if %sis_low -> (i32, i32) {
        %s = scalar.andi %la, %c63i : i32
        %mv = scalar.andi %lb, %c63i : i32
        scf.yield %s, %mv : i32, i32
      } else {
        %lb_lo = scalar.andi %lb, %c15i : i32
        %lc_hi = scalar.shrui %lc, %c6i : i32
        %lc_hi4 = scalar.shli %lc_hi, %c4i : i32
        %s2 = scalar.ori %lb_lo, %lc_hi4 : i32
        %lb_hi = scalar.shrui %lb, %c4i : i32
        %la_hi = scalar.shrui %la, %c6i : i32
        %la_hi4 = scalar.shli %la_hi, %c4i : i32
        %m2 = scalar.ori %lb_hi, %la_hi4 : i32
        scf.yield %s2, %m2 : i32, i32
      }
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %w_half_last : index
      %dmin0 = scalar.addi %blk_half0, %c1i : i32
      %dmin_ix = index.cast %dmin0 : i32 to index
      %dmin_lo = index.max %dmin_ix, %c0 : index
      %dmin_idx = index.min %dmin_lo, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %dmin_half_v = view.load %w_f16_view[%dmin_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dmin = scalar.extf %dmin_half_v : f16 to f32
      %sc_f = scalar.sitofp %sc : i32 to f32
      %m_f = scalar.sitofp %smin : i32 to f32
      %q_f = scalar.sitofp %quant : i32 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %scaled = scalar.mulf %dsc, %q_f : f32
      %dm = scalar.mulf %dmin, %m_f : f32
      %value = scalar.subf %scaled, %dm : f32
      %h = scalar.fptrunc %value : f32 to f16
      %row_local = index.cast %r_i : i32 to index
      view.store %h, %wstage_lds_view[%row_local, %c_idx] : f16, view<16x16xf16>
      scf.yield %mk : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhs = vector.fragment.load<lhs> %wstage_lds_view[%c0, %c0] shape [%m, %k] : view<16x16xf16> -> vector<16xf16>
    %t16 = index.add %token_base, %c16 : index
    %t32 = index.add %token_base, %c32 : index
    %t48 = index.add %token_base, %c48 : index
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %token_base] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %t16] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %t32] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %t48] shape [%k, %n] : view<[%ktot]x[%tokens]xf16, %a_layout> -> vector<16xf16>
    %n0 = vector.mma %lhs, %rhs0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n1 = vector.mma %lhs, %rhs1, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n2 = vector.mma %lhs, %rhs2, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %n3 = vector.mma %lhs, %rhs3, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %n0, %n1, %n2, %n3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  vector.fragment.store<result> %acc0, %ostage_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %acc1, %ostage_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %acc2, %ostage_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %acc3, %ostage_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %val = view.load %ostage_view[%gr2, %tok] : view<[%stage_rows]x64xf32> -> f32
    %tok_g = index.add %token_base, %tok : index
    %tok_off = index.mul %tok_g, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    view.store %val, %out_view[%gflat] : f32, view<[%out_total]xf32>
    scf.yield %mk2 : index
  }
  kernel.return
}

// Requires --config=yah_ffn_gemm_q5k.m_tiles=1.
check.case public @yah_ffn_gemm_q5k_case {
  %weight = check.file.read.npy path("fixtures/q5k_gemm/input_q5k_gemm.npy") : tensor<56320xi8>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1024xf32>
  %expected = check.file.read.npy path("fixtures/q5k_gemm/expected_out.npy") : tensor<1024xf32>
  %wstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1024xf32>
  kernel.launch @yah_ffn_gemm_q5k(%weight, %input, %wstage, %ostage, %output) : (tensor<56320xi8>, tensor<64x5120xf16>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1024xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_q5k_case> @yah_ffn_gemm_q5k_bench

// Requires --config=yah_ffn_gemm_q5k.m_tiles=1088. An all-zero Q5_K weight
// decodes to zero, so every output must be exactly 0.
check.case public @yah_ffn_gemm_q5k_full_case {
  %weight = check.generate.fill value(0) : tensor<61276160xi8>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1114112xf32>
  %expected = check.generate.fill value(0.0) : tensor<1114112xf32>
  %wstage = check.generate.fill value(0.0) : tensor<89128960xf16>
  %ostage = check.generate.fill value(0.0) : tensor<1114112xf32>
  kernel.launch @yah_ffn_gemm_q5k(%weight, %input, %wstage, %ostage, %output) : (tensor<61276160xi8>, tensor<64x5120xf16>, tensor<89128960xf16>, tensor<1114112xf32>, tensor<1114112xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1114112xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_q5k_full_case> @yah_ffn_gemm_q5k_full_bench
