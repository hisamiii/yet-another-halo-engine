// Split the interleaved q|gate projection: each head of qg holds head_dim q values, then head_dim gate values.
//   q_out[b][h*head_dim + d] = qg[b][h*2*head_dim + d], gate_out[b][h*head_dim + d] = qg[b][h*2*head_dim + head_dim + d]
// Grid: (ceil(num_heads*head_dim / 256), batch) workgroups of 256 lanes, one element per lane. The emitters set head_dim.
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_unpack_qg.batch : %value: index where [range(%value, 1, 4096)]

config.decl @yah_unpack_qg.num_heads : %value: index where [range(%value, 1, 65536)]

config.def @yah_unpack_qg.head_dim = 1 : index

kernel.def target(@yah_wave32) @yah_unpack_qg() {
  %unit = index.constant 1 : index
  %batch = config.get @yah_unpack_qg.batch : index
  %num_heads = config.get @yah_unpack_qg.num_heads : index
  %head_dim = config.get @yah_unpack_qg.head_dim : index
  %total_h = index.mul %num_heads, %head_dim : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %total_h, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %batch, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%qg: buffer, %q_out: buffer, %gate_out: buffer) {
  %base = index.constant 0 : offset
  %c256 = index.constant 256 : index
  %c2 = index.constant 2 : index
  %batch = config.get @yah_unpack_qg.batch : index
  %num_heads = config.get @yah_unpack_qg.num_heads : index
  %head_dim = config.get @yah_unpack_qg.head_dim : index
  %total_h = index.mul %num_heads, %head_dim : index
  %two_total = index.mul %total_h, %c2 : index

  %qg_noalias, %q_noalias, %gate_noalias = buffer.assume.noalias %qg, %q_out, %gate_out : buffer, buffer, buffer
  %qg_view = buffer.view %qg_noalias[%base] : buffer -> view<[%batch]x[%two_total]xf32>
  %q_view = buffer.view %q_noalias[%base] : buffer -> view<[%batch]x[%total_h]xf32>
  %gate_view = buffer.view %gate_noalias[%base] : buffer -> view<[%batch]x[%total_h]xf32>

  %lane = kernel.workitem.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %wg = kernel.workgroup.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %idx = index.add %wg_base, %lane : index

  %in_range = index.cmp ult, %idx, %total_h : index
  scf.if %in_range {
    %head_idx = index.div %idx, %head_dim : index
    %dim_idx = index.rem %idx, %head_dim : index
    %head_off = index.mul %head_idx, %c2 : index
    %head_off2 = index.mul %head_off, %head_dim : index
    %src = index.add %head_off2, %dim_idx : index
    %src1 = index.add %src, %head_dim : index
    %qv = view.load %qg_view[%row, %src] : view<[%batch]x[%two_total]xf32> -> f32
    %gv = view.load %qg_view[%row, %src1] : view<[%batch]x[%two_total]xf32> -> f32
    view.store %qv, %q_view[%row, %idx] : f32, view<[%batch]x[%total_h]xf32>
    view.store %gv, %gate_view[%row, %idx] : f32, view<[%batch]x[%total_h]xf32>
  }
  kernel.return
}
