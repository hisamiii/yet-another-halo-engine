// YAH draft-probability scatter, Loom port of ScatterDraftProbabilitiesKernel.
//
// HIP source: sample.hip. The speculative verifier hands back a sparse list of
// candidate ids and probabilities; this scatters them into a dense vocabulary row.
// Only the first occurrence of a token writes, and that first entry sums every
// occurrence in original order so the lookup keeps the verifier exact f32 value.
// The duplicate scan and the sum are both serial Loom loops with no early exit:
// the scan accumulates a flag and the caller tests it, because a loop cannot
// break out of a kernel on this target.
//
// Required config: --config=yah_scatter_draft.count=4 --config=yah_scatter_draft.vocab=8
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_scatter_draft.count : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_scatter_draft.vocab : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@yah_wave32) @yah_scatter_draft() {
  %unit = index.constant 1 : index
  %count = config.get @yah_scatter_draft.count : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %count, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%ids: buffer, %probs: buffer, %dense: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %zero = scalar.constant 0.0 : f32
  %count = config.get @yah_scatter_draft.count : index
  %vocab = config.get @yah_scatter_draft.vocab : index
  %ids_na, %probs_na, %dense_na = buffer.assume.noalias %ids, %probs, %dense : buffer, buffer, buffer
  %ids_view = buffer.view %ids_na[%base] : buffer -> view<[%count]xi32>
  %probs_view = buffer.view %probs_na[%base] : buffer -> view<[%count]xf32>
  %dense_view = buffer.view %dense_na[%base] : buffer -> view<[%vocab]xf32>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %index = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %index, %count : index
  scf.if %in_range {
    %token_i = view.load %ids_view[%index] : view<[%count]xi32> -> i32
    %token = index.cast %token_i : i32 to index
    %token_ok = index.cmp ult, %token, %vocab : index
    scf.if %token_ok {
      %dup = scf.for %p = [%c0 to %index step %c1](%d = %c0i : i32) -> (i32) {
        %pid_i = view.load %ids_view[%p] : view<[%count]xi32> -> i32
        %pid = index.cast %pid_i : i32 to index
        %same = index.cmp eq, %pid, %token : index
        %next = scf.if %same -> (i32) {
          scf.yield %c1i : i32
        } else {
          scf.yield %d : i32
        }
        scf.yield %next : i32
      }
      %dup_idx = index.cast %dup : i32 to index
      %is_first = index.cmp eq, %dup_idx, %c0 : index
      scf.if %is_first {
        %probability = scf.for %n = [%index to %count step %c1](%s = %zero : f32) -> (f32) {
          %nid_i = view.load %ids_view[%n] : view<[%count]xi32> -> i32
          %nid = index.cast %nid_i : i32 to index
          %match = index.cmp eq, %nid, %token : index
          %next_s = scf.if %match -> (f32) {
            %pv = view.load %probs_view[%n] : view<[%count]xf32> -> f32
            %sum = scalar.addf %s, %pv : f32
            scf.yield %sum : f32
          } else {
            scf.yield %s : f32
          }
          scf.yield %next_s : f32
        }
        view.store %probability, %dense_view[%token] : f32, view<[%vocab]xf32>
      }
    }
  }
  kernel.return
}

// Requires --config=yah_scatter_draft.count=4 --config=yah_scatter_draft.vocab=8.
//
// ids = {2, 5, 2, 5} and probabilities = {0.25, 0.5, 0.25, 0.5}. The first
// occurrences (index 0 and index 1) sum their duplicates: dense[2] = 0.5 and
// dense[5] = 1.0. Both sums are exact powers of two, so the expected row is an
// exact fixture.
check.case public @yah_scatter_draft_case {
  %ids = check.file.read.npy path("fixtures/scatter_draft/ids.npy") : tensor<4xi32>
  %probs = check.file.read.npy path("fixtures/scatter_draft/probs.npy") : tensor<4xf32>
  %dense = check.generate.fill value(0.0) : tensor<8xf32>
  %expected = check.file.read.npy path("fixtures/scatter_draft/expected.npy") : tensor<8xf32>
  kernel.launch @yah_scatter_draft(%ids, %probs, %dense) : (tensor<4xi32>, tensor<4xf32>, tensor<8xf32>)
  check.expect.close actual(%dense) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.return
}

check.benchmark<@yah_scatter_draft_case> @yah_scatter_draft_bench
