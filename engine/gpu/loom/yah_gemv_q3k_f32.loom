// YAH Q3_K block GEMV, Loom port of Q8KBlockGEMVKernel for the Q3_K format
// (gemv_quant.hip). Decode each weight element with the Q3_K block decoder and
// dot it against the fp32 activation row:
//
//   y[m] = sum_k q3k_decode(W, m, k) * x[k]
//
// One workgroup per output row, 32 lanes, each lane eight elements per block and
// a subgroup add. This is the arm LaunchGEMV reaches through kHipQuantDirect. On
// the Qwen3.8-27B shard the output projection is Q6_K, so the Q6_K arm runs at the
// end of every prefill; the Q3_K arm is the tied lm-head fallback.
//
// Measured: 0.97 ms at 17408 rows x 5120. 0.0469 ms at 16 rows.
//
// Required config: --config=yah_gemv_q3k.m_rows=16
//                  --config=yah_gemv_q3k.k_blocks=20
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_gemv_q3k.m_rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_gemv_q3k.k_blocks : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_gemv_q3k() {
  %unit = index.constant 1 : index
  %m_rows = config.get @yah_gemv_q3k.m_rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_rows, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %x: buffer, %y: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c144 = index.constant 110 : index
  %c256 = index.constant 256 : index
  %c1440 = index.constant 1100 : index
  %c2880 = index.constant 2200 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %c110i = scalar.constant 110 : i32
  %c2200i = scalar.constant 2200 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c7i = scalar.constant 7 : i32
  %c54i = scalar.constant 54 : i32
  %c96i = scalar.constant 96 : i32
  %zero = scalar.constant 0.0 : f32
  %m_rows = config.get @yah_gemv_q3k.m_rows : index
  %k_blocks = config.get @yah_gemv_q3k.k_blocks : index
  %w_bytes = index.mul %m_rows, %c2880 : index
  %w_halfs = index.mul %m_rows, %c1440 : index
  %x_elems = index.mul %k_blocks, %c256 : index
  %weight_na, %x_na, %y_na = buffer.assume.noalias %weight, %x, %y : buffer, buffer, buffer
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%x_elems]xf32>
  %y_view = buffer.view %y_na[%base] : buffer -> view<[%m_rows]xf32>
  %m = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %m_i = index.cast %m : index to i32
  %lane_i = index.cast %lane : index to i32
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %x_last = index.sub %x_elems, %c1 : index
  %acc0 = scf.for %kblk = [%c0 to %k_blocks step %c1](%a0 = %zero : f32) -> (f32) {
    %kblk_i = index.cast %kblk : index to i32
    %row_off = scalar.muli %m_i, %c2200i : i32
    %blk_off0 = scalar.muli %kblk_i, %c110i : i32
    %blk_off = scalar.addi %row_off, %blk_off0 : i32
    %kblk256 = scalar.shli %kblk_i, %c8i : i32
    %acc1 = scf.for %j = [%c0 to %c8 step %c1](%a1 = %a0 : f32) -> (f32) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %i_i = scalar.addi %lane_i, %j32 : i32
      %group = scalar.shrui %i_i, %c5i : i32
      %half = scalar.shrui %group, %c2i : i32
      %sp = scalar.andi %group, %c3i : i32
      %h16b = scalar.andi %i_i, %c16i : i32
      %h16 = scalar.shrui %h16b, %c4i : i32
      %jj = scalar.andi %i_i, %c15i : i32
      %lane_of = scalar.addi %h16b, %jj : i32
      %half32 = scalar.shli %half, %c5i : i32
      %qs0 = scalar.addi %blk_off, %c32i : i32
      %qs1 = scalar.addi %qs0, %half32 : i32
      %qs_i = scalar.addi %qs1, %lane_of : i32
      %low_shift = scalar.shli %sp, %c1i : i32
      %qs_ix = index.cast %qs_i : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %w_last : index
      %qsb8 = view.load %w_view[%qs_idx] : view<[%w_bytes]xi8> -> i8
      %qsb = scalar.extui %qsb8 : i8 to i32
      %low0 = scalar.shrui %qsb, %low_shift : i32
      %low = scalar.andi %low0, %c3i : i32
      %hm_i = scalar.addi %blk_off, %lane_of : i32
      %hm_ix = index.cast %hm_i : i32 to index
      %hm_lo = index.max %hm_ix, %c0 : index
      %hm_idx = index.min %hm_lo, %w_last : index
      %hmb8 = view.load %w_view[%hm_idx] : view<[%w_bytes]xi8> -> i8
      %hmb = scalar.extui %hmb8 : i8 to i32
      %half4 = scalar.shli %half, %c2i : i32
      %high_shift = scalar.addi %half4, %sp : i32
      %bit0 = scalar.shrui %hmb, %high_shift : i32
      %bit = scalar.andi %bit0, %c1i : i32
      %bit4 = scalar.shli %bit, %c2i : i32
      %lowbit = scalar.ori %low, %bit4 : i32
      %quant = scalar.subi %lowbit, %c4i : i32
      %quant_f = scalar.sitofp %quant : i32 to f32
      %si0 = scalar.muli %half, %c8i : i32
      %sp2 = scalar.shli %sp, %c1i : i32
      %si1 = scalar.addi %si0, %sp2 : i32
      %si_v = scalar.addi %si1, %h16 : i32
      %si_lt8 = scalar.cmpi slt, %si_v, %c8i : i32
      %si_lo3 = scalar.andi %si_v, %c7i : i32
      %sc0 = scalar.addi %blk_off, %c96i : i32
      %sc1 = scalar.addi %sc0, %si_lo3 : i32
      %sc_ix = index.cast %sc1 : i32 to index
      %sc_lo = index.max %sc_ix, %c0 : index
      %sc_idx = index.min %sc_lo, %w_last : index
      %scb8 = view.load %w_view[%sc_idx] : view<[%w_bytes]xi8> -> i8
      %scb = scalar.extui %scb8 : i8 to i32
      %scb_lo = scalar.andi %scb, %c15i : i32
      %scb_hi = scalar.shrui %scb, %c4i : i32
      %low4 = scf.if %si_lt8 -> (i32) {
        scf.yield %scb_lo : i32
      } else {
        scf.yield %scb_hi : i32
      }
      %si_mod4 = scalar.andi %si_v, %c3i : i32
      %hi_off8 = scalar.addi %sc0, %c8i : i32
      %hi1 = scalar.addi %hi_off8, %si_mod4 : i32
      %hi_ix = index.cast %hi1 : i32 to index
      %hi_lo = index.max %hi_ix, %c0 : index
      %hi_idx = index.min %hi_lo, %w_last : index
      %hib8 = view.load %w_view[%hi_idx] : view<[%w_bytes]xi8> -> i8
      %hib = scalar.extui %hib8 : i8 to i32
      %si_div4 = scalar.shrui %si_v, %c2i : i32
      %hi_shift2 = scalar.shli %si_div4, %c1i : i32
      %high0 = scalar.shrui %hib, %hi_shift2 : i32
      %high2 = scalar.andi %high0, %c3i : i32
      %high4b = scalar.shli %high2, %c4i : i32
      %scale6 = scalar.ori %low4, %high4b : i32
      %scale_biased = scalar.subi %scale6, %c32i : i32
      %scale_f = scalar.sitofp %scale_biased : i32 to f32
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_i = scalar.addi %blk_half0, %c54i : i32
      %d_ix = index.cast %d_i : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dsc = scalar.mulf %d, %scale_f : f32
      %value = scalar.mulf %dsc, %quant_f : f32
      %kidx_i = scalar.addi %kblk256, %i_i : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %x_last : index
      %xv = view.load %x_view[%kidx] : view<[%x_elems]xf32> -> f32
      %prod = scalar.mulf %value, %xv : f32
      %next = scalar.addf %a1, %prod : f32
      scf.yield %next : f32
    }
    scf.yield %acc1 : f32
  }
  %sum = kernel.subgroup.reduce<addf> %acc0 : f32
  %is_zero = index.cmp eq, %lane, %c0 : index
  %st = scf.if %is_zero -> (f32) {
    view.store %sum, %y_view[%m] : f32, view<[%m_rows]xf32>
    scf.yield %zero : f32
  } else {
    scf.yield %zero : f32
  }
  kernel.return
}

// Requires the config block above with m_rows=16, k_blocks=20.
check.case public @yah_gemv_q3k_case {
  %weight = check.file.read.npy path("fixtures/q3k_gemm/input_q3k_gemm.npy") : tensor<35200xi8>
  %x = check.file.read.npy path("fixtures/q3k_gemm/gemv_x.npy") : tensor<5120xf32>
  %expected = check.file.read.npy path("fixtures/q3k_gemm/gemv_expected.npy") : tensor<16xf32>
  %y = check.generate.fill value(0.0) : tensor<16xf32>
  kernel.launch @yah_gemv_q3k(%weight, %x, %y) : (tensor<35200xi8>, tensor<5120xf32>, tensor<16xf32>)
  check.expect.close actual(%y) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<16xf32>
  check.return
}

check.benchmark<@yah_gemv_q3k_case> @yah_gemv_q3k_bench

// Requires --config=yah_gemv_q3k.m_rows=17408 --config=yah_gemv_q3k.k_blocks=20.
// An all-zero Q3_K weight decodes to zero, so every output row must be exactly 0.
check.case public @yah_gemv_q3k_full_case {
  %weight = check.generate.fill value(0) : tensor<38297600xi8>
  %x = check.generate.fill value(1.0) : tensor<5120xf32>
  %y = check.generate.fill value(0.0) : tensor<17408xf32>
  %expected = check.generate.fill value(0.0) : tensor<17408xf32>
  kernel.launch @yah_gemv_q3k(%weight, %x, %y) : (tensor<38297600xi8>, tensor<5120xf32>, tensor<17408xf32>)
  check.expect.close actual(%y) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<17408xf32>
  check.return
}

check.benchmark<@yah_gemv_q3k_full_case> @yah_gemv_q3k_full_bench