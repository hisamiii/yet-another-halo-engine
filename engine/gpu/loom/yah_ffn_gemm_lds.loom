// YAH FFN GEMM with LDS-staged operands.
//
// v3 (16x64 tile, weights read once, pipeline depth 3 unroll 2) reaches 1.819 ms
// and its load-only probe shows 95% of that is the memory path. Disassembling the
// HIP control we benchmark against shows why it is faster on the same traffic:
// it fetches each operand byte once into 64 KiB of shared memory with wide
// coalesced global loads (8 global_load_b128 in its body) and then serves 48 of
// its per-body operand reads from LDS (ds_load_b128). Loom issues 40 global
// gathers and never touches shared memory, so every MMA operand reaches back out
// to L2/L1.
//
// The shape that matters is the run length per lane. A [16,16] f16 fragment
// gather reads 32 contiguous bytes per lane from 16 rows 10240 bytes apart. This
// kernel instead stages a BK=64 block: 32 lanes are assigned four-per-row, so one
// instruction covers 8 runs of 128 contiguous bytes -- a full cache line each,
// against 32-byte runs before. The MMAs then read the staged tile from LDS.
//
// LDS cost: activation 64 tokens x 64 K x 2 B = 8192 B, weight 16 rows x 64 K x
// 2 B = 2048 B, so 10 KiB against the 64 KiB budget. Two barriers per 64-K block,
// which is one barrier per four K steps, and with a single wave per workgroup a
// barrier is cheap.
//
// Weight traffic is unchanged at one pass over 178 MB; only the transaction shape
// and the operand-delivery level change.
amdgpu.target<gfx11-generic> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_lds.m_tiles : %value: index where [range(%value, 1, 4096)]

config.def @yah_ffn_gemm_lds.bk = 64 : index

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_lds() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_lds.m_tiles : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%weight: buffer, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c5120 = index.constant 5120 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index

  // Staged activation tile viewed as [k][t] with a 64-element token stride.
  %kt_layout = encoding.layout.strided [1, 64] : encoding<layout>

  %weight_noalias, %input_noalias, %output_noalias = buffer.assume.noalias %weight, %input, %output : buffer, buffer, buffer
  %w_view = buffer.view %weight_noalias[%base] : buffer -> view<17408x5120xf16>
  %a_view = buffer.view %input_noalias[%base] : buffer -> view<64x5120xf16>
  %out_view = buffer.view %output_noalias[%base] : buffer -> view<17408x64xf32>

  %act_bytes = index.constant 8192 : offset
  %wgt_bytes = index.constant 2048 : offset
  %act = buffer.alloca<workgroup> align(16) %act_bytes : buffer
  %wgt = buffer.alloca<workgroup> align(16) %wgt_bytes : buffer
  %act_tk = buffer.view %act[%base] : buffer -> view<64x64xf16>
  %act_kt = buffer.view %act[%base] : buffer -> view<64x64xf16, %kt_layout>
  %wgt_view = buffer.view %wgt[%base] : buffer -> view<16x64xf16>

  %lane = kernel.workitem.id<x> : index
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %four = index.constant 4 : index
  %lane_row = index.div %lane, %four : index
  %lane_quad = index.rem %lane, %four : index
  %klane = index.mul %lane_quad, %c16 : index

  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %acc0, %acc1, %acc2, %acc3 = scf.for %kb = [%c0 to %c5120 step %c64](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %a2 = %init : vector<8xf32>, %a3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    // Stage the activation tile: 8 passes x 8 tokens, four lanes per token.
    %f0 = scf.for %p = [%c0 to %c8 step %c1](%d0 = %c0 : index) -> (index) {
      %t = index.add %lane_row, %c0 : index
      %t9 = index.mul %p, %c8 : index
      %tt = index.add %t, %t9 : index
      %gk = index.add %kb, %klane : index
      %av = vector.load %a_view[%tt, %gk] : view<64x5120xf16> -> vector<16xf16>
      vector.store %av, %act_tk[%tt, %klane] : vector<16xf16>, view<64x64xf16>
      scf.yield %d0 : index
    }
    // Stage the weight tile: 2 passes x 8 rows, four lanes per row.
    %f1 = scf.for %q = [%c0 to %c2 step %c1](%d1 = %c0 : index) -> (index) {
      %r = index.add %lane_row, %c0 : index
      %r9 = index.mul %q, %c8 : index
      %rr = index.add %r, %r9 : index
      %gr = index.add %m_origin, %rr : index
      %gk2 = index.add %kb, %klane : index
      %wv = vector.load %w_view[%gr, %gk2] : view<17408x5120xf16> -> vector<16xf16>
      vector.store %wv, %wgt_view[%rr, %klane] : vector<16xf16>, view<16x64xf16>
      scf.yield %d1 : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // Four K sub-steps served entirely from LDS.
    %l0 = vector.fragment.load<lhs> %wgt_view[%c0, %c0] shape [%m, %k] : view<16x64xf16> -> vector<16xf16>
    %r0 = vector.fragment.load<rhs> %act_kt[%c0, %c0] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %r1 = vector.fragment.load<rhs> %act_kt[%c0, %c16] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %r2 = vector.fragment.load<rhs> %act_kt[%c0, %c32] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %r3 = vector.fragment.load<rhs> %act_kt[%c0, %c48] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %b0 = vector.mma %l0, %r0, %a0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %b1 = vector.mma %l0, %r1, %a1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %b2 = vector.mma %l0, %r2, %a2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %b3 = vector.mma %l0, %r3, %a3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %l1 = vector.fragment.load<lhs> %wgt_view[%c0, %c16] shape [%m, %k] : view<16x64xf16> -> vector<16xf16>
    %s0 = vector.fragment.load<rhs> %act_kt[%c16, %c0] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %s1 = vector.fragment.load<rhs> %act_kt[%c16, %c16] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %s2 = vector.fragment.load<rhs> %act_kt[%c16, %c32] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %s3 = vector.fragment.load<rhs> %act_kt[%c16, %c48] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %c0n = vector.mma %l1, %s0, %b0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %c1n = vector.mma %l1, %s1, %b1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %c2n = vector.mma %l1, %s2, %b2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %c3n = vector.mma %l1, %s3, %b3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %l2 = vector.fragment.load<lhs> %wgt_view[%c0, %c32] shape [%m, %k] : view<16x64xf16> -> vector<16xf16>
    %u0 = vector.fragment.load<rhs> %act_kt[%c32, %c0] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %u1 = vector.fragment.load<rhs> %act_kt[%c32, %c16] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %u2 = vector.fragment.load<rhs> %act_kt[%c32, %c32] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %u3 = vector.fragment.load<rhs> %act_kt[%c32, %c48] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %d0n = vector.mma %l2, %u0, %c0n : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %d1n = vector.mma %l2, %u1, %c1n : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %d2n = vector.mma %l2, %u2, %c2n : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %d3n = vector.mma %l2, %u3, %c3n : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %l3 = vector.fragment.load<lhs> %wgt_view[%c0, %c48] shape [%m, %k] : view<16x64xf16> -> vector<16xf16>
    %v0 = vector.fragment.load<rhs> %act_kt[%c48, %c0] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %v1 = vector.fragment.load<rhs> %act_kt[%c48, %c16] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %v2 = vector.fragment.load<rhs> %act_kt[%c48, %c32] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %v3 = vector.fragment.load<rhs> %act_kt[%c48, %c48] shape [%k, %n] : view<64x64xf16, %kt_layout> -> vector<16xf16>
    %e0n = vector.mma %l3, %v0, %d0n : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %e1n = vector.mma %l3, %v1, %d1n : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %e2n = vector.mma %l3, %v2, %d2n : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %e3n = vector.mma %l3, %v3, %d3n : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %e0n, %e1n, %e2n, %e3n : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  vector.fragment.store<result> %acc0, %out_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<17408x64xf32>
  vector.fragment.store<result> %acc1, %out_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<17408x64xf32>
  vector.fragment.store<result> %acc2, %out_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<17408x64xf32>
  vector.fragment.store<result> %acc3, %out_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<17408x64xf32>
  kernel.return
}

check.case public @yah_ffn_gemm_lds_case {
  %weight = check.generate.fill value(1.0) : tensor<17408x5120xf16>
  %input = check.generate.fill value(1.0) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<17408x64xf32>
  %expected = check.generate.fill value(5120.0) : tensor<17408x64xf32>
  kernel.launch @yah_ffn_gemm_lds(%weight, %input, %output) : (tensor<17408x5120xf16>, tensor<64x5120xf16>, tensor<17408x64xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<17408x64xf32>
  check.return
}

check.benchmark<@yah_ffn_gemm_lds_case> @yah_ffn_gemm_lds_bench
