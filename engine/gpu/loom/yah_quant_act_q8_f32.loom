// YAH prefill Q8_1 activation quantizer, Loom port of QuantizeActivationToQ8_1Kernel.
//
// HIP source: models/qwen/hip/kernels/prefill_quant_gemm.hip. One warp per
// 32-element K block. The warp reduces |x|, scales by 1/127, rounds the scaled
// value away from zero, and writes one int8 plus the block scale into the tiled
// Q8_1 activation layout:
//
//   tile(tt, kb) = [16 tokens x 16 bytes]      offset   0   (lane 0..15)
//                  [16 tokens x 16 bytes]      offset 256   (lane 16..31)
//                  [16 fp32 token scales]      offset 512
//
// with tt = token/16, kb = block/32, that 576-byte tile followed by the activation
// sum sidecar (two fp32 per (token, block): the whole-block sum and its low-16
// sum). The port keeps the layout exactly, including both sums, so the W8A8 GEMM
// epilogue can read it unchanged.
//
// The warp reduction is `kernel.subgroup.reduce<maxnumf>`. The sidecar sums are
// two masked `reduce<addf>` calls: the quantized values are small integers, so
// the f32 sums are exact and match HIP integer `__shfl_xor` tree. `scalar.roundf`
// is ties-away-from-zero, which is HIP roundf.
//
// Required config: --config=yah_quant_act_q8.batch=16 --config=yah_quant_act_q8.k=32
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_quant_act_q8.batch : %value: index where [range(%value, 1, 65536)]

config.decl @yah_quant_act_q8.k : %value: index where [range(%value, 32, 65536)]

kernel.def target(@yah_wave32) @yah_quant_act_q8() {
  %unit = index.constant 1 : index
  %batch = config.get @yah_quant_act_q8.batch : index
  %k = config.get @yah_quant_act_q8.k : index
  %batch_i = index.cast %batch : index to i32
  %k_i = index.cast %k : index to i32
  %c5i = scalar.constant 5 : i32
  %c15i = scalar.constant 15 : i32
  %c4i = scalar.constant 4 : i32
  %c3i = scalar.constant 3 : i32
  %c7i = scalar.constant 7 : i32
  %num_blocks_i = scalar.shrui %k_i, %c5i : i32
  %batch15_i = scalar.addi %batch_i, %c15i : i32
  %tiles_i = scalar.shrui %batch15_i, %c4i : i32
  %blocks_i = scalar.muli %batch_i, %num_blocks_i : i32
  %blocks7_i = scalar.addi %blocks_i, %c7i : i32
  %grid_i = scalar.shrui %blocks7_i, %c3i : i32
  %grid = index.cast %grid_i : i32 to index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%grid, %unit, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%x: buffer, %y: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c144 = index.constant 144 : index
  %c152 = index.constant 152 : index
  %c256 = index.constant 256 : index
  %c128 = index.constant 128 : index
  %c576 = index.constant 576 : index
  %c704 = index.constant 704 : index
  %c176 = index.constant 176 : index
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c15i = scalar.constant 15 : i32
  %c127f = scalar.constant 127.0 : f32
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %batch = config.get @yah_quant_act_q8.batch : index
  %k = config.get @yah_quant_act_q8.k : index
  %k_i = index.cast %k : index to i32
  %num_blocks_i = scalar.shrui %k_i, %c5i : i32
  %num_blocks = index.cast %num_blocks_i : i32 to index
  %batch_i = index.cast %batch : index to i32
  %batch15_i = scalar.addi %batch_i, %c15i : i32
  %tiles_i = scalar.shrui %batch15_i, %c4i : i32
  %tiles = index.cast %tiles_i : i32 to index
  %total_blocks = index.mul %batch, %num_blocks : index
  %tiles_blocks = index.mul %tiles, %num_blocks : index
  %x_elems = index.mul %batch, %k : index
  %total_bytes = index.mul %tiles_blocks, %c704 : index
  %sum_base_words = index.mul %tiles_blocks, %c144 : index
  %total_words = index.mul %tiles_blocks, %c176 : index
  %x_na, %y_na = buffer.assume.noalias %x, %y : buffer, buffer
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%x_elems]xf32>
  %y_i8 = buffer.view %y_na[%base] : buffer -> view<[%total_bytes]xi8>
  %y_f32 = buffer.view %y_na[%base] : buffer -> view<[%total_words]xf32>
  %wg = kernel.workgroup.id<x> : index
  %wid = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %wg8 = index.mul %wg, %c8 : index
  %b_idx = index.add %wg8, %wid : index
  %in_range = index.cmp ult, %b_idx, %total_blocks : index
  %sink = scf.if %in_range -> (index) {
    %tok = index.div %b_idx, %num_blocks : index
    %blk = index.rem %b_idx, %num_blocks : index
    %tok_k = index.mul %tok, %k : index
    %blk32 = index.mul %blk, %c32 : index
    %blk32_lane = index.add %blk32, %lane : index
    %elem = index.add %tok_k, %blk32_lane : index
    %val = view.load %x_view[%elem] : view<[%x_elems]xf32> -> f32
    %abs = scalar.absf %val : f32
    %max_abs = kernel.subgroup.reduce<maxnumf> %abs : f32
    %d = scalar.divf %max_abs, %c127f : f32
    %nonzero = scalar.cmpf one, %d, %zero : f32
    %id = scf.if %nonzero -> (f32) {
      %inv = scalar.divf %one, %d : f32
      scf.yield %inv : f32
    } else {
      scf.yield %zero : f32
    }
    %scaled = scalar.mulf %val, %id : f32
    %rounded = scalar.roundf %scaled : f32
    %q_i32 = scalar.fptosi %rounded : f32 to i32
    %q_i8 = scalar.trunci %q_i32 : i32 to i8
    // Byte position inside the 576-byte tile.
    %tok_i = index.cast %tok : index to i32
    %tt_i = scalar.shrui %tok_i, %c4i : i32
    %tl_i = scalar.andi %tok_i, %c15i : i32
    %tt = index.cast %tt_i : i32 to index
    %tl_clamp_i = scalar.minsi %tl_i, %c15i : i32
    %tl = index.cast %tl_clamp_i : i32 to index
    %tt_nb = index.mul %tt, %num_blocks : index
    %tile_raw = index.add %tt_nb, %blk : index
    // Clamp the tile so the footprint analysis can bound every store by the
    // declared buffer. For a valid b_idx the clamp never changes the value.
    %tile_raw_i = index.cast %tile_raw : index to i32
    %tile_max = index.sub %tiles_blocks, %c1 : index
    %tile_max_i = index.cast %tile_max : index to i32
    %tile_clamp_i = scalar.minsi %tile_raw_i, %tile_max_i : i32
    %tile = index.cast %tile_clamp_i : i32 to index
    %tile_bytes = index.mul %tile, %c576 : index
    %lane_i = index.cast %lane : index to i32
    %half_i = scalar.shrui %lane_i, %c4i : i32
    %pos_i = scalar.andi %lane_i, %c15i : i32
    %half = index.cast %half_i : i32 to index
    %pos = index.cast %pos_i : i32 to index
    %half256 = index.mul %half, %c256 : index
    %tl16 = index.mul %tl, %c16 : index
    %tl16_pos = index.add %tl16, %pos : index
    %within = index.add %half256, %tl16_pos : index
    %byte = index.add %tile_bytes, %within : index
    view.store %q_i8, %y_i8[%byte] : i8, view<[%total_bytes]xi8>
    // The sidecar sums. q is a small integer, so these f32 reductions are exact.
    %qf = scalar.sitofp %q_i32 : i32 to f32
    %lt16 = index.cmp ult, %lane, %c16 : index
    %low_contrib = scf.if %lt16 -> (f32) {
      scf.yield %qf : f32
    } else {
      scf.yield %zero : f32
    }
    %high_contrib = scf.if %lt16 -> (f32) {
      scf.yield %zero : f32
    } else {
      scf.yield %qf : f32
    }
    %low = kernel.subgroup.reduce<addf> %low_contrib : f32
    %high = kernel.subgroup.reduce<addf> %high_contrib : f32
    %is_leader = index.cmp eq, %lane, %c0 : index
    scf.if %is_leader {
      %tile_words = index.mul %tile, %c144 : index
      // The scale is four bytes after word 128 of the tile, i.e. word 128 + tl.
      %scale_off = index.add %c128, %tl : index
      %scale_idx = index.add %tile_words, %scale_off : index
      view.store %d, %y_f32[%scale_idx] : f32, view<[%total_words]xf32>
      %tile16 = index.mul %tile, %c16 : index
      %tile16_tl = index.add %tile16, %tl : index
      %slot_pair = index.mul %tile16_tl, %c2 : index
      %slot = index.add %sum_base_words, %slot_pair : index
      %total_sum = scalar.addf %low, %high : f32
      %slot0 = scalar.mulf %d, %total_sum : f32
      %slot1 = scalar.mulf %d, %low : f32
      view.store %slot0, %y_f32[%slot] : f32, view<[%total_words]xf32>
      %slot_next = index.add %slot, %c1 : index
      view.store %slot1, %y_f32[%slot_next] : f32, view<[%total_words]xf32>
    }
    scf.yield %c0 : index
  } else {
    scf.yield %c0 : index
  }
  kernel.return
}

// Requires --config=yah_quant_act_q8.batch=16 --config=yah_quant_act_q8.k=32.
//
// 16 tokens of 32 values, 1..512, so every token has a different block scale and
// a different int8 payload. The expected 704 bytes (576 payload + 128 sidecar)
// are a byte-exact fixture; the sums are compared as raw bits, which pins the
// low/high split and the d factor.
check.case public @yah_quant_act_q8_case {
  %x = check.generate.iota offset(1.0) step(1.0) : tensor<16x32xf32>
  %y = check.generate.fill value(0) : tensor<704xi8>
  %expected = check.file.read.npy path("fixtures/q8_act/expected_bytes.npy") : tensor<704xi8>
  kernel.launch @yah_quant_act_q8(%x, %y) : (tensor<16x32xf32>, tensor<704xi8>)
  check.expect.equal actual(%y) expected(%expected) : tensor<704xi8>
  check.return
}

check.benchmark<@yah_quant_act_q8_case> @yah_quant_act_q8_bench
