// YAH ATB packed-head expansion (fp16), Loom port of AtbExpandHeadFp16Kernel.
//
// HIP source: models/qwen/hip/kernels/prefill_fp16.hip. The NPU produces only the
// head columns of a projection; this pass copies them from a packed [rows,
// head_cols] region into the first head_cols columns of a full-width row:
//
//   out[r*full_cols + c] = packed[r*head_cols + c]      c < head_cols
//
// The HIP kernel derives r and c from a flat index with a division and a modulo by
// head_cols. This port uses a two-dimensional grid and two-dimensional views so the
// row and column are grid coordinates and no index division is needed -- power-of-two
// index division lowers to `index.shrui`, which the AMDGPU constraint rejects, and a
// runtime divisor would work but reads worse here.
//
// The columns past head_cols belong to the other producer and must be left alone,
// which is why the expectation is a fixture rather than a fill.
//
// Required config: --config=yah_atb_expand.rows=2 --config=yah_atb_expand.head_cols=3
//                  --config=yah_atb_expand.full_cols=5
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_atb_expand.rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_atb_expand.head_cols : %value: index where [range(%value, 1, 65536)]

config.decl @yah_atb_expand.full_cols : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_atb_expand() {
  %unit = index.constant 1 : index
  %rows = config.get @yah_atb_expand.rows : index
  %head_cols = config.get @yah_atb_expand.head_cols : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %head_cols, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %rows, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%packed: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %rows = config.get @yah_atb_expand.rows : index
  %head_cols = config.get @yah_atb_expand.head_cols : index
  %full_cols = config.get @yah_atb_expand.full_cols : index
  %packed_na, %out_na = buffer.assume.noalias %packed, %out : buffer, buffer
  %packed_view = buffer.view %packed_na[%base] : buffer -> view<[%rows]x[%head_cols]xf16>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%rows]x[%full_cols]xf16>
  %r = kernel.workgroup.id<y> : index
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %c256b = index.constant 256 : index
  %wg_base = index.mul %wg, %c256b : index
  %c = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %c, %head_cols : index
  scf.if %in_range {
    %value = view.load %packed_view[%r, %c] : view<[%rows]x[%head_cols]xf16> -> f16
    view.store %value, %out_view[%r, %c] : f16, view<[%rows]x[%full_cols]xf16>
  }
  kernel.return
}

// Requires --config=yah_atb_expand.rows=2 --config=yah_atb_expand.head_cols=3
// --config=yah_atb_expand.full_cols=5.
check.case public @yah_atb_expand_case {
  %packed = check.generate.iota offset(0.0) step(1.0) : tensor<2x3xf16>
  %expected = check.file.read.npy path("fixtures/atb_head/expected_expand.npy") : tensor<2x5xf16>
  %out = check.generate.fill value(-1.0) : tensor<2x5xf16>
  kernel.launch @yah_atb_expand(%packed, %out) : (tensor<2x3xf16>, tensor<2x5xf16>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x5xf16>
  check.return
}

check.benchmark<@yah_atb_expand_case> @yah_atb_expand_bench
