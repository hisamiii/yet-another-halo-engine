// YAH decode per-head RMSNorm, Loom port of PerHeadRMSNormKernel (norm.hip).
//
// HIP source: models/qwen/hip/kernels/norm.hip. One workgroup per head, each head's
// slice normalized independently:
//
//   mean_sq = sum_i x_head[i]^2 / head_dim
//   inv_rms = 1 / sqrt(mean_sq + eps)
//   out_head[i] = (x_head[i] * inv_rms) * weight[i]
//
// The weight is indexed within the head and shared across heads, exactly as upstream.
// The port uses one subgroup per head with `kernel.subgroup.reduce<addf>` in place of
// the shared-memory tree.
//
// The check is exact: x all ones with eps zero gives inv_rms exactly 1, so each head's
// output is exactly the weight row, and the flat output is that row repeated -- a
// periodic iota.
//
// Required config: --config=yah_perhead_rmsnorm_decode.num_heads=2
//                  --config=yah_perhead_rmsnorm_decode.head_dim=4
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_perhead_rmsnorm_decode.num_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_perhead_rmsnorm_decode.head_dim : %value: index where [range(%value, 1, 65536)]

config.def @yah_perhead_rmsnorm_decode.eps = 0.0 : f32

kernel.def target(@yah_wave32) @yah_perhead_rmsnorm_decode() {
  %unit = index.constant 1 : index
  %num_heads = config.get @yah_perhead_rmsnorm_decode.num_heads : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%num_heads, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%x: buffer, %weight: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c32 = index.constant 32 : index
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %num_heads = config.get @yah_perhead_rmsnorm_decode.num_heads : index
  %head_dim = config.get @yah_perhead_rmsnorm_decode.head_dim : index
  %eps = config.get @yah_perhead_rmsnorm_decode.eps : f32
  %total = index.mul %num_heads, %head_dim : index
  %x_na, %w_na, %out_na = buffer.assume.noalias %x, %weight, %out : buffer, buffer, buffer
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%num_heads]x[%head_dim]xf32>
  %w_view = buffer.view %w_na[%base] : buffer -> view<[%head_dim]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%num_heads]x[%head_dim]xf32>
  %h = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %partial = scf.for %i = [%lane to %head_dim step %c32](%s = %zero : f32) -> (f32) {
    %v = view.load %x_view[%h, %i] : view<[%num_heads]x[%head_dim]xf32> -> f32
    %sq = scalar.mulf %v, %v : f32
    %next = scalar.addf %s, %sq : f32
    scf.yield %next : f32
  }
  %sum_sq = kernel.subgroup.reduce<addf> %partial : f32
  %dim_i = index.cast %head_dim : index to i32
  %dim_f = scalar.sitofp %dim_i : i32 to f32
  %mean_sq = scalar.divf %sum_sq, %dim_f : f32
  %shifted = scalar.addf %mean_sq, %eps : f32
  %root = scalar.sqrtf %shifted : f32
  %inv = scalar.divf %one, %root : f32
  %sink = scf.for %j = [%lane to %head_dim step %c32](%mark = %zero : f32) -> (f32) {
    %v2 = view.load %x_view[%h, %j] : view<[%num_heads]x[%head_dim]xf32> -> f32
    %w = view.load %w_view[%j] : view<[%head_dim]xf32> -> f32
    %normalized = scalar.mulf %v2, %inv : f32
    %scaled = scalar.mulf %normalized, %w : f32
    view.store %scaled, %out_view[%h, %j] : f32, view<[%num_heads]x[%head_dim]xf32>
    scf.yield %mark : f32
  }
  kernel.return
}

// Requires --config=yah_perhead_rmsnorm_decode.num_heads=2
// --config=yah_perhead_rmsnorm_decode.head_dim=4.
check.case public @yah_perhead_rmsnorm_decode_case {
  %x = check.generate.fill value(1.0) : tensor<2x4xf32>
  %weight = check.generate.iota offset(0.0) step(1.0) : tensor<4xf32>
  %out = check.generate.fill value(0.0) : tensor<2x4xf32>
  %expected = check.generate.iota offset(0.0) step(1.0) period(4) : tensor<2x4xf32>
  kernel.launch @yah_perhead_rmsnorm_decode(%x, %weight, %out) : (tensor<2x4xf32>, tensor<4xf32>, tensor<2x4xf32>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x4xf32>
  check.return
}

check.benchmark<@yah_perhead_rmsnorm_decode_case> @yah_perhead_rmsnorm_decode_bench
