// YAH ATB gate+up SwiGLU decoder, Loom port of AtbDecodeSwiGLUKernel.
//
// HIP source: models/qwen/hip/kernels/prefill_fp16.hip. Gate and up share the
// bfp16ebs8 L1 layout, so one thread decodes both and emits the fp16 SwiGLU:
//
//   g = group; tile = g/8192; gi = g%8192; l1r = tile/l1_cols; l1c = tile%l1_cols
//   rib = gi%8; t1 = gi/8; block = t1%4; t2 = t1/4; sbc_half = t2%8; sbr_half = t2/8
//   row = l1r*512 + (2*sbr_half + block/2)*8 + rib
//   col0 = n_offset + l1c*128 + (2*sbc_half + block%2)*8
//   value = Bfp16DecodeByte(gate[g*9+1+i], Bfp16DecodeScale(gate[g*9]))
//   out[row][col0+i] = fp16(value / (1 + exp(-value)) * up_decoded)
//
// Same decode helper and same `2^(shared-133)` scale construction as
// yah_atb_decode_c_f32.loom, but the store is f16 via `scalar.fptrunc`.
//
// Required config: --config=yah_atb_decode_swiglu.groups=1 --config=yah_atb_decode_swiglu.l1_cols=1
//                  --config=yah_atb_decode_swiglu.n_full=16 --config=yah_atb_decode_swiglu.n_offset=0
//                  --config=yah_atb_decode_swiglu.out_rows=1 --config=yah_atb_decode_swiglu.packed_bytes=9
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_atb_decode_swiglu.groups : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_atb_decode_swiglu.l1_cols : %value: index where [range(%value, 1, 65536)]

config.decl @yah_atb_decode_swiglu.n_full : %value: index where [range(%value, 8, 1073741824)]

config.decl @yah_atb_decode_swiglu.n_offset : %value: index where [range(%value, 0, 1073741824)]

config.decl @yah_atb_decode_swiglu.out_rows : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_atb_decode_swiglu.packed_bytes : %value: index where [range(%value, 9, 1073741824)]

kernel.def target(@yah_wave32) @yah_atb_decode_swiglu() {
  %unit = index.constant 1 : index
  %groups = config.get @yah_atb_decode_swiglu.groups : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %groups, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%gate: buffer, %up: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c6 = index.constant 6 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c256 = index.constant 256 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c6i = scalar.constant 6 : i32
  %c7i = scalar.constant 7 : i32
  %c13i = scalar.constant 13 : i32
  %c23i = scalar.constant 23 : i32
  %c128i = scalar.constant 128 : i32
  %c256i = scalar.constant 256 : i32
  %c512i = scalar.constant 512 : i32
  %c8191i = scalar.constant 8191 : i32
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %groups = config.get @yah_atb_decode_swiglu.groups : index
  %l1_cols = config.get @yah_atb_decode_swiglu.l1_cols : index
  %n_full = config.get @yah_atb_decode_swiglu.n_full : index
  %n_offset = config.get @yah_atb_decode_swiglu.n_offset : index
  %out_rows = config.get @yah_atb_decode_swiglu.out_rows : index
  %packed_bytes = config.get @yah_atb_decode_swiglu.packed_bytes : index
  %l1_cols_i = index.cast %l1_cols : index to i32
  %n_offset_i = index.cast %n_offset : index to i32
  %out_elems = index.mul %out_rows, %n_full : index
  %out_rows_m1 = index.sub %out_rows, %c1 : index
  %n_full_m8 = index.sub %n_full, %c8 : index
  %out_rows_m1_i = index.cast %out_rows_m1 : index to i32
  %n_full_m8_i = index.cast %n_full_m8 : index to i32
  %gate_na, %up_na, %out_na = buffer.assume.noalias %gate, %up, %out : buffer, buffer, buffer
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<[%packed_bytes]xi8>
  %up_view = buffer.view %up_na[%base] : buffer -> view<[%packed_bytes]xi8>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%out_elems]xf16>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %g = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %g, %groups : index
  %sink = scf.if %in_range -> (index) {
    %g_i = index.cast %g : index to i32
    %tile_i = scalar.shrui %g_i, %c13i : i32
    %gi_i = scalar.andi %g_i, %c8191i : i32
    %l1c_i = scalar.remsi %tile_i, %l1_cols_i : i32
    %l1r_i = scalar.divsi %tile_i, %l1_cols_i : i32
    %rib_i = scalar.andi %gi_i, %c7i : i32
    %t1_i = scalar.shrui %gi_i, %c3i : i32
    %block_i = scalar.andi %t1_i, %c3i : i32
    %t2_i = scalar.shrui %t1_i, %c2i : i32
    %sbc_half_i = scalar.andi %t2_i, %c7i : i32
    %sbr_half_i = scalar.shrui %t2_i, %c3i : i32
    %br_i = scalar.shrui %block_i, %c1i : i32
    %bc_i = scalar.andi %block_i, %c1i : i32
    %sbr2_i = scalar.shli %sbr_half_i, %c1i : i32
    %sbr2br_i = scalar.addi %sbr2_i, %br_i : i32
    %sbr2br8_i = scalar.shli %sbr2br_i, %c3i : i32
    %l1r512_i = scalar.muli %l1r_i, %c512i : i32
    %sbr2br8_rib_i = scalar.addi %sbr2br8_i, %rib_i : i32
    %row_i = scalar.addi %l1r512_i, %sbr2br8_rib_i : i32
    %sbc2_i = scalar.shli %sbc_half_i, %c1i : i32
    %sbc2bc_i = scalar.addi %sbc2_i, %bc_i : i32
    %sbc2bc8_i = scalar.shli %sbc2bc_i, %c3i : i32
    %l1c128_i = scalar.shli %l1c_i, %c7i : i32
    %col_pre_i = scalar.addi %n_offset_i, %l1c128_i : i32
    %col0_i = scalar.addi %col_pre_i, %sbc2bc8_i : i32
    %row_clamp_i = scalar.minsi %row_i, %out_rows_m1_i : i32
    %col_clamp_i = scalar.minsi %col0_i, %n_full_m8_i : i32
    %row = index.cast %row_clamp_i : i32 to index
    %col0 = index.cast %col_clamp_i : i32 to index
    %g9 = index.mul %g, %c9 : index
    %gate_shared_i8 = view.load %gate_view[%g9] : view<[%packed_bytes]xi8> -> i8
    %gate_shared = scalar.extui %gate_shared_i8 : i8 to i32
    %gate_shift = scalar.subi %gate_shared, %c6i : i32
    %gate_bits = scalar.shli %gate_shift, %c23i : i32
    %gm = scalar.bitcast %gate_bits : i32 to f32
    %up_shared_i8 = view.load %up_view[%g9] : view<[%packed_bytes]xi8> -> i8
    %up_shared = scalar.extui %up_shared_i8 : i8 to i32
    %up_shift = scalar.subi %up_shared, %c6i : i32
    %up_bits = scalar.shli %up_shift, %c23i : i32
    %um = scalar.bitcast %up_bits : i32 to f32
    %row_base = index.mul %row, %n_full : index
    %write_loop = scf.for %i = [%c0 to %c8 step %c1](%mark = %c0i : i32) -> (i32) {
      %ip1 = index.add %i, %c1 : index
      %byte_idx = index.add %g9, %ip1 : index
      %gb_i8 = view.load %gate_view[%byte_idx] : view<[%packed_bytes]xi8> -> i8
      %gb = scalar.extui %gb_i8 : i8 to i32
      %ghigh = scalar.andi %gb, %c128i : i32
      %gneg = scalar.cmpi ugt, %ghigh, %c0i : i32
      %gbf = scalar.sitofp %gb : i32 to f32
      %gpos = scalar.mulf %gbf, %gm : f32
      %gmag = scalar.subi %c256i, %gb : i32
      %gmagf = scalar.sitofp %gmag : i32 to f32
      %gnegp = scalar.mulf %gmagf, %gm : f32
      %gnegv = scalar.negf %gnegp : f32
      %value = scf.if %gneg -> (f32) {
        scf.yield %gnegv : f32
      } else {
        scf.yield %gpos : f32
      }
      %ub_i8 = view.load %up_view[%byte_idx] : view<[%packed_bytes]xi8> -> i8
      %ub = scalar.extui %ub_i8 : i8 to i32
      %uhigh = scalar.andi %ub, %c128i : i32
      %uneg = scalar.cmpi ugt, %uhigh, %c0i : i32
      %ubf = scalar.sitofp %ub : i32 to f32
      %upos = scalar.mulf %ubf, %um : f32
      %umag = scalar.subi %c256i, %ub : i32
      %umagf = scalar.sitofp %umag : i32 to f32
      %unegp = scalar.mulf %umagf, %um : f32
      %unegv = scalar.negf %unegp : f32
      %uvalue = scf.if %uneg -> (f32) {
        scf.yield %unegv : f32
      } else {
        scf.yield %upos : f32
      }
      %negv = scalar.subf %zero, %value : f32
      %e = scalar.expf<afn> %negv : f32
      %denom = scalar.addf %one, %e : f32
      %silu = scalar.divf %value, %denom : f32
      %product = scalar.mulf %silu, %uvalue : f32
      %half = scalar.fptrunc %product : f32 to f16
      %ci = index.add %col0, %i : index
      %dst = index.add %row_base, %ci : index
      view.store %half, %out_view[%dst] : f16, view<[%out_elems]xf16>
      scf.yield %mark : i32
    }
    scf.yield %c0 : index
  } else {
    scf.yield %c0 : index
  }
  kernel.return
}

// Requires --config=yah_atb_decode_swiglu.groups=1, .l1_cols=1, .n_full=16,
// .n_offset=0, .out_rows=1, .packed_bytes=9.
//
// shared = 133 makes both scales exactly 1.0. Gate bytes 100..107 and up bytes
// 1..8 decode to those integers, and exp(-100) is below the f32 half-ulp of 1, so
// sigmoid(100+i) is exactly 1 and the output is exactly (100+i)*(1+i). Every value
// is an integer below 2048, so the fp16 store is exact.
check.case public @yah_atb_decode_swiglu_case {
  %gate = check.file.read.npy path("fixtures/atb_decode_swiglu/gate.npy") : tensor<9xi8>
  %up = check.file.read.npy path("fixtures/atb_decode_swiglu/up.npy") : tensor<9xi8>
  %out = check.generate.fill value(0.0) : tensor<1x16xf16>
  %expected = check.file.read.npy path("fixtures/atb_decode_swiglu/expected.npy") : tensor<1x16xf16>
  kernel.launch @yah_atb_decode_swiglu(%gate, %up, %out) : (tensor<9xi8>, tensor<9xi8>, tensor<1x16xf16>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x16xf16>
  check.return
}

check.benchmark<@yah_atb_decode_swiglu_case> @yah_atb_decode_swiglu_bench
