// YAH decode online attention over the fp16 KV cache, Loom port of
// QwenDecodeOnlineAttentionHalfKernel (attention_decode.hip).
//
// One workgroup per (query head, row), 32 lanes. Each lane owns eight of the 256
// head dimensions: the float4s at lane and lane+32, i.e. dims 4*lane..4*lane+3
// and 128+4*lane..128+4*lane+3. For every visible position the lane computes its
// partial q.k, the subgroup reduces it, and the online softmax rescales the lane
// eight output accumulators. The epilogue divides by the running sum and
// multiplies by sigmoid(gate).
//
//   kv_head = head / (num_heads / num_kv_heads)
//   seq_len = start_pos + row + 1
//   scale   = 1 / sqrt(256) = 1/16
//   score[p] = dot(q[head], k[p]) * scale
//   s        = softmax(score[0..seq_len))
//   ctx[d]   = sum_p s[p] * v[p][d]
//   out[d]   = ctx[d] * sigmoid(gate[head][d])
//
// The fp16 cache layout is [layer][position][kv_head][dim]. HIP loads two
// positions per iteration and uses float4 loads and DPP reductions; this port
// keeps the scalar position order and a subgroup reduce, same value.
//
// Required config: --config=yah_decode_attn.layer_idx=0
//                  --config=yah_decode_attn.start_pos=2
//                  --config=yah_decode_attn.max_context=4
//                  --config=yah_decode_attn.num_heads=2
//                  --config=yah_decode_attn.num_kv_heads=1
//                  --config=yah_decode_attn.head_dim=256
//                  --config=yah_decode_attn.rows=1
//                  --config=yah_decode_attn.has_gate=1
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_decode_attn.layer_idx : %value: index where [range(%value, 0, 65536)]

config.decl @yah_decode_attn.start_pos : %value: index where [range(%value, 0, 1073741824)]

config.decl @yah_decode_attn.max_context : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_decode_attn.num_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_decode_attn.num_kv_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_decode_attn.head_dim : %value: index where [range(%value, 1, 1024)]

config.decl @yah_decode_attn.rows : %value: index where [range(%value, 1, 4096)]

config.decl @yah_decode_attn.has_gate : %value: index where [range(%value, 0, 1)]

kernel.def target(@yah_wave32) @yah_decode_attn() {
  %unit = index.constant 1 : index
  %num_heads = config.get @yah_decode_attn.num_heads : index
  %rows = config.get @yah_decode_attn.rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%num_heads, %rows, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%q: buffer, %k_cache: buffer, %v_cache: buffer, %gate: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %scale = scalar.constant 0.0625 : f32
  %neg_inf = scalar.constant -3.0000000000000001e+38 : f32
  %layer_idx = config.get @yah_decode_attn.layer_idx : index
  %start_pos = config.get @yah_decode_attn.start_pos : index
  %max_context = config.get @yah_decode_attn.max_context : index
  %num_heads = config.get @yah_decode_attn.num_heads : index
  %num_kv_heads = config.get @yah_decode_attn.num_kv_heads : index
  %head_dim = config.get @yah_decode_attn.head_dim : index
  %rows = config.get @yah_decode_attn.rows : index
  %has_gate_flag = config.get @yah_decode_attn.has_gate : index
  %has_gate = index.cmp eq, %has_gate_flag, %c1 : index
  %q_width = index.mul %num_heads, %head_dim : index
  %q_total = index.mul %rows, %q_width : index
  %kv_width = index.mul %num_kv_heads, %head_dim : index
  %cache_elems = index.mul %max_context, %kv_width : index
  %q_na, %k_na, %v_na, %gate_na, %out_na = buffer.assume.noalias %q, %k_cache, %v_cache, %gate, %out : buffer, buffer, buffer, buffer, buffer
  %q_view = buffer.view %q_na[%base] : buffer -> view<[%q_total]xf32>
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<[%q_total]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%q_total]xf32>
  %k_view = buffer.view %k_na[%base] : buffer -> view<[%cache_elems]xf16>
  %v_view = buffer.view %v_na[%base] : buffer -> view<[%cache_elems]xf16>
  %head = kernel.workgroup.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %group_size = index.div %num_heads, %num_kv_heads : index
  %kv_head = index.div %head, %group_size : index
  %pos = index.add %start_pos, %row : index
  %seq_len = index.add %pos, %c1 : index
  %row_off = index.mul %row, %q_width : index
  %head_off = index.mul %head, %head_dim : index
  %q_base = index.add %row_off, %head_off : index
  %cache_head = index.mul %kv_head, %head_dim : index
  %layer_off = index.mul %layer_idx, %cache_elems : index
  %cache0 = index.add %layer_off, %cache_head : index
  %lane4 = index.mul %lane, %c4 : index
  %qa = index.add %q_base, %lane4 : index
  %qb = index.add %qa, %c128 : index
  %q0 = view.load %q_view[%qa] : view<[%q_total]xf32> -> f32
  %qa_1 = index.add %qa, %c1 : index
  %q1 = view.load %q_view[%qa_1] : view<[%q_total]xf32> -> f32
  %qa_2 = index.add %qa_1, %c1 : index
  %q2 = view.load %q_view[%qa_2] : view<[%q_total]xf32> -> f32
  %qa_3 = index.add %qa_2, %c1 : index
  %q3 = view.load %q_view[%qa_3] : view<[%q_total]xf32> -> f32
  %q4 = view.load %q_view[%qb] : view<[%q_total]xf32> -> f32
  %qb_1 = index.add %qb, %c1 : index
  %q5 = view.load %q_view[%qb_1] : view<[%q_total]xf32> -> f32
  %qb_2 = index.add %qb_1, %c1 : index
  %q6 = view.load %q_view[%qb_2] : view<[%q_total]xf32> -> f32
  %qb_3 = index.add %qb_2, %c1 : index
  %q7 = view.load %q_view[%qb_3] : view<[%q_total]xf32> -> f32
  %running0, %running1, %o0, %o1, %o2, %o3, %o4, %o5, %o6, %o7 = scf.for %position = [%c0 to %seq_len step %c1](%running_max = %neg_inf : f32, %running_sum = %zero : f32, %a0 = %zero : f32, %a1 = %zero : f32, %a2 = %zero : f32, %a3 = %zero : f32, %a4 = %zero : f32, %a5 = %zero : f32, %a6 = %zero : f32, %a7 = %zero : f32) -> (f32, f32, f32, f32, f32, f32, f32, f32, f32, f32) {
    %pos_off = index.mul %position, %kv_width : index
    %kb = index.add %cache0, %pos_off : index
    %ka = index.add %kb, %lane4 : index
    %kbm = index.add %ka, %c128 : index
    %k0r = view.load %k_view[%ka] : view<[%cache_elems]xf16> -> f16
    %k0 = scalar.extf %k0r : f16 to f32
    %ka_1 = index.add %ka, %c1 : index
    %k1r = view.load %k_view[%ka_1] : view<[%cache_elems]xf16> -> f16
    %k1 = scalar.extf %k1r : f16 to f32
    %ka_2 = index.add %ka_1, %c1 : index
    %k2r = view.load %k_view[%ka_2] : view<[%cache_elems]xf16> -> f16
    %k2 = scalar.extf %k2r : f16 to f32
    %ka_3 = index.add %ka_2, %c1 : index
    %k3r = view.load %k_view[%ka_3] : view<[%cache_elems]xf16> -> f16
    %k3 = scalar.extf %k3r : f16 to f32
    %k4r = view.load %k_view[%kbm] : view<[%cache_elems]xf16> -> f16
    %k4 = scalar.extf %k4r : f16 to f32
    %kbm_1 = index.add %kbm, %c1 : index
    %k5r = view.load %k_view[%kbm_1] : view<[%cache_elems]xf16> -> f16
    %k5 = scalar.extf %k5r : f16 to f32
    %kbm_2 = index.add %kbm_1, %c1 : index
    %k6r = view.load %k_view[%kbm_2] : view<[%cache_elems]xf16> -> f16
    %k6 = scalar.extf %k6r : f16 to f32
    %kbm_3 = index.add %kbm_2, %c1 : index
    %k7r = view.load %k_view[%kbm_3] : view<[%cache_elems]xf16> -> f16
    %k7 = scalar.extf %k7r : f16 to f32
    %p0 = scalar.mulf %q0, %k0 : f32
    %p1 = scalar.mulf %q1, %k1 : f32
    %p2 = scalar.mulf %q2, %k2 : f32
    %p3 = scalar.mulf %q3, %k3 : f32
    %p4 = scalar.mulf %q4, %k4 : f32
    %p5 = scalar.mulf %q5, %k5 : f32
    %p6 = scalar.mulf %q6, %k6 : f32
    %p7 = scalar.mulf %q7, %k7 : f32
    %s1 = scalar.addf %p0, %p1 : f32
    %s2 = scalar.addf %s1, %p2 : f32
    %s3 = scalar.addf %s2, %p3 : f32
    %s4 = scalar.addf %s3, %p4 : f32
    %s5 = scalar.addf %s4, %p5 : f32
    %s6 = scalar.addf %s5, %p6 : f32
    %dot = scalar.addf %s6, %p7 : f32
    %dotr = kernel.subgroup.reduce<addf> %dot : f32
    %score = scalar.mulf %dotr, %scale : f32
    %new_max = scalar.maxnumf %running_max, %score : f32
    %d1 = scalar.subf %running_max, %new_max : f32
    %prev = scalar.expf<afn> %d1 : f32
    %d2 = scalar.subf %score, %new_max : f32
    %vs = scalar.expf<afn> %d2 : f32
    %t1 = scalar.mulf %running_sum, %prev : f32
    %new_sum = scalar.addf %t1, %vs : f32
    %v0r = view.load %v_view[%ka] : view<[%cache_elems]xf16> -> f16
    %v0 = scalar.extf %v0r : f16 to f32
    %v1r = view.load %v_view[%ka_1] : view<[%cache_elems]xf16> -> f16
    %v1 = scalar.extf %v1r : f16 to f32
    %v2r = view.load %v_view[%ka_2] : view<[%cache_elems]xf16> -> f16
    %v2 = scalar.extf %v2r : f16 to f32
    %v3r = view.load %v_view[%ka_3] : view<[%cache_elems]xf16> -> f16
    %v3 = scalar.extf %v3r : f16 to f32
    %v4r = view.load %v_view[%kbm] : view<[%cache_elems]xf16> -> f16
    %v4 = scalar.extf %v4r : f16 to f32
    %v5r = view.load %v_view[%kbm_1] : view<[%cache_elems]xf16> -> f16
    %v5 = scalar.extf %v5r : f16 to f32
    %v6r = view.load %v_view[%kbm_2] : view<[%cache_elems]xf16> -> f16
    %v6 = scalar.extf %v6r : f16 to f32
    %v7r = view.load %v_view[%kbm_3] : view<[%cache_elems]xf16> -> f16
    %v7 = scalar.extf %v7r : f16 to f32
    %vp0 = scalar.mulf %v0, %vs : f32
    %op0 = scalar.mulf %a0, %prev : f32
    %on0 = scalar.addf %op0, %vp0 : f32
    %vp1 = scalar.mulf %v1, %vs : f32
    %op1 = scalar.mulf %a1, %prev : f32
    %on1 = scalar.addf %op1, %vp1 : f32
    %vp2 = scalar.mulf %v2, %vs : f32
    %op2 = scalar.mulf %a2, %prev : f32
    %on2 = scalar.addf %op2, %vp2 : f32
    %vp3 = scalar.mulf %v3, %vs : f32
    %op3 = scalar.mulf %a3, %prev : f32
    %on3 = scalar.addf %op3, %vp3 : f32
    %vp4 = scalar.mulf %v4, %vs : f32
    %op4 = scalar.mulf %a4, %prev : f32
    %on4 = scalar.addf %op4, %vp4 : f32
    %vp5 = scalar.mulf %v5, %vs : f32
    %op5 = scalar.mulf %a5, %prev : f32
    %on5 = scalar.addf %op5, %vp5 : f32
    %vp6 = scalar.mulf %v6, %vs : f32
    %op6 = scalar.mulf %a6, %prev : f32
    %on6 = scalar.addf %op6, %vp6 : f32
    %vp7 = scalar.mulf %v7, %vs : f32
    %op7 = scalar.mulf %a7, %prev : f32
    %on7 = scalar.addf %op7, %vp7 : f32
    scf.yield %new_max, %new_sum, %on0, %on1, %on2, %on3, %on4, %on5, %on6, %on7 : f32, f32, f32, f32, f32, f32, f32, f32, f32, f32
  }
  %inv = scalar.divf %one, %running1 : f32
  %r0 = scalar.mulf %o0, %inv : f32
  %r1 = scalar.mulf %o1, %inv : f32
  %r2 = scalar.mulf %o2, %inv : f32
  %r3 = scalar.mulf %o3, %inv : f32
  %r4 = scalar.mulf %o4, %inv : f32
  %r5 = scalar.mulf %o5, %inv : f32
  %r6 = scalar.mulf %o6, %inv : f32
  %r7 = scalar.mulf %o7, %inv : f32
  %g0 = view.load %gate_view[%qa] : view<[%q_total]xf32> -> f32
  %g1 = view.load %gate_view[%qa_1] : view<[%q_total]xf32> -> f32
  %g2 = view.load %gate_view[%qa_2] : view<[%q_total]xf32> -> f32
  %g3 = view.load %gate_view[%qa_3] : view<[%q_total]xf32> -> f32
  %g4 = view.load %gate_view[%qb] : view<[%q_total]xf32> -> f32
  %g5 = view.load %gate_view[%qb_1] : view<[%q_total]xf32> -> f32
  %g6 = view.load %gate_view[%qb_2] : view<[%q_total]xf32> -> f32
  %g7 = view.load %gate_view[%qb_3] : view<[%q_total]xf32> -> f32
  %ng0 = scalar.mulf %g0, %negone : f32
  %eg0 = scalar.expf<afn> %ng0 : f32
  %dg0 = scalar.addf %one, %eg0 : f32
  %sg0 = scalar.divf %one, %dg0 : f32
  %rg0 = scalar.mulf %r0, %sg0 : f32
  %out0 = scf.if %has_gate -> (f32) {
    scf.yield %rg0 : f32
  } else {
    scf.yield %r0 : f32
  }
  view.store %out0, %out_view[%qa] : f32, view<[%q_total]xf32>
  %ng1 = scalar.mulf %g1, %negone : f32
  %eg1 = scalar.expf<afn> %ng1 : f32
  %dg1 = scalar.addf %one, %eg1 : f32
  %sg1 = scalar.divf %one, %dg1 : f32
  %rg1 = scalar.mulf %r1, %sg1 : f32
  %out1 = scf.if %has_gate -> (f32) {
    scf.yield %rg1 : f32
  } else {
    scf.yield %r1 : f32
  }
  view.store %out1, %out_view[%qa_1] : f32, view<[%q_total]xf32>
  %ng2 = scalar.mulf %g2, %negone : f32
  %eg2 = scalar.expf<afn> %ng2 : f32
  %dg2 = scalar.addf %one, %eg2 : f32
  %sg2 = scalar.divf %one, %dg2 : f32
  %rg2 = scalar.mulf %r2, %sg2 : f32
  %out2 = scf.if %has_gate -> (f32) {
    scf.yield %rg2 : f32
  } else {
    scf.yield %r2 : f32
  }
  view.store %out2, %out_view[%qa_2] : f32, view<[%q_total]xf32>
  %ng3 = scalar.mulf %g3, %negone : f32
  %eg3 = scalar.expf<afn> %ng3 : f32
  %dg3 = scalar.addf %one, %eg3 : f32
  %sg3 = scalar.divf %one, %dg3 : f32
  %rg3 = scalar.mulf %r3, %sg3 : f32
  %out3 = scf.if %has_gate -> (f32) {
    scf.yield %rg3 : f32
  } else {
    scf.yield %r3 : f32
  }
  view.store %out3, %out_view[%qa_3] : f32, view<[%q_total]xf32>
  %ng4 = scalar.mulf %g4, %negone : f32
  %eg4 = scalar.expf<afn> %ng4 : f32
  %dg4 = scalar.addf %one, %eg4 : f32
  %sg4 = scalar.divf %one, %dg4 : f32
  %rg4 = scalar.mulf %r4, %sg4 : f32
  %out4 = scf.if %has_gate -> (f32) {
    scf.yield %rg4 : f32
  } else {
    scf.yield %r4 : f32
  }
  view.store %out4, %out_view[%qb] : f32, view<[%q_total]xf32>
  %ng5 = scalar.mulf %g5, %negone : f32
  %eg5 = scalar.expf<afn> %ng5 : f32
  %dg5 = scalar.addf %one, %eg5 : f32
  %sg5 = scalar.divf %one, %dg5 : f32
  %rg5 = scalar.mulf %r5, %sg5 : f32
  %out5 = scf.if %has_gate -> (f32) {
    scf.yield %rg5 : f32
  } else {
    scf.yield %r5 : f32
  }
  view.store %out5, %out_view[%qb_1] : f32, view<[%q_total]xf32>
  %ng6 = scalar.mulf %g6, %negone : f32
  %eg6 = scalar.expf<afn> %ng6 : f32
  %dg6 = scalar.addf %one, %eg6 : f32
  %sg6 = scalar.divf %one, %dg6 : f32
  %rg6 = scalar.mulf %r6, %sg6 : f32
  %out6 = scf.if %has_gate -> (f32) {
    scf.yield %rg6 : f32
  } else {
    scf.yield %r6 : f32
  }
  view.store %out6, %out_view[%qb_2] : f32, view<[%q_total]xf32>
  %ng7 = scalar.mulf %g7, %negone : f32
  %eg7 = scalar.expf<afn> %ng7 : f32
  %dg7 = scalar.addf %one, %eg7 : f32
  %sg7 = scalar.divf %one, %dg7 : f32
  %rg7 = scalar.mulf %r7, %sg7 : f32
  %out7 = scf.if %has_gate -> (f32) {
    scf.yield %rg7 : f32
  } else {
    scf.yield %r7 : f32
  }
  view.store %out7, %out_view[%qb_3] : f32, view<[%q_total]xf32>
  kernel.return
}

// Requires the config block above with has_gate=1.
check.case public @yah_decode_attn_case {
  %q = check.file.read.npy path("fixtures/decode_attn/input_q.npy") : tensor<512xf32>
  %k = check.file.read.npy path("fixtures/decode_attn/input_k.npy") : tensor<1024xf16>
  %v = check.file.read.npy path("fixtures/decode_attn/input_v.npy") : tensor<1024xf16>
  %gate = check.file.read.npy path("fixtures/decode_attn/input_gate.npy") : tensor<512xf32>
  %expected = check.file.read.npy path("fixtures/decode_attn/expected.npy") : tensor<512xf32>
  %out = check.generate.fill value(0.0) : tensor<512xf32>
  kernel.launch @yah_decode_attn(%q, %k, %v, %gate, %out) : (tensor<512xf32>, tensor<1024xf16>, tensor<1024xf16>, tensor<512xf32>, tensor<512xf32>)
  check.expect.close actual(%out) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<512xf32>
  check.return
}

check.benchmark<@yah_decode_attn_case> @yah_decode_attn_bench

// Requires the config block above with has_gate=0. The same q/k/v, without the
// sigmoid gate; out must equal the softmax context directly.
check.case public @yah_decode_attn_nogate_case {
  %q = check.file.read.npy path("fixtures/decode_attn/input_q.npy") : tensor<512xf32>
  %k = check.file.read.npy path("fixtures/decode_attn/input_k.npy") : tensor<1024xf16>
  %v = check.file.read.npy path("fixtures/decode_attn/input_v.npy") : tensor<1024xf16>
  %gate = check.file.read.npy path("fixtures/decode_attn/input_gate.npy") : tensor<512xf32>
  %expected = check.file.read.npy path("fixtures/decode_attn/expected_nogate.npy") : tensor<512xf32>
  %out = check.generate.fill value(0.0) : tensor<512xf32>
  kernel.launch @yah_decode_attn(%q, %k, %v, %gate, %out) : (tensor<512xf32>, tensor<1024xf16>, tensor<1024xf16>, tensor<512xf32>, tensor<512xf32>)
  check.expect.close actual(%out) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<512xf32>
  check.return
}

check.benchmark<@yah_decode_attn_nogate_case> @yah_decode_attn_nogate_bench
