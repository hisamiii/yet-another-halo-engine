// YAH fp16 output normalization, width-specialized, Loom port of HalfNorm5120.
//
// HIP source: models/qwen/hip/kernels/prefill_fp16.hip. Per row of dim elements:
//
//   sum_sq = sum_i x[i]^2                 (FMA accumulation upstream)
//   inv    = 1 / sqrt(sum_sq/dim + eps)
//   out[i] = f16((x[i] * inv) * weight[i])
//
// `RoundActivation` upstream is an empty asm barrier plus __float2half_rn, so it is
// exactly the f16 narrowing this port writes; the barrier is a codegen concern with
// no arithmetic content.
//
// The HIP kernel is specialized to dim 5120 with 256 threads and a fully unrolled
// 20-iteration loop. This port takes dim as a config and uses one subgroup per row
// with a lane-strided loop, which needs no division and is the same sum. Same
// arithmetic, different packing; the full-size case uses dim 5120.
//
// The check is exact at both sizes. With x all ones and eps zero the mean square is
// exactly 1, so inv is exactly 1 and the output is exactly the weight row. At dim 512
// the weight is an iota, which fp16 holds exactly and which catches a wrong weight
// index or output stride; at dim 5120 the values would exceed fp16's exact integer
// range, so that case uses a uniform weight and checks the full-size loop instead.
//
// Required config: --config=yah_half_norm5120.rows=1 --config=yah_half_norm5120.dim=512
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_half_norm5120.rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_half_norm5120.dim : %value: index where [range(%value, 32, 65536)]

config.def @yah_half_norm5120.eps = 0.0 : f32

kernel.def target(@yah_wave32) @yah_half_norm5120() {
  %unit = index.constant 1 : index
  %rows = config.get @yah_half_norm5120.rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%x: buffer, %weight: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %dim = config.get @yah_half_norm5120.dim : index
  %eps = config.get @yah_half_norm5120.eps : f32
  %rows = config.get @yah_half_norm5120.rows : index
  %total_elems = index.mul %rows, %dim : index
  %x_na, %weight_na, %out_na = buffer.assume.noalias %x, %weight, %out : buffer, buffer, buffer
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%total_elems]xf32>
  %weight_view = buffer.view %weight_na[%base] : buffer -> view<[%dim]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%total_elems]xf16>
  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row_base = index.mul %row, %dim : index
  %partial = scf.for %i = [%lane to %dim step %c32](%s = %zero : f32) -> (f32) {
    %off = index.add %row_base, %i : index
    %v = view.load %x_view[%off] : view<[%total_elems]xf32> -> f32
    %sq = scalar.mulf %v, %v : f32
    %next = scalar.addf %s, %sq : f32
    scf.yield %next : f32
  }
  %sum_sq = kernel.subgroup.reduce<addf> %partial : f32
  %dim_i = index.cast %dim : index to i32
  %dim_f = scalar.sitofp %dim_i : i32 to f32
  %mean = scalar.divf %sum_sq, %dim_f : f32
  %shifted = scalar.addf %mean, %eps : f32
  %root = scalar.sqrtf %shifted : f32
  %inv = scalar.divf %one, %root : f32
  %sink = scf.for %j = [%lane to %dim step %c32](%mark = %zero : f32) -> (f32) {
    %off2 = index.add %row_base, %j : index
    %v2 = view.load %x_view[%off2] : view<[%total_elems]xf32> -> f32
    %w = view.load %weight_view[%j] : view<[%dim]xf32> -> f32
    %normed = scalar.mulf %v2, %inv : f32
    %weighted = scalar.mulf %normed, %w : f32
    %half = scalar.fptrunc %weighted : f32 to f16
    view.store %half, %out_view[%off2] : f16, view<[%total_elems]xf16>
    scf.yield %mark : f32
  }
  kernel.return
}

// Requires --config=yah_half_norm5120.rows=1 --config=yah_half_norm5120.dim=512.
check.case public @yah_half_norm5120_small {
  %x = check.generate.fill value(1.0) : tensor<512xf32>
  %weight = check.generate.iota offset(0.0) step(1.0) : tensor<512xf32>
  %out = check.generate.fill value(0.0) : tensor<512xf16>
  %expected = check.generate.iota offset(0.0) step(1.0) : tensor<512xf16>
  kernel.launch @yah_half_norm5120(%x, %weight, %out) : (tensor<512xf32>, tensor<512xf32>, tensor<512xf16>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<512xf16>
  check.return
}

check.benchmark<@yah_half_norm5120_small> @yah_half_norm5120_small_bench

// Requires --config=yah_half_norm5120.rows=1 --config=yah_half_norm5120.dim=5120.
// The production width: fp16 cannot hold 0..5119 exactly, so this case uses a
// uniform weight and verifies the full-size loop and reduction instead.
check.case public @yah_half_norm5120_full {
  %x = check.generate.fill value(1.0) : tensor<5120xf32>
  %weight = check.generate.fill value(1.0) : tensor<5120xf32>
  %out = check.generate.fill value(0.0) : tensor<5120xf16>
  %expected = check.generate.fill value(1.0) : tensor<5120xf16>
  kernel.launch @yah_half_norm5120(%x, %weight, %out) : (tensor<5120xf32>, tensor<5120xf32>, tensor<5120xf16>)
  check.expect.close actual(%out) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<5120xf16>
  check.return
}

check.benchmark<@yah_half_norm5120_full> @yah_half_norm5120_full_bench
