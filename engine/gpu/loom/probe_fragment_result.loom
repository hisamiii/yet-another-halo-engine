// Probe: physical per-lane layout of the gfx11 16x16 f32 result/init fragment.
// Lane L loads vector<8xf32> from a distinct row (lane*8+e) of a 32x8xf32 tensor
// with iota, wraps it as vector.fragment<init> shape[16,16], then
// vector.fragment.store<result> writes it to a 16x16xf32 tensor. The output
// cell value (lane*8+e) identifies which lane-local register element landed
// where.
amdgpu.target<gfx11-generic> @probe_wave32 {subgroup_size = 32}

kernel.def target(@probe_wave32) @probe_fragment_result_global() {
  %unit = index.constant 1 : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %lane = kernel.workitem.id<x> : index
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %in_view = buffer.view %input_noalias[%base] : buffer -> view<32x8xf32>
  %out_view = buffer.view %output_noalias[%base] : buffer -> view<16x16xf32>
  %vals = vector.load %in_view[%lane, %c0] : view<32x8xf32> -> vector<8xf32>
  %init = vector.fragment<init> %vals shape [%m, %n] : vector<8xf32>
  vector.fragment.store<result> %init, %out_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
  kernel.return
}

check.case public @probe_fragment_result_global_case {
  %input = check.generate.iota offset(0.0) step(1.0) : tensor<32x8xf32>
  %output = check.generate.fill value(0.0) : tensor<16x16xf32>
  kernel.launch @probe_fragment_result_global(%input, %output) : (tensor<32x8xf32>, tensor<16x16xf32>)
  check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<16x16xf32>
  check.file.write.npy value(%output) path("probe_fragment_result_global.npy") mode(always) : tensor<16x16xf32>
  check.return
}

check.benchmark<@probe_fragment_result_global_case> @probe_fragment_result_global_bench
