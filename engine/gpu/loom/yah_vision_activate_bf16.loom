// YAH vision GELU epilogue, Loom port of Activate.
//
// HIP source: models/qwen/vision/encoder.hip. Elementwise, with the same bf16
// round trip on the input that the encoder uses everywhere:
//
//   x    = Round(input[i] + bias[i % width])
//   gelu = approximate ? 0.5*x*(1 + tanhf(0.7978845608028654*(x + 0.044715*x*x*x)))
//                      : 0.5*x*(1 + erff(x * 0.7071067811865475))
//   out  = Bf16(gelu)
//
// The `x*x*x` in the HIP source is left-associated as ((0.044715*x)*x)*x, not
// 0.044715*(x*x*x); the port keeps that association so the last f32 bit agrees.
// Both branch bodies are emitted and selected with `scf.if` on the config, so one
// compiled module carries both the tanh and the erf path.
//
// The check uses the saturating regime, where the answer is exactly representable
// and independent of which transcendental is used: for x >= ~9 both tanhf and erff
// return exactly 1.0 in f32, so gelu(x) = 0.5*x*2 = x exactly, and at x = 0 both
// return 0 so gelu(0) = 0. Every input is a multiple of 40 and every output is that
// same input, which `check.generate.iota` states without a fixture. The linear
// regime is not independently verifiable here: the afn transcendental is an
// approximation, so a bit-exact expectation would have to reproduce the GPU
// polynomial, and bf16 has no numpy dtype to hold a tolerance fixture.
//
// Required config: --config=yah_vision_activate.size=8
//                  --config=yah_vision_activate.width=8
//                  --config=yah_vision_activate.approximate=1   (and =0)
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_vision_activate.size : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_vision_activate.width : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_vision_activate.approximate : %value: index where [range(%value, 0, 1)]

kernel.def target(@yah_wave32) @yah_vision_activate() {
  %unit = index.constant 1 : index
  %size = config.get @yah_vision_activate.size : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %size, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %bias: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c256 = index.constant 256 : index
  %c1 = index.constant 1 : index
  %size = config.get @yah_vision_activate.size : index
  %width = config.get @yah_vision_activate.width : index
  %approximate = config.get @yah_vision_activate.approximate : index
  %half = scalar.constant 0.5 : f32
  %one = scalar.constant 1.0 : f32
  %a = scalar.constant 0.044714999999999998 : f32
  %c = scalar.constant 0.79788456080286541 : f32
  %inv_sqrt2 = scalar.constant 0.70710678118654746 : f32
  %input_na, %bias_na, %output_na = buffer.assume.noalias %input, %bias, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_na[%base] : buffer -> view<[%size]xf32>
  %bias_view = buffer.view %bias_na[%base] : buffer -> view<[%width]xf32>
  %output_view = buffer.view %output_na[%base] : buffer -> view<[%size]xbf16>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %index = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %index, %size : index
  scf.if %in_range {
    %col = index.rem %index, %width : index
    %previous = view.load %input_view[%index] : view<[%size]xf32> -> f32
    %bias_value = view.load %bias_view[%col] : view<[%width]xf32> -> f32
    %sum = scalar.addf %previous, %bias_value : f32
    %narrow = scalar.fptrunc %sum : f32 to bf16
    %x = scalar.extf %narrow : bf16 to f32
    // tanh path: 0.5*x*(1 + tanh(c*(x + ((a*x)*x)*x)))
    %ax = scalar.mulf %a, %x : f32
    %axx = scalar.mulf %ax, %x : f32
    %axxx = scalar.mulf %axx, %x : f32
    %cubic = scalar.addf %x, %axxx : f32
    %argument = scalar.mulf %c, %cubic : f32
    %t = scalar.tanhf<afn> %argument : f32
    %one_t = scalar.addf %one, %t : f32
    %half_x = scalar.mulf %half, %x : f32
    %gelu_t = scalar.mulf %half_x, %one_t : f32
    // erf path: 0.5*x*(1 + erf(x/sqrt(2)))
    %scaled = scalar.mulf %x, %inv_sqrt2 : f32
    %e = scalar.erff<afn> %scaled : f32
    %one_e = scalar.addf %one, %e : f32
    %gelu_e = scalar.mulf %half_x, %one_e : f32
    %use_tanh = index.cmp eq, %approximate, %c1 : index
    %gelu = scf.if %use_tanh -> (f32) {
      scf.yield %gelu_t : f32
    } else {
      scf.yield %gelu_e : f32
    }
    %result = scalar.fptrunc %gelu : f32 to bf16
    view.store %result, %output_view[%index] : bf16, view<[%size]xbf16>
  }
  kernel.return
}

// Requires --config=yah_vision_activate.size=8, .width=8, .approximate=1 (or 0).
//
// Inputs 0, 40, ..., 280. With width == size the bias index is the element index.
// Both transcedental paths saturate: tanh/erf return exactly 1.0, giving
// gelu(x) = 0.5*x*2 = x exactly, and gelu(0) = 0. Expected output is the input.
check.case public @yah_vision_activate_case {
  %input = check.generate.iota offset(0.0) step(40.0) : tensor<8xf32>
  %bias = check.generate.fill value(0.0) : tensor<8xf32>
  %output = check.generate.fill value(0.0) : tensor<8xbf16>
  %expected = check.generate.iota offset(0.0) step(40.0) : tensor<8xbf16>
  kernel.launch @yah_vision_activate(%input, %bias, %output) : (tensor<8xf32>, tensor<8xf32>, tensor<8xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xbf16>
  check.return
}

check.benchmark<@yah_vision_activate_case> @yah_vision_activate_bench
