// yah_conv_state: carry the short-conv state between prefill chunks.
// The conv kernels read, for token t < 3 of a chunk, the previous chunk's last
// inputs from state[c*4 + 1..3] (yah_ssm_conv: s2 = state[c*4+3] = x[-1],
// state[c*4+2] = x[-2], state[c*4+1] = x[-3]). After a chunk's conv, this
// writes the chunk's last three input rows there:
//   state[c*4 + 1 + j] = x[(batch - 3 + j) * channels + c],  j = 0..2
// Required config: --config=yah_conv_state.batch=B --config=yah_conv_state.channels=10240
amdgpu.target<gfx1151> @cs_w32 {subgroup_size = 32}
config.decl @yah_conv_state.batch : %value: index where [range(%value, 3, 1048576)]
config.decl @yah_conv_state.channels : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@cs_w32) @yah_conv_state() {
  %ch = config.get @yah_conv_state.channels : index
  %c1 = index.constant 1 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %t0 = index.add %ch, %c255 : index
  %wgs = index.div %t0, %c256 : index
  kernel.launch.config workgroups(%wgs, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%x: buffer, %state: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c256 = index.constant 256 : index
  %batch = config.get @yah_conv_state.batch : index
  %ch = config.get @yah_conv_state.channels : index
  %xtot = index.mul %batch, %ch : index
  %stot = index.mul %ch, %c4 : index
  %x_na, %s_na = buffer.assume.noalias %x, %state : buffer, buffer
  %xv = buffer.view %x_na[%base] : buffer -> view<[%xtot]xf32>
  %sv = buffer.view %s_na[%base] : buffer -> view<[%stot]xf32>
  %wg = kernel.workgroup.id<x> : index
  %tid = kernel.workitem.id<x> : index
  %c0w = index.mul %wg, %c256 : index
  %c = index.add %c0w, %tid : index
  %live = index.cmp ult, %c, %ch : index
  %ch1 = index.sub %ch, %c1 : index
  %cc = index.min %c, %ch1 : index
  %b3 = index.sub %batch, %c3 : index
  %s4 = index.mul %cc, %c4 : index
  scf.if %live {
    scf.for %j = [%c0 to %c3 step %c1] {
      %row = index.add %b3, %j : index
      %xr = index.mul %row, %ch : index
      %xa = index.add %xr, %cc : index
      %v = view.load %xv[%xa] : view<[%xtot]xf32> -> f32
      %sj = index.add %j, %c1 : index
      %sa = index.add %s4, %sj : index
      view.store %v, %sv[%sa] : f32, view<[%stot]xf32>
    }
  }
  kernel.return
}
