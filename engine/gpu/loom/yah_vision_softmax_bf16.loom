// YAH vision attention softmax, Loom port of Softmax in vision/encoder.hip.
//
// HIP source: models/qwen/vision/encoder.hip. One workgroup per row:
//
//   v[j]    = Round(Round(score[j]) * 0.1178511301977579)    (1/sqrt(72))
//   m       = max_j v[j]
//   e[j]    = expf(v[j] - m)
//   out[j]  = Bf16(e[j] / sum_j e[j])
//
// `Round` is `float(Bf16(x))`, so the score is rounded to the bf16 grid before and
// after the scale. The port spells both rounds out.
//
// The HIP kernel is templated on a compile-time value count for register-resident
// shapes and falls back to a strided loop otherwise. This port always uses the
// strided shape, one subgroup per row, with `kernel.subgroup.reduce` for the max
// and the sum instead of the 256-thread shared-memory trees. Same arithmetic.
//
// The check is exact. A uniform row makes every v equal, so the maximum cancels
// exactly, every exponential is exp(0) = 1, the sum is exactly the row length, and
// the output is exactly 1/length -- 0.125 at length 8, which bf16 holds exactly.
// The scale is multiplied by a constant `v` and then subtracted back out, so this
// does not independently verify it; what it verifies is the max/exp/sum/normalize
// structure, the two bf16 roundings on the path, and the row indexing.
//
// Required config: --config=yah_vision_softmax.rows=2
//                  --config=yah_vision_softmax.length=8
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_vision_softmax.rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_vision_softmax.length : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_vision_softmax() {
  %unit = index.constant 1 : index
  %rows = config.get @yah_vision_softmax.rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%scores: buffer, %probabilities: buffer) {
  %base = index.constant 0 : offset
  %c32 = index.constant 32 : index
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %scale = scalar.constant 0.11785113019775791 : f32
  %neg_infinite = scalar.constant -3.0000000000000001e+38 : f32
  %rows = config.get @yah_vision_softmax.rows : index
  %length = config.get @yah_vision_softmax.length : index
  %total = index.mul %rows, %length : index
  %scores_na, %prob_na = buffer.assume.noalias %scores, %probabilities : buffer, buffer
  %scores_view = buffer.view %scores_na[%base] : buffer -> view<[%rows]x[%length]xf32>
  %prob_view = buffer.view %prob_na[%base] : buffer -> view<[%rows]x[%length]xbf16>
  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %local_max = scf.for %j = [%lane to %length step %c32](%m = %neg_infinite : f32) -> (f32) {
    %s = view.load %scores_view[%row, %j] : view<[%rows]x[%length]xf32> -> f32
    %inner_narrow = scalar.fptrunc %s : f32 to bf16
    %inner = scalar.extf %inner_narrow : bf16 to f32
    %scaled = scalar.mulf %inner, %scale : f32
    %outer_narrow = scalar.fptrunc %scaled : f32 to bf16
    %v = scalar.extf %outer_narrow : bf16 to f32
    %bigger = scalar.maxnumf %m, %v : f32
    scf.yield %bigger : f32
  }
  %maximum = kernel.subgroup.reduce<maxnumf> %local_max : f32
  %local_sum = scf.for %k = [%lane to %length step %c32](%s2 = %zero : f32) -> (f32) {
    %s3 = view.load %scores_view[%row, %k] : view<[%rows]x[%length]xf32> -> f32
    %in3 = scalar.fptrunc %s3 : f32 to bf16
    %in3f = scalar.extf %in3 : bf16 to f32
    %sc3 = scalar.mulf %in3f, %scale : f32
    %out3 = scalar.fptrunc %sc3 : f32 to bf16
    %v3 = scalar.extf %out3 : bf16 to f32
    %shifted = scalar.subf %v3, %maximum : f32
    %e = scalar.expf<afn> %shifted : f32
    %next = scalar.addf %s2, %e : f32
    scf.yield %next : f32
  }
  %sum_all = kernel.subgroup.reduce<addf> %local_sum : f32
  %inverse = scalar.divf %one, %sum_all : f32
  %sink = scf.for %p = [%lane to %length step %c32](%mark = %zero : f32) -> (f32) {
    %s4 = view.load %scores_view[%row, %p] : view<[%rows]x[%length]xf32> -> f32
    %in4 = scalar.fptrunc %s4 : f32 to bf16
    %in4f = scalar.extf %in4 : bf16 to f32
    %sc4 = scalar.mulf %in4f, %scale : f32
    %out4 = scalar.fptrunc %sc4 : f32 to bf16
    %v4 = scalar.extf %out4 : bf16 to f32
    %shifted4 = scalar.subf %v4, %maximum : f32
    %e4 = scalar.expf<afn> %shifted4 : f32
    %normalized = scalar.mulf %e4, %inverse : f32
    %narrow = scalar.fptrunc %normalized : f32 to bf16
    view.store %narrow, %prob_view[%row, %p] : bf16, view<[%rows]x[%length]xbf16>
    scf.yield %mark : f32
  }
  kernel.return
}

// Requires --config=yah_vision_softmax.rows=2 --config=yah_vision_softmax.length=8.
check.case public @yah_vision_softmax_case {
  %scores = check.generate.fill value(1.0) : tensor<2x8xf32>
  %probabilities = check.generate.fill value(0.0) : tensor<2x8xbf16>
  %expected = check.generate.fill value(0.125) : tensor<2x8xbf16>
  kernel.launch @yah_vision_softmax(%scores, %probabilities) : (tensor<2x8xf32>, tensor<2x8xbf16>)
  check.expect.close actual(%probabilities) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x8xbf16>
  check.return
}

check.benchmark<@yah_vision_softmax_case> @yah_vision_softmax_bench
