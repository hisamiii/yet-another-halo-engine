// YAH DeltaNet row-split recurrence, Loom port of BatchedDeltaNetRowSplitKernel.
//
// HIP source: models/qwen/hip/kernels/ssm_row_split.hip. The HIP kernel is a
// templated register tile (kKeysPerLane, kRowsPerLane, prefetch, LDS staging) over
// a fixed 128x128 state. This port re-tiles it to one lane per state row with the
// full 128-key row in registers, which is the same arithmetic with no cross-lane
// reduction at all: kKeysPerLane = 128 makes kLanesPerRow = 1, and RowReduce2
// degenerates to a no-op. The `seg == 0` store guard is therefore always taken.
// Tiling is what the HIP kernel's own comments tune; coverage is what this port
// owes, and this form is the one whose correctness is checkable analytically.
//
// Per token t and head h, with kh = h % num_key_heads and one lane per state row:
//
//   alpha, beta = ab[t][h]                     (from BatchedDeltaNetPrepAlphaBeta)
//   inv_k, q_scale, kq3 = kq_scales[t][kh]     (from BatchedDeltaNetPrepKq)
//   kq_dot = inv_k * q_scale * kq3
//   q[i]   = conv_out[t][kh][i]                q comes first in the qkv layout
//   k[i]   = conv_out[t][num_key_heads + kh][i]
//   v      = conv_out[t][2*num_key_heads + h][row]
//   u = sum_i (alpha*s[i])*k[i]
//   p = sum_i (alpha*s[i])*q[i]
//   d = (v - u*inv_k) * beta
//   raw_out[t][h][row] = p*q_scale + d*kq_dot          (seg == 0, so every lane)
//   s[i] = alpha*s[i] + (d*inv_k)*k[i]
//
// The state is read and written in place through the state buffer, so the kernel
// needs no persistent register tile and each token re-reads the row it updates.
// That is more global traffic than the HIP tile and is deliberate: tuning is
// deferred, and this form makes the recurrence's data flow explicit.
//
// The state buffer is one layer's worth, [num_heads][128][128]; the HIP kernel
// takes a layer index and offsets internally, which a caller reproduces by
// offsetting the pointer.
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_deltanet.batch : %value: index where [range(%value, 1, 1048576)]
config.decl @yah_deltanet.qkv_size : %value: index where [range(%value, 128, 1048576)]
config.decl @yah_deltanet.inner_size : %value: index where [range(%value, 128, 1048576)]
config.decl @yah_deltanet.num_key_heads : %value: index where [range(%value, 1, 4096)]
config.decl @yah_deltanet.num_heads : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_wave32) @yah_deltanet() {
  %unit = index.constant 1 : index
  %c128 = index.constant 128 : index
  %num_heads = config.get @yah_deltanet.num_heads : index
  kernel.launch.config workgroups(%num_heads, %unit, %unit) workgroup_size(%c128, %unit, %unit) : index
} launch(%conv: buffer, %kq: buffer, %ab: buffer, %state: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c128 = index.constant 128 : index
  %c16384 = index.constant 16384 : index
  %zero = scalar.constant 0.0 : f32
  %batch = config.get @yah_deltanet.batch : index
  %qkv_size = config.get @yah_deltanet.qkv_size : index
  %inner_size = config.get @yah_deltanet.inner_size : index
  %num_key_heads = config.get @yah_deltanet.num_key_heads : index
  %num_heads = config.get @yah_deltanet.num_heads : index
  %conv_total = index.mul %batch, %qkv_size : index
  %kq_total = index.mul %batch, %num_key_heads : index
  %kq_total3 = index.mul %kq_total, %c3 : index
  %ab_total = index.mul %batch, %num_heads : index
  %ab_total2 = index.mul %ab_total, %c2 : index
  %state_total = index.mul %num_heads, %c16384 : index
  %out_total = index.mul %batch, %inner_size : index
  %conv_noalias, %kq_noalias, %ab_noalias, %state_noalias, %out_noalias = buffer.assume.noalias %conv, %kq, %ab, %state, %out : buffer, buffer, buffer, buffer, buffer
  %conv_view = buffer.view %conv_noalias[%base] : buffer -> view<[%conv_total]xf32>
  %kq_view = buffer.view %kq_noalias[%base] : buffer -> view<[%kq_total3]xf32>
  %ab_view = buffer.view %ab_noalias[%base] : buffer -> view<[%ab_total2]xf32>
  %state_view = buffer.view %state_noalias[%base] : buffer -> view<[%state_total]xf32>
  %out_view = buffer.view %out_noalias[%base] : buffer -> view<[%out_total]xf32>
  %h = kernel.workgroup.id<x> : index
  %row = kernel.workitem.id<x> : index
  %kh = index.rem %h, %num_key_heads : index
  %state_base0 = index.mul %h, %c16384 : index
  %row_k = index.mul %row, %c128 : index
  %state_row = index.add %state_base0, %row_k : index
  %sink = scf.for %t = [%c0 to %batch step %c1](%mark = %zero : f32) -> (f32) {
    %conv_t = index.mul %t, %qkv_size : index
    %q_row = index.mul %kh, %c128 : index
    %q_off = index.add %conv_t, %q_row : index
    %k_head = index.add %num_key_heads, %kh : index
    %k_row = index.mul %k_head, %c128 : index
    %k_off = index.add %conv_t, %k_row : index
    %v_heads = index.mul %num_key_heads, %c2 : index
    %v_head = index.add %v_heads, %h : index
    %v_row0 = index.mul %v_head, %c128 : index
    %v_off = index.add %conv_t, %v_row0 : index
    %v_off_row = index.add %v_off, %row : index
    %ab_t = index.mul %t, %num_heads : index
    %ab_h = index.add %ab_t, %h : index
    %ab_off = index.mul %ab_h, %c2 : index
    %ab_off1 = index.add %ab_off, %c1 : index
    %alpha = view.load %ab_view[%ab_off] : view<[%ab_total2]xf32> -> f32
    %beta = view.load %ab_view[%ab_off1] : view<[%ab_total2]xf32> -> f32
    %kq_t = index.mul %t, %num_key_heads : index
    %kq_base = index.add %kq_t, %kh : index
    %kq_off = index.mul %kq_base, %c3 : index
    %kq_off1 = index.add %kq_off, %c1 : index
    %kq_off2 = index.add %kq_off, %c2 : index
    %inv_k = view.load %kq_view[%kq_off] : view<[%kq_total3]xf32> -> f32
    %q_scale = view.load %kq_view[%kq_off1] : view<[%kq_total3]xf32> -> f32
    %kq3 = view.load %kq_view[%kq_off2] : view<[%kq_total3]xf32> -> f32
    %kq_dot = scalar.mulf %inv_k, %q_scale : f32
    %kq_dot2 = scalar.mulf %kq_dot, %kq3 : f32
    %v = view.load %conv_view[%v_off_row] : view<[%conv_total]xf32> -> f32
    %u, %p = scf.for %i = [%c0 to %c128 step %c1](%ua = %zero : f32, %pa = %zero : f32) -> (f32, f32) {
      %s_idx = index.add %state_row, %i : index
      %k_idx = index.add %k_off, %i : index
      %q_idx = index.add %q_off, %i : index
      %s = view.load %state_view[%s_idx] : view<[%state_total]xf32> -> f32
      %kk = view.load %conv_view[%k_idx] : view<[%conv_total]xf32> -> f32
      %qq = view.load %conv_view[%q_idx] : view<[%conv_total]xf32> -> f32
      %sa = scalar.mulf %s, %alpha : f32
      %uk = scalar.mulf %sa, %kk : f32
      %pq = scalar.mulf %sa, %qq : f32
      %u2 = scalar.addf %ua, %uk : f32
      %p2 = scalar.addf %pa, %pq : f32
      scf.yield %u2, %p2 : f32, f32
    }
    %u_inv = scalar.mulf %u, %inv_k : f32
    %v_minus = scalar.subf %v, %u_inv : f32
    %d = scalar.mulf %v_minus, %beta : f32
    %p_scaled = scalar.mulf %p, %q_scale : f32
    %d_kq = scalar.mulf %d, %kq_dot2 : f32
    %o = scalar.addf %p_scaled, %d_kq : f32
    %out_t = index.mul %t, %inner_size : index
    %out_h = index.mul %h, %c128 : index
    %out_base = index.add %out_t, %out_h : index
    %out_idx = index.add %out_base, %row : index
    view.store %o, %out_view[%out_idx] : f32, view<[%out_total]xf32>
    %dk = scalar.mulf %d, %inv_k : f32
    %sink2 = scf.for %j = [%c0 to %c128 step %c1](%m2 = %zero : f32) -> (f32) {
      %js_idx = index.add %state_row, %j : index
      %jk_idx = index.add %k_off, %j : index
      %sj = view.load %state_view[%js_idx] : view<[%state_total]xf32> -> f32
      %kj = view.load %conv_view[%jk_idx] : view<[%conv_total]xf32> -> f32
      %sja = scalar.mulf %sj, %alpha : f32
      %kjdk = scalar.mulf %dk, %kj : f32
      %sj_new = scalar.addf %sja, %kjdk : f32
      view.store %sj_new, %state_view[%js_idx] : f32, view<[%state_total]xf32>
      scf.yield %m2 : f32
    }
    scf.yield %mark : f32
  }
  kernel.return
}

// Requires --config=yah_deltanet.batch=2, .qkv_size=384, .inner_size=128,
// .num_key_heads=1, .num_heads=1.
//
// All-ones inputs. With one head and one key head, s[i] = sigma is uniform across
// the row, so u = p = 128*sigma and
//
//   d     = (v - u*inv_k)*beta = (1 - 128*sigma)
//   out   = p*q_scale + d*kq_dot = 128*sigma + (1 - 128*sigma) = 1
//   sigma' = sigma + d*inv_k = 1 - 127*sigma
//
// so the output is 1 for every token and the state walks 1 -> -126 -> 16003. Every
// value is an exact f32 integer, so the expectation is exact rather than tolerant.
// The state expectation is what proves the token loop ran twice: a bug that
// stopped after one token would leave -126.
check.case public @yah_deltanet_case {
  %conv = check.generate.fill value(1.0) : tensor<768xf32>
  %kq = check.generate.fill value(1.0) : tensor<6xf32>
  %ab = check.generate.fill value(1.0) : tensor<4xf32>
  %state = check.generate.fill value(1.0) : tensor<16384xf32>
  %out = check.generate.fill value(0.0) : tensor<256xf32>
  %expected_out = check.generate.fill value(1.0) : tensor<256xf32>
  %expected_state = check.generate.fill value(16003.0) : tensor<16384xf32>
  kernel.launch @yah_deltanet(%conv, %kq, %ab, %state, %out) : (tensor<768xf32>, tensor<6xf32>, tensor<4xf32>, tensor<16384xf32>, tensor<256xf32>)
  check.expect.close actual(%out) expected(%expected_out) atol(0.0) rtol(0.0) nan(same) : tensor<256xf32>
  check.expect.close actual(%state) expected(%expected_state) atol(0.0) rtol(0.0) nan(same) : tensor<16384xf32>
  check.return
}

check.benchmark<@yah_deltanet_case> @yah_deltanet_bench

// Requires --config=yah_deltanet.batch=512, .qkv_size=1536, .inner_size=1024,
// .num_key_heads=2, .num_heads=8.
//
// Production-shaped, and still exact. ab is an iota with period 2, so every pair
// is (alpha, beta) = (0, 1). With alpha = 0 the readout u = sum_i (alpha*s[i])*k[i]
// is zero whatever the state holds, which decouples the trajectory from its own
// history and keeps it bounded for any batch:
//
//   u = p = 0
//   d = (v - 0)*beta = 1
//   out = 0*q_scale + 1*kq_dot = 1
//   s[i] = 0*s[i] + (d*inv_k)*k[i] = 1
//
// so the state converges to 1 after the first token and stays there, and every
// output is 1. The 2-token case above is what proves the state dependence; this one
// proves the port holds at a real shape and gives a number worth reading. Heads are
// not uniform here (num_heads = 4 x num_key_heads, so kh = h % 2 selects two
// different q/k rows), which exercises the head indexing the small case cannot.
check.case public @yah_deltanet_scaled {
  %conv = check.generate.fill value(1.0) : tensor<786432xf32>
  %kq = check.generate.fill value(1.0) : tensor<3072xf32>
  %ab = check.generate.iota offset(0.0) step(1.0) period(2) : tensor<8192xf32>
  %state = check.generate.fill value(0.0) : tensor<131072xf32>
  %out = check.generate.fill value(0.0) : tensor<524288xf32>
  %expected_out = check.generate.fill value(1.0) : tensor<524288xf32>
  %expected_state = check.generate.fill value(1.0) : tensor<131072xf32>
  kernel.launch @yah_deltanet(%conv, %kq, %ab, %state, %out) : (tensor<786432xf32>, tensor<3072xf32>, tensor<8192xf32>, tensor<131072xf32>, tensor<524288xf32>)
  check.expect.close actual(%out) expected(%expected_out) atol(0.0) rtol(0.0) nan(same) : tensor<524288xf32>
  check.expect.close actual(%state) expected(%expected_state) atol(0.0) rtol(0.0) nan(same) : tensor<131072xf32>
  check.return
}

check.benchmark<@yah_deltanet_scaled> @yah_deltanet_scaled_bench
