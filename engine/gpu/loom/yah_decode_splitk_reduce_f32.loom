// YAH decode split-K attention reduce, Loom port of
// QwenDecodeSplitKAttentionReduceKernel (attention_decode.hip).
//
// One workgroup per (query head, row), 32 lanes, same lane/dimension map as the
// partials kernel. It combines the per-split statistics and unnormalised contexts
// written by yah_decode_splitk_partials_f16:
//
//   global_max = max over splits of stats[split].max
//   global_sum = sum over splits of stats[split].sum * exp(stats[split].max - global_max)
//   ctx[d]     = sum over splits of partial[split][d] * exp(stats[split].max - global_max)
//   out[d]     = ctx[d] / global_sum * sigmoid(gate[d])
//
// The scratch layout is the one the partials kernel documents; pi is
// head*max_splits + split and the row stride is num_heads*max_splits*(head_dim+2).
//
// Required config: --config=yah_decode_splitk_reduce.num_heads=2
//                  --config=yah_decode_splitk_reduce.head_dim=256
//                  --config=yah_decode_splitk_reduce.rows=1
//                  --config=yah_decode_splitk_reduce.splits=2
//                  --config=yah_decode_splitk_reduce.max_splits=2
//                  --config=yah_decode_splitk_reduce.has_gate=1
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_decode_splitk_reduce.num_heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_decode_splitk_reduce.head_dim : %value: index where [range(%value, 1, 1024)]

config.decl @yah_decode_splitk_reduce.rows : %value: index where [range(%value, 1, 4096)]

config.decl @yah_decode_splitk_reduce.splits : %value: index where [range(%value, 1, 4096)]

config.decl @yah_decode_splitk_reduce.max_splits : %value: index where [range(%value, 1, 4096)]

config.decl @yah_decode_splitk_reduce.has_gate : %value: index where [range(%value, 0, 1)]

kernel.def target(@yah_wave32) @yah_decode_splitk_reduce() {
  %unit = index.constant 1 : index
  %num_heads = config.get @yah_decode_splitk_reduce.num_heads : index
  %rows = config.get @yah_decode_splitk_reduce.rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%num_heads, %rows, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%gate: buffer, %scratch: buffer, %out: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c128 = index.constant 128 : index
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %neg_inf = scalar.constant -3.0000000000000001e+38 : f32
  %num_heads = config.get @yah_decode_splitk_reduce.num_heads : index
  %head_dim = config.get @yah_decode_splitk_reduce.head_dim : index
  %rows = config.get @yah_decode_splitk_reduce.rows : index
  %splits = config.get @yah_decode_splitk_reduce.splits : index
  %max_splits = config.get @yah_decode_splitk_reduce.max_splits : index
  %has_gate_flag = config.get @yah_decode_splitk_reduce.has_gate : index
  %has_gate = index.cmp eq, %has_gate_flag, %c1 : index
  %q_width = index.mul %num_heads, %head_dim : index
  %out_total = index.mul %rows, %q_width : index
  %stats_elems = index.mul %num_heads, %max_splits : index
  %stats_elems2 = index.mul %stats_elems, %c2 : index
  %hd2 = index.add %head_dim, %c2 : index
  %row_stride = index.mul %num_heads, %max_splits : index
  %row_stride2 = index.mul %row_stride, %hd2 : index
  %scratch_elems = index.mul %rows, %row_stride2 : index
  %gate_na, %s_na, %out_na = buffer.assume.noalias %gate, %scratch, %out : buffer, buffer, buffer
  %gate_view = buffer.view %gate_na[%base] : buffer -> view<[%out_total]xf32>
  %s_view = buffer.view %s_na[%base] : buffer -> view<[%scratch_elems]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%out_total]xf32>
  %head = kernel.workgroup.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %head_off = index.mul %head, %head_dim : index
  %row_off = index.mul %row, %q_width : index
  %q_base = index.add %row_off, %head_off : index
  %srow = index.mul %row, %row_stride2 : index
  %pi0 = index.mul %head, %max_splits : index
  %part_base = index.add %srow, %stats_elems2 : index
  %lane4 = index.mul %lane, %c4 : index
  %qa = index.add %q_base, %lane4 : index
  %qb = index.add %qa, %c128 : index
  %gmax = scf.for %split = [%c0 to %splits step %c1](%g = %neg_inf : f32) -> (f32) {
    %pi = index.add %pi0, %split : index
    %mi = index.mul %pi, %c2 : index
    %moff = index.add %srow, %mi : index
    %mv = view.load %s_view[%moff] : view<[%scratch_elems]xf32> -> f32
    %ng = scalar.maxnumf %g, %mv : f32
    scf.yield %ng : f32
  }
  %gsum, %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7 = scf.for %split2 = [%c0 to %splits step %c1](%gs = %zero : f32, %a0 = %zero : f32, %a1 = %zero : f32, %a2 = %zero : f32, %a3 = %zero : f32, %a4 = %zero : f32, %a5 = %zero : f32, %a6 = %zero : f32, %a7 = %zero : f32) -> (f32, f32, f32, f32, f32, f32, f32, f32, f32) {
    %pi = index.add %pi0, %split2 : index
    %mi = index.mul %pi, %c2 : index
    %moff = index.add %srow, %mi : index
    %mv = view.load %s_view[%moff] : view<[%scratch_elems]xf32> -> f32
    %si = index.add %mi, %c1 : index
    %soff = index.add %srow, %si : index
    %sv = view.load %s_view[%soff] : view<[%scratch_elems]xf32> -> f32
    %d = scalar.subf %mv, %gmax : f32
    %ps = scalar.expf<afn> %d : f32
    %svs = scalar.mulf %sv, %ps : f32
    %ngs = scalar.addf %gs, %svs : f32
    %pihd = index.mul %pi, %head_dim : index
    %pbase = index.add %part_base, %pihd : index
    %pa = index.add %pbase, %lane4 : index
    %pa_1 = index.add %pa, %c1 : index
    %pa_2 = index.add %pa_1, %c1 : index
    %pa_3 = index.add %pa_2, %c1 : index
    %pb = index.add %pa, %c128 : index
    %pb_1 = index.add %pb, %c1 : index
    %pb_2 = index.add %pb_1, %c1 : index
    %pb_3 = index.add %pb_2, %c1 : index
    %pp0 = view.load %s_view[%pa] : view<[%scratch_elems]xf32> -> f32
    %pp1 = view.load %s_view[%pa_1] : view<[%scratch_elems]xf32> -> f32
    %pp2 = view.load %s_view[%pa_2] : view<[%scratch_elems]xf32> -> f32
    %pp3 = view.load %s_view[%pa_3] : view<[%scratch_elems]xf32> -> f32
    %pp4 = view.load %s_view[%pb] : view<[%scratch_elems]xf32> -> f32
    %pp5 = view.load %s_view[%pb_1] : view<[%scratch_elems]xf32> -> f32
    %pp6 = view.load %s_view[%pb_2] : view<[%scratch_elems]xf32> -> f32
    %pp7 = view.load %s_view[%pb_3] : view<[%scratch_elems]xf32> -> f32
    %n0 = scalar.mulf %pp0, %ps : f32
    %n1 = scalar.mulf %pp1, %ps : f32
    %n2 = scalar.mulf %pp2, %ps : f32
    %n3 = scalar.mulf %pp3, %ps : f32
    %n4 = scalar.mulf %pp4, %ps : f32
    %n5 = scalar.mulf %pp5, %ps : f32
    %n6 = scalar.mulf %pp6, %ps : f32
    %n7 = scalar.mulf %pp7, %ps : f32
    %b0 = scalar.addf %a0, %n0 : f32
    %b1 = scalar.addf %a1, %n1 : f32
    %b2 = scalar.addf %a2, %n2 : f32
    %b3 = scalar.addf %a3, %n3 : f32
    %b4 = scalar.addf %a4, %n4 : f32
    %b5 = scalar.addf %a5, %n5 : f32
    %b6 = scalar.addf %a6, %n6 : f32
    %b7 = scalar.addf %a7, %n7 : f32
    scf.yield %ngs, %b0, %b1, %b2, %b3, %b4, %b5, %b6, %b7 : f32, f32, f32, f32, f32, f32, f32, f32, f32
  }
  %inv = scalar.divf %one, %gsum : f32
  %qa_1 = index.add %qa, %c1 : index
  %qa_2 = index.add %qa_1, %c1 : index
  %qa_3 = index.add %qa_2, %c1 : index
  %qb_1 = index.add %qb, %c1 : index
  %qb_2 = index.add %qb_1, %c1 : index
  %qb_3 = index.add %qb_2, %c1 : index
  %inv0 = scalar.mulf %r0, %inv : f32
  %g0 = view.load %gate_view[%qa] : view<[%out_total]xf32> -> f32
  %ng0 = scalar.mulf %g0, %negone : f32
  %eg0 = scalar.expf<afn> %ng0 : f32
  %dg0 = scalar.addf %one, %eg0 : f32
  %sg0 = scalar.divf %one, %dg0 : f32
  %rg0 = scalar.mulf %inv0, %sg0 : f32
  %res0 = scf.if %has_gate -> (f32) {
    scf.yield %rg0 : f32
  } else {
    scf.yield %inv0 : f32
  }
  view.store %res0, %out_view[%qa] : f32, view<[%out_total]xf32>
  %inv1 = scalar.mulf %r1, %inv : f32
  %g1 = view.load %gate_view[%qa_1] : view<[%out_total]xf32> -> f32
  %ng1 = scalar.mulf %g1, %negone : f32
  %eg1 = scalar.expf<afn> %ng1 : f32
  %dg1 = scalar.addf %one, %eg1 : f32
  %sg1 = scalar.divf %one, %dg1 : f32
  %rg1 = scalar.mulf %inv1, %sg1 : f32
  %res1 = scf.if %has_gate -> (f32) {
    scf.yield %rg1 : f32
  } else {
    scf.yield %inv1 : f32
  }
  view.store %res1, %out_view[%qa_1] : f32, view<[%out_total]xf32>
  %inv2 = scalar.mulf %r2, %inv : f32
  %g2 = view.load %gate_view[%qa_2] : view<[%out_total]xf32> -> f32
  %ng2 = scalar.mulf %g2, %negone : f32
  %eg2 = scalar.expf<afn> %ng2 : f32
  %dg2 = scalar.addf %one, %eg2 : f32
  %sg2 = scalar.divf %one, %dg2 : f32
  %rg2 = scalar.mulf %inv2, %sg2 : f32
  %res2 = scf.if %has_gate -> (f32) {
    scf.yield %rg2 : f32
  } else {
    scf.yield %inv2 : f32
  }
  view.store %res2, %out_view[%qa_2] : f32, view<[%out_total]xf32>
  %inv3 = scalar.mulf %r3, %inv : f32
  %g3 = view.load %gate_view[%qa_3] : view<[%out_total]xf32> -> f32
  %ng3 = scalar.mulf %g3, %negone : f32
  %eg3 = scalar.expf<afn> %ng3 : f32
  %dg3 = scalar.addf %one, %eg3 : f32
  %sg3 = scalar.divf %one, %dg3 : f32
  %rg3 = scalar.mulf %inv3, %sg3 : f32
  %res3 = scf.if %has_gate -> (f32) {
    scf.yield %rg3 : f32
  } else {
    scf.yield %inv3 : f32
  }
  view.store %res3, %out_view[%qa_3] : f32, view<[%out_total]xf32>
  %inv4 = scalar.mulf %r4, %inv : f32
  %g4 = view.load %gate_view[%qb] : view<[%out_total]xf32> -> f32
  %ng4 = scalar.mulf %g4, %negone : f32
  %eg4 = scalar.expf<afn> %ng4 : f32
  %dg4 = scalar.addf %one, %eg4 : f32
  %sg4 = scalar.divf %one, %dg4 : f32
  %rg4 = scalar.mulf %inv4, %sg4 : f32
  %res4 = scf.if %has_gate -> (f32) {
    scf.yield %rg4 : f32
  } else {
    scf.yield %inv4 : f32
  }
  view.store %res4, %out_view[%qb] : f32, view<[%out_total]xf32>
  %inv5 = scalar.mulf %r5, %inv : f32
  %g5 = view.load %gate_view[%qb_1] : view<[%out_total]xf32> -> f32
  %ng5 = scalar.mulf %g5, %negone : f32
  %eg5 = scalar.expf<afn> %ng5 : f32
  %dg5 = scalar.addf %one, %eg5 : f32
  %sg5 = scalar.divf %one, %dg5 : f32
  %rg5 = scalar.mulf %inv5, %sg5 : f32
  %res5 = scf.if %has_gate -> (f32) {
    scf.yield %rg5 : f32
  } else {
    scf.yield %inv5 : f32
  }
  view.store %res5, %out_view[%qb_1] : f32, view<[%out_total]xf32>
  %inv6 = scalar.mulf %r6, %inv : f32
  %g6 = view.load %gate_view[%qb_2] : view<[%out_total]xf32> -> f32
  %ng6 = scalar.mulf %g6, %negone : f32
  %eg6 = scalar.expf<afn> %ng6 : f32
  %dg6 = scalar.addf %one, %eg6 : f32
  %sg6 = scalar.divf %one, %dg6 : f32
  %rg6 = scalar.mulf %inv6, %sg6 : f32
  %res6 = scf.if %has_gate -> (f32) {
    scf.yield %rg6 : f32
  } else {
    scf.yield %inv6 : f32
  }
  view.store %res6, %out_view[%qb_2] : f32, view<[%out_total]xf32>
  %inv7 = scalar.mulf %r7, %inv : f32
  %g7 = view.load %gate_view[%qb_3] : view<[%out_total]xf32> -> f32
  %ng7 = scalar.mulf %g7, %negone : f32
  %eg7 = scalar.expf<afn> %ng7 : f32
  %dg7 = scalar.addf %one, %eg7 : f32
  %sg7 = scalar.divf %one, %dg7 : f32
  %rg7 = scalar.mulf %inv7, %sg7 : f32
  %res7 = scf.if %has_gate -> (f32) {
    scf.yield %rg7 : f32
  } else {
    scf.yield %inv7 : f32
  }
  view.store %res7, %out_view[%qb_3] : f32, view<[%out_total]xf32>
  kernel.return
}

// Requires the config block above with rows=1, splits=2, max_splits=2, has_gate=1.
check.case public @yah_decode_splitk_reduce_case {
  %gate = check.file.read.npy path("fixtures/decode_splitk/input_gate.npy") : tensor<512xf32>
  %scratch = check.file.read.npy path("fixtures/decode_splitk/scratch.npy") : tensor<1032xf32>
  %expected = check.file.read.npy path("fixtures/decode_splitk/expected.npy") : tensor<512xf32>
  %out = check.generate.fill value(0.0) : tensor<512xf32>
  kernel.launch @yah_decode_splitk_reduce(%gate, %scratch, %out) : (tensor<512xf32>, tensor<1032xf32>, tensor<512xf32>)
  check.expect.close actual(%out) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<512xf32>
  check.return
}

check.benchmark<@yah_decode_splitk_reduce_case> @yah_decode_splitk_reduce_bench
