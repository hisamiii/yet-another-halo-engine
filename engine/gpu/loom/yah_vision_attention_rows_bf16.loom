// YAH vision attention row transpose, Loom port of AttentionRows.
//
// HIP source: models/qwen/vision/encoder.hip. The attention kernels produce a
// head-major buffer; this pass transposes it into the token-major hidden layout the
// rest of the encoder reads:
//
//   out[(begin + token)*kHidden + head*kHeadDim + d]
//       = Bf16(in[(head*rows + token)*kHeadDim + d])
//
// The HIP kernel derives token, head and d from one flat index with a division and
// two modulos by kHidden and kHeadDim. This port makes head and token grid
// coordinates and the head dimension the lane, with three-dimensional views, so no
// index division appears; `begin` is a config that shifts the token row.
//
// The expectation is a permutation of the source, and bf16 has no numpy dtype, so it
// is stored as raw 16-bit patterns and compared through `check.tensor.view`.
//
// Required config: --config=yah_vision_attention_rows.heads=2
//                  --config=yah_vision_attention_rows.head_dim=3
//                  --config=yah_vision_attention_rows.rows=2
//                  --config=yah_vision_attention_rows.begin=0
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_vision_attention_rows.heads : %value: index where [range(%value, 1, 4096)]

config.decl @yah_vision_attention_rows.head_dim : %value: index where [range(%value, 1, 4096)]

config.decl @yah_vision_attention_rows.rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_vision_attention_rows.begin : %value: index where [range(%value, 0, 65536)]

kernel.def target(@yah_wave32) @yah_vision_attention_rows() {
  %unit = index.constant 1 : index
  %heads = config.get @yah_vision_attention_rows.heads : index
  %head_dim = config.get @yah_vision_attention_rows.head_dim : index
  %rows = config.get @yah_vision_attention_rows.rows : index
  %begin = config.get @yah_vision_attention_rows.begin : index
  %hidden = index.mul %heads, %head_dim : index
  %tokens = index.add %begin, %rows : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%heads, %rows, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %heads = config.get @yah_vision_attention_rows.heads : index
  %head_dim = config.get @yah_vision_attention_rows.head_dim : index
  %rows = config.get @yah_vision_attention_rows.rows : index
  %begin = config.get @yah_vision_attention_rows.begin : index
  %hidden = index.mul %heads, %head_dim : index
  %tokens = index.add %begin, %rows : index
  %in_total = index.mul %heads, %rows : index
  %in_elems = index.mul %in_total, %head_dim : index
  %out_elems = index.mul %tokens, %hidden : index
  %in_na, %out_na = buffer.assume.noalias %input, %output : buffer, buffer
  %in_view = buffer.view %in_na[%base] : buffer -> view<[%heads]x[%rows]x[%head_dim]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%tokens]x[%heads]x[%head_dim]xbf16>
  %head = kernel.workgroup.id<x> : index
  %token = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.add %begin, %token : index
  // One workgroup per (head, token); the lanes cover head_dim, striding if it
  // exceeds the workgroup. head is a grid dimension, not the lane coordinate.
  %c256b = index.constant 256 : index
  %sink = scf.for %d = [%lane to %head_dim step %c256b](%mark = %lane : index) -> (index) {
    %v = view.load %in_view[%head, %token, %d] : view<[%heads]x[%rows]x[%head_dim]xf32> -> f32
    %narrow = scalar.fptrunc %v : f32 to bf16
    view.store %narrow, %out_view[%row, %head, %d] : bf16, view<[%tokens]x[%heads]x[%head_dim]xbf16>
    scf.yield %mark : index
  }
  kernel.return
}

// Requires --config=yah_vision_attention_rows.heads=2, .head_dim=3, .rows=2, .begin=0.
check.case public @yah_vision_attention_rows_case {
  %input = check.generate.iota offset(0.0) step(1.0) : tensor<2x2x3xf32>
  %output = check.generate.fill value(0.0) : tensor<2x2x3xbf16>
  %expected = check.file.read.npy path("fixtures/vision_attention_rows/expected_bits.npy") : tensor<12xi16>
  kernel.launch @yah_vision_attention_rows(%input, %output) : (tensor<2x2x3xf32>, tensor<2x2x3xbf16>)
  %actual_bits = check.tensor.view %output offset(0) : tensor<2x2x3xbf16> -> tensor<12xi16>
  check.expect.equal actual(%actual_bits) expected(%expected) : tensor<12xi16>
  check.return
}

check.benchmark<@yah_vision_attention_rows_case> @yah_vision_attention_rows_bench
