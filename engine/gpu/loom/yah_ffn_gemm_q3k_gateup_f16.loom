// YAH FFN GEMM with in-kernel Q3_K decode and the paired gate/up SwiGLU
// epilogue, Loom port of HalfPrefillGemmKernel<..., kQ3_K, kGateUp>.
//
// HIP source: prefill_fp16.hip. Two Q3_K GEMMs share one activation tile and
// one output, each with its own decoder, accumulator group and staging buffer:
//
//   gate_acc[row][token] = sum_k q3k_decode(gate_w, row, k) * f16(A[token][k])
//   up_acc[row][token]   = sum_k q3k_decode(up_w,   row, k) * f16(A[token][k])
//   out[token*m + row]   = round_f16(silu(gate_acc) * up_acc)
//
// Same-format paired arm. 3 FFN layer(s) of the shard use Q3_K for both
// gate and up. Generated from yah_ffn_gemm_q3k_gateup_f16.loom by replacing both
// decode bodies with the verified yah_ffn_gemm_q3k_f32 decode and setting the
// per-tile sizes.
//
// Measured: 25.49 ms at m_tiles=1088 (production 17408 rows). 0.985 ms at
// m_tiles=1. Both decoders and the combine are untuned; the same deferred levers
// as the other format ports apply.
//
// Correctness case: both weights are the packed Q3_K fixture and the activation
// is 0.25, chosen so the accumulators sit near +-2..10 and silu is non-trivial.
// The expected is round_f16(silu(acc) * acc). The production-size case uses
// all-zero weights, so every output is zero.
//
// Required config (correctness): --config=yah_ffn_gemm_q3k_gateup.m_tiles=1
// Required config (benchmark):   --config=yah_ffn_gemm_q3k_gateup.m_tiles=1088
amdgpu.target<gfx1151> @yah_gemm_wave32 {subgroup_size = 32}

config.decl @yah_ffn_gemm_q3k_gateup.m_tiles : %value: index where [range(%value, 1, 4096)]

kernel.def target(@yah_gemm_wave32) @yah_ffn_gemm_q3k_gateup() {
  %unit = index.constant 1 : index
  %m_tiles = config.get @yah_ffn_gemm_q3k_gateup.m_tiles : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_tiles, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%gate_weight: buffer, %up_weight: buffer, %input: buffer, %gwstage: buffer, %uwstage: buffer, %ogate: buffer, %oup: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c5120 = index.constant 5120 : index
  %c2880 = index.constant 2880 : index
  %c17600 = index.constant 17600 : index
  %c35200 = index.constant 35200 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c2i = scalar.constant 2 : i32
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c7i = scalar.constant 7 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c54i = scalar.constant 54 : i32
  %c63i = scalar.constant 63 : i32
  %c96i = scalar.constant 96 : i32
  %c110i = scalar.constant 110 : i32
  %c255i = scalar.constant 255 : i32
  %c2200i = scalar.constant 2200 : i32
  %one = scalar.constant 1.0 : f32
  %negone = scalar.constant -1.0 : f32
  %m_tiles = config.get @yah_ffn_gemm_q3k_gateup.m_tiles : index
  %m_rows = index.mul %m_tiles, %c16 : index
  %w_bytes = index.mul %m_tiles, %c35200 : index
  %w_halfs = index.mul %m_tiles, %c17600 : index
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %out_total = index.mul %m_rows, %c64 : index
  %stage_rows = index.mul %m_tiles, %c16 : index
  %stage_last = index.sub %stage_rows, %c1 : index
  %a_layout = encoding.layout.strided [1, 5120] : encoding<layout>
  %gate_weight_na, %up_weight_na, %input_na, %gwstage_na, %uwstage_na, %ogate_na, %oup_na, %output_na = buffer.assume.noalias %gate_weight, %up_weight, %input, %gwstage, %uwstage, %ogate, %oup, %output : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %gw_view = buffer.view %gate_weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %gw_f16_view = buffer.view %gate_weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %uw_view = buffer.view %up_weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %uw_f16_view = buffer.view %up_weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %a_t_view = buffer.view %input_na[%base] : buffer -> view<5120x64xf16, %a_layout>
  %out_view = buffer.view %output_na[%base] : buffer -> view<[%out_total]xf16>
  %gwstage_view = buffer.view %gwstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %uwstage_view = buffer.view %uwstage_na[%base] : buffer -> view<[%stage_rows]x5120xf16>
  %ogate_view = buffer.view %ogate_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %oup_view = buffer.view %oup_na[%base] : buffer -> view<[%stage_rows]x64xf32>
  %wg_x = kernel.workgroup.id<x> : index
  %m_origin = index.mul %wg_x, %c16 : index
  %lane = kernel.workitem.id<x> : index
  %lane_i = index.cast %lane : index to i32
  %m_origin_i = index.cast %m_origin : index to i32
  %zeros = vector.constant 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zeros shape [%m, %n] : vector<8xf32>
  %g0, %g1, %g2, %g3, %u0, %u1, %u2, %u3 = scf.for %kk = [%c0 to %c5120 step %c16](%ag0 = %init : vector<8xf32>, %ag1 = %init : vector<8xf32>, %ag2 = %init : vector<8xf32>, %ag3 = %init : vector<8xf32>, %au0 = %init : vector<8xf32>, %au1 = %init : vector<8xf32>, %au2 = %init : vector<8xf32>, %au3 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kk_i = index.cast %kk : index to i32
    %kbase = scalar.andi %kk_i, %c255i : i32
    %kblk = scalar.shrui %kk_i, %c8i : i32

    %j_sink_g = scf.for %j_g = [%c0 to %c8 step %c1](%mk_g = %c0 : index) -> (index) {
      %j_i_g = index.cast %j_g : index to i32
      %j32_g = scalar.shli %j_i_g, %c5i : i32
      %e_i_g = scalar.addi %lane_i, %j32_g : i32
      %r_i_g = scalar.shrui %e_i_g, %c4i : i32
      %c_i_g = scalar.andi %e_i_g, %c15i : i32
      %i_i_g = scalar.addi %kbase, %c_i_g : i32
      %row_i_g = scalar.addi %m_origin_i, %r_i_g : i32
      %row_off_g = scalar.muli %row_i_g, %c2200i : i32
      %blk_off0_g = scalar.muli %kblk, %c110i : i32
      %blk_off_g = scalar.addi %row_off_g, %blk_off0_g : i32
      %group_g = scalar.shrui %i_i_g, %c5i : i32
      %half_g = scalar.shrui %group_g, %c2i : i32
      %sp_g = scalar.andi %group_g, %c3i : i32
      %h16b_g = scalar.andi %i_i_g, %c16i : i32
      %h16_g = scalar.shrui %h16b_g, %c4i : i32
      %jj_g = scalar.andi %i_i_g, %c15i : i32
      %lane_of_g = scalar.addi %h16b_g, %jj_g : i32
      %half32_g = scalar.shli %half_g, %c5i : i32
      %qs0_g = scalar.addi %blk_off_g, %c32i : i32
      %qs1_g = scalar.addi %qs0_g, %half32_g : i32
      %qs_i_g = scalar.addi %qs1_g, %lane_of_g : i32
      %low_shift_g = scalar.shli %sp_g, %c1i : i32
      %qs_ix_g = index.cast %qs_i_g : i32 to index
      %qs_lo_g = index.max %qs_ix_g, %c0 : index
      %qs_idx_g = index.min %qs_lo_g, %w_last : index
      %qsb8_g = view.load %gw_view[%qs_idx_g] : view<[%w_bytes]xi8> -> i8
      %qsb_g = scalar.extui %qsb8_g : i8 to i32
      %low0_g = scalar.shrui %qsb_g, %low_shift_g : i32
      %low_g = scalar.andi %low0_g, %c3i : i32
      %hm_i_g = scalar.addi %blk_off_g, %lane_of_g : i32
      %hm_ix_g = index.cast %hm_i_g : i32 to index
      %hm_lo_g = index.max %hm_ix_g, %c0 : index
      %hm_idx_g = index.min %hm_lo_g, %w_last : index
      %hmb8_g = view.load %gw_view[%hm_idx_g] : view<[%w_bytes]xi8> -> i8
      %hmb_g = scalar.extui %hmb8_g : i8 to i32
      %half4_g = scalar.shli %half_g, %c2i : i32
      %high_shift_g = scalar.addi %half4_g, %sp_g : i32
      %bit0_g = scalar.shrui %hmb_g, %high_shift_g : i32
      %bit_g = scalar.andi %bit0_g, %c1i : i32
      %bit4_g = scalar.shli %bit_g, %c2i : i32
      %lowbit_g = scalar.ori %low_g, %bit4_g : i32
      %quant_g = scalar.subi %lowbit_g, %c4i : i32
      %quant_f_g = scalar.sitofp %quant_g : i32 to f32
      %si0_g = scalar.muli %half_g, %c8i : i32
      %sp2_g = scalar.shli %sp_g, %c1i : i32
      %si1_g = scalar.addi %si0_g, %sp2_g : i32
      %si_v_g = scalar.addi %si1_g, %h16_g : i32
      %si_lt8_g = scalar.cmpi slt, %si_v_g, %c8i : i32
      %si_lo3_g = scalar.andi %si_v_g, %c7i : i32
      %sc0_g = scalar.addi %blk_off_g, %c96i : i32
      %sc1_g = scalar.addi %sc0_g, %si_lo3_g : i32
      %sc_ix_g = index.cast %sc1_g : i32 to index
      %sc_lo_ix_g = index.max %sc_ix_g, %c0 : index
      %sc_idx_g = index.min %sc_lo_ix_g, %w_last : index
      %scb8_g = view.load %gw_view[%sc_idx_g] : view<[%w_bytes]xi8> -> i8
      %scb_g = scalar.extui %scb8_g : i8 to i32
      %scb_lo_g = scalar.andi %scb_g, %c15i : i32
      %scb_hi_g = scalar.shrui %scb_g, %c4i : i32
      %low4_g = scf.if %si_lt8_g -> (i32) {
        scf.yield %scb_lo_g : i32
      } else {
        scf.yield %scb_hi_g : i32
      }
      %si_mod4_g = scalar.andi %si_v_g, %c3i : i32
      %hi_off8_g = scalar.addi %sc0_g, %c8i : i32
      %hi1_g = scalar.addi %hi_off8_g, %si_mod4_g : i32
      %hi_ix_g = index.cast %hi1_g : i32 to index
      %hi_lo_g = index.max %hi_ix_g, %c0 : index
      %hi_idx_g = index.min %hi_lo_g, %w_last : index
      %hib8_g = view.load %gw_view[%hi_idx_g] : view<[%w_bytes]xi8> -> i8
      %hib_g = scalar.extui %hib8_g : i8 to i32
      %si_div4_g = scalar.shrui %si_v_g, %c2i : i32
      %hi_shift_g = scalar.shli %si_div4_g, %c1i : i32
      %high0_g = scalar.shrui %hib_g, %hi_shift_g : i32
      %high2_g = scalar.andi %high0_g, %c3i : i32
      %high4_g = scalar.shli %high2_g, %c4i : i32
      %scale6_g = scalar.ori %low4_g, %high4_g : i32
      %scale_biased_g = scalar.subi %scale6_g, %c32i : i32
      %scale_f_g = scalar.sitofp %scale_biased_g : i32 to f32
      %blk_half0_g = scalar.shrui %blk_off_g, %c1i : i32
      %d_i_g = scalar.addi %blk_half0_g, %c54i : i32
      %d_ix_g = index.cast %d_i_g : i32 to index
      %d_lo_g = index.max %d_ix_g, %c0 : index
      %d_idx_g = index.min %d_lo_g, %w_half_last : index
      %d_half_v_g = view.load %gw_f16_view[%d_idx_g] : view<[%w_halfs]xf16> -> f16
      %d_g = scalar.extf %d_half_v_g : f16 to f32
      %dsc_g = scalar.mulf %d_g, %scale_f_g : f32
      %value_g = scalar.mulf %dsc_g, %quant_f_g : f32
      %h_g = scalar.fptrunc %value_g : f32 to f16
      %c_ix_g = index.cast %c_i_g : i32 to index
      %c_idx_g = index.max %c_ix_g, %c0 : index
      %kx_g = index.add %kk, %c_idx_g : index
      %row_ix_g = index.cast %row_i_g : i32 to index
      %row_lo_g = index.max %row_ix_g, %c0 : index
      %row_g = index.min %row_lo_g, %stage_last : index
      view.store %h_g, %gwstage_view[%row_g, %kx_g] : f16, view<[%stage_rows]x5120xf16>
      scf.yield %mk_g : index
    }
    %j_sink_u = scf.for %j_u = [%c0 to %c8 step %c1](%mk_u = %c0 : index) -> (index) {
      %j_i_u = index.cast %j_u : index to i32
      %j32_u = scalar.shli %j_i_u, %c5i : i32
      %e_i_u = scalar.addi %lane_i, %j32_u : i32
      %r_i_u = scalar.shrui %e_i_u, %c4i : i32
      %c_i_u = scalar.andi %e_i_u, %c15i : i32
      %i_i_u = scalar.addi %kbase, %c_i_u : i32
      %row_i_u = scalar.addi %m_origin_i, %r_i_u : i32
      %row_off_u = scalar.muli %row_i_u, %c2200i : i32
      %blk_off0_u = scalar.muli %kblk, %c110i : i32
      %blk_off_u = scalar.addi %row_off_u, %blk_off0_u : i32
      %group_u = scalar.shrui %i_i_u, %c5i : i32
      %half_u = scalar.shrui %group_u, %c2i : i32
      %sp_u = scalar.andi %group_u, %c3i : i32
      %h16b_u = scalar.andi %i_i_u, %c16i : i32
      %h16_u = scalar.shrui %h16b_u, %c4i : i32
      %jj_u = scalar.andi %i_i_u, %c15i : i32
      %lane_of_u = scalar.addi %h16b_u, %jj_u : i32
      %half32_u = scalar.shli %half_u, %c5i : i32
      %qs0_u = scalar.addi %blk_off_u, %c32i : i32
      %qs1_u = scalar.addi %qs0_u, %half32_u : i32
      %qs_i_u = scalar.addi %qs1_u, %lane_of_u : i32
      %low_shift_u = scalar.shli %sp_u, %c1i : i32
      %qs_ix_u = index.cast %qs_i_u : i32 to index
      %qs_lo_u = index.max %qs_ix_u, %c0 : index
      %qs_idx_u = index.min %qs_lo_u, %w_last : index
      %qsb8_u = view.load %uw_view[%qs_idx_u] : view<[%w_bytes]xi8> -> i8
      %qsb_u = scalar.extui %qsb8_u : i8 to i32
      %low0_u = scalar.shrui %qsb_u, %low_shift_u : i32
      %low_u = scalar.andi %low0_u, %c3i : i32
      %hm_i_u = scalar.addi %blk_off_u, %lane_of_u : i32
      %hm_ix_u = index.cast %hm_i_u : i32 to index
      %hm_lo_u = index.max %hm_ix_u, %c0 : index
      %hm_idx_u = index.min %hm_lo_u, %w_last : index
      %hmb8_u = view.load %uw_view[%hm_idx_u] : view<[%w_bytes]xi8> -> i8
      %hmb_u = scalar.extui %hmb8_u : i8 to i32
      %half4_u = scalar.shli %half_u, %c2i : i32
      %high_shift_u = scalar.addi %half4_u, %sp_u : i32
      %bit0_u = scalar.shrui %hmb_u, %high_shift_u : i32
      %bit_u = scalar.andi %bit0_u, %c1i : i32
      %bit4_u = scalar.shli %bit_u, %c2i : i32
      %lowbit_u = scalar.ori %low_u, %bit4_u : i32
      %quant_u = scalar.subi %lowbit_u, %c4i : i32
      %quant_f_u = scalar.sitofp %quant_u : i32 to f32
      %si0_u = scalar.muli %half_u, %c8i : i32
      %sp2_u = scalar.shli %sp_u, %c1i : i32
      %si1_u = scalar.addi %si0_u, %sp2_u : i32
      %si_v_u = scalar.addi %si1_u, %h16_u : i32
      %si_lt8_u = scalar.cmpi slt, %si_v_u, %c8i : i32
      %si_lo3_u = scalar.andi %si_v_u, %c7i : i32
      %sc0_u = scalar.addi %blk_off_u, %c96i : i32
      %sc1_u = scalar.addi %sc0_u, %si_lo3_u : i32
      %sc_ix_u = index.cast %sc1_u : i32 to index
      %sc_lo_ix_u = index.max %sc_ix_u, %c0 : index
      %sc_idx_u = index.min %sc_lo_ix_u, %w_last : index
      %scb8_u = view.load %uw_view[%sc_idx_u] : view<[%w_bytes]xi8> -> i8
      %scb_u = scalar.extui %scb8_u : i8 to i32
      %scb_lo_u = scalar.andi %scb_u, %c15i : i32
      %scb_hi_u = scalar.shrui %scb_u, %c4i : i32
      %low4_u = scf.if %si_lt8_u -> (i32) {
        scf.yield %scb_lo_u : i32
      } else {
        scf.yield %scb_hi_u : i32
      }
      %si_mod4_u = scalar.andi %si_v_u, %c3i : i32
      %hi_off8_u = scalar.addi %sc0_u, %c8i : i32
      %hi1_u = scalar.addi %hi_off8_u, %si_mod4_u : i32
      %hi_ix_u = index.cast %hi1_u : i32 to index
      %hi_lo_u = index.max %hi_ix_u, %c0 : index
      %hi_idx_u = index.min %hi_lo_u, %w_last : index
      %hib8_u = view.load %uw_view[%hi_idx_u] : view<[%w_bytes]xi8> -> i8
      %hib_u = scalar.extui %hib8_u : i8 to i32
      %si_div4_u = scalar.shrui %si_v_u, %c2i : i32
      %hi_shift_u = scalar.shli %si_div4_u, %c1i : i32
      %high0_u = scalar.shrui %hib_u, %hi_shift_u : i32
      %high2_u = scalar.andi %high0_u, %c3i : i32
      %high4_u = scalar.shli %high2_u, %c4i : i32
      %scale6_u = scalar.ori %low4_u, %high4_u : i32
      %scale_biased_u = scalar.subi %scale6_u, %c32i : i32
      %scale_f_u = scalar.sitofp %scale_biased_u : i32 to f32
      %blk_half0_u = scalar.shrui %blk_off_u, %c1i : i32
      %d_i_u = scalar.addi %blk_half0_u, %c54i : i32
      %d_ix_u = index.cast %d_i_u : i32 to index
      %d_lo_u = index.max %d_ix_u, %c0 : index
      %d_idx_u = index.min %d_lo_u, %w_half_last : index
      %d_half_v_u = view.load %uw_f16_view[%d_idx_u] : view<[%w_halfs]xf16> -> f16
      %d_u = scalar.extf %d_half_v_u : f16 to f32
      %dsc_u = scalar.mulf %d_u, %scale_f_u : f32
      %value_u = scalar.mulf %dsc_u, %quant_f_u : f32
      %h_u = scalar.fptrunc %value_u : f32 to f16
      %c_ix_u = index.cast %c_i_u : i32 to index
      %c_idx_u = index.max %c_ix_u, %c0 : index
      %kx_u = index.add %kk, %c_idx_u : index
      %row_ix_u = index.cast %row_i_u : i32 to index
      %row_lo_u = index.max %row_ix_u, %c0 : index
      %row_u = index.min %row_lo_u, %stage_last : index
      view.store %h_u, %uwstage_view[%row_u, %kx_u] : f16, view<[%stage_rows]x5120xf16>
      scf.yield %mk_u : index
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %lhsg = vector.fragment.load<lhs> %gwstage_view[%m_origin, %kk] shape [%m, %k] : view<[%stage_rows]x5120xf16> -> vector<16xf16>
    %lhsu = vector.fragment.load<lhs> %uwstage_view[%m_origin, %kk] shape [%m, %k] : view<[%stage_rows]x5120xf16> -> vector<16xf16>
    %rhs0 = vector.fragment.load<rhs> %a_t_view[%kk, %c0] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs1 = vector.fragment.load<rhs> %a_t_view[%kk, %c16] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs2 = vector.fragment.load<rhs> %a_t_view[%kk, %c32] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %rhs3 = vector.fragment.load<rhs> %a_t_view[%kk, %c48] shape [%k, %n] : view<5120x64xf16, %a_layout> -> vector<16xf16>
    %ng0 = vector.mma %lhsg, %rhs0, %ag0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng1 = vector.mma %lhsg, %rhs1, %ag1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng2 = vector.mma %lhsg, %rhs2, %ag2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %ng3 = vector.mma %lhsg, %rhs3, %ag3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu0 = vector.mma %lhsu, %rhs0, %au0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu1 = vector.mma %lhsu, %rhs1, %au1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu2 = vector.mma %lhsu, %rhs2, %au2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %nu3 = vector.mma %lhsu, %rhs3, %au3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %ng0, %ng1, %ng2, %ng3, %nu0, %nu1, %nu2, %nu3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  vector.fragment.store<result> %g0, %ogate_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %g1, %ogate_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %g2, %ogate_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %g3, %ogate_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u0, %oup_view[%m_origin, %c0] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u1, %oup_view[%m_origin, %c16] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u2, %oup_view[%m_origin, %c32] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  vector.fragment.store<result> %u3, %oup_view[%m_origin, %c48] shape [%m, %n] : vector<8xf32>, view<[%stage_rows]x64xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %store_sink = scf.for %j2 = [%c0 to %c32 step %c1](%mk2 = %c0 : index) -> (index) {
    %j2_i = index.cast %j2 : index to i32
    %j32b = scalar.shli %j2_i, %c5i : i32
    %e2_i = scalar.addi %lane_i, %j32b : i32
    %r2_i = scalar.shrui %e2_i, %c6i : i32
    %tok_i = scalar.andi %e2_i, %c63i : i32
    %r2_ix = index.cast %r2_i : i32 to index
    %r2 = index.max %r2_ix, %c0 : index
    %tok_ix = index.cast %tok_i : i32 to index
    %tok = index.max %tok_ix, %c0 : index
    %gr2_ix = index.add %m_origin, %r2 : index
    %gr2 = index.min %gr2_ix, %stage_last : index
    %gv = view.load %ogate_view[%gr2, %tok] : view<[%stage_rows]x64xf32> -> f32
    %uv = view.load %oup_view[%gr2, %tok] : view<[%stage_rows]x64xf32> -> f32
    %tok_off = index.mul %tok, %m_rows : index
    %gflat = index.add %tok_off, %gr2 : index
    %negg = scalar.mulf %gv, %negone : f32
    %e = scalar.expf<afn> %negg : f32
    %den = scalar.addf %one, %e : f32
    %inv = scalar.divf %one, %den : f32
    %sig = scalar.mulf %gv, %inv : f32
    %act = scalar.mulf %sig, %uv : f32
    %h = scalar.fptrunc %act : f32 to f16
    view.store %h, %out_view[%gflat] : f16, view<[%out_total]xf16>
    scf.yield %mk2 : index
  }
  kernel.return
}

// Requires --config=yah_ffn_gemm_q3k_gateup.m_tiles=1.
check.case public @yah_ffn_gemm_q3k_gateup_case {
  %gate_weight = check.file.read.npy path("fixtures/q3k_gemm/input_q3k_gemm.npy") : tensor<35200xi8>
  %up_weight = check.file.read.npy path("fixtures/q3k_gemm/input_q3k_gemm.npy") : tensor<35200xi8>
  %input = check.generate.fill value(0.25) : tensor<64x5120xf16>
  %output = check.generate.fill value(0.0) : tensor<1024xf16>
  %expected = check.file.read.npy path("fixtures/q3k_gemm/expected_gateup.npy") : tensor<1024xf16>
  %gwstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %uwstage = check.generate.fill value(0.0) : tensor<81920xf16>
  %ogate = check.generate.fill value(0.0) : tensor<1024xf32>
  %oup = check.generate.fill value(0.0) : tensor<1024xf32>
  kernel.launch @yah_ffn_gemm_q3k_gateup(%gate_weight, %up_weight, %input, %gwstage, %uwstage, %ogate, %oup, %output) : (tensor<35200xi8>, tensor<35200xi8>, tensor<64x5120xf16>, tensor<81920xf16>, tensor<81920xf16>, tensor<1024xf32>, tensor<1024xf32>, tensor<1024xf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.1) rtol(0.0) nan(same) : tensor<1024xf16>
  check.return
}

