// YAH DFlash grouped dynamic convolution, Loom port of
// dflash_grouped_dynamic_conv_kernel.
//
// HIP source: dflash_kernels.hip. For every (token, channel):
//
//   groups = hidden_size/group_size; group = channel/group_size
//   coeff_per_token = 2*kernel_size*groups
//   sum = 0
//   for tap < kernel_size where token >= tap:
//     sum += (base[(side*kernel_size+tap)*hidden + channel]
//             + dynamic[token*coeff_per_token + (side*kernel_size+tap)*groups + group])
//            * input[(token-tap)*hidden + channel]
//   output[token*hidden + channel] = sum
//
// The `token < tap` continue is an `scf.if` guard around the accumulation.
//
// Required config: --config=yah_dflash_conv.num_tokens=2 --config=yah_dflash_conv.hidden_size=4
//                  --config=yah_dflash_conv.kernel_size=2 --config=yah_dflash_conv.group_size=2
//                  --config=yah_dflash_conv.side=0
amdgpu.target<gfx1151> @yah_wave32 {subgroup_size = 32}

config.decl @yah_dflash_conv.num_tokens : %value: index where [range(%value, 1, 1073741824)]

config.decl @yah_dflash_conv.hidden_size : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_dflash_conv.kernel_size : %value: index where [range(%value, 1, 65536)]

config.decl @yah_dflash_conv.group_size : %value: index where [range(%value, 1, 1048576)]

config.decl @yah_dflash_conv.side : %value: index where [range(%value, 0, 1)]

kernel.def target(@yah_wave32) @yah_dflash_conv() {
  %unit = index.constant 1 : index
  %num_tokens = config.get @yah_dflash_conv.num_tokens : index
  %hidden_size = config.get @yah_dflash_conv.hidden_size : index
  %total = index.mul %num_tokens, %hidden_size : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %total, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%c256, %unit, %unit) : index
} launch(%input: buffer, %dynamic: buffer, %base_kernel: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c256 = index.constant 256 : index
  %zero = scalar.constant 0.0 : f32
  %num_tokens = config.get @yah_dflash_conv.num_tokens : index
  %hidden_size = config.get @yah_dflash_conv.hidden_size : index
  %kernel_size = config.get @yah_dflash_conv.kernel_size : index
  %group_size = config.get @yah_dflash_conv.group_size : index
  %side = config.get @yah_dflash_conv.side : index
  %total = index.mul %num_tokens, %hidden_size : index
  %groups = index.div %hidden_size, %group_size : index
  %ks_groups = index.mul %kernel_size, %groups : index
  %coeff = index.mul %c2, %ks_groups : index
  %c2k = index.mul %c2, %kernel_size : index
  %base_elems = index.mul %c2k, %hidden_size : index
  %dyn_elems = index.mul %num_tokens, %coeff : index
  %input_na, %dyn_na, %base_na, %out_na = buffer.assume.noalias %input, %dynamic, %base_kernel, %output : buffer, buffer, buffer, buffer
  %input_view = buffer.view %input_na[%base] : buffer -> view<[%total]xf32>
  %dyn_view = buffer.view %dyn_na[%base] : buffer -> view<[%dyn_elems]xf32>
  %base_view = buffer.view %base_na[%base] : buffer -> view<[%base_elems]xf32>
  %out_view = buffer.view %out_na[%base] : buffer -> view<[%total]xf32>
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %wg256 = index.mul %wg, %c256 : index
  %index = index.add %wg256, %lane : index
  %in_range = index.cmp ult, %index, %total : index
  %sink = scf.if %in_range -> (index) {
    %token = index.div %index, %hidden_size : index
    %channel = index.rem %index, %hidden_size : index
    %group = index.div %channel, %group_size : index
    %token_coeff = index.mul %token, %coeff : index
    %sum = scf.for %tap = [%c0 to %kernel_size step %c1](%acc = %zero : f32) -> (f32) {
      %enough = index.cmp uge, %token, %tap : index
      %next = scf.if %enough -> (f32) {
        %sidek = index.mul %side, %kernel_size : index
        %st = index.add %sidek, %tap : index
        %st_groups = index.mul %st, %groups : index
        %dyn_off = index.add %token_coeff, %st_groups : index
        %dyn_idx = index.add %dyn_off, %group : index
        %dyn_v = view.load %dyn_view[%dyn_idx] : view<[%dyn_elems]xf32> -> f32
        %st_hidden = index.mul %st, %hidden_size : index
        %base_idx = index.add %st_hidden, %channel : index
        %base_v = view.load %base_view[%base_idx] : view<[%base_elems]xf32> -> f32
        %tap_sum = scalar.addf %base_v, %dyn_v : f32
        %tt = index.sub %token, %tap : index
        %in_off = index.mul %tt, %hidden_size : index
        %in_idx = index.add %in_off, %channel : index
        %in_v = view.load %input_view[%in_idx] : view<[%total]xf32> -> f32
        %prod = scalar.mulf %tap_sum, %in_v : f32
        %s = scalar.addf %acc, %prod : f32
        scf.yield %s : f32
      } else {
        scf.yield %acc : f32
      }
      scf.yield %next : f32
    }
    view.store %sum, %out_view[%index] : f32, view<[%total]xf32>
    scf.yield %c0 : index
  } else {
    scf.yield %c0 : index
  }
  kernel.return
}

// Requires the config above. input = 1, base_kernel = iota 0..7, dynamic = iota 0..15,
// side = 0: the two tokens produce [0, 1, 3, 4] and [8, 9, 13, 14], which also
// exercises the grouping of the dynamic coefficients by channel.
check.case public @yah_dflash_conv_case {
  %input = check.generate.fill value(1.0) : tensor<8xf32>
  %dynamic = check.generate.iota offset(0.0) step(1.0) : tensor<16xf32>
  %base_kernel = check.generate.iota offset(0.0) step(1.0) : tensor<8xf32>
  %output = check.generate.fill value(0.0) : tensor<8xf32>
  %expected = check.file.read.npy path("fixtures/dflash_conv/expected.npy") : tensor<8xf32>
  kernel.launch @yah_dflash_conv(%input, %dynamic, %base_kernel, %output) : (tensor<8xf32>, tensor<16xf32>, tensor<8xf32>, tensor<8xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xf32>
  check.return
}

check.benchmark<@yah_dflash_conv_case> @yah_dflash_conv_bench
