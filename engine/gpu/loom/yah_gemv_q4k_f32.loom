// YAH Q4_K block GEMV, Loom port of Q8KBlockGEMVKernel for the Q4_K format
// (gemv_quant.hip). Decode each weight element with the Q4_K block decoder and
// dot it against the fp32 activation row:
//
//   y[m] = sum_k q4k_decode(W, m, k) * x[k]
//
// block_q4_K is 144 bytes, 20 blocks per 5120-wide row. Element i of a block is
//   gg = i/64; wv = i%64; lane = wv%32; low = wv < 32
//   qb = qs[gg*32+lane]; quant4 = low ? qb & 15 : qb >> 4
//   (sc, m) = GetQKScaleMin(scales, 2*gg + (low ? 0 : 1))
//   value = f32(d)*sc*quant4 - f32(dmin)*m
// which is the yah_dequant_q4k_bf16 decoder; the scale-pair branch is chosen by
// sis < 4, not by the nibble selector.
//
// One workgroup per output row, 32 lanes. HIP uses QuantWarpBlockDot, which
// distributes the row across the warp by block; this port gives each lane eight
// elements per block and reduces the row with a subgroup add, which computes the
// same sum. This is the kernel LaunchGEMV reaches through kHipQuantDirect, and it
// is the decode down projection, output projection and attention output
// projection for a Q4_K shard.
//
// Required config: --config=yah_gemv_q4k.m_rows=16
//                  --config=yah_gemv_q4k.k_blocks=20
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_gemv_q4k.m_rows : %value: index where [range(%value, 1, 65536)]

config.decl @yah_gemv_q4k.k_blocks : %value: index where [range(%value, 1, 65536)]

kernel.def target(@yah_wave32) @yah_gemv_q4k() {
  %unit = index.constant 1 : index
  %m_rows = config.get @yah_gemv_q4k.m_rows : index
  %c32 = index.constant 32 : index
  kernel.launch.config workgroups(%m_rows, %unit, %unit) workgroup_size(%c32, %unit, %unit) : index
} launch(%weight: buffer, %x: buffer, %y: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c144 = index.constant 144 : index
  %c256 = index.constant 256 : index
  %c1440 = index.constant 1440 : index
  %c2880 = index.constant 2880 : index
  %c0i = scalar.constant 0 : i32
  %c1i = scalar.constant 1 : i32
  %c4i = scalar.constant 4 : i32
  %c5i = scalar.constant 5 : i32
  %c6i = scalar.constant 6 : i32
  %c8i = scalar.constant 8 : i32
  %c15i = scalar.constant 15 : i32
  %c16i = scalar.constant 16 : i32
  %c31i = scalar.constant 31 : i32
  %c32i = scalar.constant 32 : i32
  %c63i = scalar.constant 63 : i32
  %c144i = scalar.constant 144 : i32
  %c2880i = scalar.constant 2880 : i32
  %zero = scalar.constant 0.0 : f32
  %m_rows = config.get @yah_gemv_q4k.m_rows : index
  %k_blocks = config.get @yah_gemv_q4k.k_blocks : index
  %w_bytes = index.mul %m_rows, %c2880 : index
  %w_halfs = index.mul %m_rows, %c1440 : index
  %x_elems = index.mul %k_blocks, %c256 : index
  %weight_na, %x_na, %y_na = buffer.assume.noalias %weight, %x, %y : buffer, buffer, buffer
  %w_view = buffer.view %weight_na[%base] : buffer -> view<[%w_bytes]xi8>
  %w_f16_view = buffer.view %weight_na[%base] : buffer -> view<[%w_halfs]xf16>
  %x_view = buffer.view %x_na[%base] : buffer -> view<[%x_elems]xf32>
  %y_view = buffer.view %y_na[%base] : buffer -> view<[%m_rows]xf32>
  %m = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %m_i = index.cast %m : index to i32
  %lane_i = index.cast %lane : index to i32
  %w_last = index.sub %w_bytes, %c1 : index
  %w_half_last = index.sub %w_halfs, %c1 : index
  %x_last = index.sub %x_elems, %c1 : index
  %acc0 = scf.for %kblk = [%c0 to %k_blocks step %c1](%a0 = %zero : f32) -> (f32) {
    %kblk_i = index.cast %kblk : index to i32
    %row_off = scalar.muli %m_i, %c2880i : i32
    %blk_off0 = scalar.muli %kblk_i, %c144i : i32
    %blk_off = scalar.addi %row_off, %blk_off0 : i32
    %kblk256 = scalar.shli %kblk_i, %c8i : i32
    %acc1 = scf.for %j = [%c0 to %c8 step %c1](%a1 = %a0 : f32) -> (f32) {
      %j_i = index.cast %j : index to i32
      %j32 = scalar.shli %j_i, %c5i : i32
      %i_i = scalar.addi %lane_i, %j32 : i32
      %gg_i = scalar.shrui %i_i, %c6i : i32
      %wv_i = scalar.andi %i_i, %c63i : i32
      %lane_dec = scalar.andi %wv_i, %c31i : i32
      %wv_hi = scalar.shrui %wv_i, %c5i : i32
      %is_low = scalar.cmpi slt, %wv_i, %c32i : i32
      %qs0 = scalar.addi %blk_off, %c16i : i32
      %gg32 = scalar.shli %gg_i, %c5i : i32
      %qs1 = scalar.addi %qs0, %gg32 : i32
      %qs2 = scalar.addi %qs1, %lane_dec : i32
      %qs_ix = index.cast %qs2 : i32 to index
      %qs_lo = index.max %qs_ix, %c0 : index
      %qs_idx = index.min %qs_lo, %w_last : index
      %qb8 = view.load %w_view[%qs_idx] : view<[%w_bytes]xi8> -> i8
      %qb = scalar.extui %qb8 : i8 to i32
      %qb_lo = scalar.andi %qb, %c15i : i32
      %qb_hi = scalar.shrui %qb, %c4i : i32
      %quant4 = scf.if %is_low -> (i32) {
        scf.yield %qb_lo : i32
      } else {
        scf.yield %qb_hi : i32
      }
      %gg2 = scalar.shli %gg_i, %c1i : i32
      %sis = scalar.addi %gg2, %wv_hi : i32
      %sis_low = scalar.cmpi slt, %sis, %c4i : i32
      %la0 = scalar.addi %blk_off, %c4i : i32
      %la_i = scalar.addi %la0, %sis : i32
      %lb_i = scalar.addi %la_i, %c4i : i32
      %lc_i = scalar.addi %blk_off, %sis : i32
      %la_ix = index.cast %la_i : i32 to index
      %la_lo = index.max %la_ix, %c0 : index
      %la_idx = index.min %la_lo, %w_last : index
      %lb_ix = index.cast %lb_i : i32 to index
      %lb_lo = index.max %lb_ix, %c0 : index
      %lb_idx = index.min %lb_lo, %w_last : index
      %lc_ix = index.cast %lc_i : i32 to index
      %lc_lo = index.max %lc_ix, %c0 : index
      %lc_idx = index.min %lc_lo, %w_last : index
      %la8 = view.load %w_view[%la_idx] : view<[%w_bytes]xi8> -> i8
      %lb8 = view.load %w_view[%lb_idx] : view<[%w_bytes]xi8> -> i8
      %lc8 = view.load %w_view[%lc_idx] : view<[%w_bytes]xi8> -> i8
      %la = scalar.extui %la8 : i8 to i32
      %lb = scalar.extui %lb8 : i8 to i32
      %lc = scalar.extui %lc8 : i8 to i32
      %sc, %smin = scf.if %sis_low -> (i32, i32) {
        %s = scalar.andi %la, %c63i : i32
        %mv = scalar.andi %lb, %c63i : i32
        scf.yield %s, %mv : i32, i32
      } else {
        %lb_lo2 = scalar.andi %lb, %c15i : i32
        %lc_hi = scalar.shrui %lc, %c6i : i32
        %lc_hi4 = scalar.shli %lc_hi, %c4i : i32
        %s2 = scalar.ori %lb_lo2, %lc_hi4 : i32
        %lb_hi = scalar.shrui %lb, %c4i : i32
        %la_hi = scalar.shrui %la, %c6i : i32
        %la_hi4 = scalar.shli %la_hi, %c4i : i32
        %m2 = scalar.ori %lb_hi, %la_hi4 : i32
        scf.yield %s2, %m2 : i32, i32
      }
      %blk_half0 = scalar.shrui %blk_off, %c1i : i32
      %d_ix = index.cast %blk_half0 : i32 to index
      %d_lo = index.max %d_ix, %c0 : index
      %d_idx = index.min %d_lo, %w_half_last : index
      %dmin0 = scalar.addi %blk_half0, %c1i : i32
      %dmin_ix = index.cast %dmin0 : i32 to index
      %dmin_lo = index.max %dmin_ix, %c0 : index
      %dmin_idx = index.min %dmin_lo, %w_half_last : index
      %d_half_v = view.load %w_f16_view[%d_idx] : view<[%w_halfs]xf16> -> f16
      %dmin_half_v = view.load %w_f16_view[%dmin_idx] : view<[%w_halfs]xf16> -> f16
      %d = scalar.extf %d_half_v : f16 to f32
      %dmin = scalar.extf %dmin_half_v : f16 to f32
      %sc_f = scalar.sitofp %sc : i32 to f32
      %m_f = scalar.sitofp %smin : i32 to f32
      %q_f = scalar.sitofp %quant4 : i32 to f32
      %dsc = scalar.mulf %d, %sc_f : f32
      %scaled = scalar.mulf %dsc, %q_f : f32
      %dm = scalar.mulf %dmin, %m_f : f32
      %value = scalar.subf %scaled, %dm : f32
      %kidx_i = scalar.addi %kblk256, %i_i : i32
      %kidx_ix = index.cast %kidx_i : i32 to index
      %kidx_lo = index.max %kidx_ix, %c0 : index
      %kidx = index.min %kidx_lo, %x_last : index
      %xv = view.load %x_view[%kidx] : view<[%x_elems]xf32> -> f32
      %prod = scalar.mulf %value, %xv : f32
      %next = scalar.addf %a1, %prod : f32
      scf.yield %next : f32
    }
    scf.yield %acc1 : f32
  }
  %sum = kernel.subgroup.reduce<addf> %acc0 : f32
  %is_zero = index.cmp eq, %lane, %c0 : index
  %st = scf.if %is_zero -> (f32) {
    view.store %sum, %y_view[%m] : f32, view<[%m_rows]xf32>
    scf.yield %zero : f32
  } else {
    scf.yield %zero : f32
  }
  kernel.return
}

// Requires the config block above with m_rows=16, k_blocks=20.
check.case public @yah_gemv_q4k_case {
  %weight = check.file.read.npy path("fixtures/q4k_gemm/input_q4k_gemm.npy") : tensor<46080xi8>
  %x = check.file.read.npy path("fixtures/q4k_gemm/gemv_x.npy") : tensor<5120xf32>
  %expected = check.file.read.npy path("fixtures/q4k_gemm/gemv_expected.npy") : tensor<16xf32>
  %y = check.generate.fill value(0.0) : tensor<16xf32>
  kernel.launch @yah_gemv_q4k(%weight, %x, %y) : (tensor<46080xi8>, tensor<5120xf32>, tensor<16xf32>)
  check.expect.close actual(%y) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<16xf32>
  check.return
}

check.benchmark<@yah_gemv_q4k_case> @yah_gemv_q4k_bench

// Requires --config=yah_gemv_q4k.m_rows=17408 --config=yah_gemv_q4k.k_blocks=20.
// An all-zero Q4_K weight decodes to zero, so every output row must be exactly 0.
check.case public @yah_gemv_q4k_full_case {
  %weight = check.generate.fill value(0) : tensor<50135040xi8>
  %x = check.generate.fill value(1.0) : tensor<5120xf32>
  %y = check.generate.fill value(0.0) : tensor<17408xf32>
  %expected = check.generate.fill value(0.0) : tensor<17408xf32>
  kernel.launch @yah_gemv_q4k(%weight, %x, %y) : (tensor<50135040xi8>, tensor<5120xf32>, tensor<17408xf32>)
  check.expect.close actual(%y) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<17408xf32>
  check.return
}

check.benchmark<@yah_gemv_q4k_full_case> @yah_gemv_q4k_full_bench
