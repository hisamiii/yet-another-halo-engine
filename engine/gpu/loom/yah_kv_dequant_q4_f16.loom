// YAH KV cache unpack from q4, Loom port of DequantizeQ4Kernel.
//
// HIP source: engine/kv/kv_quant.hip. One work-item owns one 18-byte KvQ4Block
// (engine/kv/kv_cache.hpp) and writes 32 f16 values:
//
//   scale = f32(u16 d)                              little endian f16 bits
//   raw   = even i: qs[i/2] & 0x0F, odd i: qs[i/2] >> 4
//   value = raw >= 8 ? raw - 16 : raw               two's complement nibble
//   out[i] = f16(scale * f32(value))
//
// The nibble is four bits of two's complement, so 0x8 means -8 and 0xF means -1.
// The port recovers the sign arithmetically as raw - ((raw >> 3) << 4), which is
// raw below 8 and raw - 16 at or above it, with no branch.
//
// Required configs, one per case:
//
//   @yah_kvq4_dequant_varied   blocks=4     (4 x 18 i8 in, 4 x 32 f16 out)
//   @yah_kvq4_dequant_uniform  blocks=10240 (184320 i8 in, 327680 f16 out)
amdgpu.target<gfx11-generic> @yah_wave32 {subgroup_size = 32}

config.decl @yah_kvq4_dequant.blocks : %value: index where [range(%value, 1, 1048576)]

kernel.def target(@yah_wave32) @yah_kvq4_dequant() {
  %unit = index.constant 1 : index
  %blocks = config.get @yah_kvq4_dequant.blocks : index
  %workgroup_size = index.constant 256 : index
  %c256 = index.constant 256 : index
  %c255 = index.constant 255 : index
  %biased = index.add %blocks, %c255 : index
  %tiles = index.div %biased, %c256 : index
  kernel.launch.config workgroups(%tiles, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3i = scalar.constant 3 : i32
  %c4i = scalar.constant 4 : i32
  %c15i = scalar.constant 15 : i32
  %c16 = index.constant 16 : index
  %c18 = index.constant 18 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %c8i16 = scalar.constant 8 : i16
  %blocks = config.get @yah_kvq4_dequant.blocks : index
  %src_bytes = index.mul %blocks, %c18 : index
  %total = index.mul %blocks, %c32 : index
  %src_noalias = buffer.assume.noalias %src : buffer
  %dst_noalias = buffer.assume.noalias %dst : buffer
  %src_view = buffer.view %src_noalias[%base] : buffer -> view<[%src_bytes]xi8>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%total]xf16>
  %lane = kernel.workitem.id<x> : index
  %wg = kernel.workgroup.id<x> : index
  %wg_base = index.mul %wg, %c256 : index
  %blk = index.add %wg_base, %lane : index
  %in_range = index.cmp ult, %blk, %blocks : index
  scf.if %in_range {
    %src_base = index.mul %blk, %c18 : index
    %dst_base = index.mul %blk, %c32 : index
    %d_lo_off = index.add %src_base, %c0 : index
    %d_hi_off = index.add %src_base, %c1 : index
    %d_lo8 = view.load %src_view[%d_lo_off] : view<[%src_bytes]xi8> -> i8
    %d_hi8 = view.load %src_view[%d_hi_off] : view<[%src_bytes]xi8> -> i8
    %d_lo = scalar.extui %d_lo8 : i8 to i16
    %d_hi = scalar.extui %d_hi8 : i8 to i16
    %d_hi_shifted = scalar.shli %d_hi, %c8i16 : i16
    %d_bits = scalar.ori %d_lo, %d_hi_shifted : i16
    %d_half = scalar.bitcast %d_bits : i16 to f16
    %scale = scalar.extf %d_half : f16 to f32
    %codes_base = index.add %src_base, %c2 : index
    %sink = scf.for %k = [%c0 to %c16 step %c1](%t = %scale : f32) -> (f32) {
      %two_k = index.mul %k, %c2 : index
      %odd_k = index.add %two_k, %c1 : index
      %code_off = index.add %codes_base, %k : index
      %packed8 = view.load %src_view[%code_off] : view<[%src_bytes]xi8> -> i8
      %packed = scalar.extui %packed8 : i8 to i32
      %low = scalar.andi %packed, %c15i : i32
      %high = scalar.shrui %packed, %c4i : i32
      %low_sign = scalar.shrui %low, %c3i : i32
      %high_sign = scalar.shrui %high, %c3i : i32
      %low_borrow = scalar.shli %low_sign, %c4i : i32
      %high_borrow = scalar.shli %high_sign, %c4i : i32
      %low_value = scalar.subi %low, %low_borrow : i32
      %high_value = scalar.subi %high, %high_borrow : i32
      %low_f = scalar.sitofp %low_value : i32 to f32
      %high_f = scalar.sitofp %high_value : i32 to f32
      %low_product = scalar.mulf %scale, %low_f : f32
      %high_product = scalar.mulf %scale, %high_f : f32
      %low_out = scalar.fptrunc %low_product : f32 to f16
      %high_out = scalar.fptrunc %high_product : f32 to f16
      %even_off = index.add %dst_base, %two_k : index
      %odd_off = index.add %dst_base, %odd_k : index
      view.store %low_out, %dst_view[%even_off] : f16, view<[%total]xf16>
      view.store %high_out, %dst_view[%odd_off] : f16, view<[%total]xf16>
      scf.yield %t : f32
    }
  }
  kernel.return
}

// Requires --config=yah_kvq4_dequant.blocks=4.
check.case public @yah_kvq4_dequant_varied {
  %src = check.file.read.npy path("fixtures/kv_quant_q8/q4_expected_varied.npy") : tensor<72xi8>
  %expected = check.file.read.npy path("fixtures/kv_quant_q8/q4_dequant_varied_expected.npy") : tensor<128xf16>
  %dst = check.generate.fill value(0.0) : tensor<128xf16>
  kernel.launch @yah_kvq4_dequant(%src, %dst) : (tensor<72xi8>, tensor<128xf16>)
  check.expect.close actual(%dst) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<128xf16>
  check.return
}

check.benchmark<@yah_kvq4_dequant_varied> @yah_kvq4_dequant_varied_bench

// Requires --config=yah_kvq4_dequant.blocks=10240.
check.case public @yah_kvq4_dequant_uniform {
  %src = check.file.read.npy path("fixtures/kv_quant_q8/q4_expected_uniform.npy") : tensor<184320xi8>
  %expected = check.file.read.npy path("fixtures/kv_quant_q8/q4_dequant_uniform_expected.npy") : tensor<327680xf16>
  %dst = check.generate.fill value(0.0) : tensor<327680xf16>
  kernel.launch @yah_kvq4_dequant(%src, %dst) : (tensor<184320xi8>, tensor<327680xf16>)
  check.expect.close actual(%dst) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<327680xf16>
  check.return
}

check.benchmark<@yah_kvq4_dequant_uniform> @yah_kvq4_dequant_uniform_bench
